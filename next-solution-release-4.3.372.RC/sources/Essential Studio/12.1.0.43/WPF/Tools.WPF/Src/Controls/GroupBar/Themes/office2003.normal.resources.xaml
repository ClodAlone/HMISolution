<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- GroupBar -->
	<SolidColorBrush x:Key="Office2003_GroupBar_BorderBrush" Color="#FF002D96"/>
	<LinearGradientBrush x:Key="Office2003_GroupBar_HeaderBrush" 
						 StartPoint="0,0" 
						 EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFCBE1FC"/>
				<GradientStop Offset="1" Color="#FF7DA6E0"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2003_GroupBar_Content" Color="#FFECE9D8"/>

	<!--GroupBarItem-->
	<LinearGradientBrush x:Key="Office2003_GroupBarItem_NormalStateBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFCBE1FC"/>
			<GradientStop Offset="1" Color="#FF7DA5E0"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003_GroupBarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFBE694"/>
			<GradientStop Offset="1" Color="#FFEE9515"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003_GroupBarItem_OverBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFFFDC"/>
			<GradientStop Offset="1" Color="#FFF7C05B"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003_GroupBarItem_OverSelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFE87F08"/>
			<GradientStop Offset="1" Color="#FFF7DA7C"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2003_GroupViewItem_SeparatorBrush" Color="#FF002D96"/>

	<!-- GroupView -->
	<SolidColorBrush x:Key="Office2003_GroupView_Background" Color="#FFECE9D8"/>

	<!-- GroupViewItem -->
	<Color x:Key="Office2003_GroupViewItem_OverBackgroundColor">#FFFFD091</Color>
	<Color x:Key="Office2003_GroupViewItem_PressedBackgroundColor">#FFFE9552</Color>
	<Color x:Key="Office2003_GroupViewItem_SelectedBackgroundColor">#FFFFAD55</Color>
	<Color x:Key="Office2003_GroupViewItem_SelectedOverBackgroundColor">#FFFE914E</Color>

	<SolidColorBrush x:Key="Office2003_GroupViewItem_BackgroundBrush" Color="#FFECE9D8"/>
	<SolidColorBrush x:Key="Office2003_GroupViewItem_BorderBrush" Color="#FFECE9D8"/>
	<SolidColorBrush x:Key="Office2003_GroupViewItem_OverBackgroundBrush" Color="#FFFFD091"/>
	<SolidColorBrush x:Key="Office2003_GroupViewItem_OverBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2003_GroupViewItem_PressedBackgroundBrush" Color="#FFFE9552"/>
	<SolidColorBrush x:Key="Office2003_GroupViewItem_PressedBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2003_GroupViewItem_SelectedBackgroundBrush" Color="#FFFFAD55"/>
	<SolidColorBrush x:Key="Office2003_GroupViewItem_SelectedBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2003_GroupViewItem_SelectedOverBackgroundBrush" Color="#FFFE914E"/>

	<!-- Splitter -->
	<LinearGradientBrush x:Key="Office2003_Splitter_BackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FF5987D6"/>
			<GradientStop Offset="1" Color="#FF002D96"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	
	<!--NavigationToolbar-->
	<LinearGradientBrush x:Key="Office2003_NavigationToolbar_BackgroundBrush" 
						 StartPoint="0,0" 
						 EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFCBE1FC"/>
				<GradientStop Offset="1" Color="#FF7DA6E0"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!--NavigationToolbarItem-->
	<LinearGradientBrush x:Key="Office2003_NavigationToolbarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFBE694"/>
			<GradientStop Offset="1" Color="#FFEE9515"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003_NavigationToolbarItem_OverBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFFFDC"/>
			<GradientStop Offset="1" Color="#FFF7C05B"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2003_NavigationToolbarItem_SelectedOverBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFE87F08"/>
			<GradientStop Offset="1" Color="#FFF7DA7C"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!-- MenuItem -->
	<LinearGradientBrush x:Key="Office2003_MenuItem_Brush"
						 StartPoint="0,0"
						 EndPoint="1,0">
		<GradientStop Color="#FFE3EFFF" Offset="0"/>
		<GradientStop Color="#FF87ADE4" Offset="1"/>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2003_MenuItem_OverBrush" Color="#FFFFEEC2"/>
	<SolidColorBrush x:Key="Office2003_MenuItem_OverBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2003_MenuItem_SelectedBackgroundBrush" Color="#FFFFAD55"/>
	<SolidColorBrush x:Key="Office2003_MenuItem_SelectedOverBackgroundBrush" Color="#FFFE914E"/>
	<SolidColorBrush x:Key="Office2003_MenuItem_SeparatorBrush" Color="#7BA4E0"/>

	<!-- Menu -->
	<SolidColorBrush x:Key="Office2003_Menu_BackgroundBrush" Color="#FFF6F6F6"/>
	<SolidColorBrush x:Key="Office2003_Menu_BorderBrush" Color="#FF000080"/>

	<!-- MenuText -->
	<SolidColorBrush x:Key="Office2003_MenuText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="Office2003_MenuText_SelectedBrush" Color="Black"/>
	<SolidColorBrush x:Key="Office2003_MenuText_DisabledBrush" Color="Gray"/>

	<!-- Text -->
	<SolidColorBrush x:Key="Office2003_TabText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="Office2003_ItemText_Brush" Color="Black"/>

    <SolidColorBrush x:Key="Office2003_CollapseArrowColor" Color="Black"/>
    <SolidColorBrush x:Key="Office2003_PopupBorderFillColor" Color="#A5C4EE"/>
    <SolidColorBrush x:Key="Office2003_NavigationPaneColor" Color="#ECE9D8"/>
    <SolidColorBrush x:Key="Office2003_NavigationPaneMouseOverColor" Color="#FFC06F"/>
    <SolidColorBrush x:Key="Office2003_NavigationPaneTextColor" Color="Black"/>
    <SolidColorBrush x:Key="Office2003_NavigationPaneBorderColor" Color="#6F7074"/>
    <SolidColorBrush x:Key="Office2003_NavigationPaneCheckedBorderColor" Color="Black"/>
</ResourceDictionary>