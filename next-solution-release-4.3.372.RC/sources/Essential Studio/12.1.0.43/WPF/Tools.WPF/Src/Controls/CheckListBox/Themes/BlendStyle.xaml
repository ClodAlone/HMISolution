<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">

    <!--Brushes-->
    <SolidColorBrush x:Key="CheckListBoxBorderBrush.Blend" Color="#FF555556" />

    <SolidColorBrush x:Key="CheckListBoxBackground.Blend" Color="#FF333333" />

    <SolidColorBrush x:Key="CheckListBoxItemForeground.Blend" Color="White" />

    <SolidColorBrush x:Key="CheckListBoxItemBorderBrush.Blend" Color="Transparent" />

    <SolidColorBrush x:Key="CheckListBoxItemBackground.Blend" Color="#FF424242" />

    <SolidColorBrush x:Key="SelectedBrush.Blend" Color="#FFAAAAAA" />

    <SolidColorBrush x:Key="SelectedBorderBrush.Blend" Color="Transparent" />

    <SolidColorBrush x:Key="SelectedForeground.Blend" Color="Black" />

    <SolidColorBrush x:Key="CheckListBoxItemHoverBorder.Blend" Color="Transparent" />

    <SolidColorBrush x:Key="CheckListBoxItemHoverBrush.Blend" Color="#FF707070" />

    <SolidColorBrush x:Key="CheckListBoxItemHoverForeground.Blend" Color="Black" />

    <!--CheckListBoxStyle-->
    <Style x:Key="BlendCheckListBoxStyle" TargetType="{x:Type local:CheckListBox}">
        <Setter  Property="BorderThickness" Value="1" />
        <Setter  Property="BorderBrush" Value="{StaticResource CheckListBoxBorderBrush.Blend}" />
        <Setter Property="Background" Value="{StaticResource CheckListBoxBackground.Blend}" />
        <Setter Property="Foreground" Value="{StaticResource CheckListBoxItemForeground.Blend}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheckListBox}">
                    <Border Background="{TemplateBinding Background}"  SnapsToDevicePixels="True"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer  Padding="{TemplateBinding Padding}"  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="0,0,0,-1" />
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource BlendCheckListBoxStyle}" TargetType="{x:Type local:CheckListBox}" />

    <!--CheckListBoxItemStyle-->
    <Style x:Key="BlendCheckListBoxItemStyle" TargetType="{x:Type local:CheckListBoxItem}">
        <Setter  Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource CheckListBoxItemBackground.Blend}" />
        <Setter Property="BorderBrush" Value="{StaticResource CheckListBoxItemBorderBrush.Blend}" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="local:CheckListBox.CheckBoxAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheckListBoxItem}">
                    <Border Name="Bd" CornerRadius="0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="true">
                        <Grid KeyboardNavigation.DirectionalNavigation="None">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Name="firstColumn" Width="Auto" />
                                <ColumnDefinition Name="secondColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Focusable="False" Name="PART_CheckBox" IsChecked="{Binding Path=IsSelected, RelativeSource={RelativeSource TemplatedParent}}"  VerticalAlignment="Center"  Margin="3,1,5,1" />
                            <Border Name="contentBd" Grid.Column="1">
                                <ContentPresenter Margin="3" ContentSource="Content" />
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <DataTrigger
                    Binding="{Binding Path=(local:CheckListBox.CheckBoxAlignment), RelativeSource={RelativeSource AncestorType={x:Type local:CheckListBox}}}" Value="Right">
                            <Setter TargetName="PART_CheckBox"
                                    Property="Grid.Column"
                                    Value="1" />
                            <Setter TargetName="contentBd" Property="Grid.Column"
                                    Value="0" />
                            <Setter TargetName="firstColumn" Property="Width"
                                    Value="*" />
                            <Setter TargetName="secondColumn" Property="Width"
                                    Value="Auto" />
                            <Setter TargetName="PART_CheckBox" Property="Margin"
                                    Value="5,1,1,1" />
                        </DataTrigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="Padding" Value="12,6,12,6" />
                            <Setter Property="Margin" TargetName="contentBd" Value="5,0,0,0" />
                            <Setter Property="CornerRadius" TargetName="Bd" Value="0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFocused" Value="true" />
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource SelectedBrush.Blend}" />
                            <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{StaticResource SelectedBorderBrush.Blend}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource SelectedForeground.Blend}" />
                            <Setter Property="CornerRadius" TargetName="Bd" Value="0" />
                        </MultiTrigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource SelectedBrush.Blend}" />
                            <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{StaticResource SelectedBorderBrush.Blend}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource SelectedForeground.Blend}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource CheckListBoxItemBackground.Blend}" />
                            <Setter Property="BorderBrush" Value="{StaticResource CheckListBoxItemBorderBrush.Blend}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="true" />
                                <Condition Property="shared:SkinStorage.EnableTouch" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd"
                                    Property="Background"
                                     Value="{StaticResource CheckListBoxItemHoverBrush.Blend}" />
                            <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{StaticResource CheckListBoxItemHoverBorder.Blend}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource CheckListBoxItemHoverForeground.Blend}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled"
                                 Value="false">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource BlendCheckListBoxItemStyle}" TargetType="{x:Type local:CheckListBoxItem}" />
</ResourceDictionary>