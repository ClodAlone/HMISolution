<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF" >

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/FontListBox/Themes/Brushes.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/FontListBox/Themes/MainTemplate.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/FontListBox/Themes/ShinyTemplate.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="FontListBoxInternalItemBaseStyle" TargetType="{x:Type local:FontListBoxInternalItem}">
        <Setter Property="Background" Value="{StaticResource Aero.ItemBrush}"/>
		<Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:FontListBox}}}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="ContentTemplate" Value="{StaticResource FontFamilyRecordTemplate}"/>
		<Setter Property="Template" Value="{StaticResource  FontListBoxInternalItemTemplate}"/>
        <Style.Triggers>           
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Background" Value="{StaticResource Blend.ItemBrush}"/>
                <Setter Property="Template" Value="{StaticResource BlendFontListBoxInternalItemTemplate}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Background" Value="{StaticResource Office2003.ItemBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2003FontListBoxInternalItemTemplate}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="Background" Value="{StaticResource Office2007Blue.ItemBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2007BlueFontListBoxInternalItemTemplate}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Background" Value="{StaticResource Office2007Silver.ItemBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2007SilverFontListBoxInternalItemTemplate}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Background" Value="{StaticResource Office2007Black.ItemBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2007BlackFontListBoxInternalItemTemplate}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="Background" Value="{StaticResource ItemBrush.Orange}"/>
                <Setter Property="Template" Value="{StaticResource SyncOrangeFontListBoxInternalItemTemplate}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Background" Value="{StaticResource ListBoxItemBackground.ShinyRed}"/>
                <Setter Property="Template" Value="{StaticResource FontListBoxInternalItemTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Background" Value="{StaticResource ListBoxItemBackground.ShinyRed}"/>
                <Setter Property="Template" Value="{StaticResource FontListBoxInternalItemTemplate.ShinyBlue}"/>
            </Trigger>
        </Style.Triggers>
	</Style>

	<Style x:Key="GroupHeaderBaseStyle" TargetType="{x:Type local:GroupHeader}">
        <Setter Property="Background" Value="{StaticResource Aero.HeaderBrush}"/>
		<Setter Property="Foreground" Value="Black"/>
		<Setter Property="Height" Value="20"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"/>
		<Setter Property="FontStyle" Value="Normal"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Template" Value="{StaticResource GroupHeaderTemplate}"/>
        <Style.Triggers >           
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Background" Value="{StaticResource Blend.HeaderBrush}"/>
                <Setter Property="Template" Value="{StaticResource BlendGroupHeaderTemplate}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Background" Value="{StaticResource Office2003.HeaderBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2003GroupHeaderTemplate}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="Background" Value="{StaticResource Office2007Blue.HeaderBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2007BlueGroupHeaderTemplate}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Background" Value="{StaticResource Office2007Silver.HeaderBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2007SilverGroupHeaderTemplate}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Background" Value="{StaticResource Office2007Black.HeaderBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2007BlackGroupHeaderTemplate}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="Background" Value="{StaticResource HeaderBrush.Orange}"/>
                <Setter Property="Template" Value="{StaticResource SyncOrangeGroupHeaderTemplate}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrushKey.ShinyBlue}"/>
                <Setter Property="Template" Value="{StaticResource ShinyBlueGroupHeaderTemplate}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="Template" Value="{StaticResource ShinyRedGroupHeaderTemplate}"/>
            </Trigger>
        </Style.Triggers>
	</Style>
	
	<Style x:Key="FontListBoxBaseStyle" TargetType="{x:Type local:FontListBox}">
        <Setter Property="Background" Value="{StaticResource Aero.BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Aero.ItemForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Template" Value="{StaticResource FontListBoxTemplate}"/>
        <Style.Triggers >
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Background" Value="{StaticResource Blend.BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Blend.ItemForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Background" Value="{StaticResource Office2003.BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2003.ItemForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="Background" Value="{StaticResource Office2007Blue.BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2007Blue.ItemForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Background" Value="{StaticResource Office2007Silver.BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2007Silver.ItemForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Background" Value="{StaticResource Office2007Black.BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2007Black.ItemForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="Background" Value="{StaticResource BackgroundBrush.Orange}"/>
                <Setter Property="Foreground" Value="{StaticResource ItemForegroundBrush.Orange}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush.Orange}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Background" Value="{StaticResource FontListBoxBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="Foreground" Value="{StaticResource FontListBoxForeground.ShinyRed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource FontListBoxBorderBrushKey.ShinyRed}"/>
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Background" Value="{StaticResource FontListBoxBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="Foreground" Value="{StaticResource FontListBoxForeground.ShinyRed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource FontListBoxBorderBrushKey.ShinyRed}"/>
            </Trigger>
           
        </Style.Triggers>
	</Style>

</ResourceDictionary>