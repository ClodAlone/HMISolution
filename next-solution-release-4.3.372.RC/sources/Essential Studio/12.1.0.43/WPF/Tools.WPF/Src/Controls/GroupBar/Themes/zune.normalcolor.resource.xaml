<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- GroupBar -->
	<SolidColorBrush x:Key="Zune_GroupBar_BorderBrush" Color="#FF002D96"/>
	<LinearGradientBrush x:Key="Zune_GroupBar_HeaderBrush"
						 StartPoint="0,0"
						 EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
        <GradientStop Offset="0" Color="#FF6B6B6B"/>
        <GradientStop Offset="0.5" Color="#FF565656"/>
        <GradientStop Offset="0.5" Color="#FF3A3A3A"/>
        <GradientStop Offset="1" Color="#2A2A2A"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Zune_GroupBar_Content" Color="#FFECE9D8"/>

	<!--GroupBarItem-->
	<LinearGradientBrush x:Key="Zune_GroupBarItem_NormalStateBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
      <GradientStop Offset="0" Color="#FFFFA466"/>
      <GradientStop Offset="0.5" Color="#FFF25E1E"/>
      <GradientStop Offset="0.5" Color="#FFB64A06"/>
      <GradientStop Offset="1" Color="#FFC75A17"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Zune_GroupBarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
      <GradientStop Offset="0" Color="#FF6B6B6B"/>
      <GradientStop Offset="0.5" Color="#FF565656"/>
      <GradientStop Offset="0.5" Color="#FF3A3A3A"/>
      <GradientStop Offset="1" Color="#2A2A2A"/>
    </LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Zune_GroupBarItem_OverBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
      <GradientStop Offset="0" Color="#FF999999"/>
      <GradientStop Offset="0.5" Color="#FF878787"/>
      <GradientStop Offset="0.5" Color="#FF6B6B6B"/>
      <GradientStop Offset="1" Color="#FF5B5B5B"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Zune_GroupBarItem_OverSelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
      <GradientStop Offset="0" Color="#FF999999"/>
      <GradientStop Offset="0.5" Color="#FF878787"/>
      <GradientStop Offset="0.5" Color="#FF6B6B6B"/>
      <GradientStop Offset="1" Color="#FF5B5B5B"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
  <SolidColorBrush x:Key="Zune_GroupViewItem_SeparatorBrush" Color="#FF002D96"/>

	<!-- GroupView -->
	<SolidColorBrush x:Key="Zune_GroupView_Background" Color="#FFECE9D8"/>

	<!-- GroupViewItem -->
	<Color x:Key="Zune_GroupViewItem_OverBackgroundColor">#FFFFD091</Color>
	<Color x:Key="Zune_GroupViewItem_PressedBackgroundColor">#FFFE9552</Color>
	<Color x:Key="Zune_GroupViewItem_SelectedBackgroundColor">#FFFFAD55</Color>
	<Color x:Key="Zune_GroupViewItem_SelectedOverBackgroundColor">#FFFE914E</Color>

  <SolidColorBrush x:Key="Zune_GroupViewItem_BackgroundBrush" Color="#FFECE9D8"/>
  <SolidColorBrush x:Key="Zune_GroupViewItem_BorderBrush" Color="#FFECE9D8"/>
  <SolidColorBrush x:Key="Zune_GroupViewItem_OverBackgroundBrush" Color="#FFFFD091"/>
  <SolidColorBrush x:Key="Zune_GroupViewItem_OverBorderBrush" Color="#FF000080"/>
  <SolidColorBrush x:Key="Zune_GroupViewItem_PressedBackgroundBrush" Color="#FFFE9552"/>
  <SolidColorBrush x:Key="Zune_GroupViewItem_PressedBorderBrush" Color="#FF000080"/>
  <SolidColorBrush x:Key="Zune_GroupViewItem_SelectedBackgroundBrush" Color="#FFFFAD55"/>
  <SolidColorBrush x:Key="Zune_GroupViewItem_SelectedBorderBrush" Color="#FF000080"/>
  <SolidColorBrush x:Key="Zune_GroupViewItem_SelectedOverBackgroundBrush" Color="#FFFE914E"/>

 	<!-- Splitter -->
	<SolidColorBrush x:Key="Zune_Splitter_BackgroundBrush" Color="#FF595959"/>

	<!--NavigationToolbar-->
	<LinearGradientBrush x:Key="Zune_NavigationToolbar_BackgroundBrush"
						 StartPoint="0,0"
						 EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
        <GradientStop Offset="0" Color="#FF6B6B6B"/>
        <GradientStop Offset="0.5" Color="#FF565656"/>
        <GradientStop Offset="0.5" Color="#FF3A3A3A"/>
        <GradientStop Offset="1" Color="#2A2A2A"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!--NavigationToolbarItem-->
	<LinearGradientBrush x:Key="Zune_NavigationToolbarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
      <GradientStop Offset="0" Color="#FF999999"/>
      <GradientStop Offset="0.5" Color="#FF878787"/>
      <GradientStop Offset="0.5" Color="#FF6B6B6B"/>
      <GradientStop Offset="1" Color="#FF5B5B5B"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Zune_NavigationToolbarItem_OverBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
      <GradientStop Offset="0" Color="#FF999999"/>
      <GradientStop Offset="0.5" Color="#FF878787"/>
      <GradientStop Offset="0.5" Color="#FF6B6B6B"/>
      <GradientStop Offset="1" Color="#FF5B5B5B"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Zune_NavigationToolbarItem_SelectedOverBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
      <GradientStop Offset="0" Color="#FF999999"/>
      <GradientStop Offset="0.5" Color="#FF878787"/>
      <GradientStop Offset="0.5" Color="#FF6B6B6B"/>
      <GradientStop Offset="1" Color="#FF5B5B5B"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Zune_NavigationToolbarItem_ArrowBrush" Color="White"/>

  <!-- MenuItem -->
  <SolidColorBrush x:Key="Zune_MenuItem_Brush" Color="#FFE9EEEE"/>
  <SolidColorBrush x:Key="Zune_MenuItem_OverBrush" Color="#FFFFE7A2"/>
  <SolidColorBrush x:Key="Zune_MenuItem_OverBorderBrush" Color="#FFFFBD69"/>
  <SolidColorBrush x:Key="Zune_MenuItem_SelectedBackgroundBrush" Color="#FFFFAB3F"/>
  <SolidColorBrush x:Key="Zune_MenuItem_SelectedOverBackgroundBrush" Color="#FFFFAB3F"/>
  <SolidColorBrush x:Key="Zune_MenuItem_SeparatorBrush" Color="#FF002D96"/>

  <!-- Menu -->
  <SolidColorBrush x:Key="Zune_Menu_BackgroundBrush" Color="#FFF6F6F6"/>
  <SolidColorBrush x:Key="Zune_Menu_BorderBrush" Color="#FF002D96"/>

  <!-- MenuText -->
  <SolidColorBrush x:Key="Zune_MenuText_Brush" Color="Black"/>
  <SolidColorBrush x:Key="Zune_MenuText_SelectedBrush" Color="Black"/>
  <SolidColorBrush x:Key="Zune_MenuText_DisabledBrush" Color="Gray"/>
  
	<!-- Text -->
  <SolidColorBrush x:Key="Zune_TabText_Brush" Color="#FFF2F2F2"/>
  <SolidColorBrush x:Key="Zune_ItemText_Brush" Color="Black"/>

    <SolidColorBrush x:Key="Zune_CollapseArrowColor" Color="White"/>
    <SolidColorBrush x:Key="Zune_PopupBorderFillColor" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="Zune_NavigationPaneColor" Color="#ECE9D8"/>
    <SolidColorBrush x:Key="Zune_NavigationPaneMouseOverColor" Color="#F98546"/>
    <SolidColorBrush x:Key="Zune_NavigationPaneTextColor" Color="Black"/>
    <SolidColorBrush x:Key="Zune_NavigationPaneBorderColor" Color="#002D96"/>
    <SolidColorBrush x:Key="Zune_NavigationPaneCheckedBorderColor" Color="#464646"/>
</ResourceDictionary>