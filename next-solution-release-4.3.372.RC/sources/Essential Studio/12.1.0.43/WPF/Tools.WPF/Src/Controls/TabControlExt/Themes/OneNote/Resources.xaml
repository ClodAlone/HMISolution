<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Controls/TabControlExt/Themes/MainTemplates.xaml" />
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Controls/TabControlExt/Themes/Brushes.xaml"/>

    </ResourceDictionary.MergedDictionaries>
	
	<system:Double x:Key="NanValue">
		NaN
	</system:Double>

    <ControlTemplate x:Key="OneNoteTabItemTemplate" TargetType="{x:Type local:TabItemExt}">
        <local:OneNoteTabBorder BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Name="Bd" MinHeight="18"
								ToolTip="{Binding Path=ItemToolTip, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabItemExt}}}"
								>
            <DockPanel x:Name="PART_DockPanel" LastChildFill="True">
                <ToggleButton Name="PART_CloseButton" Width="15" Height="14" Margin="1,0,10,0" VerticalAlignment="Top"                                 
                                  DockPanel.Dock="Right" 
                                  Focusable="False" 
                                  Visibility="Hidden"                                  
							      Template="{StaticResource DefaultCloseButtonTemplate}"
                                  Command="local:TabControlCommands.CloseTabItem"
                                  />
                <Image x:Name="PART_Image"
					   Source="{TemplateBinding local:TabControlExt.Image}"
					   Height="{TemplateBinding local:TabControlExt.ImageHeight}"
					   Width="{TemplateBinding local:TabControlExt.ImageWidth}"
					   Stretch="Fill" Margin="0,0,0,4"
					   SnapsToDevicePixels="True" VerticalAlignment="Center"
                       DockPanel.Dock="{Binding Path=(local:TabControlExt.ImageAlignment), Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ImageAlignmentToDockConverter}}"/>
                <ContentPresenter         ContentSource="Header" x:Name="Content" Margin="6,0,0,1" TextElement.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabItemExt}}}" 
                                          RecognizesAccessKey="True" Content="{TemplateBinding HeaderedContentControl.Header}" 
                                          ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}"                                           
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                          SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
            </DockPanel>
        </local:OneNoteTabBorder>
        <ControlTemplate.Triggers>
			<Trigger Property="local:TabControlExt.ImageHeight" Value="{StaticResource NanValue}">
				<Setter TargetName="PART_Image" Property="Stretch" Value="Uniform" />
			</Trigger>
			<Trigger Property="local:TabControlExt.ImageWidth" Value="{StaticResource NanValue}">
				<Setter TargetName="PART_Image" Property="Stretch" Value="Uniform" />
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="local:TabControlExt.ImageHeight" Value="{StaticResource NanValue}" />
					<Condition Property="local:TabControlExt.ImageWidth" Value="{StaticResource NanValue}" />
				</MultiTrigger.Conditions>
				<Setter TargetName="PART_Image" Property="Stretch" Value="None" />
			</MultiTrigger>
            <!--Initial section-->
            <DataTrigger Binding="{Binding Path=CloseButtonType,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Both">
                <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=CloseButtonType,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Individual">
                <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=CloseButtonType,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="IndividualOnMouseOver"/>
                    <Condition Binding="{Binding Path=IsMouseOver, ElementName=Bd}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Path=(local:TabControlExt.Image), RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                <Setter Property="UIElement.Visibility" TargetName="PART_Image" Value="Collapsed"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding Path=IsMouseOver, ElementName=Bd}" Value="True">
                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource OneNote.TabHoverBorderBrush}"/>
                <Setter Property="TextElement.Foreground" TargetName="Content" Value="{StaticResource OneNote.TabSelectedForeground}"/>
            </DataTrigger>


            <!--RotateTextWhenVertical section-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Left"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <RotateTransform Angle="-90"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Border.BorderThickness" TargetName="Bd" Value="1,1,0,1"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Right"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <RotateTransform Angle="-90"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Border.BorderThickness" TargetName="Bd" Value="0,1,1,1"/>
            </MultiDataTrigger>
            <!--End RotateTextWhenVertical section-->

            <!--TabStripPlacement section-->
            <DataTrigger Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Bottom">
                <Setter Property="Border.BorderThickness" TargetName="Bd" Value="1,1,1,0"/>
                <!--<Setter Property="Margin" TargetName="Bd" Value="0,0.5,0,0"/>-->
                <Setter Property="VerticalAlignment" Value="Top" TargetName="PART_DockPanel"/>
                <Setter Property="VerticalAlignment" Value="Bottom" TargetName="PART_CloseButton"/>
                <Setter Property="Margin" Value="0,4,0,0" TargetName="PART_Image"/>
                <Setter Property="LayoutTransform" TargetName="PART_DockPanel">
                    <Setter.Value>
                        <RotateTransform Angle="-180"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Bottom"/>
                    <Condition Binding="{Binding Path=(local:TabControlExt.ImageAlignment), RelativeSource={RelativeSource Self}}" Value="LeftOfText"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Margin" Value="8,4,0,0" TargetName="PART_Image"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Left"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Margin" TargetName="Bd" Value="0,0.5,0,0"/>
                <Setter Property="Border.BorderThickness" TargetName="Bd" Value="1,1,1,0"/>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Right"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Border.BorderThickness" TargetName="Bd" Value="1,1,1,0"/>
            </MultiDataTrigger>
            <!--End TabStripPlacement section-->
            <!--VS 2008 specifies section-->
            <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="BorderBrush" TargetName="Bd"  Value="{StaticResource OneNote.TabHoverBorderBrush}"/>
                <Setter Property="BottomBorderBrush" TargetName="Bd" Value="{StaticResource OneNote.TabSelectedBottomBorderBrush}"/>
                <Setter Property="BorderInnerBrush" TargetName="Bd" Value="{StaticResource OneNote.TabHoverBorderInnerBrush}"/>
                <Setter Property="TextElement.FontWeight" TargetName="Content" Value="SemiBold"/>
            </DataTrigger>
            <!--RotateTextWhenVertical = FALSE-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Bottom"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Margin" Value="0,0,-10,0"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Left"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Margin" Value="-2,0,-8,0"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="9999"/>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Top"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" Value="2,0,0,0"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="9999"/>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Right"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" Value="2,0,0,0"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="9999"/>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Bottom"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" Value="0,0,2,0"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="9999"/>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Left"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" Value="-2,0,0,0"/>
            </MultiDataTrigger>

            <!--IsSelected Section-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Top"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" Value="-12,-2,0,-1"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="9999"/>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Top"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" Value="0,-2,-2,-1"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Right"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" Value="-12,-2,0,-1"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="9999"/>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Right"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" Value="0,-2,-2,-1"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Bottom"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" Value="-2,-2,-12,-1"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="0"/>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Bottom"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" Value="-2,-2,0,-1"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Left"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" Value="-2,-2,-10,-1"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding Path=(Panel.ZIndex), RelativeSource={RelativeSource Self}}" Value="0"/>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Left"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" Value="-2,-2,0,-1"/>
            </MultiDataTrigger>
            <!--End IsSelected section-->
            <!--End RotateTextWhenVertical = FALSE-->


            <!--RotateTextWhenVertical = TRUE-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Left"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" TargetName="PART_CloseButton" Value="1,0,0,0"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Right"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" TargetName="PART_CloseButton" Value="1,0,0,0"/>
            </MultiDataTrigger>
            <!--IsSelected Section-->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Left"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" Value="-2,-2,2,-2"/>
                <Setter Property="Panel.ZIndex" Value="1"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="Right"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FrameworkElement.Margin" Value="-2,-2,2,-2"/>
                <Setter Property="Panel.ZIndex" Value="1"/>
            </MultiDataTrigger>
            <!--End IsSelected section-->
            <!--End RotateTextWhenVertical = TRUE-->

            <!--End VS 2008 specifies section-->
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="OneNoteTabItemStyle" TargetType="{x:Type local:TabItemExt}">
        <Setter Property="Foreground" Value="{StaticResource Aero.InactiveForeground}"/>
        <Setter Property="FrameworkElement.FocusVisualStyle">
            <Setter.Value>
                <Style TargetType="IFrameworkInputElement">
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <!--<ControlTemplate>
                                <Rectangle Stroke="#FF000000" StrokeThickness="1" StrokeDashArray="1 2" Margin="3,3,3,1" SnapsToDevicePixels="True" />
                            </ControlTemplate>-->
                            <x:Null/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="TextElement.Foreground" >
            <Setter.Value>
                <SolidColorBrush>#FF000000</SolidColorBrush>
            </Setter.Value>
        </Setter>
        <!--<Setter Property="Padding" Value="0"/>-->
        <Setter Property="BorderThickness" Value="1"/>                
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="Margin" Value="-8,0,0,0"/>
        <Setter Property="Background" Value="{StaticResource OneNote.TabBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OneNote.TabBorderBrush}"/>
        <Setter Property="Control.HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Control.Template" Value="{StaticResource OneNoteTabItemTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <!--<Setter Property="BorderBrush" Value="{shared:SkinObject TabHoverBorderBrush}"/>-->
                <Setter Property="Background" Value="{StaticResource OneNote.TabSelectedBackgroundBrush}"/>
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Margin" Value="0"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding HeaderTemplate}" Value="{x:Null}">
                <Setter Property="HeaderTemplate" Value="{StaticResource HeaderDataTemplate}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(local:TabControlExt.UseCustomEditableTemplate), RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding Path=(local:TabControlExt.IsEditing), RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="HeaderTemplate" Value="{Binding Path=(local:TabControlExt.CustomEditableTemplate), RelativeSource={RelativeSource Self}}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(local:TabControlExt.UseCustomEditableTemplate), RelativeSource={RelativeSource Self}}" Value="False"/>
                    <Condition Binding="{Binding Path=(local:TabControlExt.IsEditing), RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="HeaderTemplate" Value="{StaticResource EditableDataTemplate}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
  