<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:sample="clr-namespace:Syncfusion.Windows.Tools.Controls">

    <SolidColorBrush x:Key="RepeatButtonBorder" Color="#FF323437" />

    <LinearGradientBrush  x:Key="RepeatButtonMouseOverBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE3AD" Offset="0" />
        <GradientStop Color="#FFFFF4CB" Offset="0.02" />
        <GradientStop Color="#FFFFDB75" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="RepeatButtonHoverBorder" Color="#FFFFC06F" />

    <LinearGradientBrush x:Key="RepeatButtonPressedBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFC973D" Offset="0.038" />
        <GradientStop Color="#FFFFB75B" Offset="0.95" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="RepeatButtonPressedBorder" Color="#FFFB903F" />

    <LinearGradientBrush x:Key="RepeatButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFCBCFD4" Offset="0.033" />
        <GradientStop Color="#FFBBC0C6" Offset="0.519" />
        <GradientStop Color="#FF949CA6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,1" x:Key="RepeatButtonMouseOverBorderBrush">
        <GradientStop Color="#FFDBCE99"></GradientStop>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="RangeFillBrush" Color="#FF262626" />

    <LinearGradientBrush x:Key="HorizontalThumbBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFCBCFD4" Offset="0.033" />
        <GradientStop Color="#FFBBC0C6" Offset="0.519" />
        <GradientStop Color="#FF949CA6" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HorizontalThumbBorderBrush" Color="#FF323437" />

    <LinearGradientBrush x:Key="VerticalThumbBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFCBCFD4" Offset="0.033" />
        <GradientStop Color="#FFBBC0C6" Offset="0.519" />
        <GradientStop Color="#FF949CA6" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="VerticalThumbBorderBrush" Color="#FF323437" />

    <!--Custom Template for Horizontal Thumb-->

    <ControlTemplate x:Key="ThumbTemplateKey" TargetType="Thumb">
        <Grid>
            <Path Stretch="Fill" x:Name="paththumb" Fill="{StaticResource HorizontalThumbBackground}" Stroke="{StaticResource HorizontalThumbBorderBrush}"  StrokeThickness="1"   Data="M0.125,0.125 L0.125,9.25 L5.125,17.875 L10.75,9 L10.75,0 z">
            </Path>
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="paththumb" Property="Fill" Value="{StaticResource RepeatButtonMouseOverBrush}" />
                <Setter TargetName="paththumb" Property="Stroke" Value="#FFFFC06F" />
            </MultiTrigger>
            <Trigger Property="IsMouseCaptured" Value="True">
                <Setter TargetName="paththumb" Property="Fill" Value="{StaticResource RepeatButtonMouseOverBrush}" />
                <Setter TargetName="paththumb" Property="Stroke" Value="#FFFFC06F" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--Custom Template for vertical Thumb-->

    <ControlTemplate x:Key="ThumbTemplateVertical" TargetType="Thumb">
        <Grid>
            <Path Stretch="Fill" x:Name="paththumbsecond" Fill="{StaticResource VerticalThumbBackground}"  Stroke="{StaticResource VerticalThumbBorderBrush}" StrokeThickness="1"   Data="M261,231 L290.5,230.5 290.5,258 259.5,259 237.5,246 z" />
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="paththumbsecond" Property="Fill" Value="{StaticResource RepeatButtonMouseOverBrush}" />
                <Setter TargetName="paththumbsecond" Property="Stroke" Value="#FFFFC06F" />
            </MultiTrigger>
            <Trigger Property="IsMouseCaptured" Value="True">
                <Setter TargetName="paththumbsecond" Property="Fill" Value="{StaticResource RepeatButtonMouseOverBrush}" />
                <Setter TargetName="paththumbsecond" Property="Stroke" Value="#FFFFC06F" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--Custom Template for Repeat Button-->

    <ControlTemplate x:Key="RepeatButtonTemplate1" TargetType="RepeatButton">
        <Grid>
            <Border x:Name="Background" CornerRadius="3" Opacity="1" Background="{StaticResource RepeatButtonBackground}" SnapsToDevicePixels="True" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{StaticResource RepeatButtonBorder}">
                <Grid Background="Transparent">
                    <Rectangle x:Name="BackgroundGradient" Opacity="0"  RadiusX="3" RadiusY="3">
                    </Rectangle>
                </Grid>
            </Border>
            <ContentControl IsTabStop="False"
                              x:Name="contentPresenter"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="{TemplateBinding Padding}" Foreground="Black">
                <ContentControl.Content>
                    <Viewbox x:Name="viewBox1" Height="8" Width="8"  HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="upbuttonpath" Width="8" Height="8" Stretch="Uniform" Fill="Black" Data="M 0 0 L 3.5 4 L 7 0 Z"  RenderTransformOrigin=".5,.5">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform />
                                    <SkewTransform />
                                    <RotateTransform Angle="90" />
                                    <TranslateTransform />
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Viewbox>
                </ContentControl.Content>
            </ContentControl>

            <Rectangle x:Name="DisabledVisualElement" RadiusX="3" RadiusY="3" Fill="#FFFFFFFF" Opacity="0" IsHitTestVisible="false" />
            <Rectangle x:Name="FocusVisualElement" RadiusX="2" RadiusY="2" Margin="1" Stroke="Black" StrokeThickness="1" Opacity="0" IsHitTestVisible="false" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="true">
                <Setter TargetName="contentPresenter" Property="FontSize" Value="30" />
                <Setter Property="Width" TargetName="viewBox1" Value="18" />
                <Setter Property="Height" TargetName="viewBox1" Value="18" />
                <Setter Property="Width" TargetName="upbuttonpath" Value="18" />
                <Setter Property="Height" TargetName="upbuttonpath" Value="18" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.EnableTouch" Value="False" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Background" Property="Background" Value="{StaticResource RepeatButtonMouseOverBrush}"></Setter>
                <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource RepeatButtonHoverBorder}"></Setter>
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="Background" Property="Background" Value="{StaticResource RepeatButtonPressedBrush}"></Setter>
                <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource RepeatButtonPressedBorder}"></Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

