<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">

    <!--Brushes-->
    <SolidColorBrush x:Key="CheckListBoxBorderBrush.Orange" Color="#FFEDA023" />
    <SolidColorBrush x:Key="CheckListBoxBackground.Orange" Color="#FF6E2714" />

    <SolidColorBrush x:Key="CheckListBoxItemBorderBrush.Orange" Color="Transparent" />
    <SolidColorBrush x:Key="CheckListBoxItemBackground.Orange" Color="Transparent" />
    <SolidColorBrush x:Key="CheckListBoxItemForeground.Orange" Color="White" />

    <SolidColorBrush x:Key="CheckListBoxItemHoverBorder.Orange" Color="#FFF3B766" />
    <SolidColorBrush x:Key="CheckListBoxItemHoverBrush.Orange" Color="#FF5F1A11" />
    <SolidColorBrush x:Key="CheckListBoxItemHoverForeground.Orange" Color="White" />

    <SolidColorBrush x:Key="SelectedBrush.Orange" Color="#FF5F1A11" />
    <SolidColorBrush x:Key="SelectedBorderBrush.Orange" Color="#FFF3B766" />
    <SolidColorBrush x:Key="SelectedForeground.Orange" Color="White" />

    <!--CheckListBoxStyle-->
    <Style x:Key="SyncOrangeCheckListBoxStyle" TargetType="{x:Type local:CheckListBox}">
        <Setter  Property="BorderThickness" Value="1" />
        <Setter  Property="BorderBrush" Value="{StaticResource CheckListBoxBorderBrush.Orange}" />
        <Setter Property="Background" Value="{StaticResource CheckListBoxBackground.Orange}" />
        <Setter Property="Foreground" Value="{StaticResource CheckListBoxItemForeground.Orange}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheckListBox}">
                    <Border Background="{TemplateBinding Background}"  SnapsToDevicePixels="True"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer  Padding="{TemplateBinding Padding}"  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource SyncOrangeCheckListBoxStyle}" TargetType="{x:Type local:CheckListBox}" />

    <!--CheckListBoxItemStyle-->
    <Style x:Key="SyncOrangeCheckListBoxItemStyle" TargetType="{x:Type local:CheckListBoxItem}">
        <Setter  Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource CheckListBoxItemBackground.Orange}" />
        <Setter Property="BorderBrush" Value="{StaticResource CheckListBoxItemBorderBrush.Orange}" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="local:CheckListBox.CheckBoxAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheckListBoxItem}">
                    <Border Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="true">
                        <Grid KeyboardNavigation.DirectionalNavigation="None">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Name="firstColumn" Width="Auto" />
                                <ColumnDefinition Name="secondColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Focusable="False" Name="PART_CheckBox" IsChecked="{Binding Path=IsSelected, RelativeSource={RelativeSource TemplatedParent}}"  VerticalAlignment="Center"  Margin="1,1,5,1" />
                            <Border Name="contentBd" Grid.Column="1">
                                <ContentPresenter Margin="3" ContentSource="Content" />
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <DataTrigger
                    Binding="{Binding Path=(local:CheckListBox.CheckBoxAlignment), RelativeSource={RelativeSource AncestorType={x:Type local:CheckListBox}}}" Value="Right">
                            <Setter TargetName="PART_CheckBox"
                                    Property="Grid.Column"
                                    Value="1" />
                            <Setter TargetName="contentBd" Property="Grid.Column"
                                    Value="0" />
                            <Setter TargetName="firstColumn" Property="Width"
                                    Value="*" />
                            <Setter TargetName="secondColumn" Property="Width"
                                    Value="Auto" />
                            <Setter TargetName="PART_CheckBox" Property="Margin"
                                    Value="5,1,1,1" />
                        </DataTrigger>

                        <Trigger Property="IsSelected"
                                 Value="true">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource SelectedBrush.Orange}" />
                            <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{StaticResource SelectedBorderBrush.Orange}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource SelectedForeground.Orange}" />
                            <Setter TargetName="Bd" Property="CornerRadius" Value="0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFocused" Value="true" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource CheckListBoxItemBackground.Orange}" />
                            <Setter Property="BorderBrush" Value="{StaticResource CheckListBoxItemBorderBrush.Orange}" />
                        </MultiTrigger>

                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource CheckListBoxItemHoverBrush.Orange}" />
                            <Setter TargetName="Bd"
                                    Property="BorderBrush"
                                    Value="{StaticResource CheckListBoxItemHoverBorder.Orange}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource CheckListBoxItemHoverForeground.Orange}" />
                            <Setter TargetName="Bd" Property="CornerRadius" Value="0" />
                        </Trigger>

                        <Trigger Property="IsEnabled"
                                 Value="false">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource SyncOrangeCheckListBoxItemStyle}" TargetType="{x:Type local:CheckListBoxItem}" />
</ResourceDictionary>