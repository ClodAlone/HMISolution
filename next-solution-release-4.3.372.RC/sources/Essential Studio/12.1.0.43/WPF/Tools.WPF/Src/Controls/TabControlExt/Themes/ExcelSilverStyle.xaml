<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
     xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
     xmlns:Sync_Resources="clr-namespace:Syncfusion.Windows.Tools.Controls.Resources"
	xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF" 
xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna" >

    <!-- Brushes -->
<Sync_Resources:ResourceWrapper x:Key="ResourceWrapperKey"/>
    <SolidColorBrush x:Key="Aero.TabControlBackgroundBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Aero.TabPanelBackgroundBrush" Color="#FFDCE2E8" />
    <Geometry x:Key="Checkmark">M 0,5.1 L 1.7,5.2 L 3.4,7.1 L 8,0.4 L 9.2,0 L 3.3,10.8 Z</Geometry>
    <Geometry x:Key="RightArrow">M 0,0 L 4,3.5 L 0,7 Z</Geometry>
    <Thickness x:Key="Aero.TabPanelPadding" Left="0" Top="0" Right="0" Bottom="0" />
    <Thickness x:Key="Aero.TabPanelMargin" Left="2" Top="2" Right="4" Bottom="0" />
    <Thickness x:Key="Aero.ContentPanelBorderThickness" Left="0" Top="0" Right="0" Bottom="0" />
    <CornerRadius x:Key="Aero.ContentPanelBorderCornerRadius" TopLeft="2" TopRight="2" BottomRight="2" BottomLeft="2" />
    <Thickness x:Key="Aero.ContentPanelInnerBorderThickness" Left="1" Top="1" Right="1" Bottom="1" />
    <Thickness x:Key="Aero.ContentPanelInnerBorderMargin" Left="3" Top="3" Right="3" Bottom="3" />
    <Thickness x:Key="Aero.ContentPanelOuterBorderThickness" Left="1" Top="1" Right="1" Bottom="1" />
    <Thickness x:Key="Aero.TabItemBorderThickness" Left="1" Top="1" Right="1" Bottom="1" />

    <SolidColorBrush x:Key="Aero.ActiveForeground" Color="Black"/>
    <SolidColorBrush x:Key="Aero.InactiveForeground" Color="Black"/>

    <SolidColorBrush x:Key="Aero.TabItemForeground" Color="#FF4D5359"/>

    <SolidColorBrush x:Key="Aero.TabHoverBorderInnerBrush" Color="#FFF5F6F7"/>

    <SolidColorBrush x:Key="Aero.TabSelectedBottomBorderBrush" Color="#D2E6FA"/>
    <SolidColorBrush x:Key="Aero.ButtonActivePathBrush" Color="Black"/>
    <SolidColorBrush x:Key="Aero.ButtonInactivePathBrush" Color="Black"/>
    <SolidColorBrush x:Key="Aero.ButtonInactiveBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Aero.ButtonActiveBorderBrush" Color="#3399FF"/>
    <SolidColorBrush x:Key="Aero.ButtonBackgroundBrush" Color="#CEEDFA"/>

    <!--<SolidColorBrush x:Key="Aero.ContentPanelBackgroundBrush" Color="#D2E6FA"/>-->
    <SolidColorBrush x:Key="Aero.ContentPanelInnerBorderBrush" Color="#FFA6ACB3"/>
    <SolidColorBrush x:Key="Aero.ContextMenuBackgroundBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Aero.ContextMenuBorderBrush" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Aero.ContextMenuBarBorderBrush" Color="#A0A0B4"/>
    <SolidColorBrush x:Key="Aero.ContextMenuBarInnerBorderBrush" Color="White"/>
    <SolidColorBrush x:Key="Aero.MenuItemBorderBrush" Color="#96D9F9"/>

    <LinearGradientBrush x:Key="Aero.ContextMenuBarBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#F4F7FC" Offset="0" />
            <GradientStop Color="#D4D8E6" Offset="1" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Aero.MenuItemBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#F1F8FB" Offset="0" />
            <GradientStop Color="#BAE4F6" Offset="1" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TabBackground.Aero" Color="#F9F9F9"/>
   
	
	<LinearGradientBrush x:Key="Aero.TabBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
					<GradientStop Color="#FFE0E4E8" Offset="0"/>
					<GradientStop Color="#FFE5E9EC" Offset="0.748"/>
					<GradientStop Color="#FFEEF0F2" Offset="1"/>
				</LinearGradientBrush>
				
    <SolidColorBrush x:Key="Aero.TabInnerBorderBrush" Color="#FFF5F6F7"/>

    <SolidColorBrush x:Key="Aero.TabBorderBrush" Color="#FFA6ACB3"/>   
	
	<LinearGradientBrush x:Key="Aero.HoverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
					<GradientStop Color="#FFE9ECEE" Offset="0"/>
					<GradientStop Color="#FFF0F2F4" Offset="0.775"/>
					<GradientStop Color="#FFF1F3F5" Offset="1"/>
				</LinearGradientBrush>

    <SolidColorBrush x:Key="Aero.TabHoverBorderBrush" Color="#FFA6ACB3"/>

    <LinearGradientBrush x:Key="Aero.TabSelectedBackgroundBrush"  EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFB9BEC4" Offset="0"/>
        <GradientStop Color="#FFF5F6F7" Offset="0.018"/>
        <GradientStop Color="White" Offset="0.089"/>
    </LinearGradientBrush>  

    <SolidColorBrush x:Key="Aero.ContentPanelBorderBrush" Color="#FF728EAD"/>


    <local:ImageAlignmentToDockConverter x:Key="ImageAlignmentToDockConverter"/>

    <DataTemplate x:Key="HeaderDataTemplate" DataType="{x:Type local:TabItemExt}">
        <TextBlock Focusable="False" Text="{Binding FallbackValue=''}" TextTrimming="CharacterEllipsis" 
				   IsHitTestVisible="False" Padding="0" />
    </DataTemplate>

    <DataTemplate x:Key="EditableDataTemplate" DataType="{x:Type local:TabItemExt}">
        <TextBox x:Name="EditableHeader" Focusable="True" Style="{Binding Path=EditHeaderItemStyle, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}"
				 Text="{Binding Path=Header, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabItemExt}}, Mode=TwoWay}"  
				 IsReadOnly="False" Padding="0" />
    </DataTemplate>

    <LinearGradientBrush x:Key="background" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFCFDFD" Offset="0"/>
        <GradientStop Color="#FFE5EAF5" Offset="0.3"/>
        <GradientStop Color="#FFCFD7EB" Offset="0.3"/>
        <GradientStop Color="#FFE0E5F5" Offset="0.7"/>
        <GradientStop Color="#FFECEEFC" Offset="1"/>
    </LinearGradientBrush>


    <SolidColorBrush x:Key="ExcelButtonActivePathBrush" Color="#FF576B82"/>
    <SolidColorBrush x:Key="ExcelButtonInactivePathBrush" Color="#FF576B82"/>
    <SolidColorBrush x:Key="ExcelButtonInactiveBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ExcelButtonMouseOverBackground" Color="#FFFDE47B" />
    <SolidColorBrush x:Key="ExcelButtonMouseOverBorderBrush" Color="#FFE8BF3A" />
    <SolidColorBrush x:Key="ExcelSilverButtonActivePathBrush" Color="#FF4C535C"/>
    <SolidColorBrush x:Key="ExcelSilverButtonInactivePathBrush" Color="#FF4C535C"/>



    <ControlTemplate TargetType="{x:Type TabItem}" 
                                     x:Key="newtabitem">
        <Border BorderThickness="0" 
                                Margin="2,0,0,0"  Name="Bd"
                                BorderBrush="AliceBlue" 
                                Background="{StaticResource background}"
                                CornerRadius="5,5,0,0">
        </Border>
    </ControlTemplate>


    <local:CloseButtonTypeToVisibilityConverter x:Key="CloseButtonTypeToVisibilityConverter"/>
    <shared:BooleanToVisibilityConverterEx x:Key="BooleanToVisibilityConverterEx"/>


    <ControlTemplate x:Key="CloseButtonTemplate" TargetType="{x:Type ButtonBase}">
        <shared:Border3D x:Name="brdBack" BorderThickness="1"
                BorderBrush="{StaticResource Aero.ButtonInactiveBorderBrush}">
            <Path Name="pathButton" SnapsToDevicePixels="True"
				Stroke="{StaticResource Aero.ButtonInactivePathBrush}"
				StrokeThickness="1.5"
                Data="M1,1 L7,7 M1,7 L7,1"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8"/>
        </shared:Border3D>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="brdBack" Property="IsInverted" Value="True"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource Aero.ButtonBackgroundBrush}"/>
                <Setter TargetName="brdBack" Property="BorderBrush" Value="{StaticResource Aero.ButtonActiveBorderBrush}"/>
                <Setter TargetName="pathButton" Property="Stroke" Value="{StaticResource Aero.ButtonActivePathBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <ControlTemplate x:Key="MenuButtonTemplate" TargetType="{x:Type ButtonBase}">
        <shared:Border3D x:Name="brdBack" BorderThickness="1"
                BorderBrush="{StaticResource Aero.ButtonInactiveBorderBrush}">
            <Path Name="pathButton" SnapsToDevicePixels="True"
				Fill="{StaticResource Aero.ButtonInactivePathBrush}"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8">
                <Path.Data>
                    <GeometryGroup>
                        <PathGeometry>
                            <PathFigure StartPoint="0,1" IsFilled="True" IsClosed="True">
                                <LineSegment Point="8,1"/>
                                <LineSegment Point="8,3"/>
                                <LineSegment Point="0,3"/>
                            </PathFigure>
                        </PathGeometry>
                        <PathGeometry>
                            <PathFigure StartPoint="0,4" IsFilled="True" IsClosed="True">
                                <LineSegment Point="4,8"/>
                                <LineSegment Point="8,4"/>
                            </PathFigure>
                        </PathGeometry>
                    </GeometryGroup>
                </Path.Data>
            </Path>
        </shared:Border3D>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=IsAllItemsVisible,RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter TargetName="pathButton" Property="Data" Value="M0,4 L4,8 L8,4 z"/>
            </DataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="brdBack" Property="IsInverted" Value="True"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource Aero.ButtonBackgroundBrush}"/>
                <Setter TargetName="brdBack" Property="BorderBrush" Value="{StaticResource Aero.ButtonActiveBorderBrush}"/>
                <Setter TargetName="pathButton" Property="Fill" Value="{StaticResource Aero.ButtonActivePathBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ExcelSilverTabScrollingButton" TargetType="{x:Type Button}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <shared:Border3D x:Name="PART_Border" VerticalAlignment="Center" HorizontalAlignment="Center"
				Margin="1,0,0,0"
                Padding="1"
                Width="15"
                Height="15"
                BorderThickness="1"
                BorderBrush="{StaticResource ExcelButtonInactiveBorderBrush}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True"
				CornerRadius="0">
                        <Canvas Width="8" Height="7">
                            <Path Data="M0,0L4,3.5 0,7" HorizontalAlignment="Center" Stroke="{StaticResource ExcelSilverButtonInactivePathBrush}" Fill="{StaticResource ExcelSilverButtonInactivePathBrush}" Name="PART_Path1" VerticalAlignment="Center"/>
                            <Path Data="M4,0L8,3.5 4,7" HorizontalAlignment="Center" Stroke="{StaticResource ExcelSilverButtonInactivePathBrush}" Fill="{StaticResource ExcelSilverButtonInactivePathBrush}" Name="PART_Path2" VerticalAlignment="Center"/>
                            <Path Data="M5,0L5,7" HorizontalAlignment="Center" Stroke="{StaticResource ExcelSilverButtonInactivePathBrush}" Fill="{StaticResource ExcelSilverButtonInactivePathBrush}" Name="PART_Path3" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Canvas>
                    </shared:Border3D>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="LastTab">
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Path3" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="FirstTab">
                            <Setter TargetName="PART_Path2" Property="Data" Value="M8,0L4,3.5 8,7"/>
                            <Setter TargetName="PART_Path3" Property="Data" Value="M2,0L2,7"/>
                            <Setter TargetName="PART_Path1" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Path3" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="PrevPage">
                            <Setter TargetName="PART_Path1" Property="Data" Value="M4,0L0,3.5 4,7"/>
                            <Setter TargetName="PART_Path2" Property="Data" Value="M8,0L4,3.5 8,7"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="PrevTab">
                            <Setter TargetName="PART_Path1" Property="Data" Value="M4,0L0,3.5 4,7"/>
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="NextTab">
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Border" Property="IsInverted" Value="True"/>
                            <Setter Property="Content" Value="1,1,-1,-1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="PART_Border" Value="{StaticResource ExcelButtonMouseOverBackground}"/>
                            <Setter Property="BorderBrush" TargetName="PART_Border" Value="{StaticResource ExcelButtonMouseOverBorderBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path1" Value="{StaticResource ExcelButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path1" Value="{StaticResource ExcelButtonActivePathBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path2" Value="{StaticResource ExcelButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path2" Value="{StaticResource ExcelButtonActivePathBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path3" Value="{StaticResource ExcelButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path3" Value="{StaticResource ExcelButtonActivePathBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TabPanelAdvStyle" TargetType="{x:Type local:TabPanelAdv}">
        <Setter Property="Padding" Value="0,0,0,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabPanelAdv}">
                    <Border Name="Bord" Background="{Binding TabPanelBackground,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:TabControlExt}},FallbackValue=Transparent}"                           
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Height="16"
							Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}"
							CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top">
							
                        <DockPanel LastChildFill="True">
                            <Border Name="BottomBorder" Height="0" DockPanel.Dock="Bottom" Background="Transparent" />


                            <ContentPresenter x:Name="PART_CustomItems"  AllowDrop="False" ContentSource="TabPanelItem"
                                              MaxHeight="{Binding Path=ActualHeight, ElementName=PART_TabItems}" Margin="2,0,0,0" DockPanel.Dock="Right" 
                                              Content="{Binding Path=TabPanelItem, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=''}">

                            </ContentPresenter>
                            <local:NewTabLayout>
                                <ContentPresenter x:Name="PART_ToolBarTray" Content="{Binding Path=ToolBarTray, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=''}" />
                                <local:TabItemExt BorderThickness="80" Name="PART_NewTab" DockPanel.Dock="Top" IsNewTab="True" />
                            </local:NewTabLayout>
                            <ToggleButton Name="PART_CloseButton" Width="14" Height="14" 
                                  DockPanel.Dock="Right"
                                  Focusable="False" 
                                  AllowDrop="False"
                                  Visibility="{Binding Path=CloseButtonType, Converter={StaticResource CloseButtonTypeToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=Collapsed}"
							      Template="{StaticResource CloseButtonTemplate}"
                                  Command="local:TabControlCommands.CloseCurrentTabItem"  >
                                <ToggleButton.ToolTip>
                                    <ToolTip Name="tooltip" >
                                        <TextBlock Name="tooltipText" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=CloseButtonTooltipText}"/>
                                    </ToolTip>
                                </ToggleButton.ToolTip>
                            </ToggleButton>

                            <ToggleButton Name="PART_MenuButton" Width="14" Height="14" 
                                  DockPanel.Dock="Right"
                                  AllowDrop="False"
                                  Focusable="True"
                                  Visibility="{Binding Path=ShowTabListContextMenu, Converter={StaticResource BooleanToVisibilityConverterEx}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=Collapsed}"
							      Template="{StaticResource MenuButtonTemplate}"
                                  Command="local:TabControlCommands.OpenContextMenu"
                                  >
                                <ToggleButton.ToolTip>
                                    <ToolTip Name="PART_ContextMenuButtonTooltip" >
                                        <TextBlock Name="PART_ContextMenuButtonTooltipText" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=ContextMenuButtonTooltipText}" />
                                    </ToolTip>
                                </ToggleButton.ToolTip>
                            </ToggleButton>

                            <Button Name="PART_LastTab" DockPanel.Dock="Right" Tag="LastTab" Style="{StaticResource ExcelSilverTabScrollingButton}"/>
                            <Button Name="PART_NextTab" DockPanel.Dock="Right" Tag="NextTab" Style="{StaticResource ExcelSilverTabScrollingButton}"/>
                            <Button Name="PART_PrevTab" DockPanel.Dock="Right" Tag="PrevTab" Style="{StaticResource ExcelSilverTabScrollingButton}"/>
                            <Button Name="PART_NextPage" DockPanel.Dock="Right" Tag="NextPage" Style="{StaticResource ExcelSilverTabScrollingButton}"/>
                            <Button Name="PART_PrevPage" DockPanel.Dock="Right" Tag="PrevPage" Style="{StaticResource ExcelSilverTabScrollingButton}"/>
                            <Button Name="PART_FirstTab" DockPanel.Dock="Right" Tag="FirstTab" Style="{StaticResource ExcelSilverTabScrollingButton}"/>

                            <ContentPresenter x:Name="PART_TabItems" ContentSource="TabItems" 
                                              DockPanel.Dock="Right" 
                                              Content="{TemplateBinding Content}"/>


                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>

                        <DataTrigger Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}},FallbackValue=Top}" Value="Bottom">
                            <Setter Property="LayoutTransform" TargetName="PART_CustomItems">
                                <Setter.Value>
                                    <RotateTransform Angle="-180"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="LayoutTransform" TargetName="PART_CloseButton">
                                <Setter.Value>
                                    <RotateTransform Angle="-180"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="LayoutTransform" TargetName="PART_MenuButton">
                                <Setter.Value>
                                    <RotateTransform Angle="-180"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsAllTabsClosed,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=false}" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_MenuButton" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="BottomBorder" Property="Height" Value="0"/>
                        </DataTrigger>
			<MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=Items.Count,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:TabControlExt}},FallbackValue=0}" Value="1" />
                                <Condition Binding="{Binding Path=HideHeaderOnSingleChild,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:TabControlExt}}}" Value="True" />
                                <Condition Binding="{Binding Path=ShowTabListContextMenu,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:TabControlExt}}}" Value="False" />
                                <Condition Binding="{Binding ElementName=PART_CloseButton, Path=Visibility}"  Value="Collapsed"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bord" Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="VS2008DragMarkerStyle" TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
        <Setter Property="MinWidth" Value="15"/>
        <Setter Property="MinHeight" Value="15"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
                    <DockPanel x:Name="PART_DockPanel" Height="{Binding Path=MinHeight,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DragMarkerAdorner}}}" LastChildFill="True">
                        <Canvas x:Name="PART_Top" HorizontalAlignment="Left" VerticalAlignment="Top" Height="2" Width="5" DockPanel.Dock="Top">
                            <Path Data="M0,0L2.5,3 5,0L0,0L2.5,3" Fill="{Binding Path=MarkerColor,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DragMarkerAdorner}}}" Stroke="{Binding Path=MarkerColor,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DragMarkerAdorner}}}"/>
                        </Canvas>
                        <Border x:Name="PART_Center" MinHeight="{Binding Path=ActualHeight, ElementName=PART_DockPanel}" VerticalAlignment="Top" Margin="2,0,-3,0" HorizontalAlignment="Center" BorderThickness="1,0,0,0" BorderBrush="{Binding Path=MarkerColor,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DragMarkerAdorner}}}">
                        </Border>
                        <Canvas x:Name="PART_Bottom" Height="2" Width="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" DockPanel.Dock="Bottom">
                            <Path Data="M0,3L2.5,0 5,3L0,3L2.5,0" Fill="{Binding Path=MarkerColor,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DragMarkerAdorner}}}" Stroke="{Binding Path=MarkerColor,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DragMarkerAdorner}}}"/>
                        </Canvas>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <!--Top-->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DragMarkerAdorner}},FallbackValue=Top}" Value="Top"/>
                                <Condition Binding="{Binding Path=AdornerAlignment,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DragMarkerAdorner}}}" Value="LeftSide"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="RenderTransform" TargetName="PART_Top">
                                <Setter.Value>
                                    <TranslateTransform X="6" Y="-3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform" TargetName="PART_Center">
                                <Setter.Value>
                                    <TranslateTransform Y="-3" X="8"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform" TargetName="PART_Bottom" >
                                <Setter.Value>
                                    <TranslateTransform X="0"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DragMarkerAdorner}},FallbackValue=Top}" Value="Top"/>
                                <Condition Binding="{Binding Path=AdornerAlignment,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DragMarkerAdorner}}}" Value="RightSide"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="RenderTransform" TargetName="PART_Top">
                                <Setter.Value>
                                    <TranslateTransform X="-3.5" Y="-3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform" TargetName="PART_Center">
                                <Setter.Value>
                                    <TranslateTransform X="-1.5" Y="-2"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform" TargetName="PART_Bottom">
                                <Setter.Value>
                                    <TranslateTransform X="-4.5"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <!--End Top-->

                        <!--Bottom-->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DragMarkerAdorner}},FallbackValue=Top}" Value="Bottom"/>
                                <Condition Binding="{Binding Path=AdornerAlignment,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DragMarkerAdorner}}}" Value="LeftSide"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="RenderTransform" TargetName="PART_Top">
                                <Setter.Value>
                                    <TranslateTransform X="8.5" Y="-2"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform" TargetName="PART_Center">
                                <Setter.Value>
                                    <TranslateTransform Y="-2" X="10.5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform" TargetName="PART_Bottom">
                                <Setter.Value>
                                    <TranslateTransform X="7.5"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>

