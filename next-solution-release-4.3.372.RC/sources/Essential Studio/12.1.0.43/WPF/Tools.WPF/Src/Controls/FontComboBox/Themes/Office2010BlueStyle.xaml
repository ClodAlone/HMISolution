        <GradientStop Color="#FF505153" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Office2010BlueToggleButtonArrowBorderBrush" EndPoint="0.614,0.647" StartPoint="0.129,0.118">
        <GradientStop Color="#FF757779" Offset="0" />
        <GradientStop Color="#FF505153" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010BlueListBoxItemBorderBrush" Color="#FFA7ABB0" />

    <SolidColorBrush x:Key="Office2010BlueListBoxItemBackground" Color="White" />

    <SolidColorBrush x:Key="White" Color="White" />

    <LinearGradientBrush x:Key="Office2010BlueToggleButtonMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF5E193" Offset="0.101" />
        <GradientStop Color="#FFF4DA7D" Offset="0.388" />
        <GradientStop Color="#FFF4DE8C" Offset="0.784" />
        <GradientStop Color="#FFF4E6B2" Offset="0.957" />
        <GradientStop Color="#FFF4EBC4" Offset="0.964" />
