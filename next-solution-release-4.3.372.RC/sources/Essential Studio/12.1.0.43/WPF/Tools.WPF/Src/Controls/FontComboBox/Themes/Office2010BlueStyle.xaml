    <LinearGradientBrush x:Key="Office2010BlueToggleButtonMouseOverBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE8C24E" />
        <GradientStop Color="#FFECCC43" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010BlueToggleButtonPressedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF3C360" Offset="0.038" />
        <GradientStop Color="#FFFAD373" Offset="0.045" />
        <GradientStop Color="#FFFEDF84" Offset="0.249" />
        <GradientStop Color="#FFFEDF84" Offset="0.962" />
        <GradientStop Color="#FFF8D375" Offset="0.968" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010BlueToggleButtonPressedBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC27A2D" Offset="0.113" />
        <GradientStop Color="#FFC29A44" Offset="0.887" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010BlueFontComboBoxMouseOverToggleButtonBorderBrush" Color="#FFABBAD0" />

    <LinearGradientBrush x:Key="Office2010BlueFontComboBoxMouseOverToggleButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFECF5FD" Offset="0.078" />
        <GradientStop Color="#FFD9E8F8" Offset="0.87" />
    </LinearGradientBrush>

    <conv:PopupHeightToThumbOffsetConverter x:Key="PopupHeightToThumbOffsetConverter" />

    <conv:FontToStringConverter x:Key="FontToStringConverter" />

    <SolidColorBrush x:Key="Office2010SilverListBoxItemBorderBrush" Color="#FFA7ABB0" />

    <SolidColorBrush x:Key="Office2010SilverListBoxItemBackground" Color="White" />

    <LinearGradientBrush x:Key="Office2010SilverToggleButtonMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF5E193" Offset="0.101" />
        <GradientStop Color="#FFF4DA7D" Offset="0.388" />
        <GradientStop Color="#FFF4DE8C" Offset="0.784" />
        <GradientStop Color="#FFF4E6B2" Offset="0.957" />
        <GradientStop Color="#FFF4EBC4" Offset="0.964" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010SilverToggleButtonMouseOverBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE8C24E" />
        <GradientStop Color="#FFECCC43" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010SilverToggleButtonPressedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF3C360" Offset="0.038" />
        <GradientStop Color="#FFFAD373" Offset="0.045" />
        <GradientStop Color="#FFFEDF84" Offset="0.249" />
        <GradientStop Color="#FFFEDF84" Offset="0.962" />
        <GradientStop Color="#FFF8D375" Offset="0.968" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010SilverToggleButtonPressedBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC27A2D" Offset="0.113" />
        <GradientStop Color="#FFC29A44" Offset="0.887" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010SilverFontComboBoxMouseOverToggleButtonBorderBrush" Color="#FFBBBFC4" />

    <LinearGradientBrush x:Key="Office2010SilverFontComboBoxMouseOverToggleButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="0.131" />
        <GradientStop Color="#FFF1F3F4" Offset="0.983" />
    </LinearGradientBrush>

    <!--Styles-->

    <Style x:Key="Office2010BlueToggleDropDownButtonStyle" TargetType="ToggleButton">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FrameworkElement.MinWidth" Value="0" />
        <Setter Property="FrameworkElement.MinHeight" Value="0" />
        <Setter Property="FrameworkElement.Width" Value="15" />
        <Setter Property="FrameworkElement.Height" Value="Auto" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Background" Value="{StaticResource Office2010BlueToggleButtonBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Office2010BlueToggleButtonBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Name="PART_Border" Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                BorderBrush="{TemplateBinding BorderBrush}">
                        <Border x:Name="innerBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                            <ContentPresenter RecognizesAccessKey="True"
                              Content="{TemplateBinding ContentControl.Content}"
                              ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                              Margin="{TemplateBinding Control.Padding}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                              ClipToBounds="True" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="utilsOuter:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FrameworkElement.Width" Value="35" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="utilsOuter:SkinStorage.EnableTouch" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Office2010SilverToggleButtonMouseOverBorderBrush}" />
                            <Setter TargetName="innerBorder" Property="BorderBrush" Value="White" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Office2010SilverToggleButtonMouseOverBackground}" />
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="1" />
                            <Setter TargetName="innerBorder" Property="BorderThickness" Value="1" />
                            <Setter Property="Margin" TargetName="PART_Border" Value="-1" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Office2010SilverToggleButtonPressedBorderBrush}" />
                            <Setter TargetName="innerBorder" Property="BorderBrush" Value="{StaticResource Office2010SilverToggleButtonPressedBackground}" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Office2010SilverToggleButtonPressedBackground}" />
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="1" />
                            <Setter TargetName="innerBorder" Property="BorderThickness" Value="1" />
                            <Setter Property="Margin" TargetName="PART_Border" Value="-1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Office2010BlueFontListComboBoxStyle" TargetType="{x:Type local:FontListComboBox}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource Office2010BlueFontListComboBoxBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Office2010BlueFontListComboBoxForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Office2010BlueFontListComboBoxBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FontListComboBox}">
                    <Border SnapsToDevicePixels="True"
				BorderThickness="1" Name="Bd1"
				BorderBrush="Transparent">
                        <Grid SnapsToDevicePixels="True">
                            <Border Name="Bd"
                        BorderThickness="{TemplateBinding Border.BorderThickness}"
						BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                        Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
						TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}">
                                <Grid Grid.IsSharedSizeScope="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="8*" />
                                        <ColumnDefinition SharedSizeGroup="ComboBoxButton" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Margin="{TemplateBinding Control.Padding}"
                                Name="SelectedItemBorder"
                                Grid.ColumnSpan="2" />
                                    <ContentPresenter Name="textBox"
                                          Margin="{TemplateBinding Control.Padding}"
                                          HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                          Content="{Binding Path=SelectedFontFamily, Converter={StaticResource FontToStringConverter},
                                                    Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                                          Grid.Column="1" />
                                    <ToggleButton Name="toggleButton"  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay,RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                                      Grid.Column="3"  Style="{StaticResource Office2010BlueToggleDropDownButtonStyle}">
                                        <Path Name="PART_Arrow"  Data="M0,0L3.5,3 7,0"  Stroke="{StaticResource Office2010BlueToggleButtonArrowBackground}" Fill="{StaticResource Office2010BlueToggleButtonArrowBorderBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" />
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup Placement="Bottom"
                       Name="PART_Popup"
			           TextBlock.Foreground="{Binding Path=ItemsForeground, Mode=TwoWay,
                        RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                       Height="{Binding Path=PopupDropDownHeight, Mode=TwoWay,
                        RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                       Focusable="False"
                       AllowsTransparency="True"
			           StaysOpen="True"
                       IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay,
                                RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}"
                       PopupAnimation="Fade">
                                <Border BorderThickness="1.5" Name="listBorder" BorderBrush="{StaticResource Office2010SilverListBoxItemBorderBrush}" CornerRadius="2" Background="{StaticResource Office2010SilverListBoxItemBackground}" ClipToBounds="True" SnapsToDevicePixels="True">
                                    <DockPanel Name="FontListBoxPanel"  LastChildFill="True" Background="White"
                                   Height="{Binding ElementName=bt, Path=Offset}" SnapsToDevicePixels="True">
                                        <local:BottomThumb  Name="bt"  Height="10" DockPanel.Dock="Bottom"
                                            Offset="{Binding Path=PopupDropDownHeight, Mode=TwoWay, Converter={ StaticResource PopupHeightToThumbOffsetConverter},
                                            ConverterParameter=6,  RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}" />
                                        <!--Style="{utilsOuter:SkinObject ScrollViewerStyle}"-->
                                        <ScrollViewer>
                                            <local:FontListBox x:Name="FontListBoxElement" DockPanel.Dock="Top" BorderBrush="Transparent"
                                    Width="{Binding Path=Width, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedFontFamily="{Binding Path=SelectedFontFamily, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    FocusedFontFamily="{Binding Path=FocusedFontFamily, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    FontsSource="{Binding Path=FontsSource, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    ThemeFonts="{Binding Path=ThemeFonts, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    RecentlyUsedFonts="{Binding Path=RecentlyUsedFonts, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    HasFocus="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    DisplayFontNamesInSystemFont="{Binding Path=DisplayFontNamesInSystemFont, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    GroupHeaderStyle="{Binding Path=GroupHeaderStyle, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    ItemTemplate="{Binding Path=ItemTemplate, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
                                    ItemContainerStyle="{Binding Path=ItemContainerStyle, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}, UpdateSourceTrigger=PropertyChanged}"
 />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="utilsOuter:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="Padding" Value="10,11,10,11" />
                            <Setter Property="Effect" TargetName="Bd">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="4" Opacity=".3" Direction="315" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Data" Value="M 0 0 L 7 7 L 14 0 Z" TargetName="PART_Arrow" />
                        </Trigger>
                        <Trigger Property="UIElement.IsEnabled" Value="False">
                            <Setter Property="TextElement.Foreground">
                                <Setter.Value>
                                    <DynamicResource ResourceKey="{x:Static SystemColors.GrayTextBrushKey}" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Panel.Background" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="textBox" Property="Content" Value="{Binding Path=FocusedFontFamily, Converter={StaticResource FontToStringConverter}, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:FontListComboBox}}}" />
                            <Setter TargetName="Bd" Property="Background" Value="White" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="False" />
                                <Condition Property="IsMouseOver" SourceName="Bd" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SelectedItemBorder" Property="BorderBrush" Value="{StaticResource Office2010SilverFontComboBoxMouseOverToggleButtonBorderBrush}" />
                            <Setter TargetName="SelectedItemBorder" Property="BorderThickness" Value="0,0,1,0" />
                            <Setter TargetName="toggleButton" Property="Background" Value="{StaticResource Office2010SilverFontComboBoxMouseOverToggleButtonBackground}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2010BlueFontListComboBoxStyle}" TargetType="{x:Type local:FontListComboBox}" />

    <Style x:Key="{x:Type local:BottomThumb}" TargetType="{x:Type local:BottomThumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BottomThumb}">
                    <Border Name="Border" SnapsToDevicePixels="True" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  Background="{StaticResource Office2010BlueFontComboBoxBottomThumbBackground}"
            BorderThickness="0" BorderBrush="{StaticResource Office2010BlueFontComboBoxBottomThumbBorderBrush}">
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Name="B1" Background="{StaticResource Office2010BlueFontComboBoxBottomThumbArrowFill}" Width="3" Height="3"  Margin="3,1,3,1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFD4E1F1" ShadowDepth="29" Direction="327" />
                                </Border.Effect>
                            </Border>
                            <Border Name="B2" Background="{StaticResource Office2010BlueFontComboBoxBottomThumbArrowFill}" Width="3" Height="3" Margin="3,1,3,1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFD4E1F1" ShadowDepth="29" Direction="327" />
                                </Border.Effect>
                            </Border>
                            <Border Name="B3" Background="{StaticResource Office2010BlueFontComboBoxBottomThumbArrowFill}" Width="3" Height="3" Margin="3,1,3,1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFD4E1F1" ShadowDepth="29" Direction="327" />
                                </Border.Effect>
                            </Border>
                            <Border Name="B4" Background="{StaticResource Office2010BlueFontComboBoxBottomThumbArrowFill}" Width="3" Height="3" Margin="3,1,3,1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFD4E1F1" ShadowDepth="29" Direction="327" />
                                </Border.Effect>
                            </Border>
                        </WrapPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>