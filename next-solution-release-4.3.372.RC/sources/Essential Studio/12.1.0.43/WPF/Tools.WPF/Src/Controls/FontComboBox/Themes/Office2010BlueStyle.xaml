    <SolidColorBrush x:Key="Office2010BlueToggleButtonBorderBrush" Color="Transparent" />

    <SolidColorBrush x:Key="Office2010BlueFontListComboBoxForeground" Color="#FF313031" />

    <SolidColorBrush x:Key="Office2010BlueFontComboBoxBottomThumbArrowFill" Color="#FF849DBD" />

    <SolidColorBrush x:Key="Office2010BlueFontComboBoxBottomThumbBorderBrush" Color="Transparent" />

