<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">

	<ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Controls/NotifyIcon/Themes/Brushes.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Controls/NotifyIcon/Themes/Resources.xaml" />
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Controls/NotifyIcon/Themes/ShinyTemplate.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Controls/NotifyIcon/Themes/Templates.xaml" />
    </ResourceDictionary.MergedDictionaries>

	<local:BalloonTipHeaderTemplateSelector x:Key="HeaderTemplateSelector" />
	<local:BalloonTipContentTemplateSelector x:Key="ContentTemplateSelector" />

	<Style x:Key="SeparatorStyle" TargetType="Separator">
		<Setter Property="Template" Value="{StaticResource SeparatorTemplate}"/>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Template" Value="{StaticResource SeparatorTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Template" Value="{StaticResource SeparatorTemplate.ShinyRed}"/>
            </Trigger>
        </Style.Triggers>
        
	</Style>

	<Style x:Key="MenuItemStyle" TargetType="{x:Type MenuItem}">
		<Setter Property="Template" Value="{StaticResource MenuItemTemplate}"/>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="Template" Value="{StaticResource Office2007MenuItemTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Template" Value="{StaticResource Office2007MenuItemTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Template" Value="{StaticResource Office2007MenuItemTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Template" Value="{StaticResource Office2003MenuItemTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Template" Value="{StaticResource BlendMenuItemTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="Template" Value="{StaticResource SyncOrangeMenuItemTemplate}"/>
            </Trigger>          
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Template" Value="{StaticResource MenuItemTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Template" Value="{StaticResource MenuItemTemplate.ShinyRed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

	<Style x:Key="BalloonTipHeaderBaseStyle" TargetType="{x:Type local:BalloonTipHeader}">
		<Setter Property="Template" Value="{StaticResource BalloonTipHeaderTemplate}" />
	</Style>

	<Style x:Key="BalloonTipBaseStyle" TargetType="{x:Type local:BalloonTip}">
		<Setter Property="Background" Value="{StaticResource Aero.NormalColor.Background}"/>
		<Setter Property="BorderBrush" Value="{StaticResource Aero.NormalColor.BorderBrush}"/>
		<Setter Property="Foreground" Value="{StaticResource Aero.NormalColor.Foreground}"/>
		<Setter Property="HeaderBackground" Value="{StaticResource Aero.NormalColor.HeaderBackground}"/>
		<Setter Property="HeaderForeground" Value="{StaticResource Aero.NormalColor.HeaderForeground}"/>

        <Setter Property="BorderThickness" Value="1"/>
		<Setter Property="IconTemplate" Value="{StaticResource BalloonTipContentIconTemplate}" />
		<Setter Property="HeaderTemplateSelector" Value="{StaticResource HeaderTemplateSelector}" />
		<Setter Property="ContentTemplateSelector" Value="{StaticResource ContentTemplateSelector}" />
		<Setter Property="Template" Value="{StaticResource BalloonTipTemplate}" />
		<Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="Background" Value="{StaticResource Office2007Blue.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Blue.BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2007Blue.Foreground}"/>
                <Setter Property="HeaderBackground"  Value="{StaticResource Office2007Blue.HeaderBackground}"/>
                <Setter Property="HeaderForeground" Value="{StaticResource Office2007Blue.HeaderForeground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Background" Value="{StaticResource Office2007Black.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Black.BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2007Black.Foreground}"/>
                <Setter Property="HeaderBackground" Value="{StaticResource Office2007Black.HeaderBackground}"/>
                <Setter Property="HeaderForeground" Value="{StaticResource Office2007Black.HeaderForeground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Background" Value="{StaticResource Office2007Silver.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Silver.BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2007Silver.Foreground}"/>
                <Setter Property="HeaderBackground" Value="{StaticResource Office2007Silver.HeaderBackground}"/>
                <Setter Property="HeaderForeground" Value="{StaticResource Office2007Silver.HeaderForeground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Background" Value="{StaticResource Office2003.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2003.BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2003.Foreground}"/>
                <Setter Property="HeaderBackground" Value="{StaticResource Office2003.HeaderBackground}"/>
                <Setter Property="HeaderForeground" Value="{StaticResource Office2003.HeaderForeground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Background" Value="{StaticResource Blend.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Blend.BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Blend.Foreground}"/>
                <Setter Property="HeaderBackground" Value="{StaticResource Blend.HeaderBackground}"/>
                <Setter Property="HeaderForeground" Value="{StaticResource Blend.HeaderForeground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="Background" Value="{StaticResource Orange.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Orange.BorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Orange.Foreground}"/>
                <Setter Property="HeaderBackground" Value="{StaticResource Orange.HeaderBackground}"/>
                <Setter Property="HeaderForeground" Value="{StaticResource Orange.HeaderForeground}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Background" Value="{StaticResource BackgroundBrushKey.ShinyRed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushKey.ShinyRed}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
                <Setter Property="HeaderBackground" Value="{StaticResource HeaderBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="HeaderForeground" Value="{StaticResource HeaderTextBrushKey.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Background" Value="{StaticResource BackgroundBrushKey.ShinyRed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushKey.ShinyRed}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
                <Setter Property="HeaderBackground" Value="{StaticResource HeaderBackgroundBrushKey.ShinyBlue}"/>
                <Setter Property="HeaderForeground" Value="{StaticResource HeaderTextBrushKey.ShinyRed}"/>
            </Trigger>
            <Trigger Property="BalloonTipHeaderVisibility" Value="Visible">
				<Setter Property="Background" Value="{StaticResource Aero.NormalColor.BackgroundWithHeader}"/>
				<Setter Property="BorderBrush" Value="{StaticResource Aero.NormalColor.BorderBrushWithHeader}"/>
				<Setter Property="Foreground" Value="{StaticResource Aero.NormalColor.ForegroundWithHeader}"/>
			</Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Office2007Blue.BackgroundWithHeader}"/>
                <Setter Property="BorderBrush"  Value="{StaticResource Office2007Blue.BorderBrushWithHeader}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2007Blue.ForegroundWithHeader}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Black"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Office2007Black.BackgroundWithHeader}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Black.BorderBrushWithHeader}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2007Black.ForegroundWithHeader}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Office2007Silver.BackgroundWithHeader}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Silver.BorderBrushWithHeader}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2007Silver.ForegroundWithHeader}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2003"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Office2003.BackgroundWithHeader}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2003.BorderBrushWithHeader}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2003.ForegroundWithHeader}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Blend"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Blend.BackgroundWithHeader}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Blend.BorderBrushWithHeader}"/>
                <Setter Property="Foreground" Value="{StaticResource Blend.ForegroundWithHeader}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="SyncOrange"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Orange.BackgroundWithHeader}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Orange.BorderBrushWithHeader}"/>
                <Setter Property="Foreground" Value="{StaticResource Orange.ForegroundWithHeader}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyRed"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource BackgroundWithHeader.ShinyRed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushKey.ShinyRed}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource BackgroundWithHeader.ShinyRed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushKey.ShinyRed}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
            </MultiTrigger>
            <Trigger Property="BalloonTipShape" Value="Balloon">
				<Setter Property="Border.CornerRadius" Value="10" />
			</Trigger>
			<Trigger Property="BalloonTipShape" Value="Rectangle">
				<Setter Property="Border.CornerRadius" Value="0" />
			</Trigger>
			<Trigger Property="BalloonTipShape" Value="RoundedRectangle">
				<Setter Property="Border.CornerRadius" Value="20" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="NotifyIconBaseStyle" TargetType="{x:Type local:NotifyIcon}">
        <Setter Property="Background" Value="{StaticResource Aero.NormalColor.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Aero.NormalColor.BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Aero.NormalColor.Foreground}"/>
        <Setter Property="HeaderBackground" Value="{StaticResource Aero.NormalColor.HeaderBackground}"/>
        <Setter Property="HeaderForeground" Value="{StaticResource Aero.NormalColor.HeaderForeground}"/>
        <Setter Property="BorderThickness" Value="1" />
		<Setter Property="IconTemplate" Value="{StaticResource BalloonTipContentIconTemplate}" />
		<Setter Property="ToolTipTemplate" Value="{StaticResource ToolTipContentTemplate}" />
		<Setter Property="HeaderTemplateSelector" Value="{StaticResource HeaderTemplateSelector}" />
		<Setter Property="ContentTemplateSelector" Value="{StaticResource ContentTemplateSelector}" />
		<Setter Property="Template" Value="{StaticResource NotifyIconTemplate}" />
		<Style.Triggers>
            <Trigger Property="BalloonTipHeaderVisibility" Value="Visible">
                <Setter Property="Background" Value="{StaticResource Aero.NormalColor.BackgroundWithHeader}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Aero.NormalColor.BorderBrushWithHeader}"/>
                <Setter Property="Foreground" Value="{StaticResource Aero.NormalColor.ForegroundWithHeader}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Office2007Blue.BackgroundWithHeader}"/>
                <Setter Property="BorderBrush"  Value="{StaticResource Office2007Blue.BorderBrushWithHeader}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2007Blue.ForegroundWithHeader}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Black"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Office2007Black.BackgroundWithHeader}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Black.BorderBrushWithHeader}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2007Black.ForegroundWithHeader}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Office2007Silver.BackgroundWithHeader}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Silver.BorderBrushWithHeader}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2007Silver.ForegroundWithHeader}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2003"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Office2003.BackgroundWithHeader}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2003.BorderBrushWithHeader}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2003.ForegroundWithHeader}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Blend"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Blend.BackgroundWithHeader}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Blend.BorderBrushWithHeader}"/>
                <Setter Property="Foreground" Value="{StaticResource Blend.ForegroundWithHeader}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="SyncOrange"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Orange.BackgroundWithHeader}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Orange.BorderBrushWithHeader}"/>
                <Setter Property="Foreground" Value="{StaticResource Orange.ForegroundWithHeader}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyRed"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource BackgroundWithHeader.ShinyRed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushKey.ShinyRed}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue"/>
                    <Condition Property="BalloonTipHeaderVisibility" Value="Visible"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource BackgroundWithHeader.ShinyRed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushKey.ShinyRed}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
            </MultiTrigger>
        </Style.Triggers>
	</Style>

</ResourceDictionary>