<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    	xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
					xmlns:utilsOuter="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/generic.contextmenu.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/CollapseButTemp.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/generic.animation.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/generic.navigationtoolbarmenu.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/generic.scroll.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.Wpf;component/Controls/GroupBar/Themes/syncorange.resources.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Themes/LangDictionary.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <local:HeaderTrimmingTemplate x:Key="HeaderTrimmingTemplate"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <!-- GroupBar StackedMode Template -->
    <ControlTemplate x:Key="Orange_GroupBarStackedTemplateKey" TargetType="{x:Type local:GroupBar}">
        <Grid Name="MainHost"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True"
			  Background="Transparent">
            <Grid.LayoutTransform>
                <TransformGroup>
                    <RotateTransform Angle="{Binding Path=RotationAngle, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}" />
                </TransformGroup>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="{Binding Path=ItemContentLength, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Name="HeaderHost"
					Grid.Row="0"
					Style="{Binding Path=GroupBarHeaderStyle, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					KeyboardNavigation.IsTabStop="False">
                <DockPanel Name="HeaderDockPanel"
                  Margin="{Binding Path=HeaderMarginRight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}">
                    <Border DockPanel.Dock="Right"
                            Width="5"/>
                    <ToggleButton Name="CloseButton" 
                                  DockPanel.Dock="Right"
                                  Grid.Column="1"
								  ClickMode="Press"
                                  Margin="2"
                                  Width="16"
                                  Height="15"
                                  Visibility="Collapsed"
                                  Command="local:GroupBar.m_closeButtonCommand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Name="CloseButtonContentBorder"
                                                    Background="{Binding Path=CollapseButtonBackground, 
                                                                 RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
                                                    BorderBrush="Transparent">
                                                <Path Name="pathButton" SnapsToDevicePixels="False" Stretch="Fill" StrokeThickness="1.5"
                                                      Stroke="{StaticResource Orange_CollapseArrowColor}"
                                                      Data="M109,51 L216,142 M215,52 L109,142"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Width="9" Height="8"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger SourceName="CloseButtonContentBorder" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseButtonContentBorder" Property="Background" 
                                                            Value="{Binding Path=CollapseButtonMouseOverBackground, 
                                                                    RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <ToggleButton Name="CollapseButton" Template="{Binding Path=CollapseButtonTemplate, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
                                  DockPanel.Dock="Right"
                                  Grid.Column="1"
								  ClickMode="Press"
								  IsChecked="{Binding Path=IsCollapsed, RelativeSource={RelativeSource TemplatedParent}}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="FrameworkElement.Focusable" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=(local:GroupBar.AllowCollapse), RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
					                             Value="False" >
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <ContentPresenter Name="HeaderContent"
                                      VerticalAlignment="Center"
				                      ContentSource="SelectedHeader"
                                      Content="{TemplateBinding SelectedHeader}"
                                      ContentTemplateSelector="{StaticResource HeaderTrimmingTemplate}"/>

                </DockPanel>
            </Border>
            <StackPanel Grid.Row="1">
                <Border Name="ContentHostBorder"
					Height="{TemplateBinding ItemContentLength}"
					BorderThickness="{TemplateBinding BorderThickness}"
					Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					KeyboardNavigation.IsTabStop="False"
					KeyboardNavigation.TabNavigation="None">
                    <ContentPresenter Name="ContentHost" ContentSource="SelectedContent">
                        <ContentPresenter.LayoutTransform>
                            <TransformGroup>
                                <RotateTransform Angle="{Binding Path=ContentRotationAngle, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"/>
                            </TransformGroup>
                        </ContentPresenter.LayoutTransform>
                    </ContentPresenter>
                </Border>
                <ToggleButton Name="CollapsedContentToggleButton"					
					Height="{TemplateBinding ItemContentLength}"
                    Command="local:GroupBar.m_popupCommand">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Name="CollapsedContentHostBorder"
                                            Background="{StaticResource Orange_NavigationPaneColor}"
                                            BorderThickness="1,0,1,0"
                                            BorderBrush="{StaticResource Orange_NavigationPaneBorderColor}">
                                            <TextBlock Name="ToggleButtonText"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Text="Navigation Pane"
                                                Foreground="{StaticResource Orange_NavigationPaneTextColor}"
                                                FontSize="14">
                                                <TextBlock.LayoutTransform>
                                                    <TransformGroup>
                                                        <RotateTransform Angle="270"/>
                                                    </TransformGroup>
                                                </TextBlock.LayoutTransform>
                                            </TextBlock>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger SourceName="CollapsedContentHostBorder" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CollapsedContentHostBorder" Property="ToolTip" Value="Click to expand groupbar item header"/>
                                                <Setter TargetName="CollapsedContentHostBorder" Property="Cursor" Value="Hand"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CollapsedContentHostBorder" Property="Background" Value="{StaticResource Orange_NavigationPaneMouseOverColor}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Path=(local:GroupBar.Orientation), 
                                                RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}" Value="Horizontal" >
                                                <Setter TargetName="ToggleButtonText" Property="LayoutTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </StackPanel>
            <local:GroupBarSplitter Name="Splitter"
									Height="8"
									Grid.Row="2"
									DragIncrement="{TemplateBinding ItemHeaderHeight}"
									KeyboardNavigation.IsTabStop="False"
									Focusable="True"
									BorderThickness="1,1,1,0"
									BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
									Margin="0"/>
            <Border Name="StackItemsHost"
					Grid.Row="3"
					BorderThickness="{TemplateBinding BorderThickness}"
          Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					Height="Auto"
					Focusable="False">
                <ItemsPresenter/>
            </Border>
            <local:NavigationToolbar
				Height="{TemplateBinding StackItemHostHeight}"
				Width="{Binding ElementName=MainHost, Path=ActualWidth}"
				BorderThickness="1,0,1,1"
				Grid.Row="4"
				Background="{StaticResource Orange_NavigationToolbar_BackgroundBrush}"
				Name="NavigationToolbar"
				KeyboardNavigation.IsTabStop="False"
				Focusable="False"/>
            <Popup Name="PART_Popup"
                       Focusable="False"
                       AllowsTransparency="True"
			           StaysOpen="False"                       
                       IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, 
                               RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
                       PopupAnimation="Fade">
                <Border Name="PopupResizePart"
                               Background="{StaticResource Orange_PopupBorderFillColor}"
                               BorderThickness="1"
                               BorderBrush="{StaticResource Orange_NavigationPaneBorderColor}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10" Name="PopupGripperRow"/>
                        </Grid.RowDefinitions>
                        <Border Name="PopupInnerBorder" Grid.Row="0" 
                                Margin="5,5,5,0"
                                BorderThickness="1"
                                BorderBrush="{StaticResource Orange_NavigationPaneBorderColor}">
                            <ContentPresenter Name="PopupContentHost" Focusable="True"/>
                        </Border>
                        <Canvas Name="PopupGripper" Grid.Row="1"
                                Height="10" RenderTransformOrigin="0.5,0.5" 
                                Visibility="{Binding Path=ShowGripper, RelativeSource={RelativeSource TemplatedParent}, 
                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Canvas.RenderTransform>
                                <RotateTransform Angle="180"/>
                            </Canvas.RenderTransform>
                            <Line Stroke="{StaticResource Orange_NavigationPaneBorderColor}"
                                  StrokeThickness="1" 
                                  X1="1" Y1="3" X2="3" Y2="1"/>
                            <Line Stroke="{StaticResource Orange_NavigationPaneBorderColor}"
                                  StrokeThickness="1" 
                                  X1="1" Y1="6" X2="6" Y2="1"/>
                            <Line Stroke="{StaticResource Orange_NavigationPaneBorderColor}"
                                  StrokeThickness="1" 
                                  X1="1" Y1="9" X2="9" Y2="1"/>
                        </Canvas>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="ShowGripper" Value="False">
                <Setter TargetName="PopupGripperRow" Property="Height" Value="5"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="Splitter" Property="Cursor" Value="SizeWE"/>
            </Trigger>
            <Trigger Property="IsCollapsed" Value="False">
                <Setter TargetName="CollapsedContentToggleButton" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="ContentHostBorder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsCollapsed" Value="True">
                <Setter TargetName="HeaderDockPanel" Property="Margin" Value="0"/>
                <Setter TargetName="HeaderContent" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="CollapsedContentToggleButton" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ContentHostBorder" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsToolBarEnabled" Value="True">
                <Setter TargetName="Splitter" Property="Visibility" Value="Visible"/>
                <!--<Setter TargetName="StackItemsHost" Property="Visibility" Value="Visible"/>-->
                <!--<Setter TargetName="NavigationToolbar" Property="Visibility" Value="Visible"/>-->
            </Trigger>
            <Trigger Property="IsToolBarEnabled" Value="False">
                <Setter TargetName="Splitter" Property="Visibility" Value="Collapsed"/>
                <!--<Setter TargetName="StackItemsHost" Property="Visibility" Value="Collapsed"/>-->
                <!--<Setter TargetName="NavigationToolbar" Property="Visibility" Value="Collapsed"/>-->
                <Setter TargetName="HeaderHost" Property="TextBlock.TextAlignment" Value="Left"/>
                <Setter TargetName="HeaderHost" Property="Padding" Value="5,1,1,1"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsToolBarEnabled" Value="False"/>
                    <Condition Property="IsCollapsed" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="CloseButton" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
            <Trigger SourceName="CloseButton" Property="IsChecked" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- GroupBar MultipleExpansion Template -->
    <ControlTemplate x:Key="Orange_GroupBarMultipleExpansionTemplateKey" TargetType="{x:Type local:GroupBar}">
        <Grid Name="MainHost"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True"
			  Background="Transparent">
            <Grid.LayoutTransform>
                <TransformGroup>
                    <RotateTransform Angle="{Binding Path=RotationAngle, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}" />
                </TransformGroup>
            </Grid.LayoutTransform>
            <Border Name="ItemsHost"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					BorderThickness="1,0,1,1"
					BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}">
                <ScrollViewer Name="ScrollViewer"
                              Margin="{Binding Path=ScrollViewerMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
							  Focusable="False"
							  VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter/>
                </ScrollViewer>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- GroupBar NonStackedMode Template -->
    <ControlTemplate x:Key="Orange_GroupBarNonStackedTemplateKey" TargetType="{x:Type local:GroupBar}">
        <Grid Name="MainHost"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True"
			  Background="Transparent">
            <Grid.LayoutTransform>
                <TransformGroup>
                    <RotateTransform Angle="{Binding Path=RotationAngle, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"/>
                </TransformGroup>
            </Grid.LayoutTransform>
            <Border Name="ItemsHost"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					BorderThickness="{TemplateBinding BorderThickness}"
					BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}">
                <ItemsPresenter Margin="{Binding Path=ScrollViewerMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"/>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- GroupBarItem NonStackedMode Template -->
    <ControlTemplate x:Key="Orange_GroupBarItemNonStackedTemplateKey" TargetType="{x:Type local:GroupBarItem}">
        <Grid Name="MainGrid"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Name="HeaderGrid"
				  Grid.Row="0"
				  ClipToBounds="True"
				  Cursor="{Binding Path=GroupBarItemCursor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				  Height="{Binding Path=ItemHeaderHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				  Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="0.5*"/>
                </Grid.RowDefinitions>
                <Border Name="HeaderHost"
					Grid.Row="0"
					Grid.RowSpan="2"
					Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}"
					BorderBrush="{StaticResource Orange_GroupViewItem_SeparatorBrush}"
					BorderThickness="0,0,0,1">
                    <ContentPresenter Content="{TemplateBinding Header}"
									  ContentTemplate="{TemplateBinding HeaderTemplate}"
									  ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"/>
                </Border>
            </Grid>
            <Border Name="ContentHostBorder"
					Grid.Row="1"
					BorderBrush="{StaticResource Orange_GroupViewItem_SeparatorBrush}"
					BorderThickness="0,0,0,1"
					Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}">
                <Border.LayoutTransform>
                    <TransformGroup>
                        <RotateTransform Angle="{Binding Path=ContentRotationAngle, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"/>
                    </TransformGroup>
                </Border.LayoutTransform>
                <ContentPresenter Name="ContentHost"
								  Content="{TemplateBinding Content}"
								  ContentTemplate="{TemplateBinding ContentTemplate}"
								  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsLastItem" Value="True"/>
                    <Condition Property="IsExpanded" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter  Property="BorderThickness" TargetName="HeaderHost"  Value="0"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsLastItem" Value="True"/>
                    <Condition Property="IsExpanded" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderThickness" TargetName="ContentHostBorder"  Value="0"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource GroupBarItem_SelectedStoryboard}"/>
                </MultiTrigger.EnterActions>
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Orange_GroupBarItem_SelectedBackgroundBrush}"/>
            </MultiTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Orange_GroupBarItem_OverBackgroundBrush}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Orange_GroupBarItem_OverSelectedBackgroundBrush}"/>
            </MultiTrigger>
            <Trigger Property="IsContextMenuOpened" Value="True">
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Orange_GroupBarItem_OverBackgroundBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- GroupBarItem MultipleExpansion Template -->
    <ControlTemplate x:Key="Orange_GroupBarItemMultipleExpansionTemplateKey" TargetType="{x:Type local:GroupBarItem}">
        <Grid Name="MainGrid"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <Border Name="HeaderHost"
						Height="{Binding Path=ItemHeaderHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						ClipToBounds="True"
						Cursor="{Binding Path=GroupBarItemCursor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}"
						BorderBrush="{StaticResource Orange_GroupViewItem_SeparatorBrush}"
						BorderThickness="0,1,0,0">
                    <DockPanel>
                        <ToggleButton Name="Expander" DockPanel.Dock="Left"
									  ClickMode="Press"
									  IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="FrameworkElement.Focusable" Value="False"/>
                                    <Setter Property="FrameworkElement.Width" Value="19"/>
                                    <Setter Property="FrameworkElement.Height" Value="13"/>
                                    <Setter Property="Control.Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Height="13" Width="19" Background="#00FFFFFF">
                                                    <Border Height="9" BorderBrush="#FF7898B5" CornerRadius="1,1,1,1" Width="9" BorderThickness="1,1,1,1" SnapsToDevicePixels="True">
                                                        <Border.Background>
                                                            <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                                                <LinearGradientBrush.GradientStops>
                                                                    <GradientStop Offset="0.2" Color="#FFFFFFFF"/>
                                                                    <GradientStop Offset="1" Color="#FFC0B7A6"/>
                                                                </LinearGradientBrush.GradientStops>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Path Margin="1,1,1,1" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" Fill="#FF000000" Name="ExpandPath" />
                                                    </Border>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                                                        <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <ContentPresenter DockPanel.Dock="Top"
										  Content="{TemplateBinding Header}"
										  ContentTemplate="{TemplateBinding HeaderTemplate}"
										  ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <Border Name="ContentHostBorder"
					Grid.Row="1"
					Height="0"
					Width="0"
					BorderBrush="{StaticResource Orange_GroupViewItem_SeparatorBrush}"
					BorderThickness="0,1,0,0"
					Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}">
                <Border.LayoutTransform>
                    <TransformGroup>
                        <RotateTransform Angle="{Binding Path=ContentRotationAngle, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"/>
                    </TransformGroup>
                </Border.LayoutTransform>
                <ContentPresenter Name="ContentHost"
								  Height="{Binding Height, ElementName=ContentHostBorder, UpdateSourceTrigger=PropertyChanged}"
								  Width="{Binding Width, ElementName=ContentHostBorder, UpdateSourceTrigger=PropertyChanged}"
								  Content="{TemplateBinding Content}"
								  ContentTemplate="{TemplateBinding ContentTemplate}"
								  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
								  KeyboardNavigation.IsTabStop="False"
								  KeyboardNavigation.TabNavigation="Continue"
								  KeyboardNavigation.ControlTabNavigation="Continue"
								  KeyboardNavigation.DirectionalNavigation="Continue"/>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsLastItem" Value="True">
                <Setter Property="BorderThickness" TargetName="HeaderHost"  Value="0,1,0,1" />
                <Setter Property="BorderThickness" TargetName="ContentHostBorder"  Value="0,0,0,0" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource GroupBarItem_SelectedStoryboard}"/>
                </Trigger.EnterActions>
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Orange_GroupBarItem_SelectedBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Orange_GroupBarItem_OverBackgroundBrush}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Orange_GroupBarItem_OverSelectedBackgroundBrush}"/>
            </MultiTrigger>
            <Trigger Property="IsContextMenuOpened" Value="True">
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Orange_GroupBarItem_OverBackgroundBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- GroupBarItem StackedMode Template -->
    <ControlTemplate x:Key="Orange_GroupBarItemStackedTemplateKey" TargetType="{x:Type local:GroupBarItem}">
        <Grid Name="MainGrid"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True">
            <Grid Name="HeaderGrid"
				  Grid.Row="0"
				  ClipToBounds="True"
				  Cursor="{Binding Path=GroupBarItemCursor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				  Height="{Binding Path=ItemHeaderHeight, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="0.5*"/>
                </Grid.RowDefinitions>
                <Border Name="HeaderHost"
						Grid.Row="0"
						Grid.RowSpan="2"
						Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}"
						BorderBrush="{StaticResource Orange_GroupViewItem_SeparatorBrush}"
						BorderThickness="0,0,0,1">
                    <ContentPresenter Content="{TemplateBinding Header}"
									  ContentTemplate="{TemplateBinding HeaderTemplate}"
									  ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
									  KeyboardNavigation.IsTabStop="False"
									  KeyboardNavigation.TabNavigation="Continue"
									  KeyboardNavigation.ControlTabNavigation="Continue"
									  KeyboardNavigation.DirectionalNavigation="Continue"/>
                </Border>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Orange_GroupBarItem_SelectedBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Orange_GroupBarItem_OverBackgroundBrush}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Orange_GroupBarItem_OverSelectedBackgroundBrush}"/>
            </MultiTrigger>
            <Trigger Property="IsContextMenuOpened" Value="True">
                <Setter TargetName="HeaderHost" Property="Background" Value="{StaticResource Orange_GroupBarItem_OverBackgroundBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- GroupBarItemHeader Template -->
    <ControlTemplate x:Key="Orange_GroupBarItemHeaderTemplateKey" TargetType="{x:Type local:GroupBarItemHeader}">
        <DockPanel Name="MainGrid"
				   SnapsToDevicePixels="True"
				   Margin="5,0,0,0">
            <Border Name="ImageHost"
					DockPanel.Dock="Left"
					Height="{TemplateBinding ImageHeight}"
					Width="{TemplateBinding ImageWidth}"
					HorizontalAlignment="{TemplateBinding ImageHorizontalAlignment}"
					VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"
					Margin="{TemplateBinding ImageMargin}">
                <Image Name="Image"
					   Source="{TemplateBinding ImageSource}"
					   Visibility="Visible"
					   Stretch="Fill"/>
            </Border>
            <Border Name="TextHost"
					DockPanel.Dock="Top"
					Margin="{TemplateBinding TextMargin}"
					HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}"
					VerticalAlignment="{TemplateBinding TextVerticalAlignment}"
					TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBarItem}}}">
                <StackPanel>
                    <TextBlock Name="Text"
							   HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}"
							   VerticalAlignment="{TemplateBinding TextVerticalAlignment}"
							   Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBarItemHeader}}}"
							   FontWeight="Bold"
							   Margin="1,1,1,1"
							   TextTrimming="CharacterEllipsis"/>
					<TextBox Name="TextEditor"
							 Visibility="Collapsed"
							 Width="{Binding ActualWidth, ElementName=TextHost}"
							 Height="14"
							 Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBarItemHeader}}}"
							 FontSize="10"
							 Margin="1,0,0,0"
							 Padding="0,0,0,0"
							 BorderThickness="0"/>
				</StackPanel>
            </Border>
        </DockPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="local:GroupBar.VisualMode" Value="MultipleExpansion">
                <Setter Property="Visibility" TargetName="Image" Value="Collapsed"/>
                <Setter Property="Margin" TargetName="MainGrid" Value="0"/>
                <Setter Property="Width" TargetName="ImageHost" Value="0"/>
            </Trigger>
            <Trigger Property="IsInEditMode" Value="True">
                <Setter TargetName="TextEditor" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Text" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="ImageHost" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="TextHost" Property="HorizontalAlignment" Value="Stretch"/>
            </Trigger>
            <DataTrigger Binding="{Binding Path=(local:GroupBar.IsCollapsed), RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
					               Value="True" >
                <Setter TargetName="ImageHost" Property="Margin" Value="2"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- GroupView MultipleExpansion Template -->
    <ControlTemplate x:Key="Orange_GroupViewMultipleExpansionTemplateKey" TargetType="{x:Type local:GroupView}">
        <StackPanel Name="MainHost"
					Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}"
					TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}">
            <ItemsPresenter ClipToBounds="True"/>
        </StackPanel>
    </ControlTemplate>

    <!-- GroupView Default Template -->
    <ControlTemplate x:Key="Orange_GroupViewDefaultTemplateKey" TargetType="{x:Type local:GroupView}">
        <ScrollViewer Name="MainHost"
					  Focusable="False"
					  Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}"
					  Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupView}}}"
					  VerticalScrollBarVisibility="Auto"
					  Style="{StaticResource ScrollViewerStyle}">
            <Border Name="ItemsHost" Padding="0,0,0,0">
                <ItemsPresenter ClipToBounds="True"/>
            </Border>
        </ScrollViewer>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=(local:GroupBarItem.IsAnimating), RelativeSource={RelativeSource AncestorType={x:Type local:GroupBarItem}}}"
						 Value="True" >
                <Setter TargetName="MainHost" Property="VerticalScrollBarVisibility" Value="Hidden"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- GroupViewItem Template -->



    <ControlTemplate x:Key="Orange_GroupViewItemTemplateKey" TargetType="{x:Type local:GroupViewItem}">

        <Border Name="MainGrid"
				Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupViewItem}}}"
				BorderBrush="Transparent"
				BorderThickness="1"
				ClipToBounds="True"
				SnapsToDevicePixels="True"
				Cursor="{Binding Path=GroupViewItemCursor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}">
            <Grid>
                <Grid.Resources>
                    <local:ContentToVisibilityConverter x:Key="ContentToVisibility"/>
                </Grid.Resources>
                <DockPanel Name="ContentHost" Visibility="{Binding Path=Content,ElementName=contentpresenter, Converter={StaticResource ContentToVisibility}}"
					   Width="{Binding Path=InternalContentLength, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
					   HorizontalAlignment="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}">
                    <Border Name="ImageHost"
						DockPanel.Dock="Left"
						Width="{TemplateBinding ImageWidth}"
						Height="{TemplateBinding ImageHeight}"
						HorizontalAlignment="Left"
						Background="Transparent">
                        <Image Name="Image"
						   Stretch="Fill"
						   Source="{TemplateBinding ImageSource}"/>
                    </Border>
                    <Border Name="TextHost"
						DockPanel.Dock="Top"
						Padding="3,2,3,2"
						HorizontalAlignment="{Binding Path=TextAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
						TextBlock.Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupViewItem}}}" >
                        <StackPanel>
                            <TextBlock Name="Text"
								   Visibility="Visible"
								   TextTrimming="CharacterEllipsis"
								   Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
                            <TextBox Name="TextEditor"
								 Visibility="Collapsed"
								 Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"
								 Background="{TemplateBinding Background}"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
                <Border >
                    <StackPanel>
                        <ContentControl x:Name="contentpresenter"
                            Content="{TemplateBinding Content}" 
                            Width="{Binding Path=InternalContentLength, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
                            HorizontalContentAlignment="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=IsShowText, RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}" Value="False">
                <Setter TargetName="TextHost" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <Trigger Property="IsInEditMode" Value="True">
                <Setter TargetName="TextEditor" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Text" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="TextHost" Property="HorizontalAlignment" Value="Stretch"/>
                <Setter TargetName="TextHost" Property="Visibility" Value="Visible"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition SourceName="MainGrid" Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsSelected" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" TargetName="MainGrid">
                    <Setter.Value>
                        <SolidColorBrush Color="{Binding Path=MouseHoverColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="MainGrid" Property="BorderBrush" Value="{StaticResource Orange_GroupViewItem_OverBorderBrush}"/>
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" TargetName="MainGrid">
                    <Setter.Value>
                        <SolidColorBrush Color="{Binding Path=MouseDownColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="MainGrid" Property="BorderBrush" Value="{StaticResource Orange_GroupViewItem_PressedBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" TargetName="MainGrid">
                    <Setter.Value>
                        <SolidColorBrush Color="{Binding Path=SelectedItemColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="MainGrid" Property="BorderBrush" Value="{StaticResource Orange_GroupViewItem_SelectedBorderBrush}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition SourceName="MainGrid" Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsSelected" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" TargetName="MainGrid">
                    <Setter.Value>
                        <SolidColorBrush Color="{Binding Path=SelectedItemMouseHoverColor, RelativeSource={RelativeSource AncestorType={x:Type local:GroupViewItem}}}"/>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="MainGrid" Property="BorderBrush" Value="{StaticResource Orange_GroupViewItem_PressedBorderBrush}"/>
            </MultiTrigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="MainGrid" Property="Background" Value="{StaticResource Orange_GroupViewItem_SelectedOverBackgroundBrush}"/>
                <Setter TargetName="MainGrid" Property="BorderBrush" Value="{StaticResource Orange_GroupViewItem_PressedBorderBrush}"/>
            </Trigger>
            <DataTrigger Binding="{Binding Path=(local:GroupView.IsListViewMode), RelativeSource={RelativeSource AncestorType={x:Type local:GroupView}}}"
						 Value="False">
                <Setter TargetName="ContentHost" Property="Width" Value="{Binding Path=Width}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Naviagation Toolbar Template -->
    <ControlTemplate x:Key="Orange_NavigationToolbar" TargetType="{x:Type local:NavigationToolbar}">
        <Grid Name="MainGrid"
			  SnapsToDevicePixels="True"
			  ClipToBounds="True"
			  Background="Transparent">
            <Grid.Resources>
                <ResourceDictionary>
                    <Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}">
                        <Setter Property="Template" Value="{StaticResource ToggleButtonKeyTemplate}"/>
                    </Style>
                    <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type CheckBox}">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1">
                                        <ContentPresenter ContentSource="Content"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True" >
                                <Setter Property="Background" Value="#FFBD69"/>
                                <Setter Property="BorderBrush" Value="#FFAB3F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </Grid.Resources>
            <Border Name="MainHost"
                    CornerRadius="{Binding Path=ToolbarBottomCornerRadius, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
                    Background="{TemplateBinding Background}"
					BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
					BorderThickness="{TemplateBinding BorderThickness}">
                <WrapPanel Name="MainPanel"
						   Orientation="Horizontal"
						   FlowDirection="RightToLeft">
                    <Menu Name="Menu" Margin="{Binding Path=ToolbarMenuMarginRight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"
						  FlowDirection="LeftToRight"
						  Background="Transparent">
                        <MenuItem Name="TopMenuItem"
								  Padding="0"
								  Margin="0"
								  Background="Transparent"
								 >
                            <!--Template="{StaticResource MenuItemSubmenuTemplateKey}"
								  ItemContainerStyle="{StaticResource MenuItemKeyStyle}"-->
                            <MenuItem.Header>
                                <DockPanel Name="MenuImageHost"
										   Background="{Binding Background, ElementName=TopMenuItem}">
                                    <Border Name="MenuImage"
											Height="{TemplateBinding Height}" 
											Width="{Binding Path=MenuDefaultWidth, RelativeSource={RelativeSource AncestorType={x:Type local:NavigationToolbar}}}"
											VerticalAlignment="Center"
											HorizontalAlignment="Center">
                                        <Canvas Width="5"
												Height="3" 
												VerticalAlignment="Center"
												HorizontalAlignment="Center">
                                            <Line X1="0" Y1="1" X2="5" Y2="1" StrokeThickness="1" Stroke="{StaticResource Orange_NavigationToolbarItem_ArrowBrush2}"/>
                                            <Line X1="1" Y1="2" X2="4" Y2="2" StrokeThickness="1" Stroke="{StaticResource Orange_NavigationToolbarItem_ArrowBrush2}"/>
                                            <Line X1="2" Y1="3" X2="3" Y2="3" StrokeThickness="1" Stroke="{StaticResource Orange_NavigationToolbarItem_ArrowBrush2}"/>

                                            <Line X1="0" Y1="0" X2="5" Y2="0" StrokeThickness="1" Stroke="{StaticResource Orange_NavigationToolbarItem_ArrowBrush1}"/>
                                            <Line X1="1" Y1="1" X2="4" Y2="1" StrokeThickness="1" Stroke="{StaticResource Orange_NavigationToolbarItem_ArrowBrush1}"/>
                                            <Line X1="2" Y1="2" X2="3" Y2="2" StrokeThickness="1" Stroke="{StaticResource Orange_NavigationToolbarItem_ArrowBrush1}"/>
                                        </Canvas>
                                    </Border>
                                </DockPanel>
                            </MenuItem.Header>
                            <MenuItem Name="SplitterUpMenuItem"
									  Command="local:GroupBar.SplitterUpCommand"
									  Header="{StaticResource Showmorebuttons}"
									  StaysOpenOnClick="True">
                                <MenuItem.Icon>
                                    <StaticResource ResourceKey="Office_NavigationToolBar_UpMenuItemHeader"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Name="SplitterDownMenuItem"
									  Command="local:GroupBar.SplitterDownCommand"
									  Header="{StaticResource Showfewerbuttons}"
									  StaysOpenOnClick="True">
                                <MenuItem.Icon>
                                    <StaticResource ResourceKey="Office_NavigationToolBar_DownMenuItemHeader"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <!--Style="{StaticResource SeparatorKeyStyle}"-->
                            <MenuItem Name="OptionsMenu"
									  Command="local:GroupBar.OpenOptionsCommand"
									  Header="{Binding Path=NavigationOptionsMenuItemHeader, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"/>
                            <Separator />
                            <!--Style="{StaticResource SeparatorKeyStyle}"-->
                            <MenuItem Name="ButtonsMenu"
									  Header="{StaticResource Buttons}"
									 />
                            <!--ItemContainerStyle="{StaticResource MenuItemKeyStyle}"-->
                        </MenuItem>
                    </Menu>
                    <ItemsPresenter Name="ItemsPresenter"/>
                </WrapPanel>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
      <DataTrigger
				Binding="{Binding Path=IsCollapsed, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				Value="True">
        <Setter TargetName="Menu" Property="Margin" Value="0"/>
      </DataTrigger>
          
            <Trigger SourceName="TopMenuItem" Property="IsMouseOver" Value="True">
                <Setter TargetName="TopMenuItem" Property="Background" Value="{StaticResource Orange_NavigationToolbarItem_OverBrush}"/>
            </Trigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition
						Binding="{Binding Path=Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="Horizontal"/>
                    <Condition
						Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="RightToLeft"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Menu" Property="LayoutTransform">
                    <Setter.Value>
                        <RotateTransform Angle="-90" />
                    </Setter.Value>
                </Setter>
                <Setter TargetName="MenuImageHost" Property="LayoutTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <RotateTransform Angle="90"/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition
						Binding="{Binding Path=Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="Horizontal"/>
                    <Condition
						Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
						Value="LeftToRight"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Menu" Property="LayoutTransform">
                    <Setter.Value>
                        <RotateTransform Angle="-90" />
                    </Setter.Value>
                </Setter>
                <Setter TargetName="MenuImageHost" Property="LayoutTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <RotateTransform Angle="-90" />
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
            </MultiDataTrigger>

            <DataTrigger
				Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				Value="RightToLeft">
                <Setter TargetName="MainPanel" Property="FlowDirection" Value="LeftToRight"/>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>

            <DataTrigger
				Binding="{Binding Path=FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:GroupBar}}}"
				Value="LeftToRight">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- NaviagationToolbarItem Template -->
    <ControlTemplate x:Key="Orange_NaviagationToolbarItemTemplateKey" TargetType="{x:Type local:NavigationToolbarItem}">
        <Grid SnapsToDevicePixels="True" ClipToBounds="True">
            <Border Name="ImageHost"
					Width="{Binding Path=ItemDefaultWidth, RelativeSource={RelativeSource AncestorType={x:Type local:NavigationToolbar}}}"
					Background="{TemplateBinding Background}"
					BorderThickness="0"
					Margin="0">
                <StackPanel HorizontalAlignment="Center"
							VerticalAlignment="Center">
                    <Image Name="Image"
						   Source="{TemplateBinding ImageSource}"
						   Visibility="Visible"
						   Height="20"
						   Width="20"
						   Stretch="Fill"/>
                    <Border Name="EmptyImage"
							Visibility="Collapsed"
							BorderBrush="Black"
                            BorderThickness="1"
							Height="20"
							Width="20"/>
                </StackPanel>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger SourceName="ImageHost" Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Orange_NavigationToolbarItem_OverBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ImageHost" Property="Background" Value="{StaticResource Orange_NavigationToolbarItem_SelectedBackgroundBrush}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsSelected" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="ImageHost" Property="Background" Value="{StaticResource Orange_NavigationToolbarItem_SelectedOverBackgroundBrush}"/>
            </MultiTrigger>
            <Trigger SourceName="Image" Property="Source" Value="{x:Null}">
                <Setter TargetName="EmptyImage" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Image" Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Splitter Template -->
    <ControlTemplate x:Key="Orange_GroupBarSplitterTemplateKey" TargetType="{x:Type local:GroupBarSplitter}">
        <Border BorderThickness="{TemplateBinding BorderThickness}"
				BorderBrush="{TemplateBinding BorderBrush}"
				Background="{StaticResource Orange_Splitter_BackgroundBrush}">
            <Border Width="18" Height="2" HorizontalAlignment="Center">
                <Canvas>
                    <Line X1="1" Y1="1" X2="3" Y2="1" Stroke="White" StrokeThickness="2"/>
                    <Line X1="5" Y1="1" X2="7" Y2="1" Stroke="White" StrokeThickness="2"/>
                    <Line X1="9" Y1="1" X2="11" Y2="1" Stroke="White" StrokeThickness="2"/>
                    <Line X1="13" Y1="1" X2="15" Y2="1" Stroke="White" StrokeThickness="2"/>
                    <Line X1="17" Y1="1" X2="19" Y2="1" Stroke="White" StrokeThickness="2"/>

                    <Line X1="0" Y1="0" X2="2" Y2="0" Stroke="{StaticResource Orange_PointBrush}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="4" Y1="0" X2="6" Y2="0" Stroke="{StaticResource Orange_PointBrush}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="8" Y1="0" X2="10" Y2="0" Stroke="{StaticResource Orange_PointBrush}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="12" Y1="0" X2="14" Y2="0" Stroke="{StaticResource Orange_PointBrush}" StrokeThickness="2" Opacity="0.5"/>
                    <Line X1="16" Y1="0" X2="18" Y2="0" Stroke="{StaticResource Orange_PointBrush}" StrokeThickness="2" Opacity="0.5"/>
                </Canvas>
            </Border>
        </Border>
    </ControlTemplate>
</ResourceDictionary>