<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Syncfusion.Windows.Tools"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls" >

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Controls/Autocomplete/Themes/Generic.Tools.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Controls/Autocomplete/Themes/Brushes.xaml"/>
        <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <converters:PopupControlRelatedPlacementConverter x:Key="PopupPlacementConverter" />



    <Style x:Key="OrangeToggleDropDownButtonStyle"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle"
                Value="true"/>
        <Setter Property="IsTabStop"
                Value="false"/>
        <Setter Property="Focusable"
                Value="false"/>
        <Setter Property="ClickMode"
                Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Name="Chrome" 
							SnapsToDevicePixels="true">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ComboBoxButton"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Name="Chrome1" Background="{StaticResource TextBoxBackground.Orange}" 
                                       Grid.Column="0">
                            </Border>
                            <Border Name="Chrome2" Margin="-1,0,0,0" Background="{StaticResource ToggleButtonBackground.Orange}" 
                                    Grid.Column="1" Width="40"  Grid.Row="0">
                            </Border>
                          
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Chrome2" Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Chrome2" Property="Background" Value="{StaticResource ToggleButtonChecked.Orange}"/>
                        </Trigger>
                        <Trigger SourceName="Chrome2" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome2" Property="Background" Value="{StaticResource ToggleButtonChecked.Orange}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

  
    <Style x:Key="OrangeTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2"/>
    </Style>
  

    <!--AutoComplete template-->

    <ControlTemplate TargetType="{x:Type TextBox}" x:Key="OrangeTextBoxTemplate">
        <Border x:Name="Bd" CornerRadius="4"                                     
                            SnapsToDevicePixels="true">
            <ScrollViewer x:Name="PART_ContentHost" 
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="OrangeHistoryAutoCompleteTemplate" TargetType="{x:Type local:AutoComplete}">
        <Border BorderBrush="{TemplateBinding BorderBrush}" 
                Background="{TemplateBinding Background}"                             
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
            <Grid 
            Focusable="False">
                <Grid.RowDefinitions>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <!--<ColumnDefinition Width="1*" MinWidth="13"/>-->
                </Grid.ColumnDefinitions>
                <local:VistaSpecificProgressBar Name="PART_VistaProgressBar" Grid.Column="0" />
                <TextBox Name="PART_EditableTextBox" 
						 Grid.Column="0" 
						 Margin="0" Background="Transparent"
						 VerticalAlignment="Center"
						 BorderThickness="0"
						 Foreground="{TemplateBinding Foreground}" 
						 FontFamily="{TemplateBinding FontFamily}"
						 FontSize="{TemplateBinding FontSize}" 
						 FontStretch="{TemplateBinding FontStretch}"
						 FontStyle="{TemplateBinding FontStyle}" 
						 FontWeight="{TemplateBinding FontWeight}"
						 Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
						 />
                <Popup Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
					   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
					   VerticalOffset="-2"
					   HorizontalOffset="1"
					   SnapsToDevicePixels="True"
					   AllowsTransparency="True" 
					   Focusable="True" 
					   PopupAnimation="Slide">
                    <ListBox Name="PART_Container" 
                             SelectionMode="{TemplateBinding SelectionMode}"
                              ItemTemplate="{TemplateBinding ItemTemplate}"
                                ItemContainerStyle="{TemplateBinding ItemContainerStyle}"
                              ItemContainerStyleSelector="{TemplateBinding ItemTemplate}"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"
							 IsSynchronizedWithCurrentItem="True"
							 SnapsToDevicePixels="True"
							 MaxHeight="{TemplateBinding MaxDropHeight}" 
							 Focusable="True" 
							 Width="{Binding Path=ActualWidth, ElementName=PART_EditableTextBox}"
							 />
                </Popup>
                <Popup Name="HistoryPopup"                
					   SnapsToDevicePixels="True"
					   Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
					   AllowsTransparency="True" 
					   Focusable="True" 
					   PopupAnimation="Slide"
					   IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                    <ListBox Name="PART_HistoryContainer" 
                             SelectionMode="{TemplateBinding SelectionMode}"
                              ItemTemplate="{TemplateBinding ItemTemplate}"
                                ItemContainerStyle="{TemplateBinding ItemContainerStyle}"
                              ItemContainerStyleSelector="{TemplateBinding ItemTemplate}"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"
							 IsSynchronizedWithCurrentItem="True" 
						     SnapsToDevicePixels="True"
							 Height="{TemplateBinding HistoryListHeight}"
							 Width="{TemplateBinding ActualWidth}"
							 Focusable="True"
							 />
                </Popup>
            </Grid>
        </Border>

    </ControlTemplate>

    <ControlTemplate x:Key="OrangeAutoCompleteTemplate" TargetType="{x:Type local:AutoComplete}">
        <Border BorderBrush="{TemplateBinding BorderBrush}" 
                Background="{TemplateBinding Background}"                             
                BorderThickness="{TemplateBinding BorderThickness}" TextBlock.Foreground="{TemplateBinding Foreground}">

            <Grid Focusable="False">
                <Grid.RowDefinitions>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <local:VistaSpecificProgressBar Name="PART_VistaProgressBar" Grid.Column="0" />


                <ToggleButton Name="PART_CheckButton" Margin="0,0,0,0" 
                      Grid.ColumnSpan="2" 
							        Visibility="{Binding Path=IsHistory, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource BooleanToVisibilityConverter}}"
							        IsChecked="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
							        Style="{StaticResource OrangeToggleDropDownButtonStyle}">

                </ToggleButton>
                <TextBox Name="PART_EditableTextBox" 
                 Grid.Column="0" 
                 Margin="2,0,40,0" Template="{StaticResource OrangeTextBoxTemplate}"
				 VerticalAlignment="Center"                         
                 Background="Transparent"                         
			     Foreground="White"                          
                 FontFamily="{TemplateBinding FontFamily}"
				 FontSize="{TemplateBinding FontSize}" 
                 FontStretch="{TemplateBinding FontStretch}"
				 FontStyle="{TemplateBinding FontStyle}" 
                 FontWeight="{TemplateBinding FontWeight}" 
				 Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
				 />
                <Popup TextBlock.Foreground="{Binding Path=ItemsForeground, Mode=TwoWay, 
                        RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
                    Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
			   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" 
               VerticalOffset="-2" Grid.ColumnSpan="2"
			   HorizontalOffset="1"
			   SnapsToDevicePixels="True"
			   AllowsTransparency="True"
               Focusable="True"
               PopupAnimation="Slide">

                    <ListBox Name="PART_Container" 
                             SelectionMode="{TemplateBinding SelectionMode}"
                             ItemTemplate="{TemplateBinding ItemTemplate}"
                                ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                              ItemContainerStyleSelector="{TemplateBinding ItemTemplate}"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              
                   
                   IsSynchronizedWithCurrentItem="True" 
                   SnapsToDevicePixels="True"
				   Width="{Binding Path=ActualWidth, ElementName=PART_CheckButton}"
				   MaxHeight="{TemplateBinding MaxDropHeight}" 
                   Focusable="True">
                    </ListBox>
                </Popup>
                <Popup Name="HistoryPopup" 
                       TextBlock.Foreground="{Binding Path=ItemsForeground, Mode=TwoWay, 
                        RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
               SnapsToDevicePixels="True"
     		   Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
               AllowsTransparency="True" 
               Focusable="True" 
               PopupAnimation="Slide"
			   IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                    <ListBox Name="PART_HistoryContainer"    
                             SelectionMode="{TemplateBinding SelectionMode}"
                   IsSynchronizedWithCurrentItem="True" 
                   SnapsToDevicePixels="True"
			       Height="{TemplateBinding HistoryListHeight}"                 
			       Width="{TemplateBinding ActualWidth}"
                   Focusable="True"
				   />
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger SourceName="PART_EditableTextBox" Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource ToggleButtonChecked.Orange}"/>
            </Trigger>

            <Trigger SourceName="PART_EditableTextBox" Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource ToggleButtonChecked.Orange}"/>
            </Trigger>


        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>