    <SolidColorBrush x:Key="BorderBrush.Orange" Color="#FF6E2713" />
    <Style x:Key="OrangeToggleDropDownButtonStyle"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle"
                Value="true" />
        <Setter Property="IsTabStop"
                Value="false" />
        <Setter Property="Focusable"
                Value="false" />
        <Setter Property="ClickMode"
                Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Name="Chrome"
							SnapsToDevicePixels="true">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ComboBoxButton" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Name="Chrome1" Background="{StaticResource TextBoxBackground.Orange}"
                                       Grid.Column="0">
                            </Border>
                            <Border Name="Chrome2" Margin="-1,0,0,0" Background="{StaticResource ToggleButtonBackground.Orange}"
                                    Grid.Column="1" Width="40"  Grid.Row="0">
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Chrome2" Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Chrome2" Property="Background" Value="{StaticResource ToggleButtonChecked.Orange}" />
                        </Trigger>
                        <Trigger SourceName="Chrome2" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome2" Property="Background" Value="{StaticResource ToggleButtonChecked.Orange}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Thumb Style-->
    <Style x:Key="SyncOrangeThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Ellipse Fill="{TemplateBinding Background}" Height="5" Width="5" Grid.Row="1" Grid.Column="1" />
                        <Ellipse Fill="{TemplateBinding Background}" Height="5" Width="5" Grid.Row="0" Grid.Column="1" />
                        <Ellipse Fill="{TemplateBinding Background}" Height="5" Width="5" Grid.Row="1" Grid.Column="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--AutoComplete template-->

    <ControlTemplate TargetType="{x:Type TextBox}" x:Key="OrangeTextBoxTemplate">
        <Border x:Name="Bd" CornerRadius="4"
                            SnapsToDevicePixels="true">
            <ScrollViewer x:Name="PART_ContentHost"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Border>
    </ControlTemplate>

    <Style x:Key="SyncOrangeAutoCompleteStyle" TargetType="{x:Type local:AutoComplete}">

        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="MinWidth" Value="15" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Background" Value="{StaticResource TextBoxBackground.Orange}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush.Orange}" />
        <Setter Property="Foreground" Value="{StaticResource Blend.Foreground}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AutoComplete}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BorderThickness="{TemplateBinding BorderThickness}" TextBlock.Foreground="{TemplateBinding Foreground}">

                        <Grid Focusable="False">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:VistaSpecificProgressBar x:Name="PART_VistaProgressBar" Grid.Column="0" />

                            <ToggleButton Name="PART_CheckButton" Margin="0,0,0,0"
                      Grid.ColumnSpan="2"
							        Visibility="{Binding Path=EnableDropDown, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource BooleanToVisibilityConverter}}"
							        IsChecked="False"
							        Style="{StaticResource OrangeToggleDropDownButtonStyle}">
                            </ToggleButton>
                            <TextBox Name="PART_EditableTextBox"
                 Grid.Column="0"
                 Margin="2,0,40,0" Template="{StaticResource OrangeTextBoxTemplate}"
				 VerticalAlignment="Center"
                 Background="Transparent"
			     Foreground="White"
                 FontFamily="{TemplateBinding FontFamily}"
				 FontSize="{TemplateBinding FontSize}"
                 FontStretch="{TemplateBinding FontStretch}"
				 FontStyle="{TemplateBinding FontStyle}"
                 FontWeight="{TemplateBinding FontWeight}"
                 Padding="{TemplateBinding Padding}"
				 Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
 />
                            <Popup x:Name="PART_Popup" TextBlock.Foreground="{Binding Path=ItemsForeground, Mode=TwoWay,
                        RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
                    Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
			   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
               VerticalOffset="-2" Grid.ColumnSpan="2"
			   HorizontalOffset="1"
			   SnapsToDevicePixels="True"
			   AllowsTransparency="True"
               Focusable="True"
               PopupAnimation="Slide">
                                <Border>
                                    <Grid Background="{TemplateBinding Background}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <ListBox Name="PART_Container"  KeyboardNavigation.DirectionalNavigation="Cycle"
                             SelectionMode="{TemplateBinding SelectionMode}" Grid.Row="0"
                             ItemTemplate="{TemplateBinding ItemTemplate}"

                              ItemContainerStyleSelector="{TemplateBinding ItemTemplate}"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"

                   IsSynchronizedWithCurrentItem="True"
                   SnapsToDevicePixels="True"
				   Width="{Binding Path=ActualWidth, ElementName=PART_CheckButton}"
				   MaxHeight="{TemplateBinding MaxDropHeight}"
                   Focusable="True">
                                        </ListBox>
                                        <Thumb x:Name="ContainerThumb" Margin="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource SyncOrangeThumbStyle}" Grid.Row="1" />
                                    </Grid>
                                </Border>
                            </Popup>
                            <Popup Name="HistoryPopup"
                       TextBlock.Foreground="{Binding Path=ItemsForeground, Mode=TwoWay,
                        RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
               SnapsToDevicePixels="True"
     		   Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
               AllowsTransparency="True"
               Focusable="True"
               PopupAnimation="Slide"
			   IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                                <Border>
                                    <Grid Background="{TemplateBinding Background}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <ListBox Name="PART_HistoryContainer"     KeyboardNavigation.DirectionalNavigation="Cycle"
                             SelectionMode="{TemplateBinding SelectionMode}" Grid.Row="0"
                   IsSynchronizedWithCurrentItem="True"
                   SnapsToDevicePixels="True"
			       Height="{TemplateBinding HistoryListHeight}"
			       Width="{TemplateBinding ActualWidth}"
                   Focusable="True"
 />
                                        <Thumb x:Name="HistoryThumb" Margin="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource SyncOrangeThumbStyle}" Grid.Row="1" />
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHistory" Value="True">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsHistory" Value="False">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger SourceName="PART_EditableTextBox" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource ToggleButtonChecked.Orange}" />
                        </Trigger>

                        <Trigger SourceName="PART_EditableTextBox" Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource ToggleButtonChecked.Orange}" />
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Single">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Multiple">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Extended">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="True"></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <Trigger Property="EnableDropDown" Value="false">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:AutoComplete}">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <Grid
            Focusable="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <!--<ColumnDefinition Width="1*" MinWidth="13" />-->
                                    </Grid.ColumnDefinitions>
                                    <local:VistaSpecificProgressBar x:Name="PART_VistaProgressBar" Grid.Column="0" />
                                    <TextBox Name="PART_EditableTextBox"
						 Grid.Column="0"
						 Margin="0" Background="Transparent"
						 VerticalAlignment="Center"
						 BorderThickness="0"
						 Foreground="{TemplateBinding Foreground}"
						 FontFamily="{TemplateBinding FontFamily}"
						 FontSize="{TemplateBinding FontSize}"
						 FontStretch="{TemplateBinding FontStretch}"
						 FontStyle="{TemplateBinding FontStyle}"
						 FontWeight="{TemplateBinding FontWeight}"
						 Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
 />
                                    <Popup Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
					   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
					   VerticalOffset="-2"
					   HorizontalOffset="1"
					   SnapsToDevicePixels="True"
					   AllowsTransparency="True"
					   Focusable="True"
					   PopupAnimation="Slide">
                                        <Border>
                                            <Grid Background="{TemplateBinding Background}">
                                                <ListBox Name="PART_Container"
                             SelectionMode="{TemplateBinding SelectionMode}"

							 IsSynchronizedWithCurrentItem="True"
							 SnapsToDevicePixels="True"
							 MaxHeight="{TemplateBinding MaxDropHeight}"
							 Focusable="True"
							 Width="{Binding Path=ActualWidth, ElementName=PART_EditableTextBox}" />
                                                <Thumb x:Name="ContainerThumb" Margin="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource SyncOrangeThumbStyle}" />
                                            </Grid>
                                        </Border>
                                    </Popup>
                                    <Popup Name="HistoryPopup"
					   SnapsToDevicePixels="True"
					   Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
					   AllowsTransparency="True"
					   Focusable="True"
					   PopupAnimation="Slide"
					   IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                                        <ListBox Name="PART_HistoryContainer"
                             SelectionMode="{TemplateBinding SelectionMode}"

							 IsSynchronizedWithCurrentItem="True"
						     SnapsToDevicePixels="True"
							 Height="{TemplateBinding HistoryListHeight}"
							 Width="{TemplateBinding ActualWidth}"
							 Focusable="True"
 />
                                    </Popup>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style BasedOn="{StaticResource SyncOrangeAutoCompleteStyle}" TargetType="{x:Type local:AutoComplete}" />
</ResourceDictionary>