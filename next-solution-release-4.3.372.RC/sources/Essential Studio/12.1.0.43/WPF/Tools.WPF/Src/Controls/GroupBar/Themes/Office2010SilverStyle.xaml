            <Setter Property="TextElement.Foreground" Value="{StaticResource Office2007Blue_MenuText_Brush}" />

        </Style>


        <!-- Context Menu for GroupBar -->
        <ContextMenu x:Key="GroupBar_ContextMenu" 
				 ItemContainerStyle="{StaticResource MenuItemKeyStyle}"
				 Style="{StaticResource ContextMenuKeyStyle}">
            <MenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=GroupbarMItemCut}" Command="local:GroupBar.CutItemCommand" />
            <MenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=GroupbarMItemCopy}" Command="local:GroupBar.CopyItemCommand" />
            <MenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=GroupbarMItemPaste}" Command="local:GroupBar.PasteItemCommand" />
            <Separator Style="{StaticResource SeparatorKeyStyle}" />
            <MenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=GroupbarMItemListView}" Command="local:GroupBar.ChangeListViewModeCommand"
				  IsCheckable="True"
				  IsChecked="{Binding Path=(PlacementTarget).(local:GroupView.IsListViewMode), RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
            <MenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=GroupbarMItemSortAsc}" Command="local:GroupBar.SortAscCommand" />
            <MenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=GroupbarMItemSortDec}" Command="local:GroupBar.SortDesCommand" />
            <Separator Style="{StaticResource SeparatorKeyStyle}" />
            <MenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=GroupbarMItemAddTab}" Command="local:GroupBar.AddTabCommand" />
            <MenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=GroupbarMItemDeleteTab}" Command="local:GroupBar.DeleteTabCommand" />
            <MenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=GroupbarMItemRenameTab}" Command="local:GroupBar.RenameTabCommand" />
            <MenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=GroupbarMItemAddItem}" Command="local:GroupBar.AddItemCommand" />
            <MenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=GroupbarMItemRenameItem}" Command="local:GroupBar.RenameItemCommand" />
            <MenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=GroupbarMItemDeleteItem}" Command="local:GroupBar.DeleteItemCommand" />
            <Separator Style="{StaticResource SeparatorKeyStyle}" />
            <MenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=GroupbarMItemMoveUp}" Command="local:GroupBar.MoveUpCommand" />
            <MenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=GroupbarMItemMoveDown}" Command="local:GroupBar.MoveDownCommand" />
        </ContextMenu>


