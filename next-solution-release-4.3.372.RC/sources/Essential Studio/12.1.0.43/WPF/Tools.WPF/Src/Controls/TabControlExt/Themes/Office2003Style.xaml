            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=Top}" Value="Left"/>
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=false}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
            </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Path=(local:TabControlExt.IsEditing), RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="Visibility" TargetName="PART_EditHeader" Value="Visible"/>
                            <Setter Property="Visibility" TargetName="Content" Value="Collapsed"/>
                        </DataTrigger>
                        <!--End TabStripPlacement section-->
        </ControlTemplate.Triggers>
		</ControlTemplate>
