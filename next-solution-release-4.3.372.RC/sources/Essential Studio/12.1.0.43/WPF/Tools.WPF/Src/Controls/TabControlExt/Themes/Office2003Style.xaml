<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
					xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:Sync_Resources="clr-namespace:Syncfusion.Windows.Tools.Controls.Resources"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
	xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"  xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
    xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna">
    
	<!-- Brushes -->
    <Sync_Resources:ResourceWrapper x:Key="ResourceWrapperKey"/>
	 <SolidColorBrush x:Key="Office2003.TabControlBackgroundBrush" Color="Transparent"/>
    <LinearGradientBrush x:Key="Office2003.TabPanelBackgroundBrush" StartPoint="0.5, 0" EndPoint="0.5,1">
        <GradientStop Color="#D9D9E6" Offset="0"/>
        <GradientStop Color="#FEFEFE" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2003.TabPanelBottomBackgroundBrush" Color="#E8820C" />
    <Thickness x:Key="Office2003.TabPanelPadding" Left="0" Top="2" Right="0" Bottom="0" />
    <Thickness x:Key="Office2003.TabPanelMargin" Left="0" Top="0" Right="0" Bottom="0" />
    <Thickness x:Key="Office2003.ContentPanelBorderThickness" Left="0" Top="0" Right="0" Bottom="0" />
    <CornerRadius x:Key="Office2003.ContentPanelBorderCornerRadius" TopLeft="0" TopRight="0" BottomRight="0" BottomLeft="0" />
    <Thickness x:Key="Office2003.ContentPanelInnerBorderThickness" Left="0" Top="0" Right="0" Bottom="0" />
    <Thickness x:Key="Office2003.ContentPanelInnerBorderMargin" Left="0" Top="0" Right="0" Bottom="0" />
    <Thickness x:Key="Office2003.ContentPanelOuterBorderThickness" Left="2" Top="2" Right="2" Bottom="2" />
    <Thickness x:Key="Office2003.TabItemBorderThickness" Left="1" Top="1" Right="1" Bottom="0" />
    <CornerRadius x:Key="Office2003.TabBorderCornerRadius" TopLeft="0" TopRight="0" BottomLeft="0" BottomRight="0" />
    <Thickness x:Key="Office2003.TabMargin" Left="1" Top="0" Right="1" Bottom="0" />
    <Thickness x:Key="Office2003.TabSelectedMargin" Left="1" Top="0" Right="1" Bottom="0" />
 <LinearGradientBrush x:Key="TabBackground.Office2003" StartPoint="0.5, 0" EndPoint="0.5,1">
        <GradientStop Color="#D9D9E6" Offset="0"/>
        <GradientStop Color="#FEFEFE" Offset="0.9"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2003.ActiveForeground" Color="Black"/>
    <SolidColorBrush x:Key="Office2003.InactiveForeground" Color="Black"/>
    <SolidColorBrush x:Key="Office2003.TabBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Office2003.TabHoverBorderBrush" Color="#4B4B6F"/>
    <SolidColorBrush x:Key="Office2003.TabSelectedBorderBrush" Color="#4B4B6F"/>
    <SolidColorBrush x:Key="Office2003.TabHoverSelectedBorderBrush" Color="#4B4B6F"/>
    <SolidColorBrush x:Key="Office2003.TabSubLineBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Office2003.TabBottomBorderBrush" Color="#4B4B6F"/>
    <SolidColorBrush x:Key="Office2003.ButtonActivePathBrush" Color="Black"/>
    <SolidColorBrush x:Key="Office2003.ButtonInactivePathBrush" Color="Black"/>
    <SolidColorBrush x:Key="Office2003.ButtonInactiveBorderBrush" Color="Transparent"/>
    <!--<SolidColorBrush x:Key="Office2003.ContentPanelBackgroundBrush" Color="Transparent"/>-->    
    <SolidColorBrush x:Key="Office2003.ContextMenuBackgroundBrush" Color="#F6F6F6"/>
    <SolidColorBrush x:Key="Office2003.ContextMenuBorderBrush" Color="#000080"/>    
    <SolidColorBrush x:Key="Office2003.ContextMenuBarBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Office2003.ContextMenuBarInnerBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Office2003.MenuItemBorderBrush" Color="#000080"/>
    <SolidColorBrush x:Key="Office2003.MenuItemActiveForeground" Color="Black" />
    <SolidColorBrush x:Key="Office2003.MenuItemInactiveForeground" Color="Black" />
    <SolidColorBrush x:Key="Office2003.ButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="Office2003.TabBackgroundBrush" Color="Transparent"/>

    <LinearGradientBrush x:Key="Office2003.TabHoverBackgroundBrush" StartPoint="0.5, 0" EndPoint="0.5, 1">
        <GradientStop Color="#FDF1C0" Offset="0"/>
        <GradientStop Color="#F7C25F" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="Office2003.TabSelectedBackgroundBrush" StartPoint="0.5, 0" EndPoint="0.5, 1">
        <GradientStop Color="#F7D778" Offset="0"/>
        <GradientStop Color="#E8820C" Offset="1"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="Office2003.MenuItemBackgroundBrush" Color="#FFEEC2" />
    <LinearGradientBrush x:Key="Office2003.ContextMenuBarBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#E3EFFF" Offset="0" />
            <GradientStop Color="#87ADE4" Offset="1" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
	
	 <local:ImageAlignmentToDockConverter x:Key="ImageAlignmentToDockConverter"/>

    <DataTemplate x:Key="HeaderDataTemplate" DataType="{x:Type local:TabItemExt}">
        <TextBlock Focusable="False" Text="{Binding FallbackValue=''}" TextTrimming="CharacterEllipsis" 
				   IsHitTestVisible="False" Padding="4,0,4,1" />
    </DataTemplate>

    <DataTemplate x:Key="EditableDataTemplate" DataType="{x:Type local:TabItemExt}">
        <TextBox x:Name="EditableHeader" Focusable="True" Style="{Binding Path=EditHeaderItemStyle, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}"
				 Text="{Binding Path=Header, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabItemExt}}, Mode=TwoWay}"  
				 IsReadOnly="False" Padding="4,1,4,1" />
    </DataTemplate>

    <LinearGradientBrush x:Key="background" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFCFDFD" Offset="0"/>
        <GradientStop Color="#FFE5EAF5" Offset="0.3"/>
        <GradientStop Color="#FFCFD7EB" Offset="0.3"/>
        <GradientStop Color="#FFE0E5F5" Offset="0.7"/>
        <GradientStop Color="#FFECEEFC" Offset="1"/>
    </LinearGradientBrush>


    <ControlTemplate TargetType="{x:Type TabItem}" 
                                     x:Key="newtabitem">
        <Border BorderThickness="0" 
                                Margin="2,0,0,0"  Name="Bd"
                                BorderBrush="AliceBlue" 
                                Background="{StaticResource background}"
                                CornerRadius="5,5,0,0">
        </Border>      
    </ControlTemplate>


    <local:CloseButtonTypeToVisibilityConverter x:Key="CloseButtonTypeToVisibilityConverter"/>
    <shared:BooleanToVisibilityConverterEx x:Key="BooleanToVisibilityConverterEx"/>
   
    <ControlTemplate x:Key="Office2003CloseButtonTemplate" TargetType="{x:Type ButtonBase}">
        <shared:Border3D x:Name="brdBack" BorderThickness="1"
                BorderBrush="{StaticResource Office2003.ButtonInactiveBorderBrush}">
            <Path Name="pathButton" SnapsToDevicePixels="True"
				Stroke="{StaticResource Office2003.ButtonInactivePathBrush}"
				StrokeThickness="1.5"
                Data="M1,1 L7,7 M1,7 L7,1"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8"/>
        </shared:Border3D>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="brdBack" Property="IsInverted" Value="True"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" TargetName="brdBack" Value="{StaticResource Office2003.ButtonBackgroundBrush}"/>
                <Setter Property="BorderBrush" TargetName="brdBack" Value="{x:Null}"/>
                <!--<Setter TargetName="brdBack" Property="Background" Value="{StaticResource Office2003.ButtonBackgroundBrush}"/>               
                <Setter TargetName="pathButton" Property="Stroke" Value="{StaticResource Office2003.ButtonActivePathBrush}" />-->
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

   
      <ControlTemplate x:Key="Office2003MenuButtonTemplate" TargetType="{x:Type ButtonBase}">
        <shared:Border3D x:Name="brdBack" BorderThickness="1"
                BorderBrush="{StaticResource Office2003.ButtonInactiveBorderBrush}">
            <Path Name="pathButton" SnapsToDevicePixels="True"
				Fill="{StaticResource Office2003.ButtonInactivePathBrush}"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8">
                <Path.Data>
                    <GeometryGroup>
                        <PathGeometry>
                            <PathFigure StartPoint="0,1" IsFilled="True" IsClosed="True">
                                <LineSegment Point="8,1"/>
                                <LineSegment Point="8,3"/>
                                <LineSegment Point="0,3"/>
                            </PathFigure>
                        </PathGeometry>
                        <PathGeometry>
                            <PathFigure StartPoint="0,4" IsFilled="True" IsClosed="True">
                                <LineSegment Point="4,8"/>
                                <LineSegment Point="8,4"/>
                            </PathFigure>
                        </PathGeometry>
                    </GeometryGroup>
                </Path.Data>
            </Path>
        </shared:Border3D>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=IsAllItemsVisible,RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter TargetName="pathButton" Property="Data" Value="M0,4 L4,8 L8,4 z"/>
            </DataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="brdBack" Property="IsInverted" Value="True"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <!--<Setter TargetName="brdBack" Property="Background" Value="{StaticResource Office2003.ButtonBackgroundBrush}"/>
                <Setter TargetName="pathButton" Property="Fill" Value="{StaticResource Office2003.ButtonActivePathBrush}"/>-->
                <Setter Property="Background" TargetName="brdBack" Value="{StaticResource Office2003.ButtonBackgroundBrush}"/>
                <Setter Property="BorderBrush" TargetName="brdBack" Value="{x:Null}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Office2003TabScrollingButton" TargetType="{x:Type Button}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <shared:Border3D x:Name="PART_Border" VerticalAlignment="Center" HorizontalAlignment="Center"
				Margin="1,0,0,0"
                Padding="1"
                Width="15"
                Height="15"
                BorderThickness="1"
                BorderBrush="{StaticResource Office2003.ButtonInactiveBorderBrush}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True"
				CornerRadius="0">
                        <Canvas Width="8" Height="7">
                            <Path Data="M0,0L4,3.5 0,7" HorizontalAlignment="Center" Stroke="{StaticResource Office2003.ButtonInactivePathBrush}" Fill="{StaticResource Office2003.ButtonInactivePathBrush}" Name="PART_Path1" VerticalAlignment="Center"/>
                            <Path Data="M4,0L8,3.5 4,7" HorizontalAlignment="Center" Stroke="{StaticResource Office2003.ButtonInactivePathBrush}" Fill="{StaticResource Office2003.ButtonInactivePathBrush}" Name="PART_Path2" VerticalAlignment="Center"/>
                            <Path Data="M5,0L5,7" HorizontalAlignment="Center" Stroke="{StaticResource Office2003.ButtonInactivePathBrush}" Fill="{StaticResource Office2003.ButtonInactivePathBrush}" Name="PART_Path3" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Canvas>
                    </shared:Border3D>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="LastTab">
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Path3" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="FirstTab">
                            <Setter TargetName="PART_Path2" Property="Data" Value="M8,0L4,3.5 8,7"/>
                            <Setter TargetName="PART_Path3" Property="Data" Value="M2,0L2,7"/>
                            <Setter TargetName="PART_Path1" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Path3" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="PrevPage">
                            <Setter TargetName="PART_Path1" Property="Data" Value="M4,0L0,3.5 4,7"/>
                            <Setter TargetName="PART_Path2" Property="Data" Value="M8,0L4,3.5 8,7"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="PrevTab">
                            <Setter TargetName="PART_Path1" Property="Data" Value="M4,0L0,3.5 4,7"/>
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="NextTab">
                            <Setter TargetName="PART_Path2" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Border" Property="IsInverted" Value="True"/>
                            <Setter Property="Content" Value="1,1,-1,-1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="PART_Border" Value="{StaticResource Office2003.ButtonBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="PART_Border" Value="{x:Null}"/>
                            <Setter Property="Stroke" TargetName="PART_Path1" Value="{StaticResource Office2003.ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path1" Value="{StaticResource Office2003.ButtonActivePathBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path2" Value="{StaticResource Office2003.ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path2" Value="{StaticResource Office2003.ButtonActivePathBrush}"/>
                            <Setter Property="Stroke" TargetName="PART_Path3" Value="{StaticResource Office2003.ButtonActivePathBrush}"/>
                            <Setter Property="Fill" TargetName="PART_Path3" Value="{StaticResource Office2003.ButtonActivePathBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Office2003TabPanelAdvStyle" TargetType="{x:Type local:TabPanelAdv}">
        <Setter Property="Padding" Value="0,2,0,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabPanelAdv}">
                    <Border Name="Bord" Background="{Binding TabPanelBackground,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:TabControlExt}},FallbackValue=Transparent}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
							Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}"
							CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top">


                        <DockPanel LastChildFill="True">
                            <Border Name="BottomBorder" Height="4" DockPanel.Dock="Bottom" Background="{StaticResource Office2003.TabPanelBottomBackgroundBrush}"/>


                            <ContentPresenter x:Name="PART_CustomItems"  AllowDrop="False" ContentSource="TabPanelItem"
                                              MaxHeight="{Binding Path=ActualHeight, ElementName=PART_TabItems}" Margin="2,0,0,0" DockPanel.Dock="Right" 
                                              Content="{Binding Path=TabPanelItem, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=''}">

                            </ContentPresenter>
                            <local:NewTabLayout>
                                <ContentPresenter x:Name="PART_ToolBarTray" Content="{Binding Path=ToolBarTray, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=''}" />
                                <local:TabItemExt BorderThickness="80" Name="PART_NewTab" DockPanel.Dock="Top" IsNewTab="True" />
                            </local:NewTabLayout>
                            <ToggleButton Name="PART_CloseButton" Width="14" Height="14" 
                                  DockPanel.Dock="Right"
                                  Focusable="False" 
                                  AllowDrop="False"
                                  Visibility="{Binding Path=CloseButtonType, Converter={StaticResource CloseButtonTypeToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=Collapsed}"
							      Template="{StaticResource Office2003CloseButtonTemplate}"
                                  Command="local:TabControlCommands.CloseCurrentTabItem" 
                                  >
                                <ToggleButton.ToolTip>
                                    <ToolTip Name="tooltip" >
                                        <TextBlock Name="tooltipText" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=CloseButtonTooltipText}"/>
                                    </ToolTip>
                                </ToggleButton.ToolTip>
                            </ToggleButton>

                            <ToggleButton Name="PART_MenuButton" Width="14" Height="14" 
                                  DockPanel.Dock="Right"
                                  AllowDrop="False"
                                  Focusable="True"
                                  Visibility="{Binding Path=ShowTabListContextMenu, Converter={StaticResource BooleanToVisibilityConverterEx}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=Collapsed}"
							      Template="{StaticResource Office2003MenuButtonTemplate}"
                                  Command="local:TabControlCommands.OpenContextMenu"
                                  >
                                <ToggleButton.ToolTip>
                                    <ToolTip Name="PART_ContextMenuButtonTooltip" >
                                        <TextBlock Name="PART_ContextMenuButtonTooltipText" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=ContextMenuButtonTooltipText}" />
                                    </ToolTip>
                                </ToggleButton.ToolTip>
                            </ToggleButton>

                            <Button Name="PART_LastTab" DockPanel.Dock="Right" Tag="LastTab" Visibility="Collapsed" Style="{StaticResource Office2003TabScrollingButton}"/>
                            <Button Name="PART_NextTab" DockPanel.Dock="Right" Tag="NextTab" Visibility="Collapsed" Style="{StaticResource Office2003TabScrollingButton}"/>
                            <Button Name="PART_PrevTab" DockPanel.Dock="Right" Tag="PrevTab" Visibility="Collapsed" Style="{StaticResource Office2003TabScrollingButton}"/>
                            <Button Name="PART_NextPage" DockPanel.Dock="Right" Tag="NextPage" Visibility="Collapsed" Style="{StaticResource Office2003TabScrollingButton}"/>
                            <Button Name="PART_PrevPage" DockPanel.Dock="Right" Tag="PrevPage" Visibility="Collapsed" Style="{StaticResource Office2003TabScrollingButton}"/>
                            <Button Name="PART_FirstTab" DockPanel.Dock="Right" Tag="FirstTab" Visibility="Collapsed" Style="{StaticResource Office2003TabScrollingButton}"/>

                            <ContentPresenter x:Name="PART_TabItems" ContentSource="TabItems" 
                                              DockPanel.Dock="Right" 
                                              Content="{TemplateBinding Content}"/>


                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                            <Setter TargetName="BottomBorder" Property="Height" Value="4"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}},FallbackValue=Top}" Value="Bottom">
                            <Setter Property="LayoutTransform" TargetName="PART_CustomItems">
                                <Setter.Value>
                                    <RotateTransform Angle="-180"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="LayoutTransform" TargetName="PART_CloseButton">
                                <Setter.Value>
                                    <RotateTransform Angle="-180"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="LayoutTransform" TargetName="PART_MenuButton">
                                <Setter.Value>
                                    <RotateTransform Angle="-180"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsAllTabsClosed,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}},FallbackValue=false}" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_MenuButton" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="BottomBorder" Property="Height" Value="0"/>
                        </DataTrigger>
			<MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=Items.Count,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:TabControlExt}},FallbackValue=0}" Value="1" />
                                <Condition Binding="{Binding Path=HideHeaderOnSingleChild,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:TabControlExt}}}" Value="True" />
                                <Condition Binding="{Binding Path=ShowTabListContextMenu,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type local:TabControlExt}}}" Value="False" />
                                <Condition Binding="{Binding ElementName=PART_CloseButton, Path=Visibility}"  Value="Collapsed"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bord" Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
<Style BasedOn="{StaticResource Office2003TabPanelAdvStyle}" TargetType="{x:Type local:TabPanelAdv}"/>

   <Style x:Key="Office2007DragMarkerStyle" TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
        <Setter Property="MinWidth" Value="15"/>
        <Setter Property="MinHeight" Value="15"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
                    <Canvas x:Name="PART_Arrow" HorizontalAlignment="Left" VerticalAlignment="Top" Height="9" Width="8">
                        <Canvas.RenderTransform>
                            <TranslateTransform X="8" Y="-10"/>
                        </Canvas.RenderTransform>
                        <Path Data="M3,0L3,7 L1,7 L4.5,10 L8,7 L6,7 L6,0 L2.5,0" Fill="{Binding Path=MarkerColor,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DragMarkerAdorner}}}" Stroke="Black"/>
                    </Canvas>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=AdornerAlignment,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:DragMarkerAdorner}}}" Value="RightSide">
                            <Setter Property="RenderTransform" TargetName="PART_Arrow">
                                <Setter.Value>
                                    <TranslateTransform X="-1.5" Y="-10"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <system:Double x:Key="NanValue">
        NaN
    </system:Double>
    <Style TargetType="MenuItem" x:Key="Office2003CustomMenuItem">
        <Setter Property="Margin" Value="1"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource ResourceKey={x:Static SystemColors.MenuTextBrushKey}}"/>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Rectangle Name="Bg"
                            RadiusX="3"
                            RadiusY="3"
                            Fill="{TemplateBinding Panel.Background}"
                            Stroke="{TemplateBinding Border.BorderBrush}" StrokeThickness="1" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="24" SharedSizeGroup="MenuItemIconColumnGroup" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                                <ColumnDefinition Width="17" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{TemplateBinding MenuItem.Icon}" ContentSource="Icon" Name="Icon" Width="16" Height="16" Margin="1,1,1,1" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                            <Border BorderThickness="1,1,1,1" CornerRadius="3,3,3,3" BorderBrush="#FFCDD3E6" Background="#FFE6EFF4" Name="GlyphPanel" Width="22" Height="22" Margin="1,1,1,1" Visibility="Hidden">
                                <Path Data="M0,5.1L1.7,5.2 3.4,7.1 8,0.4 9.2,0 3.3,10.8z" Fill="#FF0C12A1" Name="Glyph" Width="9" Height="11" FlowDirection="LeftToRight" />
                            </Border>
                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" Content="{TemplateBinding HeaderedContentControl.Header}" ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}" ContentSource="Header" Margin="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" Grid.Column="2" />
                            <TextBlock Text="{TemplateBinding MenuItem.InputGestureText}" Margin="{TemplateBinding Control.Padding}" Grid.Column="4" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Classic">
                            <Setter TargetName="Bg" Property="RadiusX" Value="0" />
                            <Setter TargetName="Bg" Property="RadiusY" Value="0" />
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                            <Setter TargetName="Bg" Property="RadiusX" Value="0" />
                            <Setter TargetName="Bg" Property="RadiusY" Value="0" />
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                            <Setter TargetName="GlyphPanel" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="GlyphPanel" Property="Background" Value="Transparent" />
                            <Setter TargetName="Glyph" Property="Fill" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="MenuItem.Icon" Value="x:Null">
                            <Setter Property="UIElement.Visibility" TargetName="Icon" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="MenuItem.IsChecked" Value="True">
                            <Setter Property="UIElement.Visibility" TargetName="GlyphPanel" Value="Visible"/>
                            <Setter Property="UIElement.Visibility" TargetName="Icon" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="MenuItem.IsHighlighted" Value="True">
                            <Setter Property="Shape.Fill" TargetName="Bg" Value="{StaticResource Office2003.MenuItemBackgroundBrush}"/>
                            <Setter Property="Shape.Stroke" TargetName="Bg" Value="{StaticResource Office2003.MenuItemBorderBrush}"/>
                            <Setter Property="TextElement.Foreground" Value="{StaticResource ResourceKey={x:Static SystemColors.MenuTextBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="UIElement.IsEnabled" Value="False">
                            <Setter Property="TextElement.Foreground" Value="#FF9A9A9A"/>
                            <Setter Property="Panel.Background" TargetName="GlyphPanel" Value="#FFEEE9E9"/>
