            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter  Property="Background" Value="{StaticResource Office2007Blue_GroupBar_HeaderBrush}"/>
                <Setter  Property="TextElement.Foreground"  Value="{StaticResource VisualStudio2005Metallic_TabText_Brush}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter  Property="Background" Value="{StaticResource Office2007Black_GroupBar_HeaderBrush}"/>
                <Setter  Property="TextElement.Foreground"  Value="{StaticResource VisualStudio2005Metallic_TabText_Brush}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter  Property="Background" Value="{StaticResource Office2007Silver_GroupBar_HeaderBrush}"/>
                <Setter  Property="TextElement.Foreground"  Value="{StaticResource VisualStudio2005Metallic_TabText_Brush}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter  Property="Background" Value="{StaticResource Orange_GroupBar_HeaderBrush}"/>
                <Setter  Property="TextElement.Foreground" Value="{StaticResource Orange_TabText_Brush}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter  Property="Background"  Value="{StaticResource NormalBackgroundBrushKey.ShinyRed}"/>
                <Setter  Property="TextElement.Foreground"  Value="{StaticResource TextBrushKey.ShinyRed}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyBlue">
