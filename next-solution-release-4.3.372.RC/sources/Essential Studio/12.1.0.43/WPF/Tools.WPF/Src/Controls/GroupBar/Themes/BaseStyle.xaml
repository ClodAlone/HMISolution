    <Style x:Key="HeaderStyle" TargetType="{x:Type Border}">
        <Setter  Property="Background" Value="{StaticResource Office2007Blue_GroupBar_HeaderBrush}"/>
        <Setter  Property="TextBlock.FontSize" Value="14"/>
        <Setter  Property="TextBlock.FontStyle" Value="Normal"/>
        <Setter  Property="TextBlock.TextAlignment" Value="Center"/>
        <Setter  Property="TextElement.Foreground"  Value="{StaticResource VisualStudio2005_TabText_Brush}"/>
        <Setter  Property="Height" Value="{Binding Path=HeaderHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"/>
        <Setter  Property="BorderThickness" Value="1,1,1,1"/>
        <Setter  Property="CornerRadius" Value="{Binding Path=HeaderTopCornerRadius, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"/>
        <Setter  Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GroupBar}}}"/>
        <Setter  Property="TextElement.FontWeight" Value="Bold"/>
        <Style.Triggers >
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Blend">
                <Setter  Property="Background" Value="{StaticResource Blend_GroupBar_HeaderBrush}"/>
                <Setter  Property="TextElement.Foreground"  Value="{StaticResource Blend_TabText_Brush}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2003">
                <Setter  Property="Background" Value="{StaticResource Office2003_GroupBar_HeaderBrush}"/>
                <Setter  Property="TextElement.Foreground"  Value="{StaticResource VisualStudio2005Metallic_TabText_Brush}"/>
