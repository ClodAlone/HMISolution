                <Setter Property="Margin" Value="{StaticResource OfficeGroupViewItemMargin}"/>
                <Setter Property="Template" Value="{StaticResource GroupViewItemTemplateKey.ShinyRed}"/>
                <Setter Property="MouseHoverColor" Value="{StaticResource GroupViewItemHighlightColor.ShinyRed}"/>
            </MultiTrigger>
            
            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="componentModel:DesignerProperties.IsInDesignMode" Value="False"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyBlue"/>
                </MultiTrigger.Conditions>
