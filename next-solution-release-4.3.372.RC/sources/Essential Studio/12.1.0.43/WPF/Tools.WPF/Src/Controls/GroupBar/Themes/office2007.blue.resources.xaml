<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- GroupBar -->
	<SolidColorBrush x:Key="Office2007Blue_GroupBar_BorderBrush" Color="#FF6593CF"/>
	<LinearGradientBrush x:Key="Office2007Blue_GroupBar_HeaderBrush"
						 StartPoint="0,0"
						 EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFE3EFFF"/>
				<GradientStop Offset="0.4" Color="#FFC4DDFF"/>
				<GradientStop Offset="0.4" Color="#FFADD1FF"/>
				<GradientStop Offset="1" Color="#FFC0DBFF"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2007Blue_GroupBar_Content" Color="#FFDCEBFE"/>

	<!--GroupBarItem-->
	<LinearGradientBrush x:Key="Office2007Blue_GroupBarItem_NormalStateBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFE3EFFF"/>
			<GradientStop Offset="0.4" Color="#FFC4DDFF"/>
			<GradientStop Offset="0.4" Color="#FFADD1FF"/>
			<GradientStop Offset="1" Color="#FFC0DBFF"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Blue_GroupBarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFD9AA"/>
			<GradientStop Offset="0.4" Color="#FFFFBB6E"/>
			<GradientStop Offset="0.4" Color="#FFFFAB3F"/>
			<GradientStop Offset="1" Color="#FFFEE17A"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Blue_GroupBarItem_OverBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFFEE4"/>
			<GradientStop Offset="0.4" Color="#FFFFE8A7"/>
			<GradientStop Offset="0.4" Color="#FFFFD767"/>
			<GradientStop Offset="1" Color="#FFFFE69E"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Blue_GroupBarItem_OverSelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFBD69"/>
			<GradientStop Offset="0.4" Color="#FFFFAC42"/>
			<GradientStop Offset="0.4" Color="#FFFB8C3C"/>
			<GradientStop Offset="1" Color="#FFFED364"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2007Blue_GroupViewItem_SeparatorBrush" Color="#FF6593CF"/>

	<!-- GroupView -->
	<SolidColorBrush x:Key="Office2007Blue_GroupView_Background" Color="#FFDCEBFE"/>

	<!-- GroupViewItem -->
	<Color x:Key="Office2007Blue_GroupViewItem_OverBackgroundColor">#FFFFD091</Color>
	<Color x:Key="Office2007Blue_GroupViewItem_PressedBackgroundColor">#FFFE9552</Color>
	<Color x:Key="Office2007Blue_GroupViewItem_SelectedBackgroundColor">#FFFFAD55</Color>
	<Color x:Key="Office2007Blue_GroupViewItem_SelectedOverBackgroundColor">#FFFE914E</Color>

	<SolidColorBrush x:Key="Office2007Blue_GroupViewItem_BackgroundBrush" Color="#FFDCEBFE"/>
	<SolidColorBrush x:Key="Office2007Blue_GroupViewItem_BorderBrush" Color="#FFDCEBFE"/>
	<SolidColorBrush x:Key="Office2007Blue_GroupViewItem_OverBackgroundBrush" Color="#FFFFD091"/>
	<SolidColorBrush x:Key="Office2007Blue_GroupViewItem_OverBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2007Blue_GroupViewItem_PressedBackgroundBrush" Color="#FFFE9552"/>
	<SolidColorBrush x:Key="Office2007Blue_GroupViewItem_PressedBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2007Blue_GroupViewItem_SelectedBackgroundBrush" Color="#FFFFAD55"/>
	<SolidColorBrush x:Key="Office2007Blue_GroupViewItem_SelectedBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2007Blue_GroupViewItem_SelectedOverBackgroundBrush" Color="#FFFE914E"/>

	<!-- Splitter -->
	<LinearGradientBrush x:Key="Office2007Blue_Splitter_BackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFFFFF"/>
			<GradientStop Offset="1" Color="#FFB6D6FF"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2007Blue_PointBrush" Color="#FF6593CF"/>

	<!--NavigationToolbar-->
	<LinearGradientBrush x:Key="Office2007Blue_NavigationToolbar_BackgroundBrush"
						 StartPoint="0,0"
						 EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFE3EFFF"/>
				<GradientStop Offset="0.4" Color="#FFC4DDFF"/>
				<GradientStop Offset="0.4" Color="#FFADD1FF"/>
				<GradientStop Offset="1" Color="#FFC0DBFF"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!--NavigationToolbarItem-->
	<LinearGradientBrush x:Key="Office2007Blue_NavigationToolbarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFD9AA"/>
			<GradientStop Offset="0.4" Color="#FFFFBB6E"/>
			<GradientStop Offset="0.4" Color="#FFFFAB3F"/>
			<GradientStop Offset="1" Color="#FFFEE17A"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Blue_NavigationToolbarItem_OverBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFFEE4"/>
			<GradientStop Offset="0.4" Color="#FFFFE8A7"/>
			<GradientStop Offset="0.4" Color="#FFFFD767"/>
			<GradientStop Offset="1" Color="#FFFFE69E"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Blue_NavigationToolbarItem_SelectedOverBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFBD69"/>
			<GradientStop Offset="0.4" Color="#FFFFAC42"/>
			<GradientStop Offset="0.4" Color="#FFFB8C3C"/>
			<GradientStop Offset="1" Color="#FFFED364"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2007Blue_NavigationToolbarItem_ArrowBrush1" Color="#FF4371B0"/>
	<SolidColorBrush x:Key="Office2007Blue_NavigationToolbarItem_ArrowBrush2" Color="#FFFFF8CB"/>	

	<!-- MenuItem -->
	<SolidColorBrush x:Key="Office2007Blue_MenuItem_Brush" Color="#FFE9EEEE"/>
	<SolidColorBrush x:Key="Office2007Blue_MenuItem_OverBrush" Color="#FFFFE7A2"/>
	<SolidColorBrush x:Key="Office2007Blue_MenuItem_OverBorderBrush" Color="#FFFFBD69"/>
	<SolidColorBrush x:Key="Office2007Blue_MenuItem_SelectedBackgroundBrush" Color="#FFFFAB3F"/>
	<SolidColorBrush x:Key="Office2007Blue_MenuItem_SelectedOverBackgroundBrush" Color="#FFFFAB3F"/>
	<SolidColorBrush x:Key="Office2007Blue_MenuItem_SeparatorBrush" Color="#FF9AC6FF"/>

	<!-- Menu -->
	<SolidColorBrush x:Key="Office2007Blue_Menu_BackgroundBrush" Color="#FFF6F6F6"/>
	<SolidColorBrush x:Key="Office2007Blue_Menu_BorderBrush" Color="#FF6593CF"/>

	<!-- MenuText -->
	<SolidColorBrush x:Key="Office2007Blue_MenuText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="Office2007Blue_MenuText_SelectedBrush" Color="Black"/>
	<SolidColorBrush x:Key="Office2007Blue_MenuText_DisabledBrush" Color="Gray"/>

	<!-- Text -->
	<SolidColorBrush x:Key="Office2007Blue_TabText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="Office2007Blue_ItemText_Brush" Color="Black"/>

    <SolidColorBrush x:Key="Office2007Blue_CollapseArrowColor" Color="#567DB1"/>
    <SolidColorBrush x:Key="Office2007Blue_PopupBorderFillColor" Color="#C0DBFF"/>
    <SolidColorBrush x:Key="Office2007Blue_NavigationPaneColor" Color="#DDEBFF"/>
    <SolidColorBrush x:Key="Office2007Blue_NavigationPaneMouseOverColor" Color="#FFC06F"/>
    <SolidColorBrush x:Key="Office2007Blue_NavigationPaneTextColor" Color="#15428B"/>
    <SolidColorBrush x:Key="Office2007Blue_NavigationPaneBorderColor" Color="#6593CF"/>
    <SolidColorBrush x:Key="Office2007Blue_NavigationPaneCheckedBorderColor" Color="#6593CF"/>

</ResourceDictionary>