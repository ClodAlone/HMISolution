<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"  xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"    xmlns:converters="clr-namespace:Syncfusion.Windows.Tools"
	                >

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <SolidColorBrush x:Key="Transparent" Color="Transparent" />

    <SolidColorBrush x:Key="Office2010BlueAutoCompleteBackground" Color="#FFEDF5FD" />
    <SolidColorBrush x:Key="Office2010BlueAutoCompleteBorderBrush" Color="#FFB1C0D6" />
    <Thickness x:Key="XP.Margin" >1</Thickness>
    <Thickness x:Key="Vista.Margin">0</Thickness>
    <SolidColorBrush x:Key="White" Color="White" />

    <LinearGradientBrush x:Key="Office2010BlueToggleButtonArrowFill" EndPoint="0.614,0.647" StartPoint="0.129,0.118">
        <GradientStop Color="#FF757779" Offset="0" />
        <GradientStop Color="#FF505153" Offset="1" />
    </LinearGradientBrush>

    <converters:PopupControlRelatedPlacementConverter x:Key="PopupPlacementConverter" />

    <SolidColorBrush x:Key="Office2010BlueForeground" Color="Black" />

    <SolidColorBrush x:Key="Black" Color="Black" />

    <LinearGradientBrush x:Key="Office2010BlueToggleButtonMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF9E7A1" Offset="0.073" />
        <GradientStop Color="#FFF9E085" Offset="0.384" />
        <GradientStop Color="#FFF9E69F" Offset="0.84" />
        <GradientStop Color="#FFFAF2CD" Offset="0.971" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Office2010BlueToggleButtonPressedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFAD577" Offset="0" />
        <GradientStop Color="#FFFCDB7F" Offset="0.039" />
        <GradientStop Color="#FFFFE48A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Office2010BlueToggleButtonPressedBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC27A2D" Offset="0.113" />
        <GradientStop Color="#FFC29A44" Offset="0.887" />
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFEDC757" x:Key="Office2010ToggleButtonMouseOverBorderBrush" />
    <LinearGradientBrush x:Key="Office2010BlueToggleButtonMouseOverInnerBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFCF4D7" Offset="0.649" />
        <GradientStop Color="#FFFCF8E8" Offset="0.905" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2010BlueToggleButtonPressedInnerBackground" Color="#FFF7D072" />
    <Style x:Key="OfficeToggleDropDownButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FrameworkElement.MinWidth" Value="0" />
        <Setter Property="FrameworkElement.MinHeight" Value="0" />
        <Setter Property="FrameworkElement.Width" Value="17" />
        <Setter Property="FrameworkElement.Height" Value="NaN" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Background" Value="{StaticResource Office2010BlueAutoCompleteBackground}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="BorderBrush" Value="{StaticResource Transparent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Name="PART_Border"
                                Background="{TemplateBinding Panel.Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                        <Border BorderThickness="0" Background="Transparent" x:Name="InnerBorder"  Margin="1">

                            <Path Stretch="Fill" VerticalAlignment="Center" HorizontalAlignment="Center"  SnapsToDevicePixels="True"  Data="F1 M 386,271.344L 392.667,271.344L 392.667,272.677L 391.312,272.677L 391.312,274.01L 390.021,274.01L 390.021,275.323L 388.646,275.323L 388.646,273.969L 387.354,273.969L 387.354,272.635L 386,272.635L 386,271.344 Z "  Height="3"   Width="5.5">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0.395101,-0.0808108" EndPoint="1.07361,-0.0808108">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TransformGroup>
                                                <SkewTransform CenterX="0.395101" CenterY="-0.0808108" AngleX="27.1126" AngleY="0" />
                                                <RotateTransform CenterX="0.395101" CenterY="-0.0808108" Angle="66.6663" />
                                            </TransformGroup>
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF6E6B5F" Offset="0" />
                                        <GradientStop Color="#FF44433F" Offset="1" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>

                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Office2010ToggleButtonMouseOverBorderBrush}" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Office2010BlueToggleButtonMouseOverInnerBackground}">
                            </Setter>
                            <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource Office2010BlueToggleButtonMouseOverBackground}" />
                        </Trigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition  Binding="{Binding Path=(local:AutoComplete.IsKeyboardFocusWithin), RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" Value="true" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Office2010ToggleButtonMouseOverBorderBrush}" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Office2010BlueToggleButtonMouseOverInnerBackground}">
                            </Setter>
                            <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource Office2010BlueToggleButtonMouseOverBackground}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition  Binding="{Binding Path=(local:AutoComplete.IsKeyboardFocusWithin), RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" Value="true" />
                                <Condition  Binding="{Binding Path=(local:AutoComplete.IsHistoryDropDownOpen), RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" Value="true" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource Office2010BlueToggleButtonPressedBackground}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Office2010BlueToggleButtonPressedBorderBrush}" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Office2010BlueToggleButtonPressedInnerBackground}">
                            </Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition  Binding="{Binding Path=(local:AutoComplete.IsKeyboardFocusWithin), RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" Value="true" />
                                <Condition  Binding="{Binding Path=(local:AutoComplete.IsDropDownOpen), RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" Value="true" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource Office2010BlueToggleButtonPressedBackground}" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Office2010BlueToggleButtonPressedBorderBrush}" />
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Office2010BlueToggleButtonPressedInnerBackground}">
                            </Setter>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Thumb Style-->
    <SolidColorBrush x:Key="Office2010BlueAutoCompleteThumbFillcolor" Color="#FFBCC6D1" />
    <Style x:Key="Office2010BlueThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="{StaticResource Office2010BlueAutoCompleteThumbFillcolor}" />
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Height="12" Width="8" Margin="0,2,0,0">
                        <Path Margin="0,0,0,0" Data="M7,0L7,7 0,7 0,4 4,4 4,0z">
                            <Path.Fill>
                                <DrawingBrush ViewboxUnits="Absolute" TileMode="Tile" Viewbox="0,0,4,4" Viewport="0,0,4,4" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <DrawingGroup.Children>
                                                <GeometryDrawing Brush="#00FFFFFF">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,1,1" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#FFF7FFFF"  Geometry="M1,1L3,1 3,3 1,3z" />
                                                <GeometryDrawing Brush="#FFBCC6D1"  Geometry="M0,0L2,0 2,2 0,2z" />
                                            </DrawingGroup.Children>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Path.Fill>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <LinearGradientBrush x:Key="Office2010BlueMouseOverToggleButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFECF5FD" Offset="0.078" />
        <GradientStop Color="#FFD9E8F8" Offset="0.87" />
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFABBAD0" x:Key="Office2010BlueMouseOverToggleButtonBorderBrush" />
    <Style x:Key="Office2010BlueAutoCompleteStyle" TargetType="{x:Type local:AutoComplete}">

        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="MinWidth" Value="15" />
        <Setter Property="MinHeight" Value="20" />

        <Setter Property="Background" Value="{StaticResource Office2010BlueAutoCompleteBackground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Office2010BlueAutoCompleteBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Office2010BlueForeground}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type local:AutoComplete}">
                    <Border Name="MainBorder"
                BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BorderThickness="{TemplateBinding BorderThickness}"
                TextBlock.Foreground="{StaticResource Office2010BlueForeground}">
                        <Grid Name="ContentGrid"
>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*" />
                                <ColumnDefinition Width="Auto" MinWidth="13" />
                            </Grid.ColumnDefinitions>

                            <local:VistaSpecificProgressBar x:Name="PART_VistaProgressBar" Grid.Column="0" />
                            <TextBox Name="PART_EditableTextBox"
                 Grid.Column="0" Style="{x:Null}"
                 Margin="0"
				 VerticalAlignment="Center"
                 Background="Transparent"
			     Foreground="{TemplateBinding Foreground}"
                 BorderThickness="0"
                 FontFamily="{TemplateBinding FontFamily}"
				 FontSize="{TemplateBinding FontSize}"
                 FontStretch="{TemplateBinding FontStretch}"
				 FontStyle="{TemplateBinding FontStyle}"
                 FontWeight="{TemplateBinding FontWeight}"
				 Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
 />
                            <ToggleButton Name="PART_CheckButton" Grid.Column="1" BorderThickness="1"  Margin="0,-1,-1,-1" BorderBrush="{StaticResource Transparent}"
                              SnapsToDevicePixels="True"
							        Visibility="{Binding Path=EnableDropDown, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource BooleanToVisibilityConverter}}"
							        IsChecked="False"
							        Style="{StaticResource OfficeToggleDropDownButtonStyle}"
>

                                <Path Name="PART_Arrow"
                Data="M0,0 L3,4 6,0"

                Fill="{StaticResource Office2010BlueToggleButtonArrowFill}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
			   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}"
             VerticalOffset="1"
                                   AllowsTransparency="True"
			   SnapsToDevicePixels="True"
               Focusable="False"
               PopupAnimation="Slide">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome SnapsToDevicePixels="True"  x:Name="Shdw">
                                    <Border SnapsToDevicePixels="True" BorderThickness="1"  BorderBrush="#FFA7ABB0" Background="White">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition Height="13"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <ListBox Name="PART_Container"    KeyboardNavigation.DirectionalNavigation="Cycle"
                             SelectionMode="{TemplateBinding SelectionMode}" Grid.Row="0"
                   IsSynchronizedWithCurrentItem="True"
                   SnapsToDevicePixels="True" BorderThickness="0"
				   Width="{Binding Path=ActualWidth, ElementName=ContentGrid}"
				   MaxHeight="{TemplateBinding MaxDropHeight}"
                   Focusable="True">
                                            </ListBox>
                                            <Border BorderBrush="#FFDDE7EE" Grid.Row="1" CornerRadius="0,0,2,2" Margin="1" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">
                                                <Border.Background>
                                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                        <GradientStop Color="#FFECF5FD" Offset="0.185" />
                                                        <GradientStop Color="#FFDDEBF9" Offset="0.798" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Thumb x:Name="ContainerThumb" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource Office2010BlueThumbStyle}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                            <Popup Name="HistoryPopup"
               SnapsToDevicePixels="True" VerticalOffset="1"
     		   Placement="{Binding Path=PopupPlacement, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}, Converter={StaticResource PopupPlacementConverter}}"
               AllowsTransparency="True"
               Focusable="False"
               PopupAnimation="Slide"
			   IsOpen="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome SnapsToDevicePixels="True"  x:Name="Shdw1">
                                    <Border SnapsToDevicePixels="True" BorderThickness="1"  BorderBrush="#FFA7ABB0" Background="White">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                                <RowDefinition Height="13"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <ListBox Name="PART_HistoryContainer"    KeyboardNavigation.DirectionalNavigation="Cycle"
                              SelectionMode="{TemplateBinding SelectionMode}" Grid.Row="0"
                   IsSynchronizedWithCurrentItem="True"
                   SnapsToDevicePixels="True" BorderThickness="0"
			       Height="{TemplateBinding HistoryListHeight}"
			       Width="{TemplateBinding ActualWidth}"
                   Focusable="True"
>
                                            </ListBox>
                                            <Border BorderBrush="#FFDDE7EE" Grid.Row="1" CornerRadius="0,0,2,2" Margin="1" BorderThickness="0,1,0,0" HorizontalAlignment="Stretch">
                                                <Border.Background>
                                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                        <GradientStop Color="#FFECF5FD" Offset="0.185" />
                                                        <GradientStop Color="#FFDDEBF9" Offset="0.798" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Thumb x:Name="HistoryThumb" Margin="0,0,0,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource Office2010BlueThumbStyle}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHistory" Value="True">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsHistoryDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsHistory" Value="False">
                            <Setter TargetName="PART_CheckButton" Property="IsChecked" Value="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:AutoComplete}}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="White" />
                            <Setter TargetName="PART_CheckButton" Property="Background" Value="{StaticResource Office2010BlueMouseOverToggleButtonBackground}" />
                            <Setter TargetName="PART_CheckButton" Property="BorderBrush" Value="{StaticResource Office2010BlueMouseOverToggleButtonBorderBrush}" />
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Single">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Multiple">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="False"></Setter>
                        </Trigger>
                        <Trigger Property="SelectionMode" Value="Extended">
                            <Setter TargetName="PART_Popup" Property="StaysOpen" Value="True"></Setter>
                        </Trigger>

                        <Trigger Property="HasDropShadow" SourceName="PART_Popup" Value="true">
                            <Setter Property="Margin" TargetName="Shdw" Value="0,0,5,5" />
                            <Setter Property="Color" TargetName="Shdw" Value="#FFA5AFB9" />
                        </Trigger>
                        <Trigger Property="HasDropShadow" SourceName="HistoryPopup" Value="true">
                            <Setter Property="Margin" TargetName="Shdw1" Value="0,0,5,5" />
                            <Setter Property="Color" TargetName="Shdw1" Value="#FFA5AFB9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource Office2010BlueAutoCompleteStyle}" TargetType="{x:Type local:AutoComplete}" />

</ResourceDictionary>