    <DropShadowBitmapEffect x:Key="PopupDropShadow" ShadowDepth="1.5" Softness="0.15"/>


  

    <!-- MenuItem Template -->
    <ControlTemplate x:Key="MenuItemKeyTemplate" TargetType="{x:Type MenuItem}">
        <Border  Name="Bd"
				 BorderThickness="0"
				 SnapsToDevicePixels="True"
				 Background="Transparent" >
            <Grid ShowGridLines="False" Background="Transparent" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="MenuItemIconColumnGroup" Width="22" MinWidth="17" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition SharedSizeGroup="MenuItemIGTColumnGroup" Width="Auto" />
                    <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>

                <Border Name="grad" 
						SnapsToDevicePixels="True" 
						Background="{StaticResource Office2007Blue_MenuItem_Brush}">
                </Border>

                <Border Name="back" 
						BorderThickness="1" 
						SnapsToDevicePixels="True" 
						Grid.ColumnSpan="4" 
						Background="LightBlue" 
						BorderBrush="{StaticResource Office2007Blue_MenuItem_OverBorderBrush}" 
						Opacity="0"/>

                <Border Name="GlyphPanel"
						Visibility="Hidden"
						HorizontalAlignment="Center"
						Margin="0,1,2,1"
						VerticalAlignment="Center"
						Width="20"
						Height="20"
						Background="{StaticResource Office2007Blue_MenuItem_SelectedBackgroundBrush}"
						BorderThickness="1"
						BorderBrush="{StaticResource Office2007Blue_MenuItem_OverBorderBrush}">

                    <Path Name="Glyph" 
						  Fill="{TemplateBinding Border.Background}"
						  Stretch="Fill"
						  Stroke="Black"
						  HorizontalAlignment="Center"
						  Margin="0"
						  VerticalAlignment="Center"
						  Width="7.5"
						  Height="5.875"
						  Data="M5.375,11.125 L7.75,13.25 11.875,8.375"/>
                </Border>

                <ContentPresenter Name="HeaderHost"
								  Margin="4,2,4,2"
								  RecognizesAccessKey="True" 
								  VerticalAlignment="Center"
								  Grid.Column="1"
								  ContentSource="Header"
								  ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}">
                </ContentPresenter>

                <TextBlock Margin="5,2,0,2"
						   Grid.Column="2"
						   DockPanel.Dock="Right"
						   Text="{TemplateBinding MenuItem.InputGestureText}"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="MenuItem.IsChecked" Value="True">
                <Setter TargetName="GlyphPanel" Property="UIElement.Visibility" Value="{x:Static Visibility.Visible}"/>
            </Trigger>
            <Trigger Property="MenuItem.IsHighlighted" Value="True">
                <Setter TargetName="back" Property="Opacity" Value="1"/>
            </Trigger>          
            

            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Blend">
                <Setter TargetName="grad" Property="Background" Value="{StaticResource Blend_MenuItem_Brush}"/>
                <Setter TargetName="back" Property="BorderBrush" Value="{StaticResource Blend_MenuItem_OverBorderBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource Blend_MenuItem_SelectedBackgroundBrush}"/>
                <Setter TargetName="GlyphPanel" Property="BorderBrush" Value="{StaticResource Blend_MenuItem_OverBorderBrush}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2003">
                <Setter TargetName="grad" Property="Background" Value="{StaticResource Office2003_MenuItem_Brush}"/>
                <Setter TargetName="back" Property="BorderBrush" Value="{StaticResource Office2003_MenuItem_OverBorderBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource Office2003_MenuItem_SelectedBackgroundBrush}"/>
                <Setter TargetName="GlyphPanel" Property="BorderBrush" Value="{StaticResource Office2003_MenuItem_OverBorderBrush}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter TargetName="grad" Property="Background" Value="{StaticResource Office2007Blue_MenuItem_Brush}"/>
                <Setter TargetName="back" Property="BorderBrush" Value="{StaticResource Office2007Blue_MenuItem_OverBorderBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource Office2007Blue_MenuItem_SelectedBackgroundBrush}"/>
                <Setter TargetName="GlyphPanel" Property="BorderBrush" Value="{StaticResource Office2007Blue_MenuItem_OverBorderBrush}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter TargetName="grad" Property="Background" Value="{StaticResource Office2007Silver_MenuItem_Brush}"/>
                <Setter TargetName="back" Property="BorderBrush" Value="{StaticResource Office2007Silver_MenuItem_OverBorderBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource Office2007Silver_MenuItem_SelectedBackgroundBrush}"/>
                <Setter TargetName="GlyphPanel" Property="BorderBrush" Value="{StaticResource Office2007Silver_MenuItem_OverBorderBrush}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter TargetName="grad" Property="Background" Value="{StaticResource Office2007Black_MenuItem_Brush}"/>
                <Setter TargetName="back" Property="BorderBrush" Value="{StaticResource Office2007Black_MenuItem_OverBorderBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource Office2007Black_MenuItem_SelectedBackgroundBrush}"/>
                <Setter TargetName="GlyphPanel" Property="BorderBrush" Value="{StaticResource Office2007Black_MenuItem_OverBorderBrush}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter TargetName="grad" Property="Background" Value="{StaticResource Office2007Blue_MenuItem_Brush}"/>
                <Setter TargetName="back" Property="BorderBrush" Value="{StaticResource Office2007Blue_MenuItem_OverBorderBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource Office2007Blue_MenuItem_SelectedBackgroundBrush}"/>
                <Setter TargetName="GlyphPanel" Property="BorderBrush" Value="{StaticResource Office2007Blue_MenuItem_OverBorderBrush}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter TargetName="grad" Property="Background" Value="{StaticResource ItemBackgroundBrushKey.ShinyRed}"/>
                <Setter TargetName="back" Property="BorderBrush" Value="{StaticResource MenuBorderBrushKey.ShinyRed}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource NormalBackgroundBrushKey.ShinyRed}"/>
                <Setter TargetName="GlyphPanel" Property="BorderBrush" Value="{StaticResource MenuBorderBrushKey.ShinyRed}"/>
            </Trigger>
            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter TargetName="grad" Property="Background" Value="{StaticResource ItemBackgroundBrushKey.ShinyBlue}"/>
                <Setter TargetName="back" Property="BorderBrush" Value="{StaticResource MenuBorderBrushKey.ShinyBlue}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
                <Setter TargetName="GlyphPanel" Property="BorderBrush" Value="{StaticResource MenuBorderBrushKey.ShinyBlue}"/>
            </Trigger>


            <Trigger Property="MenuItem.IsHighlighted" Value="True">
                <Setter TargetName="back" Property="Opacity" Value="1"/>
                <Setter TargetName="back" Property="Background"	Value="{StaticResource Office2007Blue_MenuItem_OverBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource Office2007Blue_MenuItem_SelectedOverBackgroundBrush}"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{StaticResource Office2007Blue_MenuText_SelectedBrush}"/>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
                <Setter Property="TextElement.Foreground" Value="{StaticResource Office2007Blue_MenuText_DisabledBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Visibility" Value="Hidden"/>
            </Trigger>

            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="True"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Blend"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="back" Property="Background"	Value="{StaticResource Blend_MenuItem_OverBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource Blend_MenuItem_SelectedOverBackgroundBrush}"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{StaticResource Blend_MenuText_SelectedBrush}"/>
            </MultiTrigger>

            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="True"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2003"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="back" Property="Background"	Value="{StaticResource Office2003_MenuItem_OverBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource Office2003_MenuItem_SelectedOverBackgroundBrush}"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{StaticResource Office2003_MenuText_SelectedBrush}"/>
            </MultiTrigger>
            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="True"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Blue"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="back" Property="Background"	Value="{StaticResource Office2007Blue_MenuItem_OverBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource Office2007Blue_MenuItem_SelectedOverBackgroundBrush}"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{StaticResource Office2007Blue_MenuText_SelectedBrush}"/>
            </MultiTrigger>

            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="True"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Silver"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="back" Property="Background"	Value="{StaticResource Office2007Silver_MenuItem_OverBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource Office2007Silver_MenuItem_SelectedOverBackgroundBrush}"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{StaticResource Office2007Silver_MenuText_SelectedBrush}"/>
            </MultiTrigger>
            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="True"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Black"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="back" Property="Background"	Value="{StaticResource Office2007Black_MenuItem_OverBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource Office2007Black_MenuItem_SelectedOverBackgroundBrush}"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{StaticResource Office2007Black_MenuText_SelectedBrush}"/>
            </MultiTrigger>
            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="True"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="SyncOrange"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="back" Property="Background"	Value="{StaticResource Office2007Blue_MenuItem_OverBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource Office2007Blue_MenuItem_SelectedOverBackgroundBrush}"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{StaticResource Office2007Blue_MenuText_SelectedBrush}"/>
            </MultiTrigger>
            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="True"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyRed"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="back" Property="Background"	Value="{StaticResource NormalBackgroundBrushKey.ShinyRed}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource MenuBorderBrushKey.ShinyRed}"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
            </MultiTrigger>
            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="True"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyBlue"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="back" Property="Background"	Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
                <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource MenuBorderBrushKey.ShinyBlue}"/>
                <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="{StaticResource TextBrushKey.ShinyBlue}"/>
            </MultiTrigger>



            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="False"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Blend"/>
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Blend_MenuText_DisabledBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Visibility" Value="Hidden"/>
            </MultiTrigger>
            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="False"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2003"/>
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Office2003_MenuText_DisabledBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Visibility" Value="Hidden"/>
            </MultiTrigger>
            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="False"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Blue"/>
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Office2007Blue_MenuText_DisabledBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Visibility" Value="Hidden"/>
            </MultiTrigger>
            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="False"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Silver"/>
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Office2007Silver_MenuText_DisabledBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Visibility" Value="Hidden"/>
            </MultiTrigger>
            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="False"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="Office2007Black"/>
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Office2007Black_MenuText_DisabledBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Visibility" Value="Hidden"/>
            </MultiTrigger>
            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="False"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="SyncOrange"/>
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Office2007Blue_MenuText_DisabledBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Visibility" Value="Hidden"/>
            </MultiTrigger>
            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="False"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyRed"/>
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Office2007Blue_MenuText_DisabledBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Visibility" Value="Hidden"/>
            </MultiTrigger>
            <MultiTrigger >
                <MultiTrigger.Conditions >
                    <Condition Property="MenuItem.IsHighlighted" Value="False"/>
                    <Condition Property="utilsOuter:SkinStorage.VisualStyle" Value="ShinyBlue"/>
                </MultiTrigger.Conditions>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Office2007Blue_MenuText_DisabledBrush}"/>
                <Setter TargetName="GlyphPanel" Property="Visibility" Value="Hidden"/>
            </MultiTrigger>



            <Trigger Property="utilsOuter:SkinStorage.VisualStyle" Value="Blend">
                <Setter TargetName="GlyphPanel" Property="Background" Value="Transparent"/>
                <Setter TargetName="GlyphPanel" Property="BorderBrush" Value="Transparent"/>
                <Setter TargetName="Glyph" Property="Stroke" Value="White"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>



    <ControlTemplate x:Key="MenuItemKeyTemplate.ShinyRed" TargetType="{x:Type MenuItem}">
        <ControlTemplate.Resources>
            <Storyboard x:Key="HighlightedOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="HighlightedOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ControlTemplate.Resources>
        <Border x:Name="Border" Background="White"   BorderBrush="{StaticResource PopupBorderBrushKey.ShinyRed}"  BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="17" Width="Auto" SharedSizeGroup="MenuItemIconColumnGroup"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup"/>
                    <ColumnDefinition Width="14"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Grid.ColumnSpan="4" Background="{StaticResource NormalBackgroundBrushKey.ShinyRed}" Opacity="0" x:Name="border"/>

                <ContentPresenter Margin="4,0,6,0" x:Name="Icon" VerticalAlignment="Center" ContentSource="Icon"/>

                <Grid Visibility="Hidden" Margin="4,0,6,0" x:Name="GlyphPanel" VerticalAlignment="Center">
                    <Path x:Name="GlyphPanelpath" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Data="M0,2 L0,4.8 L2.5,7.4 L7.1,2.8 L7.1,0 L2.5,4.6 z" FlowDirection="LeftToRight"/>
                </Grid>

                <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" x:Name="HeaderHost" RecognizesAccessKey="True" ContentSource="Header"/>

                <Grid Grid.Column="3" Margin="4,0,6,0" x:Name="ArrowPanel" VerticalAlignment="Center">
                    <Path x:Name="ArrowPanelPath" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Data="M0,0 L0,8 L4,4 z"/>
                </Grid>

                <Popup IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" x:Name="SubMenuPopup" Focusable="false" AllowsTransparency="true" PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}" VerticalOffset="-3">
                    <Grid x:Name="SubMenu">
                        <Border x:Name="SubMenuBorder" Background="White"  BorderBrush="{StaticResource PopupBorderBrushKey.ShinyRed}" BorderThickness="1"/>

                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Grid>
                </Popup>

            </Grid>
        </Border>

        <ControlTemplate.Triggers>

            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Margin" Value="0,1,0,1"/>
                <Setter Property="Padding" Value="6,3,6,3"/>
                <Setter Property="Grid.IsSharedSizeScope" Value="true"/>
                <Setter Property="Placement" Value="Bottom" TargetName="SubMenuPopup"/>
                <Setter Property="Visibility" Value="Collapsed" TargetName="ArrowPanel"/>
            </Trigger>

            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Margin" Value="0,1,0,1"/>
                <Setter Property="Padding" Value="6,3,6,3"/>
                <Setter Property="Visibility" Value="Collapsed" TargetName="ArrowPanel"/>
            </Trigger>

            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="DockPanel.Dock" Value="Top"/>
                <Setter Property="Padding" Value="0,2,0,2"/>
                <Setter Property="Grid.IsSharedSizeScope" Value="true"/>
            </Trigger>

            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="DockPanel.Dock" Value="Top"/>
                <Setter Property="Padding" Value="0,2,0,2"/>
                <Setter Property="Visibility" Value="Collapsed" TargetName="ArrowPanel"/>
            </Trigger>
            <Trigger Property="IsSuspendingPopupAnimation" Value="true">
                <Setter Property="PopupAnimation" Value="None" TargetName="SubMenuPopup"/>
            </Trigger>

            <Trigger Property="Icon" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon"/>
            </Trigger>

            <Trigger Property="IsChecked" Value="true">
                <Setter Property="Visibility" Value="Visible" TargetName="GlyphPanel"/>
                <Setter Property="Visibility" Value="Collapsed" TargetName="Icon"/>
            </Trigger>

            <Trigger Property="AllowsTransparency" SourceName="SubMenuPopup" Value="true">
                <Setter Property="Margin" Value="0,0,3,3" TargetName="SubMenu"/>
                <Setter Property="SnapsToDevicePixels" Value="true" TargetName="SubMenu"/>
                <Setter Property="BitmapEffect" Value="{StaticResource PopupDropShadow}" TargetName="SubMenuBorder"/>
            </Trigger>

            <Trigger Property="IsHighlighted" Value="true">
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource HighlightedOff}" x:Name="HighlightedOff_BeginStoryboard"/>
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource HighlightedOn}"/>
                </Trigger.EnterActions>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

