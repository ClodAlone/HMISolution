                                Background="{StaticResource background}"
                                CornerRadius="5,5,0,0">
        </Border>      
    </ControlTemplate>


    <local:CloseButtonTypeToVisibilityConverter x:Key="CloseButtonTypeToVisibilityConverter"/>
    <shared:BooleanToVisibilityConverterEx x:Key="BooleanToVisibilityConverterEx"/>
   
    <ControlTemplate x:Key="OrangeCloseButtonTemplate" TargetType="{x:Type ButtonBase}">
        <Border x:Name="brdBack" Height="14" Width="14" BorderThickness="1" >
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment= "Center">
                <ContentPresenter.Content>
                    <Border Name="bd" Height="8"  Width="8" HorizontalAlignment="Center" VerticalAlignment= "Center" 
                Background="{StaticResource CloseButtonBackground.Orange}"/>
                </ContentPresenter.Content>
            </ContentPresenter>
        </Border>
        <ControlTemplate.Triggers>            
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource ButtonHoverBrush.Orange}"/>
                <Setter TargetName="brdBack" Property="BorderBrush" Value="{StaticResource ButtonBorderBrush.Orange}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource ButtonPressedBrush.Orange}"/>
