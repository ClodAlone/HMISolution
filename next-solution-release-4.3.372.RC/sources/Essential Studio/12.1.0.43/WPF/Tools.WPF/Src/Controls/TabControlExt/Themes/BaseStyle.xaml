    <Style x:Key="BaseTabItemExt" TargetType="{x:Type local:TabItemExt}">
        <Setter Property="TextElement.Foreground"  Value="{StaticResource Aero.InactiveForeground}"/>
        <Setter Property="FrameworkElement.FocusVisualStyle">
            <Setter.Value>
                <Style TargetType="IFrameworkInputElement">
                    <Setter Property="Control.Template">
                        <Setter.Value>                          
                            <x:Null/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Margin" Value="-8,0,0,0"/>
        <Setter Property="Background" Value="{StaticResource Aero.TabBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Aero.TabBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Control.HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template" Value="{StaticResource VS2008TabItemTemplate}"/>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="TextElement.Foreground" Value="{StaticResource Office2007.Blue.InactiveForeground}"/>
                <Setter Property="Margin" Value="1,0,1,0"/>
                <Setter Property="Background" Value="{StaticResource BackgroundBrushes.Office2007}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BackgroundBrushes.Office2007}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template" Value="{StaticResource Office2007BlueTabItemTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="TextElement.Foreground" Value="{StaticResource Office2007.Black.InactiveForeground}"/>
