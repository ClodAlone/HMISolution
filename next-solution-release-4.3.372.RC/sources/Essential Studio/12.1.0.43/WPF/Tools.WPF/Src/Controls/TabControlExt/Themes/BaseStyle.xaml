                <Setter Property="BorderBrush" Value="{StaticResource TabItemBorderBrushKey.ShinyRed}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Template" Value="{StaticResource ShinyRed.TabItemTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrushKey.ShinyBlue}"/>
                <Setter Property="Margin" Value="1,0,1,0"/>
