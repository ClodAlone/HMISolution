                <Setter Property="BorderBrush" Value="{StaticResource Blend.TabItemBorderBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template" Value="{StaticResource BlendTabItemTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="TextElement.Foreground" Value="{StaticResource TabInActiveForeground.Orange}"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="{StaticResource TabItemBackground.Orange}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TabItemHoverBorderBrush.Orange}"/>
                <Setter Property="BorderThickness" Value="2,2,2,0"/>
                <Setter Property="Template" Value="{StaticResource OrangeTabItemTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
                <Setter Property="Margin" Value="1,0,1,0"/>
