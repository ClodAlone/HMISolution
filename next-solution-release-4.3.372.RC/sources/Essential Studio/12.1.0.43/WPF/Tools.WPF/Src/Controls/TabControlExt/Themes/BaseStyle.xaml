                <Setter Property="BorderBrush" Value="{StaticResource Office2003.TabBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1,1,1,0"/>
                <Setter Property="Template" Value="{StaticResource GenericTabItemTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="TextElement.Foreground" Value="{StaticResource Blend.InactiveForeground}"/>
                <Setter Property="Margin" Value="1,0,1,0"/>
