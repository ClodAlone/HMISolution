                    <Condition Binding="{Binding Path=(shared:SkinStorage.VisualStyle), RelativeSource={RelativeSource Self}}" Value="SyncOrange" />
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Margin" Value="0"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                    <Condition Binding="{Binding Path=(shared:SkinStorage.VisualStyle), RelativeSource={RelativeSource Self}}" Value="ShinyRed" />
                    <Condition Binding="{Binding Path=RotateTextWhenVertical,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TabControlExt}}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Margin" Value="1,0,1,0"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
