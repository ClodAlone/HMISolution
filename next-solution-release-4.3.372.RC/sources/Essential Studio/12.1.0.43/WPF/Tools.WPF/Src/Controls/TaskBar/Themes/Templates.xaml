                <Setter Property="BorderBrush" Value="{StaticResource Office2003.BorderBrush}"/>
                <Setter Property="HeaderBackground" Value="{StaticResource Office2003.HeaderBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2003.HeaderForeground}"/>
