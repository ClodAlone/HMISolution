        <Setter Property="BorderBrush" Value="{StaticResource Aero.BorderBrush}"/>
        <Setter Property="HeaderBackground" Value="{StaticResource Aero.HeaderBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Aero.HeaderForeground}"/>
