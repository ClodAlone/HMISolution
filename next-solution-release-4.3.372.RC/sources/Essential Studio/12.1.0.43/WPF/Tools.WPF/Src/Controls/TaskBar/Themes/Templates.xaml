    <!--Vista Style ToggleButton Template-->
    <ControlTemplate x:Key="VistaToggleButtonTemplate"  TargetType="{x:Type ToggleButton}">
        <local:CheckableBorder Name="CheckBorder" MinHeight="24" Margin="3" Background="{Binding Path=HeaderBackground, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}" BorderThickness="1" CornerRadius="2">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="2" Name="bord" Margin="0,2,3,2" ClipToBounds="True"
                            Width="{Binding Path=(local:TaskBar.ButtonSize), RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}" 
							Height="{Binding Path=(local:TaskBar.ButtonSize), RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}"  							
                            CornerRadius="8" 
							BorderThickness="0" Background="Transparent" >

                    <Border Margin="0" Name="LittelButton" RenderTransformOrigin="0.5, 0.5" >
                        <Border.RenderTransform>
                            <RotateTransform Angle="180"/>
                        </Border.RenderTransform>
                        <Border.Background>
                            <ImageBrush x:Name="ToggleImage" ImageSource="pack://application:,,,/Syncfusion.Tools.WPF;component/Controls/TaskBar/Resources/normal.png" Stretch="Fill">

                            </ImageBrush>
                        </Border.Background>

                    </Border>

                </Border>
                <Border Height="1" Grid.Column="1" Margin="3,1,5,1" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Stretch" ClipToBounds="True">
                    <Border.Background>
                        <DrawingBrush Stretch="Fill">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Pen>
                                        <Pen Thickness="1" Brush="#FFA8BEE0" LineJoin="Miter" />
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <PathGeometry>
                                            <PathGeometry.Figures>
                                                <PathFigureCollection>
                                                    <PathFigure StartPoint="0,0"  IsClosed="True">
                                                        <PathFigure.Segments>
                                                            <PathSegmentCollection >
                                                                <LineSegment Point="0,100" />

                                                            </PathSegmentCollection>
                                                        </PathFigure.Segments>
                                                    </PathFigure>
                                                </PathFigureCollection>
                                            </PathGeometry.Figures>
                                        </PathGeometry>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Border.Background>
                </Border>
                <ContentPresenter Grid.Column="0" Name="ContentSite"  Margin="7,2,7,2" HorizontalAlignment="Left" VerticalAlignment="Center" 
								  ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" RecognizesAccessKey="True" 
								  Content="{TemplateBinding ContentControl.Content}"   
				/>
            </Grid>
            <Border.Triggers>
                <EventTrigger RoutedEvent="local:CheckableBorder.Checked">
                    <EventTrigger.Actions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="LittelButton"
									Storyboard.TargetProperty="(Border.RenderTransform).(RotateTransform.Angle)">
                                    <DoubleAnimation.Duration>
                                        <MultiBinding Converter="{StaticResource SpeedToDurationConverter}" ConverterParameter="Expanded">
                                            <Binding Path="(local:TaskBar.Speed)" RelativeSource="{RelativeSource AncestorType={x:Type local:TaskBarItem}}"/>
                                            <Binding Path="DesiredSize.Height" ElementName="ItemsPresenter" />
                                            <Binding Path="SafeHeight" ElementName="PanelPresenter" />
                                        </MultiBinding>
                                    </DoubleAnimation.Duration>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger.Actions>
                </EventTrigger>
                <EventTrigger RoutedEvent="local:CheckableBorder.Unchecked">
                    <EventTrigger.Actions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="LittelButton"
									Storyboard.TargetProperty="(Border.RenderTransform).(RotateTransform.Angle)" To="0">
                                    <DoubleAnimation.Duration>
                                        <MultiBinding Converter="{StaticResource SpeedToDurationConverter}" ConverterParameter="Collapsed">
                                            <Binding Path="(local:TaskBar.Speed)" RelativeSource="{RelativeSource AncestorType={x:Type local:TaskBarItem}}"/>
                                            <Binding Path="SafeHeight" ElementName="PanelPresenter" />
                                        </MultiBinding>
                                    </DoubleAnimation.Duration>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger.Actions>
                </EventTrigger>
            </Border.Triggers>
        </local:CheckableBorder>
        <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation  Storyboard.TargetName="bord" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="bord" Storyboard.TargetProperty="Opacity" Duration="0:0:.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter Property="BorderThickness" TargetName="CheckBorder" Value="1"/>
                <Setter Property="BorderBrush" TargetName="CheckBorder" Value="#FFD4ECF6"/>
                <Setter Property="Background" TargetName="CheckBorder" Value="{StaticResource MouseOverToggle.Aero}"/>                
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="UIElement.IsMouseOver" Value="True" />
                    <Condition Property="local:ToggleButtonExt.IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation  Storyboard.TargetName="bord" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="bord" Storyboard.TargetProperty="Opacity" Duration="0:0:.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
                <Setter Property="BorderThickness" TargetName="CheckBorder" Value="1"/>
                <Setter Property="BorderBrush" TargetName="CheckBorder" Value="#FFD4ECF6"/>
                <Setter Property="Background" TargetName="CheckBorder" Value="{StaticResource MouseOverToggle.Aero}"/>
               
            </MultiTrigger>

            <Trigger Property="IsMouseOver" SourceName="LittelButton" Value="True">
                <Setter Property="BorderBrush" TargetName="bord" Value="{StaticResource MouseOverToggleBorder.Aero}"/>
                <Setter Property="BorderThickness" TargetName="bord" Value="1"/>
                <Setter Property="Margin" TargetName="bord" Value="-0.5,2,3,2"/>
                <Setter Property="Background" TargetName="bord" Value="{StaticResource MouseOverToggle.Aero}"/>               
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" SourceName="LittelButton" Value="True" />
                    <Condition Property="local:ToggleButtonExt.IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" TargetName="bord" Value="{StaticResource MouseOverToggleBorder.Aero}"/>
                <Setter Property="BorderThickness" TargetName="bord" Value="1"/>
                <Setter Property="Margin" TargetName="bord" Value="0,2,3,2"/>
                <Setter Property="Background" TargetName="bord" Value="{StaticResource MouseOverToggle.Aero}"/>               
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--ToggleButton Style-->
    <Style x:Key="{x:Type local:ToggleButtonExt}" TargetType="{x:Type local:ToggleButtonExt}">
        <Setter Property="Control.Template" Value="{StaticResource VistaToggleButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="Control.Template" Value="{StaticResource ToggleButtonTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Control.Template" Value="{StaticResource ToggleButtonTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Control.Template" Value="{StaticResource ToggleButtonTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Control.Template" Value="{StaticResource ToggleButtonTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Control.Template" Value="{StaticResource BlendExpanderDownHeaderStyle}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="Control.Template" Value="{StaticResource OrangeToggleButtonTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Control.Template" Value="{StaticResource ToggleButtonTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Control.Template" Value="{StaticResource ToggleButtonTemplate.ShinyBlue}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

 
    <!--Vista ExpanderExt Template -->
    <ControlTemplate x:Key="VistaExpanderExtTemplate" TargetType="{x:Type Expander}">
        <Border Name="GeneralBorder" BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}"
				BorderThickness="{TemplateBinding Border.BorderThickness}" 
				Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}"
				SnapsToDevicePixels="True" Padding="{TemplateBinding Control.Padding}">
            <DockPanel>
                <local:ToggleButtonExt Name="HeaderSite"  MinWidth="0" Margin="0"		   					  
							  HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" 
							  FontStretch="{TemplateBinding TextElement.FontStretch}" 
							  VerticalContentAlignment="{TemplateBinding Control.VerticalContentAlignment}" 
							  TextElement.Foreground="{TemplateBinding Foreground}"
							  FontFamily="{TemplateBinding TextElement.FontFamily}"  
							  FontStyle="{TemplateBinding TextElement.FontStyle}" 
							  FontSize="{TemplateBinding TextElement.FontSize}" MinHeight="0" 
							  ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}" 
							  Padding="{TemplateBinding Control.Padding}" 
							  Content="{TemplateBinding HeaderedContentControl.Header}" DockPanel.Dock="Top" 
							  Style="{Binding Path=(local:TaskBar.HeaderStyle), RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}">
                    <ToggleButton.IsChecked>
                        <Binding Mode="TwoWay" Path="IsExpanded" RelativeSource="{RelativeSource TemplatedParent}" 
								 NotifyOnSourceUpdated="False" BindsDirectlyToSource="False" IsAsync="False" 
								 NotifyOnValidationError="False" NotifyOnTargetUpdated="False"/>
                    </ToggleButton.IsChecked>
                </local:ToggleButtonExt>
                <ContentPresenter Name="ExpandSite" Margin="10,2,2,2"
								  HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" 
								  VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" 
								  Focusable="False" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
								  Content="{TemplateBinding ContentControl.Content}" DockPanel.Dock="Bottom" 
				/>
            </DockPanel>
        </Border>
    </ControlTemplate>

    <!--Blend ExpanderExt Template -->
    <ControlTemplate TargetType="{x:Type Expander}" x:Key="BlendExpanderTemplate">
        <Border Name="GeneralBorder" BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}"
				BorderThickness="{TemplateBinding Border.BorderThickness}" 
				Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}" CornerRadius="3"
				SnapsToDevicePixels="True" Padding="{TemplateBinding Control.Padding}">
            <DockPanel>
                <local:ToggleButtonExt x:Name="HeaderSite1"
                              MinWidth="0" Margin="0"
		   					  FontWeight="{TemplateBinding TextElement.FontWeight}" 
							  HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" 
							  FontStretch="{TemplateBinding TextElement.FontStretch}" 
							  VerticalContentAlignment="{TemplateBinding Control.VerticalContentAlignment}" 
                                       Foreground="{TemplateBinding TextElement.Foreground}"
							  FontFamily="{TemplateBinding TextElement.FontFamily}"  
							  FontStyle="{TemplateBinding TextElement.FontStyle}" 
							  FontSize="{TemplateBinding TextElement.FontSize}" MinHeight="0" 
							  ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}" 
							  Padding="{TemplateBinding Control.Padding}" 
							  Content="{TemplateBinding HeaderedContentControl.Header}" DockPanel.Dock="Top"
							 
                TextElement.Foreground="{TemplateBinding Foreground}"
							  Style="{Binding Path=(local:TaskBar.HeaderStyle), RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}"
                                         >
                    <ToggleButton.IsChecked>
                        <Binding Mode="TwoWay" Path="IsExpanded" RelativeSource="{RelativeSource TemplatedParent}" 
								 NotifyOnSourceUpdated="False" BindsDirectlyToSource="False" IsAsync="False" 
								 NotifyOnValidationError="False" NotifyOnTargetUpdated="False"/>
                    </ToggleButton.IsChecked>
                </local:ToggleButtonExt>
                <ContentPresenter x:Name="ExpandSite"
                                             Margin="{TemplateBinding Control.Padding}"
								  HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
								  VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" 
								  Focusable="False" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
								  Content="{TemplateBinding ContentControl.Content}" DockPanel.Dock="Bottom" />
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded"
                                 Value="true">
                <Setter Property="Visibility"
                                    Value="Visible"
                                    TargetName="ExpandSite"/>
            </Trigger>
            <Trigger Property="IsEnabled"
                                 Value="false">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <ControlTemplate x:Key="ExpanderExtTemplate" TargetType="{x:Type Expander}">
        <Border Name="GeneralBorder" BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}"
				BorderThickness="{TemplateBinding Border.BorderThickness}" 
				Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}"
				SnapsToDevicePixels="True" Padding="{TemplateBinding Control.Padding}">
            <DockPanel>
                <local:ToggleButtonExt  Name="HeaderSite"  MinWidth="0" Margin="0"
		   					  FontWeight="{TemplateBinding TextElement.FontWeight}" 
							  HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" 
							  FontStretch="{TemplateBinding TextElement.FontStretch}" 
							  VerticalContentAlignment="{TemplateBinding Control.VerticalContentAlignment}" 
							  FontFamily="{TemplateBinding TextElement.FontFamily}"  
							  FontStyle="{TemplateBinding TextElement.FontStyle}" 
							  FontSize="{TemplateBinding TextElement.FontSize}" MinHeight="0" 
							  ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}" 
							  Padding="{TemplateBinding Control.Padding}" 
							  Content="{TemplateBinding HeaderedContentControl.Header}" DockPanel.Dock="Top"
							  Style="{Binding Path=(local:TaskBar.HeaderStyle), RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}"
                TextElement.Foreground="{TemplateBinding Foreground}"
					>
                    <ToggleButton.IsChecked>
                        <Binding Mode="TwoWay" Path="IsExpanded" RelativeSource="{RelativeSource TemplatedParent}" 
								 NotifyOnSourceUpdated="False" BindsDirectlyToSource="False" IsAsync="False" 
								 NotifyOnValidationError="False" NotifyOnTargetUpdated="False"/>
                    </ToggleButton.IsChecked>
                </local:ToggleButtonExt>
                <ContentPresenter Name="ExpandSite" Margin="{TemplateBinding Control.Padding}"
								  HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
								  VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" 
								  Focusable="False" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
								  Content="{TemplateBinding ContentControl.Content}" DockPanel.Dock="Bottom" 
				/>
            </DockPanel>
        </Border>
    </ControlTemplate>

    <!-- Orange Expander Template-->

    <ControlTemplate TargetType="{x:Type Expander}" x:Key="OrangeExpanderExtTemplate">
        <Border Name="GeneralBorder" BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}"
				BorderThickness="{TemplateBinding Border.BorderThickness}" 
				Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}" CornerRadius="20,0,20,20"
				SnapsToDevicePixels="True" Padding="{TemplateBinding Control.Padding}">
            <DockPanel>
                <local:ToggleButtonExt x:Name="HeaderSite1"
                              MinWidth="0" Margin="0"
		   					  FontWeight="{TemplateBinding TextElement.FontWeight}" 
							  HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" 
							  FontStretch="{TemplateBinding TextElement.FontStretch}" 
							  VerticalContentAlignment="{TemplateBinding Control.VerticalContentAlignment}" 
							  FontFamily="{TemplateBinding TextElement.FontFamily}"  
							  FontStyle="{TemplateBinding TextElement.FontStyle}" 
							  FontSize="{TemplateBinding TextElement.FontSize}" MinHeight="0" 
							  ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}" 
							  Padding="{TemplateBinding Control.Padding}" 
                                        Foreground="{TemplateBinding TextElement.Foreground}"
							  Content="{TemplateBinding HeaderedContentControl.Header}" DockPanel.Dock="Top"
							
                TextElement.Foreground="{StaticResource HeaderForeground.Orange}"
							  Style="{Binding Path=(local:TaskBar.HeaderStyle), RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}">
                    <ToggleButton.IsChecked>
                        <Binding Mode="TwoWay" Path="IsExpanded" RelativeSource="{RelativeSource TemplatedParent}" 
								 NotifyOnSourceUpdated="False" BindsDirectlyToSource="False" IsAsync="False" 
								 NotifyOnValidationError="False" NotifyOnTargetUpdated="False"/>
                    </ToggleButton.IsChecked>
                </local:ToggleButtonExt>
                <ContentPresenter x:Name="ExpandSite" TextBlock.Foreground="{StaticResource ForegroundBrush.Orange}"
                                             Margin="10,0,10,0"
								  HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
								  VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" 
								  Focusable="False" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
								  Content="{TemplateBinding ContentControl.Content}" DockPanel.Dock="Bottom" />
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded"
                                 Value="true">
                <Setter Property="Visibility"
                                    Value="Visible"
                                    TargetName="ExpandSite"/>
            </Trigger>
            <Trigger Property="IsEnabled"
                                 Value="false">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- TaskBar Template -->
    <ControlTemplate x:Key="TaskBarTemplate" TargetType="{x:Type local:TaskBar}" >
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding Border.CornerRadius}" TextBlock.Foreground="{TemplateBinding Foreground}"  BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
            <ItemsPresenter Name="TaskBarPresent"/>
        </Border>
    </ControlTemplate>

    <!-- ExpanderExt Style -->
    <Style x:Key="{x:Type local:ExpanderExt}" TargetType="{x:Type local:ExpanderExt}">
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="Control.Height" Value="{Binding Path=Height, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}"/>
        <Setter Property="Control.Width" Value="{Binding Path=Width, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}"/>
        <Setter Property="Control.HorizontalContentAlignment" Value="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}"/>
        <Setter Property="Control.VerticalContentAlignment" Value="{x:Static VerticalAlignment.Center}"/>
        <Setter Property="Border.BorderBrush" Value="{StaticResource Aero.BorderBrush}"/>
        <Setter Property="Border.BorderThickness" Value="{Binding Path=BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}"/>
        <Setter Property="Background" Value="{StaticResource Aero.ContentBackground}"/>     
        <Setter Property="Control.Template" Value="{StaticResource VistaExpanderExtTemplate}"/>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="Border.BorderBrush" Value="{StaticResource Office2007Blue.BorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Office2007Blue.ContentBackground}"/>
                <Setter Property="Control.Template" Value="{StaticResource BlendExpanderTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Border.BorderBrush" Value="{StaticResource Office2007Black.BorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Office2007Black.ContentBackground}"/>
                <Setter Property="Control.Template" Value="{StaticResource BlendExpanderTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Border.BorderBrush" Value="{StaticResource Office2007Silver.BorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Office2007Silver.ContentBackground}"/>
                <Setter Property="Control.Template" Value="{StaticResource BlendExpanderTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Border.BorderBrush" Value="{StaticResource Office2003.BorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Office2003.ContentBackground}"/>
                <Setter Property="Control.Template" Value="{StaticResource BlendExpanderTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="Border.BorderBrush" Value="{StaticResource HeaderBorderBrush.Orange}"/>
                <Setter Property="Background" Value="{StaticResource ContentBackground.Orange}"/>
                <Setter Property="Control.Template" Value="{StaticResource OrangeExpanderExtTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Border.BorderBrush" Value="{StaticResource ButtonBorderBrushKey.ShinyRed}"/>
                <Setter Property="Background" Value="{StaticResource TaskBarHeaderBrushKey.ShinyRed}"/>
                <Setter Property="Control.Template" Value="{StaticResource ExpanderExtTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Border.BorderBrush" Value="{StaticResource ButtonBorderBrushKey.ShinyRed}"/>
                <Setter Property="Background" Value="{StaticResource TaskBarHeaderBrushKey.ShinyRed}"/>
                <Setter Property="Control.Template" Value="{StaticResource ExpanderExtTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Border.BorderBrush" Value="{StaticResource Blend.BorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Blend.ContentBackground}"/>
                <Setter	Property="Control.Template" Value="{StaticResource BlendExpanderTemplate}" />
            </Trigger>            
        </Style.Triggers>
    </Style>

    <!-- ItemsPresenter Style -->
    <Style x:Key="{x:Type local:ItemsPresenterExt}" TargetType="{x:Type local:ItemsPresenterExt}">
        <Style.Triggers>
            <Trigger Property="Opacity" Value="0">
                <Setter Property="UIElement.Visibility" Value="Hidden"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TaskBarItem Template -->
    <ControlTemplate x:Key="TaskBarItemTemplate" TargetType="{x:Type local:TaskBarItem}">
        <StackPanel Name="StackName">
            <local:ExpanderExt Name="ExpandTemplate" 
							  IsExpanded="{Binding Path=(local:TaskBar.IsOpened), RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}" 
							  Focusable="False" Header="{TemplateBinding Header}" ClipToBounds="True" ExpandDirection="Down" 
				>
                <ScrollViewer  VerticalScrollBarVisibility="Auto">
                <local:TaskBarStackPanel  Name="PanelPresenter" ClipToBounds="True">
                    <StackPanel Name="SimplePanel">
                        <StackPanel.RenderTransform>
                            <TranslateTransform />
                        </StackPanel.RenderTransform>
                        <local:ItemsPresenterExt Name="ItemsPresenter" VerticalAlignment="Bottom"  
										Margin="{Binding Path=(local:TaskBar.GroupPadding), RelativeSource={RelativeSource AncestorType={x:Type local:TaskBarItem}}}"
						/>
                    </StackPanel>
                </local:TaskBarStackPanel>
                </ScrollViewer>
                <Expander.Triggers>
                    <EventTrigger RoutedEvent="Expander.Expanded">
                        <EventTrigger.Actions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ItemsPresenter" Storyboard.TargetProperty="Opacity"  To="1"
													AccelerationRatio="0.8" DecelerationRatio="0.2" >
                                        <DoubleAnimation.Duration>
                                            <MultiBinding Converter="{StaticResource SpeedToDurationConverter}" ConverterParameter="Expanded">
                                                <Binding Path="(local:TaskBar.Speed)" RelativeSource="{RelativeSource AncestorType={x:Type local:TaskBarItem}}"/>
                                                <Binding Path="DesiredSize.Height" ElementName="ItemsPresenter" />
                                                <Binding Path= "SafeHeight" ElementName="PanelPresenter" />
                                            </MultiBinding>
                                        </DoubleAnimation.Duration>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="PanelPresenter" Storyboard.TargetProperty="(SafeHeight)" >
                                        <DoubleAnimation.Duration>
                                            <MultiBinding Converter="{StaticResource SpeedToDurationConverter}" ConverterParameter="Expanded">
                                                <Binding Path="(local:TaskBar.Speed)" RelativeSource="{RelativeSource AncestorType={x:Type local:TaskBarItem}}"/>
                                                <Binding Path="DesiredSize.Height" ElementName="ItemsPresenter" />
                                                <Binding Path="SafeHeight" ElementName="PanelPresenter" />
                                            </MultiBinding>
                                        </DoubleAnimation.Duration>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="SimplePanel" Storyboard.TargetProperty="(StackPanel.RenderTransform).(TranslateTransform.Y)" 
												To="0">
                                        <DoubleAnimation.Duration>
                                            <MultiBinding Converter="{StaticResource SpeedToDurationConverter}" ConverterParameter="Expanded">
                                                <Binding Path="(local:TaskBar.Speed)" RelativeSource="{RelativeSource AncestorType={x:Type local:TaskBarItem}}"/>
                                                <Binding Path="DesiredSize.Height" ElementName="ItemsPresenter" />
                                                <Binding Path="SafeHeight" ElementName="PanelPresenter" />
                                            </MultiBinding>
                                        </DoubleAnimation.Duration>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger.Actions>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Expander.Collapsed">
                        <EventTrigger.Actions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ItemsPresenter" Storyboard.TargetProperty="Opacity"  To="0" 
												AccelerationRatio="0.8" DecelerationRatio="0.2">
                                        <DoubleAnimation.Duration>
                                            <MultiBinding Converter="{StaticResource SpeedToDurationConverter}" ConverterParameter="Collapsed">
                                                <Binding Path="(local:TaskBar.Speed)" RelativeSource="{RelativeSource AncestorType={x:Type local:TaskBarItem}}"/>
                                                <Binding Path="SafeHeight" ElementName="PanelPresenter" />
                                            </MultiBinding>
                                        </DoubleAnimation.Duration>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="PanelPresenter" Storyboard.TargetProperty="(SafeHeight)" To="0">
                                        <DoubleAnimation.Duration>
                                            <MultiBinding Converter="{StaticResource SpeedToDurationConverter}" ConverterParameter="Collapsed">
                                                <Binding Path="(local:TaskBar.Speed)" RelativeSource="{RelativeSource AncestorType={x:Type local:TaskBarItem}}"/>
                                                <Binding Path="SafeHeight" ElementName="PanelPresenter" />
                                            </MultiBinding>
                                        </DoubleAnimation.Duration>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="SimplePanel" 
														 Storyboard.TargetProperty="(StackPanel.RenderTransform).(TranslateTransform.Y)" >
                                        <DoubleAnimation.To>
                                            <MultiBinding Converter="{StaticResource DoubleToNegativeDoubleConverter}">
                                                <Binding Path="DesiredSize.Height" ElementName="ItemsPresenter" />
                                                <Binding Path="(local:TaskBar.GroupPadding)" RelativeSource="{RelativeSource AncestorType={x:Type local:TaskBarItem}}" />
                                            </MultiBinding>
                                        </DoubleAnimation.To>
                                        <DoubleAnimation.Duration>
                                            <MultiBinding Converter="{StaticResource SpeedToDurationConverter}" ConverterParameter="Collapsed">
                                                <Binding Path="(local:TaskBar.Speed)" RelativeSource="{RelativeSource AncestorType={x:Type local:TaskBarItem}}"/>
                                                <Binding Path="SafeHeight" ElementName="PanelPresenter" />
                                            </MultiBinding>
                                        </DoubleAnimation.Duration>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger.Actions>
                    </EventTrigger>
                </Expander.Triggers>
            </local:ExpanderExt>
        </StackPanel>
        
    </ControlTemplate>

    <!-- TaskBar Style -->
    <Style x:Key="TaskBarStyle" TargetType="{x:Type local:TaskBar}">
        <Setter Property="TextBlock.Foreground" Value="{StaticResource Aero.HeaderForeground}"/>
        <Setter Property="Foreground" Value="{StaticResource Aero.HeaderForeground}"/>
        <Setter Property="Template" Value="{StaticResource TaskBarTemplate}" />
        <Setter Property="Background" Value="{StaticResource TaskBar.Background.Default}"/>     
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Border.CornerRadius" Value="0"/>
        <Setter Property="ButtonSize" Value="14"/>
        <Style.Triggers>
            <Trigger Property="local:TaskBar.GroupOrientation" Value="Horizontal">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Background" Value="{StaticResource TaskBar.Background.Default}"/>
                <Setter Property="Foreground" Value="{StaticResource Blend.HeaderForeground}"/>
                <Setter	Property="TextBlock.Foreground" Value="{StaticResource Blend.HeaderForeground}"/>
                <Setter Property="Border.CornerRadius" Value="0"/>

            </Trigger>           
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Background" Value="{StaticResource TaskBar.Background.Default}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2003.HeaderForeground}"/>
                <Setter	Property="TextBlock.Foreground" Value="{StaticResource Office2003.HeaderForeground}"/>
                <Setter Property="Border.CornerRadius" Value="0"/>

            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="Background" Value="{StaticResource TaskBar.Background.Default}"/>
                <Setter Property="Foreground"  Value="{StaticResource Office2007Blue.HeaderForeground}"/>
                <Setter	Property="TextBlock.Foreground"  Value="{StaticResource Office2007Blue.HeaderForeground}"/>
                <Setter Property="Border.CornerRadius" Value="0"/>

            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Background" Value="{StaticResource TaskBar.Background.Default}"/>
                <Setter Property="Foreground" Value="{StaticResource Office2007Black.HeaderForeground}"/>
                <Setter	Property="TextBlock.Foreground" Value="{StaticResource Office2007Black.HeaderForeground}"/>
                <Setter Property="Border.CornerRadius" Value="0"/>

            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Background" Value="{StaticResource TaskBar.Background.Default}"/>
                <Setter Property="TextBlock.Foreground" Value="{StaticResource Office2007Silver.HeaderForeground}"/>
                <Setter	Property="Foreground" Value="{StaticResource Office2007Silver.HeaderForeground}"/>
                <Setter Property="Border.CornerRadius" Value="0"/>

            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="Foreground" Value="{StaticResource HeaderForeground.Orange}"/>
                <Setter Property="Background" Value="{StaticResource Background.Orange}"/>
                <Setter Property="TextBlock.Foreground" Value="{StaticResource HeaderForeground.Orange}"/>
                <Setter Property="Border.CornerRadius" Value="20,0,20,20"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
                <Setter Property="Background" Value="{StaticResource TaskBarBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="TextBlock.Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
                <Setter Property="Border.CornerRadius" Value="2"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
                <Setter Property="Background" Value="{StaticResource TaskBarBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="TextBlock.Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
                <Setter Property="Border.CornerRadius" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TaskBarItem Style -->
