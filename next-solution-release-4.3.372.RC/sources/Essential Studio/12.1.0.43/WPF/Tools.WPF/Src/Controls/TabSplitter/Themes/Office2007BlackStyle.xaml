    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2007BlackTabSplitterItemSelectedBorderBrush" Color="#A3A3A3"/>
   
   
    <LinearGradientBrush x:Key="Office2007BlackSplitterButtonHoverBackgroundBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFF9D1" Offset="1" />
            <GradientStop Color="#FFFFEAA3" Offset="0.65" />
            <GradientStop Color="#FFFFD75C" Offset="0.6" />
            <GradientStop Color="#FFFFD456" Offset="0.25" />
            <GradientStop Color="#FFFFE395" Offset="0.05" />
            <GradientStop Color="#FFFFEAAD" Offset="0" />
