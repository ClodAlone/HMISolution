    <DataTemplate x:Key="HeaderDataTemplate" DataType="{x:Type local:TabSplitterItem}">
        <TextBlock Focusable="False" Text="{Binding}" TextTrimming="CharacterEllipsis" 
				   IsHitTestVisible="False" Padding="5,0,5,0"
				   />
