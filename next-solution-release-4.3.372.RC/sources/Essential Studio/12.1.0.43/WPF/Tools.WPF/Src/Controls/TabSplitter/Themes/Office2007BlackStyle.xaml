        <GradientStop Color="#BDB087" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Office2007BlackTabSplitterItemHoverBorderBrush" Color="#A3A3A3"/>
  
   
   
    <LinearGradientBrush x:Key="Office2007BlackTabSplitterItemSelectedBackgroundBrush" StartPoint="0.5, 0" EndPoint="0.5, 1">
