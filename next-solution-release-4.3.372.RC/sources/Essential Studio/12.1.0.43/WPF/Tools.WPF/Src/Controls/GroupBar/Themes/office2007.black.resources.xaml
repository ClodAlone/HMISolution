<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- GroupBar -->
	<SolidColorBrush x:Key="Office2007Black_GroupBar_BorderBrush" Color="#FF4C535C"/>
	<LinearGradientBrush x:Key="Office2007Black_GroupBar_HeaderBrush"
						 StartPoint="0,0"
						 EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFF8F8F9"/>
				<GradientStop Offset="0.4" Color="#FFDFE2E4"/>
				<GradientStop Offset="0.4" Color="#FFC7CBD1"/>
				<GradientStop Offset="1" Color="#FFDBDEE2"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2007Black_GroupBar_Content" Color="#FFA6ACB5"/>

	<!--GroupBarItem-->
	<LinearGradientBrush x:Key="Office2007Black_GroupBarItem_NormalStateBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFF8F8F9"/>
			<GradientStop Offset="0.4" Color="#FFDFE2E4"/>
			<GradientStop Offset="0.4" Color="#FFC7CBD1"/>
			<GradientStop Offset="1" Color="#FFDBDEE2"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Black_GroupBarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFD9AA"/>
			<GradientStop Offset="0.4" Color="#FFFFBB6E"/>
			<GradientStop Offset="0.4" Color="#FFFFAB3F"/>
			<GradientStop Offset="1" Color="#FFFEE17A"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Black_GroupBarItem_OverBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFFEE4"/>
			<GradientStop Offset="0.4" Color="#FFFFE8A7"/>
			<GradientStop Offset="0.4" Color="#FFFFD767"/>
			<GradientStop Offset="1" Color="#FFFFE69E"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Black_GroupBarItem_OverSelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFBD69"/>
			<GradientStop Offset="0.4" Color="#FFFFAC42"/>
			<GradientStop Offset="0.4" Color="#FFFB8C3C"/>
			<GradientStop Offset="1" Color="#FFFED364"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2007Black_GroupViewItem_SeparatorBrush" Color="#FF4C535C"/>

	<!-- GroupView -->
	<SolidColorBrush x:Key="Office2007Black_GroupView_Background" Color="#FFA6ACB5"/>

	<!-- GroupViewItem -->
	<Color x:Key="Office2007Black_GroupViewItem_OverBackgroundColor">#FFFFD091</Color>
	<Color x:Key="Office2007Black_GroupViewItem_PressedBackgroundColor">#FFFE9552</Color>
	<Color x:Key="Office2007Black_GroupViewItem_SelectedBackgroundColor">#FFFFAD55</Color>
	<Color x:Key="Office2007Black_GroupViewItem_SelectedOverBackgroundColor">#FFFE914E</Color>

	<SolidColorBrush x:Key="Office2007Black_GroupViewItem_BackgroundBrush" Color="#FFA6ACB5"/>
	<SolidColorBrush x:Key="Office2007Black_GroupViewItem_BorderBrush" Color="#FFA6ACB5"/>
	<SolidColorBrush x:Key="Office2007Black_GroupViewItem_OverBackgroundBrush" Color="#FFFFD091"/>
	<SolidColorBrush x:Key="Office2007Black_GroupViewItem_OverBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2007Black_GroupViewItem_PressedBackgroundBrush" Color="#FFFE9552"/>
	<SolidColorBrush x:Key="Office2007Black_GroupViewItem_PressedBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2007Black_GroupViewItem_SelectedBackgroundBrush" Color="#FFFFAD55"/>
	<SolidColorBrush x:Key="Office2007Black_GroupViewItem_SelectedBorderBrush" Color="#FF000080"/>
	<SolidColorBrush x:Key="Office2007Black_GroupViewItem_SelectedOverBackgroundBrush" Color="#FFFE914E"/>

	<!-- Splitter -->
	<LinearGradientBrush x:Key="Office2007Black_Splitter_BackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFFFFF"/>
			<GradientStop Offset="1" Color="#FFC3C8CE"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2007Black_PointBrush" Color="#FF7C7C7C"/>

	<!--NavigationToolbar-->
	<LinearGradientBrush x:Key="Office2007Black_NavigationToolbar_BackgroundBrush"
						 StartPoint="0,0"
						 EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStopCollection>
				<GradientStop Offset="0" Color="#FFF8F8F9"/>
				<GradientStop Offset="0.4" Color="#FFDFE2E4"/>
				<GradientStop Offset="0.4" Color="#FFC7CBD1"/>
				<GradientStop Offset="1" Color="#FFDBDEE2"/>
			</GradientStopCollection>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>

	<!--NavigationToolbarItem-->
	<LinearGradientBrush x:Key="Office2007Black_NavigationToolbarItem_SelectedBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFD9AA"/>
			<GradientStop Offset="0.4" Color="#FFFFBB6E"/>
			<GradientStop Offset="0.4" Color="#FFFFAB3F"/>
			<GradientStop Offset="1" Color="#FFFEE17A"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Black_NavigationToolbarItem_OverBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFFEE4"/>
			<GradientStop Offset="0.4" Color="#FFFFE8A7"/>
			<GradientStop Offset="0.4" Color="#FFFFD767"/>
			<GradientStop Offset="1" Color="#FFFFE69E"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="Office2007Black_NavigationToolbarItem_SelectedOverBackgroundBrush"
		StartPoint="0,0"
		EndPoint="0,1">
		<LinearGradientBrush.GradientStops>
			<GradientStop Offset="0" Color="#FFFFBD69"/>
			<GradientStop Offset="0.4" Color="#FFFFAC42"/>
			<GradientStop Offset="0.4" Color="#FFFB8C3C"/>
			<GradientStop Offset="1" Color="#FFFED364"/>
		</LinearGradientBrush.GradientStops>
	</LinearGradientBrush>
	<SolidColorBrush x:Key="Office2007Black_NavigationToolbarItem_ArrowBrush1" Color="#FF313431"/>
	<SolidColorBrush x:Key="Office2007Black_NavigationToolbarItem_ArrowBrush2" Color="#FFEBEBEB"/>

	<!-- MenuItem -->
	<SolidColorBrush x:Key="Office2007Black_MenuItem_Brush" Color="#FFE9EEEE"/>
	<SolidColorBrush x:Key="Office2007Black_MenuItem_OverBrush" Color="#FFFFE7A2"/>
	<SolidColorBrush x:Key="Office2007Black_MenuItem_OverBorderBrush" Color="#FFFFBD69"/>
	<SolidColorBrush x:Key="Office2007Black_MenuItem_SelectedBackgroundBrush" Color="#FFFFAB3F"/>
	<SolidColorBrush x:Key="Office2007Black_MenuItem_SelectedOverBackgroundBrush" Color="#FFFFAB3F"/>
	<SolidColorBrush x:Key="Office2007Black_MenuItem_SeparatorBrush" Color="#FF9AC6FF"/>

	<!-- Menu -->
	<SolidColorBrush x:Key="Office2007Black_Menu_BackgroundBrush" Color="#FFF6F6F6"/>
	<SolidColorBrush x:Key="Office2007Black_Menu_BorderBrush" Color="#FF6593CF"/>

	<!-- MenuText -->
	<SolidColorBrush x:Key="Office2007Black_MenuText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="Office2007Black_MenuText_SelectedBrush" Color="Black"/>
	<SolidColorBrush x:Key="Office2007Black_MenuText_DisabledBrush" Color="Gray"/>

	<!-- Text -->
	<SolidColorBrush x:Key="Office2007Black_TabText_Brush" Color="Black"/>
	<SolidColorBrush x:Key="Office2007Black_ItemText_Brush" Color="Black"/>

    <SolidColorBrush x:Key="Office2007Black_CollapseArrowColor" Color="#000000"/>
    <SolidColorBrush x:Key="Office2007Black_PopupBorderFillColor" Color="#C5C7D1"/>
    <SolidColorBrush x:Key="Office2007Black_NavigationPaneColor" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="Office2007Black_NavigationPaneMouseOverColor" Color="#FFC06F"/>
    <SolidColorBrush x:Key="Office2007Black_NavigationPaneTextColor" Color="#000000"/>
    <SolidColorBrush x:Key="Office2007Black_NavigationPaneBorderColor" Color="#4C535C"/>
    <SolidColorBrush x:Key="Office2007Black_NavigationPaneCheckedBorderColor" Color="#4C535C"/>

</ResourceDictionary>