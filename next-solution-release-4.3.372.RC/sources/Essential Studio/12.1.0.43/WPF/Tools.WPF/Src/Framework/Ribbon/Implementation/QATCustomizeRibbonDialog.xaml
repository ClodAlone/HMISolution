<Window x:Class="Syncfusion.Windows.Tools.Controls.QATCustomizeRibbonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow"
        Title="Rename" Height="100" Width="350">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock  Text="Display Name :" VerticalAlignment="Center" />
        <TextBox Margin="5" x:Name="renameTextBox" Text="{Binding DisplayName}"  FocusManager.IsFocusScope="True" Grid.Column="1"/>
        <StackPanel Margin="10 0 0 0" Orientation="Horizontal" Grid.Column="1" Grid.Row="1">
            <Button x:Name="btnOK" IsDefault="True" Content="Ok" Width="75" Height="25" Click="btnOK_Click"/>
            <Button x:Name="btnCancel" IsCancel="True" Content="Cancel" Margin="10 0 0 0"  Width="75" Height="25" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
