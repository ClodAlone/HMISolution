    <Style TargetType="{x:Type local:TitleBar}">
        <Setter Property="Focusable" Value="False"/>
        <!--<Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>-->
        <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
        <Setter Property="ClipToBounds" Value="False"/>        
        <Setter Property="Background" Value="{StaticResource Blue.TitleBar.BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue.TitleBar.BorderBrush}"/>
        <Setter Property="Template" Value="{StaticResource Office2007BlueTitleBarTemplate}"/>

        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Foreground" Value="{StaticResource Black.Foreground2}"/>
                <Setter Property="Background" Value="{StaticResource Black.TitleBar.BackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Black.TitleBar.BorderBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2007BlackTitleBarTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Foreground" Value="{StaticResource Silver.Foreground}"/>
                <Setter Property="Background" Value="{StaticResource Silver.TitleBar.BackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Silver.TitleBar.BorderBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2007SilverTitleBarTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}"/>
                <Setter Property="Background" Value="{StaticResource Office2003.TitleBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Office2003.TitleBorderBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2003TitleBarTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}"/>
                <Setter Property="Background" Value="{StaticResource Blend.RibbonBarBackgroundBrush1}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Blend.TitleActiveBorderBrush}"/>
                <Setter Property="Template" Value="{StaticResource BlendTitleBarTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
                <Setter Property="Background" Value="{StaticResource SelectedBrushKey.ShinyRed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
                <Setter Property="Template" Value="{StaticResource ShinyRedTitleBarTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyBlue}"/>
                <Setter Property="Background" Value="{StaticResource SelectedBrushKey.ShinyBlue}"/>
                <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
                <Setter Property="Template" Value="{StaticResource ShinyBlueTitleBarTemplate}"/>
            </Trigger>            
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="False">
                <Setter Property="SysButtonsColumnWidth" Value="75"/>
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="False" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowStyle}" Value="ToolWindow" />
