<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
	xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    >
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blue.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Silver.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Black.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Default.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Office2003.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyBlue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blend.xaml"/>

        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyRed.xaml"/>
       
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="RibbonSeparatorTemplate.Office2007Blue" TargetType="{x:Type local:RibbonSeparator}">
        <StackPanel Width="2" Height="55" Orientation="Horizontal">
            <Border Width="1" Height="55" Background="White"/>
            <Border Width="1" Height="55" Background="{StaticResource Blue.SeparatorBrush}"/>
        </StackPanel>
    </ControlTemplate>
    <ControlTemplate x:Key="RibbonSeparatorTemplate.Office2007Black" TargetType="{x:Type local:RibbonSeparator}">
        <StackPanel Width="2" Height="55" Orientation="Horizontal">
            <Border Width="1" Height="55" Background="White"/>
            <Border Width="1" Height="55" Background="{StaticResource Black.SeparatorBrush}"/>
        </StackPanel>
    </ControlTemplate>
    <ControlTemplate x:Key="RibbonSeparatorTemplate.Office2007Silver" TargetType="{x:Type local:RibbonSeparator}">
        <StackPanel Width="2" Height="55" Orientation="Horizontal">
            <Border Width="1" Height="55" Background="White"/>
            <Border Width="1" Height="55" Background="{StaticResource Silver.SeparatorBrush}"/>
        </StackPanel>
    </ControlTemplate>
    <ControlTemplate x:Key="RibbonSeparatorTemplate.Office2003" TargetType="{x:Type local:RibbonSeparator}">
        <StackPanel Width="2" Height="55" Orientation="Horizontal">
            <Border Width="1" Height="55" Background="White"/>
            <Border Width="1" Height="55" Background="{StaticResource Blue.SeparatorBrush}"/>
        </StackPanel>
    </ControlTemplate>
    <ControlTemplate x:Key="RibbonSeparatorTemplate.Blend" TargetType="{x:Type local:RibbonSeparator}">
        <StackPanel Width="2" Height="55" Orientation="Horizontal">
            <Border Width="1" Height="55" Background="White"/>
            <Border Width="1" Height="55" Background="{StaticResource Blend.SeparatorBrush}"/>
        </StackPanel>
    </ControlTemplate>
    <ControlTemplate x:Key="RibbonSeparatorTemplate.ShinyRed" TargetType="{x:Type local:RibbonSeparator}">
        <StackPanel Width="2" Height="55" Orientation="Horizontal">
            <Border Width="1" Height="55" Background="White"/>
            <Border Width="1" Height="55" Background="{StaticResource SeparatorBackgroundBrushKey.ShinyRed}"/>
        </StackPanel>
    </ControlTemplate>
    <ControlTemplate x:Key="RibbonSeparatorTemplate.ShinyBlue" TargetType="{x:Type local:RibbonSeparator}">
        <StackPanel Width="2" Height="55" Orientation="Horizontal">
            <Border Width="1" Height="55" Background="White"/>
            <Border Width="1" Height="55" Background="{StaticResource SeparatorBackgroundBrushKey.ShinyBlue}"/>
        </StackPanel>
    </ControlTemplate>

    <Style TargetType="{x:Type local:RibbonSeparator}">
        <Setter Property="Focusable"   Value="False"/>     
        <Setter Property="Template" Value="{StaticResource RibbonSeparatorTemplate.Office2007Blue}"/>
        <Setter Property="Margin" Value="3,5,3,0"/>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Template" Value="{StaticResource RibbonSeparatorTemplate.Office2007Black}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Template" Value="{StaticResource RibbonSeparatorTemplate.Office2007Silver}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Template" Value="{StaticResource RibbonSeparatorTemplate.Office2003}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Template" Value="{StaticResource RibbonSeparatorTemplate.Blend}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Template" Value="{StaticResource RibbonSeparatorTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Template" Value="{StaticResource RibbonSeparatorTemplate.ShinyBlue}"/>
            </Trigger>            
        </Style.Triggers>
    </Style>
</ResourceDictionary>
