    <Syncfusion:FloatTrimmingTemplate x:Key="FloatTrimmingTemplate" />

	<ControlTemplate x:Key="Office2007BlueFloatWindowCloseButtonTemplate"  TargetType="{x:Type Button}">
		<Border x:Name="brdBack" Height="16" Width="17" Margin="0,0,0,0"
				BorderThickness="1" Background="{StaticResource FloatCloseButtonBackground}" 
				BorderBrush="Transparent" >
			<Path Name="pathButton" SnapsToDevicePixels="False" Stretch="Fill" StrokeThickness="1.5"
					Stroke="{StaticResource Office2007Blue.AwlKeyImg}"
					Data="M109,51 L216,142 M215,52 L109,142"
					HorizontalAlignment="Center" VerticalAlignment="Center" Width="9" Height="8"/>
		 </Border>
		<ControlTemplate.Triggers>
			<Trigger Property="Button.IsEnabled" Value="False">
				<Setter TargetName="brdBack" Property="Opacity" Value="0.4"/>
			</Trigger>
			<Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="brdBack" Property="Background" Value="{StaticResource Office2007Blue.ButtonFocused}"/>
                <Setter TargetName="brdBack" Property="BorderBrush" Value="{StaticResource Office2007Blue.ButtonFocusedBorder}"/>
                <Setter TargetName="pathButton" Property="Stroke" Value="{StaticResource Office2007Blue.AwlKeyImgFocused}"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

