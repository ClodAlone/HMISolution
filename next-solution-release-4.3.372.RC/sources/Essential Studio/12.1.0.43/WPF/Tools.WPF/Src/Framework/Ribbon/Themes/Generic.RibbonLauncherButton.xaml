            </Storyboard>
            <Storyboard x:Key="CheckedOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="CheckedBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="CheckedOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="CheckedBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ControlTemplate.Resources>
        <Border VerticalAlignment="Center" 
            HorizontalAlignment="Center"
			CornerRadius="{TemplateBinding CornerRadius}"
			BorderThickness="{TemplateBinding BorderThickness}"
			BorderBrush="{TemplateBinding BorderBrush}"
			Background="{TemplateBinding Background}"
			SnapsToDevicePixels="True" Name="Background"
			Width="{TemplateBinding Width}"
			Height="{TemplateBinding Height}">
            <Grid>
                <Border x:Name="CheckedBorder" BorderThickness="{TemplateBinding BorderThickness}" Opacity="0" Background="{StaticResource SelectedBrushKey.ShinyBlue}" CornerRadius="{TemplateBinding CornerRadius}"/>
                <Border x:Name="Hover" BorderThickness="{TemplateBinding BorderThickness}" Background="{StaticResource HighlightBrushKey.ShinyBlue}"  CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>

                <Border x:Name="PART_InnerBorder" 
              Width="13" 
              Height="12"
			  VerticalAlignment="Center" 
              HorizontalAlignment="Center"
		      CornerRadius="{TemplateBinding CornerRadius}"
			  BorderThickness="{TemplateBinding BorderThickness}"
			  BorderBrush="{TemplateBinding BorderBrush}"
			  Background="{TemplateBinding Background}" 
              SnapsToDevicePixels="True">
                    <Canvas Margin="1,0,0,0" Width="8" Height="8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Path Stroke="{StaticResource GlyphBrushKey.ShinyBlue}">
                            <Path.Data>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0.5,0" EndPoint="0.5,6"/>
                                    <LineGeometry StartPoint="0,0.5" EndPoint="6,0.5"/>
                                    <LineGeometry StartPoint="3,3.5" EndPoint="4,3.5"/>
                                    <LineGeometry StartPoint="4,4.5" EndPoint="6,4.5"/>
                                    <LineGeometry StartPoint="4,5.5" EndPoint="6,5.5"/>
                                    <LineGeometry StartPoint="3,6.5" EndPoint="7,6.5"/>
                                    <LineGeometry StartPoint="6.5,3" EndPoint="6.5,7"/>
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                        <Path x:Name="PART_WhitePath" Stroke="{StaticResource TextBoxBackgroundBrushKey.ShinyBlue}">
                            <Path.Data>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="1.5,1" EndPoint="1.5,6"/>
                                    <LineGeometry StartPoint="1,1.5" EndPoint="6,1.5"/>
                                    <LineGeometry StartPoint="4,3.5" EndPoint="5,3.5"/>
                                    <LineGeometry StartPoint="4,7.5" EndPoint="8,7.5"/>
                                    <LineGeometry StartPoint="7.5,3" EndPoint="7.5,8"/>
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                    </Canvas>
                </Border>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                </Trigger.ExitActions>
                <Setter Property="Background" TargetName="Background" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource PressedOn}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource PressedOff}"/>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--RibbonBarLauncherButton style-->
  <Style x:Key="RibbonBarLauncherButton" TargetType="{x:Type local:RibbonButton}">
    <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>  
    <Setter Property="CornerRadius" Value="0,0,1,0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="#5D41A0"/>      
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template" Value="{StaticResource RibbonBarLauncherTemplate.Office2007Blue}"/>
    <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Template" Value="{StaticResource RibbonBarLauncherTemplate.Office2007Black}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Template" Value="{StaticResource RibbonBarLauncherTemplate.Office2007Silver}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Template" Value="{StaticResource RibbonBarLauncherTemplate.Office2003}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Template" Value="{StaticResource RibbonBarLauncherTemplate.Blend}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Template" Value="{StaticResource RibbonBarLauncherTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Template" Value="{StaticResource RibbonBarLauncherTemplate.ShinyBlue}"/>
            </Trigger>
        </Style.Triggers>
  </Style>
    
</ResourceDictionary>