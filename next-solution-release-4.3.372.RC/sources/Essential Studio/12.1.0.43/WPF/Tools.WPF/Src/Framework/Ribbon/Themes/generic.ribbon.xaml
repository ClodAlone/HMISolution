  <!--Ribbon normal state template-->
  <ControlTemplate TargetType="{x:Type local:Ribbon}" x:Key="Normal.Office2007Blue">
        <AdornerDecorator Name="PART_AdornerDecorator" DockPanel.Dock="Top" 
                              Panel.ZIndex="100"
                              Margin="0,-30,0,0">
            <Border>
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="53"/>
                        <RowDefinition Height="92"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0"
                   Panel.ZIndex="200">
                        <local:RibbonWindowPanel x:Name="PART_RibbonWindowPanel" DockPanel.Dock="Top" Panel.ZIndex="100">
                            <Border x:Name="PART_TitleBorder"
                    Visibility="Collapsed"
                    Height="30"
                    Margin="0,0,0,-20"
                    Background="{StaticResource Blue.TitleBar.BackgroundBrush}"
                    Width="{TemplateBinding ActualWidth}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource Blue.TitleBar.BorderBrush}"
                    CornerRadius="5,5,0,0"/>
                            <ContentPresenter ContentSource="ApplicationMenu"
                              Margin="5,6,0,0"
                              Width="38" Height="38"
                              Name="PART_ApplicationMenu"
                              Content="{TemplateBinding ApplicationMenu}"/>
                            <ContentPresenter HorizontalAlignment="Center"
                              Margin="43,0,0,0"
                              Height="30"
                              Content="{TemplateBinding QuickAccessToolBar}"/>
                        </local:RibbonWindowPanel>
                        <Border DockPanel.Dock="Left"
                  Background="{StaticResource Blue.Ribbon.TabPanelBackground}"
                  Height="23"
                  Width="5"
                  Margin="0,-14,0,0"/>
                        <Border DockPanel.Dock="Left"
                  Background="{StaticResource Blue.Ribbon.TabPanelBackground}"
                  Width="41"
                  Height="23"
                  Margin="0,-14,0,0"
                  Panel.ZIndex="11"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="0,0,0,1"/>
                        <Border DockPanel.Dock="Right"
                  Width="5"
                  Background="{StaticResource Blue.Ribbon.TabPanelBackground}"
                  Height="23"
                  Margin="0,-14,0,0"
                  Panel.ZIndex="12"/>
                        <Border DockPanel.Dock="Right"
                  Background="{StaticResource Blue.Ribbon.TabPanelBackground}"
                  Height="23"
                  Panel.ZIndex="12"
                  Margin="0,-14,0,1"
                  BorderThickness="0,0,0,1"
                  BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter ContentSource="TabPanelItem"/>
                        </Border>
                        <Border DockPanel.Dock="Bottom"
                  Margin="0,-14,0,1"
                  Panel.ZIndex="10"
                  Background="{StaticResource Blue.Ribbon.TabPanelBackground}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
                            <ItemsPresenter/>
                        </Border>
                    </DockPanel>
                    <Border Grid.Row="1"
                Background="{StaticResource Blue.Ribbon.TabPanelBackground}">
                        <Border Margin="3,-1,3,0"
                  Padding="0"
                  BorderThickness="1"
                  CornerRadius="3"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  Background="{TemplateBinding Background}">
                            <local:RibbonTabItemsControl Focusable="False" ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedTabItem.Items}" ItemTemplate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedTabItem.ItemTemplate}" DisplayMemberPath="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedTabItem.DisplayMemberPath}" ItemContainerStyle="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedTabItem.ItemContainerStyle}" >
								<local:RibbonTabItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<local:RibbonLayoutPanel />
									</ItemsPanelTemplate>
								</local:RibbonTabItemsControl.ItemsPanel>
							</local:RibbonTabItemsControl>
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </AdornerDecorator>
        <ControlTemplate.Triggers>
            <!--<MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}, Path=IsGlassActive}"
                       Value="True" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}, Path=WindowState}"
                       Value="Maximized" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_AdornerDecorator" Property="Margin" Value="0,-22,0,0" />
            </MultiDataTrigger>-->
            <Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="True">
                <Setter TargetName="PART_AdornerDecorator" 
                        Property="Margin" Value="0"/>
            </Trigger>
            
        </ControlTemplate.Triggers>
    </ControlTemplate>
    
