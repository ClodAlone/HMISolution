        <Setter Property="TabPanelBackground" Value="{StaticResource TabPanelBackgroundBrushKey.ShinyRed}"/>
        <Setter Property="TabItemsCornerRadius" Value="0,0,2,2" />
        <Setter Property="TabItemBorderThickness" Value="1" />
