                            <DockPanel LastChildFill="True" IsHitTestVisible="False">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Name="FillArea" Grid.Column="1" Grid.Row="1" Grid.RowSpan="1" 
                                            Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor
						, AncestorType={x:Type Syncfusion:HostAdornerVS2005}}}"
                                BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor
						, AncestorType={x:Type Syncfusion:HostAdornerVS2005}}}"
                                BorderThickness="{Binding Path=BorderThickness, RelativeSource={RelativeSource FindAncestor
						, AncestorType={x:Type Syncfusion:HostAdornerVS2005}}}"
                                            Opacity="{Binding Path=Opacity, RelativeSource={RelativeSource FindAncestor
						, AncestorType={x:Type Syncfusion:HostAdornerVS2005}}}" MinHeight="60" MinWidth="60" IsHitTestVisible="False" />

                                    <Border Name="TabArea"  Grid.Column="1" Grid.Row="1" 
                                            Background="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor
						, AncestorType={x:Type Syncfusion:HostAdornerVS2005}}}"
                                BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor
						, AncestorType={x:Type Syncfusion:HostAdornerVS2005}}}"
                                BorderThickness="{Binding Path=TabAreaBorderThickness, RelativeSource={RelativeSource FindAncestor
						, AncestorType={x:Type Syncfusion:HostAdornerVS2005}}}"
                                            Opacity="{Binding Path=Opacity, RelativeSource={RelativeSource FindAncestor
						, AncestorType={x:Type Syncfusion:HostAdornerVS2005}}}" IsHitTestVisible="False" />
                                </Grid>
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <DataTrigger  Binding="{Binding Path=TabStripPlacement, RelativeSource={RelativeSource FindAncestor
						, AncestorType={x:Type Syncfusion:HostAdornerVS2005}}}" Value="Bottom" >
                                    <Setter TargetName="TabArea" Property="Grid.Row" Value="2"/>
                                    <Setter TargetName="TabArea" Property="Width" Value="44"/>
                                    <Setter TargetName="TabArea" Property="Height" Value="22"/>
                                    <Setter TargetName="TabArea" Property="Margin" Value="7,0,0,0"/>
                                    <Setter TargetName="TabArea" Property="HorizontalAlignment" Value="Left"/>
                                </DataTrigger>
                                <DataTrigger  Binding="{Binding Path=TabStripPlacement, RelativeSource={RelativeSource FindAncestor
						, AncestorType={x:Type Syncfusion:HostAdornerVS2005}}}" Value="Top" >
                                    <Setter TargetName="TabArea" Property="Grid.Row" Value="0"/>
                                    <Setter TargetName="TabArea" Property="Width" Value="{Binding Path=TabAreaWidth,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Syncfusion:HostAdornerVS2005}}}"/>
                                    <Setter TargetName="TabArea" Property="Height" Value="22"/>
                                    <Setter TargetName="TabArea" Property="Margin" Value="{Binding Path=TabAreaTopMargin,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Syncfusion:HostAdornerVS2005}}}"/>
                                    <Setter TargetName="TabArea" Property="HorizontalAlignment" Value="Left"/>
                                </DataTrigger>
                                <DataTrigger  Binding="{Binding Path=TabStripPlacement, RelativeSource={RelativeSource FindAncestor
						, AncestorType={x:Type Syncfusion:HostAdornerVS2005}}}" Value="Left" >
                                    <Setter TargetName="TabArea" Property="Grid.Row" Value="1"/>
                                    <Setter TargetName="TabArea" Property="Grid.Column" Value="0"/>
                                    <Setter TargetName="TabArea" Property="Width" Value="22"/>
                                    <Setter TargetName="TabArea" Property="Height" Value="44"/>
                                    <Setter TargetName="TabArea" Property="Margin" Value="0,7,0,0"/>
                                    <Setter TargetName="TabArea" Property="VerticalAlignment" Value="Top"/>
                                </DataTrigger>
                                <DataTrigger  Binding="{Binding Path=TabStripPlacement, RelativeSource={RelativeSource FindAncestor
						, AncestorType={x:Type Syncfusion:HostAdornerVS2005}}}" Value="Right" >
                                    <Setter TargetName="TabArea" Property="Grid.Row" Value="1"/>
                                    <Setter TargetName="TabArea" Property="Grid.Column" Value="2"/>
                                    <Setter TargetName="TabArea" Property="Width" Value="22"/>
                                    <Setter TargetName="TabArea" Property="Height" Value="44"/>
                                    <Setter TargetName="TabArea" Property="Margin" Value="0,7,0,0"/>
                                    <Setter TargetName="TabArea" Property="VerticalAlignment" Value="Top"/>
                                </DataTrigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>




    <ControlTemplate x:Key="FlatKeyClose" TargetType="{x:Type ToggleButton}">
        <ControlTemplate.Resources>
            <Storyboard x:Key="HoverOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Hover" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="HoverOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Hover" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="PressedOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Background" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0.6"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="PressedOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Background" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="FocusedOn">
                <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00.1000000" Value="{x:Static Visibility.Visible}"/>
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>

            </Storyboard>
            <Storyboard x:Key="FocusedOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ControlTemplate.Resources>

        <Grid x:Name="Grid">
            <Border x:Name="Background" Background="Transparent"  BorderBrush="Transparent" Width="15" Height="15"  BorderThickness="1" CornerRadius="2,2,2,2">
                <Border x:Name="Hover" Background="{StaticResource HighlightBrushKey.ShinyRed}" Width="15" Height="15" CornerRadius="1,1,1,1" Opacity="0"/>
            </Border>
            <ContentPresenter HorizontalAlignment="Center" Margin="{TemplateBinding Padding}" 
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center" RecognizesAccessKey="True">
                <ContentPresenter.Content>
                    <Path Name="pathButton" SnapsToDevicePixels="False" Stretch="Fill" StrokeThickness="1.5"
					Stroke="{TemplateBinding ToggleButton.Foreground}"
					Data="M109,51 L216,142 M215,52 L109,142"
					HorizontalAlignment="Center" VerticalAlignment="Center" Width="9" Height="8"/>
                </ContentPresenter.Content>
            </ContentPresenter>
            <Border x:Name="FocusVisualElement"
                    IsHitTestVisible="false" Width="15" Height="15"
                    BorderBrush="{StaticResource HighlightBrushKey.ShinyRed}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="2,2,2,2" Opacity="0"/>
        </Grid>

        <ControlTemplate.Triggers>

            <Trigger Property="IsMouseOver" Value="true">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                </Trigger.ExitActions>
                <Setter Property="Background" TargetName="Background" Value="{StaticResource ButtonBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="BorderBrush" TargetName="Background" Value="{StaticResource ButtonBorderBrushKey.ShinyRed}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource PressedOn}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource PressedOff}"/>
                </Trigger.ExitActions>
                <Setter Property="Background" TargetName="Background" Value="{StaticResource ButtonBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="BorderBrush" TargetName="Background" Value="{StaticResource ButtonBorderBrushKey.ShinyRed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>

