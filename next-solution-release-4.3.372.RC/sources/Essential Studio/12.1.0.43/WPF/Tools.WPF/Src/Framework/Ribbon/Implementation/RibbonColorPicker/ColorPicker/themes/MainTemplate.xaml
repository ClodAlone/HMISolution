                                    <GeometryDrawing.Brush>
                                        <LinearGradientBrush StartPoint="0.471284,1.25485" EndPoint="2.89611,1.25485">
                                            <LinearGradientBrush.RelativeTransform>
                                                <TransformGroup>
                                                    <SkewTransform CenterX="0.471284" CenterY="1.25485" AngleX="-11.6496" AngleY="0"/>
                                                    <RotateTransform CenterX="0.471284" CenterY="1.25485" Angle="-83.5707"/>
                                                </TransformGroup>
                                            </LinearGradientBrush.RelativeTransform>
                                            <LinearGradientBrush.GradientStops>
                                                <GradientStop Color="#FFEB8221" Offset="0"/>
