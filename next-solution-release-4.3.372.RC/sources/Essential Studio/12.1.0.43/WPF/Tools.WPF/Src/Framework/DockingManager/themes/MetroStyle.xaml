                            <Setter TargetName="brdBack" Property="Background" Value="{DynamicResource MetroHoverBrush}"/>
                        </Trigger>                       
                        <Trigger Property="IsFocused" Value="True">                            
                            <Setter TargetName="brdBack" Property="Background" Value="{DynamicResource MetroBrush}"/>
                        </Trigger>                      
