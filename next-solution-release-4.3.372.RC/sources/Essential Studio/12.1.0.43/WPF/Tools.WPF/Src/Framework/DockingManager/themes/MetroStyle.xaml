                <Setter TargetName="borderTop" Property="Background" Value="{StaticResource Office2007Blue.DockedElementTabbedHostFocused}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=IsTemplateParenKeyboardFocusWithin
							, RelativeSource={RelativeSource Self}}"
						 Value="True" >
