                                      TextBlock.Foreground="{StaticResource Default.FloatWindowHeaderForeground}" IsHitTestVisible="True"
							Content="{Binding Path=(Syncfusion:DockingManager.InternalDataContext).(Syncfusion:DockingManager.InternalDataContext).(Syncfusion:DockingManager.Header)
