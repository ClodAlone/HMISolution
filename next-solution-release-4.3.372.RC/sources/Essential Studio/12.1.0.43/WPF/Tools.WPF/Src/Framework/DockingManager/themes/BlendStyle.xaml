                        <LinearGradientBrush  StartPoint="0,0" EndPoint="1,0" >
                            <LinearGradientBrush.GradientStops>
                                <GradientStopCollection>
                                    <GradientStop Color="#F0000000" Offset="0"/>
                                    <GradientStop Color="#10000000" Offset="1"/>
                                </GradientStopCollection>
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <DockPanel Background="{Binding Path=PreviewPanelBackground,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Syncfusion:DockingManager}}}" >
