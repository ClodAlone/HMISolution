                          <Path Data="M4,0L8,3.5 4,7" Canvas.Left="0" Canvas.Top="7"  Stroke="{StaticResource BlendScrollingButtonPathFill}" Fill="{StaticResource BlendScrollingButtonPathFill}" Name="PART_Path4" >
                          </Path>
                          <Path Data="M5,0L5,7" Canvas.Left="4" Canvas.Top="7" Stroke="{StaticResource BlendScrollingButtonPathFill}" Fill="{StaticResource BlendScrollingButtonPathFill}" Name="PART_Path6" >
                          </Path>
                        </Canvas>
                      </RepeatButton.Content>
                    </RepeatButton>
                  </StackPanel>
                  <ControlTemplate.Triggers>

                    <Trigger SourceName="PART_HomePage" Property="IsMouseOver" Value="True">
                      <Setter Property="Fill" TargetName="PART_Path1" Value="{StaticResource Blend.AwlKeyImgOver}"/>
                      <Setter Property="Fill" TargetName="PART_Path5" Value="{StaticResource Blend.AwlKeyImgOver}"/>
                      <Setter Property="Stroke" TargetName="PART_Path1" Value="{StaticResource Blend.AwlKeyImgOver}"/>
                      <Setter Property="Stroke" TargetName="PART_Path5" Value="{StaticResource Blend.AwlKeyImgOver}"/>
                    </Trigger>
                    <Trigger SourceName="PART_PreviousTab" Property="IsMouseOver" Value="True">
                      <Setter Property="Fill" TargetName="PART_Path2" Value="{StaticResource Blend.AwlKeyImgOver}"/>
                      <Setter Property="Stroke" TargetName="PART_Path2" Value="{StaticResource Blend.AwlKeyImgOver}"/>
                    </Trigger>
                    <Trigger SourceName="PART_NextTab" Property="IsMouseOver" Value="True">
                      <Setter Property="Fill" TargetName="PART_Path3" Value="{StaticResource Blend.AwlKeyImgOver}"/>
                      <Setter Property="Stroke" TargetName="PART_Path3" Value="{StaticResource Blend.AwlKeyImgOver}"/>
                    </Trigger>
                    <Trigger SourceName="PART_EndPage" Property="IsMouseOver" Value="True">
                      <Setter Property="Fill" TargetName="PART_Path4" Value="{StaticResource Blend.AwlKeyImgOver}"/>
                      <Setter Property="Fill" TargetName="PART_Path6" Value="{StaticResource Blend.AwlKeyImgOver}"/>
                      <Setter Property="Stroke" TargetName="PART_Path4" Value="{StaticResource Blend.AwlKeyImgOver}"/>
                      <Setter Property="Stroke" TargetName="PART_Path6" Value="{StaticResource Blend.AwlKeyImgOver}"/>
                    </Trigger>

                    <Trigger SourceName="PART_HomePage" Property="IsEnabled" Value="False">
                      <Setter Property="Opacity" TargetName="PART_HomePage" Value="0.5"/>
                    </Trigger>
                    <Trigger SourceName="PART_PreviousTab" Property="IsEnabled" Value="False">
                      <Setter Property="Opacity" TargetName="PART_PreviousTab" Value="0.5"/>
                    </Trigger>
                    <Trigger SourceName="PART_NextTab" Property="IsEnabled" Value="False">
                      <Setter Property="Opacity" TargetName="PART_NextTab" Value="0.5"/>
                    </Trigger>
                    <Trigger SourceName="PART_EndPage" Property="IsEnabled" Value="False">
                      <Setter Property="Opacity" TargetName="PART_EndPage" Value="0.5"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
