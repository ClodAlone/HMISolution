    <!--Usenativewindow-->
    
    <ControlTemplate x:Key="BlendUseNativeWindowStyle" TargetType="{x:Type Syncfusion:DockHeaderPresenter}">
        <Border  x:Name="borderTop" Width="Auto" Height="20" CornerRadius="3"
				 BorderBrush="{StaticResource Blend.BrushHeader}"
				 BorderThickness="1.5"
                 Background="{StaticResource Blend.BrushHeader}" >
            <Border.ContextMenu>
                <Syncfusion:CustomContextMenu Name="PART_ContextMenu" IsEnabledAutoHideMenuItem="False" Focusable="false" />
            </Border.ContextMenu>
            <Grid>
                <DockPanel LastChildFill="True" >
                    <ToggleButton Name="PART_CloseButton" DockPanel.Dock="Right" Focusable="False"
							Command="Syncfusion:DockHeaderPresenter.CloseCommand"
							Template="{Binding Path=ElementHost.DockingManager.CloseButtonTemplate,
								RelativeSource={RelativeSource TemplatedParent}}"
							Foreground="{StaticResource Blend.FlatKeyBrush}"
					>
                        <ToggleButton.ToolTip>
                            <ToolTip Name="tooltip" >
                                <TextBlock Name="PART_CloseButtonTooltipText" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=CloseButtonTooltipText}" />
                            </ToolTip>
                        </ToggleButton.ToolTip>
                    </ToggleButton>
                    <ToggleButton Name="PART_AwlButton" DockPanel.Dock="Right" Focusable="False"
                                  VerticalAlignment="Top"
                                  Command="Syncfusion:DockHeaderPresenter.ChangeAwlStateCommand"
                                  Template="{Binding Path=ElementHost.DockingManager.AwlButtonTemplate,
									RelativeSource={RelativeSource TemplatedParent}}"
                                  Foreground="{StaticResource Blend.AwlKeyImg}"
				>
                        <ToggleButton.ToolTip>
                            <ToolTip Name="PART_AwlButtonTooltip" >
                                <TextBlock Name="PART_AwlButtonTooltipText" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=AwlButtonTooltipText}" />
                            </ToolTip>
                        </ToggleButton.ToolTip>
                    </ToggleButton>
                    <ToggleButton Name="PART_ContextMenuButton" DockPanel.Dock="Right" Focusable="False" 
                                  VerticalAlignment="Top" 
								  IsChecked="{Binding Path=IsContextMenuOpen, RelativeSource={RelativeSource AncestorType={x:Type Syncfusion:DockHeaderPresenter}}}"
                                  Command="Syncfusion:DockHeaderPresenter.OpenContextMenuCommand"
                                  Template="{Binding Path=ElementHost.DockingManager.MenuButtonTemplate,
									RelativeSource={RelativeSource TemplatedParent}}"
                                  Foreground="{StaticResource Blend.FlatKeyBrush}"
				>
                        <ToggleButton.ToolTip>
                            <ToolTip Name="PART_ContextMenuButtonTooltip" >
                                <TextBlock Name="PART_ContextMenuButtonTooltipText" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=ContextMenuButtonTooltipText}" />
                            </ToolTip>
                        </ToggleButton.ToolTip>
                    </ToggleButton>
                    <ToggleButton Name="PART_MaximizeButton" DockPanel.Dock="Right" Focusable="False" 
                                  VerticalAlignment="Top" Visibility="Collapsed"
                                  Command="Syncfusion:DockHeaderPresenter.MaximizeStateCommand"
							Template="{Binding Path=ElementHost.DockingManager.MaximizeButtonTemplate
								, RelativeSource={RelativeSource TemplatedParent}}"
                                  Foreground="{StaticResource Blend.FlatKeyBrush}"
				>
