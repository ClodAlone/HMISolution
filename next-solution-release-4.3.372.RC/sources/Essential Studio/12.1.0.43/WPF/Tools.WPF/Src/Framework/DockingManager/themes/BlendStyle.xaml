    <Style x:Key="BlendNativeWindowStyle" TargetType="{x:Type Syncfusion:NativeFloatWindow}">
        <!--<Setter Property="WindowStyle" Value="None"/>-->
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome ResizeBorderThickness="3" CornerRadius="0" CaptionHeight="20" GlassFrameThickness="0">

                </shell:WindowChrome>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type Syncfusion:NativeFloatWindow}">
                    <AdornerDecorator>
                        <DockPanel Focusable="False" LastChildFill="True"  >
                            <Border Name="FloatWindowOutBorder"  Focusable="False" 
						BorderBrush="{StaticResource Blend.FloatWindowBorderBrush}"
						BorderThickness="1"
						Background="{StaticResource Blend.WindowBackground}" >
                                <Grid Focusable="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Name="TopRow" Style="{StaticResource RowDefinitionStyle}" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Name="BottomRow" Height="1" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Name="LeftCol" Width="1" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Name="RightCol" Width="1" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Focusable="False" Style="{StaticResource LeftTop}" Name="BorderLeftTop" Grid.Column="0" Grid.Row="0" />
                                    <Border x:Name="Part_BorderMenu"  Grid.Column="1" Grid.Row="0" Background="Transparent" Focusable="False" >
                                        <Border.ContextMenu>
                                            <Syncfusion:CustomContextMenu  x:Name="Part_CustomContextMenu" Focusable="false" Style="{StaticResource BlendCustomContextMenuStyle}" ItemContainerStyle="{StaticResource BlendCustomMenuItemStyle}"/>
                                        </Border.ContextMenu>
                                    </Border>
                                    <ContentControl Focusable="False" Style="{StaticResource Header}" Content="{TemplateBinding Title}"  Name="BorderHeader" Grid.Column="1" Grid.Row="0" />
                                    <ContentControl Focusable="False" Style="{StaticResource RightTop}" Name="BorderRightTop" Grid.Column="2" Grid.Row="0" />
                                    <ContentControl Focusable="False" Style="{StaticResource Left}" Name="BorderLeft" Grid.Column="0" Grid.Row="1" />
                                    <ContentPresenter Name="ContentPresenter"  Grid.Column="1" Grid.Row="1"
										  ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" 
										  Content="{TemplateBinding ContentControl.Content}" />
                                    <ContentControl Focusable="False" Style="{StaticResource Right}" Name="BorderRight" Grid.Column="2" Grid.Row="1" />
                                    <ContentControl Focusable="False" Style="{StaticResource LeftBottom}" Name="BorderLeftBottom" Grid.Column="0" Grid.Row="2" />
                                    <ContentControl Focusable="False" Style="{StaticResource Bottom}" Name="BorderBottom" Grid.Column="1" Grid.Row="2" />
                                    <ContentControl Focusable="False" Style="{StaticResource RightBottom}" Name="BorderRightBottom" Grid.Column="2" Grid.Row="2" />
                                </Grid>
                            </Border>
                        </DockPanel>
                    </AdornerDecorator>
                    <!--<ControlTemplate.Triggers>
            <Trigger SourceName="FloatWindowOutBorder" Property="Visibility" Value="Visible">
                <Setter TargetName="TopRow" Property="Height" Value="{Binding Path=(Syncfusion:IWindow.DockingManager).(Syncfusion:DockingManager.FloatWindowTopBorderHeight), RelativeSource={RelativeSource AncestorType={x:Type Syncfusion:IWindow}}}" />
                <Setter TargetName="BottomRow" Property="Height" Value="{Binding Path=(Syncfusion:IWindow.DockingManager).(Syncfusion:DockingManager.FloatWindowBottomBorderHeight), RelativeSource={RelativeSource AncestorType={x:Type Syncfusion:IWindow}}}" />
                <Setter TargetName="LeftCol" Property="Width" Value="{Binding Path=(Syncfusion:IWindow.DockingManager).(Syncfusion:DockingManager.FloatWindowLeftBorderWidth), RelativeSource={RelativeSource AncestorType={x:Type Syncfusion:IWindow}}}" />
                <Setter TargetName="RightCol" Property="Width" Value="{Binding Path=(Syncfusion:IWindow.DockingManager).(Syncfusion:DockingManager.FloatWindowRightBorderWidth), RelativeSource={RelativeSource AncestorType={x:Type Syncfusion:IWindow}}}" />
            </Trigger>
        </ControlTemplate.Triggers>-->
                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>

