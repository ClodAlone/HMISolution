    <SolidColorBrush Color="Gray" x:Key="BlendScrollingButtonPathFill"/>

    <Style x:Key="BlendScrollButtonsBarStyle" TargetType="{x:Type Syncfusion:ScrollButtonsBar}">
        <Setter Property="Background" Value="{Binding Background,RelativeSource={RelativeSource FindAncestor,AncestorType={x:Type Syncfusion:SidePanel}}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Syncfusion:ScrollButtonsBar}">
                  <StackPanel Orientation="Horizontal" Background="{TemplateBinding Background}" Canvas.Left="0"  Canvas.Top="0" Panel.ZIndex="2" >
                    <RepeatButton Name="PART_HomePage" Style="{StaticResource DefaultRepeatButtonStyle}" Height="{TemplateBinding ActualHeight}"  Command="Syncfusion:SidePanel.HomePageCommand"
                          Width="15" Background="{TemplateBinding Background}">
                      <RepeatButton.Content>
                        <Canvas Height="{TemplateBinding ActualHeight}">
                          <Path Data="M4,0L8,3.5 4,7" Canvas.Left="14" Canvas.Top="14" Stroke="{StaticResource BlendScrollingButtonPathFill}" Fill="{StaticResource BlendScrollingButtonPathFill}" Name="PART_Path1" >
                            <Path.RenderTransform>
                              <RotateTransform Angle="180"/>
                            </Path.RenderTransform>
                          </Path>
                          <Path Data="M5,0L5,7" Canvas.Left="0" Canvas.Top="7" Stroke="{StaticResource BlendScrollingButtonPathFill}" Fill="{StaticResource BlendScrollingButtonPathFill}" Name="PART_Path5" >
                          </Path>
                        </Canvas>
                      </RepeatButton.Content>
                    </RepeatButton>
                    <RepeatButton Name="PART_PreviousTab" Height="{TemplateBinding ActualHeight}"
                                  Style="{StaticResource DefaultRepeatButtonStyle}"
                                  Command="Syncfusion:SidePanel.PreviousCommand"
                          Width="15" Background="{TemplateBinding Background}">
                      <RepeatButton.Content>
                        <Canvas Height="{TemplateBinding ActualHeight}">
                          <Path Data="M4,0L8,3.5 4,7" Canvas.Left="12" Canvas.Top="14"  Stroke="{StaticResource BlendScrollingButtonPathFill}" Fill="{StaticResource BlendScrollingButtonPathFill}" Name="PART_Path2" >
                            <Path.RenderTransform>
                              <RotateTransform Angle="180"/>
                            </Path.RenderTransform>
                          </Path>
                        </Canvas>
                      </RepeatButton.Content>
                    </RepeatButton>
                    <RepeatButton Name="PART_NextTab" Height="{TemplateBinding ActualHeight}"
                                  Style="{StaticResource DefaultRepeatButtonStyle}"
                                  Command="Syncfusion:SidePanel.NextCommand"
                          Width="15" Background="{TemplateBinding Background}">
                      <RepeatButton.Content>
                        <Canvas Height="{TemplateBinding ActualHeight}">
                          <Path Data="M4,0L8,3.5 4,7" Canvas.Left="0" Canvas.Top="7"  Stroke="{StaticResource BlendScrollingButtonPathFill}" Fill="{StaticResource BlendScrollingButtonPathFill}" Name="PART_Path3" >
                          </Path>
                        </Canvas>
                      </RepeatButton.Content>
                    </RepeatButton>
                    <RepeatButton Name="PART_EndPage" Height="{TemplateBinding ActualHeight}"
                                  Style="{StaticResource DefaultRepeatButtonStyle}"
                                  Command="Syncfusion:SidePanel.EndPageCommand"
                          Width="15" Background="{TemplateBinding Background}">
                      <RepeatButton.Content>
