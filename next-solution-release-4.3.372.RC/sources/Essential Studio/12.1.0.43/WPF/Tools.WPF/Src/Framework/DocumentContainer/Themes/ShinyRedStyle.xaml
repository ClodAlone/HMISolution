    <Style x:Key="HeaderThemedCloseButtonStyle" TargetType="{x:Type Button}"
            BasedOn="{StaticResource HeaderClassicButtonStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Blue.HeaderCloseButtonInactiveBorderBrush}"/>
        <Setter Property="Background" Value="{StaticResource Office2007Blue.HeaderCloseButtonInactiveBackground}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Blue.HeaderCloseButtonActiveBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource Office2007Blue.HeaderCloseButtonActiveBackground}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Blue.HeaderCloseButtonHighlightBorderBrush}"/>
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="True" />
                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Office2007Blue.HeaderCloseButtonActiveHighlightBackground}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MDIWindow}}}" Value="False" />
                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Office2007Blue.HeaderCloseButtonInactiveHighlightBackground}"/>
            </MultiDataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Office2007Blue.HeaderCloseButtonPressedBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

