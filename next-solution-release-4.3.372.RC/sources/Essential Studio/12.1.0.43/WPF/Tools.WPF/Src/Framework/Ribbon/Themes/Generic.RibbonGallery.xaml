    <!--InRibbon Gallery template-->
    <ControlTemplate x:Key="InRibbonGalleryTemplate.Office2007Blue" TargetType="{x:Type local:RibbonGallery}">
        <Border BorderThickness="1"
            CornerRadius="2"
            Background="{TemplateBinding Background}"
            BorderBrush="{StaticResource Blue.Ribbon.BorderBrush}"
            Height="{TemplateBinding Height}"
            MaxHeight="62">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Button Name="PART_ScrollUpButton"
                        Grid.Row="0"
                        Style="{StaticResource GalleryRepeatButtonStyle.Office2007Blue}">
                        <Path Data="M3.5,0L0,4 7,4z" Fill="{StaticResource Blue.Path.Fill}"/>
                    </Button>

                    <Button Name="PART_ScrollDownButton"
                        Grid.Row="1"
                        Style="{StaticResource GalleryRepeatButtonStyle.Office2007Blue}">
                        <Path Data="M0,0L3.5,4 7,0z" Fill="{StaticResource Blue.Path.Fill}" />
                    </Button>

                    <Border Grid.Row="2"
                  Name="PART_ToggleButton"
                  Width="16"
                  Height="20.5"
                  Background="{StaticResource Blue.Gallery.RepeatButton.Background}"
                  BorderBrush="{StaticResource Blue.Ribbon.BorderBrush}"                
                  BorderThickness="1"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border BorderBrush="{StaticResource Blue.CheckBoxBackground}" Padding="2.5,4,2.5,3"
                    BorderThickness="1">
                            <StackPanel>
                                <Path Margin="0,0,0,2" Data="M0,0.5L7,0.5" Stroke="{StaticResource Blue.Path.Fill}" />
                                <Path Data="M0,0L3.5,4 7,0z" Fill="{StaticResource Blue.Path.Fill}"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <local:InRibbonItemsPresenter Name="PART_ScrollPresenter" ClipToBounds="True"/>
                
                <Popup Name="PART_Popup"
               Placement="Custom"
               Focusable="False"
    
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonGallery}}}">

                    <mwt:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="True">
                        <Border Background="{StaticResource Default.QuickDropDownBackground}"
                    BorderThickness="1"
                    CornerRadius="2"
                    BorderBrush="{StaticResource Default.QuickDropDownBorderBrush}">

                            <DockPanel SnapsToDevicePixels="True">

                                <Border Name="PART_ThumbBorder"
                        DockPanel.Dock="Bottom"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#DDE7EE"
                        Background="{StaticResource Blue.Gallery.Bottom.Background}">
                                    <local:PopupResizeThumb  Name="PART_ResizeThumb"/>
                                </Border>

                                <local:GalleryFilterSelector DockPanel.Dock="Top"/>

                                <Grid DockPanel.Dock="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition MinHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ScrollViewer Name="PART_ScrollViewer" Grid.Row="0">
                                        <StackPanel>
                                            <ItemsControl Name="PART_PopupItemsControl">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel
                              IsItemsHost="True"
                              ItemWidth="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemWidth}"
                              ItemHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <local:RibbonMenuGroup Visibility="{TemplateBinding MenuItems, Converter={StaticResource CountToVisibilityConverter}}"
                    Grid.Row="1" IconBarEnabled="{TemplateBinding MenuIconBarEnabled}"
                    ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=MenuItems}"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </mwt:SystemDropShadowChrome>
                </Popup>
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
            </Trigger>

            <Trigger SourceName="PART_ToggleButton"  Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_ToggleButton"  Property="BorderBrush" Value="{StaticResource Default.HoverBorderBrush}"/>
                <Setter TargetName="PART_ToggleButton"
                Property="Background" Value="{StaticResource GalleryRepeatButton.IsMouseOver.BackgroundBrush}"/>
            </Trigger>
          
            <Trigger Property="HasGroups" Value="True">
                <Setter TargetName="PART_PopupItemsControl" Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <local:GalleryGroupPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            

            <Trigger Property="ResizeDirection" Value="HorizontalAndVertical">
                <Setter TargetName="PART_Popup" Property="Width"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=HorizontalOffset}"/>
                <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=VerticalOffset}"/>
            </Trigger>

            <Trigger Property="ResizeDirection" Value="VerticalOnly">
                <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay,  Path=VerticalOffset}"/>
            </Trigger>

            <Trigger Property="PopupPosition" Value="Above">
                <Setter TargetName="PART_ThumbBorder" Property="DockPanel.Dock" Value="Top"/>
                <Setter TargetName="PART_ScrollViewer"   Property="DockPanel.Dock" Value="Bottom"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

