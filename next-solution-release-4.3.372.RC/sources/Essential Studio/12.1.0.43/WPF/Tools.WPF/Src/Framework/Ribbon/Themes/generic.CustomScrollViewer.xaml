                                            <Setter Property="Panel.Background" TargetName="MenuScrollButtonBorder" Value="{StaticResource AppMenuBackgroundBrush.ShinyBlue}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </RepeatButton.Style>
                <Path Data="M0,4L3.5,0 7,4z" Fill="{StaticResource TextBrushKey.ShinyBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </RepeatButton>
            <RepeatButton x:Name="PART_BottomButton" CommandTarget="{x:Null}" Visibility="Visible" Focusable="False" Command="ScrollBar.LineDownCommand" Grid.Column="0" Grid.Row="2">
                <RepeatButton.Style>
                    <Style TargetType="{x:Type RepeatButton}">
                        <Setter Property="ButtonBase.ClickMode" Value="Hover"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                    <Border Margin="1,1,1,1" BorderBrush="{StaticResource NormalBorderBrushKey.ShinyBlue}" CornerRadius="1,1,1,1" BorderThickness="1,1,1,1" Name="MenuScrollButtonBorder" Background="{StaticResource RibbonBarHeader.ShinyBlue}">
                                        <ContentPresenter Margin="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Center" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Content="{TemplateBinding ContentControl.Content}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="ButtonBase.IsPressed" Value="True">
                                            <Setter Property="Border.BorderBrush" TargetName="MenuScrollButtonBorder" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}" />
                                            <Setter Property="Panel.Background" TargetName="MenuScrollButtonBorder" Value="{StaticResource AppMenuBackgroundBrush.ShinyBlue}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </RepeatButton.Style>
                <Path Data="M0,0L3.5,4 7,0z" Fill="{StaticResource TextBrushKey.ShinyBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </RepeatButton>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Collapsed">
                <Setter TargetName="PART_BottomButton" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="PART_TopButton" Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="CustomScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
		<Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
		<Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
		<Setter Property="Control.Template" Value="{StaticResource ScrollViewerTemplate.Office2007Blue}"/>
