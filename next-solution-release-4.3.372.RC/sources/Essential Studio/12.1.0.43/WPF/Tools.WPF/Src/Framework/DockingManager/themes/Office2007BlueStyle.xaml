						      Value="Default" />-->
                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource FindAncestor
									, AncestorType={x:Type Syncfusion:DockedElementTabbedHost}}}"
								Value="True" />
                    <Condition Binding="{Binding Path=(Syncfusion:DockingManager.DockingManager).(Syncfusion:DockingManager.IsEnableHotTracking),
							RelativeSource={RelativeSource TemplatedParent}}"
