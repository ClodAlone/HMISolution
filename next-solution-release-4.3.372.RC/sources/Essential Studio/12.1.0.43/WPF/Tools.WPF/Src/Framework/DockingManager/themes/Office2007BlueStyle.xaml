						Value="{Binding Path=(Syncfusion:DockingManager.DockingManager).(Syncfusion:DockingManager.HeaderForeground),
							RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>            
            <DataTrigger Binding="{Binding Path=IsTemplateParenKeyboardFocusWithin, RelativeSource={RelativeSource Self}}"
						Value="True">
                <Setter TargetName="PART_ContentPresenter" Property="TextBlock.Foreground" 
						Value="{Binding Path=(Syncfusion:DockingManager.DockingManager).(Syncfusion:DockingManager.HeaderForegroundSelected),
							RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="borderTop" Property="Background" 
						Value="{Binding Path=(Syncfusion:DockingManager.DockingManager).(Syncfusion:DockingManager.SelectedHeaderBackground),
							RelativeSource={RelativeSource TemplatedParent}}" />

                <Setter TargetName="PART_AwlButton" Property="Foreground" 
						Value="{Binding Path=(Syncfusion:DockingManager.DockingManager).(Syncfusion:DockingManager.HeaderForegroundSelected),
							RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="PART_ContextMenuButton" Property="Foreground" 
						Value="{Binding Path=(Syncfusion:DockingManager.DockingManager).(Syncfusion:DockingManager.HeaderForegroundSelected),
							RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="PART_CloseButton" Property="Foreground" 
						Value="{Binding Path=(Syncfusion:DockingManager.DockingManager).(Syncfusion:DockingManager.HeaderForegroundSelected),
							RelativeSource={RelativeSource TemplatedParent}}" />

