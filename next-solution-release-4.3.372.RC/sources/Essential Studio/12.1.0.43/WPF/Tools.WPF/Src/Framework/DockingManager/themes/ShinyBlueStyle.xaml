                <Setter TargetName="PART_BorderSeparator" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="Visibility" SourceName="PART_ScrollButtons" Value="Collapsed">
                <Setter Property="Canvas.Left" TargetName="PART_BorderName" Value="0"/>
