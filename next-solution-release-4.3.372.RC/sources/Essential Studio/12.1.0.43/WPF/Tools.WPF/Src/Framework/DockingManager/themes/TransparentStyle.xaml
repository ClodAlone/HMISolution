        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Syncfusion:CustomContextMenu}">    
                    <Grid Margin="0,0,5,5">
                        <Border Background="{StaticResource TransparentContextMenuBackgroundBrush}" CornerRadius="0"
