						, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:NativeFloatWindow}}}" 
					Value="True" >
                            <Setter TargetName="contentWraper" Property="Visibility" Value="Hidden"/>
                        </DataTrigger>
