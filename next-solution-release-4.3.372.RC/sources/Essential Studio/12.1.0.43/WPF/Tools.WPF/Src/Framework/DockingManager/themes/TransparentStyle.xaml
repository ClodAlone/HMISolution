                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_ContextMenu" Property="IsEnabledHiddenMenuItem" Value="False" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
