<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
	xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
	xmlns:diagnostics="clr-namespace:System.Diagnostics;assembly=WindowsBase"
	>

    <ResourceDictionary.MergedDictionaries>

       
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/DocumentContainer/Themes/Brushes.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/DocumentContainer/Themes/Resources/ButtonsBrushes.xaml"/>      

    </ResourceDictionary.MergedDictionaries>
    
    <local:ParentToBoolConverter x:Key="ParentToBool" />
    <local:TestConverter x:Key="TestConverter" />
	
	<ControlTemplate x:Key="ListBoxItemTemplate" TargetType="{x:Type ListBoxItem}">
		<Border Name="WrappBorder" Padding="2" SnapsToDevicePixels="True"
				BorderBrush="{Binding Path=ItemBorderBrush, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}"
				BorderThickness="{Binding Path=ItemBorderThickness, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}"
				CornerRadius="{Binding Path=ItemCornerRadius, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}"
				Background="#00FFFFFF"
				Margin="2"
				>
			<StackPanel Orientation="Horizontal" >
				<Border Name="IconBorder" Background="{Binding Path=(local:DocumentContainer.Icon), Converter={StaticResource TestConverter}}" Margin="1" Width="16"/>
				<ContentPresenter Content="{Binding Path=(local:DocumentContainer.Header)}" Name="content"
								  ContentTemplate="{Binding Path=(FrameworkElement.DataContext).(local:DocumentContainer.HeaderTemplate)
										, ElementName=WrappBorder}"
								  TextBlock.Foreground="{TemplateBinding Foreground}"/>
			</StackPanel>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="WrappBorder" Property="BorderBrush" Value="#FF909CA5" />
				<Setter TargetName="WrappBorder" Property="Background" Value="#FFC0D3E5" />
				<Setter TargetName="WrappBorder" Property="BorderThickness"
						Value="1"/>
			</Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="TextBlock.Foreground" Value="Black" TargetName="content"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="TextBlock.Foreground" Value="Black" TargetName="content"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyRed"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="WrappBorder" Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}" />
                <Setter TargetName="WrappBorder" Property="Background" Value="{StaticResource SelectedBrushKey.ShinyRed}" />
                <Setter TargetName="WrappBorder" Property="BorderThickness"
						Value="1"/>
                <Setter TargetName="content" Property="TextBlock.Foreground" Value="Black"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="WrappBorder" Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}" />
                <Setter TargetName="WrappBorder" Property="Background" Value="{StaticResource SelectedBrushKey.ShinyBlue}" />
                <Setter TargetName="WrappBorder" Property="BorderThickness"
						Value="1"/>
                <Setter TargetName="content" Property="TextBlock.Foreground" Value="Black"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="SyncOrange"/>
                    <Condition Property="IsMouseOver" Value="True"/>                    
                </MultiTrigger.Conditions>
                <Setter TargetName="WrappBorder" Property="BorderBrush" Value="#FFF3B766" />
                <Setter TargetName="WrappBorder" Property="Background" Value="#FF5F1A11" />
                <Setter TargetName="WrappBorder" Property="BorderThickness"
						Value="1"/>
                <Setter TargetName="content" Property="TextBlock.Foreground" Value="#FFFFFFFF"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="SyncOrange"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="WrappBorder" Property="BorderBrush" Value="Transparent" />
                <Setter TargetName="WrappBorder" Property="Background" Value="Transparent" />
                <Setter TargetName="WrappBorder" Property="BorderThickness"
						Value="1"/>
                <Setter TargetName="content" Property="TextBlock.Foreground" Value="#FFFFFFFF"/>
            </MultiTrigger>
         

            <Trigger Property="IsSelected" Value="True">
				<Setter TargetName="WrappBorder" Property="BorderBrush"
						Value="{Binding Path=SelectedItemBorderBrush, RelativeSource={RelativeSource FindAncestor
							, AncestorType={x:Type local:ListSwicthPreviewControl}}}"/>
				<Setter TargetName="WrappBorder" Property="BorderThickness"
						Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource FindAncestor
							, AncestorType={x:Type local:ListSwicthPreviewControl}}
							}"/>
				
				<Setter TargetName="WrappBorder" Property="Background"
						Value="{Binding Path=SelectedItemBackground, RelativeSource={RelativeSource FindAncestor
							, AncestorType={x:Type local:ListSwicthPreviewControl}}}"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
    
    <ControlTemplate x:Key="ListBoxItemTemplate.ShinyRed" TargetType="{x:Type ListBoxItem}">
        <ControlTemplate.Resources>
            <Storyboard x:Key="HoverOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="HoverRectangle" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="HoverOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="HoverRectangle" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="SelectedOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="SelectedRectangle" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="SelectedOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="SelectedRectangle" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ControlTemplate.Resources>
        <Grid Background="{TemplateBinding Background}"
						Margin="1,1,1,1" SnapsToDevicePixels="true" x:Name="grid">
            <Border x:Name="Background"
							IsHitTestVisible="False"
							Background="{StaticResource SelectedBrushKey.ShinyBlue}"
							BorderBrush="{Binding Path=ItemBorderBrush, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}"
				BorderThickness="{Binding Path=ItemBorderThickness, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}"
				CornerRadius="{Binding Path=ItemCornerRadius, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}">
                <StackPanel Orientation="Horizontal" >
                    <Border Name="IconBorder" Background="{Binding Path=(local:DocumentContainer.Icon), Converter={StaticResource TestConverter}}" Margin="1" Width="16"/>
                    <ContentPresenter Content="{Binding Path=(local:DocumentContainer.Header)}" Name="content"
								  ContentTemplate="{Binding Path=(FrameworkElement.DataContext).(local:DocumentContainer.HeaderTemplate)
										, ElementName=Background}"
								  TextBlock.Foreground="Black"/>
                </StackPanel>
            </Border>
            <Border x:Name="SelectedRectangle"
							IsHitTestVisible="False"
							Opacity="0"
							Background="{StaticResource NormalBackgroundBrushKey.ShinyRed}"
							BorderBrush="{Binding Path=ItemBorderBrush, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}"
				BorderThickness="{Binding Path=ItemBorderThickness, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}"
				CornerRadius="{Binding Path=ItemCornerRadius, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}">
                <StackPanel Orientation="Horizontal" >
                    <Border Name="IconBorder1" Background="{Binding Path=(local:DocumentContainer.Icon), Converter={StaticResource TestConverter}}" Margin="1" Width="16"/>
                    <ContentPresenter Content="{Binding Path=(local:DocumentContainer.Header)}" Name="content1"
								  ContentTemplate="{Binding Path=(FrameworkElement.DataContext).(local:DocumentContainer.HeaderTemplate)
										, ElementName=SelectedRectangle}"
								  TextBlock.Foreground="Black"/>
                </StackPanel>
            </Border>
            <Border x:Name="HoverRectangle"
							IsHitTestVisible="False"
							Background="{StaticResource HighlightBrushKey.ShinyRed}"
							BorderBrush="{Binding Path=ItemBorderBrush, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}"
				BorderThickness="{Binding Path=ItemBorderThickness, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}"
				CornerRadius="{Binding Path=ItemCornerRadius, RelativeSource={RelativeSource FindAncestor
					, AncestorType={x:Type local:ListSwicthPreviewControl}}}"
							Opacity="0">
            <StackPanel Orientation="Horizontal" >
                <Border Name="IconBorder11" Background="{Binding Path=(local:DocumentContainer.Icon), Converter={StaticResource TestConverter}}" Margin="1" Width="16"/>
                <ContentPresenter Content="{Binding Path=(local:DocumentContainer.Header)}" Name="content11"
								  ContentTemplate="{Binding Path=(FrameworkElement.DataContext).(local:DocumentContainer.HeaderTemplate)
										, ElementName=HoverRectangle}"
								  TextBlock.Foreground="Black"/>
                </StackPanel>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="true">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource SelectedOn}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource SelectedOff}"/>
                </Trigger.ExitActions>
                <Setter TargetName="Background" Property="BorderBrush"
						Value="{Binding Path=SelectedItemBorderBrush, RelativeSource={RelativeSource FindAncestor
							, AncestorType={x:Type local:ListSwicthPreviewControl}}}"/>
                <Setter TargetName="Background" Property="BorderThickness"
						Value="{Binding Path=SelectedItemBorderThickness, RelativeSource={RelativeSource FindAncestor
							, AncestorType={x:Type local:ListSwicthPreviewControl}}
							}"/>
                <!--, diagnostics:PresentationTraceSources.TraceLevel=High-->
                <Setter TargetName="Background" Property="Background"
						Value="{Binding Path=SelectedItemBackground, RelativeSource={RelativeSource FindAncestor
							, AncestorType={x:Type local:ListSwicthPreviewControl}}}"/>
            </Trigger>

           
        </ControlTemplate.Triggers>
    </ControlTemplate>

	<Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="OverridesDefaultStyle" Value="True"/>
	    <Setter Property="MinWidth" Value="30" />
		<Setter Property="MinHeight" Value="25" />
		<Setter Property="Background" Value="#00ffffff" />
		<Setter Property="Template" Value="{StaticResource ListBoxItemTemplate}" />
	</Style>


    <ControlTemplate x:Key="ListBoxTemplate" TargetType="{x:Type ListBox}" >
		<Border SnapsToDevicePixels="True" Name="bd" Padding="1,1,1,1" 
                BorderBrush="Gray" 
                BorderThickness="1">
			<ScrollViewer Padding="{TemplateBinding Control.Padding}" Focusable="False" >
				<DockPanel LastChildFill="True" >
                    <Border BorderThickness="1" Name="border" BorderBrush="Gray" DockPanel.Dock="Right">
					    <local:TrackContainer VerticalAlignment="Center">
						<shared:PreviewBorder Name="PART_PreviewBorder"
											  BorderBrush="#FF8F8B88" BorderThickness="1"
											  Width="75" Height="75" />
					</local:TrackContainer>
                    </Border>
					<ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
				</DockPanel>
			</ScrollViewer>
		</Border>
        <ControlTemplate.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="BorderBrush" TargetName="bd" Value="#FF6B2603"/>
                <Setter Property="BorderBrush" TargetName="border" Value="#FF6B2603"/>
                <Setter Property="BorderBrush" TargetName="PART_PreviewBorder" Value="#FF6B2603"/>
            </Trigger>
        </ControlTemplate.Triggers>  
	</ControlTemplate>

	<ControlTemplate x:Key="ListSwicthPreviewControlTemplate" TargetType="{x:Type local:ListSwicthPreviewControl}" >
		<Border Background="{TemplateBinding Background}"
				BorderBrush="{TemplateBinding BorderBrush}"
				BorderThickness="{TemplateBinding BorderThickness}"
			>
				<ListBox Name="PART_ListBox"
					Template="{StaticResource ListBoxTemplate}"
					ItemContainerStyle="{StaticResource ListBoxItemStyle}"
				/>
		</Border>
	</ControlTemplate>

	<Style x:Key="{x:Type local:ListSwicthPreviewControl}" TargetType="{x:Type local:ListSwicthPreviewControl}" >
		<Setter Property="BorderBrush" Value="{StaticResource Aero.MenuItemInactiveBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{StaticResource Aero.MenuItemInactiveBackground}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="ItemBorderBrush" Value="#00FFFFFF" />
        <Setter Property="ItemBorderThickness" Value="1" />
        <Setter Property="SelectedItemBorderBrush" Value="{StaticResource Aero.MenuItemActiveBorderBrush}" />
        <Setter Property="SelectedItemBorderThickness" Value="1" />
        <Setter Property="SelectedItemBackground" Value="{StaticResource Aero.MenuItemActiveBackground}" />
        <Setter Property="ItemCornerRadius" Value="0" />
        <Setter Property="ItemWidth" Value="0" />
        <Setter Property="ItemHeight" Value="0" />
        <Setter Property="MinWidth" Value="550" />
        <Setter Property="Template" Value="{StaticResource ListSwicthPreviewControlTemplate}" />
		<Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Blue.MenuItemInactiveBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource Office2007Blue.MenuItemInactiveBackground}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource Office2007Blue.MenuItemActiveBorderBrush}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource Office2007Blue.MenuItemActiveBackground}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Black.MenuItemInactiveBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource Office2007Black.MenuItemInactiveBackground}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource Office2007Black.MenuItemActiveBorderBrush}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource Office2007Black.MenuItemActiveBackground}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Silver.MenuItemInactiveBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource Office2007Silver.MenuItemInactiveBackground}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource Office2007Silver.MenuItemActiveBorderBrush}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource Office2007Silver.MenuItemActiveBackground}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="BorderBrush" Value="{StaticResource Office2007Silver.MenuItemInactiveBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource Office2003.MenuItemInactiveBackground}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource Office2007Silver.MenuItemInactiveBackground}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource Office2007Silver.MenuItemActiveBackground}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="BorderBrush" Value="{StaticResource Blend.MenuItemInactiveBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource Blend.MenuItemInactiveBackground}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource Blend.MenuItemActiveBorderBrush}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource Blend.MenuItemActiveBackground}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="SyncOrange">
                <Setter Property="BorderBrush" Value="{StaticResource MenuItemInactiveBorderBrush.Orange}" />
                <Setter Property="Background" Value="{StaticResource  MenuItemRightBarBrush.Orange}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource MenuBorderBrush.Orange}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource MenuItemHoverBrush.Orange}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="BorderBrush" Value="{StaticResource MenuBorderBrushKey.ShinyRed}" />
                <Setter Property="Background" Value="{StaticResource  MenuBackgroundBrushKey.ShinyRed}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource MenuBorderBrushKey.ShinyRed}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource NormalBackgroundBrushKey.ShinyRed}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="BorderBrush" Value="{StaticResource MenuBorderBrushKey.ShinyBlue}" />
                <Setter Property="Background" Value="{StaticResource  MenuBackgroundBrushKey.ShinyBlue}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource MenuBorderBrushKey.ShinyBlue}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}" />
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, 
						 AncestorType={x:Type Popup}}, Converter={StaticResource ParentToBool}}"  Value="True">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{StaticResource MenuBackgroundBrushKey.ShinyBlue}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource MenuBorderBrushKey.ShinyBlue}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, 
						 AncestorType={x:Type Popup}}, Converter={StaticResource ParentToBool}}"  Value="True"/>
                    <Condition Binding="{Binding Path=shared:SkinStorage.VisualStyle, RelativeSource={RelativeSource TemplatedParent}}" Value="Office2007Blue"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{StaticResource Office2007Blue.MenuItemActiveBackground}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource Office2007Blue.MenuItemActiveBorderBrush}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource Office2007Blue.MenuItemActiveBackground}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, 
						 AncestorType={x:Type Popup}}, Converter={StaticResource ParentToBool}}"  Value="True"/>
                    <Condition Binding="{Binding Path=shared:SkinStorage.VisualStyle, RelativeSource={RelativeSource TemplatedParent}}" Value="Office2007Black"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{StaticResource Office2007Black.MenuItemActiveBackground}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource Office2007Black.MenuItemActiveBorderBrush}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource Office2007Black.MenuItemActiveBackground}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, 
						 AncestorType={x:Type Popup}}, Converter={StaticResource ParentToBool}}"  Value="True"/>
                    <Condition Binding="{Binding Path=shared:SkinStorage.VisualStyle, RelativeSource={RelativeSource TemplatedParent}}" Value="Office2007Silver"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{StaticResource Office2007Silver.MenuItemActiveBackground}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource Office2007Silver.MenuItemActiveBorderBrush}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource Office2007Silver.MenuItemActiveBackground}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, 
						 AncestorType={x:Type Popup}}, Converter={StaticResource ParentToBool}}"  Value="True"/>
                    <Condition Binding="{Binding Path=shared:SkinStorage.VisualStyle, RelativeSource={RelativeSource TemplatedParent}}" Value="Office2003"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{StaticResource Office2003.MenuItemActiveBackground}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource Office2003.MenuItemActiveBorderBrush}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource Office2003.MenuItemActiveBackground}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, 
						 AncestorType={x:Type Popup}}, Converter={StaticResource ParentToBool}}"  Value="True"/>
                    <Condition Binding="{Binding Path=shared:SkinStorage.VisualStyle, RelativeSource={RelativeSource TemplatedParent}}" Value="Blend"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{StaticResource Blend.MenuItemActiveBackground}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource Blend.MenuItemActiveBorderBrush}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource Blend.MenuItemActiveBackground}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, 
						 AncestorType={x:Type Popup}}, Converter={StaticResource ParentToBool}}"  Value="True"/>
                    <Condition Binding="{Binding Path=shared:SkinStorage.VisualStyle, RelativeSource={RelativeSource TemplatedParent}}" Value="SyncOrange"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{StaticResource MenuItemBackground.Orange}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource MenuItemBorder.Orange}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource MenuItemOverBackground.Orange}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, 
						 AncestorType={x:Type Popup}}, Converter={StaticResource ParentToBool}}"  Value="True"/>
                    <Condition Binding="{Binding Path=shared:SkinStorage.VisualStyle, RelativeSource={RelativeSource TemplatedParent}}" Value="ShinyRed"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{StaticResource Office2007Blue.MenuItemInactiveBorderBrush}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource MenuBorderBrushKey.ShinyRed}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource NormalBackgroundBrushKey.ShinyRed}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, 
						 AncestorType={x:Type Popup}}, Converter={StaticResource ParentToBool}}"  Value="True"/>
                    <Condition Binding="{Binding Path=shared:SkinStorage.VisualStyle, RelativeSource={RelativeSource TemplatedParent}}" Value="ShinyBlue"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="{StaticResource Office2007Blue.MenuItemInactiveBorderBrush}" />
                <Setter Property="SelectedItemBorderBrush" Value="{StaticResource MenuBorderBrushKey.ShinyBlue}" />
                <Setter Property="SelectedItemBackground" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}" />
            </MultiDataTrigger>
        </Style.Triggers>
	</Style>

    

</ResourceDictionary>
