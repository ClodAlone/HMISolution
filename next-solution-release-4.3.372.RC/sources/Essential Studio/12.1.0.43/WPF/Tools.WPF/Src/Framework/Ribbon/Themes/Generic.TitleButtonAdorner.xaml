    <local:CorrectingBrushConverter x:Key="correctingBrushConverter"/>

    <ControlTemplate x:Key="Office2007BlueTitleButtonAdornerTemplate" TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
        <Border Background="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TitleButtonAdorner}}, Converter={StaticResource correctingBrushConverter}, Path=Color, Mode=OneWay}">
            <Border Name="PART_Border"  CornerRadius="3"  
                    Height="{TemplateBinding Height}"                  
                    Width="{TemplateBinding Width}">
                <ContentPresenter IsHitTestVisible="False" Content="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TitleButtonAdorner}}, Path=Content}"/>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_Border" Property="BorderThickness" Value="1" />
                <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Blue.TitleBarButton.BorderBrushHover}" />
                <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Blue.TitleBarButton.BackgroundHover}" />
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TitleButtonAdorner}}, Path=IsPressed}" Value="True">
                <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Blue.TitleBarButton.BackgroundPressed}"/>
                <Setter TargetName="PART_Border" Property="BorderThickness" Value="1" />
                <Setter TargetName="PART_Border" Property="BorderBrush" Value="{StaticResource Blue.TitleBarButton.BorderBrushPressed}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
