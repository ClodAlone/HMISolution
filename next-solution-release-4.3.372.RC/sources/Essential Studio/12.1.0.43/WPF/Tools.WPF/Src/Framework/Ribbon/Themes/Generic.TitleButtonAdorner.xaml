    <Style x:Key="{x:Type local:TitleButtonAdorner}" TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
    <Setter Property="Height" Value="25"/>
    <Setter Property="Width" Value="25"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template" Value="{StaticResource Office2007BlueTitleButtonAdornerTemplate}"/>        
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Template" Value="{StaticResource Office2007BlackTitleButtonAdornerTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Template" Value="{StaticResource Office2007SilverTitleButtonAdornerTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Template" Value="{StaticResource Office2003TitleButtonAdornerTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Template" Value="{StaticResource BlendTitleButtonAdornerTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Template" Value="{StaticResource TitleButtonAdornerTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Template" Value="{StaticResource TitleButtonAdornerTemplate.ShinyBlue}"/>
            </Trigger>           
        </Style.Triggers>
       
  </Style>
  
</ResourceDictionary>
    
  