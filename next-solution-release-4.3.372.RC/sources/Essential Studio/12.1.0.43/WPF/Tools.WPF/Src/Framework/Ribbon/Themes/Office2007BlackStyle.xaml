    <Style x:Key="Office2007BlackSplitMenuButtonStyle" TargetType="{x:Type local:SplitMenuButton}">
        <!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
        <Setter Property="Padding" Value="1"/>
        <Setter Property="SmallIcon" Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/WordArt16.png"/>
        <!--<Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>-->
        <!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{StaticResource SkinDictionary}"/>-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SplitMenuButton}">
                    <Border	BorderThickness="{TemplateBinding BorderThickness}"
							BorderBrush="{TemplateBinding BorderBrush}"
							Background="{TemplateBinding Background}" 	Margin="{TemplateBinding Padding}"	
							HorizontalAlignment="Stretch"			
							Opacity="{TemplateBinding Opacity}"
							IsEnabled="{TemplateBinding IsEnabled}">
                        <Grid HorizontalAlignment="Stretch">
                            <DockPanel HorizontalAlignment="Stretch" LastChildFill="True" >
                                <Border Name="PART_ToggleButton"
										MinWidth="24"					
										DockPanel.Dock="Right"
										Background="Transparent"
										BorderThickness="0,1,1,1"
										BorderBrush="{TemplateBinding BorderBrush}">
                                    <Border x:Name="PART_TogleButtonInnerBorder" BorderThickness="1">
                                        <Path Fill="{StaticResource Black.Foreground}" Margin="5,16,0,0"
												  HorizontalAlignment="Center"
												  VerticalAlignment="Center"
												  Data="M 0 0 L 4 4 L 8 0 Z">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="-90"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                </Border>
                                <Border x:Name="PART_OutterBorder" BorderThickness="1" HorizontalAlignment="Stretch" DockPanel.Dock="Left">
                                    <Border x:Name="PART_InnerBorder" BorderThickness="1" Background="Transparent">
                                        <WrapPanel
											  Orientation="Horizontal"
											  VerticalAlignment="Center"
											  HorizontalAlignment="Left"
											  Margin="1">
                                            <Image Margin="5,3,5,3" Grid.Row="0" x:Name="PART_Image"
													Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}"
													Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}"
												   MinHeight="16" MinWidth="16" 
												   Source="{Binding Path=Icon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
												   />

                                            <TextBlock Margin="0,0,7,0" Name="label"
													   TextWrapping="Wrap"
													   TextAlignment="Center"
													   Foreground="{StaticResource Black.Foreground}"
													   VerticalAlignment="Center"
													   HorizontalAlignment="Center"
													   Text="{TemplateBinding Label}"/>
                                        </WrapPanel>
                                    </Border>
                                </Border>
                            </DockPanel>
                            <local:CustomPopup x:Name="PART_Popup"
								  Placement="Custom"
								  PlacementTarget ="{Binding Path=PlacementBorder, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ApplicationMenu}}}"
								  Focusable="False"
								  PopupAnimation="Fade"
                                               
								  AllowsTransparency="True"
								  StaysOpen="True"
								  IsOpen="{Binding Path=IsMenuOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="true">
                                    <Border Background="{StaticResource Default.SimpleMenuPopupBrush}" BorderThickness="1" CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}" BorderBrush="{StaticResource Default.QuickDropDownBorderBrush}">
                                        <ScrollViewer x:Name="PART_ScrollViwer" Margin="0,0,0,-5" Style="{StaticResource CustomScrollViewerStyle}">
                                            <ItemsPresenter
											  Margin="0,0,0,5"
											  HorizontalAlignment="Stretch"
											  VerticalAlignment="Stretch"
											  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </local:CustomPopup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,4,4"/>
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="PART_ToggleButton"  Property="Background" Value="{StaticResource MenuButton.MouseOverBrush}"/>
                            <Setter TargetName="PART_ToggleButton"  Property="BorderBrush" Value="{StaticResource MenuButton.OutterBorderBrush}"/>
                            <Setter TargetName="PART_OutterBorder"  Property="Background" Value="{StaticResource IsDropDownOpenBrush}"/>
                            <Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.OutterBorderBrush}"/>
                            <Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.InnerBorderBrush}"/>
                            <Setter TargetName="PART_TogleButtonInnerBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.InnerBorderBrush}"/>
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Black.Foreground}"/>
                        </Trigger>

                        <Trigger Property="IsMenuOpen" Value="True">
                            <Setter TargetName="PART_ToggleButton"  Property="Background" Value="{StaticResource MenuButton.MouseOverBrush}"/>
                            <Setter TargetName="PART_ToggleButton"  Property="BorderBrush" Value="{StaticResource MenuButton.OutterBorderBrush}"/>
                            <Setter TargetName="PART_OutterBorder"  Property="Background" Value="{StaticResource IsDropDownOpenBrush}"/>
                            <Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.OutterBorderBrush}"/>
                            <Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.InnerBorderBrush}"/>
                            <Setter TargetName="PART_TogleButtonInnerBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.InnerBorderBrush}"/>
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Black.Foreground}"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_ToggleButton"  Property="Background" Value="{StaticResource MenuButton.MouseOverBrush}"/>
                            <Setter TargetName="PART_ToggleButton"  Property="BorderBrush" Value="{StaticResource MenuButton.OutterBorderBrush}"/>
                            <Setter TargetName="PART_OutterBorder"  Property="Background" Value="{StaticResource IsDropDownOpenBrush}"/>
                            <Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.OutterBorderBrush}"/>
                            <Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.InnerBorderBrush}"/>
                            <Setter TargetName="PART_TogleButtonInnerBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.InnerBorderBrush}"/>
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Black.Foreground}"/>
                        </Trigger>

                        <Trigger SourceName="PART_OutterBorder"  Property="IsMouseOver" Value="True">
                            <!--<Setter Property="CanCommandExecute" Value="True"/>-->
                            <Setter TargetName="PART_ToggleButton"  Property="BorderBrush" Value="{StaticResource MenuButton.OutterBorderBrush}"/>
                            <Setter TargetName="PART_ToggleButton"  Property="Background" Value="{StaticResource MenuButton.MouseOverBrush}"/>
                            <Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.OutterBorderBrush}"/>
                            <Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.InnerBorderBrush}"/>
                            <Setter TargetName="PART_InnerBorder"  Property="Background" Value="{StaticResource MenuButton.MouseOverBrush}"/>
                            <Setter TargetName="PART_TogleButtonInnerBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.InnerBorderBrush}"/>
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Black.Foreground}"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="Padding" Value="10" />
                            <Setter Property="Height" TargetName="PART_Image" Value="20"/>
                            <Setter Property="Width" TargetName="PART_Image" Value="20"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

