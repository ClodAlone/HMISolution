                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <local:DropDownButton Name="PART_PopupButtonOverflowed"   Style="{StaticResource QuickAccessPopupButtonStyle}"
												Visibility="{TemplateBinding QATDropDownVisiblity}">
                                <local:DropDownButton.PathGeometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="4,7" EndPoint="9,7"/>
                                        <PathGeometry>
                                            <PathFigure StartPoint="5,10" IsFilled="True" IsClosed="True">
                                                <LineSegment Point="8,10"/>
                                                <LineSegment Point="6.5,12.5"/>
                                            </PathFigure>

                                        </PathGeometry>
                                    </GeometryGroup>
                                </local:DropDownButton.PathGeometry>

                                <Border BorderThickness="0.5" BorderBrush="Gray" Padding="2" Width="220">
                                    <Grid>
                                        <DockPanel>
                                            <Border HorizontalAlignment="Left"  DockPanel.Dock="Left" Width="25" Background="{StaticResource Black.QATContextMenu.LeftBar.Backgound}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Black.QATContextMenu.BorderBrush}" />
                                        </DockPanel>
                                        <StackPanel>

                                            <Border Background="{StaticResource Black.QATContextMenu.TopBar.Backgound}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Black.QATContextMenu.BorderBrush}" Margin="0,0,0,1" Height="22">
                                                <TextBlock x:Uid="CustomizeQATTextBlock" Margin="3,0,0,0"  Foreground="{StaticResource Black.QATContextMenu.Foreground}" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=CustomizeQAT}" FontWeight="Bold" VerticalAlignment="Center" />
                                            </Border>
                                            <ItemsControl Name="PART_QATMenuOverFlow" ItemContainerStyle="{StaticResource RibbonButtonPopupItemStyle}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                            <Separator Name="TopSeperatorOverFlow" Visibility="Collapsed" Background="{StaticResource Default.QuickDropDownSeparator}" Margin="{StaticResource Default.QuickDropDownMargin}" Height="2"></Separator>
                                            <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATMoreCommands}" Command="local:RibbonCommands.QATMoreCommands" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=EnableMoreCommands, Converter={StaticResource BooleanToVisibilityConverter}}"  Foreground="{StaticResource Black.Foreground}"/>
                                            <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle}" Visibility="{Binding ElementName=PART_AboveButton, Path=Visibility, Mode=TwoWay}"  Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove" Foreground="{StaticResource Black.Foreground}"/>
                                            <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle}" Visibility="{Binding ElementName=PART_BelowButton, Path=Visibility, Mode=TwoWay}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}" Command="local:RibbonCommands.PlaceQATBelow" Foreground="{StaticResource Black.Foreground}"/>
                                            <Separator Background="{StaticResource Default.QuickDropDownSeparator}" Margin="{StaticResource Default.QuickDropDownMargin}" Height="2"></Separator>
                                            <local:RibbonButton  IsSelected="{Binding ElementName=PART_MinimizeButton, Path=IsSelected, Mode=TwoWay}"   Command="local:RibbonCommands.MinimizeRibbon"  Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path= MinimizeRibbon}" IsToggle="True" Foreground="{StaticResource Black.Foreground}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </local:DropDownButton>
                        </StackPanel>
                    </local:DropDownButton>

                </Grid>
            </local:TwoItemsLayoutPanelEx>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="HasOverflowChildren" Value="True">
                <Setter TargetName="PART_PopupButton" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="PART_OverflowButton" Property="Visibility" Value="Visible"/>
            </Trigger>

            <Trigger Property="HasItems" Value="True"  SourceName="PART_QATMenu">
                <Setter Property="Visibility" TargetName="TopSeperator" Value="Visible" />
            </Trigger>
            <Trigger Property="HasItems" Value="True"  SourceName="PART_QATMenuOverFlow">
                <Setter Property="Visibility" TargetName="TopSeperatorOverFlow" Value="Visible" />
            </Trigger>

            <Trigger Property="HasGeometry" Value="False">
                <Setter TargetName="PART_AboveButton" Property="Visibility" Value="Visible"/>
                <Setter TargetName="PART_BelowButton" Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--QuickAccessToolBar style-->
    <Style x:Key="Office2007BlackQuickAccessToolBarStyle" TargetType="{x:Type local:QuickAccessToolBar}">
        <!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="GeometryBackground" Value="{StaticResource Black.QuickAccessActiveBrush}"/>
        <Setter Property="GeometryStroke" Value="{StaticResource Black.ActiveGeometryStroke}"/>
        <!--<Setter Property="Control.FontSize" Value="11"/>
        <Setter Property="Control.FontFamily" Value="Calibri"/>-->
        <Setter Property="Control.Foreground" Value="{StaticResource Black.Foreground}"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template" Value="{StaticResource QuickAccessToolBarTemplate}"/>
        
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}}}" Value="False">
                <Setter Property="GeometryBackground" Value="{StaticResource Black.QuickAccessNotActiveBrush}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource Black.GeometryStroke}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}"
                     Value="True">
                <Setter Property="GeometryBackground" Value="Transparent"/>
                <!--<Setter Property="GeometryStroke" Value="#FF9BA4B1"/>-->
            </DataTrigger>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="FrameworkElement.Height" Value="40" />
            </Trigger>
        </Style.Triggers>
    </Style>


