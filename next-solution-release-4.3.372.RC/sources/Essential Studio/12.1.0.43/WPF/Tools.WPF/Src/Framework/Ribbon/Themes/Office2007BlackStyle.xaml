                                                                            </Trigger>
                                                                            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                                                                <Setter Property="FontSize" Value="18"/>
                                                                                <Setter Property="Padding" Value="16,9,16,9"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>

                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Default.QuickDropDownButtonHoverBorder}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Resources>
                                                </StackPanel>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <Separator Name="TopSeperator" Visibility="Collapsed" Background="{StaticResource Default.QuickDropDownSeparator}" Margin ="30,0,0,0"  Height="2"></Separator>
                                    <local:RibbonButton Name="PART_MoreCommands"  Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATMoreCommands}" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=EnableMoreCommands, Converter={StaticResource BooleanToVisibilityConverter}}"  Command="local:RibbonCommands.QATMoreCommands" Foreground="{StaticResource Black.Foreground}" Width="auto"/>
                                    <local:RibbonButton Name="PART_AboveButton" Visibility="Collapsed"  Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove" Foreground="{StaticResource Black.Foreground}" Width="auto"/>
                                    <local:RibbonButton Name="PART_BelowButton" Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}"  Command="local:RibbonCommands.PlaceQATBelow" Foreground="{StaticResource Black.Foreground}" Width="auto"/>
                                    <Separator Background="{StaticResource Default.QuickDropDownSeparator}" Margin ="30,0,0,0"  Height="2"></Separator>
                                    <local:RibbonButton Name="PART_MinimizeButton"  Style="{StaticResource RibbonButtonPopupItemStyle}"  Command="local:RibbonCommands.MinimizeRibbon"  Label="{Binding Source={StaticResource ResourceWrapperKey}, Path= MinimizeRibbon}" IsToggle="True" Foreground="{StaticResource Black.Foreground}" Width="auto"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </local:DropDownButton>

                    <local:DropDownButton  
            Grid.Column="1"
            Name="PART_OverflowButton"
            Style="{StaticResource QuickAccessPopupButtonStyle}"                           
            Visibility="Collapsed" 
            DockPanel.Dock="Right">
                        <local:DropDownButton.PathGeometry>
                            <GeometryGroup>
                                <PathGeometry>
                                    <PathFigure StartPoint="3.5,8" IsFilled="True" IsClosed="True">
                                        <LineSegment Point="4.5,9"/>
                                        <LineSegment Point="3.5,10"/>
                                    </PathFigure>
                                </PathGeometry>

                                <PathGeometry>
                                    <PathFigure StartPoint="7.5,8" IsFilled="True" IsClosed="True">
                                        <LineSegment Point="8.5,9"/>
                                        <LineSegment Point="7.5,10"/>
                                    </PathFigure>
                                </PathGeometry>

                            </GeometryGroup>
                        </local:DropDownButton.PathGeometry>

                        <StackPanel Orientation="Horizontal" Background="{StaticResource Black.QuickAccessActiveBrush}" MaxHeight="21">
