    <ControlTemplate x:Key="RibbonCheckBoxTemplate" TargetType="{x:Type local:RibbonCheckBox}">
        <BulletDecorator SnapsToDevicePixels="true" Background="Transparent">
            <BulletDecorator.Bullet>
                <Border x:Name="border1" Width="13" Height="13" BorderBrush="{StaticResource Black.CheckBox.BorderBrush}" BorderThickness="1" Background="{StaticResource Blue.CheckBoxBackground}">
                    <Border x:Name="border2" BorderBrush="{StaticResource Black.CheckBox.InnerBorderBrush}" BorderThickness="1">
                        <Border x:Name="border3" BorderThickness="1" Background="{StaticResource CheckRadioInnerFillBrush}" BorderBrush="{StaticResource CheckRadioInnerBorderBrush}">
                            <Canvas SnapsToDevicePixels="True">
                                <Path x:Name="path">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="2,4">
                                                <LineSegment Point="3,6"/>
                                                <LineSegment Point="5,-1"/>
                                                <LineSegment Point="7,-1"/>
                                                <LineSegment Point="4,8"/>
                                                <LineSegment Point="2,8"/>
                                                <LineSegment Point="0,5"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Border>
                    </Border>
                </Border>
            </BulletDecorator.Bullet>
            <ContentPresenter Name="content" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="6,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </BulletDecorator>
        <ControlTemplate.Triggers>
            <Trigger Property="HasContent" Value="true">
                <Setter Property="FocusVisualStyle" Value="{StaticResource CheckRadioFocusVisual}"/>
                <Setter Property="Padding" Value="2,0,0,0"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Fill" TargetName="path" Value="{StaticResource Black.CheckBox.BorderBrushHover}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="border1" Property="BorderBrush" Value="{StaticResource Black.CheckBox.BorderBrushHover}" />
                <Setter TargetName="border2" Property="BorderBrush" Value="{StaticResource Blue.CheckBoxBackgroundHover}" />
                <Setter TargetName="border3" Property="BorderBrush" Value="{StaticResource CheckRadioOverInnerBorderBrush}" />
                <Setter TargetName="border3" Property="Background" Value="{StaticResource CheckRadioOverInnerFillBrush}" />
                <Setter Property="TextBlock.Foreground" TargetName="content" Value="{StaticResource Black.Foreground}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="TextBlock.Foreground" TargetName="content" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>



