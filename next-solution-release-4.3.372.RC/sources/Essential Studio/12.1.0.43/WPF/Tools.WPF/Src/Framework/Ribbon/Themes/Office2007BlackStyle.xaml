	<Style BasedOn="{StaticResource Office2007BlackRibbonGalleryGroupStyle}" TargetType="{x:Type local:RibbonGalleryGroup}"/>
	
	<Style x:Key="RibbonButtonPopupItemStyle" TargetType="{x:Type local:RibbonButton}">
        <Setter  Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
        <!--<Setter Property="Height" Value="23"/>-->
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonButton}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Panel.Background}" 
						Width="{TemplateBinding Width}" Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}" MinHeight="{TemplateBinding MinHeight}"
						MaxHeight="{TemplateBinding MaxHeight}" Margin="{TemplateBinding Margin}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="21"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Name="PART_CheckBorder" Grid.Column="0" Visibility="Collapsed" 
								Width="21" Height="21" BorderThickness="1" BorderBrush="{StaticResource Default.QuickCheckedButtonBorderBrush}"   
								Background="{StaticResource Default.QuickCheckedButtonBackgroundBrush}" CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}">
                                <Path Stroke="{StaticResource Black.Foreground}" StrokeThickness="1.4">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="6 9" EndPoint="9 16"/>
                                            <LineGeometry StartPoint="9 16" EndPoint="13 3"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Border>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Name="label"  Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_CheckBorder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Black.Foreground}"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Padding" Value="16,9,16,9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Default.QuickDropDownButtonHoverBorder}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

	<!--RibbonGallery-->
	<Style x:Key="Office2007BlackGalleryFilterSelectorStyle" TargetType="{x:Type local:GalleryFilterSelector}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GalleryFilterSelector}">
                    <Grid>
                        <Border Height="15" 
                    Name="PART_DropDownButton" 
                    Background="{StaticResource Black.RibbonBarHeader.BackgroundBrush}"
                    BorderThickness="0,0,0,1" 
                    BorderBrush="{StaticResource Default.QuickDropDownBorder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="10,0,0,0" 
                            
                           FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
                           FontStyle="Normal"                            
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GalleryFilterSelector}},                  
                                          Path=SelectedFilter.Label}"/>
                                <Path Fill="{TemplateBinding Foreground}"
					            HorizontalAlignment="Center"
					            VerticalAlignment="Center"
					            Data="M 0 0 L 4 4 L 8 0 Z"
					            Margin="1"/>
                            </StackPanel>
                        </Border>

                        <Popup Name="PART_Popup"                   
                   Placement="Bottom"
                   Focusable="False"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade"
                   IsOpen="{Binding Path=IsDropDownOpen, 
                                    Mode=TwoWay, 
                                    RelativeSource={RelativeSource AncestorType={x:Type local:GalleryFilterSelector}}}">
                            <mwt:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="True">
                                <local:RibbonButtonChecker 
									ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GalleryFilterSelector}},
                                	Converter={StaticResource GalleryFilterConverter}, ConverterParameter={StaticResource RibbonButtonPopupItemStyle}, Path=Filters}" CheckedButton="{Binding Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GalleryFilterSelector}}, Converter={StaticResource FilterToRibbonButtonConverter}, Path=SelectedFilter}"/>
                            </mwt:SystemDropShadowChrome>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Default.GalleryFilterSelection}"/>
            </Trigger>

            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=HasFilters}" Value="True">
                <Setter Property="Filters" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=GalleryFilters}"/>
                <Setter Property="SelectedFilter" Value="{Binding Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=CurrentFilter}"/>
                <Setter Property="Visibility" Value="Visible"/>
                <!--Filters="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=GalleryFilters}"
        SelectedFilter="{Binding Mode=TwoWay,
        RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}},
        Path=CurrentFilter}"-->
            </DataTrigger>
        </Style.Triggers>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlackGalleryFilterSelectorStyle}" TargetType="{x:Type local:GalleryFilterSelector}"/>

    <Style x:Key="Office2007BlackRibbonButtonCheckerStyle" TargetType="{x:Type local:RibbonButtonChecker}">
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonButtonChecker}">
                    <!--<ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonButtonChecker}},                  
                                              Path=Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>-->
                    <Border Background="{StaticResource Default.RibbonButtonChecked}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlackRibbonButtonCheckerStyle}" TargetType="{x:Type local:RibbonButtonChecker}"/>

    <ControlTemplate x:Key="HorizontalAndVerticalResizeThumb" TargetType="{x:Type local:PopupResizeThumb}">
        <Border Width="10" Height="10"
            Background="Transparent"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
            <Path Margin="0,0,2,2" Data="M7,0L7,7 0,7 0,4 4,4 4,0z"
            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Path.Fill>
                    <DrawingBrush ViewboxUnits="Absolute" TileMode="Tile" Viewbox="0,0,4,4" Viewport="0,0,4,4" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <DrawingGroup.Children>
                                    <GeometryDrawing Brush="#00FFFFFF">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,1,1" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#C0C6D6"  Geometry="M1,1L3,1 3,3 1,3z" />
                                    <GeometryDrawing Brush="#5574A7"  Geometry="M0,0L2,0 2,2 0,2z" />
                                </DrawingGroup.Children>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Path.Fill>
            </Path>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Cursor" Value="SizeNWSE"/>
            </Trigger>
            <Trigger Property="FlowDirection" Value="RightToLeft">
                <Setter Property="Cursor" Value="SizeNESW"/>
            </Trigger>
            
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <ControlTemplate x:Key="VerticalOnlyResizeThumb" TargetType="{x:Type local:PopupResizeThumb}">
        <Border Width="20" Height="10" Background="Transparent"
            VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M0,0L2,0 2,2 0,2z M5,0L7,0 7,2 5,2z M10,0L12,0 12,2 10,2z M15,0L17,0 17,2 15,2z" Fill="#C0C6D6" Margin="1,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Path Data="M0,0L2,0 2,2 0,2z M5,0L7,0 7,2 5,2z M10,0L12,0 12,2 10,2z M15,0L17,0 17,2 15,2z" Fill="#5574A7" Margin="0,0,1,1" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Cursor" Value="SizeNS"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <Style x:Key="Office2007BlackStyle" TargetType="{x:Type local:PopupResizeThumb}">
        <Setter Property="Template" Value="{StaticResource HorizontalAndVerticalResizeThumb}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        
    </Style>
	
	<Style BasedOn="{StaticResource Office2007BlackStyle}" TargetType="{x:Type local:PopupResizeThumb}"/>
	
    <Style x:Key="Office2007BlackLabelTextBlockStyle" TargetType="{x:Type local:LabelTextBlock}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <!--<Setter Property="Height" Value="15"/>-->
        <Setter Property="Margin" Value="0,-2,0,0"/>
        <!--<Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>-->
        <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
    </Style>


	<Style BasedOn="{StaticResource Office2007BlackLabelTextBlockStyle}" TargetType="{x:Type local:LabelTextBlock}"/>

    <ContentControl x:Key="Path">
        <ContentControl.Style>
            <Style>
                <Setter Property="Control.OverridesDefaultStyle"  Value="True"/>
                <Setter Property="Control.HorizontalAlignment" Value="Center"/>
                <Setter Property="Control.VerticalAlignment" Value="Top"/>
                <Setter Property="Control.Height" Value="14"/>
                <!--<Setter Property="Control.FontSize" Value="11.5"/>-->
                <Setter Property="Control.Margin" Value="0,-1,0,0"/>
                <!--<Setter Property="Control.FontFamily" Value="Segoe UI"/>-->
                <!--<Setter Property="Control.Foreground" Value="{StaticResource Black.Foreground}"/>-->
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border>
                                <Path Data="M0,0L3.5,4 7,0z" Margin="0,6,0,0"  HorizontalAlignment="Center" Fill="{StaticResource Black.Path.Fill}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ContentControl.Style>
    </ContentControl>


    <Style x:Key="GalleryRepeatButtonStyle" TargetType="Button">
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Background" Value="{StaticResource Black.Gallery.RepeatButton.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Black.Ribbon.BorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  Opacity="{TemplateBinding Opacity}"
                  BorderThickness="1">
                        <Border Name="PART_InnerBorder"
                    BorderBrush="{StaticResource Blue.CheckBoxBackground}"
                    BorderThickness="1"
                    Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource Default.HoverBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Default.HoverBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource GalleryRepeatButton.IsMouseOver.BackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource GalleryRepeatButton.IsPressed.BorderBrush}" />
                <Setter Property="Background" Value="{StaticResource GalleryRepeatButton.IsPressed.BackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
                <!--<Setter Property="Background" Value="{StaticResource GalleryRepeatButton.IsEnabled.BackgroundBrush}" />-->
            </Trigger>
        </Style.Triggers>
    </Style>


    <!--InRibbon Gallery template-->
    <ControlTemplate x:Key="InRibbonGalleryTemplate" TargetType="{x:Type local:RibbonGallery}">
        <Border BorderThickness="1" CornerRadius="2" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Black.Ribbon.BorderBrush}" Height="{TemplateBinding Height}" MaxHeight="62">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Button Name="PART_ScrollUpButton" Grid.Row="0" Style="{StaticResource GalleryRepeatButtonStyle}">
                        <Path Data="M3.5,0L0,4 7,4z" Fill="{StaticResource Black.Path.Fill}"/>
                    </Button>

                    <Button Name="PART_ScrollDownButton" Grid.Row="1" Style="{StaticResource GalleryRepeatButtonStyle}">
                        <Path Data="M0,0L3.5,4 7,0z" Fill="{StaticResource Black.Path.Fill}" />
                    </Button>

                    <Border Grid.Row="2" Name="PART_ToggleButton" Width="16" Height="20.5" Background="{StaticResource Black.Gallery.RepeatButton.Background}" BorderBrush="{StaticResource Black.Ribbon.BorderBrush}" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border BorderBrush="{StaticResource Blue.CheckBoxBackground}" Padding="2.5,4,2.5,3" BorderThickness="1">
                            <StackPanel>
                                <Path Margin="0,0,0,2" Data="M0,0.5L7,0.5" Stroke="{StaticResource Black.Path.Fill}" />
                                <Path Data="M0,0L3.5,4 7,0z" Fill="{StaticResource Black.Path.Fill}" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <local:InRibbonItemsPresenter x:Name="PART_ScrollPresenter" ClipToBounds="True"/>
                
                <Popup x:Name="PART_Popup" Placement="Custom" Focusable="False" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
               IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonGallery}}}">

                    <mwt:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="True">
                        <Border Background="{StaticResource Default.QuickDropDownBackground}"
                    BorderThickness="1"
                    CornerRadius="2"
                    BorderBrush="{StaticResource Default.QuickDropDownBorderBrush}">

                            <DockPanel SnapsToDevicePixels="True">

                                <Border Name="PART_ThumbBorder" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#DDE7EE" Background="{StaticResource Black.Gallery.Bottom.Background}">
                                    <local:PopupResizeThumb IsTabStop="False" Name="PART_ResizeThumb"/>
                                </Border>

                                <local:GalleryFilterSelector DockPanel.Dock="Top"/>

                                <Grid DockPanel.Dock="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition MinHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ScrollViewer Name="PART_ScrollViewer" Grid.Row="0">
                                        <StackPanel>
                                            <ItemsControl Name="PART_PopupItemsControl">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel IsItemsHost="True" ItemWidth="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemWidth}" ItemHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <local:RibbonMenuGroup Visibility="{TemplateBinding MenuItems, Converter={StaticResource CountToVisibilityConverter}}" Grid.Row="1" IconBarEnabled="{TemplateBinding MenuIconBarEnabled}" ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=MenuItems}"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </mwt:SystemDropShadowChrome>
                </Popup>
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
            </Trigger>

            <Trigger SourceName="PART_ToggleButton"  Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_ToggleButton"  Property="BorderBrush" Value="{StaticResource Default.HoverBorderBrush}" />
                <Setter TargetName="PART_ToggleButton"
                Property="Background" Value="{StaticResource GalleryRepeatButton.IsMouseOver.BackgroundBrush}" />
            </Trigger>
            
            <Trigger Property="HasGroups" Value="True">
                <Setter TargetName="PART_PopupItemsControl" Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <local:GalleryGroupPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>


            <Trigger Property="ResizeDirection" Value="HorizontalAndVertical">
                <Setter TargetName="PART_Popup" Property="Width"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=HorizontalOffset}"/>
                <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=VerticalOffset}"/>
            </Trigger>

            <Trigger Property="ResizeDirection" Value="VerticalOnly">
                <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay,  Path=VerticalOffset}"/>
				<Setter TargetName="PART_ResizeThumb" Property="Template" Value="{StaticResource VerticalOnlyResizeThumb}" />
				<Setter TargetName="PART_ResizeThumb" Property="HorizontalAlignment" Value="Center" />
            </Trigger>

            <Trigger Property="PopupPosition" Value="Above">
                <Setter TargetName="PART_ThumbBorder" Property="DockPanel.Dock" Value="Top"/>
                <Setter TargetName="PART_ScrollViewer"   Property="DockPanel.Dock" Value="Bottom"/>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNESW" TargetName="PART_ResizeThumb" />
            </Trigger>
			<Trigger Property="ResizeDirection" Value="NoResize">
				<Setter Property="Visibility" Value="Collapsed" TargetName="PART_ResizeThumb"/>
			</Trigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=PopupPosition}" Value="Above"/>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=FlowDirection}" Value="RightToLeft"/>
				</MultiDataTrigger.Conditions>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNWSE" TargetName="PART_ResizeThumb" />
			</MultiDataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    
    <!--GALLERY DROPDOWN TEMPLATES-->

    <!--Large template-->
    <ControlTemplate x:Key="LargeGalleryTemplate" TargetType="{x:Type local:RibbonGallery}">

        <Border Name="PART_OuterBorder" BorderThickness="1" CornerRadius="1" BorderBrush="Transparent">
            <StackPanel>
                <Border x:Name="PART_ToggleButton" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="1" Height="{TemplateBinding Height}" CornerRadius="2">
                    <StackPanel>
                        <Image  Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center" VerticalAlignment="Top" Width="32" Height="32" Margin="0,1,0,0"/>
                        <local:CustomItemsControl Path="{StaticResource Path}" ItemsSource="{Binding Path=Label, Mode=OneWay, Converter={StaticResource TextWrappingConverter}, RelativeSource={RelativeSource TemplatedParent}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:MultilinePanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </local:CustomItemsControl>
                    </StackPanel>
                </Border>

                <Popup x:Name="PART_Popup" MinWidth="{TemplateBinding ExpandWidth}" MinHeight="{TemplateBinding ExpandHeight}" Placement="Custom" Focusable="False" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonGallery}}}">

                    <mwt:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="True" ClipToBounds="True">

                        <Border Background="{StaticResource Default.QuickDropDownBackground}" BorderThickness="1" CornerRadius="2" BorderBrush="{StaticResource Default.QuickDropDownBorderBrush}">

                            <DockPanel LastChildFill="True" SnapsToDevicePixels="True">

                                <Border Name="PART_ThumbBorder" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#DDE7EE" Background="{StaticResource Black.Gallery.Bottom.Background}">
                                    <local:PopupResizeThumb x:Name="PART_ResizeThumb"/>
                                </Border>

                                <local:GalleryFilterSelector DockPanel.Dock="Top"/>

                                <Grid DockPanel.Dock="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition MinHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                        <RowDefinition Height="Auto" MinHeight="0"/>
                                    </Grid.RowDefinitions>
                                    <ScrollViewer Grid.Row="0">
                                        <ItemsPresenter VerticalAlignment="Top"/>
                                    </ScrollViewer>

                                    <local:RibbonMenuGroup Visibility="{TemplateBinding MenuItems, Converter={StaticResource CountToVisibilityConverter}}" Grid.Row="1" IconBarEnabled="{TemplateBinding MenuIconBarEnabled}"
                                                           ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=MenuItems}"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </mwt:SystemDropShadowChrome>
                </Popup>
            </StackPanel>
        </Border>


        <ControlTemplate.Triggers>
            <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
            </Trigger>

            <Trigger Property="ResizeDirection" Value="HorizontalAndVertical">
                <Setter TargetName="PART_Popup" Property="Width"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=HorizontalOffset}"/>
                <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=VerticalOffset}"/>
            </Trigger>

            <Trigger Property="ResizeDirection" Value="VerticalOnly">
                <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay,  Path=VerticalOffset}"/>
				<Setter TargetName="PART_ResizeThumb" Property="Template" Value="{StaticResource VerticalOnlyResizeThumb}" />
				<Setter TargetName="PART_ResizeThumb" Property="HorizontalAlignment" Value="Center" />
            </Trigger>

            <Trigger Property="PopupPosition" Value="Above">
                <Setter TargetName="PART_ThumbBorder" Property="DockPanel.Dock" Value="Top"/>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNESW" TargetName="PART_ResizeThumb" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Black.MouseOver.BorderBrush}" />
                <Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="Transparent"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="{StaticResource Default.GalleryOuterHoverBorderBrush}"/>
                <Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Default.GalleryHoverBorderBrush}"/>
            </Trigger>
			<Trigger Property="ResizeDirection" Value="NoResize">
				<Setter Property="Visibility" Value="Collapsed" TargetName="PART_ResizeThumb"/>
			</Trigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=PopupPosition}" Value="Above"/>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=FlowDirection}" Value="RightToLeft"/>
				</MultiDataTrigger.Conditions>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNWSE" TargetName="PART_ResizeThumb" />
			</MultiDataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>



    <!--Small Template-->
    <ControlTemplate x:Key="SmallGalleryTemplate" TargetType="{x:Type local:RibbonGallery}">
        <Border Name="PART_OuterBorder" BorderThickness="1" CornerRadius="1" BorderBrush="Transparent"  Opacity="{TemplateBinding Opacity}" IsEnabled="{TemplateBinding IsEnabled}">
            <Border Name="PART_ToggleButton"
		  CornerRadius="2"
				BorderThickness="{TemplateBinding BorderThickness}"
				BorderBrush="{TemplateBinding BorderBrush}"
		  Background="{TemplateBinding Background}"
		  Opacity="{TemplateBinding Opacity}"
		  IsEnabled="{TemplateBinding IsEnabled}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
								VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Margin="2" Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
									 Width="16" Height="16" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="2,0,2,0"/>
                    <Path Grid.Column="2"
							  Fill="{StaticResource Black.Path.Fill}"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"
							  Data="M 0 0 L 4 4 L 8 0 Z"
							  Margin="1"/>
                    <Popup Name="PART_Popup"
             MinWidth="{TemplateBinding ExpandWidth}"
             MinHeight="{TemplateBinding ExpandHeight}"
             Placement="Custom"
             Focusable="False"
             AllowsTransparency="True"
             StaysOpen="False"
             PopupAnimation="Fade"
             IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonGallery}}}">

                        <mwt:SystemDropShadowChrome x:Name="PART_Shadow"
                                      SnapsToDevicePixels="True"
                                      ClipToBounds="True">

                            <Border Background="{StaticResource Default.QuickDropDownBackground}"
                    BorderThickness="1"
                    CornerRadius="2"
                    BorderBrush="{StaticResource Default.QuickDropDownBorderBrush}">

                                <DockPanel LastChildFill="True"
                         SnapsToDevicePixels="True">

                                    <Border Name="PART_ThumbBorder"
                           DockPanel.Dock="Bottom"
                           BorderThickness="0,1,0,0"
                           BorderBrush="#DDE7EE"
                           Background="{StaticResource Black.Gallery.Bottom.Background}">
                                        <local:PopupResizeThumb  Name="PART_ResizeThumb"/>
                                    </Border>

                                    <local:GalleryFilterSelector DockPanel.Dock="Top"/>

                                    <Grid DockPanel.Dock="Top">
                                        <Grid.RowDefinitions>
                                            <RowDefinition MinHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                            <RowDefinition Height="Auto" MinHeight="0"/>
                                        </Grid.RowDefinitions>
                                        <ScrollViewer Grid.Row="0">
                                            <ItemsPresenter VerticalAlignment="Top"/>
                                        </ScrollViewer>

                                        <local:RibbonMenuGroup Visibility="{TemplateBinding MenuItems, Converter={StaticResource CountToVisibilityConverter}}"
                      Grid.Row="1" IconBarEnabled="{TemplateBinding MenuIconBarEnabled}"
                      ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=MenuItems}"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </mwt:SystemDropShadowChrome>
                    </Popup>
                </Grid>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
            </Trigger>

            <Trigger Property="ResizeDirection" Value="HorizontalAndVertical">
                <Setter TargetName="PART_Popup" Property="Width"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=HorizontalOffset}"/>
                <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=VerticalOffset}"/>
            </Trigger>

            <Trigger Property="ResizeDirection" Value="VerticalOnly">
                <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay,  Path=VerticalOffset}"/>
				<Setter TargetName="PART_ResizeThumb" Property="Template" Value="{StaticResource VerticalOnlyResizeThumb}" />
				<Setter TargetName="PART_ResizeThumb" Property="HorizontalAlignment" Value="Center" />
            </Trigger>

            <Trigger Property="PopupPosition" Value="Above">
                <Setter TargetName="PART_ThumbBorder" Property="DockPanel.Dock" Value="Top"/>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNESW" TargetName="PART_ResizeThumb" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Black.MouseOver.BorderBrush}" />
                <Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="Transparent"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="{StaticResource Default.GalleryOuterHoverBorderBrush}"/>
                <Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Default.GalleryHoverBorderBrush}"/>
            </Trigger>
			<Trigger Property="ResizeDirection" Value="NoResize">
				<Setter Property="Visibility" Value="Collapsed" TargetName="PART_ResizeThumb"/>
			</Trigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=PopupPosition}" Value="Above"/>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=FlowDirection}" Value="RightToLeft"/>
				</MultiDataTrigger.Conditions>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNWSE" TargetName="PART_ResizeThumb" />
			</MultiDataTrigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>



    <!--ExtraSmall Template-->
    <ControlTemplate x:Key="ExtraSmallGalleryTemplate" TargetType="{x:Type local:RibbonGallery}">
        <Border Name="PART_OuterBorder" BorderThickness="1" Height="23" Width="33" CornerRadius="1" BorderBrush="Transparent">
            <Border Name="PART_ToggleButton"
                  Height="23" CornerRadius="1" Width="33"
                  BorderThickness="{TemplateBinding BorderThickness}"
						      BorderBrush="{TemplateBinding BorderBrush}"
						      Background="{TemplateBinding Panel.Background}">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
						    VerticalAlignment="Center"
                HorizontalAlignment="Center">
                        <Image Margin="1" 
                 Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
								 Width="16"
                 Height="16" />
                    </Border>
                    <Path Grid.Column="1"
					    Fill="{StaticResource Black.Path.Fill}"
					    HorizontalAlignment="Center"
					    VerticalAlignment="Center"
					    Data="M 0 0 L 4 4 L 8 0 Z"
					    Margin="1"/>
                    <Popup Name="PART_Popup"
             MinWidth="{TemplateBinding ExpandWidth}"
             MinHeight="{TemplateBinding ExpandHeight}"
             Placement="Bottom"
             Focusable="False"
             AllowsTransparency="True"
             StaysOpen="False"
             PopupAnimation="Fade"
             IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonGallery}}}">

                        <mwt:SystemDropShadowChrome x:Name="PART_Shadow"
                                      SnapsToDevicePixels="True"
                                      ClipToBounds="True">

                            <Border Background="{StaticResource Default.QuickDropDownBackground}" VerticalAlignment="Stretch"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}"
                    BorderBrush="{StaticResource Default.QuickDropDownBorderBrush}">

                                <DockPanel  VerticalAlignment="Stretch"
                         SnapsToDevicePixels="True">

                                    <Border Name="PART_ThumbBorder"
                           DockPanel.Dock="Bottom"
                           BorderThickness="0,1,0,0"
                           BorderBrush="#DDE7EE"
                           Background="{StaticResource Black.Gallery.Bottom.Background}">
                                        <local:PopupResizeThumb  Name="PART_ResizeThumb"/>
                                    </Border>

                                    <local:GalleryFilterSelector DockPanel.Dock="Top"/>

                                    <Grid DockPanel.Dock="Top">
                                        <Grid.RowDefinitions>
                                            <RowDefinition MinHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                            <RowDefinition Height="Auto" MinHeight="0"/>
                                        </Grid.RowDefinitions>
                                        <ScrollViewer Grid.Row="0">
                                            <ItemsPresenter VerticalAlignment="Top"/>
                                        </ScrollViewer>

                                        <local:RibbonMenuGroup Visibility="{TemplateBinding MenuItems, Converter={StaticResource CountToVisibilityConverter}}"
                      Grid.Row="1" IconBarEnabled="{TemplateBinding MenuIconBarEnabled}"
                      ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=MenuItems}"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </mwt:SystemDropShadowChrome>
                    </Popup>
                </Grid>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Black.MouseOver.BorderBrush}" />
                <Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="Transparent"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="{StaticResource Default.GalleryOuterHoverBorderBrush}"/>
                <Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Default.GalleryHoverBorderBrush}"/>
            </Trigger>

            <Trigger Property="ResizeDirection" Value="HorizontalAndVertical">
                <Setter TargetName="PART_Popup" Property="Width"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=HorizontalOffset}"/>
                <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=VerticalOffset}"/>
            </Trigger>

            <Trigger Property="ResizeDirection" Value="VerticalOnly">
                <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay,  Path=VerticalOffset}"/>
				<Setter TargetName="PART_ResizeThumb" Property="Template" Value="{StaticResource VerticalOnlyResizeThumb}" />
				<Setter TargetName="PART_ResizeThumb" Property="HorizontalAlignment" Value="Center" />
            </Trigger>

            <Trigger Property="PopupPosition" Value="Above">
                <Setter TargetName="PART_ThumbBorder" Property="DockPanel.Dock" Value="Top"/>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNESW" TargetName="PART_ResizeThumb" />
            </Trigger>
			<Trigger Property="ResizeDirection" Value="NoResize">
				<Setter Property="Visibility" Value="Collapsed" TargetName="PART_ResizeThumb"/>
			</Trigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=PopupPosition}" Value="Above"/>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=FlowDirection}" Value="RightToLeft"/>
				</MultiDataTrigger.Conditions>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNWSE" TargetName="PART_ResizeThumb" />
			</MultiDataTrigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>



