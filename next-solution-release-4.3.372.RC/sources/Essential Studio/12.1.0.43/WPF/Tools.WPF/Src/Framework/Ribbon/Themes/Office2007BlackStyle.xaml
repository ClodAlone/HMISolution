                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Text" Property="Margin" Value="4,1,4,1" />
                        </Trigger>
                        <Trigger Property="HelpText" Value="">

                            <Setter TargetName="HelpImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Seperator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_HelpText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style  BasedOn="{StaticResource Office2007BlackScreenTipStyle}" TargetType="{x:Type local:ScreenTip}"/>
        <!--RibbonWindow style-->
    <Style x:Key="Office2007BlackRibbonWindowStyle" TargetType="{x:Type local:RibbonWindow}">
        <Setter Property="RibbonStatusBarStyle" Value="{StaticResource {x:Type local:RibbonStatusBar}}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="MinHeight" Value="150"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource Window.ActiveBorderBrush}"/>
        <Setter Property="Background" Value="{StaticResource Black.Window.Background}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonWindow}">
                    <AdornerDecorator x:Name="PART_Adorner">
                        <Grid>
                            <Border Name="PART_MainBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <DockPanel HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Stretch">
                                    <local:TitleBar x:Name="PART_TitleBar" Title="{TemplateBinding Title}" DockPanel.Dock="Top" Style="{StaticResource TitleBarStyleKey}"/>
                                    <Grid>
                                        <DockPanel>
                                            <ContentPresenter DockPanel.Dock="Bottom" Content="{TemplateBinding StatusBar}"/>
                                            <ContentPresenter DockPanel.Dock="Bottom" Content="{TemplateBinding Content}"/>
                                        </DockPanel>
                                        <Label x:Name="PART_ResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" IsTabStop="False" Cursor="SizeNWSE">
                                            <Grid SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                                                <Path Fill="{StaticResource Black.ResizeGripperForegroundLight}" Data="M 9,1 L 11,1 L 11,3 L 9,3 Z M 5,5 L 7,5 L 7,7 L 5,7 Z M 9,5 L 11,5 L 11,7 L 9,7 Z M 1,9 L 3,9 L 3,11 L 1,11 Z M 5,9 L 7,9 L 7,11 L 5,11 Z M 9,9 L 11,9 L 11,11 L 9,11 Z" />
                                                <Path Fill="{StaticResource Black.ResizeGripperForegroundDark}" Data="M 8,0 L 10,0 L 10,2 L 8,2 Z M 4,4 L 6,4 L 6,6 L 4,6 Z M 8,4 L 10,4 L 10,6 L 8,6 Z M 0,8 L 2,8 L 2,10 L 0,10 Z M 4,8 L 6,8 L 6,10 L 4,10 Z M 8,8 L 10,8 L 10,10 L 8,10 Z" />
                                            </Grid>
                                        </Label>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="PART_TitleBar" Property="Background" Value="{StaticResource Black.TitleBar.ActiveBackgroundBrush}"/>
                            <Setter TargetName="PART_TitleBar" Property="BorderBrush" Value="{StaticResource Black.TitleBar.ActiveBorderBrush}"/>
                            <Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ResizeMode" Value="CanResizeWithGrip"/>
                                <Condition Property="WindowState" Value="Normal"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="MaximizedMode" Value="KioskStyle" />
                                <Condition Property="WindowState" Value="Maximized" />
                                <Condition Property="WindowStyle" Value="None" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
							<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsGlassActive" Value="True">
				
                <Setter Property="Template" >
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonWindow}">
                            <AdornerDecorator x:Name="PART_Adorner">
                                <Grid >
                                  
                                    <DockPanel HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Stretch">
                                        <local:TitleBar x:Name="PART_TitleBar" Title="{TemplateBinding Title}" DockPanel.Dock="Top" Style="{StaticResource TitleBarStyleKey}"/>
                                        <!--<Border BorderThickness="1" BorderBrush="#FF526374">-->
                                            <Grid>
                                                <DockPanel>
                                                    <ContentPresenter DockPanel.Dock="Bottom" Content="{TemplateBinding StatusBar}"/>
                                                    <Border Name="PART_ContentBorder" Background="{TemplateBinding Background}" DockPanel.Dock="Bottom" Margin="0,-1,0,0" Padding="0,1,0,0" BorderThickness="2,0,2,0" BorderBrush="{StaticResource Black.Window.Background}">
                                                        <ContentPresenter Content="{TemplateBinding Content}"/>
                                                    </Border>
                                                </DockPanel>
                                                <Label x:Name="PART_ResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" IsTabStop="False" Cursor="SizeNWSE">
                                                    <Grid SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                                                        <Path Fill="{StaticResource Black.ResizeGripperForegroundLight}" Data="M 9,1 L 11,1 L 11,3 L 9,3 Z M 5,5 L 7,5 L 7,7 L 5,7 Z M 9,5 L 11,5 L 11,7 L 9,7 Z M 1,9 L 3,9 L 3,11 L 1,11 Z M 5,9 L 7,9 L 7,11 L 5,11 Z M 9,9 L 11,9 L 11,11 L 9,11 Z" />
                                                        <Path Fill="{StaticResource Black.ResizeGripperForegroundDark}" Data="M 8,0 L 10,0 L 10,2 L 8,2 Z M 4,4 L 6,4 L 6,6 L 4,6 Z M 8,4 L 10,4 L 10,6 L 8,6 Z M 0,8 L 2,8 L 2,10 L 0,10 Z M 4,8 L 6,8 L 6,10 L 4,10 Z M 8,8 L 10,8 L 10,10 L 8,10 Z" />
                                                    </Grid>
                                                </Label>
                                            </Grid>
                                        <!--</Border>-->
                                    </DockPanel>
                                </Grid>
                                    
                            </AdornerDecorator>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsGlassActive" Value="True">
                                    <Setter TargetName="PART_TitleBar" Property="Background" Value="Transparent"/>
                                    <Setter TargetName="PART_TitleBar" Property="BorderThickness" Value="0"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="ResizeMode" Value="CanResizeWithGrip"/>
                                        <Condition Property="WindowState" Value="Normal"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible"/>
                                </MultiTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsGlassActive}" Value="True" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=WindowState}" Value="Maximized" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="PART_TitleBar" Property="Margin" Value="0,6,0,-8"/>
                                    <Setter TargetName="PART_ContentBorder" Property="Margin" Value="0,8,0,0"/>
                                </MultiDataTrigger>
                                <!--<MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="WindowState" Value="Maximized" />
                                        <Condition Property="WindowStyle" Value="None" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
                                </MultiTrigger>-->
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsGlassActive" Value="False">
				
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonWindow}">
                            <AdornerDecorator x:Name="PART_Adorner">
                                <Grid>
                                    <Border Name="PART_MainBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                                        <DockPanel HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Stretch">
                                            <local:TitleBar x:Name="PART_TitleBar" Title="{TemplateBinding Title}" DockPanel.Dock="Top" Style="{StaticResource TitleBarStyleKey}"/>
                                            <Grid >                                                
                                                <DockPanel>
                                                    <ContentPresenter DockPanel.Dock="Bottom" Content="{TemplateBinding StatusBar}"/>
                                                    <ContentPresenter DockPanel.Dock="Bottom" Content="{TemplateBinding Content}"/>
                                                </DockPanel>
                                                <Label x:Name="PART_ResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" IsTabStop="False" Cursor="SizeNWSE">
                                                    <Grid SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                                                        <Path Fill="{StaticResource Black.ResizeGripperForegroundLight}" Data="M 9,1 L 11,1 L 11,3 L 9,3 Z M 5,5 L 7,5 L 7,7 L 5,7 Z M 9,5 L 11,5 L 11,7 L 9,7 Z M 1,9 L 3,9 L 3,11 L 1,11 Z M 5,9 L 7,9 L 7,11 L 5,11 Z M 9,9 L 11,9 L 11,11 L 9,11 Z" />
                                                        <Path Fill="{StaticResource Black.ResizeGripperForegroundDark}" Data="M 8,0 L 10,0 L 10,2 L 8,2 Z M 4,4 L 6,4 L 6,6 L 4,6 Z M 8,4 L 10,4 L 10,6 L 8,6 Z M 0,8 L 2,8 L 2,10 L 0,10 Z M 4,8 L 6,8 L 6,10 L 4,10 Z M 8,8 L 10,8 L 10,10 L 8,10 Z" />
                                                    </Grid>
                                                </Label>
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </AdornerDecorator>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsActive" Value="True">
                                    <Setter TargetName="PART_TitleBar" Property="Background" Value="{StaticResource Black.TitleBar.ActiveBackgroundBrush}"/>
                                    <Setter TargetName="PART_TitleBar" Property="BorderBrush" Value="{StaticResource Black.TitleBar.ActiveBorderBrush}"/>
                                    <Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="ResizeMode" Value="CanResizeWithGrip"/>
                                        <Condition Property="WindowState" Value="Normal"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="MaximizedMode" Value="KioskStyle" />
                                        <Condition Property="WindowState" Value="Maximized" />
                                        <Condition Property="WindowStyle" Value="None" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
									<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                                </MultiTrigger>
								<Trigger Property="WindowState" Value="Maximized">
                                    
                                <Setter Property="Margin" TargetName="PART_MainBorder">
                                        <Setter.Value>
                                            <Thickness Top="4" 
											Bottom="{x:Static  SystemParameters.ResizeFrameHorizontalBorderHeight}" 
											Left="{x:Static  SystemParameters.ResizeFrameVerticalBorderWidth}" 
											Right="{x:Static  SystemParameters.ResizeFrameVerticalBorderWidth}"/>
                                        </Setter.Value>
                                    </Setter>
                                
									
                                </Trigger>
                                <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                    <Setter Property="Margin" Value="7,4,7,8" TargetName="PART_MainBorder"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>


	<Style BasedOn="{StaticResource Office2007BlackRibbonWindowStyle}" TargetType="{x:Type local:RibbonWindow}"/>

	<!--RibbonTextBox-->
	 <Style x:Key="Office2007BlackRibbonTextBoxStyle" TargetType="{x:Type local:RibbonTextBox}">
        <!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
        <Setter Property="Background" Value="{StaticResource Blue.TextBoxBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Black.CheckBox.BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="2"/>
        <!--<Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>-->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AllowDrop" Value="true"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonTextBox}">
                    <Border SnapsToDevicePixels="true" x:Name="Bd" CornerRadius="{StaticResource Blue.ComboCornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Blue.CheckBox.BorderBrushHover}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Blue.TextBoxBackgroundHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
	<Style BasedOn="{StaticResource Office2007BlackRibbonTextBoxStyle}" TargetType="{x:Type local:RibbonTextBox}"/>

	<!--RibbonSeperator-->
	 <Style x:Key="Office2007BlackRibbonSeparatorStyle" TargetType="{x:Type local:RibbonSeparator}">
        <!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
        <Setter Property="Focusable"   Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonSeparator}">
                    <StackPanel Width="2" Height="55" Orientation="Horizontal">
                        <Border Width="1" Height="55" Background="White"/>
                        <Border Width="1" Height="55" Background="{StaticResource Black.SeparatorBrush}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Margin" Value="3,5,3,0"/>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlackRibbonSeparatorStyle}" TargetType="{x:Type local:RibbonSeparator}"/>

	<!--RibbonScrollingButton-->
	<!--RibbonScrollingButton style-->
    <ControlTemplate x:Key="RibbonScrollingButtonTemplate" TargetType="{x:Type Button}">
        <Border x:Name="PART_Border" VerticalAlignment="Stretch" HorizontalAlignment="Center"
				BorderThickness="1,0,0,0"
				BorderBrush="{TemplateBinding BorderBrush}"
				Background="{TemplateBinding Background}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True"
				CornerRadius="0,3,3,0">
            <Border x:Name="PART_InnerBorder" VerticalAlignment="Stretch" HorizontalAlignment="Center"
				BorderThickness="1,0,0,0"
				BorderBrush="{StaticResource Blue.CheckBoxBackground}"
				Background="{TemplateBinding Background}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True" CornerRadius="0,3,3,0">
                <Path x:Name="PART_Path" Stroke="{StaticResource Blend.PathFill1}" StrokeThickness="2" Fill="{StaticResource Black.Path.Fill}" Margin="3,16,-2,0"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  Data="{StaticResource Default.PathData}">
                    <Path.RenderTransform>
                        <RotateTransform Angle="-90"/>
                    </Path.RenderTransform>
                </Path>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Left">
                <Setter TargetName="PART_Path" Property="Margin" Value="6,0,-5,0"/>
                <Setter TargetName="PART_Path" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="90"/>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="PART_Border" Property="CornerRadius" Value="3,0,0,3"/>
                <Setter TargetName="PART_InnerBorder" Property="CornerRadius" Value="3,0,0,3"/>
                <Setter TargetName="PART_Border" Property="BorderThickness" Value="0,0,1,0"/>
                <Setter TargetName="PART_InnerBorder" Property="BorderThickness" Value="0,0,1,0"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <Style x:Key="RibbonScrollingButton" TargetType="{x:Type Button}">
        <Setter Property="shared:SkinStorage.VisualStyle" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Ribbon}}, Path=(shared:SkinStorage.VisualStyle), Mode=OneWay}"/>
        <!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Ribbon}}, Path=(shared:SkinStorage.VisualStylesList), Mode=OneWay}"/>-->
        <Setter Property="Template" Value="{StaticResource RibbonScrollingButtonTemplate}"/>
        <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
        <Setter Property="Background" Value="{StaticResource Black.Ribbon.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Black.ImageBorder.BorderBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>
	<!--RibbonRadioButton-->
	<Style x:Key="TextBoxStyle1" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Black.CheckBox.BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!--<Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>-->
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AllowDrop" Value="true"/>
    </Style>

    <ControlTemplate x:Key="RibbonRadioButtonTemplate" TargetType="{x:Type local:RibbonRadioButton}">
        <BulletDecorator Background="Transparent">
            <BulletDecorator.Bullet>
                <Canvas Width="13" Height="13">
                    <Ellipse x:Name="ellipse1" Width="13" Height="13" Fill="{StaticResource Blue.CheckBoxBackground}" Stroke="{StaticResource Black.CheckBox.BorderBrush}">
                    </Ellipse>
                    <Ellipse x:Name="ellipse2" Fill="{StaticResource Black.CheckBox.InnerBorderBrush}" Canvas.Left="2" Canvas.Top="2" Width="9" Height="9">
                    </Ellipse>
                    <Ellipse x:Name="ellipse3" Fill="{StaticResource CheckRadioInnerFillBrush}" Canvas.Left="3" Canvas.Top="3" Width="7" Height="7">
                    </Ellipse>
                    <Ellipse x:Name="ellipse" Canvas.Left="4" Canvas.Top="4" Width="5" Height="5">
                    </Ellipse>
                </Canvas>
            </BulletDecorator.Bullet>
            <ContentPresenter Margin="6,0,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </BulletDecorator>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Fill" TargetName="ellipse" Value="{StaticResource Black.CheckBox.BorderBrushHover}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="ellipse1" Property="Stroke" Value="{StaticResource Black.CheckBox.BorderBrushHover}" />
                <Setter TargetName="ellipse2" Property="Fill" Value="{StaticResource Black.CheckBox.InnerBorderBrush}" />
                <Setter TargetName="ellipse3" Property="Fill" Value="{StaticResource CheckRadioOverInnerFillBrush}" />
                <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Office2007BlackRibbonRadioButtonStyle" TargetType="{x:Type local:RibbonRadioButton}">
        <!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
        <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
        <Setter Property="Margin" Value="3,3,3,3"/>
        <Setter Property="Background" Value="{StaticResource CheckRadioFillNormal}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CheckRadioStrokeNormal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Content" Value="New RadioButton"/>
        <Setter Property="Template" Value="{StaticResource RibbonRadioButtonTemplate}"/>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlackRibbonRadioButtonStyle}" TargetType="{x:Type local:RibbonRadioButton}"/>

	<!--RibbonPage-->
	<Style x:Key="Office2007BlackRibbonPageStyle" TargetType="{x:Type local:RibbonPage}">
        <!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{StaticResource SkinDictionary}"/>-->
        <Setter Property="Margin" Value="0,25,0,0"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonPage}">
                    <AdornerDecorator x:Name="PART_Adorner">
                        <Grid>
                            <Border Name="PART_MainBorder" Background="{StaticResource Black.Window.Background}" BorderBrush="{StaticResource Black.Window.BorderBrush}" BorderThickness="1" CornerRadius="5">

                                <DockPanel HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Stretch">

                                    <ContentPresenter DockPanel.Dock="Bottom" Content="{TemplateBinding StatusBar}"/>

                                    <AdornerDecorator DockPanel.Dock="Top" Panel.ZIndex="100">
                                        <ContentPresenter Content="{TemplateBinding Ribbon}"/>
                                    </AdornerDecorator>

                                    <ContentPresenter  DockPanel.Dock="Bottom" Content="{TemplateBinding Content}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </AdornerDecorator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlackRibbonPageStyle}" TargetType="{x:Type local:RibbonPage}"/>

    <Style x:Key="Office2007BlackApplicationMenuGroupStyle" TargetType="{x:Type local:ApplicationMenuGroup}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ApplicationMenuGroup}">
                    <local:LayoutPanel x:Name="PART_LayoutPanel" Width="{TemplateBinding ActualWidth}">
                        <StackPanel Margin="1,0,1,1" HorizontalAlignment="Stretch">
                            <Border Name="PART_Header"  Height="21"  HorizontalAlignment="Stretch" Margin="0,0,0,2"  SnapsToDevicePixels="True" Background="{StaticResource Black.MenuItems.HeaderBackground}" BorderBrush="{StaticResource Black.QATContextMenu.BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="2,2,0,0" Padding="7,0,5,0" >
                                <TextBlock Text="{TemplateBinding Header}" FontSize="{TemplateBinding FontSize}" FontWeight="Bold" Foreground="{StaticResource Black.Foreground}" VerticalAlignment="Center"/>
                            </Border>
                            <ItemsPresenter KeyboardNavigation.TabNavigation="Contained" KeyboardNavigation.DirectionalNavigation="Contained" x:Name="PART_Presenter" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="0,0,0,1"/>
                        </StackPanel>
                        <Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource Black.QATContextMenu.BorderBrush}" Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BoolToVisibilityConverter}}"  Margin="1,1,1,1" Background="{StaticResource Black.MenuItems.HeaderBackground}" Height="{TemplateBinding ActualHeight}" Width="22" Panel.ZIndex="-1" HorizontalAlignment="Left"/>
                    </local:LayoutPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter TargetName="PART_Header" Property="Height" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlackApplicationMenuGroupStyle}" TargetType="{x:Type local:ApplicationMenuGroup}"/>
    
	<!--RibbonMenuGroup-->
	 <Style x:Key="Office2007BlackRibbonMenuGroupStyle" TargetType="{x:Type local:RibbonMenuGroup}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonMenuGroup}">
                    <local:LayoutPanel x:Name="PART_LayoutPanel" Width="{TemplateBinding ActualWidth}">
                        <StackPanel Margin="1,0,1,1" HorizontalAlignment="Stretch">
                            <Border Name="PART_Header"  Height="21"  HorizontalAlignment="Stretch" Margin="0,0,0,2"  SnapsToDevicePixels="True" Background="{StaticResource Black.MenuItems.HeaderBackground}" BorderBrush="{StaticResource Black.QATContextMenu.BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="2,2,0,0" Padding="7,0,5,0" >
                                <TextBlock Text="{TemplateBinding Header}" FontSize="{TemplateBinding FontSize}" FontWeight="Bold" Foreground="{StaticResource Black.Foreground}" VerticalAlignment="Center"/>
                            </Border>
                            <ItemsPresenter KeyboardNavigation.TabNavigation="Contained" KeyboardNavigation.DirectionalNavigation="Contained" x:Name="PART_Presenter" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="0,0,0,1"/>
                        </StackPanel>
                        <Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource Black.QATContextMenu.BorderBrush}" Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BoolToVisibilityConverter}}"  Margin="1,1,1,1" Background="{StaticResource Black.MenuItems.HeaderBackground}" Height="{TemplateBinding ActualHeight}" Width="22" Panel.ZIndex="-1" HorizontalAlignment="Left"/>
                    </local:LayoutPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter TargetName="PART_Header" Property="Height" Value="1"/>
