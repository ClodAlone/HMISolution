                            <ItemsPresenter x:Name="PART_Presenter"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource Black.Foreground2}"/>
