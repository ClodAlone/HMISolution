  <Style BasedOn="{StaticResource Office2007BlackRibbonStatusBarStyle}" TargetType="{x:Type local:RibbonStatusBar}"/>
	
	 <Style x:Key="Office2007BlackWindowTitleBarButtonStyle" TargetType="{x:Type local:WindowTitleBarButton}">
		<!-- <Setter Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type local:TitleBar}}}"/> -->
		<Setter Property="Focusable" Value="false" />
		<Setter Property="Template">
		  <Setter.Value>
			<ControlTemplate TargetType="{x:Type local:WindowTitleBarButton}">
			  <Border CornerRadius="3" Background="Transparent" Panel.ZIndex="100"
					  BorderBrush="{TemplateBinding BorderBrush}" Name="PART_Border"
					  BorderThickness="{TemplateBinding BorderThickness}">
				<ContentPresenter  Content="{TemplateBinding Content}"
					 HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" RecognizesAccessKey="False"/>
			  </Border>
			  <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="1" />
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="DarkGray" />
                            <Setter TargetName="PART_Border" Property="Background" Value="White" />
                        </Trigger>
                        
                    </ControlTemplate.Triggers>
			</ControlTemplate>
		  </Setter.Value>
		</Setter>
	  </Style>
  
	<Style BasedOn="{StaticResource Office2007BlackWindowTitleBarButtonStyle}" TargetType="{x:Type local:WindowTitleBarButton}"/>
  
	<!--TitleBar-->
    <Style x:Key="TitleBarStyleKey" TargetType="{x:Type local:TitleBar}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource Black.Foreground2}"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Background" Value="{StaticResource Black.TitleBar.BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Black.TitleBar.BorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TitleBar}">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0,0,0,1" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="2,2,0,0">
                        <Grid Name="GlassActive" Height="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Path=AppMenuColumnWidth, Converter={StaticResource DoubleToGridLengthConverter}, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ColumnDefinition Width="{Binding Path=QATColumnWidth, Converter={StaticResource DoubleToGridLengthConverter}, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{Binding Path=SysButtonsColumnWidth, Converter={StaticResource DoubleToGridLengthConverter}, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid.ColumnDefinitions>
                             <Grid  Grid.Column="2" Margin="10,0,10,0">
                    <Rectangle x:Name="rectangle" Fill="#7FFFFFFF" Stroke="{x:Null}" StrokeThickness="0"
                    HorizontalAlignment="{Binding HorizontalAlignment,ElementName=PART_Title,Mode=TwoWay}"  
                    VerticalAlignment="Center" Margin="5,0,0,0" Width="{Binding ActualWidth, ElementName=PART_Title, Mode=Default}"
                               Height="{Binding ActualHeight, ElementName=PART_Title, Mode=Default}" RadiusX="2" RadiusY="2"
                               Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive,Converter={StaticResource BoolToVisibilityConverter}}">
                        <Rectangle.Effect>
                            <BlurEffect Radius="10"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <TextBlock Name="PART_Title"                            
                           Grid.Column="2"
                           Foreground="{TemplateBinding Foreground}"
                           HorizontalAlignment="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=TitleTextAlignment}" 
                           VerticalAlignment="Center"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           Text="{TemplateBinding Title}"
                           Margin="5,0,0,0"
                           MaxWidth="{TemplateBinding TitleMaxWidth}">
                    </TextBlock>
                </Grid>
                            <StackPanel Orientation="Horizontal" Grid.Column="3">
                                <local:WindowTitleBarButton x:Name="MinButton" Width="25" Height="25" ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path= MinimizeTooltip}" Style="{StaticResource {x:Type local:WindowTitleBarButton}}">
                                    <Canvas Width="9" Height="9">
                                        <Line X1="0" X2="8"  Y1="6" Y2="6" Stroke="{StaticResource Black.SystemButton.Brush1}" StrokeThickness="1"/>
                                        <Line X1="0" X2="8"  Y1="7" Y2="7" Stroke="{StaticResource Black.SystemButton.Brush2}" StrokeThickness="1"/>
                                        <Line X1="0" X2="8"  Y1="8" Y2="8" Stroke="{StaticResource Black.SystemButton.Brush3}" StrokeThickness="1"/>
                                    </Canvas>
                                </local:WindowTitleBarButton>
                                <local:WindowTitleBarButton x:Name="MaxButton" Width="25" Height="25" ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path=MaximizeTooltip}" Style="{StaticResource {x:Type local:WindowTitleBarButton}}">
                                    <Canvas Width="9" Height="9">
                                        <Border BorderThickness="1,3,1,1" Width="9" Margin="0,1,0,0" Height="7" BorderBrush="{StaticResource Black.SystemButton.Brush2}"/>
                                    </Canvas>
                                </local:WindowTitleBarButton>
                                <local:WindowTitleBarButton x:Name="NormalButton" Width="25" Height="25" Visibility="Hidden" ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path= RestoreTooltip}" Style="{StaticResource {x:Type local:WindowTitleBarButton}}">
                                    <Canvas Width="9" Height="8">
                                        <Line X1="2" X2="9"  Y1="1.5" Y2="1.5" Stroke="{StaticResource Black.SystemButton.Brush1}" StrokeThickness="1"/>
                                        <Rectangle Canvas.Left="6" Canvas.Top="2"  Stroke="{StaticResource Black.SystemButton.Brush2}" Width="3" Height="5" StrokeThickness="1"/>
                                        <Line X1="3" X2="8"  Y1="3" Y2="3" Stroke="{StaticResource Black.SystemButton.Brush3}" StrokeThickness="1"/>
                                        <Line X1="2" X2="8"  Y1="7" Y2="7" Stroke="{StaticResource Black.SystemButton.Brush3}" StrokeThickness="1"/>
                                        <Line X1="0" X2="7"  Y1="2.5" Y2="2.5" Stroke="{StaticResource Black.SystemButton.Brush1}" StrokeThickness="1"/>
                                        <Rectangle Canvas.Left="0" Canvas.Top="3" Stroke="{StaticResource Black.SystemButton.Brush2}" Width="7" Height="5" StrokeThickness="1"/>
                                        <Line X1="1" X2="6"  Y1="4" Y2="4" Stroke="{StaticResource Black.SystemButton.Brush3}" StrokeThickness="1"/>
                                        <Line X1="0" X2="6"  Y1="8" Y2="8" Stroke="{StaticResource Black.SystemButton.Brush3}" StrokeThickness="1"/>
                                    </Canvas>
                                </local:WindowTitleBarButton>
                                <local:WindowTitleBarButton x:Name="CloseButton" Command="Close" Width="25" Height="25" ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path=CloseTooltip}" Style="{StaticResource {x:Type local:WindowTitleBarButton}}">
                                    <Canvas Width="11" Height="10">
                                        <Path Data="M1,0.5L4,0.5 5,2.5 7,0.5 10,0.5" Stroke="{StaticResource Black.SystemButton.Brush1}" StrokeThickness="1"/>
                                        <Path Data="M1,0L4,0 5,2 7,0 10,0 7,4 7,5 10,8 7,8 5,6 4,8 1,8 4,5 4,4z" Fill="{StaticResource Black.SystemButton.Brush2}"  StrokeThickness="1"/>
                                        <Path Data="M0,8L4,8 5,6 7,8 11,8" Stroke="{StaticResource Black.SystemButton.Brush3}" StrokeThickness="1"/>
                                    </Canvas>
                                </local:WindowTitleBarButton>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Normal">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Maximized">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
