                                    <TranslateTransform X="1"  Y="0.4"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Height="35" Width="35"
                                Fill="{StaticResource AppButtonExpandedInnerBorderFill}"
                                Stroke="{StaticResource Black.AppButton.InnerBorder}" />
                            <Ellipse Height="33" Width="33" Fill="{StaticResource AppButtonExpandedTopHighlight}"/>
                            <Ellipse Height="33" Width="33" Fill="{StaticResource AppButtonExpandedBottomHighlight}"/>
