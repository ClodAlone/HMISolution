    <Style x:Key="Office2007BlackRibbonGalleryStyle" TargetType="{x:Type local:RibbonGallery}">
        <!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Height" Value="62"/>
        <Setter Property="Template" Value="{StaticResource InRibbonGalleryTemplate}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel 
            Background="Transparent"
            ClipToBounds="True"
            ItemWidth="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemWidth}"
            ItemHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="DropDown"/>
                    <Condition Property="SizeForm" Value="Large"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource LargeGalleryTemplate}"/>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="DropDown"/>
                    <Condition Property="SizeForm" Value="Small"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource SmallGalleryTemplate}"/>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="DropDown"/>
                    <Condition Property="SizeForm" Value="ExtraSmall"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource ExtraSmallGalleryTemplate}"/>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="DropDown"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{StaticResource Black.MouseOver.BorderBrush}" />
                <Setter Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}" />
            </MultiTrigger>

            <!--<Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource GalleryRepeatButton.IsPressed.BackgroundBrush}" />
      </Trigger>-->

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="DropDown"/>
                    <Condition Property="IsDropDownOpen" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{StaticResource Default.GalleryHoverBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource DropDownButton.IsDropDownOpen.BackgroundBrush}"/>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="DropDown"/>
                    <Condition Property="HasGroups" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <local:GalleryGroupPanel />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="VisualMode" Value="DropDown"/>
                    <Condition Property="IsEnabled" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="Background" Value="{StaticResource GalleryRepeatButton.IsEnabled.BackgroundBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>


