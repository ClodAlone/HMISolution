                      CornerRadius="4,4,0,0"
                      Height="20"
                      Opacity="0.75"/>

                <Border Name="PART_highlightContour" Grid.Column="1"/>

                <Border Panel.ZIndex="100"
                      Height="22.83" Name="center_Path"
