            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=HasContextTabGroup}" 
                           Value="False"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" TargetName="center_Path" Value="{StaticResource Black.TabButton.SelectedBrush}"/>
                <Setter Property="BorderBrush" TargetName="center_Path" Value="{StaticResource Black.Ribbon.BorderBrush}"/>
                <Setter Property="Fill" TargetName="PART_rightPath" Value="{StaticResource Black.TabButton.SelectedBrush}"/>
                <Setter Property="Fill" TargetName="right_path" Value="{StaticResource Black.Ribbon.BorderBrush}"/>
                <Setter Property="Fill" TargetName="PART_leftPath" Value="{StaticResource Black.TabButton.SelectedBrush}"/>
                <Setter Property="Fill" TargetName="left_path" Value="{StaticResource Black.Ribbon.BorderBrush}"/>
            </MultiDataTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsChecked" Value="True"/>
