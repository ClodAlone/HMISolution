        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonStatusBar}">
                    <Border Height="{TemplateBinding Height}" ClipToBounds="True" CornerRadius="0,0,2,2" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
