	<!--DropDownButton style for RibbonBar-->
	<Style x:Key="RibbonDropDownToggleButton" TargetType="{x:Type local:DropDownButton}">
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
		<Setter Property="Background" Value="{StaticResource Black.DropDownButton.BackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{StaticResource Black.DropDownButton.BackgroundBrush}"/>
		<Setter Property="VerticalContentAlignment" Value="Top"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:DropDownButton}">
					<Border Name="PART_ToggleButton"
CornerRadius="2"
BorderThickness="{TemplateBinding BorderThickness}"
BorderBrush="{TemplateBinding BorderBrush}"
Background="{TemplateBinding Background}" >

						<!--Background="#D4E1F1"-->
						<!--<Border
Padding="1,4,1,1"
Background="Transparent"
BorderThickness="0,1,0,0"
BorderBrush="{TemplateBinding BorderBrush}">-->

						<DockPanel Margin="1,4,1,1"
 HorizontalAlignment="Stretch"
 VerticalAlignment="Top">



							<Border DockPanel.Dock="Top"
  Name="PART_ImageBorder"
  CornerRadius="3"
  BorderThickness="1"
  BorderBrush="{StaticResource Black.ImageBorder.BorderBrush}"
  Background="{StaticResource Black.ImageBorder.BackgroundBrush}"
  HorizontalAlignment="Center" >

								<Grid MinWidth="31" MinHeight="31">
									<Grid.RowDefinitions>
										<RowDefinition Height="*"/>
										<RowDefinition Height="7"/>
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<Image Grid.Row="0"  Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
		 Width="16" Height="16" />
									<Border Grid.Row="1" Background="{StaticResource Black.ImageBorder.BackgroundBottom}"/>
								</Grid>
							</Border>

							<local:CustomItemsControl Focusable="False" Margin="3,1,3,1" DockPanel.Dock="Bottom" Path="{StaticResource Path}" ItemsSource="{Binding Path=Label, Mode=OneWay, Converter={StaticResource TextWrappingConverter}, RelativeSource={RelativeSource TemplatedParent}}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<local:MultilinePanel/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
							</local:CustomItemsControl>

							<!--<TextBlock TextWrapping="Wrap" TextAlignment="Center"
   Foreground="{TemplateBinding Foreground}"
   VerticalAlignment="Center"  
   HorizontalAlignment="Center"
   Margin="3,1,3,1"
   Text="{TemplateBinding Label}" />-->

							<!--<Path Fill="{shared:SkinObject PathFill}"
	HorizontalAlignment="Center"
	VerticalAlignment="Center"
	Data="M 0 0 L 4 4 L 8 0 Z"
	Margin="3"/>-->

							<Popup Name="PART_Popup"
 HorizontalAlignment="Center"
 VerticalAlignment="Center"
 Placement="Bottom"
 PlacementTarget="{Binding ElementName=PART_ToggleButton}"
 Focusable="False"
 AllowsTransparency="True"
 StaysOpen="False"
 IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource AncestorType={x:Type local:DropDownButton}}}"
 PopupAnimation="Fade">
								<Microsoft_Windows_Themes:SystemDropShadowChrome  Name="PART_Shadow" Margin="0" SnapsToDevicePixels="true">
                                        <ItemsPresenter/>
                                    <!--<Label Content="{Binding Path=Content, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:DropDownButton}}}"/>-->
								</Microsoft_Windows_Themes:SystemDropShadowChrome>
							</Popup>
						</DockPanel>
					</Border>
					<!--</Border>-->

					<ControlTemplate.Triggers>
						<Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
							<Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,4,4"/>
						</Trigger>
						
						<DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CollapseImage}" Value="{x:Null}">                            
                            <Setter TargetName="PART_ImageBorder" Property="Opacity" Value="0"/>
                        </DataTrigger> 

						<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
 Value="True">
							<Setter TargetName="PART_ImageBorder" Property="Background" Value="Transparent"/>
							<Setter Property="BorderBrush" Value="Transparent"/>
						</DataTrigger>

						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
 Value="False"/>
								<Condition Binding="{Binding ElementName=PART_ToggleButton, Path=IsMouseOver}" Value="True"/>
							</MultiDataTrigger.Conditions>
							<Setter TargetName="PART_ToggleButton" Property="Background" Value="{StaticResource Black.DropDownButton.BackgroundHoverBrush}"/>
							<Setter TargetName="PART_ImageBorder" Property="Background" Value="{StaticResource Black.ImageBorder.BackgroundHover}"/>
							<Setter TargetName="PART_ToggleButton" Property="BorderBrush" Value="{StaticResource Black.ImageBorder.BackgroundHover}"/>
						</MultiDataTrigger>

						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},
   Path=SelectedTabItem.HasContextTabGroup}"
   Value="False"/>
								<Condition Binding="{Binding RelativeSource={RelativeSource Self},  Path=IsDropDownOpen}"
   Value="True"/>
							</MultiDataTrigger.Conditions>
							<Setter TargetName="PART_ImageBorder" Property="BorderThickness" Value="1"/>
							<Setter TargetName="PART_ImageBorder" Property="Background" Value="{StaticResource Black.ImageBorder.BackgroundChecked}"/>
							<Setter TargetName="PART_ToggleButton" Property="BorderBrush" Value="{StaticResource Black.ImageBorder.BackgroundChecked}"/>
							<Setter TargetName="PART_ToggleButton" Property="Background" Value="{StaticResource Black.DropDownButton.BackgroundHoverSelected}"/>
						</MultiDataTrigger>

						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},
   Path=SelectedTabItem.HasContextTabGroup}"
   Value="True"/>
								<Condition Binding="{Binding ElementName=PART_ToggleButton, Path=IsMouseOver}" 
   Value="True"/>
							</MultiDataTrigger.Conditions>
							<Setter TargetName="PART_ToggleButton" Property="BorderBrush" Value="{StaticResource RibbonBarButton.Context.Hover.BorderBrush}"/>
						</MultiDataTrigger>

						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},
   Path=SelectedTabItem.HasContextTabGroup}"
   Value="True"/>
								<Condition Binding="{Binding RelativeSource={RelativeSource Self},  Path=IsDropDownOpen}"
   Value="True"/>
							</MultiDataTrigger.Conditions>
							<Setter TargetName="PART_ToggleButton" Property="Background" Value="{StaticResource RibbonBarButton.Context.IsDropDownOpen.BackgroundBrush}"/>
							<Setter TargetName="PART_ToggleButton" Property="BorderBrush" Value="{StaticResource RibbonBarButton.Context.IsDropDownOpen.BorderBrush}"/>
						</MultiDataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<Style.Triggers>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
Value="True">
				<Setter Property="Background" Value="{StaticResource RibbonBarButton.Context.BackgroundBrush}"/>
			</DataTrigger>
		</Style.Triggers>
	</Style>

