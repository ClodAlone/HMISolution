                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Luna.PressedBrush.Default}"/>
                                    <Setter TargetName="PART_ToggleButton"  Property="Background" Value="{StaticResource IsDropDownOpenBrush}"/>
                                </MultiTrigger>
                                <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                    <Setter Property="Padding" Value="5" />
                                    <Setter TargetName="PART_Image" Property="Height" Value="48" />
                                    <Setter TargetName="PART_Image" Property="Width" Value="48" />
                                    <Setter Property="Margin" Value="0,21,0,2" TargetName="label"/>
                                    <Setter Property="Width" TargetName="Bd" Value="60"/>
                                    <Setter Property="Height" TargetName="Bd" Value="100"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Default.HoverBorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Default.HoverBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Default.HoverBorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Black.Foreground}"/>
                <Setter Property="Background" Value="{StaticResource DropDownButton.IsDropDownOpen.BackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style BasedOn="{StaticResource Office2007BlackSplitButtonStyle}" TargetType="{x:Type local:SplitButton}"/>

    <!-- MenuButton Style -->
    <Style x:Key="Office2007BlackMenuButtonStyle" TargetType="{x:Type local:MenuButton}">
        <!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
        <!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{StaticResource SkinDictionary}"/>-->
        <Setter Property="Padding" Value="1"/>
        <!--<Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>-->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MenuButton}">
                    <Border x:Name="PART_OutterBorder"
					   BorderThickness="1"
					   BorderBrush="{TemplateBinding BorderBrush}"
					   Background="{TemplateBinding Background}"
					   Opacity="{TemplateBinding Opacity}"
					   IsEnabled="{TemplateBinding IsEnabled}" >
                        <Grid>
                            <Border x:Name="PART_InnerBorder" BorderThickness="1">
                                <DockPanel LastChildFill="True" MaxWidth="{TemplateBinding ActualWidth}" >
                                    <Path Fill="{StaticResource Black.Path.Fill}" Margin="5,16,4,0" DockPanel.Dock="Right"
											  HorizontalAlignment="Center"
											  VerticalAlignment="Center"
											  Data="M 0 0 L 4 4 L 8 0 Z">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <DockPanel DockPanel.Dock="Left" HorizontalAlignment="Stretch" Margin="1,3,3,1">
                                        <Image	   Margin="5,1,5,3"
												   DockPanel.Dock="Left"
												   
												   Source="{Binding Path=Icon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
												   MinWidth="16" MinHeight="16" MaxHeight="32" MaxWidth="32" Stretch="None" />
                                        <StackPanel Orientation="Vertical" Margin="0,0,0,2" VerticalAlignment="Center" DockPanel.Dock="Right">
                                            <TextBlock x:Name="PART_Label" TextTrimming="CharacterEllipsis"
													   TextWrapping="Wrap" TextAlignment="Center"
													   Foreground="{StaticResource Black.Foreground}"
													   VerticalAlignment="Center" HorizontalAlignment="Left"
													   Margin="0,0,0,2"
													   FontWeight="Bold"
													   Text="{TemplateBinding Label}"
													   DockPanel.Dock="Bottom"/>
                                            <local:TwoLinesLayoutPanel HorizontalAlignment="Left">
                                                <TextBlock x:Name="PART_Description" TextWrapping="Wrap" Margin="0,0,10,0" TextAlignment="Left" 
												   Foreground="{StaticResource Black.Foreground}"
												   VerticalAlignment="Center" HorizontalAlignment="Left"
												   Text="{TemplateBinding Description}"/>
                                            </local:TwoLinesLayoutPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </DockPanel>
                            </Border>
                            <local:CustomPopup Name="PART_Popup"
								  Placement="Custom"
								  PlacementTarget ="{Binding Path=PlacementBorder, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ApplicationMenu}}}"
								  Focusable="False"
								  PopupAnimation="Fade"
								  AllowsTransparency="True"
								  StaysOpen="True"
								  IsOpen="{Binding Path=IsMenuOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="true" Margin="0">
                                    <Border Background="{StaticResource Default.QuickDropDownBackground}" BorderThickness="1" CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}" BorderBrush="{StaticResource Default.QuickDropDownBorderBrush}" >
                                        <ScrollViewer x:Name="PART_ScrollViwer" Style="{StaticResource CustomScrollViewerStyle}" >
                                            <ItemsPresenter
											  Margin="{TemplateBinding Control.Padding}"
											  HorizontalAlignment="Stretch"
											  VerticalAlignment="Stretch"
											  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </local:CustomPopup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,3,3"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.OutterBorderBrush}"/>
                            <Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.InnerBorderBrush}"/>
                            <Setter TargetName="PART_InnerBorder"  Property="Background" Value="{StaticResource MenuButton.MouseOverBrush}"/>
                            <Setter TargetName="PART_Description" Property="Foreground" Value="{StaticResource Black.Foreground}"/>
                            <Setter TargetName="PART_Label" Property="Foreground" Value="{StaticResource Black.Foreground}"/>

                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.OutterBorderBrush}"/>
                            <Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.InnerBorderBrush}"/>
                            <Setter TargetName="PART_InnerBorder"  Property="Background" Value="{StaticResource MenuButton.MouseOverBrush}"/>
                            <Setter TargetName="PART_Description" Property="Foreground" Value="{StaticResource Black.Foreground}"/>
                            <Setter TargetName="PART_Label" Property="Foreground" Value="{StaticResource Black.Foreground}"/>

                        </Trigger>
                        <DataTrigger Binding="{Binding Path=Description, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Label" Property="FontWeight" Value="Normal"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2007BlackMenuButtonStyle}" TargetType="{x:Type local:MenuButton}"/>

