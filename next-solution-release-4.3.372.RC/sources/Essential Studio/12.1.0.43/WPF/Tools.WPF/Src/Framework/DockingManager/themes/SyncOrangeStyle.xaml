    <Style x:Key="SyncOrangeCustomMenuItemStyle" TargetType="{x:Type Syncfusion:CustomMenuItem}" >
        <Setter Property="Foreground" Value="{StaticResource TabItemForeground.Orange}"/>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Syncfusion:CustomMenuItem}" >
                    <Border  Name="Bd" 
				 Background="Transparent" 
                 SnapsToDevicePixels="True">
                        <Grid ShowGridLines="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="MenuItemIconColumnGroup" Width="26" MinWidth="17" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition SharedSizeGroup="MenuItemIGTColumnGroup" Width="Auto" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <Border Name="grad" 
                        BorderBrush="{StaticResource MenuItemSeparator.Orange}" 
                        BorderThickness="0, 0, 1, 0" 
                        SnapsToDevicePixels="True" 
                        Background="{StaticResource Blend.MenuItemLeftBarBackground}">
                            </Border>
                            <Border Name="back" 
                        CornerRadius="0" 
                        BorderThickness="1" 
                        SnapsToDevicePixels="True" 
                        Grid.ColumnSpan="4" 
                        Margin="2, 0, 2, 0"
                        BorderBrush="{StaticResource MenuItemBorder.Orange}" 
                        Opacity="0"/>
                            <ContentPresenter ContentSource="Icon" 
                                  ContentTemplate="{TemplateBinding Syncfusion:CustomMenuItem.IconTemplate}"
                                  Margin="0,2,0,0" 
                                  Name="Icon" 
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Center" 
                                  Content="{TemplateBinding MenuItem.Icon}" />
                            <Border 
					Visibility="Hidden" 
					HorizontalAlignment="Left" 
					Margin="4,0,0,0" 
					BorderThickness="1"
					BorderBrush="{StaticResource MenuItemGlyphBorder.Orange}"
					Background="{StaticResource MenuItemGlyphBack.Orange}"
					VerticalAlignment="Center" 
					Width="20" Height="20" 
					Name="GlyphPanel" >
                                <Path Stretch="Fill" 
						  Stroke="{StaticResource MenuItemGlyphForeground.Orange}" 
						  HorizontalAlignment="Center" 
						  Margin="0" 
						  VerticalAlignment="Center" 
						  Width="7.5" 
						  Height="5.875" 
						  Data="M5.375,11.125 L7.75,13.25 11.875,8.375"/>
                            </Border>
                            <ContentPresenter ContentSource="Header" Margin="4,2,4,2" Name="HeaderHost" TextBlock.Foreground="{StaticResource MenuItemForeground1.Orange}"
								  ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}"
								  RecognizesAccessKey="True" VerticalAlignment="Center" Grid.Column="1" >
                            </ContentPresenter>
                            <TextBlock Margin="5,2,0,2" Text="{TemplateBinding MenuItem.InputGestureText}" Grid.Column="2" DockPanel.Dock="Right"
						   Foreground="{StaticResource MenuItemForeground1.Orange}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="MenuItem.Icon" Value="{x:Null}">
                            <Setter Property="UIElement.Visibility" TargetName="Icon" Value="{x:Static Visibility.Collapsed}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="MenuItem.IsChecked" Value="True"/>
                                <Condition Property="Syncfusion:CustomMenuItem.HeaderInIconArea" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="UIElement.Visibility" TargetName="GlyphPanel" Value="{x:Static Visibility.Visible}" />
                            <Setter Property="UIElement.Visibility" TargetName="Icon" Value="{x:Static Visibility.Collapsed}" />
                        </MultiTrigger>
                        <Trigger Property="MenuItem.IsHighlighted" Value="True">
                            <Setter TargetName="back" Property="Opacity" Value="1"/>
                            <Setter TargetName="back" Property="Background"	Value="{StaticResource MenuItemOverBackground.Orange}"/>
                            <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource MenuItemBorder.Orange}" />
                            <Setter TargetName="GlyphPanel" Property="Background" Value="{StaticResource MenuItemGlyphBackMouseOver.Orange}"/>
                            <Setter TargetName="GlyphPanel" Property="BorderBrush" Value="{StaticResource MenuItemGlyphBorderMouseOver.Orange}"/>
                            <Setter TargetName="HeaderHost" Property="TextBlock.Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="UIElement.IsEnabled" Value="False">
                            <Setter Property="TextElement.Foreground" TargetName="HeaderHost" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </Trigger>
                        <Trigger Property="Syncfusion:CustomMenuItem.HeaderInIconArea" Value="True">
                            <Setter TargetName="HeaderHost" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="HeaderHost" Property="Grid.ColumnSpan" Value="2"/>
                        </Trigger>


                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

