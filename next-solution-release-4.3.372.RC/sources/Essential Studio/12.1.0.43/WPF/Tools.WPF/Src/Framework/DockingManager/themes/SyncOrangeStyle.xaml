            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=CenterButtonActiveSide, RelativeSource={RelativeSource FindAncestor
							   , AncestorType={x:Type Syncfusion:DockPreviewMainButtonVS2005}}}" 
							   Value="Tabbed" />
                    <Condition Binding="{Binding Path=IsDisableCenter, RelativeSource={RelativeSource AncestorType={x:Type Syncfusion:DockPreviewMainButtonVS2005}}}"
							   Value="False" />
