                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Syncfusion:FloatWindowBorder}">
                            <Border Name="border"
				Margin="0"
				BorderThickness="0"
				BorderBrush="{StaticResource FloatHeaderBorderBrush.Orange}"
				Background="{StaticResource FloatHeaderMiddleBackground.Orange}"
			/>


                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Path=IsKeyboardFocusWithin
						, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:IWindow}}}"
						Value="False" >
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource FloatHeaderMiddleBackgroundInactive.Orange}"/>
                                </DataTrigger>

                                <Trigger SourceName="border" Property="Visibility" Value="Visible">
                                    <Setter  TargetName="border" Property="Background" 
						Value="{Binding Path=(Syncfusion:IWindow.DockingManager).(Syncfusion:DockingManager.RightFloatWindowTopBorderBrush), RelativeSource={RelativeSource AncestorType={x:Type Syncfusion:IWindow}}}" />
