                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition 
						Binding="{Binding Path=(Syncfusion:IWindow.DockingManager).(Syncfusion:DockingManager.IsEnableHotTracking),
							RelativeSource={RelativeSource AncestorType={x:Type Syncfusion:IWindow}}}" Value="True" />
                                        <Condition Binding="{Binding Path=IsMouseOver
						, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:IWindow}}}"
