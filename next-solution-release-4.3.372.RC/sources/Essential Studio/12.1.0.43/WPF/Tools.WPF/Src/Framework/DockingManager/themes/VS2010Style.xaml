                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Syncfusion:TabControlExt}">
                            <Border BorderBrush="{StaticResource TabControlBorderBrush}" Margin="0" BorderThickness="2">
                                <Border BorderBrush="{StaticResource VS2010.TabPanelBottomBackgroundBrush}" Name="btborder" CornerRadius="1.5">
