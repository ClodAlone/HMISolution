                                        <Condition Property="TabControl.TabStripPlacement" Value="Left" />
                                        <Condition Property="Syncfusion:TabControlExt.RotateTextWhenVertical" Value="True" />
                                        <Condition Property="FlowDirection" Value="RightToLeft" />
