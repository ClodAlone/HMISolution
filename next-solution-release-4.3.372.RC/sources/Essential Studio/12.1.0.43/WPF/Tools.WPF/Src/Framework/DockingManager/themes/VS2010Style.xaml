        </Canvas>
        <ControlTemplate.Triggers>
            
            <Trigger Property="Visibility" SourceName="PART_ScrollButtons" Value="Visible">
                <Setter Property="Canvas.Top" TargetName="PART_BorderName" Value="{Binding ActualWidth,ElementName=PART_ScrollButtons}" />
                <Setter TargetName="PART_BorderSeparator" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Visibility" SourceName="PART_ScrollButtons" Value="Collapsed">
                <Setter Property="Canvas.Top" TargetName="PART_BorderName" Value="0" />
                <Setter TargetName="PART_BorderSeparator" Property="Visibility" Value="Collapsed" />
