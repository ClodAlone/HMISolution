    <SolidColorBrush x:Key="TabControlBorderBrush" Color="#FF293955" />

    <Style x:Key="VS2010TabControlStyle" TargetType="{x:Type Syncfusion:TabControlExt}">
        <Setter Property="TabPanelStyle" Value="{StaticResource VS2010TabPanelAdvStyle}" />
        <Setter Property="TabPanelBackground" Value="{StaticResource VS2010.TabPanelBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource VS2010.InactiveForeground}" />
