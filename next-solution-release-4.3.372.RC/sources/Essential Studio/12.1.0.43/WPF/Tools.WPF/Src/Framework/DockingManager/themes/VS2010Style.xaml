                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" Name="RowDefinition0" />
                                            <RowDefinition Height="*" Name="RowDefinition1" />
                                        </Grid.RowDefinitions>
                                        <Syncfusion:HeaderPanel Name="HeaderPanel" Grid.Column="0" Grid.Row="0" Panel.ZIndex="1"  
							   Focusable="False" Background="#FF293955"
							   HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Syncfusion:TabPanelAdv x:Name="PART_TabPanel" Focusable="False" DockPanel.Dock="Right"  
                                               HorizontalAlignment="Left" VerticalAlignment="Top"                                              
