<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:system="clr-namespace:System;assembly=mscorlib"
  xmlns:Syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls"
                    	xmlns:sys="clr-namespace:System;assembly=mscorlib"
						xmlns:Sync_Resources="clr-namespace:Syncfusion.Windows.Tools.Controls.Resources"
	xmlns:pc="clr-namespace:System.Windows;assembly=PresentationCore"
	xmlns:pf="clr-namespace:System.Windows;assembly=PresentationFramework" xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
  xmlns:utilsOuter="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF" 
                    xmlns:shell="clr-namespace:Syncfusion.Windows;assembly=Syncfusion.Shared.Wpf">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Controls/TabControlExt/Themes/VS2010Style.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Sync_Resources:ResourceWrapper x:Key="ResourceWrapperKey" />
    <!--Tab-->
    <!--<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls" xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">-->

    <!-- Brushes -->
    <SolidColorBrush x:Key="VS2010.TabControlBackgroundBrush" Color="White" />
    <LinearGradientBrush x:Key="VS2010.TabPanelBackgroundBrush" StartPoint="0.5, 0" EndPoint="0.5,1">
        <GradientStop Color="#D9D9E6" Offset="0" />
        <GradientStop Color="#FEFEFE" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="VS2010.TabPanelBottomBackgroundBrush" Color="#FFFFE8A6" />
    <Thickness x:Key="VS2010.TabPanelPadding" Left="0" Top="2" Right="0" Bottom="0" />
    <Thickness x:Key="VS2010.TabPanelMargin" Left="0" Top="0" Right="0" Bottom="0" />
    <Thickness x:Key="VS2010.ContentPanelBorderThickness" Left="0" Top="0" Right="0" Bottom="0" />
    <CornerRadius x:Key="VS2010.ContentPanelBorderCornerRadius" TopLeft="0" TopRight="0" BottomRight="0" BottomLeft="0" />
    <Thickness x:Key="VS2010.ContentPanelInnerBorderThickness" Left="0" Top="0" Right="0" Bottom="0" />
    <Thickness x:Key="VS2010.ContentPanelInnerBorderMargin" Left="0" Top="0" Right="0" Bottom="0" />
    <Thickness x:Key="VS2010.ContentPanelOuterBorderThickness" Left="2" Top="2" Right="2" Bottom="2" />
    <Thickness x:Key="VS2010.TabItemBorderThickness" Left="1" Top="1" Right="1" Bottom="0" />
    <CornerRadius x:Key="VS2010.TabBorderCornerRadius" TopLeft="0" TopRight="0" BottomLeft="0" BottomRight="0" />
    <Thickness x:Key="VS2010.TabMargin" Left="1" Top="0" Right="1" Bottom="0" />
    <Thickness x:Key="VS2010.TabSelectedMargin" Left="1" Top="0" Right="1" Bottom="0" />
    <!--<LinearGradientBrush x:Key="TabBackground.Office2003" StartPoint="0.5, 0" EndPoint="0.5,1">
        <GradientStop Color="#D9D9E6" Offset="0"/>
        <GradientStop Color="#FEFEFE" Offset="0.9"/>
    </LinearGradientBrush>-->
    <SolidColorBrush x:Key="TabBackground.Office2003" Color="White" />
    <SolidColorBrush x:Key="VS2010.ActiveForeground" Color="Black" />
    <SolidColorBrush x:Key="VS2010.InactiveForeground" Color="White" />
    <SolidColorBrush x:Key="VS2010.TabBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TabHoverBorderBrush" Color="#FF9BA7B7" />
    <SolidColorBrush x:Key="VS2010.TabSelectedBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="VS2010.TabHoverSelectedBorderBrush" Color="#4B4B6F" />
    <SolidColorBrush x:Key="VS2010.TabSubLineBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="VS2010.TabBottomBorderBrush" Color="#4B4B6F" />
    <SolidColorBrush x:Key="VS2010.ButtonActivePathBrush" Color="Black" />
    <SolidColorBrush x:Key="VS2010.ButtonInactivePathBrush" Color="#FFCED4DD" />
    <SolidColorBrush x:Key="VS2010.ButtonInactiveBorderBrush" Color="Transparent" />
    <!--<SolidColorBrush x:Key="VS2010.ContentPanelBackgroundBrush" Color="Transparent"/>-->
    <SolidColorBrush x:Key="VS2010.ContextMenuBackgroundBrush" Color="#F6F6F6" />
    <SolidColorBrush x:Key="VS2010.ContextMenuBorderBrush" Color="#000080" />
    <SolidColorBrush x:Key="VS2010.ContextMenuBarBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="VS2010.ContextMenuBarInnerBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="VS2010.MenuItemBorderBrush" Color="#000080" />
    <SolidColorBrush x:Key="VS2010.MenuItemActiveForeground" Color="Black" />
    <SolidColorBrush x:Key="VS2010.MenuItemInactiveForeground" Color="Black" />
    <SolidColorBrush x:Key="VS2010.ButtonBackgroundBrush" Color="#FFFFFCF4" />
    <SolidColorBrush x:Key="VS2010.TabBackgroundBrush" Color="Transparent" />

    <LinearGradientBrush x:Key="VS2010.TabHoverBackgroundBrush" StartPoint="0.5, 0" EndPoint="0.5, 1">
        <GradientStop Color="#FDF1C0" Offset="0" />
        <GradientStop Color="#F7C25F" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VS2010.TabSelectedBackgroundBrush" StartPoint="0.5, 0" EndPoint="0.5, 1">
        <GradientStop Color="#F7D778" Offset="0" />
        <GradientStop Color="#E8820C" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="VS2010.MenuItemBackgroundBrush" Color="#FFEEC2" />
    <LinearGradientBrush x:Key="VS2010.ContextMenuBarBackgroundBrush" StartPoint="0,0"
		EndPoint="1,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#E3EFFF" Offset="0" />
            <GradientStop Color="#87ADE4" Offset="1" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <Syncfusion:ImageAlignmentToDockConverter x:Key="ImageAlignmentToDockConverter" />

    <DataTemplate x:Key="HeaderDataTemplate" DataType="{x:Type Syncfusion:TabItemExt}">
        <TextBlock Focusable="False" Text="{Binding}" TextTrimming="CharacterEllipsis" 
				   IsHitTestVisible="False" Padding="4,0,4,1" />
    </DataTemplate>

    <DataTemplate x:Key="EditableDataTemplate" DataType="{x:Type Syncfusion:TabItemExt}">
        <TextBox x:Name="EditableHeader" Focusable="True" Style="{Binding Path=EditHeaderItemStyle, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:TabControlExt}}}"
				 Text="{Binding Path=Header, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:TabItemExt}}, Mode=TwoWay}"  
				 IsReadOnly="False" Padding="4,1,4,1" />
    </DataTemplate>

    <LinearGradientBrush x:Key="background" EndPoint="0,1" StartPoint="0,0"
		>
        <GradientStop Color="#FFFCFDFD" Offset="0" />
        <GradientStop Color="#FFE5EAF5" Offset="0.3" />
        <GradientStop Color="#FFCFD7EB" Offset="0.3" />
        <GradientStop Color="#FFE0E5F5" Offset="0.7" />
        <GradientStop Color="#FFECEEFC" Offset="1" />
    </LinearGradientBrush>


    <ControlTemplate TargetType="{x:Type TabItem}" 
                                     x:Key="newtabitem">
        <Border BorderThickness="0" 
                                Margin="2,0,0,0" Name="Bd"
                                BorderBrush="Red" 
                                Background="{StaticResource background}"
                                CornerRadius="5,5,0,0">
        </Border>
    </ControlTemplate>


    <Syncfusion:CloseButtonTypeToVisibilityConverter x:Key="CloseButtonTypeToVisibilityConverter" />
    <utilsOuter:BooleanToVisibilityConverterEx x:Key="BooleanToVisibilityConverterEx" />

    <ControlTemplate x:Key="VS2010CloseButtonTemplate" TargetType="{x:Type ButtonBase}">
        <utilsOuter:Border3D x:Name="brdBack" BorderThickness="1"
                BorderBrush="{StaticResource VS2010.ButtonInactiveBorderBrush}">
            <Path Name="pathButton" SnapsToDevicePixels="True"
				Stroke="{StaticResource VS2010.ButtonInactivePathBrush}"
				StrokeThickness="1.5"
                Data="M1,1 L7,7 M1,7 L7,1"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8" />
        </utilsOuter:Border3D>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="brdBack" Property="IsInverted" Value="True" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" 
						TargetName="brdBack" Value="{StaticResource VS2010.ButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" 
						TargetName="brdBack" Value="#FFE5C365" />
                <!--<Setter TargetName="brdBack" Property="Background" Value="{StaticResource VS2010.ButtonBackgroundBrush}"/>-->
                <Setter TargetName="pathButton" Property="Stroke" Value="{StaticResource VS2010.ButtonActivePathBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="VS2010CloseButtonTemplate1" TargetType="{x:Type ButtonBase}">
        <utilsOuter:Border3D x:Name="brdBack" BorderThickness="1"
                SnapsToDevicePixels="True" 
                BorderBrush="{StaticResource VS2010.ButtonInactiveBorderBrush}">
            <Path Name="pathButton" SnapsToDevicePixels="True"
				Stroke="#FF75633D"
				StrokeThickness="1.5"
                Data="M1,1 L7,7 M1,7 L7,1"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8" />
        </utilsOuter:Border3D>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="brdBack" Property="IsInverted" Value="True" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" 
						TargetName="brdBack" Value="{StaticResource VS2010.ButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" 
						TargetName="brdBack" Value="#FFE5C365" />
                <!--<Setter TargetName="brdBack" Property="Background" Value="{StaticResource VS2010.ButtonBackgroundBrush}"/>-->
                <Setter TargetName="pathButton" Property="Stroke" Value="{StaticResource VS2010.ButtonActivePathBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="VS2010MenuButtonTemplate" TargetType="{x:Type ButtonBase}">
        <utilsOuter:Border3D x:Name="brdBack" BorderThickness="1"
                BorderBrush="{StaticResource VS2010.ButtonInactiveBorderBrush}">
            <Path Name="pathButton" SnapsToDevicePixels="True"
				Fill="{StaticResource VS2010.ButtonInactivePathBrush}"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8">
                <Path.Data>
                    <GeometryGroup>
                        <PathGeometry>
                            <PathFigure StartPoint="0,1" IsFilled="True" IsClosed="True">
                                <LineSegment Point="8,1" />
                                <LineSegment Point="8,3" />
                                <LineSegment Point="0,3" />
                            </PathFigure>
                        </PathGeometry>
                        <PathGeometry>
                            <PathFigure StartPoint="0,4" IsFilled="True" IsClosed="True">
                                <LineSegment Point="4,8" />
                                <LineSegment Point="8,4" />
                            </PathFigure>
                        </PathGeometry>
                    </GeometryGroup>
                </Path.Data>
            </Path>
        </utilsOuter:Border3D>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=IsAllItemsVisible,RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter TargetName="pathButton" Property="Data" Value="M0,4 L4,8 L8,4 z" />
            </DataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="brdBack" Property="IsInverted" Value="True" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="brdBack" Property="Background" 
						Value="{StaticResource VS2010.ButtonBackgroundBrush}" />
                <Setter TargetName="pathButton" Property="Fill" Value="{StaticResource VS2010.ButtonActivePathBrush}" />
                <!--<Setter Property="Background" TargetName="brdBack" Value="{StaticResource VS2010.ButtonBackgroundBrush}"/>-->
                <Setter Property="BorderBrush" 
						TargetName="brdBack" Value="#FFE5C365" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <SolidColorBrush x:Key="TabPanelBackground" Color="#FF2C3D5A" />
    <Style x:Key="VS2010TabPanelAdvStyle" TargetType="{x:Type Syncfusion:TabPanelAdv}">
        <Setter Property="Background"
                Value="{StaticResource TabPanelBackground}" />
        <Setter Property="Padding" Value="0,2,0,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Syncfusion:TabPanelAdv}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
							Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}"
							CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <!--<Border Background="Transparent"  BorderThickness="0,0,0,4" BorderBrush="{StaticResource Office2003.TabPanelBottomBackgroundBrush}"  CornerRadius="2" >-->

                        <DockPanel LastChildFill="True">
                            <Border Name="BottomBorder" Height="4" DockPanel.Dock="Bottom" Background="{StaticResource VS2010.TabPanelBottomBackgroundBrush}" CornerRadius="1.5,1.5,0,0" />


                            <ContentPresenter x:Name="PART_CustomItems" AllowDrop="False" ContentSource="TabPanelItem"
                                              MaxHeight="{Binding Path=ActualHeight, ElementName=PART_TabItems}" Margin="2,0,0,0" DockPanel.Dock="Right" 
                                              Content="{Binding Path=TabPanelItem, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:TabControlExt}}}">

                            </ContentPresenter>
                            <Syncfusion:NewTabLayout>
                                <ContentPresenter x:Name="PART_ToolBarTray" Content="{Binding Path=ToolBarTray, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:TabControlExt}}}" />
                                <Syncfusion:TabItemExt BorderThickness="80" x:Name="PART_NewTab" DockPanel.Dock="Top" IsNewTab="True" />
                            </Syncfusion:NewTabLayout>
                            <ToggleButton Name="PART_CloseButton" Width="14" Height="14" 
                                  DockPanel.Dock="Right"
                                  Focusable="False" 
                                  AllowDrop="False"
                                  Visibility="{Binding Path=CloseButtonType, Converter={StaticResource CloseButtonTypeToVisibilityConverter}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:TabControlExt}}}"
							      Template="{StaticResource VS2010CloseButtonTemplate}"
                                  Command="Syncfusion:TabControlCommands.CloseCurrentTabItem" 
                                  />

                            <ToggleButton Name="PART_MenuButton" Width="14" Height="14" 
                                  DockPanel.Dock="Right"
                                  AllowDrop="False"
                                  Focusable="True"
                                  Visibility="{Binding Path=ShowTabListContextMenu, Converter={StaticResource BooleanToVisibilityConverterEx}, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:TabControlExt}}}"
							      Template="{StaticResource VS2010MenuButtonTemplate}"
                                  Command="Syncfusion:TabControlCommands.OpenContextMenu"
                                  />

                            <ContentPresenter x:Name="PART_TabItems" ContentSource="TabItems" 
                                              DockPanel.Dock="Right" 
                                              Content="{TemplateBinding Content}" />


                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=IsFocus,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:TabControlExt}}}" Value="False">
                            <Setter TargetName="BottomBorder" Property="Background" 
						Value="#FFCED4DF" />
                            <Setter TargetName="BottomBorder" Property="BorderBrush" Value="#FFCED4DF" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Path=IsTabGroupFocus,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:TabControlExt}}}" Value="False">
                            <Setter TargetName="BottomBorder" Property="Background" 
						Value="#FF3D5277" />
                            <Setter TargetName="BottomBorder" Property="BorderBrush" Value="#FF3D5277" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsFirstTabItemSelected,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:TabControlExt}}}" Value="False">
                            <Setter TargetName="BottomBorder" Property="CornerRadius" Value="1.5,1.5,0,0" />

                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsFirstTabItemSelected,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:TabControlExt}}}" Value="True">
                            <Setter TargetName="BottomBorder" Property="CornerRadius" Value="0,1.5,0,0" />

                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=TabStripPlacement,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}}" Value="Bottom">
                            <Setter Property="LayoutTransform" TargetName="PART_CustomItems">
                                <Setter.Value>
                                    <RotateTransform Angle="-180" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="LayoutTransform" TargetName="PART_CloseButton">
                                <Setter.Value>
                                    <RotateTransform Angle="-180" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="LayoutTransform" TargetName="PART_MenuButton">
                                <Setter.Value>
                                    <RotateTransform Angle="-180" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsAllTabsClosed,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:TabControlExt}}}" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_MenuButton" Property="Visibility" Value="Hidden" />
                            <!--<Setter TargetName="BottomBorder" Property="Height" Value="0"/>-->
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VS2010DragMarkerStyle" TargetType="{x:Type utilsOuter:TemplatedAdornerInternalControl}">
        <Setter Property="MinWidth" Value="15" />
        <Setter Property="MinHeight" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type utilsOuter:TemplatedAdornerInternalControl}">
                    <Canvas x:Name="PART_Arrow" HorizontalAlignment="Left" VerticalAlignment="Top" Height="9" Width="8">
                        <Canvas.RenderTransform>
                            <TranslateTransform X="8" Y="-10" />
                        </Canvas.RenderTransform>
                        <Path Data="M3,0L3,7 L1,7 L4.5,10 L8,7 L6,7 L6,0 L2.5,0" Fill="{Binding Path=MarkerColor,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:DragMarkerAdorner}}}" Stroke="Black" />
                    </Canvas>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=AdornerAlignment,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:DragMarkerAdorner}}}" Value="RightSide">
                            <Setter Property="RenderTransform" TargetName="PART_Arrow">
                                <Setter.Value>
                                    <TranslateTransform X="-1.5" Y="-10" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--<Style BasedOn="{StaticResource VS2010DragMarkerStyle}" TargetType="{x:Type utilsOuter:TemplatedAdornerInternalControl}"/>-->
    <system:Double x:Key="NanValue">
        NaN
    </system:Double>


    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#FF6A7376" />
    <!--<SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#FFFFE8A6"/>-->

    <LinearGradientBrush x:Key="TabSelectedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFAEB" Offset="0" />
        <GradientStop Color="#FFFFF3CF" Offset="0.404" />
        <GradientStop Color="#FFFFE8A6" Offset="0.452" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TabItemUnfocusedBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF7F8F9" Offset="0.032" />
        <GradientStop Color="#FFCED4DF" Offset="0.455" />
    </LinearGradientBrush>
    <Style x:Key="VS2010TabItemStyle" TargetType="{x:Type Syncfusion:TabItemExt}">
        <Setter Property="Foreground" Value="{StaticResource VS2010.InactiveForeground}" />
        <Setter Property="FrameworkElement.FocusVisualStyle">
            <Setter.Value>
                <Style TargetType="IFrameworkInputElement">
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <x:Null />
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Background"
                Value="{StaticResource VS2010.TabBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VS2010.TabBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="HeaderMargin" Value="6,0,0,1" />
        <Setter Property="IconMargin" Value="0,0,0,4" />
        <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Control.VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Syncfusion:TabItemExt}">
                    <utilsOuter:Border3D Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" 
           
            CornerRadius="2,2,0,0" Margin="-1,0,0,0" Padding="2"
            VerticalAlignment="Stretch"
            SnapsToDevicePixels="True"
			ToolTip="{Binding Path=ItemToolTip, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:TabItemExt}}}"
			>
                        <DockPanel x:Name="PART_DockPanel" LastChildFill="True">
                            <ToggleButton Name="PART_CloseButton" Width="15" Height="14" Margin="1,0,1,0"
                                  VerticalAlignment="Top"
                                  DockPanel.Dock="Right" 
                                  Focusable="False"
                                  Visibility="Hidden"
							      Template="{StaticResource VS2010CloseButtonTemplate}"
                                  Command="Syncfusion:TabControlCommands.CloseTabItem"
                                  />
                            <Image x:Name="PART_Image"
					   Source="{TemplateBinding Syncfusion:TabControlExt.Image}"
					   Height="{TemplateBinding Syncfusion:TabControlExt.ImageHeight}"
					   Width="{TemplateBinding Syncfusion:TabControlExt.ImageWidth}"
					   Stretch="Fill" Margin="{TemplateBinding IconMargin}" 
					   SnapsToDevicePixels="True" VerticalAlignment="Center"                           
					   DockPanel.Dock="{Binding Path=(Syncfusion:TabControlExt.ImageAlignment), Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ImageAlignmentToDockConverter}}" />
                            <ContentPresenter ContentSource="Header" x:Name="Content" Margin="{TemplateBinding HeaderMargin}" TextElement.Foreground="White"
                                          RecognizesAccessKey="True" Content="{TemplateBinding HeaderedContentControl.Header}" 
                                          ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}"                                           
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                          SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                        </DockPanel>
                    </utilsOuter:Border3D>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Syncfusion:TabControlExt.ImageHeight" Value="{StaticResource NanValue}">
                            <Setter TargetName="PART_Image" Property="Stretch" Value="Uniform" />
                        </Trigger>
                        <Trigger Property="Syncfusion:TabControlExt.ImageWidth" Value="{StaticResource NanValue}">
                            <Setter TargetName="PART_Image" Property="Stretch" Value="Uniform" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Syncfusion:TabControlExt.ImageHeight" Value="{StaticResource NanValue}" />
                                <Condition Property="Syncfusion:TabControlExt.ImageWidth" Value="{StaticResource NanValue}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Image" Property="Stretch" Value="None" />
                        </MultiTrigger>
                        <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Content"
						Property="TextElement.Foreground" Value="{StaticResource VS2010.ActiveForeground}" />
                            <Setter TargetName="Bd" Property="Background" 
						Value="{StaticResource TabSelectedBackgroundBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource VS2010.TabSelectedBorderBrush}" />
                            <!--<Setter TargetName="Bd" Property="Margin" Value="-1,0,0,-3"/>-->
                            <Setter TargetName="PART_CloseButton" Property="Template" Value="{StaticResource VS2010CloseButtonTemplate1}" />
                            <Setter Property="TextElement.FontWeight" TargetName="Content"
						Value="{Binding Path=SelectedItemFontWeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Syncfusion:TabControlExt}}}" />

                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=IsMouseOver, ElementName=Bd}" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TabHoverBorderBrush}" />
                            <Setter TargetName="Bd" Property="Background" 
						Value="{StaticResource TabHoverBackgroundBrush}" />
                            <!--<Setter TargetName="Bd" Property="Margin" Value="0,1,0,0" />-->
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}"
								Value="True" />
                                <Condition Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Path=IsFocus,RelativeSource={RelativeSource Self}}" Value="False" />
