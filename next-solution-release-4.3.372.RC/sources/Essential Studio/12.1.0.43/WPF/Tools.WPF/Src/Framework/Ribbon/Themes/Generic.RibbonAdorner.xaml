<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    >
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Silver.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Black.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Default.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Office2003.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyBlue.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.Blend.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Tools.WPF;component/Framework/Ribbon/Themes/Generic.Brushes.ShinyRed.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    
    <Style x:Key="{x:Type local:RibbonAdorner}" TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
        <Setter Property="MinWidth" Value="15"/>
        <Setter Property="MinHeight" Value="15"/>
        <Setter Property="Control.FontSize" Value="11.5"/>
        <Setter Property="Control.FontFamily" Value="Segoe UI"/>
        <Setter Property="Control.Foreground" Value="{StaticResource Blue.Foreground}" />
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shared:TemplatedAdornerInternalControl}">
                    <Border x:Name="PART_InnerBorder" CornerRadius="2" BorderThickness="1"  BorderBrush="#FF767676" Background="{StaticResource AdornerBrush}" >
                        <TextBlock Margin="2,0,2,0" 				
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Text ="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:RibbonAdorner}}, Path=Text}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                            <Setter Property="Background" TargetName="PART_InnerBorder" Value="{StaticResource AdornerBrush}"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                            <Setter Property="Background" TargetName="PART_InnerBorder" Value="{StaticResource AdornerBrush}"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                            <Setter Property="Background" TargetName="PART_InnerBorder" Value="{StaticResource Office2003.AdornerBrush}"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                            <Setter Property="Background" TargetName="PART_InnerBorder" Value="{StaticResource Blend.AdornerBrush}"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                            <Setter Property="Background" TargetName="PART_InnerBorder" Value="{StaticResource AdornerBrush.ShinyBlue}"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                            <Setter Property="Background" TargetName="PART_InnerBorder" Value="{StaticResource AdornerBrush.ShinyRed}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:RibbonAdorner}}, Path=Enabled}" Value="False">
                            <Setter TargetName="PART_InnerBorder" Property="Opacity" Value="0.4"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Foreground" Value="{StaticResource Black.Foreground}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Foreground" Value="{StaticResource Silver.Foreground}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}" />
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Foreground" Value="{StaticResource TextBrushKey.ShinyBlue}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>