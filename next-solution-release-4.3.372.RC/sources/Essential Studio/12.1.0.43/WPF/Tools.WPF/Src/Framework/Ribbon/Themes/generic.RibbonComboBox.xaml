                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office2003.MenuButton.MouseOverBrush}"/>
                <Setter Property="ComboBoxItem.Foreground" Value="{StaticResource Blue.Foreground}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="RibbonComboBoxItemTemplate.Blend" TargetType="{x:Type local:RibbonComboBoxItem}">
        <Border Name="Bd" CornerRadius="2" Height="22" Margin="1,0,1,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="true">
            <ContentPresenter Margin="2" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="true">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Blend.HoverBorderBrush}"/>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Luna.MouseOverBrush.Blend}"/>
                <Setter Property="ComboBoxItem.Foreground" Value="{StaticResource Blend.Foreground3}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    

    <Style x:Key="{x:Type local:RibbonComboBoxItem}" TargetType="{x:Type local:RibbonComboBoxItem}">
        <Setter Property="Background"  Value="{StaticResource Default.ComboBoxItemBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template" Value="{StaticResource RibbonComboBoxItemTemplate.Office2007Blue}"/>  
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="Background"  Value="{StaticResource Default.ComboBoxItemBrush}"/>
                <Setter Property="Template" Value="{StaticResource RibbonComboBoxItemTemplate.Office2007Black}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="Background"  Value="{StaticResource Default.ComboBoxItemBrush}"/>
                <Setter Property="Template" Value="{StaticResource RibbonComboBoxItemTemplate.Office2007Silver}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="Background"  Value="{StaticResource Default.ComboBoxItemBrush}"/>
                <Setter Property="Template" Value="{StaticResource RibbonComboBoxItemTemplate.Office2003}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="Background" Value="{StaticResource Blend.ComboBoxItemBrush}"/>
                <Setter Property="Template" Value="{StaticResource RibbonComboBoxItemTemplate.Blend}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="Background" Value="{StaticResource ComboBoxItemBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="Template" Value="{StaticResource RibbonComboBoxItemTemplate.ShinyRed}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="Background"  Value="{StaticResource ComboBoxItemBackgroundBrushKey.ShinyBlue}"/>
                <Setter Property="Template" Value="{StaticResource RibbonComboBoxItemTemplate.ShinyBlue}"/>
            </Trigger>
           
        </Style.Triggers>
    
    </Style>
