			<Trigger Property="ResizeDirection" Value="VerticalOnly">
				<Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay,  Path=VerticalOffset}"/>
				<Setter TargetName="PART_ResizeThumb" Property="Template" Value="{StaticResource VerticalOnlyResizeThumb}" />
				<Setter TargetName="PART_ResizeThumb" Property="HorizontalAlignment" Value="Center" />
			</Trigger>

			<Trigger Property="PopupPosition" Value="Above">
				<Setter TargetName="PART_ThumbBorder" Property="DockPanel.Dock" Value="Top"/>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNESW" TargetName="PART_ResizeThumb" />
			</Trigger>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Blend.RibbonMouseOverBrush}" />
				<Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="Transparent"/>
			</Trigger>
			<Trigger Property="IsDropDownOpen" Value="True">
				<Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="{StaticResource Blend.GalleryOuterHoverBorderBrush}"/>
				<Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Blend.GalleryHoverBorderBrush}"/>
			</Trigger>
			<Trigger Property="ResizeDirection" Value="NoResize">
				<Setter Property="Visibility" Value="Collapsed" TargetName="PART_ResizeThumb"/>
			</Trigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=PopupPosition}" Value="Above"/>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=FlowDirection}" Value="RightToLeft"/>
				</MultiDataTrigger.Conditions>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNWSE" TargetName="PART_ResizeThumb" />
			</MultiDataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>



	<!--ExtraSmall Template-->
	<ControlTemplate x:Key="ExtraSmallGalleryTemplate" TargetType="{x:Type local:RibbonGallery}">
		<Border Name="PART_OuterBorder" BorderThickness="1" Height="23" Width="33" CornerRadius="1" BorderBrush="Transparent">
			<Border Name="PART_ToggleButton"
				  Height="23" CornerRadius="1" Width="33"
				  BorderThickness="{TemplateBinding BorderThickness}"
							  BorderBrush="{TemplateBinding BorderBrush}"
							  Background="{TemplateBinding Panel.Background}">
				<Grid >
					<Grid.ColumnDefinitions>
						<ColumnDefinition/>
						<ColumnDefinition/>
					</Grid.ColumnDefinitions>
					<Border Grid.Column="0"
							VerticalAlignment="Center"
				HorizontalAlignment="Center">
						<Image Margin="1" 
				 Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
								 Width="16"
				 Height="16" />
					</Border>
					<Path Grid.Column="1"
						Fill="{StaticResource Blend.PathFill}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Data="M 0 0 L 4 4 L 8 0 Z"
						Margin="1"/>
					<Popup Name="PART_Popup"
			 MinWidth="{TemplateBinding ExpandWidth}"
			 MinHeight="{TemplateBinding ExpandHeight}"
			 Placement="Bottom"
			 Focusable="False"
			 AllowsTransparency="True"
			 StaysOpen="False"
			 PopupAnimation="Fade"
			 IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonGallery}}}">

						<mwt:SystemDropShadowChrome x:Name="PART_Shadow"
									  SnapsToDevicePixels="True"
									  ClipToBounds="True">

							<Border Background="{StaticResource Blend.QuickDropDownBackground}" VerticalAlignment="Stretch"
					BorderThickness="1"
					CornerRadius="{StaticResource Blend.QuickDropDownCornerRadius}"
					BorderBrush="{StaticResource Blend.QuickDropDownBorderBrush}">

								<DockPanel  VerticalAlignment="Stretch"
						 SnapsToDevicePixels="True">

									<Border Name="PART_ThumbBorder"
						   DockPanel.Dock="Bottom"
						   BorderThickness="0,1,0,0"
						   BorderBrush="#DDE7EE"
						   Background="{StaticResource Blend.GalleryBottomBackground}">
										<local:PopupResizeThumb  Name="PART_ResizeThumb"/>
									</Border>

									<local:GalleryFilterSelector DockPanel.Dock="Top"/>

									<Grid DockPanel.Dock="Top">
										<Grid.RowDefinitions>
											<RowDefinition MinHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
											<RowDefinition Height="Auto" MinHeight="0"/>
										</Grid.RowDefinitions>
										<ScrollViewer Grid.Row="0">
											<ItemsPresenter VerticalAlignment="Top"/>
										</ScrollViewer>

										<local:RibbonMenuGroup Visibility="{TemplateBinding MenuItems, Converter={StaticResource CountToVisibilityConverter}}"
					  Grid.Row="1" IconBarEnabled="{TemplateBinding MenuIconBarEnabled}"
					  ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=MenuItems}"/>
									</Grid>
								</DockPanel>
							</Border>
						</mwt:SystemDropShadowChrome>
					</Popup>
				</Grid>
			</Border>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
				<Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
			</Trigger>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Blend.RibbonMouseOverBrush}" />
				<Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="Transparent"/>
			</Trigger>
			<Trigger Property="IsDropDownOpen" Value="True">
				<Setter Property="BorderBrush" TargetName="PART_OuterBorder" Value="{StaticResource Blend.GalleryOuterHoverBorderBrush}"/>
				<Setter Property="BorderBrush" TargetName="PART_ToggleButton" Value="{StaticResource Blend.GalleryHoverBorderBrush}"/>
			</Trigger>

			<Trigger Property="ResizeDirection" Value="HorizontalAndVertical">
				<Setter TargetName="PART_Popup" Property="Width"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=HorizontalOffset}"/>
				<Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=VerticalOffset}"/>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb" >
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNESW" TargetName="PART_ResizeThumb" />
			</Trigger>

			<Trigger Property="ResizeDirection" Value="VerticalOnly">
				<Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay,  Path=VerticalOffset}"/>
				<Setter TargetName="PART_ResizeThumb" Property="Template" Value="{StaticResource VerticalOnlyResizeThumb}" />
				<Setter TargetName="PART_ResizeThumb" Property="HorizontalAlignment" Value="Center" />
			</Trigger>

			<Trigger Property="PopupPosition" Value="Above">
				<Setter TargetName="PART_ThumbBorder" Property="DockPanel.Dock" Value="Top"/>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNESW" TargetName="PART_ResizeThumb" />
			</Trigger>
			<Trigger Property="ResizeDirection" Value="NoResize">
				<Setter Property="Visibility" Value="Collapsed" TargetName="PART_ResizeThumb"/>
			</Trigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=PopupPosition}" Value="Above"/>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=FlowDirection}" Value="RightToLeft"/>
				</MultiDataTrigger.Conditions>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNWSE" TargetName="PART_ResizeThumb" />
			</MultiDataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>


	<!--END GALLERY DROPDOWN TEMPLATES-->


	<Style x:Key="BlendRibbonGalleryStyle" TargetType="{x:Type local:RibbonGallery}">
		<!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Margin" Value="1"/>
		<Setter Property="Height" Value="62"/>
		<Setter Property="Template" Value="{StaticResource InRibbonGalleryTemplate}"/>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<WrapPanel 
			Background="Transparent"
			ClipToBounds="True"
			ItemWidth="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemWidth}"
			ItemHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="VisualMode" Value="DropDown"/>
					<Condition Property="SizeForm" Value="Large"/>
				</MultiTrigger.Conditions>
				<Setter Property="Template" Value="{StaticResource LargeGalleryTemplate}"/>
			</MultiTrigger>

			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="VisualMode" Value="DropDown"/>
					<Condition Property="SizeForm" Value="Small"/>
				</MultiTrigger.Conditions>
				<Setter Property="Template" Value="{StaticResource SmallGalleryTemplate}"/>
			</MultiTrigger>

			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="VisualMode" Value="DropDown"/>
					<Condition Property="SizeForm" Value="ExtraSmall"/>
				</MultiTrigger.Conditions>
				<Setter Property="Template" Value="{StaticResource ExtraSmallGalleryTemplate}"/>
			</MultiTrigger>

			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="VisualMode" Value="DropDown"/>
					<Condition Property="IsMouseOver" Value="True"/>
				</MultiTrigger.Conditions>
				<Setter Property="BorderBrush" Value="{StaticResource Blend.RibbonMouseOverBrush}" />
				<Setter Property="Background" Value="{StaticResource Luna.MouseOverBrush.Blend}" />
			</MultiTrigger>

			<!--<Trigger Property="IsPressed" Value="True">
		<Setter Property="Background" Value="{StaticResource GalleryRepeatButton.IsPressed.BackgroundBrush}" />
	  </Trigger>-->

			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="VisualMode" Value="DropDown"/>
					<Condition Property="IsDropDownOpen" Value="True"/>
				</MultiTrigger.Conditions>
				<Setter Property="BorderBrush" Value="{StaticResource Blend.GalleryHoverBorderBrush}" />
				<Setter Property="Background" Value="{StaticResource Luna.SelectedBrush.Blend}"/>
			</MultiTrigger>

			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="VisualMode" Value="DropDown"/>
					<Condition Property="HasGroups" Value="True"/>
				</MultiTrigger.Conditions>
				<Setter Property="ItemsPanel">
					<Setter.Value>
						<ItemsPanelTemplate>
							<local:GalleryGroupPanel />
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
			</MultiTrigger>

			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="VisualMode" Value="DropDown"/>
					<Condition Property="IsEnabled" Value="False"/>
				</MultiTrigger.Conditions>
				<Setter Property="Opacity" Value="0.65" />
				<Setter Property="Background" Value="{StaticResource Blend.GalleryRepeatButton.IsEnabled.BackgroundBrush}" />
			</MultiTrigger>
		</Style.Triggers>
	</Style>

	<Style BasedOn="{StaticResource BlendRibbonGalleryStyle}" TargetType="{x:Type local:RibbonGallery}"/>
	
