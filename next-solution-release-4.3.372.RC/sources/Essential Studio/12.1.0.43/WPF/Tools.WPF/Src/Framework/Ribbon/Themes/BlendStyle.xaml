							<Path Data="M1,0L4,0 5,2 7,0 10,0 7,4 7,5 10,8 7,8 5,6 4,8 1,8 4,5 4,4z" Fill="{StaticResource Blend.SystemButtonBrush2}"  StrokeThickness="1"/>
							<Path Data="M0,8L4,8 5,6 7,8 11,8" Stroke="{StaticResource Blend.SystemButtonBrush3}" StrokeThickness="1"/>
