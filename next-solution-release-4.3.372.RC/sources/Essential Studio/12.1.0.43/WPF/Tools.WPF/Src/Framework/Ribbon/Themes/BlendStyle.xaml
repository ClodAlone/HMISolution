						<Canvas Width="9" Height="8">
							<Line X1="2" X2="9"  Y1="1.5" Y2="1.5" Stroke="{StaticResource Blend.SystemButtonBrush1}" StrokeThickness="1"/>
							<Rectangle Canvas.Left="6" Canvas.Top="2"  Stroke="{StaticResource Blend.SystemButtonBrush2}" Width="3" Height="5" StrokeThickness="1"/>
							<Line X1="3" X2="8"  Y1="3" Y2="3" Stroke="{StaticResource Blend.SystemButtonBrush3}" StrokeThickness="1"/>
							<Line X1="2" X2="8"  Y1="7" Y2="7" Stroke="{StaticResource Blend.SystemButtonBrush3}" StrokeThickness="1"/>
							<Line X1="0" X2="7"  Y1="2.5" Y2="2.5" Stroke="{StaticResource Blend.SystemButtonBrush1}" StrokeThickness="1"/>
							<Rectangle Canvas.Left="0" Canvas.Top="3" Stroke="{StaticResource Blend.SystemButtonBrush2}" Width="7" Height="5" StrokeThickness="1"/>
							<Line X1="1" X2="6"  Y1="4" Y2="4" Stroke="{StaticResource Blend.SystemButtonBrush3}" StrokeThickness="1"/>
							<Line X1="0" X2="6"  Y1="8" Y2="8" Stroke="{StaticResource Blend.SystemButtonBrush3}" StrokeThickness="1"/>
