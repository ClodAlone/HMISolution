	<!-- MenuButton Style -->
	<Style  x:Key="BlendMenuButtonStyle" TargetType="{x:Type local:MenuButton}">
		<!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
		<!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{StaticResource SkinDictionary}"/>-->
		<Setter Property="Padding" Value="1"/>
		<!--<Setter Property="FontSize" Value="11.5"/>
		<Setter Property="FontFamily" Value="Segoe UI"/>-->
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:MenuButton}">
					<Border x:Name="PART_OutterBorder"
					   BorderThickness="1"
					   BorderBrush="{TemplateBinding BorderBrush}"
					   Background="{TemplateBinding Background}"
					   Opacity="{TemplateBinding Opacity}"
					   IsEnabled="{TemplateBinding IsEnabled}" >
						<Grid>
							<Border x:Name="PART_InnerBorder" BorderThickness="1">
								<DockPanel LastChildFill="True" MaxWidth="{TemplateBinding ActualWidth}" >
									<Path Fill="{StaticResource Blend.PathFill1}" Margin="5,16,4,0" DockPanel.Dock="Right"
											  HorizontalAlignment="Center"
											  VerticalAlignment="Center"
											  Data="M 0 0 L 4 4 L 8 0 Z">
										<Path.RenderTransform>
											<RotateTransform Angle="-90"/>
										</Path.RenderTransform>
									</Path>
									<DockPanel DockPanel.Dock="Left" HorizontalAlignment="Stretch" Margin="1,3,3,1">
										<Image	   Margin="5,1,5,3"
												   DockPanel.Dock="Left"
												   
												   Source="{Binding Path=Icon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
												   MinWidth="16" MinHeight="16" MaxHeight="32" MaxWidth="32" Stretch="None" />
										<StackPanel Orientation="Vertical" Margin="0,0,0,2" VerticalAlignment="Center" DockPanel.Dock="Right">
											<TextBlock x:Name="PART_Label"
													   TextWrapping="Wrap" TextAlignment="Center"
													   Foreground="{StaticResource Blend.Foreground2}"
													   VerticalAlignment="Center" HorizontalAlignment="Left"
													   Margin="0,0,0,2"
													   FontWeight="Bold"
													   Text="{TemplateBinding Label}"
													   DockPanel.Dock="Bottom"/>
											<local:TwoLinesLayoutPanel HorizontalAlignment="Left">
												<TextBlock x:Name="PART_Description" TextWrapping="Wrap" Margin="0,0,10,0" TextAlignment="Left" 
												   Foreground="{StaticResource Blend.Foreground2}"
												   VerticalAlignment="Center" HorizontalAlignment="Left"
												   Text="{TemplateBinding Description}"/>
											</local:TwoLinesLayoutPanel>
										</StackPanel>
									</DockPanel>
								</DockPanel>
							</Border>
							<local:CustomPopup Name="PART_Popup"
								  Placement="Custom"
								  PlacementTarget ="{Binding Path=PlacementBorder, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ApplicationMenu}}}"
								  Focusable="False"
								  PopupAnimation="Fade"
								  AllowsTransparency="True"
								  StaysOpen="True"
								  IsOpen="{Binding Path=IsMenuOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
								<Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="true" Margin="0">
									<Border Background="{StaticResource Blend.QuickDropDownBackground}" BorderThickness="1" CornerRadius="{StaticResource Blend.QuickDropDownCornerRadius}" BorderBrush="{StaticResource Blend.QuickDropDownBorderBrush}" >
										<ScrollViewer x:Name="PART_ScrollViwer" Style="{StaticResource CustomScrollViewerStyle}" >
											<ItemsPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"/>
										</ScrollViewer>
									</Border>
								</Microsoft_Windows_Themes:SystemDropShadowChrome>
							</local:CustomPopup>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
							<Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,3,3"/>
						</Trigger>
						<Trigger Property="IsFocused" Value="True">
							<Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.OutterBorderBrush}"/>
							<Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.InnerBorderBrush}"/>
							<Setter TargetName="PART_InnerBorder"  Property="Background" Value="{StaticResource Blend.MenuButton.MouseOverBrush}"/>
							<Setter TargetName="PART_Description" Property="Foreground" Value="{StaticResource Blend.Foreground3}"/>
							<Setter TargetName="PART_Label" Property="Foreground" Value="{StaticResource Blend.Foreground3}"/>

						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.OutterBorderBrush}"/>
							<Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.InnerBorderBrush}"/>
							<Setter TargetName="PART_InnerBorder"  Property="Background" Value="{StaticResource Blend.MenuButton.MouseOverBrush}"/>
							<Setter TargetName="PART_Description" Property="Foreground" Value="{StaticResource Blend.Foreground3}"/>
							<Setter TargetName="PART_Label" Property="Foreground" Value="{StaticResource Blend.Foreground3}"/>

						</Trigger>
						<DataTrigger Binding="{Binding Path=Description, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
							<Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed"/>
							<Setter TargetName="PART_Label" Property="FontWeight" Value="Normal"/>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>    

	<Style BasedOn="{StaticResource BlendMenuButtonStyle}" TargetType="{x:Type local:MenuButton}"/>
	
	<Style x:Key="BlendSimpleMenuButtonStyle" TargetType="{x:Type local:SimpleMenuButton}">
		<!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
		<Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
		<Setter Property="Background" Value="Transparent"/>
		<!--<Setter Property="FontSize" Value="11.5"/>
		<Setter Property="FontFamily" Value="Segoe UI"/>-->
		<!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{StaticResource SkinDictionary}"/>-->
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:SimpleMenuButton}">
					<Border x:Name="PART_OutterBorder"			  
						  BorderThickness="1" Margin="{TemplateBinding Padding}"
						  BorderBrush="{TemplateBinding BorderBrush}"
						  Background="{TemplateBinding Background}"
						  Opacity="{TemplateBinding Opacity}"
						  IsEnabled="{TemplateBinding IsEnabled}">
						<Grid>
							<Border x:Name="PART_InnerBorder" 
									BorderThickness="0" 
									MaxWidth="{TemplateBinding ActualWidth}">
								<DockPanel HorizontalAlignment="Stretch" 
										   Margin="1,3,3,1" 
										   LastChildFill="True" >
									<Image DockPanel.Dock="Left" x:Name="PART_Image"
										   Margin="5,1,5,3" RenderOptions.BitmapScalingMode="NearestNeighbor"
										   Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}"
										   Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}"
										   Source="{Binding Path=Icon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
										   MinHeight="16" MinWidth="16"/>
									<StackPanel Orientation="Vertical" 
												Margin="0,0,0,2" 
												VerticalAlignment="Center" 
												DockPanel.Dock="Right">
										<TextBlock x:Name="PART_Label" 
												   TextAlignment="Left"
												   Foreground="{StaticResource Blend.Foreground2}"
												   VerticalAlignment="Center" 
												   HorizontalAlignment="Left"
												   FontWeight="Bold"
												   Text="{TemplateBinding Label}"/>
										<local:TwoLinesLayoutPanel HorizontalAlignment="Left">
											<TextBlock x:Name="PART_Description" 
									   TextWrapping="Wrap" 
									   Margin="0,0,10,0" 
									   TextAlignment="Left"
									   Foreground="{StaticResource Blend.Foreground2}"
									   VerticalAlignment="Center" 
									   HorizontalAlignment="Left"
									   Text="{TemplateBinding Description}"/>
										</local:TwoLinesLayoutPanel>
									</StackPanel>
								</DockPanel>
							</Border>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsFocused" Value="True">
							<Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.OutterBorderBrush}"/>
							<Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.InnerBorderBrush}"/>
							<Setter TargetName="PART_InnerBorder"  Property="Background" Value="{StaticResource Blend.MenuButton.MouseOverBrush}"/>
							<Setter TargetName="PART_Label" Property="Foreground" Value="{StaticResource TextBrushKey.ShinyRed}"/>
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.OutterBorderBrush}"/>
							<Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.InnerBorderBrush}"/>
							<Setter TargetName="PART_InnerBorder"  Property="Background" Value="{StaticResource Blend.MenuButton.MouseOverBrush}"/>
							<Setter TargetName="PART_Label" Property="Foreground" Value="Black"/>							
						</Trigger>
						<DataTrigger Binding="{Binding Path=Description, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
							<Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed"/>
							<Setter TargetName="PART_Label" Property="FontWeight" Value="Normal"/>
						</DataTrigger>
						<Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
							<Setter Property="Padding" Value="5" />
							<Setter Property="Height" TargetName="PART_Image" Value="20"/>
							<Setter Property="Width" TargetName="PART_Image" Value="20"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Opacity" Value="0.5"/>
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style BasedOn="{StaticResource BlendSimpleMenuButtonStyle}" TargetType="{x:Type local:SimpleMenuButton}"/>
	
	<Style x:Key="BlendSplitMenuButtonStyle"  TargetType="{x:Type local:SplitMenuButton}">
		<!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
		<Setter Property="Padding" Value="1"/>
		<!--<Setter Property="FontSize" Value="11.5"/>
		<Setter Property="FontFamily" Value="Segoe UI"/>-->
		<!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{StaticResource SkinDictionary}"/>-->
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:SplitMenuButton}">
					<Border	BorderThickness="{TemplateBinding BorderThickness}"
							BorderBrush="{TemplateBinding BorderBrush}"
							Background="{TemplateBinding Background}"
							HorizontalAlignment="Stretch"		Margin="{TemplateBinding Padding}"	
							Opacity="{TemplateBinding Opacity}"
							IsEnabled="{TemplateBinding IsEnabled}">
						<Grid HorizontalAlignment="Stretch">
							<DockPanel HorizontalAlignment="Stretch" LastChildFill="True" >
								<Border Name="PART_ToggleButton"
										Width="24"							
										DockPanel.Dock="Right"
										Background="Transparent"
										BorderThickness="0,1,1,1"
										BorderBrush="{TemplateBinding BorderBrush}">
									<Border x:Name="PART_TogleButtonInnerBorder" BorderThickness="1">
										<Path Fill="{StaticResource Blend.Foreground2}" Margin="5,16,0,0"
												  HorizontalAlignment="Center"
												  VerticalAlignment="Center"
												  Data="M 0 0 L 4 4 L 8 0 Z">
											<Path.RenderTransform>
												<RotateTransform Angle="-90"/>
											</Path.RenderTransform>
										</Path>
									</Border>
								</Border>
								<Border x:Name="PART_OutterBorder" BorderThickness="1" HorizontalAlignment="Stretch" DockPanel.Dock="Left">
									<Border x:Name="PART_InnerBorder" BorderThickness="1" Background="Transparent">
										<WrapPanel
											  Orientation="Horizontal"
											  VerticalAlignment="Center"
											  HorizontalAlignment="Left"
											  Margin="1">
                                            <Image Margin="5,3,5,3" Grid.Row="0" x:Name="PART_Image"
													Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}"
													Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}"
												   MinHeight="16" MinWidth="16" 
												   Source="{Binding Path=Icon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
												   />

											<TextBlock Margin="0,0,7,0" Name="label"
													   TextWrapping="Wrap"
													   TextAlignment="Center"
													   Foreground="{StaticResource Blend.Foreground2}"
													   VerticalAlignment="Center"
													   HorizontalAlignment="Center"
													   Text="{TemplateBinding Label}"/>
										</WrapPanel>
									</Border>
								</Border>
							</DockPanel>
							<local:CustomPopup Name="PART_Popup"
								  Placement="Custom"
								  PlacementTarget ="{Binding Path=PlacementBorder, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ApplicationMenu}}}"
								  Focusable="False"
								  PopupAnimation="Fade"
								  AllowsTransparency="True"
								  StaysOpen="True"
								  IsOpen="{Binding Path=IsMenuOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
								<Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="true">
									<Border Background="{StaticResource Blend.SimpleMenuPopupBrush}" BorderThickness="1" CornerRadius="{StaticResource Blend.QuickDropDownCornerRadius}" BorderBrush="{StaticResource Blend.QuickDropDownBorderBrush}">
										<ScrollViewer x:Name="PART_ScrollViwer" Margin="0,0,0,-5" Style="{StaticResource CustomScrollViewerStyle}">
											<ItemsPresenter
											  Margin="0,0,0,5"
											  HorizontalAlignment="Stretch"
											  VerticalAlignment="Stretch"
											  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"/>
										</ScrollViewer>
									</Border>
								</Microsoft_Windows_Themes:SystemDropShadowChrome>
							</local:CustomPopup>
						</Grid>
					</Border>

					<ControlTemplate.Triggers>
						<Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
							<Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,4,4"/>
						</Trigger>

						<Trigger Property="IsFocused" Value="True">
							<Setter TargetName="PART_ToggleButton"  Property="Background" Value="{StaticResource Blend.MenuButton.MouseOverBrush}"/>
							<Setter TargetName="PART_ToggleButton"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.OutterBorderBrush}"/>
							<Setter TargetName="PART_OutterBorder"  Property="Background" Value="{StaticResource Blend.IsDropDownOpenBrush}"/>
							<Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.OutterBorderBrush}"/>
							<Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.InnerBorderBrush}"/>
							<Setter TargetName="PART_TogleButtonInnerBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.InnerBorderBrush}"/>
							<Setter TargetName="label" Property="Foreground" Value="{StaticResource Blend.Foreground3}"/>
						</Trigger>

						<Trigger Property="IsMenuOpen" Value="True">
							<Setter TargetName="PART_ToggleButton"  Property="Background" Value="{StaticResource Blend.MenuButton.MouseOverBrush}"/>
							<Setter TargetName="PART_ToggleButton"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.OutterBorderBrush}"/>
							<Setter TargetName="PART_OutterBorder"  Property="Background" Value="{StaticResource Blend.IsDropDownOpenBrush}"/>
							<Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.OutterBorderBrush}"/>
							<Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.InnerBorderBrush}"/>
							<Setter TargetName="PART_TogleButtonInnerBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.InnerBorderBrush}"/>
							<Setter TargetName="label" Property="Foreground" Value="{StaticResource Blend.Foreground3}"/>
						</Trigger>

						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_ToggleButton"  Property="Background" Value="{StaticResource Blend.MenuButton.MouseOverBrush}"/>
							<Setter TargetName="PART_ToggleButton"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.OutterBorderBrush}"/>
							<Setter TargetName="PART_OutterBorder"  Property="Background" Value="{StaticResource Blend.IsDropDownOpenBrush}"/>
							<Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.OutterBorderBrush}"/>
							<Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.InnerBorderBrush}"/>
							<Setter TargetName="PART_TogleButtonInnerBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.InnerBorderBrush}"/>
							<Setter TargetName="label" Property="Foreground" Value="{StaticResource Blend.Foreground3}"/>
						</Trigger>

						<Trigger SourceName="PART_OutterBorder"  Property="IsMouseOver" Value="True">
							<!--<Setter Property="CanCommandExecute" Value="True"/>-->
							<Setter TargetName="PART_ToggleButton"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.OutterBorderBrush}"/>
							<Setter TargetName="PART_ToggleButton"  Property="Background" Value="{StaticResource Blend.MenuButton.MouseOverBrush}"/>
							<Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.OutterBorderBrush}"/>
							<Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.InnerBorderBrush}"/>
							<Setter TargetName="PART_InnerBorder"  Property="Background" Value="{StaticResource Blend.MenuButton.MouseOverBrush}"/>
							<Setter TargetName="PART_TogleButtonInnerBorder"  Property="BorderBrush" Value="{StaticResource Blend.MenuButton.InnerBorderBrush}"/>
							<Setter TargetName="label" Property="Foreground" Value="{StaticResource Blend.Foreground3}"/>
						</Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="Padding" Value="10" />
                            <Setter Property="Height" TargetName="PART_Image" Value="20"/>
                            <Setter Property="Width" TargetName="PART_Image" Value="20"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style BasedOn="{StaticResource BlendSplitMenuButtonStyle}" TargetType="{x:Type local:SplitMenuButton}"/>
	
	<!-- RibbonToggleButton Style -->
	<SolidColorBrush x:Key="RibbonToggleButtonBackgroundBrush" Color="#FF595959"/>
	<SolidColorBrush x:Key="RibbonToggleButtonBorderBrush" Color="#FF333333"/>
	<SolidColorBrush x:Key="RibbonToggleButtonForeground" Color="#FFF0F0F0"/>
	
	<SolidColorBrush x:Key="RibbonToggleButtonHoverBackgroundBrush" Color="#FFAAAAAA"/>
	<SolidColorBrush x:Key="RibbonToggleButtonHoverBorderBrush" Color="#FF424242"/>
	<SolidColorBrush x:Key="RibbonToggleButtonHoverForeground" Color="#FF1A1A1A"/>

	<SolidColorBrush x:Key="RibbonToggleButtonPressedBackgroundBrush" Color="#FF424242"/>
	<SolidColorBrush x:Key="RibbonToggleButtonPressedBorderBrush" Color="#FF1A1A1A"/>
	
	<SolidColorBrush x:Key="RibbonToggleButtonCheckedBackgroundBrush" Color="#FF424242"/>
	<SolidColorBrush x:Key="RibbonToggleButtonCheckedBorderBrush" Color="#FF1A1A1A"/>
	
	<SolidColorBrush x:Key="RibbonToggleButtonDisabledBackgroundBrush" Color="#FF666666"/>
	<SolidColorBrush x:Key="RibbonToggleButtonDisabledBorderBrush" Color="#FF3B3B3B"/>
	<SolidColorBrush x:Key="RibbonToggleButtonDisabledForeground" Color="#FF424242"/>
	<SolidColorBrush Color="#FFB2B2B2" x:Key="BlendRibbonToggleButtonCheckedBackground"/>
	<Style x:Key="BlendRibbonToggleButtonStyle" TargetType="local:RibbonToggleButton">
		<Setter Property="Foreground" Value="{StaticResource RibbonToggleButtonForeground}" />
		<Setter Property="SmallIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt16.png"/>
		<Setter Property="LargeIcon" Value="/Syncfusion.Shared.WPF;component//Controls/ButtonControls/Images/WordArt32.png"/>
		<Setter Property="Label" Value="RibbonToggleButton"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="Background" Value="{StaticResource RibbonToggleButtonBackgroundBrush}"/>
		<Setter Property="BorderBrush" Value="{StaticResource RibbonToggleButtonBorderBrush}"/>
		<Setter Property="MinHeight" Value="22"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="local:RibbonToggleButton">
					<ControlTemplate.Triggers>                    
						<Trigger Property="IsMouseOver" Value="true">
							<Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource RibbonToggleButtonHoverBackgroundBrush}"/>
							<Setter Property="Border.BorderBrush" TargetName="ItemBorder" Value="{StaticResource RibbonToggleButtonHoverBorderBrush}"/>
							<Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource RibbonToggleButtonHoverBackgroundBrush}"/>
							<Setter Property="Border.BorderBrush" TargetName="ItemBorder1" Value="{StaticResource RibbonToggleButtonHoverBorderBrush}"/>
							<Setter Property="TextElement.Foreground" TargetName="PART_Text" Value="{StaticResource RibbonToggleButtonHoverForeground}"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource RibbonToggleButtonPressedBackgroundBrush}"/>
							<Setter Property="Border.BorderBrush" TargetName="ItemBorder" Value="{StaticResource RibbonToggleButtonPressedBorderBrush}"/>
							<Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource RibbonToggleButtonPressedBackgroundBrush}"/>
							<Setter Property="Border.BorderBrush" TargetName="ItemBorder1" Value="{StaticResource RibbonToggleButtonPressedBorderBrush}"/>
							<Setter Property="TextElement.Foreground" TargetName="PART_Text" Value="{StaticResource RibbonToggleButtonForeground}"/>
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource BlendRibbonToggleButtonCheckedBackground}"/>
							<Setter Property="Border.BorderBrush" TargetName="ItemBorder" Value="{StaticResource BlendRibbonToggleButtonCheckedBackground}"/>
							<Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource BlendRibbonToggleButtonCheckedBackground}"/>
							<Setter Property="Border.BorderBrush" TargetName="ItemBorder1" Value="{StaticResource BlendRibbonToggleButtonCheckedBackground}"/>
							<Setter Property="TextBlock.Foreground" TargetName="PART_Text" Value="{StaticResource RibbonToggleButtonHoverForeground}"/>                            
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Border.Background" TargetName="ItemBorder" Value="{StaticResource RibbonToggleButtonDisabledBackgroundBrush}"/>
							<Setter Property="Border.BorderBrush" TargetName="ItemBorder" Value="{StaticResource RibbonToggleButtonDisabledBorderBrush}"/>
							<Setter Property="Border.Background" TargetName="ItemBorder1" Value="{StaticResource RibbonToggleButtonDisabledBackgroundBrush}"/>
							<Setter Property="Border.BorderBrush" TargetName="ItemBorder1" Value="{StaticResource RibbonToggleButtonDisabledBorderBrush}"/>
							<Setter Property="TextBlock.Foreground" TargetName="PART_Text" Value="{StaticResource RibbonToggleButtonDisabledForeground}"/>
						</Trigger>
					</ControlTemplate.Triggers>
					<Grid>                        
						<Border x:Name="ItemCheckedBorder" CornerRadius="2" Opacity="0"
								BorderThickness="{TemplateBinding BorderThickness}" 
								Background="{StaticResource RibbonToggleButtonCheckedBackgroundBrush}" 
								BorderBrush="{StaticResource RibbonToggleButtonCheckedBorderBrush}"/>
						<Border Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								MinHeight="22" Name="ItemBorder" SnapsToDevicePixels="True" CornerRadius="2">

							<Grid Margin="{TemplateBinding Padding}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>
								<Border Name="PART_ImageBorder" Grid.Column="0">
									<Image Margin="2" x:Name="smallImage"
									Width="{Binding Path=IconWidth, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonToggleButton}}}" Height="{Binding Path=IconWidth, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonToggleButton}}}"   
									Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
								</Border>
								<AccessText Grid.Column="1" x:Name="PART_Text"
										   Text="{TemplateBinding Label}" 
										   Foreground="{TemplateBinding Foreground}"
										   FontFamily="{TemplateBinding FontFamily}"
										   FontSize="{TemplateBinding FontSize}"
										   VerticalAlignment="{TemplateBinding VerticalAlignment}"                           
										   HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
										   Margin="2,0,4,0"/>
							</Grid>
						</Border>
						<Border Background="{TemplateBinding Background}" Visibility="Collapsed"
								BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
								MinHeight="22" Name="ItemBorder1" SnapsToDevicePixels="True" CornerRadius="2">
							<StackPanel Margin="{TemplateBinding Padding}">
								<Border Name="PART_ImageBorderLarge">
									<Image Margin="2"
									Width="26" Height="26"   x:Name="LargeImage"
									Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
								</Border>
								<ItemsControl x:Name="PART_TextAreaLarge"
											   VerticalAlignment="{TemplateBinding VerticalAlignment}"                           
											   HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
											   Margin="2,0,4,0"/>
							</StackPanel>
						</Border>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style BasedOn="{StaticResource BlendRibbonToggleButtonStyle}" TargetType="local:RibbonToggleButton"/>
	
	</ResourceDictionary>