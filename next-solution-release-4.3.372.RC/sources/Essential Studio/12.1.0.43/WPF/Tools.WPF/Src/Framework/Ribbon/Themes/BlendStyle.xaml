	<ControlTemplate x:Key="ApplicationMenuTemplate" TargetType="{x:Type local:ApplicationMenu}">
		<Grid x:Name="PART_ButtonGrid" Height="38" Width="38" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}">
			<Ellipse Height="37" Width="37" Name="OB"
			   Fill="{StaticResource Blend.AppButton.OutterBorderFill}"
			   Stroke="{StaticResource Blend.AppButton.OutterBorder}"
			   StrokeThickness="1"
			   SnapsToDevicePixels="True" />
			<Ellipse Height="37" Width="37"
			   Stroke="{StaticResource Blend.AppButton.OutterBorder}"
			   Opacity="0.6"
			   StrokeThickness="1"
			   SnapsToDevicePixels="True">
				<Ellipse.RenderTransform>
					<TranslateTransform X="1" Y="0.4" />
				</Ellipse.RenderTransform>
			</Ellipse>
			<Ellipse Height="35" Width="35"
			   Fill="{StaticResource Blend.AppButton.InnerBorderFill}"
			   Name="IB"
			   Stroke="{StaticResource Blend.AppButton.InnerBorder}"
			   SnapsToDevicePixels="True" />
			<Ellipse Height="33" Width="33"
			   Fill="{StaticResource Blend.AppButton.TopHighlight}"
			   Name="TH"
			   SnapsToDevicePixels="True" />
			<Ellipse Height="33" Width="33"
			   Fill="{StaticResource Blend.AppButton.BottomHighlight}"
			   Name="BH"
			   SnapsToDevicePixels="True" />
			<Image Name="PART_ApplicationButtonImage"
			 Margin="1.5,1,0,0"
			 HorizontalAlignment="Center"             
			 VerticalAlignment="Center"             
			 Width="{Binding Path=ApplicationButtonImageWidth, RelativeSource={RelativeSource TemplatedParent}}" 
			 Height="{Binding Path=ApplicationButtonImageHeight, RelativeSource={RelativeSource TemplatedParent}}" 
			 Source="{Binding Path=ApplicationButtonImage, RelativeSource={RelativeSource TemplatedParent}}"
			 SnapsToDevicePixels="True"/>
			<local:CustomPopup StaysOpen="False" PopupAnimation="Fade" Placement="Bottom" HorizontalOffset="-3" VerticalOffset="-16" x:Name="PART_Popup" Focusable="False" AllowsTransparency="True" IsOpen="{Binding Path=IsPopupOpen, Mode=TwoWay, UpdateSourceTrigger=Explicit, RelativeSource={RelativeSource TemplatedParent}}" SnapsToDevicePixels="True" >
				<mwt:SystemDropShadowChrome Name="Shdw" Margin="0">
					<Grid  x:Name="mainGrid">
						<Border BorderBrush="{StaticResource Blend.AppMenu.OutterBorderBrush}" CornerRadius="{StaticResource Blend.AppMenuCornerRadius}" BorderThickness="1,1,1,1">
							<Border BorderBrush="{StaticResource Blend.AppMenu.InnerBorderBrush}" CornerRadius="{StaticResource Blend.QuickDropDownCornerRadius}" BorderThickness="1,1,1,1" Background="{StaticResource Blend.AppMenu.Background}">
								<DockPanel LastChildFill="True">
									<Border Height="15" CornerRadius="2,2,2,2" Background="{StaticResource Blend.AppMenu.BackgroundTop}" DockPanel.Dock="Top" />
									<DockPanel LastChildFill="True">
										<Border Height="Auto" CornerRadius="0,0,2,2" Background="{StaticResource Blend.AppMenu.BackgroundBottom}" VerticalAlignment="Bottom" DockPanel.Dock="Bottom">
											<shared:ItemsControlInternal x:Name="PART_AppItems" 
												   Margin="0,-2,0,-1" 
												   Visibility="Visible" 
												   HorizontalAlignment="Right" 
												   Padding="1,3,1,3"
												   ItemContainerStyle="{StaticResource ItemsControlInternalItemStyle}">
												<shared:ItemsControlInternal.ItemsPanel>
													<ItemsPanelTemplate>
														<StackPanel KeyboardNavigation.DirectionalNavigation="Contained" IsItemsHost="True" Orientation="Horizontal"/>
													</ItemsPanelTemplate>
												</shared:ItemsControlInternal.ItemsPanel>
											</shared:ItemsControlInternal>
										</Border>
										<Border Margin="2,0,2,1" BorderBrush="{StaticResource Blend.AppMenu.BorderBrush1}" BorderThickness="1,1,1,1" Grid.Row="1">
											<Border BorderBrush="{StaticResource Blend.AppMenu.BorderBrush2}" BorderThickness="1,1,1,1" Background="{StaticResource Blend.AppMenu.Background2}">
												<DockPanel LastChildFill="True">
													<Border x:Name="PART_Border" BorderBrush="{StaticResource Blend.AppMenu.BorderBrush3}" Visibility="Visible" BorderThickness="1,0,0,0" Background="{StaticResource Blend.AppMenu.Background3}" DockPanel.Dock="Right"
															MinWidth="{TemplateBinding PreviewPanelMinWidth}">
														<Border BorderBrush="{StaticResource Blend.AppMenu.BorderBrush4}" BorderThickness="1,0,0,0" Padding="2,2,2,2">
															<ItemsControl x:Name="PART_MenuItems" ItemsSource="{TemplateBinding internalMenuItems}"  ItemTemplate="{x:Null}" Foreground="{StaticResource Blend.Foreground2}" />
														</Border>
													</Border>
													<ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,0,-5,-5" HorizontalScrollBarVisibility="Hidden">
														<ItemsPresenter Margin="0,0,5,5" x:Name="PART_Items" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained"/>
													</ScrollViewer>
												</DockPanel>
											</Border>
										</Border>
									</DockPanel>
								</DockPanel>
							</Border>
						</Border>
						<Grid Name="PART_FakeAppButton"
							  Height="38" Width="38"
							  HorizontalAlignment="Left"
							  VerticalAlignment="Top">
							<Ellipse Height="37" Width="37"
									Fill="{StaticResource Blend.AppButtonExpandedOutterBorderFill}"
									Stroke="{StaticResource Blend.AppButton.OutterBorder}"
									StrokeThickness="1"/>
							<Ellipse Height="37" Width="37"
								Stroke="{StaticResource Blend.AppButtonExpandedOutterBorder}"
								Opacity="0.6"
								StrokeThickness="1">
								<Ellipse.RenderTransform>
									<TranslateTransform X="1"  Y="0.4"/>
								</Ellipse.RenderTransform>
							</Ellipse>
							<Ellipse Height="35" Width="35"
								Fill="{StaticResource Blend.AppButtonExpandedInnerBorderFill}"
								Stroke="{StaticResource Blend.AppButton.InnerBorder}" />
							<Ellipse Height="33" Width="33" Fill="{StaticResource Blend.AppButtonExpandedTopHighlight}"/>
							<Ellipse Height="33" Width="33" Fill="{StaticResource Blend.AppButtonExpandedBottomHighlight}"/>
							<Image Margin="1.5,1,0,0"                               
								 HorizontalAlignment="Center"
								 VerticalAlignment="Center"
								 Width="{Binding Path=ApplicationButtonImageWidth, RelativeSource={RelativeSource TemplatedParent}}" 
								 Height="{Binding Path=ApplicationButtonImageHeight, RelativeSource={RelativeSource TemplatedParent}}" 
								 Source="{Binding Path=ApplicationButtonImage, RelativeSource={RelativeSource TemplatedParent}}"
								 SnapsToDevicePixels="True"/>
							<Grid.RenderTransform>
								<TranslateTransform X="0" Y="-22" />
							</Grid.RenderTransform>
						</Grid>
					</Grid>
				</mwt:SystemDropShadowChrome>
				<local:CustomPopup.Style>
					<Style>
						<Style.Triggers>
							<Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
								<Setter Property="Popup.VerticalOffset" Value="-90"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</local:CustomPopup.Style>
			</local:CustomPopup>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
				<Setter TargetName="Shdw" Property="Margin" Value="0,0,4,4"/>
			</Trigger>
			<Trigger Property="IsBelowAppButton" Value="False">
				<Setter TargetName="PART_FakeAppButton" Property="Visibility" Value="Hidden"/>
				<Setter TargetName="PART_Popup" Property="VerticalOffset" Value="-5"/>
			</Trigger>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="OB" Property="Fill" Value="{StaticResource Blend.AppButtonHoverOutterBorderFill}"/>
				<Setter TargetName="OB" Property="Stroke" Value="{StaticResource Blend.AppButtonHoverOutterBorder}"/>
				<Setter TargetName="IB" Property="Fill" Value="{StaticResource Blend.AppButtonHoverInnerBorderFill}"/>
				<Setter TargetName="IB" Property="Stroke" Value="{StaticResource Blend.AppButtonHoverInnerBorder}"/>
				<Setter TargetName="TH" Property="Fill" Value="{StaticResource Blend.AppButtonHoverTopHighlight}"/>
				<Setter TargetName="BH" Property="Fill" Value="{StaticResource Blend.AppButtonHoverBottomHighlight}"/>
			</Trigger>
			<Trigger Property="IsPopupOpen" Value="True">
				<Setter TargetName="OB" Property="Fill" Value="{StaticResource Blend.AppButtonExpandedOutterBorderFill}"/>
				<Setter TargetName="OB" Property="Stroke" Value="{StaticResource Blend.AppButtonExpandedOutterBorder}"/>
				<Setter TargetName="IB" Property="Fill" Value="{StaticResource Blend.AppButtonExpandedInnerBorderFill}"/>
				<Setter TargetName="IB" Property="Stroke" Value="{StaticResource Blend.AppButtonExpandedInnerBorder}"/>
				<Setter TargetName="TH" Property="Fill" Value="{StaticResource Blend.AppButtonExpandedTopHighlight}"/>
				<Setter TargetName="BH" Property="Fill" Value="{StaticResource Blend.AppButtonExpandedBottomHighlight}"/>
			</Trigger>
			<Trigger Property="IsKeyTipShown" Value="True">
				<Setter TargetName="OB" Property="Fill" Value="{StaticResource Blend.AppButtonExpandedOutterBorderFill}"/>
				<Setter TargetName="OB" Property="Stroke" Value="{StaticResource Blend.AppButtonExpandedOutterBorder}"/>
				<Setter TargetName="IB" Property="Fill" Value="{StaticResource Blend.AppButtonExpandedInnerBorderFill}"/>
				<Setter TargetName="IB" Property="Stroke" Value="{StaticResource Blend.AppButtonExpandedInnerBorder}"/>
				<Setter TargetName="TH" Property="Fill" Value="{StaticResource Blend.AppButtonExpandedTopHighlight}"/>
				<Setter TargetName="BH" Property="Fill" Value="{StaticResource Blend.AppButtonExpandedBottomHighlight}"/>
			</Trigger>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="FrameworkElement.Height" TargetName="PART_ButtonGrid" Value="48" />
                <Setter Property="FrameworkElement.Width" TargetName="PART_ButtonGrid" Value="48" />
                <Setter Property="FrameworkElement.Height" TargetName="PART_FakeAppButton" Value="48" />
                <Setter Property="FrameworkElement.Width" TargetName="PART_FakeAppButton" Value="48" />
                <Setter Property="Visibility" TargetName="PART_FakeAppButton" Value="Collapsed" />
                <Setter Property="Width" TargetName="mainGrid" Value="330"/>
                <Setter Property="Margin" TargetName="PART_Border" Value="5,0,5,0"/>
                <Setter Property="Width" TargetName="PART_Border" Value="150"/>
            </Trigger>
        </ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="BlendApplicationMenuStyle" TargetType="{x:Type local:ApplicationMenu}">
		<!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
		<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
		<Setter Property="Template" Value="{StaticResource ApplicationMenuTemplate}"/>
		<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
	</Style>

	<Style BasedOn="{StaticResource BlendApplicationMenuStyle}" TargetType="{x:Type local:ApplicationMenu}"/>
	
	<!--CustomScrollViewer-->
	<Style x:Key="CustomScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
		<Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
		<Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
		<Setter Property="Control.Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ScrollViewer}">
					<Grid SnapsToDevicePixels="True">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Border Grid.Column="0" Grid.Row="1">
							<ScrollContentPresenter Margin="{TemplateBinding Control.Padding}" CanVerticallyScroll="False" CanHorizontallyScroll="False" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Content="{TemplateBinding ContentControl.Content}" />
						</Border>
						<RepeatButton x:Name="PART_TopButton" CommandTarget="{x:Null}" Visibility="Visible" Focusable="False" Command="ScrollBar.LineUpCommand" Grid.Column="0" Grid.Row="0">
							<RepeatButton.Style>
								<Style TargetType="{x:Type RepeatButton}">
									<Setter Property="ButtonBase.ClickMode" Value="Hover"/>
									<Setter Property="MinWidth" Value="0"/>
									<Setter Property="MinHeight" Value="0"/>
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="{x:Type RepeatButton}">
												<Border Margin="1,1,1,1" BorderBrush="{StaticResource Blend.MenuCustomScrollBorderBrush}" CornerRadius="1,1,1,1" BorderThickness="1,1,1,1" Name="MenuScrollButtonBorder" Background="{StaticResource Blend.MenuCustomScrollBrush}">
													<ContentPresenter Margin="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Center" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Content="{TemplateBinding ContentControl.Content}" />
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="ButtonBase.IsPressed" Value="True">
														<Setter Property="Border.BorderBrush" TargetName="MenuScrollButtonBorder" Value="{StaticResource Blend.MenuScrollPressedBorderBrush}" />
														<Setter Property="Panel.Background" TargetName="MenuScrollButtonBorder" Value="{StaticResource Blend.MenuScrollPressedBrush}" />
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</RepeatButton.Style>
							<Path Data="M0,4L3.5,0 7,4z" Fill="{StaticResource Blend.Foreground2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</RepeatButton>
						<RepeatButton x:Name="PART_BottomButton" CommandTarget="{x:Null}" Visibility="Visible" Focusable="False" Command="ScrollBar.LineDownCommand" Grid.Column="0" Grid.Row="2">
							<RepeatButton.Style>
								<Style TargetType="{x:Type RepeatButton}">
									<Setter Property="ButtonBase.ClickMode" Value="Hover"/>
									<Setter Property="MinWidth" Value="0"/>
									<Setter Property="MinHeight" Value="0"/>
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="{x:Type RepeatButton}">
												<Border Margin="1,1,1,1" BorderBrush="{StaticResource Blend.MenuCustomScrollBorderBrush}" CornerRadius="1,1,1,1" BorderThickness="1,1,1,1" Name="MenuScrollButtonBorder" Background="{StaticResource Blend.MenuCustomScrollBrush}">
													<ContentPresenter Margin="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Center" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Content="{TemplateBinding ContentControl.Content}" />
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="ButtonBase.IsPressed" Value="True">
														<Setter Property="Border.BorderBrush" TargetName="MenuScrollButtonBorder" Value="{StaticResource Blend.MenuScrollPressedBorderBrush}" />
														<Setter Property="Panel.Background" TargetName="MenuScrollButtonBorder" Value="{StaticResource Blend.MenuScrollPressedBrush}" />
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</RepeatButton.Style>
							<Path Data="M0,0L3.5,4 7,0z" Fill="{StaticResource Blend.Foreground2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</RepeatButton>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="ComputedVerticalScrollBarVisibility" Value="Collapsed">
							<Setter TargetName="PART_BottomButton" Property="Visibility" Value="Collapsed"/>
							<Setter TargetName="PART_TopButton" Property="Visibility" Value="Collapsed"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--ScreenTip-->
	<Style  x:Key="BlendScreenTipStyle" TargetType="{x:Type local:ScreenTip}">
		<Setter Property="BorderThickness" Value="1" />
		<!--<Setter Property="FontSize" Value="11.5"/>
		<Setter Property="FontFamily" Value="Segoe UI"/>-->
		<Setter Property="BorderBrush" Value="Gray" />
		<Setter Property="Background" Value="{StaticResource Blend.ScreenTipBackground}" />
		<Setter Property="Padding" Value="1,1,3,1" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="HasDropShadow" Value="True"/>
		<Setter Property="Template">
			<Setter.Value>
			  
				<ControlTemplate TargetType="{x:Type local:ScreenTip}">
					<Microsoft_Windows_Themes:SystemDropShadowChrome Name="Shdw" Color="Transparent" SnapsToDevicePixels="true">
						<Border MinHeight="20"
								CornerRadius="2"
								Background="{TemplateBinding Background}"
								BorderThickness="{TemplateBinding BorderThickness}"
								BorderBrush="{TemplateBinding BorderBrush}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="1.5*" />
									<RowDefinition Height="Auto" />
									<RowDefinition  />
									<RowDefinition Height="Auto" />

								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontSize="12" FontWeight="Bold" FontFamily="Calibri"  Margin="4,4,1,4" Foreground="White"
										 Text="{TemplateBinding Description}" Name="Desc" />
								<StackPanel Orientation="Horizontal" Grid.Row="1">
									<Border  Margin="6" Name="Image" VerticalAlignment="Center">
										<Image  Source="{Binding Path=ImageSource, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
									</Border>
									<ContentPresenter Margin="2,1,4,6" Grid.Row="1"  Name="Text" 
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" TextBlock.Foreground="#FF4C4C4C"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
								</StackPanel>
								<Border Name="PART_Seperator" Margin="4,1,4,0" Background="Gray"   Grid.Row="2" Height="1" SnapsToDevicePixels="True"  Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Stretch" />
								<Grid Grid.Row="3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="20"/>
										<ColumnDefinition  />
									</Grid.ColumnDefinitions>
									<Border  HorizontalAlignment="Left"   Grid.Column="0" Margin="4,4,0,4" x:Name="HelpImage">
										<Image Height="16" x:Name="helpImage" Width="16"  Source="{Binding Path=HelpIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
									</Border>
									<TextBlock HorizontalAlignment="Left"  Name="PART_HelpText" Text="{TemplateBinding HelpText}"  Grid.ColumnSpan="2" Grid.Column="0"
											   FontSize="12" FontWeight="Bold" FontFamily="Calibri"  Margin="28,4,1,4" Foreground="White" />
								</Grid>
							</Grid>
						</Border>
					</Microsoft_Windows_Themes:SystemDropShadowChrome>

					<ControlTemplate.Triggers>
						<Trigger Property="HasDropShadow" Value="true">
							<Setter TargetName="Shdw" Property="Margin" Value="0,0,5,5" />
							<Setter TargetName="Shdw" Property="Color" Value="#71000000" />
						</Trigger>
						
						<Trigger Property="HelpIcon" Value="{x:Null}" >
							<Setter TargetName="helpImage" Property="Source" Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/HelpSmall.png" />
						</Trigger>
						<Trigger Property="Description" Value="">
							<Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="Text" Property="Margin" Value="4,1,4,1" />
						</Trigger>
						<Trigger Property="HelpText" Value="">

							<Setter TargetName="HelpImage" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_Seperator" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_HelpText" Property="Visibility" Value="Collapsed" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style BasedOn="{StaticResource BlendScreenTipStyle}" TargetType="{x:Type local:ScreenTip}"/>	
	
	<!--RibbonPage-->
	<Style x:Key="BlendRibbonPageStyle" TargetType="{x:Type local:RibbonPage}">
