	<!--RibbonGalleryItem-->
	<!--GalleryItem template-->
	<Style x:Key="BlendRibbonGalleryItemStyle" TargetType="{x:Type local:RibbonGalleryItem}">
		<Setter Property="ClickMode" Value="Release"/>
		<!--<Setter Property="FontSize" Value="11.5"/>
		<Setter Property="FontFamily" Value="Segoe UI"/>-->
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:RibbonGalleryItem}">
					<shared:TrippleBorder    Name="PART_TrippleBorder"
								   BorderThickness="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemMouseOverBorderThickness}"
								   BorderBrush="{TemplateBinding BorderBrush}"
								   Background="Transparent"
								   OutsideBorderThickness="1"
								   OutsideBorderBrush="Transparent"
								   CornerRadius="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemMouseOverBorderCornerRadius}"
								   MinWidth="0"
								   SnapsToDevicePixels="True">

						<ContentPresenter MinWidth="0"
							  ContentSource="{TemplateBinding Content}"
							  ContentTemplate="{TemplateBinding ContentTemplate}"
							  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
								/>
					</shared:TrippleBorder>

					<ControlTemplate.Triggers>

						<Trigger Property="IsChecked" Value="true">
							<Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource Luna.SelectedBrush.Blend}"/>
							<Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" 
					  Value="{StaticResource Blend.RibbonGalleryItem.IsChecked.BorderBrush.Outside}"/>
							<Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Blend.AppMenuCornerRadius}"/>
						</Trigger>

						<Trigger Property="IsMouseOver" Value="true">
							<Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Blend.AppMenuCornerRadius}"/>
							<Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{StaticResource Blend.RibbonGalleryItem.IsMouseOver.BorderBrush}"/>
							<Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource Luna.MouseOverBrush.Blend}"/>
						</Trigger>
                        <Trigger Property="IsFocused" Value="true">
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Blend.AppMenuCornerRadius}"/>
                            <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{StaticResource Blend.RibbonGalleryItem.IsMouseOver.BorderBrush}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource Luna.MouseOverBrush.Blend}"/>
                        </Trigger>

						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsMouseOver" Value="True"/>
								<Condition Property="IsChecked" Value="True"/>
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Blend.AppMenuCornerRadius}"/>
							<Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource Luna.HoverSelectedBrush.Blend}"/>
							<Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{StaticResource Blend.QuickDropDownBorderBrush}"/>
						</MultiTrigger>

						<Trigger Property="IsPressed" Value="true">
							<Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Blend.AppMenuCornerRadius}"/>
							<Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource Luna.PressedBrush.Blend}"/>
							<Setter TargetName="PART_TrippleBorder"  
					  Property="OutsideBorderBrush" Value="{StaticResource Blend.RibbonGalleryItem.IsPressed.BorderBrush.Outside}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

	</Style>
	<!--MouseOverBrush HoverSelectedBrush SelectedBrush PressedBrush-->

	<Style BasedOn="{StaticResource BlendRibbonGalleryItemStyle}" TargetType="{x:Type local:RibbonGalleryItem}"/>
	
	<!--RibbonGallery-->
	<local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

	<Style x:Key="BlendGalleryFilterSelectorStyle" TargetType="{x:Type local:GalleryFilterSelector}">
		<Setter Property="Visibility" Value="Collapsed"/>
		<Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:GalleryFilterSelector}">
					<Grid>
						<Border Height="15" 
					Name="PART_DropDownButton" 
					Background="{StaticResource Blend.RibbonBarHeaderBackground}"
					BorderThickness="0,0,0,1" 
					BorderBrush="{StaticResource Blend.QuickDropDownBorder}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Margin="10,0,0,0" 
							
						   FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
						   FontStyle="Normal"                            
						   FontSize="12"
						   VerticalAlignment="Center"
						   Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GalleryFilterSelector}},                  
										  Path=SelectedFilter.Label}"/>
								<Path Fill="{TemplateBinding Foreground}"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Data="M 0 0 L 4 4 L 8 0 Z"
								Margin="1"/>
							</StackPanel>
						</Border>

						<Popup Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" IsOpen="{Binding Path=IsDropDownOpen,  Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:GalleryFilterSelector}}}">
							<mwt:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="True">
								<local:RibbonButtonChecker ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GalleryFilterSelector}},
										Converter={StaticResource GalleryFilterConverter}, 
										ConverterParameter={StaticResource RibbonButtonPopupItemStyle},
										Path=Filters}" CheckedButton="{Binding Mode=TwoWay,
										  RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GalleryFilterSelector}},
										  Converter={StaticResource FilterToRibbonButtonConverter},
										  Path=SelectedFilter}"/>
							</mwt:SystemDropShadowChrome>
						</Popup>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
							<Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Foreground" Value="{StaticResource Blend.GalleryFilterSelection}"/>
			</Trigger>

			<DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=HasFilters}" Value="True">
				<Setter Property="Filters" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=GalleryFilters}"/>
				<Setter Property="SelectedFilter" Value="{Binding Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=CurrentFilter}"/>
				<Setter Property="Visibility" Value="Visible"/>
				<!--Filters="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=GalleryFilters}"
		SelectedFilter="{Binding Mode=TwoWay,
		RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}},
		Path=CurrentFilter}"-->
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style BasedOn="{StaticResource BlendGalleryFilterSelectorStyle}" TargetType="{x:Type local:GalleryFilterSelector}"/>
	
	<Style x:Key="BlendRibbonButtonCheckerStyle" TargetType="{x:Type local:RibbonButtonChecker}">
		<Setter Property="MinWidth" Value="120"/>
		<Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:RibbonButtonChecker}">
					<!--<ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonButtonChecker}},                  
											  Path=Items}">
			<ItemsControl.ItemsPanel>
			  <ItemsPanelTemplate>
				<StackPanel/>
			  </ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
		  </ItemsControl>-->
					<Border Background="{StaticResource Blend.RibbonButtonChecked}">
						<ItemsPresenter/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<StackPanel/>
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style BasedOn="{StaticResource BlendRibbonButtonCheckerStyle}" TargetType="{x:Type local:RibbonButtonChecker}"/>
	
	<ControlTemplate x:Key="HorizontalAndVerticalResizeThumb" TargetType="{x:Type local:PopupResizeThumb}">
		<Border Width="10" Height="10"
			Background="Transparent"
			VerticalAlignment="Center"
			HorizontalAlignment="Center">
			<Path Margin="0,0,2,2" Data="M7,0L7,7 0,7 0,4 4,4 4,0z"
			HorizontalAlignment="Right" VerticalAlignment="Bottom">
				<Path.Fill>
					<DrawingBrush ViewboxUnits="Absolute" TileMode="Tile" Viewbox="0,0,4,4" Viewport="0,0,4,4" ViewportUnits="Absolute">
						<DrawingBrush.Drawing>
							<DrawingGroup>
								<DrawingGroup.Children>
									<GeometryDrawing Brush="#00FFFFFF">
										<GeometryDrawing.Geometry>
											<RectangleGeometry Rect="0,0,1,1" />
										</GeometryDrawing.Geometry>
									</GeometryDrawing>
									<GeometryDrawing Brush="#C0C6D6"  Geometry="M1,1L3,1 3,3 1,3z" />
									<GeometryDrawing Brush="#5574A7"  Geometry="M0,0L2,0 2,2 0,2z" />
								</DrawingGroup.Children>
							</DrawingGroup>
						</DrawingBrush.Drawing>
					</DrawingBrush>
				</Path.Fill>
			</Path>
		</Border>

		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Cursor" Value="SizeNWSE"/>
			</Trigger>
			<Trigger Property="FlowDirection" Value="RightToLeft">
				<Setter Property="Cursor" Value="SizeNESW"/>
			</Trigger>
			
		</ControlTemplate.Triggers>
	</ControlTemplate>


