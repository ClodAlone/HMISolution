	<SolidColorBrush x:Key="Blend.GalleryRepeatButton.IsPressed.BackgroundBrush" Color="#FF424242"/>
	<SolidColorBrush x:Key="Blend.GalleryRepeatButton.IsPressed.BorderBrush" Color="Transparent"/>
	<SolidColorBrush x:Key="Blend.GalleryRepeatButton.IsEnabled.BackgroundBrush" Color="Transparent"/>
	<SolidColorBrush x:Key="Blend.RibbonGalleryItem.IsChecked.BorderBrush.Outside" Color="#FF333333"/>
	<SolidColorBrush x:Key="Blend.RibbonGalleryItem.IsPressed.BorderBrush.Outside" Color="#FF333333"/>
	<SolidColorBrush x:Key="Blend.RibbonGalleryItem.IsMouseOver.BorderBrush" Color="#FF333333"/>
	<SolidColorBrush x:Key="Blend.GalleryBottomBackground" Color="#FF595959"/>
	<SolidColorBrush x:Key="Blend.ResizeThumb1" Color="#FFAAAAAA"/>
	<SolidColorBrush x:Key="Blend.ResizeThumb2" Color="#FFAAAAAA"/>
	<SolidColorBrush x:Key="Blend.GalleryHoverBorderBrush" Color="Transparent"/>
	<SolidColorBrush x:Key="Blend.RibbonMouseOverBrush" Color="#FF666666"/>
	<SolidColorBrush x:Key="Blend.GalleryOuterHoverBorderBrush" Color="#FF666666"/>
	<SolidColorBrush x:Key="Blend.Foreground3" Color="#FF000000"/>
	<SolidColorBrush x:Key="Blend.ComboBoxItemBrush" Color="#FF424242"/>


	  <ContentControl x:Key="Path">
		<ContentControl.Style>
			<Style>
				<Setter Property="Control.OverridesDefaultStyle"  Value="True"/>
				<Setter Property="Control.HorizontalAlignment" Value="Center"/>
				<Setter Property="Control.VerticalAlignment" Value="Top"/>
				<Setter Property="Control.Height" Value="14"/>
				<Setter Property="Control.FontSize" Value="11.5"/>
				<Setter Property="Control.Margin" Value="0,-1,0,0"/>
				<Setter Property="Control.FontFamily" Value="Segoe UI"/>
				<Setter Property="Control.Foreground" Value="{StaticResource Blend.Foreground2}"/>
				<Setter Property="Control.Template">
					<Setter.Value>
						<ControlTemplate TargetType="ContentControl">
							<Border>
								<Path Data="{StaticResource Blend.PathData}" Margin="0,6,0,0" StrokeThickness="2" Stroke="{StaticResource Blend.PathFill}"  HorizontalAlignment="Center" Fill="{StaticResource Blend.PathFill1}"/>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ContentControl.Style>
	</ContentControl>
	
	<Style x:Key="RibbonButtonPopupItemStyle" TargetType="{x:Type local:RibbonButton}">
		<Setter  Property="OverridesDefaultStyle" Value="true"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}"/>
		<Setter Property="Height" Value="23"/>
		<Setter Property="BorderThickness" Value="1"/>

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:RibbonButton}">
					<Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Panel.Background}"
						Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}" MinHeight="{TemplateBinding MinHeight}"
						MaxHeight="{TemplateBinding MaxHeight}"  Margin="{TemplateBinding Margin}"  SnapsToDevicePixels="True">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="21"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<Border Name="PART_CheckBorder" Grid.Column="0" Visibility="Collapsed" 
								Width="21" Height="21" BorderThickness="1" BorderBrush="{StaticResource Blend.QuickCheckedButtonBorderBrush}"  
								Background="{StaticResource Blend.QuickCheckedButtonBackgroundBrush}" CornerRadius="{StaticResource Blend.QuickDropDownCornerRadius}">
								<Path Stroke="{StaticResource Blend.Foreground2}" StrokeThickness="1.4">
									<Path.Data>
										<GeometryGroup>
											<LineGeometry StartPoint="6 9" EndPoint="9 16"/>
											<LineGeometry StartPoint="9 16" EndPoint="13 3"/>
										</GeometryGroup>
									</Path.Data>
								</Path>
							</Border>
							<TextBlock Grid.Column="1" Margin="10,0,0,0" Name="label"  Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="PART_CheckBorder" Property="Visibility" Value="Visible"/>
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="label" Property="Foreground" Value="{StaticResource Blend.Foreground3}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{StaticResource Luna.MouseOverBrush.Blend}"/>
				<Setter Property="BorderBrush" Value="{StaticResource Blend.QuickDropDownButtonHoverBorder}"/>
			</Trigger>
		</Style.Triggers>
	</Style>

	<!--RibbonScrollingButton style-->
	<ControlTemplate x:Key="RibbonScrollingButtonTemplate" TargetType="{x:Type Button}">
		<Border x:Name="PART_Border" VerticalAlignment="Stretch" HorizontalAlignment="Center"
				BorderThickness="1,0,0,0"
				BorderBrush="{TemplateBinding BorderBrush}"
				Background="{TemplateBinding Background}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True"
				CornerRadius="0,3,3,0">
			<Border x:Name="PART_InnerBorder" VerticalAlignment="Stretch" HorizontalAlignment="Center"
				BorderThickness="1,0,0,0"
				BorderBrush="{StaticResource Blend.CheckBoxBackground}"
				Background="{TemplateBinding Background}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True" CornerRadius="0,3,3,0">
				<Path x:Name="PART_Path" Stroke="{StaticResource Blend.PathFill}" StrokeThickness="2" Fill="{StaticResource Blend.PathFill1}" Margin="3,16,-2,0"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  Data="{StaticResource Blend.PathData}">
					<Path.RenderTransform>
						<RotateTransform Angle="-90"/>
					</Path.RenderTransform>
				</Path>
			</Border>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="Tag" Value="Left">
				<Setter TargetName="PART_Path" Property="Margin" Value="6,0,-5,0"/>
				<Setter TargetName="PART_Path" Property="RenderTransform">
					<Setter.Value>
						<RotateTransform Angle="90"/>
					</Setter.Value>
				</Setter>
				<Setter TargetName="PART_Border" Property="CornerRadius" Value="3,0,0,3"/>
				<Setter TargetName="PART_InnerBorder" Property="CornerRadius" Value="3,0,0,3"/>
				<Setter TargetName="PART_Border" Property="BorderThickness" Value="0,0,1,0"/>
				<Setter TargetName="PART_InnerBorder" Property="BorderThickness" Value="0,0,1,0"/>
			</Trigger>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Luna.MouseOverBrush.Blend}"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>


	<Style x:Key="RibbonScrollingButton" TargetType="{x:Type Button}">
		<Setter Property="shared:SkinStorage.VisualStyle" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Ribbon}}, Path=(shared:SkinStorage.VisualStyle), Mode=OneWay}"/>
		<!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Ribbon}}, Path=(shared:SkinStorage.VisualStylesList), Mode=OneWay}"/>-->
		<Setter Property="Template" Value="{StaticResource RibbonScrollingButtonTemplate}"/>
		<Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}"/>
		<Setter Property="Background" Value="{StaticResource Blend.RibbonBackground}"/>
		<Setter Property="BorderBrush" Value="{StaticResource Blend.ImageBorderBrush}"/>
		<Style.Triggers>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Opacity" Value="0.5"/>
			</Trigger>
		</Style.Triggers>
	</Style>

	<!--RibbonLauncherButton-->
	<ControlTemplate x:Key="RibbonBarLauncherTemplate" TargetType="{x:Type local:RibbonButton}">
		<Border VerticalAlignment="Center" 
			HorizontalAlignment="Center"
			CornerRadius="{TemplateBinding CornerRadius}"
			BorderThickness="{TemplateBinding BorderThickness}"
			BorderBrush="{TemplateBinding BorderBrush}"
			Background="{TemplateBinding Background}"
			SnapsToDevicePixels="True" Name="Background"
			Width="{TemplateBinding Width}"
			Height="{TemplateBinding Height}">
			<Border x:Name="PART_InnerBorder" 
			  Width="13" 
			  Height="12"
			  VerticalAlignment="Center" 
			  HorizontalAlignment="Center"
			  CornerRadius="{TemplateBinding CornerRadius}"
			  BorderThickness="{TemplateBinding BorderThickness}"
			  BorderBrush="{TemplateBinding BorderBrush}"
			  Background="{TemplateBinding Background}" 
			  SnapsToDevicePixels="True">
				<Canvas Margin="1,0,0,0" Width="8" Height="8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
					<Path Stroke="{StaticResource Blend.PathFill}">
						<Path.Data>
							<GeometryGroup>
								<LineGeometry StartPoint="0.5,0" EndPoint="0.5,6"/>
								<LineGeometry StartPoint="0,0.5" EndPoint="6,0.5"/>
								<LineGeometry StartPoint="3,3.5" EndPoint="4,3.5"/>
								<LineGeometry StartPoint="4,4.5" EndPoint="6,4.5"/>
								<LineGeometry StartPoint="4,5.5" EndPoint="6,5.5"/>
								<LineGeometry StartPoint="3,6.5" EndPoint="7,6.5"/>
								<LineGeometry StartPoint="6.5,3" EndPoint="6.5,7"/>
							</GeometryGroup>
						</Path.Data>
					</Path>
					<Path x:Name="PART_WhitePath" Stroke="{StaticResource Blend.TextBoxBackgroundHover}">
						<Path.Data>
							<GeometryGroup>
								<LineGeometry StartPoint="1.5,1" EndPoint="1.5,6"/>
								<LineGeometry StartPoint="1,1.5" EndPoint="6,1.5"/>
								<LineGeometry StartPoint="4,3.5" EndPoint="5,3.5"/>
								<LineGeometry StartPoint="4,7.5" EndPoint="8,7.5"/>
								<LineGeometry StartPoint="7.5,3" EndPoint="7.5,8"/>
							</GeometryGroup>
						</Path.Data>
					</Path>
				</Canvas>
			</Border>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="PART_InnerBorder" Property="BorderThickness" Value="1"/>
				<Setter TargetName="PART_InnerBorder" Property="BorderBrush" Value="White"/>
				<Setter TargetName="PART_InnerBorder" Property="Opacity" Value="0.8"/>
				<Setter TargetName="PART_WhitePath" Property="Opacity" Value="0.6"/>
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter TargetName="PART_InnerBorder" Property="BorderThickness" Value="1"/>
				<Setter TargetName="PART_InnerBorder" Property="BorderBrush" Value="White"/>
				<Setter TargetName="PART_WhitePath" Property="Opacity" Value="0.6"/>
			</Trigger>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource Blend.ToggleButton.IsMouseOverBorderBrush}"/>
				<Setter TargetName="Background" Property="Background" Value="{StaticResource Luna.MouseOverBrush.Blend}"/>
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource Blend.ToggleButton.IsCheckedBorder}"/>
				<Setter TargetName="Background" Property="Background" Value="{StaticResource Blend.LauncharPressedBrush}"/>
			</Trigger>

		</ControlTemplate.Triggers>
	</ControlTemplate>


	<!--RibbonBarLauncherButton style-->
