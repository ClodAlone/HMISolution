                                    <ItemsControl Margin="0,3,0,2" Focusable="False" Foreground ="{TemplateBinding Foreground}"	FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" x:Name="PART_Label" >
