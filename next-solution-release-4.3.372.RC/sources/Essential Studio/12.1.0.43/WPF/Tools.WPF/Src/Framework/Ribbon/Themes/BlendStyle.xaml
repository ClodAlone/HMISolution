						<Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource Blend.QATContextMenuBorderBrush}" Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BoolToVisibilityConverter}}"  Margin="1,1,1,1" Background="{StaticResource  Blend.MenuItemsHeaderBackground}" Height="{TemplateBinding ActualHeight}" Width="22" Panel.ZIndex="-1" HorizontalAlignment="Left"/>
