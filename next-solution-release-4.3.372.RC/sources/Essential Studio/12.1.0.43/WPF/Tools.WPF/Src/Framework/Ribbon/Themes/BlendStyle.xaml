	<!--RibbonListBox-->
	<Style x:Key="UpButtonStyle" TargetType="{x:Type RepeatButton}">
		<Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True"/>
		<Setter Property="Control.Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Border BorderBrush="#FFC5D1DE" CornerRadius="0,0,0,0" BorderThickness="1,1,1,1" Name="RepeatBorder" Background="{DynamicResource RepeatBorderBackgroundDisabled}">
						<Border BorderBrush="#FFE8EAED" CornerRadius="0,0,0,0" BorderThickness="1,1,1,1" Name="RepeatBorderInner">
							<Path Data="M 0 4 L 7 4 L 3.5 0 Z" Fill="#FFB7B7B7" Name="RepeatSign" HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="UIElement.IsEnabled" Value="True">
							<Setter Property="Border.BorderBrush" TargetName="RepeatBorder" Value="{StaticResource Blend.RepeatBorderBrush}" />
							<Setter Property="Panel.Background" TargetName="RepeatBorder" Value="{StaticResource Blend.RepeatBorderBackgroundEanbled}" />
							<Setter Property="Border.BorderBrush" TargetName="RepeatBorderInner" Value="{StaticResource Blend.RepeatInnerBorderBrush}" />
							<Setter Property="Shape.Fill" TargetName="RepeatSign" Value="{StaticResource Blend.PathFill}" />
						</Trigger>
						<Trigger Property="UIElement.IsMouseOver" Value="True">
							<Setter Property="Border.BorderBrush" TargetName="RepeatBorder" Value="{StaticResource Blend.ToggleButton.IsMouseOverBorderBrush}" />
							<Setter Property="Panel.Background" TargetName="RepeatBorder" Value="{StaticResource Blend.ToggleButton.IsMouseOverBrush}">

							</Setter>
							<Setter Property="Foreground" Value="{StaticResource Blend.Foreground3}"/>
							<Setter Property="Border.BorderBrush" TargetName="RepeatBorderInner" Value="{StaticResource Blend.CheckBoxBackground}" />
						</Trigger>
						<Trigger Property="ButtonBase.IsPressed" Value="True">
							<Setter Property="Border.BorderBrush" TargetName="RepeatBorder" Value="{StaticResource Blend.ToggleButton.IsCheckedBorder}" />
							<Setter Property="Panel.Background" TargetName="RepeatBorder" Value="{StaticResource Blend.ToggleButton.IsCheckedBrush}">
							</Setter>
							<Setter Property="Border.BorderBrush" TargetName="RepeatBorderInner" Value="{StaticResource Blend.MenuButton.InnerBorderBrush}">
							</Setter>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

