							<Setter Property="Border.BorderBrush" TargetName="RepeatBorder" Value="{StaticResource Blend.ToggleButton.IsCheckedBorder}" />
							<Setter Property="Panel.Background" TargetName="RepeatBorder" Value="{StaticResource Blend.ToggleButton.IsCheckedBrush}">
