					<Condition Binding="{Binding ElementName=PART_RibbonDropDownButton, Path=IsDropDownOpen}" Value="True"/>
				</MultiDataTrigger.Conditions>
				<Setter TargetName="PART_InnerBorder" Property="BorderBrush" Value="{StaticResource RibbonBar.Context.BorderBrush}"/>
			</MultiDataTrigger>

			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
