																<Setter Property="Border.Margin" Value="0,-7,0,1" />
															</Trigger>
														</Style.Triggers>
													</Style>
												</Border.Style>
												<ItemsPresenter/>
											</Border>
										</DockPanel>


										<Popup x:Name="Part_AdornerPopup" AllowsTransparency="True" PlacementTarget="{Binding ElementName=dockPanel}" IsOpen="False"  ClipToBounds="True"   StaysOpen="False" VerticalOffset="-1">
											<Border x:Name="borderpopup" MinHeight="92"  Margin="0,7,0,15"  Background="{StaticResource Blend.RibbonTabPanelBackground}">
												<Border 
				  Padding="0"   
				  BorderThickness="1" 				  
				  VerticalAlignment="{TemplateBinding VerticalAlignment}"
				  CornerRadius="3" Margin="3,0,3,0"
				  BorderBrush="{TemplateBinding BorderBrush}"
				  Background="{TemplateBinding Background}">
												<local:RibbonTabItemsControl Focusable="False" 
																			 ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedTabItem.Items}" 
																			 ItemTemplateSelector="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedTabItem.ItemTemplateSelector}" 
																			 ItemTemplate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedTabItem.ItemTemplate}"
																			 DisplayMemberPath="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedTabItem.DisplayMemberPath}" 
																			 ItemContainerStyle="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedTabItem.ItemContainerStyle}"
																			 ItemContainerStyleSelector="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedTabItem.ItemContainerStyleSelector}"
																			 ItemStringFormat="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedTabItem.ItemStringFormat}">
													<local:RibbonTabItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<local:RibbonLayoutPanel />
														</ItemsPanelTemplate>
													</local:RibbonTabItemsControl.ItemsPanel>
												</local:RibbonTabItemsControl>
												</Border>
											</Border>
										</Popup>
									</Grid>

								</Border>
							</AdornerDecorator>
							<ControlTemplate.Triggers>
								<Trigger Property="componentModel:DesignerProperties.IsInDesignMode" Value="True">
									<Setter TargetName="PART_AdornerDecorator" 
						Property="Margin" Value="0"/>
								</Trigger>
								<Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
									<Setter Property="Margin" Value="17,-5,0,2" TargetName="ribbonTabBorder"/>
									<Setter Property="Margin" Value="0,-43,0,0" TargetName="PART_AdornerDecorator"/>
									<Setter Property="Height" TargetName="borderpopup" Value="147"/>
                                    <Setter Property="Visibility" Value="Collapsed" TargetName="subBorder"/>
                                    <Setter Property="Visibility" Value="Collapsed" TargetName="subBorder1"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Trigger>

			<MultiTrigger >
				<MultiTrigger.Conditions>
					<Condition  Property="RibbonState" Value="Normal"/>
					<Condition Property="IsQATBelow" Value="True"/>
				</MultiTrigger.Conditions>
				<Setter Property="Template" Value="{StaticResource QATBelow}"/>
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="RibbonState" Value="Hide"></Condition>
					<Condition Property="IsQATBelow" Value="False"></Condition>
				</MultiTrigger.Conditions>
				<Setter Property="Template" Value="{StaticResource Hide}"/>
			</MultiTrigger>
		  <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Maximized">
			<Setter Property="Margin" Value="0,2,0,0"/>
		  </DataTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="RibbonState" Value="Hide"></Condition>
					<Condition Property="IsQATBelow" Value="True"></Condition>
				</MultiTrigger.Conditions>
				<Setter Property="Template" Value="{StaticResource HideQATBelow}"/>
			</MultiTrigger>
			<!-- <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self},  Path=SelectedTabItem.HasContextTabGroup}"
				   Value="True">
				<Setter Property="Background"
				Value="{Binding RelativeSource={RelativeSource Self},
					  Converter={StaticResource ColorToTabButtonContextBrush}, 
					  ConverterParameter={StaticResource RibbonBlendContextGradient},
					  Path=SelectedTabItem.ContextColor}" />
			</DataTrigger> -->
			<Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
				<Setter Property="Height" Value="175"/>
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="RibbonState" Value="Normal" />
					<Condition Property="IsQATBelow" Value="False" />
					<Condition Property="shared:SkinStorage.EnableTouch" Value="True"/>
				</MultiTrigger.Conditions>
				<Setter Property="Height" Value="175"/>
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="RibbonState" Value="Normal" />
					<Condition Property="IsQATBelow" Value="True" />
					<Condition Property="shared:SkinStorage.EnableTouch" Value="True"/>
				</MultiTrigger.Conditions>
				<Setter Property="Height" Value="210"/>
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="RibbonState" Value="Hide" />
					<Condition Property="IsQATBelow" Value="False" />
					<Condition Property="shared:SkinStorage.EnableTouch" Value="True"/>
				</MultiTrigger.Conditions>
				<Setter Property="Height" Value="30"/>
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="RibbonState" Value="Hide" />
					<Condition Property="IsQATBelow" Value="True" />
					<Condition Property="shared:SkinStorage.EnableTouch" Value="True"/>
				</MultiTrigger.Conditions>
				<Setter Property="Height" Value="80"/>
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="RibbonState" Value="Adorner" />
					<Condition Property="IsQATBelow" Value="False" />
					<Condition Property="shared:SkinStorage.EnableTouch" Value="True"/>
				</MultiTrigger.Conditions>
				<Setter Property="Height" Value="150"/>
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="RibbonState" Value="Adorner" />
					<Condition Property="IsQATBelow" Value="True" />
					<Condition Property="shared:SkinStorage.EnableTouch" Value="True"/>
				</MultiTrigger.Conditions>
				<Setter Property="Height" Value="80"/>
			</MultiTrigger>
		</Style.Triggers>
	</Style>

	<Style BasedOn="{StaticResource BlendRibbonStyle}" TargetType="{x:Type local:Ribbon}"/>
	
	<!--QuickAccessToolBar-->
	<local:RibbonStateToBooleanConverter x:Key="ribbonStateToBooleanConverter"/>

	<!--DropDownButton style for QuickAccessToolBar-->
	<Style x:Key="QuickAccessPopupButtonStyle" TargetType="{x:Type local:DropDownButton}">
		<Setter  Property="OverridesDefaultStyle"     Value="true"/>
		<Setter Property="Width" Value="15"/>
		<Setter Property="Height" Value="20"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
		<Setter  Property="IsTabStop" Value="false"/>
		<Setter  Property="ButtonBase.ClickMode">
			<Setter.Value>
				<x:Static
			Member="ClickMode.Press" />
			</Setter.Value>
		</Setter>
		<!--<Setter Property="ItemsPanel">
	  <Setter.Value>
		<StackPanel></StackPanel>
	  </Setter.Value>
	</Setter>-->
		<!--<Setter Property="IsToggle" Value="true"/>-->
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:DropDownButton}">
					<Border Name="PART_ToggleButton" 
		   BorderThickness="{TemplateBinding BorderThickness}"
		   BorderBrush="{TemplateBinding BorderBrush}" 
		   Background="{TemplateBinding Panel.Background}"
		   Width="13" 
		   Height="{TemplateBinding Height}" 
		   CornerRadius="{StaticResource Blend.QuickDropDownCornerRadius}">
						<Grid>
							<Path 
					Stroke="{StaticResource Blend.Foreground2}" 
					Fill="{StaticResource Blend.Foreground2}"              
					StrokeThickness="1"
					Data="{TemplateBinding PathGeometry}"/>

							<Popup Name="PART_Popup"  
				Placement="Bottom"                  
				Focusable="False"                       
				PopupAnimation="Fade"
				AllowsTransparency="True"     
				StaysOpen="False"
				IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:DropDownButton}}}">
								<Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="PART_Shadow" Margin="0" SnapsToDevicePixels="true">
									<Border Background="{StaticResource Blend.QuickDropDownBackground}" CornerRadius="{StaticResource Blend.QuickDropDownCornerRadius}" >
									   <ItemsPresenter/>
									</Border>
								</Microsoft_Windows_Themes:SystemDropShadowChrome>
							</Popup>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
							<Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{StaticResource Luna.MouseOverBrush.Blend}"/>
				<Setter Property="BorderBrush" Value="{StaticResource Blend.QuickHoverDropDownBorder}"/>
				<Setter Property="Foreground" Value="{StaticResource Blend.Foreground3}"/>
			</Trigger>

			<Trigger Property="IsDropDownOpen" Value="True">
				<Setter Property="Background" Value="{StaticResource Luna.PressedBrush.Blend}"/>
				<Setter Property="BorderBrush" Value="{StaticResource Blend.QuickDropDownBorder}"/>
			</Trigger>
			<!--<DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}"
					 Value="True">
		<Setter Property="Background" Value="Transparent"/>
	  </DataTrigger>-->
		</Style.Triggers>

	</Style>


	<ControlTemplate x:Key="QuickAccessToolBarTemplate" TargetType="{x:Type local:QuickAccessToolBar}">
		<Border       
	  Height="{TemplateBinding Height}" 
	  Width="{TemplateBinding  Width}"
	  BorderThickness="{TemplateBinding BorderThickness}"
	  BorderBrush="{TemplateBinding BorderBrush}" 
	  Background="{TemplateBinding Background}">
			<local:TwoItemsLayoutPanelEx Name="PART_PanelEx" shell:WindowChrome.IsHitTestVisibleInChrome="True"  MinRightWidth="30" MaxRightWidth="30">
				<ItemsControl Name="PART_Main" 
						Grid.Column="0" 
						Focusable="False">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<local:QuickAccessToolBarPanel						  
						HorizontalAlignment="Left"  
						ClipToBounds="True" 
						Background="Transparent"                                        
						GeometryBackground="{Binding Path=GeometryBackground, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:QuickAccessToolBar}}}"                                        
						GeometryStroke="{Binding Path=GeometryStroke, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:QuickAccessToolBar}}}"                                         
						GeometryStrokeThickness="{Binding Path=GeometryStrokeThickness, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:QuickAccessToolBar}}}"                                                                                                 
						HasGeometry="{Binding Path=HasGeometry, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:QuickAccessToolBar}}}"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>
				<Grid>
					<local:DropDownButton Style="{StaticResource QuickAccessPopupButtonStyle}"  Name="PART_PopupButton" Width="23">
						<local:DropDownButton.PathGeometry>
							<GeometryGroup>
								<LineGeometry StartPoint="4,7" EndPoint="9,7"/>
								<PathGeometry>
									<PathFigure StartPoint="5,10" IsFilled="True" IsClosed="True">
										<LineSegment Point="8,10"/>
										<LineSegment Point="6.5,12.5"/>
									</PathFigure>
								</PathGeometry>
							</GeometryGroup>
						</local:DropDownButton.PathGeometry>

						<Border BorderThickness="0.5" BorderBrush="{StaticResource Blend.QuickDropDownBorderBrush}" Padding="2" Width="auto">
							<Grid>
								<DockPanel>
									<Border HorizontalAlignment="Left"  DockPanel.Dock="Left" Width="25" Background="{StaticResource Blend.QATContextMenuLeftBarBackground}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Blend.QATContextMenuBorderBrush}" />
								</DockPanel>
								<StackPanel>

									<Border Background="{StaticResource Blend.QATContextMenuTopBarBackground}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Blend.QATContextMenuBorderBrush}" Margin="0,0,0,1" Height="22" Width="auto">
										<TextBlock x:Uid="CustomizeQATTextBlock"  Margin="3,0,0,0"  Foreground="{StaticResource Blend.QATContextMenuForeground}" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path= CustomizeQAT}" FontWeight="Bold" VerticalAlignment="Center" Width="auto" />
									</Border>
									<ItemsControl Name="PART_QATMenu">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
													<StackPanel.Resources>
														<Style TargetType="{x:Type local:RibbonButton}">
															<Setter  Property="OverridesDefaultStyle" Value="true"/>
															<Setter Property="Background" Value="Transparent"/>
															<Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}"/>
															<!--<Setter Property="Height" Value="23"/>-->
															<Setter Property="BorderThickness" Value="1"/>

															<Setter Property="Template">
																<Setter.Value>
																	<ControlTemplate TargetType="{x:Type local:RibbonButton}">
																		<Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Panel.Background}"
						Width="{TemplateBinding Width}" Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}" MinHeight="{TemplateBinding MinHeight}"
						MaxHeight="{TemplateBinding MaxHeight}"   Margin="{TemplateBinding Margin}"  SnapsToDevicePixels="True">
																			<Grid>
																				<Grid.ColumnDefinitions>
																					<ColumnDefinition Width="21"/>
																					<ColumnDefinition Width="Auto"/>
																				</Grid.ColumnDefinitions>

																				<Border Name="PART_CheckBorder" Grid.Column="0" Visibility="Collapsed" 
								Width="21" Height="21" BorderThickness="1" BorderBrush="{StaticResource Blend.QuickCheckedButtonBorderBrush}"  
								Background="{StaticResource Blend.QuickCheckedButtonBackgroundBrush}" CornerRadius="{StaticResource Blend.QuickDropDownCornerRadius}">
																					<Path Stroke="{StaticResource Blend.Foreground2}" StrokeThickness="1.4">
																						<Path.Data>
																							<GeometryGroup>
																								<LineGeometry StartPoint="6 9" EndPoint="9 16"/>
																								<LineGeometry StartPoint="9 16" EndPoint="13 3"/>
																							</GeometryGroup>
																						</Path.Data>
																					</Path>
																				</Border>
																				<TextBlock Grid.Column="1" Margin="10,0,0,0" Name="label"  Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
																			</Grid>
																		</Border>
																		<ControlTemplate.Triggers>
																			<Trigger Property="IsSelected" Value="True">
																				<Setter TargetName="PART_CheckBorder" Property="Visibility" Value="Visible"/>
																			</Trigger>
																			<Trigger Property="IsMouseOver" Value="True">
																				<Setter TargetName="label" Property="Foreground" Value="{StaticResource Blend.Foreground3}"/>
																			</Trigger>
																			<Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
																				<Setter Property="FontSize" Value="18"/>
																				<Setter Property="Padding" Value="16,9,16,9"/>
																			</Trigger>
																		</ControlTemplate.Triggers>
																	</ControlTemplate>
																</Setter.Value>
															</Setter>

															<Style.Triggers>
																<Trigger Property="IsMouseOver" Value="True">
																	<Setter Property="Background" Value="{StaticResource Luna.MouseOverBrush.Blend}"/>
																	<Setter Property="BorderBrush" Value="{StaticResource Blend.QuickDropDownButtonHoverBorder}"/>
																</Trigger>
															</Style.Triggers>
														</Style>
													</StackPanel.Resources>
												</StackPanel>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
									</ItemsControl>
									<Separator Name="TopSeperator" Visibility="Collapsed" Background="{StaticResource Blend.QuickDropDownSeparator}" Margin ="30,0,0,0"  Height="2"></Separator>
									<local:RibbonButton Name="PART_MoreCommands"  Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATMoreCommands}" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=EnableMoreCommands, Converter={StaticResource BooleanToVisibilityConverter}}"  Command="local:RibbonCommands.QATMoreCommands" Foreground="{StaticResource Blend.Foreground2}" Width="auto"/>
									<local:RibbonButton Name="PART_AboveButton" Visibility="Collapsed"  Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove" Foreground="{StaticResource Blend.Foreground2}" Width="auto"/>
									<local:RibbonButton Name="PART_BelowButton" Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}"  Command="local:RibbonCommands.PlaceQATBelow" Foreground="{StaticResource Blend.Foreground2}" Width="auto"/>
									<Separator Background="{StaticResource Blend.QuickDropDownSeparator}" Margin ="30,0,0,0"  Height="2"></Separator>
									<local:RibbonButton Name="PART_MinimizeButton"  Style="{StaticResource RibbonButtonPopupItemStyle}"  Command="local:RibbonCommands.MinimizeRibbon"  Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=MinimizeRibbon}" IsToggle="True" Foreground="{StaticResource Blend.Foreground2}" Width="auto"/>
								</StackPanel>
							</Grid>
						</Border>

					</local:DropDownButton>

					<local:DropDownButton  
			Grid.Column="1"
			Name="PART_OverflowButton"
			Style="{StaticResource QuickAccessPopupButtonStyle}"                           
			Visibility="Collapsed" 
			DockPanel.Dock="Right">
						<local:DropDownButton.PathGeometry>
							<GeometryGroup>
								<PathGeometry>
									<PathFigure StartPoint="3.5,8" IsFilled="True" IsClosed="True">
										<LineSegment Point="4.5,9"/>
										<LineSegment Point="3.5,10"/>
									</PathFigure>
								</PathGeometry>

								<PathGeometry>
									<PathFigure StartPoint="7.5,8" IsFilled="True" IsClosed="True">
										<LineSegment Point="8.5,9"/>
										<LineSegment Point="7.5,10"/>
									</PathFigure>
								</PathGeometry>

							</GeometryGroup>
						</local:DropDownButton.PathGeometry>

						<StackPanel Orientation="Horizontal" Background="{StaticResource Blend.QuickAccessActiveBrush}" MaxHeight="21">
							<ItemsControl Name="PART_PopupItemsControl" >
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
							</ItemsControl>

							<local:DropDownButton Name="PART_PopupButtonOverflowed"   Style="{StaticResource QuickAccessPopupButtonStyle}"
												Visibility="{TemplateBinding QATDropDownVisiblity}">
								<local:DropDownButton.PathGeometry>
									<GeometryGroup>
										<LineGeometry StartPoint="4,7" EndPoint="9,7"/>
										<PathGeometry>
											<PathFigure StartPoint="5,10" IsFilled="True" IsClosed="True">
												<LineSegment Point="8,10"/>
												<LineSegment Point="6.5,12.5"/>
											</PathFigure>

										</PathGeometry>
									</GeometryGroup>
								</local:DropDownButton.PathGeometry>

								<Border BorderThickness="0.5" BorderBrush="Gray" Padding="2" Width="220">
									<Grid>
										<DockPanel>
											<Border HorizontalAlignment="Left"  DockPanel.Dock="Left" Width="25" Background="{StaticResource Blend.QATContextMenuLeftBarBackground}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Blend.QATContextMenuBorderBrush}" />
										</DockPanel>
										<StackPanel>

											<Border Background="{StaticResource Blend.QATContextMenuTopBarBackground}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Blend.QATContextMenuBorderBrush}" Margin="0,0,0,1" Height="22">
												<TextBlock x:Uid="CustomizeQATTextBlock" Margin="3,0,0,0"  Foreground="{StaticResource Blend.QATContextMenuForeground}" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=CustomizeQAT}" FontWeight="Bold" VerticalAlignment="Center" />
											</Border>
											<ItemsControl Name="PART_QATMenuOverFlow" ItemContainerStyle="{StaticResource RibbonButtonPopupItemStyle}">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate>
														<StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"/>
													</ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
											</ItemsControl>
											<Separator Name="TopSeperatorOverFlow" Visibility="Collapsed" Background="{StaticResource Blend.QuickDropDownSeparator}" Margin="{StaticResource Blend.QuickDropDownMargin}" Height="2"></Separator>
											<local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATMoreCommands}" Command="local:RibbonCommands.QATMoreCommands" Foreground="{StaticResource Blend.Foreground2}" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=EnableMoreCommands, Converter={StaticResource BooleanToVisibilityConverter}}" />
											<local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle}" Visibility="{Binding ElementName=PART_AboveButton, Path=Visibility, Mode=TwoWay}"  Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove" Foreground="{StaticResource Blend.Foreground2}"/>
											<local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle}" Visibility="{Binding ElementName=PART_BelowButton, Path=Visibility, Mode=TwoWay}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}" Command="local:RibbonCommands.PlaceQATBelow" Foreground="{StaticResource Blend.Foreground2}"/>
											<Separator Background="{StaticResource Blend.QuickDropDownSeparator}" Margin="{StaticResource Blend.QuickDropDownMargin}" Height="2"></Separator>
											<local:RibbonButton  IsSelected="{Binding ElementName=PART_MinimizeButton, Path=IsSelected, Mode=TwoWay}"   Command="local:RibbonCommands.MinimizeRibbon"  Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=MinimizeRibbon}" IsToggle="True" Foreground="{StaticResource Blend.Foreground2}"/>
										</StackPanel>
									</Grid>
								</Border>
							</local:DropDownButton>
						</StackPanel>
					</local:DropDownButton>

				</Grid>
			</local:TwoItemsLayoutPanelEx>
		</Border>

		<ControlTemplate.Triggers>
			<Trigger Property="HasOverflowChildren" Value="True">
				<Setter TargetName="PART_PopupButton" Property="Visibility" Value="Collapsed"/>
				<Setter TargetName="PART_OverflowButton" Property="Visibility" Value="Visible"/>
			</Trigger>

			<Trigger Property="HasItems" Value="True"  SourceName="PART_QATMenu">
				<Setter Property="Visibility" TargetName="TopSeperator" Value="Visible" />
			</Trigger>
			<Trigger Property="HasItems" Value="True"  SourceName="PART_QATMenuOverFlow">
				<Setter Property="Visibility" TargetName="TopSeperatorOverFlow" Value="Visible" />
			</Trigger>

			<Trigger Property="HasGeometry" Value="False">
				<Setter TargetName="PART_AboveButton" Property="Visibility" Value="Visible"/>
				<Setter TargetName="PART_BelowButton" Property="Visibility" Value="Collapsed"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<!--QuickAccessToolBar style-->
	<Style x:Key="BlendQuickAccessToolBarStyle" TargetType="{x:Type local:QuickAccessToolBar}">
		<!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="GeometryBackground" Value="{StaticResource Blend.QuickAccessActiveBrush}"/>
		<Setter Property="GeometryStroke" Value="{StaticResource Blend.ActiveGeometryStroke}"/>
		<!--<Setter Property="Control.FontSize" Value="11"/>
		<Setter Property="Control.FontFamily" Value="Calibri"/>-->
		<Setter Property="Control.Foreground" Value="{StaticResource Blend.Foreground2}"/>
		<Setter Property="Height" Value="22"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="Template" Value="{StaticResource QuickAccessToolBarTemplate}"/>
		
		<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>

		<Style.Triggers>
			<DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}}}" Value="False">
				<Setter Property="GeometryBackground" Value="{StaticResource Blend.QuickAccessBrush}"/>
				<Setter Property="GeometryStroke" Value="{StaticResource Blend.GeometryStroke}"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}"
					 Value="True">
				<Setter Property="GeometryBackground" Value="Transparent"/>
				<!--<Setter Property="GeometryStroke" Value="#FF9BA4B1"/>-->
			</DataTrigger>
