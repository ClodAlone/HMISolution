					<Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="False"/>
				</MultiDataTrigger.Conditions>
				<Setter TargetName="PART_highlightBorder" Property="BorderBrush" Value="{StaticResource Blend.Ribbon.BorderBrush}"/>
				<Setter TargetName="PART_highlightBorder" Property="BorderThickness" Value="1,1,1,0"/>
				<Setter TargetName="PART_highlightBorder" Property="Height" Value="22.83"/>
				<Setter TargetName="PART_highlightBorder" Property="Margin" Value="-5.7,0,-5.7,0"/>
				<Setter  TargetName="PART_highlightBorder" Property="Panel.ZIndex" Value="100" />
				<Setter  TargetName="PART_highlightBorder" Property="BorderBrush" Value="{Binding Converter={StaticResource colorToBrushConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=ContextColor}" />
				<Setter  TargetName="PART_highlightBorder" Property="Background" Value="{Binding Converter={StaticResource colorToTransparentBrushConverter2}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=ContextColor}" />

				<Setter TargetName="PART_highlightContour" Property="Height" Value="21"/>
				<Setter TargetName="PART_highlightContour" Property="CornerRadius" Value="3,3,0,0"/>
				<Setter TargetName="PART_highlightContour" Property="BorderThickness" Value="0.7,0.7,0.7,0"/>
				<Setter TargetName="PART_highlightContour" Property="BorderBrush" Value="{StaticResource Blend.TabButtonCheckedBrush}"/>
				<Setter TargetName="PART_highlightContour" Property="Margin" Value="-4.7,0,-4.7,0"/>
				<Setter TargetName="PART_Caption" Property="Foreground" Value="White"/>

			</MultiDataTrigger>

		</ControlTemplate.Triggers>
	</ControlTemplate>

