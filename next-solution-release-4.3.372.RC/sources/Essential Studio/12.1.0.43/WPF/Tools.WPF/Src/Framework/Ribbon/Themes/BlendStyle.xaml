	<Style x:Key="GalleryRepeatButtonStyle" TargetType="Button">
		<Setter Property="ClickMode" Value="Press"/>
		<Setter Property="Width" Value="16"/>
		<Setter Property="Background" Value="{StaticResource Blend.GalleryRepeatButtonBackground}"/>
		<Setter Property="BorderBrush" Value="{StaticResource Blend.Ribbon.BorderBrush}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Background}"
				  BorderBrush="{TemplateBinding BorderBrush}"
				  Opacity="{TemplateBinding Opacity}"
				  BorderThickness="1">
						<Border Name="PART_InnerBorder"
					BorderBrush="{StaticResource Blend.CheckBoxBackground}"
					BorderThickness="1"
					Opacity="{TemplateBinding Opacity}">
							<ContentPresenter HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Content="{TemplateBinding Content}"/>
						</Border>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource Blend.HoverBorderBrush}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="BorderBrush" Value="{StaticResource Blend.HoverBorderBrush}" />
				<Setter Property="Background" Value="{StaticResource Blend.GalleryRepeatButton.IsMouseOver.BackgroundBrush}" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="BorderBrush" Value="{StaticResource Blend.GalleryRepeatButton.IsPressed.BorderBrush}" />
				<Setter Property="Background" Value="{StaticResource Blend.GalleryRepeatButton.IsPressed.BackgroundBrush}" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Opacity" Value="0.65" />
				<Setter Property="Background" Value="{StaticResource Blend.GalleryRepeatButton.IsEnabled.BackgroundBrush}" />
			</Trigger>
		</Style.Triggers>
	</Style>


	<!--InRibbon Gallery template-->
	<ControlTemplate x:Key="InRibbonGalleryTemplate" TargetType="{x:Type local:RibbonGallery}">
		<Border BorderThickness="1"
			CornerRadius="2"
			Background="{TemplateBinding Background}"
			BorderBrush="{StaticResource Blend.Ribbon.BorderBrush}"
			Height="{TemplateBinding Height}"
			MaxHeight="62">

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="16"/>
				</Grid.ColumnDefinitions>

				<Grid Grid.Column="1">
					<Grid.RowDefinitions>
						<RowDefinition/>
						<RowDefinition/>
						<RowDefinition/>
					</Grid.RowDefinitions>

					<Button Name="PART_ScrollUpButton"
						Grid.Row="0"
						Style="{StaticResource GalleryRepeatButtonStyle}">
						<Path Data="M3.5,0L0,4 7,4z" Fill="{StaticResource Blend.PathFill}"/>
					</Button>

					<Button Name="PART_ScrollDownButton"
						Grid.Row="1"
						Style="{StaticResource GalleryRepeatButtonStyle}">
						<Path Data="M0,0L3.5,4 7,0z" Fill="{StaticResource Blend.PathFill}" />
					</Button>

					<Border Grid.Row="2"
				  Name="PART_ToggleButton"
				  Width="16"
				  Height="20.5"
				  Background="{StaticResource Blend.GalleryRepeatButtonBackground}"
				  BorderBrush="{StaticResource Blend.Ribbon.BorderBrush}"                  
				  BorderThickness="1"
				  VerticalAlignment="Center" HorizontalAlignment="Center">
						<Border BorderBrush="{StaticResource Blend.CheckBoxBackground}" Padding="2.5,4,2.5,3"
					BorderThickness="1">
							<StackPanel>
								<Path Margin="0,0,0,2" Data="M0,0.5L7,0.5" Stroke="{StaticResource Blend.PathFill}" />
								<Path Data="M0,0L3.5,4 7,0z" Fill="{StaticResource Blend.PathFill}" />
							</StackPanel>
						</Border>
					</Border>
				</Grid>

				<local:InRibbonItemsPresenter Name="PART_ScrollPresenter" ClipToBounds="True"/>
				<!--<local:InRibbonScrollDecorator Name="PART_ScrollPresenter">
		  <ItemsControl Name="PART_MainItemsControl">
			<ItemsControl.ItemsPanel>
			  <ItemsPanelTemplate>
				<WrapPanel
				  Background="Transparent"
				  ClipToBounds="True"
				  ItemWidth="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemWidth}"
				  ItemHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
			  </ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
		  </ItemsControl>
		</local:InRibbonScrollDecorator>-->
				<!--SkinStorage.VisualStylesList="{local:RibbonSkinObject}"-->
				<Popup Name="PART_Popup"
			   Placement="Custom"
			   Focusable="False" 
			   AllowsTransparency="True"
			   StaysOpen="False"
			   PopupAnimation="Fade"
			   IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonGallery}}}">

					<mwt:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="True">
						<Border Background="{StaticResource Blend.QuickDropDownBackground}"
					BorderThickness="1"
					CornerRadius="2"
					BorderBrush="{StaticResource Blend.QuickDropDownBorderBrush}">

							<DockPanel SnapsToDevicePixels="True">

								<Border Name="PART_ThumbBorder"
						DockPanel.Dock="Bottom"
						BorderThickness="0,1,0,0"
						BorderBrush="#DDE7EE"
						Background="{StaticResource Blend.GalleryBottomBackground}">
                                    <local:PopupResizeThumb IsTabStop="False" Name="PART_ResizeThumb"/>
								</Border>

								<local:GalleryFilterSelector DockPanel.Dock="Top"/>

								<Grid DockPanel.Dock="Top">
									<Grid.RowDefinitions>
										<RowDefinition MinHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>
									<ScrollViewer Name="PART_ScrollViewer" Grid.Row="0">
										<StackPanel>
											<ItemsControl Name="PART_PopupItemsControl">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate>
														<WrapPanel
							  IsItemsHost="True"
							  ItemWidth="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemWidth}"
							  ItemHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
													</ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
											</ItemsControl>
										</StackPanel>
									</ScrollViewer>

									<local:RibbonMenuGroup Visibility="{TemplateBinding MenuItems, Converter={StaticResource CountToVisibilityConverter}}"
					Grid.Row="1" IconBarEnabled="{TemplateBinding MenuIconBarEnabled}"
					ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=MenuItems}"/>
								</Grid>
							</DockPanel>
						</Border>
					</mwt:SystemDropShadowChrome>
				</Popup>
			</Grid>
		</Border>

		<ControlTemplate.Triggers>
			<Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
				<Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
			</Trigger>

			<Trigger SourceName="PART_ToggleButton"  Property="IsMouseOver" Value="True">
				<Setter TargetName="PART_ToggleButton"  Property="BorderBrush" Value="{StaticResource Blend.HoverBorderBrush}" />
				<Setter TargetName="PART_ToggleButton"
				Property="Background" Value="{StaticResource Blend.GalleryRepeatButton.IsMouseOver.BackgroundBrush}" />
			</Trigger>
			<!--<Trigger Property="IsPressed" Value="True">
		  <Setter Property="BorderBrush" Value="#7B6645" />
		  <Setter Property="Background" Value="{StaticResource GalleryRepeatButton.IsPressed.BackgroundBrush}" />
		</Trigger>-->
			<!--<Trigger  Property="IsEnabled" Value="False">
		  <Setter Property="Opacity" Value="0.65" />
		  <Setter Property="Background" Value="{StaticResource GalleryRepeatButton.IsEnabled.BackgroundBrush}" />
		</Trigger>-->



			<Trigger Property="HasGroups" Value="True">
				<Setter TargetName="PART_PopupItemsControl" Property="ItemsPanel">
					<Setter.Value>
						<ItemsPanelTemplate>
							<local:GalleryGroupPanel/>
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
			</Trigger>


			<Trigger Property="ResizeDirection" Value="HorizontalAndVertical">
				<Setter TargetName="PART_Popup" Property="Width"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=HorizontalOffset}"/>
				<Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=VerticalOffset}"/>				
			</Trigger>

			<Trigger Property="ResizeDirection" Value="VerticalOnly">
				<Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay,  Path=VerticalOffset}"/>
				<Setter TargetName="PART_ResizeThumb" Property="Template" Value="{StaticResource VerticalOnlyResizeThumb}" />
				<Setter TargetName="PART_ResizeThumb" Property="HorizontalAlignment" Value="Center" />
			</Trigger>

			<Trigger Property="PopupPosition" Value="Above">
				<Setter TargetName="PART_ThumbBorder" Property="DockPanel.Dock" Value="Top"/>
				<Setter TargetName="PART_ScrollViewer"   Property="DockPanel.Dock" Value="Bottom"/>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNESW" TargetName="PART_ResizeThumb" />
			</Trigger>
			
			<Trigger Property="ResizeDirection" Value="NoResize">
				<Setter Property="Visibility" Value="Collapsed" TargetName="PART_ResizeThumb"/>
			</Trigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=PopupPosition}" Value="Above"/>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self},Path=FlowDirection}" Value="RightToLeft"/>
				</MultiDataTrigger.Conditions>
				<Setter Property="RenderTransform" TargetName="PART_ResizeThumb">
					<Setter.Value>
						<RotateTransform Angle="270" CenterX="5" CenterY="5"/>
					</Setter.Value>
				</Setter>
				<Setter Property="Cursor" Value="SizeNWSE" TargetName="PART_ResizeThumb" />
			</MultiDataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>


	<!--GALLERY DROPDOWN TEMPLATES-->

	<!--Large template-->
	<ControlTemplate x:Key="LargeGalleryTemplate" TargetType="{x:Type local:RibbonGallery}">

		<Border Name="PART_OuterBorder" BorderThickness="1" CornerRadius="1" BorderBrush="Transparent">
			<StackPanel>
				<Border Name="PART_ToggleButton"
			  BorderBrush="{TemplateBinding BorderBrush}"
						  Background="{TemplateBinding Background}"
			  BorderThickness="1"
			  Height="{TemplateBinding Height}"
			  CornerRadius="2">
					<StackPanel>
						<Image  Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
				 HorizontalAlignment="Center"
				 VerticalAlignment="Top"
				 Width="32" Height="32"
