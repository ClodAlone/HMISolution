	<ControlTemplate x:Key="RibbonCheckBoxTemplate" TargetType="{x:Type local:RibbonCheckBox}">
		<BulletDecorator SnapsToDevicePixels="true" Background="Transparent">
			<BulletDecorator.Bullet>
				<Border x:Name="border1" Width="13" Height="13" BorderBrush="{StaticResource Blend.CheckBoxBorderBrush}" BorderThickness="1" Background="{StaticResource Blend.CheckBoxBackground}">
					<Border x:Name="border2" BorderBrush="{StaticResource Blend.CheckBoxInnerBorderBrush}" BorderThickness="1">
						<Border x:Name="border3" BorderThickness="1" Background="{StaticResource Blend.CheckRadioInnerFillBrush}" BorderBrush="{StaticResource Blend.CheckRadioInnerBorderBrush}">
							<Canvas SnapsToDevicePixels="True">
								<Path x:Name="path">
									<Path.Data>
										<PathGeometry>
											<PathFigure StartPoint="2,4">
												<LineSegment Point="3,6"/>
												<LineSegment Point="5,-1"/>
												<LineSegment Point="7,-1"/>
												<LineSegment Point="4,8"/>
												<LineSegment Point="2,8"/>
												<LineSegment Point="0,5"/>
											</PathFigure>
										</PathGeometry>
									</Path.Data>
								</Path>
							</Canvas>
						</Border>
					</Border>
				</Border>
			</BulletDecorator.Bullet>
			<ContentPresenter Name="content" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="6,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
		</BulletDecorator>
		<ControlTemplate.Triggers>
			<Trigger Property="HasContent" Value="true">
				<Setter Property="FocusVisualStyle" Value="{StaticResource CheckRadioFocusVisual}"/>
				<Setter Property="Padding" Value="2,0,0,0"/>
			</Trigger>
			<Trigger Property="IsChecked" Value="True">
				<Setter Property="Fill" TargetName="path" Value="{StaticResource Blend.CheckBoxBorderBrushHover}"/>
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="IsEnabled" Value="True"/>
					<Condition Property="IsMouseOver" Value="True"/>
				</MultiTrigger.Conditions>
				<Setter TargetName="border1" Property="BorderBrush" Value="{StaticResource Blend.CheckBoxBorderBrushHover}" />
				<Setter TargetName="border2" Property="BorderBrush" Value="{StaticResource Blend.CheckBoxBackgroundHover}" />
				<Setter TargetName="border3" Property="BorderBrush" Value="{StaticResource Blend.CheckRadioOverInnerBorderBrush}" />
				<Setter TargetName="border3" Property="Background" Value="{StaticResource Blend.CheckRadioOverInnerFillBrush}" />
				<Setter Property="TextBlock.Foreground" TargetName="content" Value="{StaticResource Blend.Foreground3}"/>
			</MultiTrigger>
			<Trigger Property="IsEnabled" Value="false">
				<Setter Property="TextBlock.Foreground" TargetName="content" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

