	<ControlTemplate x:Key="CheckableItemTemplate" TargetType="{x:Type local:RibbonMenuItem}">
		<Border BorderThickness="{TemplateBinding BorderThickness}"
			BorderBrush="{TemplateBinding BorderBrush}"
			Background="{TemplateBinding Panel.Background}"
			Width="{TemplateBinding Width}"
			Height="{TemplateBinding Height}"
			MinWidth="{TemplateBinding MinWidth}"
			MaxWidth="{TemplateBinding MaxWidth}"
			MinHeight="{TemplateBinding MinHeight}"
			MaxHeight="{TemplateBinding MaxHeight}"
			Margin="{TemplateBinding Margin}"
			Padding="{TemplateBinding Padding}"
			SnapsToDevicePixels="True"
				Name="Bd"  >
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="21"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<Border Name="PART_CheckBorder" Grid.Column="0" Visibility="Collapsed" Margin="-5,0,0,0"
					  Width="21" Height="21" BorderThickness="1" BorderBrush="{StaticResource Blend.QuickCheckedButtonBorderBrush}"  
					  Background="{StaticResource Blend.QuickCheckedButtonBackgroundBrush}" CornerRadius="{StaticResource Blend.QuickDropDownCornerRadius}"
					  >
					<Path Stroke="{StaticResource Blend.Foreground2}" StrokeThickness="1.4">
						<Path.Data>
							<GeometryGroup>
								<LineGeometry StartPoint="6 9" EndPoint="9 16"/>
								<LineGeometry StartPoint="9 16" EndPoint="13 3"/>
							</GeometryGroup>
						</Path.Data>
					</Path>
				</Border>

				<TextBlock Grid.Column="1" Margin="7,2,0,2" Text="{TemplateBinding MenuItem.Header}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
			</Grid>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="MenuItem.IsChecked" Value="True">
				<Setter TargetName="PART_CheckBorder" Property="Visibility" Value="Visible"/>
			</Trigger>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Blend.HoverBorderBrush}"/>
				<Setter Property="Background" TargetName="Bd" Value="{StaticResource Luna.MouseOverBrush.Blend}"/>
			</Trigger>
			<!--<Trigger Property="IsPressed" Value="True">
				<Setter TargetName="Bd" Property="BorderBrush" Value="{shared:SkinObject HoverBorderBrush}"/>
				<Setter  TargetName="Bd" Property="Background" Value="{StaticResource MouseOverBrush1}"/>
			</Trigger>-->
			<Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
				<Setter Property="TextElement.FontSize" Value="18"/>
				<Setter Property="Padding" Value="16,9,16,9"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>


	<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

	<!--RibbonMenuItem style-->
	<Style TargetType="{x:Type local:RibbonMenuItem}" x:Key="BlendRibbonMenuItemStyle">
		<Setter Property="Padding" Value="1,0,3,0"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}"/>
		<Setter Property="BorderThickness" Value="{StaticResource Blend.MenuItemBorderThickness}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:RibbonMenuItem}">
					<Border CornerRadius="2" Name="Bd">
						<Grid Grid.ColumnSpan="3">
							<Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0" Width="25" RadiusY="0" HorizontalAlignment="Left" Fill="{StaticResource Blend.QATContextMenuLeftBarBackground}" RadiusX="0" />
							<Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="25,0,0,0" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Blend.QATContextMenuBorderBrush}" />
							<Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="26,0,0,0" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Blend.QATContextMenuBorderBrush}" />
							<Border BorderThickness="{TemplateBinding BorderThickness}"
									Background="{TemplateBinding Panel.Background}"
									Width="{TemplateBinding Width}"   
									Height="{TemplateBinding Height}"
									MinWidth="{TemplateBinding MinWidth}"
									MaxWidth="{TemplateBinding MaxWidth}"
									MinHeight="{TemplateBinding MinHeight}"
									MaxHeight="{TemplateBinding MaxHeight}"
									Margin="{TemplateBinding Margin}"
									Padding="{TemplateBinding Padding}"
									CornerRadius="{StaticResource Blend.QuickDropDownCornerRadius}"
									Name="Border"
									SnapsToDevicePixels="True">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition />
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="17"/>
										
									</Grid.ColumnDefinitions>

									<Border Name="IconBorder" Grid.Column="0" BorderThickness="1" CornerRadius="{StaticResource Blend.QuickDropDownCornerRadius}">
										<ContentPresenter Margin="1" Content="{TemplateBinding Icon}" Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}" RenderOptions.BitmapScalingMode="NearestNeighbor"
													Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
									</Border>
									<Border Name="PART_CheckBorder" Margin="1"  Background="{StaticResource ChkBoxBackgroundBrushKey}" BorderBrush="{StaticResource ChkBoxBorderBrushKey}"  Grid.Column="0" BorderThickness="1" CornerRadius="3" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}" Width="16" Height="16">
										<Path Data="M0,5.1L1.7,5.2 3.4,7.1 8,0.4 9.2,0 3.3,10.8z" Fill="{StaticResource ChkBoxPathFillKey}" x:Name="Glyph" Width="9" Height="11" FlowDirection="LeftToRight"/>
									</Border>
									<ContentPresenter ContentSource="Header" Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
										<ContentPresenter.Style>
											<Style>
												<Style.Triggers>
													<Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
														<Setter Property="TextElement.FontSize" Value="18"/>
													</Trigger>
												</Style.Triggers>
											</Style>
										</ContentPresenter.Style>
									</ContentPresenter>
									<ContentPresenter Content="{TemplateBinding InputGestureText}" VerticalAlignment="Center" Grid.Column="2"></ContentPresenter>
									<Path Width="17" Visibility="{TemplateBinding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}"
										  Grid.Column="3" Data="M0,0L4,3.5 0,7z" Fill="{TemplateBinding Foreground}" Margin="7,0,0,0" VerticalAlignment="Center" />
									<Popup Name="PART_Popup" 
										   StaysOpen="False" 
										   PopupAnimation="Fade" 
										   MinWidth="10" 
										   MinHeight="10" 
										   HorizontalOffset="1" 
										   VerticalOffset="0" 
										   AllowsTransparency="true" 
										   Placement="Right" 
										   Focusable="false" 
										   IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
										<Microsoft_Windows_Themes:SystemDropShadowChrome Name="PART_Shadow" SnapsToDevicePixels="true">
											<Border BorderBrush="{StaticResource Blend.QuickDropDownBorderBrush}" CornerRadius="{StaticResource Blend.AppMenuCornerRadius}" BorderThickness="1" Background="{StaticResource Blend.QuickDropDownBackground}">
												<Grid>
													<Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0" Width="25" RadiusY="2" HorizontalAlignment="Left" Fill="{StaticResource Blend.QATContextMenuLeftBarBackground}" RadiusX="2" />
													<Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="25,0,0,0" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Blend.QATContextMenuBorderBrush}" />
													<Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="26,0,0,0" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Blend.QATContextMenuBorderBrush}" />
													<ScrollViewer Margin="0,0,1,0" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}" CanContentScroll="True" Grid.ColumnSpan="2">
														<ItemsPresenter Name="Presenter" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Grid.IsSharedSizeScope="true" />
													</ScrollViewer>
												</Grid>
											</Border>
										</Microsoft_Windows_Themes:SystemDropShadowChrome>
									</Popup>
								</Grid>
							</Border>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
							<Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
						</Trigger>
						<Trigger Property="MenuItem.IsChecked" Value="True">
							<Setter TargetName="IconBorder" Property="Visibility" Value="Collapsed"/>
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource Blend.HoverBorderBrush}"/>
							<Setter Property="Background" TargetName="Border" Value="{StaticResource Luna.MouseOverBrush.Blend}"/>
						</Trigger>
						<Trigger Property="IsFocused" Value="True">
							<Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource Blend.HoverBorderBrush}"/>
							<Setter Property="Background" TargetName="Border" Value="{StaticResource Luna.MouseOverBrush.Blend}"/>
						</Trigger>

						<Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
							<Setter Property="TextElement.FontSize" Value="18"/>
							<Setter Property="Padding" Value="16,9,16,9"/>
						</Trigger>

					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<!--<Setter Property="BorderBrush" Value="{StaticResource Blend.HoverBorderBrush}"/>
				<Setter Property="Background" Value="{shared:SkinObject MouseOverBrush1}"/>-->
				<Setter Property="Foreground" Value="{StaticResource Blend.Foreground3}"/>
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
			</Trigger>
			<!--<Trigger Property="IsPressed" Value="True">
		<Setter Property="BorderBrush" Value="#CAB583"/>
		<Setter Property="Background" Value="{StaticResource Luna.PressedBrush.Default}"/>
	  </Trigger>-->
		</Style.Triggers>
	</Style>
	
	<Style BasedOn="{StaticResource BlendRibbonMenuItemStyle}" TargetType="{x:Type local:RibbonMenuItem}"/>
	
	<!--{Binding RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}, Path=QuickAccessToolBar.HasGeometry, Converter={StaticResource booleanToVisibilty}}-->
	<ItemsControl x:Key="RibbonContextMenuItems">
		<local:RibbonMenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path= RemoveFromQAT}" Visibility="Collapsed" Command="local:RibbonCommands.RemoveItemFromQAT" Tag="Remove" CommandTarget="{Binding Path=PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonContextMenu}}}" Style="{StaticResource {x:Type local:RibbonMenuItem}}"/>
		<local:RibbonMenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path= AddToQAT}" Visibility="Collapsed" Tag="Item_One" Command="local:RibbonCommands.AddItemToQAT" CommandTarget="{Binding Path=PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonContextMenu}}}" Style="{StaticResource {x:Type local:RibbonMenuItem}}"/>
		<Separator Style="{StaticResource SeparatorStyle}" Tag="Item_Two"></Separator>
		<local:RibbonMenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=CustomizeQATContextMenu}" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=EnableMoreCommands, Converter={StaticResource BooleanToVisibilityConverter}}"  Tag="Item_Three" Command="local:RibbonCommands.QATMoreCommands" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}" Style="{StaticResource {x:Type local:RibbonMenuItem}}"/>
		<local:RibbonMenuItem Visibility="Collapsed"  Tag="Item_Four" Header="{Binding Source={StaticResource ResourceWrapperKey}, Path= QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove"  CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}" Style="{StaticResource {x:Type local:RibbonMenuItem}}"/>
		<local:RibbonMenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}" Tag="Item_Five" Command="local:RibbonCommands.PlaceQATBelow"  CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}" Style="{StaticResource {x:Type local:RibbonMenuItem}}"/>
		<Separator Style="{StaticResource SeparatorStyle}" Tag="Item_Six"></Separator>
		<local:RibbonMenuItem Margin="0,0,0,0" Tag="Item_Seven" Template="{StaticResource CheckableItemTemplate}"  Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=MinimizeRibbon}" IsCheckable="True" Command="local:RibbonCommands.MinimizeRibbon"  CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}" Style="{StaticResource {x:Type local:RibbonMenuItem}}">
			<local:RibbonMenuItem.Icon>
				<Path Stroke="Black" StrokeThickness="1.4">
					<Path.Data>
						<GeometryGroup>
							<LineGeometry StartPoint="6 9" EndPoint="9 16"/>
							<LineGeometry StartPoint="9 16" EndPoint="13 3"/>
						</GeometryGroup>
					</Path.Data>
				</Path>
				<!--<Image Source="pack://application:,,,/RibbonSample;component/SampleImages/superman.ico"></Image>-->
			</local:RibbonMenuItem.Icon>
		</local:RibbonMenuItem>
	</ItemsControl>
	

	<!--<ContextMenu x:Key="RibbonContextMenu"></ContextMenu>-->
	<Style x:Key="BlendRibbonContextMenuStyle" TargetType="{x:Type local:RibbonContextMenu}">
		<Setter Property="Panel.Background" Value="{StaticResource Blend.QuickDropDownBackground}"/>
		<Setter Property="TextElement.FontFamily" Value="Tahoma"/>
		<Setter Property="TextElement.FontSize" Value="11"/>
		<Setter Property="TextElement.FontStyle" Value="Normal"/>
		<Setter Property="TextElement.FontWeight" Value="Normal"/>
		<Setter Property="StaysOpen"  Value="False"/>
		<Setter Property="MenuItem.Foreground" Value="{StaticResource Blend.Foreground2}"/>
		<Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}"/>
		<Setter Property="Control.VerticalContentAlignment" Value="Center"/>
		<Setter Property="Border.BorderThickness" Value="1,1,1,1"/>
		<Setter Property="Border.BorderBrush" Value="{StaticResource Blend.QuickDropDownBorderBrush}"/>
		<Setter Property="Control.Padding" Value="1,1,1,1"/>
		<Setter Property="Grid.IsSharedSizeScope" Value="True"/>
		<Setter Property="ContextMenuService.HasDropShadow" Value="True"/>
		<Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
		<Setter Property="ItemsSource" Value="{Binding Source={StaticResource RibbonContextMenuItems}, Path=Items}" />
		<!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{StaticResource SkinDictionary}"/>-->
		<Setter Property="Control.Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:RibbonContextMenu}">
					<Microsoft_Windows_Themes:SystemDropShadowChrome Name="Shdw" SnapsToDevicePixels="True" Color="#00FFFFFF">
						<Border BorderBrush="{TemplateBinding Border.BorderBrush}" CornerRadius="{StaticResource Blend.QuickDropDownCornerRadius}" BorderThickness="{TemplateBinding Border.BorderThickness}" Background="{TemplateBinding Panel.Background}">
							<Grid>
								<Rectangle Margin="1,1,1,1" Width="25" RadiusY="2" HorizontalAlignment="Left" Fill="{StaticResource Blend.QATContextMenuLeftBarBackground}" RadiusX="2" />
								<Rectangle Margin="26,1,0,1" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Blend.QATContextMenuBorderBrush}" />
								<Rectangle Margin="27,1,0,1" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Blend.QuickDropDownBackground}" />
								<ScrollViewer Margin="1,0,1,0" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}" CanContentScroll="True" Grid.ColumnSpan="2">
									<ItemsPresenter Margin="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" KeyboardNavigation.DirectionalNavigation="Cycle" />
								</ScrollViewer>
							</Grid>
						</Border>
					</Microsoft_Windows_Themes:SystemDropShadowChrome>
					<ControlTemplate.Triggers>
						<Trigger Property="ContextMenuService.HasDropShadow" Value="True">
							<Setter Property="FrameworkElement.Margin" TargetName="Shdw" Value="0,0,5,5"/>
							<Setter Property="Microsoft_Windows_Themes:SystemDropShadowChrome.Color" TargetName="Shdw" Value="#71000000"/>
						</Trigger>
						<!--<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}, Path=QuickAccessToolBar.HasGeometry}" Value="False">
			  <Setter TargetName="PART_AboveButton" Property="Visibility" Value="Collapsed"></Setter>
			</DataTrigger>-->
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<!--<Setter Property="ItemContainerStyle">
			<Setter.Value>
				<Style TargetType="{x:Type local:RibbonMenuItem}">
					<Setter Property="Background" Value="{shared:SkinObject QuickCheckedButtonBackgroundBrush}" />
				</Style>
			</Setter.Value>
		</Setter>-->
		<Style.Triggers>

		</Style.Triggers>
	</Style>

