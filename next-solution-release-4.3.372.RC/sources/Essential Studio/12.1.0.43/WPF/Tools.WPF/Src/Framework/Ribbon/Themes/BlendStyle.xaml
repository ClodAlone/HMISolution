	<!--RibbonBar style-->
	<Style x:Key="BlendRibbonBarStyle" TargetType="{x:Type local:RibbonBar}">
		<!--<Setter Property="shared:SkinStorage.VisualStylesList" Value="{local:RibbonSkinObject}"/>-->
		<Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
		  <!-- <Setter Property="CollapseImage" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=RibbonBarCollapseImage}"/> -->
		<Setter Property="Template" Value="{StaticResource RibbonBarPresenterTemplate}"/>
		<Setter Property="BorderBrush" Value="{StaticResource Blend.Ribbon.BorderBrush}"/>
		<!--<Setter Property="FontSize" Value="11.5"/>
					<Setter Property="FontFamily" Value="Segoe UI"/>-->
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Margin" Value="1,2,1,2"/>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<local:GroupPanel ItemMargin="2,4,1,4" PanelState="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonBar}}, Path=PanelState, Mode=OneWay}"/>
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="PanelState" Value="ExtraSmall">
				<Setter Property="Template" Value="{StaticResource RibbonBarSmallDropDownTemplate}"/>
				<Setter Property="Margin" Value="0"/>
			</Trigger>
			<Trigger Property="PanelState" Value="Collapsed">
				<Setter Property="Template" Value="{StaticResource RibbonBarDropDownTemplate}"/>
			</Trigger>
			<Trigger Property="IsLargeButtonPanel" Value="true">
				<Setter Property="ItemsPanel">
					<Setter.Value>
						<ItemsPanelTemplate>
							<local:LargeButtonPanel/>
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style BasedOn="{StaticResource BlendRibbonBarStyle}" TargetType="{x:Type local:RibbonBar}"/>
	
	<!--Ribbon Window -->
	<!--RibbonWindow template-->
	<ControlTemplate x:Key="RibbonWindowTemplate" TargetType="{x:Type local:RibbonWindow}">
		<AdornerDecorator x:Name="PART_Adorner">
			<Grid>
				<Border Name="PART_MainBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2,2,0,0" Padding="{TemplateBinding Padding}">
					<DockPanel HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Stretch">
						<local:TitleBar x:Name="PART_TitleBar" Title="{TemplateBinding Title}" DockPanel.Dock="Top" Style="{StaticResource TitleBarStyleKey}"/>

						<Grid >
							<DockPanel>
								<ContentPresenter DockPanel.Dock="Bottom" Content="{TemplateBinding StatusBar}"/>

								<ContentPresenter DockPanel.Dock="Bottom" Content="{TemplateBinding Content}"/>
							</DockPanel>

							<Label x:Name="PART_ResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" IsTabStop="False" Cursor="SizeNWSE">
								<Grid SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
									<Path Fill="{StaticResource Blend.ResizeGripperForegroundLight}" Data="M 9,1 L 11,1 L 11,3 L 9,3 Z M 5,5 L 7,5 L 7,7 L 5,7 Z M 9,5 L 11,5 L 11,7 L 9,7 Z M 1,9 L 3,9 L 3,11 L 1,11 Z M 5,9 L 7,9 L 7,11 L 5,11 Z M 9,9 L 11,9 L 11,11 L 9,11 Z" />

									<Path Fill="{StaticResource Blend.ResizeGripperForegroundDark}" Data="M 8,0 L 10,0 L 10,2 L 8,2 Z M 4,4 L 6,4 L 6,6 L 4,6 Z M 8,4 L 10,4 L 10,6 L 8,6 Z M 0,8 L 2,8 L 2,10 L 0,10 Z M 4,8 L 6,8 L 6,10 L 4,10 Z M 8,8 L 10,8 L 10,10 L 8,10 Z" />
								</Grid>
							</Label>
						</Grid>
					</DockPanel>
				</Border>
			</Grid>
		</AdornerDecorator>
		<ControlTemplate.Triggers>
			<Trigger Property="IsActive" Value="True">
				<Setter TargetName="PART_TitleBar" Property="Background" Value="{StaticResource Blend.TitleActiveBackgroundBrush}"/>
				<Setter TargetName="PART_TitleBar" Property="BorderBrush" Value="{StaticResource Blend.TitleActiveBorderBrush}"/>
				<Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}}"/>
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="ResizeMode" Value="CanResizeWithGrip"/>
					<Condition Property="WindowState" Value="Normal"/>
				</MultiTrigger.Conditions>
				<Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible"/>
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="MaximizedMode" Value="KioskStyle" />
					<Condition Property="WindowState" Value="Maximized" />
					<Condition Property="WindowStyle" Value="None" />
				</MultiTrigger.Conditions>
				<Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
				<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
			</MultiTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="IsGlassActive" Value="False"/>
					<Condition Property="WindowState" Value="Maximized" />
				</MultiTrigger.Conditions>
				  <Setter Property="Margin" TargetName="PART_MainBorder">
										<Setter.Value>
											<Thickness Top="4" 
											Bottom="{x:Static  SystemParameters.ResizeFrameHorizontalBorderHeight}" 
											Left="{x:Static  SystemParameters.ResizeFrameVerticalBorderWidth}" 
											Right="{x:Static  SystemParameters.ResizeFrameVerticalBorderWidth}"/>
										</Setter.Value>
				   </Setter>
			</MultiTrigger>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="Margin" Value="7,4,7,8" TargetName="PART_MainBorder"/>
            </Trigger>
        </ControlTemplate.Triggers>
	</ControlTemplate>


	<!--RibbonWindow Glass template-->
	<ControlTemplate x:Key="RibbonWindowGlassTemplate"  TargetType="{x:Type local:RibbonWindow}">
		<AdornerDecorator x:Name="PART_Adorner">
			<Grid >                
				<DockPanel HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Stretch">
					<local:TitleBar x:Name="PART_TitleBar" Title="{TemplateBinding Title}" DockPanel.Dock="Top" Style="{StaticResource TitleBarStyleKey}"/>

					<Grid>
						<DockPanel>
							<ContentPresenter DockPanel.Dock="Bottom" Content="{TemplateBinding StatusBar}"/>

							<Border Name="PART_ContentBorder" Background="{TemplateBinding Background}" DockPanel.Dock="Bottom" Margin="0,-1,0,0" Padding="0,1,0,0" BorderThickness="2,0,2,0" BorderBrush="{StaticResource Blend.WindowBackground}">
								<ContentPresenter Content="{TemplateBinding Content}"/>
							</Border>
						</DockPanel>

						<Label x:Name="PART_ResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" IsTabStop="False" Cursor="SizeNWSE">
							<Grid SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
								<Path Fill="{StaticResource Blend.ResizeGripperForegroundLight}" Data="M 9,1 L 11,1 L 11,3 L 9,3 Z M 5,5 L 7,5 L 7,7 L 5,7 Z M 9,5 L 11,5 L 11,7 L 9,7 Z M 1,9 L 3,9 L 3,11 L 1,11 Z M 5,9 L 7,9 L 7,11 L 5,11 Z M 9,9 L 11,9 L 11,11 L 9,11 Z"/>

								<Path Fill="{StaticResource Blend.ResizeGripperForegroundDark}" Data="M 8,0 L 10,0 L 10,2 L 8,2 Z M 4,4 L 6,4 L 6,6 L 4,6 Z M 8,4 L 10,4 L 10,6 L 8,6 Z M 0,8 L 2,8 L 2,10 L 0,10 Z M 4,8 L 6,8 L 6,10 L 4,10 Z M 8,8 L 10,8 L 10,10 L 8,10 Z"/>
							</Grid>
						</Label>
					</Grid>
				</DockPanel>
			</Grid>
		</AdornerDecorator>
		<ControlTemplate.Triggers>
			<Trigger Property="IsGlassActive" Value="True">
				<Setter TargetName="PART_TitleBar" Property="Background" Value="Transparent"/>
				<Setter TargetName="PART_TitleBar" Property="BorderThickness" Value="0"/>
			</Trigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="ResizeMode" Value="CanResizeWithGrip"/>
					<Condition Property="WindowState" Value="Normal"/>
				</MultiTrigger.Conditions>
				<Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible"/>
			</MultiTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsGlassActive}" Value="True" />
					<Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=WindowState}" Value="Maximized" />
				</MultiDataTrigger.Conditions>
				<!--<Setter TargetName="PART_RibbonAdorner" Property="Margin" Value="0,-22,0,0" />-->
				<Setter TargetName="PART_TitleBar" Property="Margin" Value="0,6,0,-8"/>
				<Setter TargetName="PART_ContentBorder" Property="Margin" Value="0,8,0,0"/>
			</MultiDataTrigger>
			<MultiTrigger>
				<MultiTrigger.Conditions>
					<Condition Property="WindowState" Value="Maximized" />
					<Condition Property="WindowStyle" Value="None" />
				</MultiTrigger.Conditions>
				<Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
				<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
			</MultiTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	
	<Style x:Key="BlendRibbonStatusBarStyle" TargetType="{x:Type local:RibbonStatusBar}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:RibbonStatusBar}">
					<Border Height="{TemplateBinding Height}" ClipToBounds="True" CornerRadius="0,0,2,2" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
						<Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Blend.BorderBrush}">
							<ItemsPresenter x:Name="PART_Presenter"/>
						</Border>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}"/>
		<Setter Property="BorderBrush" Value="{StaticResource Blend.BorderBrush}"/>
		<Setter Property="Background" Value="{StaticResource Blend.StatusBarBackgound}"/>
		<Setter Property="BorderThickness" Value="0,1,0,0"/>
		<Setter Property="Height" Value="22"/>
	</Style>
	
	<Style BasedOn="{StaticResource BlendRibbonStatusBarStyle}" TargetType="{x:Type local:RibbonStatusBar}"/>
	
	<!--RibbonWindow style-->
	<Style x:Key="BlendRibbonWindowStyle" TargetType="{x:Type local:RibbonWindow}">
		<Setter Property="RibbonStatusBarStyle" Value="{StaticResource {x:Type local:RibbonStatusBar}}"/>
