                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <Border Name="PART_CheckBorder" Grid.Column="0" Visibility="Collapsed" 
                      Width="21" Height="21" BorderThickness="1">
                                                                                        <Path Stroke="{StaticResource TextBrushKey.ShinyBlue}" StrokeThickness="1.4">
