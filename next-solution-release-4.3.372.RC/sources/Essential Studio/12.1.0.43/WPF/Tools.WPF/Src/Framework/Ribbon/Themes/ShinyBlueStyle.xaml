                <Setter TargetName="center_Path" Property="Background" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
                <Setter TargetName="center_Path" Property="BorderBrush" Value="{StaticResource RibbonBorderBrushKey.ShinyBlue}"/>
                <Setter TargetName="PART_rightPath" Property="Fill" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
                <Setter TargetName="right_Path" Property="Fill" Value="{StaticResource RibbonBorderBrushKey.ShinyBlue}"/>
                <Setter TargetName="PART_leftPath" Property="Fill" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
                <Setter TargetName="left_Path" Property="Fill" Value="{StaticResource RibbonBorderBrushKey.ShinyBlue}"/>
            </MultiDataTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsChecked" Value="True"/>
