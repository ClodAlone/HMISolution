    <Style x:Key="GalleryRepeatButtonStyle.ShinyRed" TargetType="Button">
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Background" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="HoverOn">
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Hover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                        <Storyboard x:Key="HoverOff">
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="Hover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                        <Storyboard x:Key="PressedOn">
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="RepeatBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0.6"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                        <Storyboard x:Key="PressedOff">
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="RepeatBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>

                    </ControlTemplate.Resources>
                    <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  Opacity="{TemplateBinding Opacity}"
                  BorderThickness="1" Name="RepeatBorder">
                        <Grid>
                            <Border x:Name="Hover" BorderThickness="{TemplateBinding BorderThickness}" Background="{StaticResource HighlightBrushKey.ShinyBlue}"  CornerRadius="0" Opacity="0"/>

                            <Border Name="PART_InnerBorder"
                    BorderBrush="Transparent" 
                    BorderThickness="1"
                    Opacity="{TemplateBinding Opacity}">
                                <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource PressedOn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource PressedOff}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--InRibbon Gallery template-->
   

    <ControlTemplate x:Key="InRibbonGalleryTemplate.ShinyRed" TargetType="{x:Type local:RibbonGallery}">
        <Border BorderThickness="1"
            CornerRadius="2"
            Background="{TemplateBinding Background}"
            BorderBrush="{StaticResource NormalBorderBrushKey.ShinyBlue}"
            Height="{TemplateBinding Height}"
            MaxHeight="62">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Button Name="PART_ScrollUpButton"
                        Grid.Row="0"
                        Style="{StaticResource GalleryRepeatButtonStyle.ShinyRed}">
                        <Path Data="M3.5,0L0,4 7,4z" Fill="{StaticResource GlyphBrushKey.ShinyBlue}"/>
                    </Button>

                    <Button Name="PART_ScrollDownButton"
                        Grid.Row="1"
                        Style="{StaticResource GalleryRepeatButtonStyle.ShinyRed}">
                        <Path Data="M0,0L3.5,4 7,0z" Fill="{StaticResource GlyphBrushKey.ShinyBlue}" />
                    </Button>

                    <Border Grid.Row="2"
                  Name="PART_ToggleButton"
                  Width="16"
                  Height="20.5"
                  Background="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"
                  BorderBrush="{StaticResource NormalBorderBrushKey.ShinyBlue}"                  
                  BorderThickness="1"
                  VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border BorderBrush="{StaticResource NormalBackgroundBrushKey.ShinyBlue}" Padding="2.5,4,2.5,3"
                    BorderThickness="1">
                            <StackPanel>
                                <Path Margin="0,0,0,2" Data="M0,0.5L7,0.5" Stroke="{StaticResource GlyphBrushKey.ShinyBlue}" />
                                <Path Data="M0,0L3.5,4 7,0z" Fill="{StaticResource GlyphBrushKey.ShinyBlue}" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <local:InRibbonItemsPresenter Name="PART_ScrollPresenter" ClipToBounds="True"/>
                <!--<local:InRibbonScrollDecorator Name="PART_ScrollPresenter">
          <ItemsControl Name="PART_MainItemsControl">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel
                  Background="Transparent"
                  ClipToBounds="True"
                  ItemWidth="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemWidth}"
                  ItemHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </local:InRibbonScrollDecorator>-->

                <Popup Name="PART_Popup"
               Placement="Custom"
               Focusable="False"

               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonGallery}}}">

                    <mwt:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="True">
                        <Border Background="{StaticResource MenuBackgroundBrushKey.ShinyBlue}"
                    BorderThickness="1"
                    CornerRadius="2"
                    BorderBrush="{StaticResource NormalBorderBrushKey.ShinyBlue}">

                            <DockPanel SnapsToDevicePixels="True">

                                <Border Name="PART_ThumbBorder"
                        DockPanel.Dock="Bottom"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#DDE7EE"
                        Background="{StaticResource WindowBackgroundBrushKey.ShinyBlue}">
                                    <local:PopupResizeThumb IsTabStop="False" Name="PART_ResizeThumb"/>
                                </Border>

                                <local:GalleryFilterSelector DockPanel.Dock="Top"/>

                                <Grid DockPanel.Dock="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition MinHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ScrollViewer Name="PART_ScrollViewer" Grid.Row="0">
                                        <StackPanel>
                                            <ItemsControl Name="PART_PopupItemsControl">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel
                              IsItemsHost="True"
                              ItemWidth="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemWidth}"
                              ItemHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <local:RibbonMenuGroup Visibility="{TemplateBinding MenuItems, Converter={StaticResource CountToVisibilityConverter}}"
                    Grid.Row="1" IconBarEnabled="{TemplateBinding MenuIconBarEnabled}"
                    ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=MenuItems}"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </mwt:SystemDropShadowChrome>
                </Popup>
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
            </Trigger>
            <!--<Trigger Property="IsPressed" Value="True">
          <Setter Property="BorderBrush" Value="#7B6645" />
          <Setter Property="Background" Value="{StaticResource GalleryRepeatButton.IsPressed.BackgroundBrush}" />
        </Trigger>-->
            <!--<Trigger  Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.65" />
          <Setter Property="Background" Value="{StaticResource GalleryRepeatButton.IsEnabled.BackgroundBrush}" />
        </Trigger>-->



            <Trigger Property="HasGroups" Value="True">
                <Setter TargetName="PART_PopupItemsControl" Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <local:GalleryGroupPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>


            <Trigger Property="ResizeDirection" Value="HorizontalAndVertical">
                <Setter TargetName="PART_Popup" Property="Width"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=HorizontalOffset}"/>
                <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=VerticalOffset}"/>
            </Trigger>

            <Trigger Property="ResizeDirection" Value="VerticalOnly">
                <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay,  Path=VerticalOffset}"/>
            </Trigger>

            <Trigger Property="PopupPosition" Value="Above">
                <Setter TargetName="PART_ThumbBorder" Property="DockPanel.Dock" Value="Top"/>
                <Setter TargetName="PART_ScrollViewer"   Property="DockPanel.Dock" Value="Bottom"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>



    <!--GALLERY DROPDOWN TEMPLATES-->

    <!--Large template-->
   

    <ControlTemplate x:Key="LargeGalleryTemplate.ShinyRed" TargetType="{x:Type local:RibbonGallery}">
        <ControlTemplate.Resources>
            <Storyboard x:Key="HoverOn">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BackgroundAnimation" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="HoverOff">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BackgroundAnimation" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.4000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="PressedOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="CheckedBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="0.6"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="PressedOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="CheckedBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ControlTemplate.Resources>

        <Border Name="PART_OuterBorder" BorderThickness="1" CornerRadius="1" BorderBrush="Transparent">
            <StackPanel>
                <Border Name="PART_ToggleButton"
              BorderBrush="{TemplateBinding BorderBrush}"
						  Background="{TemplateBinding Background}"
              BorderThickness="1"
              Height="{TemplateBinding Height}"
              CornerRadius="2">
                    <Grid>
                        <Border x:Name="CheckedBorder" BorderBrush="{StaticResource NormalBorderBrushKey.ShinyBlue}" CornerRadius="2" Opacity="0" Background="{TemplateBinding Background}" />
                        <Border x:Name="BackgroundAnimation" BorderBrush="{StaticResource NormalBorderBrushKey.ShinyBlue}" CornerRadius="2" Opacity="0" Background="{StaticResource HighlightBrushKey.ShinyBlue}" />


                        <StackPanel>
                            <Image Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Top"
                 Width="32" Height="32"
                 Margin="0,1,0,0"/>
                            <local:CustomItemsControl Path="{StaticResource Path}" ItemsSource="{Binding Path=Label, Mode=OneWay, Converter={StaticResource TextWrappingConverter}, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:MultilinePanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </local:CustomItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <Popup Name="PART_Popup"
             MinWidth="{TemplateBinding ExpandWidth}"
             MinHeight="{TemplateBinding ExpandHeight}"
             Placement="Custom"
             Focusable="False"
             AllowsTransparency="True"
             StaysOpen="False"
             PopupAnimation="Fade"
             IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonGallery}}}">

                    <mwt:SystemDropShadowChrome x:Name="PART_Shadow"
                                    SnapsToDevicePixels="True"
                                    ClipToBounds="True">

                        <Border Background="{StaticResource MenuBackgroundBrushKey.ShinyBlue}"
                  BorderThickness="1"
                  CornerRadius="2"
                  BorderBrush="{StaticResource NormalBorderBrushKey.ShinyBlue}">

                            <DockPanel LastChildFill="True"                       
                       SnapsToDevicePixels="True">

                                <Border Name="PART_ThumbBorder"
                         DockPanel.Dock="Bottom"
                         BorderThickness="0,1,0,0"
                         BorderBrush="#DDE7EE"
                         Background="{StaticResource WindowBackgroundBrushKey.ShinyBlue}">
                                    <local:PopupResizeThumb  Name="PART_ResizeThumb"/>
                                </Border>

                                <local:GalleryFilterSelector DockPanel.Dock="Top"/>

                                <Grid DockPanel.Dock="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition MinHeight="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemHeight}"/>
                                        <RowDefinition Height="Auto" MinHeight="0"/>
                                    </Grid.RowDefinitions>
                                    <ScrollViewer Grid.Row="0">
                                        <ItemsPresenter VerticalAlignment="Top"/>
                                    </ScrollViewer>

                                    <local:RibbonMenuGroup Visibility="{TemplateBinding MenuItems, Converter={StaticResource CountToVisibilityConverter}}"
                    Grid.Row="1" IconBarEnabled="{TemplateBinding MenuIconBarEnabled}"
                    ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=MenuItems}"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </mwt:SystemDropShadowChrome>
                </Popup>
            </StackPanel>
        </Border>


        <ControlTemplate.Triggers>
            <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
            </Trigger>

            <Trigger Property="ResizeDirection" Value="HorizontalAndVertical">
                <Setter TargetName="PART_Popup" Property="Width"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=HorizontalOffset}"/>
                <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay, Path=VerticalOffset}"/>
            </Trigger>

            <Trigger Property="ResizeDirection" Value="VerticalOnly">
                <Setter TargetName="PART_Popup" Property="Height"  Value="{Binding ElementName=PART_ResizeThumb, Mode=TwoWay,  Path=VerticalOffset}"/>
            </Trigger>

            <Trigger Property="PopupPosition" Value="Above">
                <Setter TargetName="PART_ThumbBorder" Property="DockPanel.Dock" Value="Top"/>
            </Trigger>

            <Trigger Property="IsMouseOver" Value="true">
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource HoverOff}" x:Name="HoverOff_BeginStoryboard"/>
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource HoverOn}" x:Name="HoverOn_BeginStoryboard"/>
                </Trigger.EnterActions>
                <Setter Property="Background" TargetName="PART_ToggleButton" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
            </Trigger>

            <Trigger Property="IsDropDownOpen" Value="true">
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource PressedOff}" x:Name="PressedOff_BeginStoryboard1"/>
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource PressedOn}" x:Name="PressedOn_BeginStoryboard1"/>
                </Trigger.EnterActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

