    <Style x:Key="ShinyBlueRibbonGalleryItemStyle" TargetType="{x:Type local:RibbonGalleryItem}">
        <Setter Property="ClickMode" Value="Release"/>
        <!--<Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonGalleryItem}">
                    <shared:TrippleBorder    Name="PART_TrippleBorder"
                                   BorderThickness="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemMouseOverBorderThickness}"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   Background="Transparent"
                                   OutsideBorderThickness="1"
                                   OutsideBorderBrush="Transparent"
                                   CornerRadius="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemMouseOverBorderCornerRadius}"
                                   MinWidth="0"
                                   SnapsToDevicePixels="True">

                        <ContentPresenter MinWidth="0"
                              ContentSource="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                />
                    </shared:TrippleBorder>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsChecked" Value="true">
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource SelectedBrushKey.ShinyBlue}"/>
                            <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" 
                      Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                            <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
                        </Trigger>
                                                <Trigger Property="IsFocused" Value="true">
                                                    <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                                                    <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
                                                    <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
                                                </Trigger>
                                                <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
                            <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
                        </MultiTrigger>

                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"/>
                            <Setter TargetName="PART_TrippleBorder"  
                      Property="OutsideBorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>
				
