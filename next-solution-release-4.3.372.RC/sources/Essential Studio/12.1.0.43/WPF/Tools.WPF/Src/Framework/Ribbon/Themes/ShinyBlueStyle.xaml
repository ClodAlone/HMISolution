                                            <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle.ShinyRed}" Visibility="{Binding ElementName=PART_AboveButton, Path=Visibility, Mode=TwoWay}"  Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove" Foreground="{StaticResource TextBrushKey.ShinyBlue}"/>
                                            <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle.ShinyRed}" Visibility="{Binding ElementName=PART_BelowButton, Path=Visibility, Mode=TwoWay}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}" Command="local:RibbonCommands.PlaceQATBelow" Foreground="{StaticResource TextBrushKey.ShinyBlue}"/>
                                            <Separator Background="{StaticResource SeparatorBackgroundBrushKey.ShinyBlue}" Margin="{StaticResource Default.QuickDropDownMargin}" Height="2"></Separator>
                                            <local:RibbonButton  IsSelected="{Binding ElementName=PART_MinimizeButton, Path=IsSelected, Mode=TwoWay}"   Command="local:RibbonCommands.MinimizeRibbon"  Style="{StaticResource RibbonButtonPopupItemStyle.ShinyRed}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=MinimizeRibbon}" IsToggle="True" Foreground="{StaticResource TextBrushKey.ShinyBlue}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </local:DropDownButton>
                        </StackPanel>
                    </local:DropDownButton>

                </Grid>
            </local:TwoItemsLayoutPanelEx>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="HasOverflowChildren" Value="True">
                <Setter TargetName="PART_PopupButton" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="PART_OverflowButton" Property="Visibility" Value="Visible"/>
            </Trigger>

            <Trigger Property="HasItems" Value="True"  SourceName="PART_QATMenu">
