                  MaxWidth="{TemplateBinding MaxWidth}"
                  MinHeight="{TemplateBinding MinHeight}"
                  MaxHeight="{TemplateBinding MaxHeight}"  Padding="{TemplateBinding Padding}"
                  Margin="{TemplateBinding Margin}" 
                  SnapsToDevicePixels="True"
