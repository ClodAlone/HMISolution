    <ControlTemplate x:Key="HorizontalAndVerticalResizeThumb.ShinyRed" TargetType="{x:Type local:PopupResizeThumb}">
        <Border Width="10" Height="10"
            Background="Transparent"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
            <Path Margin="0,0,2,2" Data="M7,0L7,7 0,7 0,4 4,4 4,0z"
            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Path.Fill>
                    <DrawingBrush ViewboxUnits="Absolute" TileMode="Tile" Viewbox="0,0,4,4" Viewport="0,0,4,4" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <DrawingGroup.Children>
                                    <GeometryDrawing Brush="#FFFFFFFF">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,1,1" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#FFFFFFFF"  Geometry="M1,1L3,1 3,3 1,3z" />
                                    <GeometryDrawing Brush="#FFFFFFFF"  Geometry="M0,0L2,0 2,2 0,2z" />
                                </DrawingGroup.Children>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Path.Fill>
            </Path>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Cursor" Value="SizeNWSE"/>
            </Trigger>
            <Trigger Property="FlowDirection" Value="RightToLeft">
                <Setter Property="Cursor" Value="SizeNESW"/>
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}},                  
                                Path=PopupPosition}" Value="Above">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="270" CenterX="5" CenterY="5"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Cursor" Value="SizeNESW"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}},                  
                                Path=PopupPosition}" Value="Above"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self},                  
                                Path=FlowDirection}" Value="RightToLeft"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="270" CenterX="5" CenterY="5"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Cursor" Value="SizeNWSE"/>
            </MultiDataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <ControlTemplate x:Key="VerticalOnlyResizeThumb.ShinyRed" TargetType="{x:Type local:PopupResizeThumb}">
        <Border Width="20" Height="10" Background="Transparent"
            VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M0,0L2,0 2,2 0,2z M5,0L7,0 7,2 5,2z M10,0L12,0 12,2 10,2z M15,0L17,0 17,2 15,2z" Fill="#FFFFFFFF" Margin="1,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Path Data="M0,0L2,0 2,2 0,2z M5,0L7,0 7,2 5,2z M10,0L12,0 12,2 10,2z M15,0L17,0 17,2 15,2z" Fill="#FFFFFFFF" Margin="0,0,1,1" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Cursor" Value="SizeNS"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ShinyBluePopupResizeThumbStyle" TargetType="{x:Type local:PopupResizeThumb}">
        <Setter Property="Template" Value="{StaticResource HorizontalAndVerticalResizeThumb.ShinyRed}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}},                  
                                Path=ResizeDirection}" Value="VerticalOnly">
                <Setter Property="Template" Value="{StaticResource VerticalOnlyResizeThumb.ShinyRed}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}},                  
                                Path=ResizeDirection}" Value="NoResize">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
			
	<Style BasedOn="{StaticResource ShinyBluePopupResizeThumbStyle}" TargetType="{x:Type local:PopupResizeThumb}"/>
		
