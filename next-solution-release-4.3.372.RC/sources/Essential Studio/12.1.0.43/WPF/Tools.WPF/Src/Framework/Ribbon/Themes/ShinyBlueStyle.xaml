                                                                                <Setter Property="FontSize" Value="18"/>
                                                                                <Setter Property="Padding" Value="16,9,16,9"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>

