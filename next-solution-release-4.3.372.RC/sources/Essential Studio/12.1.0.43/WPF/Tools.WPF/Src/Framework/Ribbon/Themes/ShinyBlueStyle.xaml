                                        <!--<DockPanel>
                                            <Border HorizontalAlignment="Left"  DockPanel.Dock="Left" Width="25" Background="{shared:SkinObject QATContextMenuLeftBarBackground}" BorderThickness="0,0,1,0" BorderBrush="{shared:SkinObject QATContextMenuBorderBrush}" />
                                        </DockPanel>-->
                                        <StackPanel>

                                            <Border Background="{StaticResource AppMenuBottomBackground.ShinyBlue}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource NormalBorderBrushKey.ShinyBlue}" Margin="0,0,0,1" Height="22">
