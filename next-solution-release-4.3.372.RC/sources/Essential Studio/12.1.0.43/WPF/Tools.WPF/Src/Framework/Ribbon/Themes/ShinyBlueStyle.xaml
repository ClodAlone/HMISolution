                                    <local:RibbonButton Name="PART_AboveButton" Visibility="Collapsed"  Style="{StaticResource RibbonButtonPopupItemStyle.ShinyRed}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove" Foreground="{StaticResource TextBrushKey.ShinyBlue}" Width="auto"/>
                                    <local:RibbonButton Name="PART_BelowButton" Style="{StaticResource RibbonButtonPopupItemStyle.ShinyRed}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}"  Command="local:RibbonCommands.PlaceQATBelow" Foreground="{StaticResource TextBrushKey.ShinyBlue}" Width="auto"/>
                                    <Separator Background="{StaticResource SeparatorBackgroundBrushKey.ShinyBlue}" Margin ="30,0,0,0"  Height="2"></Separator>
                                    <local:RibbonButton Name="PART_MinimizeButton"  Style="{StaticResource RibbonButtonPopupItemStyle.ShinyRed}"  Command="local:RibbonCommands.MinimizeRibbon"  Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=MinimizeRibbon}" IsToggle="True" Foreground="{StaticResource TextBrushKey.ShinyBlue}" Width="auto"/>
                                </StackPanel>
                            </Grid>
