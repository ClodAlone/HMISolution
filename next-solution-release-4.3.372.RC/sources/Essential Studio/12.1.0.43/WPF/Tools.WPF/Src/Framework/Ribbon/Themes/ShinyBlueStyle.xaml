                            <GeometryGroup>
                                <LineGeometry StartPoint="4,7" EndPoint="9,7"/>
                                <PathGeometry>
                                    <PathFigure StartPoint="5,10" IsFilled="True" IsClosed="True">
                                        <LineSegment Point="8,10"/>
                                        <LineSegment Point="6.5,12.5"/>
                                    </PathFigure>
                                </PathGeometry>
                            </GeometryGroup>
                        </local:DropDownButton.PathGeometry>

                        <Border BorderThickness="0.5" BorderBrush="{StaticResource NormalBorderBrushKey.ShinyBlue}" Padding="2" Width="auto">
