                            <GeometryGroup>
                                <PathGeometry>
                                    <PathFigure StartPoint="3.5,8" IsFilled="True" IsClosed="True">
                                        <LineSegment Point="4.5,9"/>
                                        <LineSegment Point="3.5,10"/>
                                    </PathFigure>
                                </PathGeometry>

                                <PathGeometry>
                                    <PathFigure StartPoint="7.5,8" IsFilled="True" IsClosed="True">
                                        <LineSegment Point="8.5,9"/>
                                        <LineSegment Point="7.5,10"/>
                                    </PathFigure>
                                </PathGeometry>

                            </GeometryGroup>
                        </local:DropDownButton.PathGeometry>

