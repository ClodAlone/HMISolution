                            <Setter TargetName="PART_Label" Property="BitmapEffect">
                                <Setter.Value>
                                    <OuterGlowBitmapEffect GlowColor="#FFFFFFFF" GlowSize="10" Opacity="1"/>
                                </Setter.Value>
