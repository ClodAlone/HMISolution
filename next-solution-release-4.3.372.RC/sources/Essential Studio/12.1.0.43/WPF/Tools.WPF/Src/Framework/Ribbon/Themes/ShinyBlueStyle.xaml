	<ControlTemplate x:Key="ToggleItemTemplate.ShinyRed" TargetType="{x:Type local:RibbonMenuItem}">
        <ControlTemplate.Resources>
            <Storyboard x:Key="HighlightedOn">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="HighlightedOff">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ControlTemplate.Resources>

        <Border BorderThickness="{TemplateBinding BorderThickness}"
                        Background="{TemplateBinding Panel.Background}"
                        Width="{TemplateBinding Width}"   
                        Height="{TemplateBinding Height}"
                        MinWidth="{TemplateBinding MinWidth}"
                        MaxWidth="{TemplateBinding MaxWidth}"
                        MinHeight="{TemplateBinding MinHeight}"
                        MaxHeight="{TemplateBinding MaxHeight}"
                        Margin="{TemplateBinding Margin}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}"
                       
                        SnapsToDevicePixels="True" Name="Bd">
            <Grid>
                <Border Background="{StaticResource NormalBackgroundBrushKey.ShinyBlue}"  
		    Opacity="0" x:Name="border"/>
                <Grid Grid.ColumnSpan="3">
                    <Border                        
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition />
                                <ColumnDefinition Width="17"/>
                            </Grid.ColumnDefinitions>

                            <Border Name="PART_CheckBorder" Grid.Column="0" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}">
                                <ContentPresenter Content="{TemplateBinding Icon}" Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                        Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                            </Border>

                            <!--<TextBlock Grid.Column="1" Margin="11,0,10,0"   Text="{TemplateBinding MenuItem.Header}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>-->
                                                    <ContentPresenter ContentSource="Header" Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                                        <ContentPresenter.Style>
                                                            <Style>
                                                                <Style.Triggers>
                                                                    <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                                                        <Setter Property="TextElement.FontSize" Value="18"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentPresenter.Style>
                                                    </ContentPresenter>
                                                        <Path Width="17" Visibility="{TemplateBinding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Grid.Column="2" Data="M0,0L4,3.5 0,7z" Fill="{TemplateBinding Foreground}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            <Popup Name="PART_Popup" 
                               StaysOpen="False" 
                               PopupAnimation="Fade" 
                               MinWidth="10" 
                               MinHeight="10" 
                               HorizontalOffset="1" 
                               VerticalOffset="0" 
                               AllowsTransparency="true" 
                               Placement="Right" 
                               Focusable="false" 
                               IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome Name="PART_Shadow" SnapsToDevicePixels="true">
                                    <Border BorderBrush="{StaticResource NormalBorderBrushKey.ShinyBlue}" CornerRadius="{StaticResource Default.AppMenuCornerRadius}" BorderThickness="1" Background="{StaticResource MenuBackgroundBrushKey.ShinyBlue}">
                                        <Grid>
                                            <ScrollViewer Margin="0,0,1,0" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}" CanContentScroll="True" Grid.ColumnSpan="2">
                                                <ItemsPresenter Name="Presenter" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Grid.IsSharedSizeScope="true" />
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                    <!--<Border BorderThickness="1" Background="#FAFAFA" BorderBrush="#FF808080" CornerRadius="2">              
                <ItemsPresenter Name="Presenter" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Grid.IsSharedSizeScope="true" />              
            </Border>-->
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,3,3"/>
            </Trigger>

            <Trigger Property="IsFocused" Value="true">
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource HighlightedOff}" x:Name="HighlightedOff_BeginStoryboard"/>
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource HighlightedOn}"/>
                </Trigger.EnterActions>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource HighlightedOff}" x:Name="HighlightedOff_BeginStoryboard1"/>
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource HighlightedOn}"/>
                </Trigger.EnterActions>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
            <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
            <Setter Property="TextElement.FontSize" Value="18"/>
            <Setter Property="Padding" Value="16,9,16,9"/>
