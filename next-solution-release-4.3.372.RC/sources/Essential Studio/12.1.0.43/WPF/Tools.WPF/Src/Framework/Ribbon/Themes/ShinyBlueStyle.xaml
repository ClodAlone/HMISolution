    <ControlTemplate x:Key="ApplicationMenuTemplate" TargetType="{x:Type local:ApplicationMenu}">
        <Grid x:Name="PART_ButtonGrid" Height="38" Width="38" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}">
            <Ellipse Height="37" Width="37" Name="OB"
               Fill="{StaticResource ShinyBlue.AppButton.OutterBorderFill}"
               Stroke="{StaticResource ShinyBlue.AppButton.OutterBorder}"
               StrokeThickness="1"
               SnapsToDevicePixels="True" />
            <Ellipse Height="37" Width="37"
               Stroke="{StaticResource ShinyBlue.AppButton.OutterBorder}"
               Opacity="0.6"
               StrokeThickness="1"
               SnapsToDevicePixels="True">
                <Ellipse.RenderTransform>
                    <TranslateTransform X="1" Y="0.4" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Height="35" Width="35"
               Fill="{StaticResource ShinyBlue.AppButton.InnerBorderFill}"
               Name="IB"
               Stroke="{StaticResource ShinyBlue.AppButton.InnerBorder}"
               SnapsToDevicePixels="True" />
            <Ellipse Height="33" Width="33"
               Fill="{StaticResource ShinyBlue.AppButton.TopHighlight}"
               Name="TH"
               SnapsToDevicePixels="True" />
            <Ellipse Height="33" Width="33"
               Fill="{StaticResource ShinyBlue.AppButton.BottomHighlight}"
               Name="BH"
               SnapsToDevicePixels="True" />
            <Image Name="PART_ApplicationButtonImage"
             Margin="1.5,1,0,0"
             HorizontalAlignment="Center"             
             VerticalAlignment="Center"             
             Width="{Binding Path=ApplicationButtonImageWidth, RelativeSource={RelativeSource TemplatedParent}}" 
             Height="{Binding Path=ApplicationButtonImageHeight, RelativeSource={RelativeSource TemplatedParent}}" 
             Source="{Binding Path=ApplicationButtonImage, RelativeSource={RelativeSource TemplatedParent}}"
             SnapsToDevicePixels="True"/>
            <local:CustomPopup StaysOpen="False" PopupAnimation="Fade" Placement="Bottom" HorizontalOffset="-3" VerticalOffset="-16" x:Name="PART_Popup" Focusable="False" AllowsTransparency="True" IsOpen="{Binding Path=IsPopupOpen, Mode=TwoWay, UpdateSourceTrigger=Explicit, RelativeSource={RelativeSource TemplatedParent}}" SnapsToDevicePixels="True" >
                <mwt:SystemDropShadowChrome Name="Shdw" Margin="0">
                    <Grid x:Name="mainGrid">
                        <Border BorderBrush="{StaticResource NormalBorderBrushKey.ShinyBlue}" CornerRadius="{StaticResource Default.AppMenuCornerRadius}" BorderThickness="1,1,1,1">
                            <Border BorderBrush="{StaticResource AppMenuBottomBackground.ShinyBlue}" CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}" BorderThickness="1,1,1,1" Background="{StaticResource AppMenuBottomBackground.ShinyBlue}">
                                <DockPanel LastChildFill="True">
                                    <Border Height="15" CornerRadius="2,2,2,2" Background="{StaticResource AppMenuBottomBackground.ShinyBlue}" DockPanel.Dock="Top" />
                                    <DockPanel LastChildFill="True">
                                        <Border Height="Auto" CornerRadius="0,0,2,2" Background="{StaticResource AppMenuBottomBackground.ShinyBlue}" VerticalAlignment="Bottom" DockPanel.Dock="Bottom">
                                            <shared:ItemsControlInternal x:Name="PART_AppItems" 
                                                   Margin="0,-2,0,-1" 
                                                   Visibility="Visible" 
                                                   HorizontalAlignment="Right" 
                                                   Padding="1,3,1,3"
                                                   ItemContainerStyle="{StaticResource ItemsControlInternalItemStyle}">
                                                <shared:ItemsControlInternal.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel KeyboardNavigation.DirectionalNavigation="Contained" IsItemsHost="True" Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </shared:ItemsControlInternal.ItemsPanel>
                                            </shared:ItemsControlInternal>
                                        </Border>
                                        <Border Margin="2,0,2,1" BorderBrush="{StaticResource NormalBorderBrushKey.ShinyBlue}" BorderThickness="1,1,1,1" Grid.Row="1">
                                            <Border BorderBrush="{StaticResource TransparentBorderBrush.ShinyBlue}" BorderThickness="1,1,1,1" Background="{StaticResource AppMenuBackground.ShinyBlue}">
                                                <DockPanel LastChildFill="True">
                                                    <Border x:Name="PART_Border" BorderBrush="{StaticResource TransparentBorderBrush.ShinyRed }" Visibility="Visible" BorderThickness="1,0,0,0" Background="{StaticResource AppMenuBackgroundBrush.ShinyBlue}" DockPanel.Dock="Right"
															MinWidth="{TemplateBinding PreviewPanelMinWidth}">
                                                        <Border BorderBrush="{StaticResource TransparentBorderBrush.ShinyRed}" BorderThickness="1,0,0,0" Padding="2,2,2,2">
                                                            <ItemsControl x:Name="PART_MenuItems" ItemsSource="{TemplateBinding internalMenuItems}"  ItemTemplate="{x:Null}" Foreground="{StaticResource TextBrushKey.ShinyBlue}" />
                                                        </Border>
                                                    </Border>
                                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,0,-5,-5" HorizontalScrollBarVisibility="Hidden">
                                                        <ItemsPresenter Margin="0,0,5,5" x:Name="PART_Items" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                    </ScrollViewer>
                                                </DockPanel>
                                            </Border>
                                        </Border>
                                    </DockPanel>
                                </DockPanel>
                            </Border>
                        </Border>
                        <Grid Name="PART_FakeAppButton"
                              Height="38" Width="38"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top">
                            <Ellipse Height="37" Width="37"
                                    Fill="{StaticResource AppButtonExpandedOutterBorderFill.ShinyBlue}"
                                    Stroke="{StaticResource ShinyBlue.AppButton.OutterBorder}"
                                    StrokeThickness="1"/>
                            <Ellipse Height="37" Width="37"
                                Stroke="{StaticResource AppButtonExpandedOutterBorder.ShinyBlue}"
                                Opacity="0.6"
                                StrokeThickness="1">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="1"  Y="0.4"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Height="35" Width="35"
                                Fill="{StaticResource AppButtonExpandedInnerBorderFill.ShinyBlue}"
                                Stroke="{StaticResource ShinyBlue.AppButton.InnerBorder}" />
                            <Ellipse Height="33" Width="33" Fill="{StaticResource AppButtonExpandedTopHighlight.ShinyBlue}"/>
                            <Ellipse Height="33" Width="33" Fill="{StaticResource AppButtonExpandedBottomHighlight.ShinyBlue}"/>
                            <Image Margin="1.5,1,0,0"                               
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Width="{Binding Path=ApplicationButtonImageWidth, RelativeSource={RelativeSource TemplatedParent}}" 
                                 Height="{Binding Path=ApplicationButtonImageHeight, RelativeSource={RelativeSource TemplatedParent}}" 
                                 Source="{Binding Path=ApplicationButtonImage, RelativeSource={RelativeSource TemplatedParent}}"
                                 SnapsToDevicePixels="True"/>
                            <Grid.RenderTransform>
                                <TranslateTransform X="0" Y="-22" />
                            </Grid.RenderTransform>
                        </Grid>
                    </Grid>
                </mwt:SystemDropShadowChrome>
                <local:CustomPopup.Style>
                    <Style>
                        <Style.Triggers>
                            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                <Setter Property="Popup.VerticalOffset" Value="-90"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </local:CustomPopup.Style>
            </local:CustomPopup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                <Setter TargetName="Shdw" Property="Margin" Value="0,0,4,4"/>
            </Trigger>
            <Trigger Property="IsBelowAppButton" Value="False">
                <Setter TargetName="PART_FakeAppButton" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="-5"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="OB" Property="Fill" Value="{StaticResource ShinyBlue.AppButton.OutterBorderFill}"/>
                <Setter TargetName="OB" Property="Stroke" Value="{StaticResource ShinyBlue.AppButton.OutterBorder}"/>
                <Setter TargetName="IB" Property="Fill" Value="{StaticResource ShinyBlue.AppButton.InnerBorderFill}"/>
                <Setter TargetName="IB" Property="Stroke" Value="{StaticResource  ShinyBlue.AppButton.InnerBorder}"/>
                <Setter TargetName="TH" Property="Fill" Value="{StaticResource  AppButtonHoverTopHighlight.ShinyBlue}"/>
                <Setter TargetName="BH" Property="Fill" Value="{StaticResource AppButtonHoverBottomHighlight.ShinyBlue}"/>
            </Trigger>
           
            <Trigger Property="IsPopupOpen" Value="True">
                <Setter TargetName="OB" Property="Fill" Value="{StaticResource AppButtonExpandedOutterBorderFill.ShinyBlue}"/>
                <Setter TargetName="OB" Property="Stroke" Value="{StaticResource AppButtonExpandedOutterBorder.ShinyBlue}"/>
                <Setter TargetName="IB" Property="Fill" Value="{StaticResource AppButtonExpandedInnerBorderFill.ShinyBlue}"/>
                <Setter TargetName="IB" Property="Stroke" Value="{StaticResource AppButtonExpandedInnerBorder.ShinyBlue}"/>
                <Setter TargetName="TH" Property="Fill" Value="{StaticResource AppButtonExpandedTopHighlight.ShinyBlue}"/>
                <Setter TargetName="BH" Property="Fill" Value="{StaticResource AppButtonExpandedBottomHighlight.ShinyBlue}"/>
            </Trigger>
            <Trigger Property="IsKeyTipShown" Value="True">
                <Setter TargetName="OB" Property="Fill" Value="{StaticResource AppButtonExpandedOutterBorderFill.ShinyBlue}"/>
                <Setter TargetName="OB" Property="Stroke" Value="{StaticResource AppButtonExpandedOutterBorder.ShinyBlue}"/>
                <Setter TargetName="IB" Property="Fill" Value="{StaticResource AppButtonExpandedInnerBorderFill.ShinyBlue}"/>
                <Setter TargetName="IB" Property="Stroke" Value="{StaticResource AppButtonExpandedInnerBorder.ShinyBlue}"/>
                <Setter TargetName="TH" Property="Fill" Value="{StaticResource AppButtonExpandedTopHighlight.ShinyBlue}"/>
                <Setter TargetName="BH" Property="Fill" Value="{StaticResource AppButtonExpandedBottomHighlight.ShinyBlue}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="FrameworkElement.Height" TargetName="PART_ButtonGrid" Value="48" />
                <Setter Property="FrameworkElement.Width" TargetName="PART_ButtonGrid" Value="48" />
                <Setter Property="FrameworkElement.Height" TargetName="PART_FakeAppButton" Value="48" />
                <Setter Property="FrameworkElement.Width" TargetName="PART_FakeAppButton" Value="48" />
                <Setter Property="Visibility" TargetName="PART_FakeAppButton" Value="Collapsed" />
                <Setter Property="Width" TargetName="mainGrid" Value="330"/>
                <Setter Property="Margin" TargetName="PART_Border" Value="5,0,5,0"/>
                <Setter Property="Width" TargetName="PART_Border" Value="150"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

