    <!--QuickAccessToolBar style-->
    <Style x:Key="Office2007BlueQuickAccessToolBarStyle"  TargetType="{x:Type local:QuickAccessToolBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="GeometryBackground" Value="{StaticResource Blue.QuickAccessActiveBrush}"/>
        <Setter Property="GeometryStroke" Value="{StaticResource Blue.ActiveGeometryStroke}"/>
        <Setter Property="Control.Foreground" Value="{StaticResource Blue.Foreground}"/>
        <Setter Property="Height" Value="22"/>
             
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:QuickAccessToolBar}">
                    <Border       
      Height="{TemplateBinding Height}" 
      Width="{TemplateBinding  Width}"
      BorderThickness="{TemplateBinding BorderThickness}"
      BorderBrush="{TemplateBinding BorderBrush}" 
      Background="{TemplateBinding Background}">
                        <local:TwoItemsLayoutPanelEx Name="PART_PanelEx" shell:WindowChrome.IsHitTestVisibleInChrome="True"  MinRightWidth="30" MaxRightWidth="30">
                            <ItemsControl Name="PART_Main" 
                        Grid.Column="0" 
                        Focusable="False">
