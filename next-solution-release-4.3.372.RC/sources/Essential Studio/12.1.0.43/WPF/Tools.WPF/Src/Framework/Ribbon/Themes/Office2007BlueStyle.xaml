            <!--<Trigger Property="IsPressed" Value="True">
        <Setter Property="BorderBrush" Value="#CAB583"/>
        <Setter Property="Background" Value="{StaticResource Luna.PressedBrush.Default}"/>
      </Trigger>-->
        </Style.Triggers>
    </Style>
  
