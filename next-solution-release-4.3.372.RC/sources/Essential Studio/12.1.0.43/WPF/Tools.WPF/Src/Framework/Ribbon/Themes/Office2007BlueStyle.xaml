            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonMenuGroup}">
                    <local:LayoutPanel x:Name="PART_LayoutPanel" Width="{TemplateBinding ActualWidth}">
                        <StackPanel Margin="1,0,1,1" HorizontalAlignment="Stretch">
                            <Border Name="PART_Header"  Height="21"  HorizontalAlignment="Stretch" Margin="0,0,0,2"  SnapsToDevicePixels="True" Background="{StaticResource Blue.MenuItems.HeaderBackground}" BorderBrush="{StaticResource Blue.QATContextMenu.BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="2,2,0,0" Padding="7,0,5,0" >
                                <TextBlock Text="{TemplateBinding Header}" FontSize="{TemplateBinding FontSize}" FontWeight="Bold" Foreground="{StaticResource Blue.Foreground}" VerticalAlignment="Center"/>
                            </Border>
                            <ItemsPresenter KeyboardNavigation.TabNavigation="Contained" KeyboardNavigation.DirectionalNavigation="Contained" x:Name="PART_Presenter" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="0,0,0,1"/>
                        </StackPanel>
                        <Border BorderThickness="0,0,1,0" BorderBrush="{StaticResource Blue.QATContextMenu.BorderBrush}" Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"  Margin="1,1,1,1" Background="{StaticResource Blue.MenuItems.HeaderBackground}" Height="{TemplateBinding ActualHeight}" Width="22" Panel.ZIndex="-1" HorizontalAlignment="Left"/>
                    </local:LayoutPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter TargetName="PART_Header" Property="Height" Value="1"/>
