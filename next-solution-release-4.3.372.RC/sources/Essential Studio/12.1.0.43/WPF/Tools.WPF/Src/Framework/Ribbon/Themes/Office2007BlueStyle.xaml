                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Grid>
                                <local:DropDownButton Style="{StaticResource QuickAccessPopupButtonStyle}"  Name="PART_PopupButton" Width="23" >
                                    <local:DropDownButton.PathGeometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="4,7" EndPoint="9,7"/>
                                            <PathGeometry>
                                                <PathFigure StartPoint="5,10" IsFilled="True" IsClosed="True">
                                                    <LineSegment Point="8,10"/>
                                                    <LineSegment Point="6.5,12.5"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </GeometryGroup>
                                    </local:DropDownButton.PathGeometry>

                                    <Border BorderThickness="0.5" BorderBrush="{StaticResource Default.QuickDropDownBorderBrush}" Padding="2" Width="auto">
                                        <Grid>
                                            <DockPanel>
                                                <Border HorizontalAlignment="Left"  DockPanel.Dock="Left" Width="25" Background="{StaticResource Blue.QATContextMenu.LeftBar.Backgound}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Blue.QATContextMenu.BorderBrush}"  />
                                            </DockPanel>
                                            <StackPanel>
                                                <Border Background="{StaticResource Blue.QATContextMenu.TopBar.Backgound}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Blue.QATContextMenu.BorderBrush}" Margin="0,0,0,1" Height="22" Width="auto">
                                                    <TextBlock x:Uid="CustomizeQATTextBlock"  Margin="3,0,0,0"  Foreground="{StaticResource Blue.QATContextMenu.Foreground}" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path= CustomizeQAT}" FontWeight="Bold" VerticalAlignment="Center" Width="auto" />
                                                </Border>
                                                <ItemsControl Name="PART_QATMenu">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                                                                <StackPanel.Resources>
                                                                    <Style TargetType="{x:Type local:RibbonButton}">
                                                                        <Setter  Property="OverridesDefaultStyle"     Value="true"/>
                                                                        <Setter Property="Background"                 Value="Transparent"/>
                                                                        <Setter Property="Foreground"                 Value="{StaticResource Blue.Foreground}"/>
                                                                        <!--<Setter Property="Height"                     Value="23"/>-->
                                                                        <Setter Property="BorderThickness"            Value="1"/>

                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="{x:Type local:RibbonButton}">
                                                                                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}" 
                  Background="{TemplateBinding Panel.Background}"
                  Width="{TemplateBinding Width}"
                  Height="{TemplateBinding Height}"
                  MinWidth="{TemplateBinding MinWidth}"
                  MaxWidth="{TemplateBinding MaxWidth}"
                  MinHeight="{TemplateBinding MinHeight}"
                  MaxHeight="{TemplateBinding MaxHeight}" 
                  Margin="{TemplateBinding Margin}" 
                  SnapsToDevicePixels="True"
                  Padding="{TemplateBinding Padding}"
                  >
                                                                                        <Grid>
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="21"/>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                            </Grid.ColumnDefinitions>

                                                                                            <Border Name="PART_CheckBorder" Grid.Column="0" Visibility="Collapsed" 
                      Width="21" Height="21" BorderThickness="1" BorderBrush="{StaticResource Default.QuickCheckedButtonBorderBrush}"  
                      Background="{StaticResource Default.QuickCheckedButtonBackgroundBrush}" CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}"
                      >
                                                                                                <Path Stroke="{StaticResource Blue.Foreground}" StrokeThickness="1.4">
                                                                                                    <Path.Data>
                                                                                                        <GeometryGroup>
                                                                                                            <LineGeometry StartPoint="6 9" EndPoint="9 16"/>
                                                                                                            <LineGeometry StartPoint="9 16" EndPoint="13 3"/>
                                                                                                        </GeometryGroup>
                                                                                                    </Path.Data>
                                                                                                </Path>
                                                                                            </Border>
                                                                                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Name="label"  Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsSelected" Value="True">
                                                                                            <Setter TargetName="PART_CheckBorder" Property="Visibility" Value="Visible"/>
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
                                                                                        </Trigger>
                                                                                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                                                                            <Setter Property="FontSize" Value="18"/>
                                                                                            <Setter Property="Padding" Value="16,9,16,9"/>
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>

                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
                                                                                <Setter Property="BorderBrush" Value="{StaticResource Default.QuickDropDownButtonHoverBorder}"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Resources>
                                                            </StackPanel>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                                <Separator Name="TopSeperator" Visibility="Collapsed" Background="{StaticResource Default.QuickDropDownSeparator}" Margin ="30,0,0,0"  Height="2"></Separator>
                                                <local:RibbonButton Name="PART_MoreCommands"  Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATMoreCommands}" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=EnableMoreCommands, Converter={StaticResource BooleanToVisibilityConverter}}"  Command="local:RibbonCommands.QATMoreCommands" Foreground="{StaticResource Blue.Foreground}" Width="auto"/>
                                                <local:RibbonButton Name="PART_AboveButton" Visibility="Collapsed"  Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove" Foreground="{StaticResource Blue.Foreground}" Width="auto"/>
                                                <local:RibbonButton Name="PART_BelowButton" Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}"  Command="local:RibbonCommands.PlaceQATBelow" Foreground="{StaticResource Blue.Foreground}" Width="auto"/>
                                                <Separator Background="{StaticResource Default.QuickDropDownSeparator}" Margin ="30,0,0,0"  Height="2"></Separator>
                                                <local:RibbonButton Name="PART_MinimizeButton"  Style="{StaticResource RibbonButtonPopupItemStyle}"  Command="local:RibbonCommands.MinimizeRibbon"  Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=MinimizeRibbon}" IsToggle="True" Foreground="{StaticResource Blue.Foreground}" Width="auto"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </local:DropDownButton>
                                <local:DropDownButton  
            Grid.Column="1"
            Name="PART_OverflowButton"
            Style="{StaticResource QuickAccessPopupButtonStyle}"                           
            Visibility="Collapsed" 
            DockPanel.Dock="Right">
                                    <local:DropDownButton.PathGeometry>
                                        <GeometryGroup>
                                            <PathGeometry>
                                                <PathFigure StartPoint="3.5,8" IsFilled="True" IsClosed="True">
                                                    <LineSegment Point="4.5,9"/>
                                                    <LineSegment Point="3.5,10"/>
                                                </PathFigure>
                                            </PathGeometry>
                                            <PathGeometry>
                                                <PathFigure StartPoint="7.5,8" IsFilled="True" IsClosed="True">
                                                    <LineSegment Point="8.5,9"/>
                                                    <LineSegment Point="7.5,10"/>
                                                </PathFigure>
                                            </PathGeometry>
                                        </GeometryGroup>
                                    </local:DropDownButton.PathGeometry>

                                    <StackPanel Orientation="Horizontal" Background="{StaticResource Blue.QuickAccessActiveBrush}" MaxHeight="21">
                                        <ItemsControl Name="PART_PopupItemsControl" >
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <local:DropDownButton Name="PART_PopupButtonOverflowed"   Style="{StaticResource QuickAccessPopupButtonStyle}"
															Visibility="{TemplateBinding QATDropDownVisiblity}">
                                            <local:DropDownButton.PathGeometry>
                                                <GeometryGroup>
                                                    <LineGeometry StartPoint="4,7" EndPoint="9,7"/>
                                                    <PathGeometry>
                                                        <PathFigure StartPoint="5,10" IsFilled="True" IsClosed="True">
                                                            <LineSegment Point="8,10"/>
                                                            <LineSegment Point="6.5,12.5"/>
                                                        </PathFigure>
                                                    </PathGeometry>
                                                </GeometryGroup>
                                            </local:DropDownButton.PathGeometry>

                                            <Border BorderThickness="0.5" BorderBrush="Gray" Padding="2" Width="220">
                                                <Grid>
                                                    <DockPanel>
                                                        <Border HorizontalAlignment="Left"  DockPanel.Dock="Left" Width="25" Background="{StaticResource Blue.QATContextMenu.LeftBar.Backgound}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Blue.QATContextMenu.BorderBrush}" />
                                                    </DockPanel>
                                                    <StackPanel>
                                                        <Border Background="{StaticResource Blue.QATContextMenu.TopBar.Backgound}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Blue.QATContextMenu.BorderBrush}" Margin="0,0,0,1" Height="22">
                                                            <TextBlock x:Uid="CustomizeQATTextBlock" Margin="3,0,0,0"  Foreground="{StaticResource Blue.QATContextMenu.Foreground}" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=CustomizeQAT}" FontWeight="Bold" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ItemsControl Name="PART_QATMenuOverFlow" ItemContainerStyle="{StaticResource RibbonButtonPopupItemStyle}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                        <Separator Name="TopSeperatorOverFlow" Visibility="Collapsed" Background="{StaticResource Default.QuickDropDownSeparator}" Margin="{StaticResource Default.QuickDropDownMargin}" Height="2"></Separator>
                                                        <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATMoreCommands}" Command="local:RibbonCommands.QATMoreCommands" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=EnableMoreCommands, Converter={StaticResource BooleanToVisibilityConverter}}"  Foreground="{StaticResource Blue.Foreground}"/>
                                                        <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle}" Visibility="{Binding ElementName=PART_AboveButton, Path=Visibility, Mode=TwoWay}"  Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove" Foreground="{StaticResource Blue.Foreground}"/>
                                                        <local:RibbonButton Style="{StaticResource RibbonButtonPopupItemStyle}" Visibility="{Binding ElementName=PART_BelowButton, Path=Visibility, Mode=TwoWay}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}" Command="local:RibbonCommands.PlaceQATBelow" Foreground="{StaticResource Blue.Foreground}"/>
                                                        <Separator Background="{StaticResource Default.QuickDropDownSeparator}" Margin="{StaticResource Default.QuickDropDownMargin}" Height="2"></Separator>
                                                        <local:RibbonButton  IsSelected="{Binding ElementName=PART_MinimizeButton, Path=IsSelected, Mode=TwoWay}"   Command="local:RibbonCommands.MinimizeRibbon"  Style="{StaticResource RibbonButtonPopupItemStyle}" Label="{Binding Source={StaticResource ResourceWrapperKey}, Path= MinimizeRibbon}" IsToggle="True" Foreground="{StaticResource Blue.Foreground}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </local:DropDownButton>
                                    </StackPanel>
                                </local:DropDownButton>
                            </Grid>
                        </local:TwoItemsLayoutPanelEx>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasOverflowChildren" Value="True">
                            <Setter TargetName="PART_PopupButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_OverflowButton" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="True"  SourceName="PART_QATMenu">
                            <Setter Property="Visibility" TargetName="TopSeperator" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True"  SourceName="PART_QATMenuOverFlow">
                            <Setter Property="Visibility" TargetName="TopSeperatorOverFlow" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasGeometry" Value="False">
                            <Setter TargetName="PART_AboveButton" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_BelowButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}}}" Value="False">
                <Setter Property="GeometryBackground" Value="{StaticResource Blue.QuickAccessNotActiveBrush}"/>
                <Setter Property="GeometryStroke" Value="{StaticResource Blue.GeometryStroke}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}"
                     Value="True">
                <Setter Property="GeometryBackground" Value="Transparent"/>
            </DataTrigger>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="FrameworkElement.Height" Value="40" />
            </Trigger>
        </Style.Triggers>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlueQuickAccessToolBarStyle}" TargetType="{x:Type local:QuickAccessToolBar}"/>
	
    <!--CustomScrollViewerStyle-->
    <Style x:Key="CustomScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Column="0" Grid.Row="1">
                            <ScrollContentPresenter Margin="{TemplateBinding Control.Padding}" CanVerticallyScroll="False" CanHorizontallyScroll="False" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Content="{TemplateBinding ContentControl.Content}" />
                        </Border>
                        <RepeatButton x:Name="PART_TopButton" CommandTarget="{x:Null}" Visibility="Visible" Focusable="False" Command="ScrollBar.LineUpCommand" Grid.Column="0" Grid.Row="0">
                            <RepeatButton.Style>
                                <Style TargetType="{x:Type RepeatButton}">
                                    <Setter Property="ButtonBase.ClickMode" Value="Hover"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Margin="1,1,1,1" BorderBrush="{StaticResource Default.MenuCustomScrollBorderBrush}" CornerRadius="1,1,1,1" BorderThickness="1,1,1,1" Name="MenuScrollButtonBorder" Background="{StaticResource Default.MenuCustomScrollBrush}">
                                                    <ContentPresenter Margin="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Center" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Content="{TemplateBinding ContentControl.Content}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="ButtonBase.IsPressed" Value="True">
                                                        <Setter Property="Border.BorderBrush" TargetName="MenuScrollButtonBorder" Value="{StaticResource Default.MenuScrollPressedBorderBrush}" />
                                                        <Setter Property="Panel.Background" TargetName="MenuScrollButtonBorder" Value="{StaticResource Default.MenuScrollPressedBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RepeatButton.Style>
                            <Path Data="M0,4L3.5,0 7,4z" Fill="{StaticResource Blue.Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </RepeatButton>
                        <RepeatButton x:Name="PART_BottomButton" CommandTarget="{x:Null}" Visibility="Visible" Focusable="False" Command="ScrollBar.LineDownCommand" Grid.Column="0" Grid.Row="2">
                            <RepeatButton.Style>
                                <Style TargetType="{x:Type RepeatButton}">
                                    <Setter Property="ButtonBase.ClickMode" Value="Hover"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Margin="1,1,1,1" BorderBrush="{StaticResource Default.MenuCustomScrollBorderBrush}" CornerRadius="1,1,1,1" BorderThickness="1,1,1,1" Name="MenuScrollButtonBorder" Background="{StaticResource Default.MenuCustomScrollBrush}">
                                                    <ContentPresenter Margin="2,2,2,2" HorizontalAlignment="Center" VerticalAlignment="Center" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Content="{TemplateBinding ContentControl.Content}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="ButtonBase.IsPressed" Value="True">
                                                        <Setter Property="Border.BorderBrush" TargetName="MenuScrollButtonBorder" Value="{StaticResource Default.MenuScrollPressedBorderBrush}" />
                                                        <Setter Property="Panel.Background" TargetName="MenuScrollButtonBorder" Value="{StaticResource Default.MenuScrollPressedBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RepeatButton.Style>
                            <Path Data="M0,0L3.5,4 7,0z" Fill="{StaticResource Blue.Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </RepeatButton>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Collapsed">
                            <Setter TargetName="PART_BottomButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_TopButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

