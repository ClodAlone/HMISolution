					  Placement="Custom"
					  PlacementTarget ="{Binding Path=PlacementBorder, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ApplicationMenu}}}"
					  Focusable="False"
					  PopupAnimation="Fade"
					  AllowsTransparency="True"
					  StaysOpen="True"
					  IsOpen="{Binding Path=IsMenuOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="true" Margin="0">
                                    <Border Background="{StaticResource Default.QuickDropDownBackground}" BorderThickness="1" CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}" BorderBrush="{StaticResource Default.QuickDropDownBorderBrush}" >
                                        <ScrollViewer x:Name="PART_ScrollViwer" Style="{StaticResource CustomScrollViewerStyle}" >
                                            <ItemsPresenter
								  Margin="{TemplateBinding Control.Padding}"
								  HorizontalAlignment="Stretch"
								  VerticalAlignment="Stretch"
								  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </local:CustomPopup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,3,3"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="PART_OutterBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.OutterBorderBrush}"/>
                            <Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource MenuButton.InnerBorderBrush}"/>
                            <Setter TargetName="PART_InnerBorder"  Property="Background" Value="{StaticResource MenuButton.MouseOverBrush}"/>
                            <Setter TargetName="PART_Description" Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
                            <Setter TargetName="PART_Label" Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
