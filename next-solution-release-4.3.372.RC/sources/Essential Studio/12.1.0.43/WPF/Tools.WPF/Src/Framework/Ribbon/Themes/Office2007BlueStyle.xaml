                                                <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                                    <Setter Property="RowDefinition.Height" Value="120"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RowDefinition.Style>
                                </RowDefinition>
                                <RowDefinition Height="17"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Border Name="PART_RibbonBarBorder"
              BorderBrush="{StaticResource RibbonBarBorderBrush}"
              BorderThickness="1,1,1,0"
              CornerRadius="3,3,0,0">
                                <Border Name="PART_presenterBorder"
                    Grid.Row="0"
                    Background="{StaticResource RibbonBarBackgroundBrush1}">
                                    <ItemsPresenter/>
                                </Border>
                            </Border>

                            <Border Name="PART_headerBorder" CornerRadius="0,0,2,2" Grid.Row="1" Background="{StaticResource Blue.RibbonBarHeader.BackgroundBrush}">

                                <DockPanel>
                                    <local:RibbonButton Name="PART_DialogLauncherButton" 
										              Style="{StaticResource RibbonBarLauncherButton}"  
                                  DockPanel.Dock="Right" 
                                  SizeForm="ExtraSmall" 
								  SmallIcon="{TemplateBinding CollapseImage}" 
                                  Width="15" 
                                  Height="14"                                										 
								  Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LauncherCommand }"
                                  CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LauncherCommandParameter }"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LauncherCommandTarget }"
                                  ToolTip="{TemplateBinding LauncherToolTip}"
                                  Visibility="{TemplateBinding IsLauncherButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    </local:RibbonButton>
                                    <TextBlock Foreground="{StaticResource Blue.Foreground2}" Name="header"  TextAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding Header}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_headerBorder" Property="Background" Value="{StaticResource Blue.RibbonBarHeader.BackgroundHoverBrush}"/>
                            <Setter TargetName="PART_presenterBorder" Property="Background" Value="{StaticResource Blue.RibbonBar.BackgroundHoverBrush}"/>
                            <Setter TargetName="header" Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
                        </Trigger>

                        <!-- <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
             Value="True">
                            <Setter TargetName="PART_RibbonBarBorder" Property="BorderBrush" Value="{StaticResource RibbonBar.Context.Background}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource RibbonBar.Context.BorderBrush}"/>
                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
                     Value="True"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_presenterBorder"  Property="Background" Value="{StaticResource RibbonBar.Context.Hover.BackgroundBrush}"/>
                        </MultiDataTrigger> -->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="1,2,1,2"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:GroupPanel ItemMargin="2,4,1,4"
                 PanelState="{Binding RelativeSource={RelativeSource FindAncestor
                 , AncestorType={x:Type local:RibbonBar}}, Path=PanelState, Mode=OneWay}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="PanelState" Value="ExtraSmall">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonBar}">
                            <local:DropDownButton Name="PART_RibbonDropDownButton"
                              SizeForm="ExtraSmall" 
                              Label="{TemplateBinding Header}"                              
                              SmallIcon="{TemplateBinding CollapseImage}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition>
                                            <RowDefinition.Style>
                                                <Style>
                                                    <Setter Property="RowDefinition.Height" Value="68"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                                            <Setter Property="RowDefinition.Height" Value="120"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </RowDefinition.Style>
                                        </RowDefinition>
                                        <RowDefinition Height="17"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <Border Name="PART_RibbonBarBorder" Background="{StaticResource Blue.Ribbon.Background}"  BorderBrush="{StaticResource Blue.Ribbon.Background}" BorderThickness="1,1,1,0"
                      CornerRadius="3,3,0,0">
                                        <Border Name="PART_PresenterBorder"  Grid.Row="0">
                                            <ItemsPresenter/>
                                        </Border>
                                    </Border>

                                    <Border Grid.Row="1" Name="PART_headerBorder"
                      Background="{StaticResource Blue.RibbonBarHeader.BackgroundBrush}">
