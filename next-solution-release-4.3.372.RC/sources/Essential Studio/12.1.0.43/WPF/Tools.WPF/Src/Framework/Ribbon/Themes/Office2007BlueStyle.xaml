                                    <Setter Property="Background" TargetName="toggleButton" Value="{StaticResource MouseOverBackground}"/>
                                    <Setter Property="BorderBrush" TargetName="toggleButton" Value="{StaticResource MouseOverBorderBrush}"/>
                                    <Setter Property="BorderThickness" TargetName="toggleButton" Value="1,0,0,0"/>

                                </Trigger>

                                <Trigger Property="IsDropDownOpen" Value="true">
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="#FFFB8C3C"/>
                                    <Setter Property="BorderBrush" TargetName="toggleButton" Value="#FFFB8C3C" />
                                    <Setter Property="Background" TargetName="toggleButton" Value="{StaticResource pressedbackground1}" />
                                    <Setter Property="BorderThickness" TargetName="toggleButton" Value="1,0,0,0"/>
                                </Trigger>
                                <Trigger Property="HasItems" Value="false">
                                    <Setter Property="MinHeight" Value="95" TargetName="DropDownBorder"/>
                                </Trigger>
                                <Trigger Property="HasItems" Value="false">
                            <Setter Property="MinHeight" Value="95" TargetName="DropDownBorder"/>
                        </Trigger>
                        <!--<Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="Transparent"/>
                        </Trigger>-->
                        <Trigger Property="IsGrouping" Value="true">
                            <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                        </Trigger>
                        <Trigger Property="AllowsTransparency" SourceName="Popup" Value="true">
                            <Setter Property="Margin" Value="0,0,0,0" TargetName="DropDownBorder"/>
                            <Setter Property="CornerRadius" TargetName="DropDownBorder" Value="3,3,3,3"/>
                        </Trigger>
                        <Trigger Property="IsEditable" Value="true">
                            <Setter Property="IsTabStop" Value="false"/>
                            <Setter Property="Visibility" Value="Visible" TargetName="PART_EditableTextBox"/>
                            <!--<Setter Property="Visibility" Value="Hidden" TargetName="ContentSite"/>-->
                        </Trigger>
                                <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                    <Setter Property="Height" Value="28"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>            
        </Style.Triggers>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlueRibbonComboBoxStyle}" TargetType="{x:Type local:RibbonComboBox}"/>
	
    <!--SeparatorStyle-->
    <Style x:Key="SeparatorStyle" TargetType="Separator">
        <Setter Property="Border.BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FrameworkElement.MinHeight" Value="2"/>
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
        <Setter Property="Margin" Value="30,0,0,0"/>
        <Setter Property="Background" Value="{StaticResource Default.QuickDropDownSeparator}"/>
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Margin="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--CheckableItemTemplate-->
    <ControlTemplate x:Key="CheckableItemTemplate" TargetType="{x:Type local:RibbonMenuItem}">
        <Border BorderThickness="{TemplateBinding BorderThickness}"
            BorderBrush="{TemplateBinding BorderBrush}"
            Background="{TemplateBinding Panel.Background}"
            Width="{TemplateBinding Width}"
            Height="{TemplateBinding Height}"
            MinWidth="{TemplateBinding MinWidth}"
            MaxWidth="{TemplateBinding MaxWidth}"
            MinHeight="{TemplateBinding MinHeight}"
            MaxHeight="{TemplateBinding MaxHeight}"
            Margin="{TemplateBinding Margin}"
            Padding="{TemplateBinding Padding}"
            SnapsToDevicePixels="True"
                Name="Bd"  >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="21"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Name="PART_CheckBorder" Grid.Column="0" Visibility="Collapsed" Margin="-5,0,0,0"
                      Width="21" Height="21" BorderThickness="1" BorderBrush="{StaticResource  Default.QuickCheckedButtonBorderBrush}"  
                      Background="{StaticResource Default.QuickCheckedButtonBackgroundBrush}" CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}"
                      >
                    <Path Stroke="{StaticResource Blue.Foreground}" StrokeThickness="1.4">
                        <Path.Data>
                            <GeometryGroup>
                                <LineGeometry StartPoint="6 9" EndPoint="9 16"/>
                                <LineGeometry StartPoint="9 16" EndPoint="13 3"/>
                            </GeometryGroup>
                        </Path.Data>
                    </Path>
                </Border>

                <TextBlock Grid.Column="1" Margin="7,2,0,2" Text="{TemplateBinding MenuItem.Header}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="MenuItem.IsChecked" Value="True">
                <Setter TargetName="PART_CheckBorder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Default.HoverBorderBrush}"/>
                <Setter Property="Background" TargetName="Bd" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                <Setter Property="TextElement.FontSize" Value="18"/>
                <Setter Property="Padding" Value="16,9,16,9"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--RibbonContextMenuItems-->
    <ItemsControl x:Key="RibbonContextMenuItems">
        <local:RibbonMenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=RemoveFromQAT}" Visibility="Collapsed" Command="local:RibbonCommands.RemoveItemFromQAT" Tag="Remove" CommandTarget="{Binding Path=PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonContextMenu}}}"/>
        <local:RibbonMenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=AddToQAT}" Visibility="Collapsed" Tag="Item_One" Command="local:RibbonCommands.AddItemToQAT" CommandTarget="{Binding Path=PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonContextMenu}}}"/>
        <Separator Style="{StaticResource SeparatorStyle}" Tag="Item_Two"></Separator>
        <local:RibbonMenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=CustomizeQATContextMenu}" Tag="Item_Three" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}, Path=EnableMoreCommands, Converter={StaticResource BooleanToVisibilityConverter}}"  Command="local:RibbonCommands.QATMoreCommands" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}"/>
        <local:RibbonMenuItem Visibility="Collapsed"  Tag="Item_Four" Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowAbove}" Command="local:RibbonCommands.PlaceQATAbove"  CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}"/>
        <local:RibbonMenuItem Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATShowBelow}" Tag="Item_Five" Command="local:RibbonCommands.PlaceQATBelow"  CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}"/>
        <Separator Style="{StaticResource SeparatorStyle}" Tag="Item_Six"></Separator>
        <local:RibbonMenuItem Margin="0,0,0,0" Tag="Item_Seven" Template="{StaticResource CheckableItemTemplate}"  Header="{Binding Source={StaticResource ResourceWrapperKey}, Path=MinimizeRibbon}" IsCheckable="True" Command="local:RibbonCommands.MinimizeRibbon"  CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}}}">
            <local:RibbonMenuItem.Icon>
                <Path Stroke="Black" StrokeThickness="1.4">
                    <Path.Data>
                        <GeometryGroup>
                            <LineGeometry StartPoint="6 9" EndPoint="9 16"/>
                            <LineGeometry StartPoint="9 16" EndPoint="13 3"/>
                        </GeometryGroup>
                    </Path.Data>
                </Path>
            </local:RibbonMenuItem.Icon>
        </local:RibbonMenuItem>
    </ItemsControl>

    <!--RibbonContextMenu Style-->
    <Style x:Key="Office2007BlueRibbonContextMenuStyle" TargetType="{x:Type local:RibbonContextMenu}">
        <Setter Property="Panel.Background" Value="{StaticResource Default.QuickDropDownBackground}"/>
        <Setter Property="TextElement.FontFamily" Value="Tahoma"/>
        <Setter Property="TextElement.FontSize" Value="11"/>
        <Setter Property="TextElement.FontStyle" Value="Normal"/>
        <Setter Property="TextElement.FontWeight" Value="Normal"/>
        <Setter Property="StaysOpen"  Value="False"/>
        <Setter Property="MenuItem.Foreground" Value="{StaticResource Blue.Foreground}"/>
        <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Center"/>
        <Setter Property="Border.BorderThickness" Value="1,1,1,1"/>
        <Setter Property="Border.BorderBrush" Value="{StaticResource Default.QuickDropDownBorderBrush}"/>
        <Setter Property="Control.Padding" Value="1,1,1,1"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
        <Setter Property="ContextMenuService.HasDropShadow" Value="True"/>
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemsSource" Value="{Binding Source={StaticResource RibbonContextMenuItems}, Path=Items}" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonContextMenu}">
                    <Microsoft_Windows_Themes:SystemDropShadowChrome Name="Shdw" SnapsToDevicePixels="True" Color="#00FFFFFF">
                        <Border BorderBrush="{TemplateBinding Border.BorderBrush}" CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}" BorderThickness="{TemplateBinding Border.BorderThickness}" Background="{TemplateBinding Panel.Background}">
                            <Grid>
                                <Rectangle Margin="1,1,1,1" Width="25" RadiusY="2" HorizontalAlignment="Left" Fill="{StaticResource Blue.QATContextMenu.LeftBar.Backgound}" RadiusX="2" />
                                <Rectangle Margin="26,1,0,1" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Blue.QATContextMenu.BorderBrush}" />
                                <Rectangle Margin="27,1,0,1" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Default.QuickDropDownBackground}" />
                                <ScrollViewer Margin="1,0,1,0" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}" CanContentScroll="True" Grid.ColumnSpan="2">
                                    <ItemsPresenter Margin="{TemplateBinding Control.Padding}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Microsoft_Windows_Themes:SystemDropShadowChrome>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ContextMenuService.HasDropShadow" Value="True">
                            <Setter Property="FrameworkElement.Margin" TargetName="Shdw" Value="0,0,5,5"/>
                            <Setter Property="Microsoft_Windows_Themes:SystemDropShadowChrome.Color" TargetName="Shdw" Value="#71000000"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="TextElement.FontSize" Value="18"/>
                            <Setter Property="Padding" Value="16,9,16,9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlueRibbonContextMenuStyle}" TargetType="{x:Type local:RibbonContextMenu}"/>
	
    <!--GalleryFilterSelector Style-->
    <Style x:Key="Office2007BlueGalleryFilterSelectorStyle" TargetType="{x:Type local:GalleryFilterSelector}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GalleryFilterSelector}">
                    <Grid>
                        <Border Height="15" 
                    Name="PART_DropDownButton" 
                    Background="{StaticResource Blue.RibbonBarHeader.BackgroundBrush}"
                    BorderThickness="0,0,0,1" 
                    BorderBrush="{StaticResource Default.QuickDropDownBorder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="10,0,0,0" 
                            
                           FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
                           FontStyle="Normal"                            
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GalleryFilterSelector}},                  
                                          Path=SelectedFilter.Label}"/>
                                <Path Fill="{TemplateBinding Foreground}"
					            HorizontalAlignment="Center"
					            VerticalAlignment="Center"
					            Data="M 0 0 L 4 4 L 8 0 Z"
					            Margin="1"/>
                            </StackPanel>
                        </Border>
                        <Popup Name="PART_Popup"                   
                   Placement="Bottom"
                   Focusable="False"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   PopupAnimation="Fade"
                   IsOpen="{Binding Path=IsDropDownOpen, 
                                    Mode=TwoWay, 
                                    RelativeSource={RelativeSource AncestorType={x:Type local:GalleryFilterSelector}}}">
                            <mwt:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="True">
                                <local:RibbonButtonChecker
                  ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GalleryFilterSelector}},
                                        Converter={StaticResource GalleryFilterConverter}, 
                                        ConverterParameter={StaticResource RibbonButtonPopupItemStyle},
                                        Path=Filters}"
                  
                  CheckedButton="{Binding Mode=TwoWay,
                                          RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:GalleryFilterSelector}},
                                          Converter={StaticResource FilterToRibbonButtonConverter},
                                          Path=SelectedFilter}"/>
                            </mwt:SystemDropShadowChrome>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Default.GalleryFilterSelection}"/>
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=HasFilters}" Value="True">
                <Setter Property="Filters" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=GalleryFilters}"/>
                <Setter Property="SelectedFilter" Value="{Binding Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=CurrentFilter}"/>
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlueGalleryFilterSelectorStyle}" TargetType="{x:Type local:GalleryFilterSelector}"/>
	
    <!--RibbonButtonChecker Style-->
    <Style x:Key="Office2007BlueRibbonButtonCheckerStyle" TargetType="{x:Type local:RibbonButtonChecker}">
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonButtonChecker}">
                    <Border Background="{StaticResource Default.RibbonButtonChecked}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlueRibbonButtonCheckerStyle}" TargetType="{x:Type local:RibbonButtonChecker}"/>
	
    <!--PopupResizeThumb Style-->
	<ControlTemplate TargetType="{x:Type local:PopupResizeThumb}" x:Key="VerticalPopupResizeThumbTemplate">
		<Border Width="20" Height="10" Background="Transparent"
VerticalAlignment="Center" HorizontalAlignment="Center">
			<Grid HorizontalAlignment="Center" VerticalAlignment="Center">
				<Path Data="M0,0L2,0 2,2 0,2z M5,0L7,0 7,2 5,2z M10,0L12,0 12,2 10,2z M15,0L17,0 17,2 15,2z" Fill="#C0C6D6" Margin="1,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
				<Path Data="M0,0L2,0 2,2 0,2z M5,0L7,0 7,2 5,2z M10,0L12,0 12,2 10,2z M15,0L17,0 17,2 15,2z" Fill="#5574A7" Margin="0,0,1,1" HorizontalAlignment="Center" VerticalAlignment="Center" />
			</Grid>
		</Border>

		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Cursor" Value="SizeNS"/>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	
    <Style x:Key="Office2007BluePopupResizeThumbStyle" TargetType="{x:Type local:PopupResizeThumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PopupResizeThumb}">
                    <Border Width="10" Height="10"
            Background="Transparent"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
                        <Path Margin="0,0,2,2" Data="M7,0L7,7 0,7 0,4 4,4 4,0z"
            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Path.Fill>
                                <DrawingBrush ViewboxUnits="Absolute" TileMode="Tile" Viewbox="0,0,4,4" Viewport="0,0,4,4" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <DrawingGroup.Children>
                                                <GeometryDrawing Brush="#00FFFFFF">
                                                    <GeometryDrawing.Geometry>
                                                        <RectangleGeometry Rect="0,0,1,1" />
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                                <GeometryDrawing Brush="#C0C6D6"  Geometry="M1,1L3,1 3,3 1,3z" />
                                                <GeometryDrawing Brush="#5574A7"  Geometry="M0,0L2,0 2,2 0,2z" />
                                            </DrawingGroup.Children>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Path.Fill>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="SizeNWSE"/>
                        </Trigger>
                        <Trigger Property="FlowDirection" Value="RightToLeft">
                            <Setter Property="Cursor" Value="SizeNESW"/>
                        </Trigger>
                        
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        
    </Style>

	<Style BasedOn="{StaticResource Office2007BluePopupResizeThumbStyle}" TargetType="{x:Type local:PopupResizeThumb}"/>
	
    <!--LabelTextBlock Style-->
    <Style x:Key="Office2007BlueLabelTextBlockStyle" TargetType="{x:Type local:LabelTextBlock}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,-2,0,0"/>
        <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlueLabelTextBlockStyle}" TargetType="{x:Type local:LabelTextBlock}"/>
	
    <!--GalleryRepeatButtonStyle-->
    <Style x:Key="GalleryRepeatButtonStyle" TargetType="Button">
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Background" Value="{StaticResource Blue.Gallery.RepeatButton.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  Opacity="{TemplateBinding Opacity}"
                  BorderThickness="1">
                        <Border Name="PART_InnerBorder"
                    BorderBrush="{StaticResource Blue.CheckBoxBackground}"
                    BorderThickness="1"
                    Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_InnerBorder"  Property="BorderBrush" Value="{StaticResource Default.HoverBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Default.HoverBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource GalleryRepeatButton.IsMouseOver.BackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource GalleryRepeatButton.IsPressed.BorderBrush}" />
                <Setter Property="Background" Value="{StaticResource GalleryRepeatButton.IsPressed.BackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65" />
               <!-- <Setter Property="Background" Value="{StaticResource GalleryRepeatButton.IsEnabled.BackgroundBrush}" />-->
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--GalleryItem template-->
    <Style x:Key="Office2007BlueRibbonGalleryItemStyle" TargetType="{x:Type local:RibbonGalleryItem}">
        <Setter Property="ClickMode" Value="Release"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonGalleryItem}">
                    <shared:TrippleBorder    Name="PART_TrippleBorder"
                                   BorderThickness="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemMouseOverBorderThickness}"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   Background="Transparent"
                                   OutsideBorderThickness="1"
                                   OutsideBorderBrush="Transparent"
                                   CornerRadius="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonGallery}}, Path=ItemMouseOverBorderCornerRadius}"
                                   MinWidth="0"
                                   SnapsToDevicePixels="True">
                        <ContentPresenter MinWidth="0"
                              ContentSource="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                />
                    </shared:TrippleBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource Luna.SelectedBrush.Default}"/>
 <Setter TargetName="PART_TrippleBorder" Property="Background" Value="{StaticResource Luna.SelectedBrush.Default}"/>
                            <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" 
                      Value="{StaticResource RibbonGalleryItem.IsChecked.BorderBrush.Outside}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                            <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{StaticResource RibbonGalleryItem.IsMouseOver.BorderBrush}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
<Setter TargetName="PART_TrippleBorder" Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="true">
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                            <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{StaticResource RibbonGalleryItem.IsMouseOver.BorderBrush}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource Luna.HoverSelectedBrush.Default}"/>
                            <Setter TargetName="PART_TrippleBorder"  Property="OutsideBorderBrush" Value="{StaticResource Default.QuickDropDownBorderBrush}"/>
                        </MultiTrigger>

                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="PART_TrippleBorder" Property="CornerRadius" Value="{StaticResource Default.AppMenuCornerRadius}"/>
                            <Setter TargetName="PART_TrippleBorder" Property="BorderBrush" Value="{StaticResource Luna.PressedBrush.Default}"/>
                            <Setter TargetName="PART_TrippleBorder"  
                      Property="OutsideBorderBrush" Value="{StaticResource RibbonGalleryItem.IsPressed.BorderBrush.Outside}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlueRibbonGalleryItemStyle}" TargetType="{x:Type local:RibbonGalleryItem}"/>
	
    <!--RibbonStatusBar Style-->
    <Style x:Key="RibbonStatusBarKey" TargetType="{x:Type local:RibbonStatusBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonStatusBar}">
                    <Border Height="{TemplateBinding Height}" 
                  ClipToBounds="True" 
                  CornerRadius="0,0,2,2" 
                  BorderThickness="{TemplateBinding BorderThickness}" 
                  BorderBrush="{TemplateBinding BorderBrush}" 
                  Background="{TemplateBinding Background}">
                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
                            <ItemsPresenter x:Name="PART_Presenter"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource Blue.Foreground2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Background" Value="{StaticResource Blue.StatusBar.Background}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <!--<Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>-->
        <Setter Property="Height" Value="22"/>
    </Style>
    
	
    <!--RibbonGallery Style-->
    <Style x:Key="Office2007BlueRibbonGalleryStyle" TargetType="{x:Type local:RibbonGallery}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Height" Value="62"/>
