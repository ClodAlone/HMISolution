        <Setter Property="Margin" Value="5,4,5,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shared:ItemsControlInternalItem">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ContentPresenter DataContext="{Binding Path=DataContext,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type shared:ItemsControlInternal}}}" Content="{TemplateBinding Content}" Margin="-1"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
