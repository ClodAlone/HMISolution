                                <Grid x:Name="mainGrid">
                                    <Border BorderBrush="{StaticResource Blue.AppMenu.OutterBorderBrush}" CornerRadius="{StaticResource Default.AppMenuCornerRadius}" BorderThickness="1,1,1,1">
