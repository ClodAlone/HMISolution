                                                        <shared:ItemsControlInternal x:Name="PART_AppItems" 
                                                   Margin="0,-2,0,-1" 
                                                   Visibility="Visible" 
                                                   HorizontalAlignment="Right" 
                                                   Padding="1,3,1,3"
                                                   ItemContainerStyle="{StaticResource ItemsControlInternalItemStyle}">
                                                            <shared:ItemsControlInternal.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel KeyboardNavigation.DirectionalNavigation="Contained" IsItemsHost="True" Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </shared:ItemsControlInternal.ItemsPanel>
                                                        </shared:ItemsControlInternal>
                                                    </Border>
                                                    <Border Margin="2,0,2,1" BorderBrush="{StaticResource Blue.AppMenu.BorderBrush1}" BorderThickness="1,1,1,1" Grid.Row="1">
                                                        <Border BorderBrush="{StaticResource Blue.AppMenu.BorderBrush2}" BorderThickness="1,1,1,1" Background="{StaticResource Blue.AppMenu.Background2}">
                                                            <DockPanel LastChildFill="True">
                                                                <Border x:Name="PART_Border" BorderBrush="{StaticResource Blue.AppMenu.BorderBrush3}" Visibility="Visible" BorderThickness="1,0,0,0" Background="{StaticResource Blue.AppMenu.Background3}" DockPanel.Dock="Right" MinWidth="{TemplateBinding PreviewPanelMinWidth}">
                                                                    <Border BorderBrush="{StaticResource Blue.AppMenu.BorderBrush4}" BorderThickness="1,0,0,0" Padding="2,2,2,2">
                                                                        <ItemsControl x:Name="PART_MenuItems" ItemsSource="{TemplateBinding internalMenuItems}" ItemTemplate="{x:Null}" Foreground="{StaticResource Blue.Foreground}" />
                                                                    </Border>
                                                                </Border>
                                                                <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="0,0,-5,-5" HorizontalScrollBarVisibility="Hidden">
