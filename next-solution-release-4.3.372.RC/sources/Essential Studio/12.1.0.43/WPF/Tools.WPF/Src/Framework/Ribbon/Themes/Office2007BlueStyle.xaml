	<Style BasedOn="{StaticResource Office2007BlueRibbonPageStyle}" TargetType="{x:Type local:RibbonPage}"/>

    <!--RibbonRadioButton Style-->
    <Style x:Key="Office2007BlueRibbonRadioButtonStyle" TargetType="{x:Type local:RibbonRadioButton}">
        <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
        <Setter Property="Margin" Value="3,3,3,3"/>
        <Setter Property="Background" Value="{StaticResource CheckRadioFillNormal}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CheckRadioStrokeNormal}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Content" Value="New RadioButton"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonRadioButton}">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Canvas Width="13" Height="13">
                                <Ellipse x:Name="ellipse1" Width="13" Height="13" Fill="{StaticResource Blue.CheckBoxBackground}" Stroke="{StaticResource Blue.CheckBox.BorderBrush}">
                                </Ellipse>
                                <Ellipse x:Name="ellipse2" Fill="{StaticResource Blue.CheckBox.InnerBorderBrush}" Canvas.Left="2" Canvas.Top="2" Width="9" Height="9">
                                </Ellipse>
                                <Ellipse x:Name="ellipse3" Fill="{StaticResource CheckRadioInnerFillBrush}" Canvas.Left="3" Canvas.Top="3" Width="7" Height="7">
                                </Ellipse>
                                <Ellipse x:Name="ellipse" Canvas.Left="4" Canvas.Top="4" Width="5" Height="5">
                                </Ellipse>
                            </Canvas>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="6,0,0,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Fill" TargetName="ellipse" Value="{StaticResource Blue.CheckBox.BorderBrushHover}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ellipse1" Property="Stroke" Value="{StaticResource Blue.CheckBox.BorderBrushHover}" />
                            <Setter TargetName="ellipse2" Property="Fill" Value="{StaticResource Blue.CheckBox.InnerBorderBrush}" />
                            <Setter TargetName="ellipse3" Property="Fill" Value="{StaticResource CheckRadioOverInnerFillBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlueRibbonRadioButtonStyle}" TargetType="{x:Type local:RibbonRadioButton}"/>
	
    <!--RibbonScrollingButton style-->
    <Style x:Key="RibbonScrollingButton" TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="PART_Border" VerticalAlignment="Stretch" HorizontalAlignment="Center"
				BorderThickness="1,0,0,0"
				BorderBrush="{TemplateBinding BorderBrush}"
				Background="{TemplateBinding Background}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True"
				CornerRadius="0,3,3,0"
					>
                        <Border x:Name="PART_InnerBorder" VerticalAlignment="Stretch" HorizontalAlignment="Center"
				BorderThickness="1,0,0,0"
				BorderBrush="{StaticResource Blue.CheckBoxBackground}"
				Background="{TemplateBinding Background}"
				Opacity="{TemplateBinding Opacity}"
				IsEnabled="{TemplateBinding IsEnabled}"
				SnapsToDevicePixels="True"
        CornerRadius="0,3,3,0">
                            <Path x:Name="PART_Path" Stroke="{StaticResource Blend.PathFill1}" StrokeThickness="2" Fill="{StaticResource Blue.Path.Fill}" Margin="3,16,-2,0"
								  HorizontalAlignment="Center"
								  VerticalAlignment="Center"
								  Data="{StaticResource Default.PathData}">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Left">
                            <Setter TargetName="PART_Path" Property="Margin" Value="6,0,-5,0"/>
                            <Setter TargetName="PART_Path" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_Border" Property="CornerRadius" Value="3,0,0,3"/>
                            <Setter TargetName="PART_InnerBorder" Property="CornerRadius" Value="3,0,0,3"/>
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter TargetName="PART_InnerBorder" Property="BorderThickness" Value="0,0,1,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
        <Setter Property="Background" Value="{StaticResource Blue.Ribbon.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue.ImageBorder.BorderBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--RibbonSeparator Style-->
    <Style x:Key="Office2007BlueRibbonSeparatorStyle" TargetType="{x:Type local:RibbonSeparator}">
        <Setter Property="Focusable"   Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonSeparator}">
                    <StackPanel Width="2" Height="55" Orientation="Horizontal">
                        <Border Width="1" Height="55" Background="White"/>
                        <Border Width="1" Height="55" Background="{StaticResource Blue.SeparatorBrush}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Margin" Value="3,5,3,0"/>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlueRibbonSeparatorStyle}" TargetType="{x:Type local:RibbonSeparator}"/>
	
    <!--RibbonTextBox Style-->
    <Style x:Key="Office2007BlueRibbonTextBoxStyle" TargetType="{x:Type local:RibbonTextBox}">
        <Setter Property="Background" Value="{StaticResource Blue.TextBoxBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue.CheckBox.BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="AllowDrop" Value="true"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonTextBox}">
                    <Border SnapsToDevicePixels="true" x:Name="Bd" CornerRadius="{StaticResource Blue.ComboCornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Background" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Blue.CheckBox.BorderBrushHover}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Blue.TextBoxBackgroundHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
	<Style BasedOn="{StaticResource Office2007BlueRibbonTextBoxStyle}" TargetType="{x:Type local:RibbonTextBox}"/>
	
	<Style x:Key="Office2007BlueWindowTitleBarButtonStyle"  TargetType="{x:Type local:WindowTitleBarButton}">
        <!-- <Setter Property="Background" Value="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type local:TitleBar}}}"/> -->
        <Setter Property="Focusable" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WindowTitleBarButton}">
                    <Border CornerRadius="3" Background="{TemplateBinding Background}" Panel.ZIndex="100"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter  Content="{TemplateBinding Content}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger  Property="IsMouseOver" Value="True">
                            <Setter  Property="Background" Value="{StaticResource TitleBarButtonMouseOver}"/> 
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
		
	<Style BasedOn="{StaticResource Office2007BlueWindowTitleBarButtonStyle}" TargetType="{x:Type local:WindowTitleBarButton}"/>
	
    <!--TitleBar Style-->
    <Style x:Key="TitleBarStyleKey" TargetType="{x:Type local:TitleBar}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Background" Value="{StaticResource Blue.TitleBar.BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue.TitleBar.BorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TitleBar}">
                    <Border Background="{TemplateBinding Background}"
                BorderThickness="0,0,0,1" 
                BorderBrush="{TemplateBinding BorderBrush}" 
                CornerRadius="4,4,0,0">
                        <Grid Name="GlassActive"
                  Height="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Path=AppMenuColumnWidth, Converter={StaticResource DoubleToGridLengthConverter}, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ColumnDefinition Width="{Binding Path=QATColumnWidth, Converter={StaticResource DoubleToGridLengthConverter}, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{Binding Path=SysButtonsColumnWidth, Converter={StaticResource DoubleToGridLengthConverter}, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid.ColumnDefinitions>
                            <Grid  Grid.Column="2" Margin="10,0,10,0">
                    <Rectangle x:Name="rectangle" Fill="#7FFFFFFF" Stroke="{x:Null}" StrokeThickness="0" 
                   HorizontalAlignment="{Binding HorizontalAlignment,ElementName=PART_Title,Mode=TwoWay}" 
                    VerticalAlignment="Center" Margin="5,0,0,0" Width="{Binding ActualWidth, ElementName=PART_Title, Mode=Default}"
                               Height="{Binding ActualHeight, ElementName=PART_Title, Mode=Default}" RadiusX="2" RadiusY="2"
                               Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive,Converter={StaticResource BoolToVisibilityConverter}}">
                        <Rectangle.Effect>
                            <BlurEffect Radius="10"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <TextBlock Name="PART_Title"                            
                           Grid.Column="2"
                           Foreground="{TemplateBinding Foreground}"
                           HorizontalAlignment="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=TitleTextAlignment}" 
                           VerticalAlignment="Center"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           Text="{TemplateBinding Title}"
                           Margin="5,0,0,0"
                           MaxWidth="{TemplateBinding TitleMaxWidth}">
                    </TextBlock>
                </Grid>
                            <StackPanel Orientation="Horizontal" 
                            Grid.Column="3">
                                <local:WindowTitleBarButton x:Name="MinButton" Width="25" Height="25" ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path=MinimizeTooltip}" Style="{StaticResource  {x:Type local:WindowTitleBarButton}}" >
                                    <Canvas Width="9" Height="9">
                                        <Line X1="0" X2="8"  Y1="6" Y2="6" Stroke="{StaticResource Blue.SystemButton.Brush1}" StrokeThickness="1"/>
                                        <Line X1="0" X2="8"  Y1="7" Y2="7" Stroke="{StaticResource Blue.SystemButton.Brush2}" StrokeThickness="1"/>
                                        <Line X1="0" X2="8"  Y1="8" Y2="8" Stroke="{StaticResource Blue.SystemButton.Brush3}" StrokeThickness="1"/>
                                    </Canvas>
                                </local:WindowTitleBarButton>
                                <local:WindowTitleBarButton x:Name="MaxButton" Width="25" Height="25" ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path=MaximizeTooltip}"  Style="{StaticResource  {x:Type local:WindowTitleBarButton}}" >
                                    <Canvas Width="9" Height="9">
                                        <Border BorderThickness="1,3,1,1" Width="9" Margin="0,1,0,0" Height="7" BorderBrush="{StaticResource Blue.SystemButton.Brush2}"/>
                                    </Canvas>
                                </local:WindowTitleBarButton>
                                <local:WindowTitleBarButton x:Name="NormalButton" Width="25" Height="25" Visibility="Hidden" ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path=RestoreTooltip}" Style="{StaticResource  {x:Type local:WindowTitleBarButton}}" >
                                    <Canvas Width="9" Height="8">
                                        <Line X1="2" X2="9"  Y1="1.5" Y2="1.5" Stroke="{StaticResource Blue.SystemButton.Brush1}" StrokeThickness="1"/>
                                        <Rectangle Canvas.Left="6" Canvas.Top="2"  Stroke="{StaticResource Blue.SystemButton.Brush2}" Width="3" Height="5" StrokeThickness="1"/>
                                        <Line X1="3" X2="8"  Y1="3" Y2="3" Stroke="{StaticResource Blue.SystemButton.Brush3}" StrokeThickness="1"/>
                                        <Line X1="2" X2="8"  Y1="7" Y2="7" Stroke="{StaticResource Blue.SystemButton.Brush3}" StrokeThickness="1"/>
                                        <Line X1="0" X2="7"  Y1="2.5" Y2="2.5" Stroke="{StaticResource Blue.SystemButton.Brush1}" StrokeThickness="1"/>
                                        <Rectangle Canvas.Left="0" Canvas.Top="3" Stroke="{StaticResource Blue.SystemButton.Brush2}" Width="7" Height="5" StrokeThickness="1"/>
                                        <Line X1="1" X2="6"  Y1="4" Y2="4" Stroke="{StaticResource Blue.SystemButton.Brush3}" StrokeThickness="1"/>
                                        <Line X1="0" X2="6"  Y1="8" Y2="8" Stroke="{StaticResource Blue.SystemButton.Brush3}" StrokeThickness="1"/>
                                    </Canvas>
                                </local:WindowTitleBarButton>
                                <local:WindowTitleBarButton x:Name="CloseButton" Command="Close" Width="25" Height="25" ToolTip="{Binding Source={StaticResource ResourceWrapperKey}, Path=CloseTooltip}"  Style="{StaticResource  {x:Type local:WindowTitleBarButton}}" >
                                    <Canvas Width="11" Height="10">
                                        <Path Data="M1,0.5L4,0.5 5,2.5 7,0.5 10,0.5" Stroke="{StaticResource Blue.SystemButton.Brush1}" StrokeThickness="1"/>
                                        <Path Data="M1,0L4,0 5,2 7,0 10,0 7,4 7,5 10,8 7,8 5,6 4,8 1,8 4,5 4,4z" Fill="{StaticResource Blue.SystemButton.Brush2}"  StrokeThickness="1"/>
                                        <Path Data="M0,8L4,8 5,6 7,8 11,8" Stroke="{StaticResource Blue.SystemButton.Brush3}" StrokeThickness="1"/>
                                    </Canvas>
                                </local:WindowTitleBarButton>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Normal">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True">
                            <Setter  Property="BorderBrush" Value="#FF526374"/>
                            
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Maximized">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Minimized">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=ResizeMode}" Value="NoResize">
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Collapsed"/>
                           
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=ResizeMode}" Value="CanMinimize">
                            <Setter TargetName="MaxButton" Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=ResizeMode}" Value="CanMinimize">
							<Setter TargetName="MaxButton" Property="IsEnabled" Value="False"/>
						</DataTrigger>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True">
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Normal" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_Title" Property="BitmapEffect">
                                <Setter.Value>
                                    <OuterGlowBitmapEffect GlowColor="#FFFFFFFF" GlowSize="14" Opacity="1"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="False" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowStyle}" Value="ToolWindow" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=MaximizedMode}" Value="KioskStyle" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Maximized" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowStyle}" Value="None" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="NormalButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>

                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                          <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowState}" Value="Maximized" />
                          <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowStyle}" Value="None" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Collapsed" TargetName="GlassActive"/>
                      </MultiDataTrigger>
                      <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                          <Setter Property="Height" Value="43" TargetName="GlassActive"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="False">
                <Setter Property="SysButtonsColumnWidth" Value="75"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=ResizeMode}" Value="NoResize">
                <Setter Property="SysButtonsColumnWidth" Value="26"/>
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="False" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowStyle}" Value="ToolWindow" />
                </MultiDataTrigger.Conditions>
                <Setter Property="SysButtonsColumnWidth" Value="26"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=ResizeMode}" Value="CanResize" />
                </MultiDataTrigger.Conditions>
                <Setter Property="SysButtonsColumnWidth" Value="90"/>
            </MultiDataTrigger>

          
          
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=ResizeMode}" Value="CanResizeWithGrip" />
                </MultiDataTrigger.Conditions>
                <Setter Property="SysButtonsColumnWidth" Value="94"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowStyle}" Value="ToolWindow" />
                </MultiDataTrigger.Conditions>
                <Setter Property="SysButtonsColumnWidth" Value="20"/>
            </MultiDataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=IsGlassActive}" Value="True" />
                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonWindow}},  Path=WindowStyle}" Value="None" />
                </MultiDataTrigger.Conditions>
                <Setter Property="SysButtonsColumnWidth" Value="0"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!--RibbonWindow style-->
    <Style x:Key="Office2007BlueRibbonWindowStyle" TargetType="{x:Type local:RibbonWindow}">
        <Setter Property="RibbonStatusBarStyle" Value="{StaticResource RibbonStatusBarKey}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="MinHeight" Value="150"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource Window.ActiveBorderBrush}"/>
        <Setter Property="Background" Value="{StaticResource Window.BackgroundBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonWindow}">
                    <AdornerDecorator x:Name="PART_Adorner">
                        <Grid>
                            <Border Name="PART_MainBorder"
						    Background="{TemplateBinding Background}"
						    BorderBrush="{TemplateBinding BorderBrush}"
						    BorderThickness="{TemplateBinding BorderThickness}"
						    CornerRadius="2"
						    Padding="{TemplateBinding Padding}">
                                <DockPanel HorizontalAlignment="Stretch" Background="{StaticResource Blue.AppMenu.Background}" VerticalAlignment="Stretch">
                                    <local:TitleBar x:Name="PART_TitleBar" Title="{TemplateBinding Title}"  DockPanel.Dock="Top" Style ="{StaticResource TitleBarStyleKey}"/>
                                    <Grid>
                                        <DockPanel>
                                            <ContentPresenter DockPanel.Dock="Bottom"
									Content="{TemplateBinding StatusBar}"/>

                                            <ContentPresenter DockPanel.Dock="Bottom"
									Content="{TemplateBinding Content}"/>
                                        </DockPanel>

                                        <Label x:Name="PART_ResizeGrip"
								HorizontalAlignment="Right"
								VerticalAlignment="Bottom"
								Visibility="Collapsed"
								IsTabStop="False"
								Cursor="SizeNWSE">
                                            <Grid SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                                                <Path Fill="{StaticResource Blue.ResizeGripperForegroundLight}"
										Data="M 9,1 L 11,1 L 11,3 L 9,3 Z M 5,5 L 7,5 L 7,7 L 5,7 Z M 9,5 L 11,5 L 11,7 L 9,7 Z M 1,9 L 3,9 L 3,11 L 1,11 Z M 5,9 L 7,9 L 7,11 L 5,11 Z M 9,9 L 11,9 L 11,11 L 9,11 Z"
										/>

                                                <Path Fill="{StaticResource Blue.ResizeGripperForegroundDark}" 
										Data="M 8,0 L 10,0 L 10,2 L 8,2 Z M 4,4 L 6,4 L 6,6 L 4,6 Z M 8,4 L 10,4 L 10,6 L 8,6 Z M 0,8 L 2,8 L 2,10 L 0,10 Z M 4,8 L 6,8 L 6,10 L 4,10 Z M 8,8 L 10,8 L 10,10 L 8,10 Z"
										 />
                                            </Grid>
                                        </Label>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="PART_TitleBar" Property="Background" Value="{StaticResource Blue.TitleBar.ActiveBackgroundBrush}"/>
                            <Setter TargetName="PART_TitleBar" Property="BorderBrush" Value="{StaticResource Blue.TitleBar.ActiveBorderBrush}"/>
                            <Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ResizeMode" Value="CanResizeWithGrip"/>
                                <Condition Property="WindowState" Value="Normal"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="MaximizedMode" Value="KioskStyle" />
                                <Condition Property="WindowState" Value="Maximized" />
                                <Condition Property="WindowStyle" Value="None" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
							<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsGlassActive" Value="True">				
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonWindow}">
                            <AdornerDecorator x:Name="PART_Adorner">
                                <Grid >
                                    
                                    <DockPanel HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Stretch">
                                        <local:TitleBar x:Name="PART_TitleBar" Title="{TemplateBinding Title}" DockPanel.Dock="Top" Style ="{StaticResource TitleBarStyleKey}"/>
                                       
                                            <Grid>
                                                <DockPanel>
                                                    <ContentPresenter DockPanel.Dock="Bottom"
									Content="{TemplateBinding StatusBar}"/>

                                                    <Border Name="PART_ContentBorder"
                                Background="{TemplateBinding Background}"
								  DockPanel.Dock="Bottom"
								  Margin="0,-1,0,0"
								  Padding="0,1,0,0"
								  BorderThickness="2,0,2,0"
								  BorderBrush="{StaticResource Window.BackgroundBrush}">
                                                        <ContentPresenter Content="{TemplateBinding Content}"/>
                                                    </Border>
                                                </DockPanel>

                                                <Label x:Name="PART_ResizeGrip"
								HorizontalAlignment="Right"
								VerticalAlignment="Bottom"
								Visibility="Collapsed"
								IsTabStop="False"
								Cursor="SizeNWSE">
                                                    <Grid SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                                                        <Path Fill="{StaticResource Blue.ResizeGripperForegroundLight}"
										Data="M 9,1 L 11,1 L 11,3 L 9,3 Z M 5,5 L 7,5 L 7,7 L 5,7 Z M 9,5 L 11,5 L 11,7 L 9,7 Z M 1,9 L 3,9 L 3,11 L 1,11 Z M 5,9 L 7,9 L 7,11 L 5,11 Z M 9,9 L 11,9 L 11,11 L 9,11 Z"
										/>

                                                        <Path Fill="{StaticResource Blue.ResizeGripperForegroundDark}" 
										Data="M 8,0 L 10,0 L 10,2 L 8,2 Z M 4,4 L 6,4 L 6,6 L 4,6 Z M 8,4 L 10,4 L 10,6 L 8,6 Z M 0,8 L 2,8 L 2,10 L 0,10 Z M 4,8 L 6,8 L 6,10 L 4,10 Z M 8,8 L 10,8 L 10,10 L 8,10 Z"
										 />
                                                    </Grid>
                                                </Label>
                                            </Grid>
                                      
                                    </DockPanel>
                                </Grid>
                            </AdornerDecorator>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsGlassActive" Value="True">
                                    <Setter TargetName="PART_TitleBar" Property="Background" Value="Transparent"/>
                                    <Setter TargetName="PART_TitleBar" Property="BorderThickness" Value="0"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="ResizeMode" Value="CanResizeWithGrip"/>
                                        <Condition Property="WindowState" Value="Normal"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible"/>
                                </MultiTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsGlassActive}"
                       Value="True" />
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=WindowState}"
                       Value="Maximized" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="PART_TitleBar" Property="Margin" Value="0,6,0,-8"/>
                                    <Setter TargetName="PART_ContentBorder" Property="Margin" Value="0,8,0,0"/>
                                </MultiDataTrigger>
                                <!--<MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="WindowState" Value="Maximized" />
                                        <Condition Property="WindowStyle" Value="None" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
                                </MultiTrigger>-->
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsGlassActive" Value="False">				
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonWindow}">
                            <AdornerDecorator x:Name="PART_Adorner">
                                <Grid>
                                    <Border Name="PART_MainBorder"
						    Background="{TemplateBinding Background}"
						    BorderBrush="{TemplateBinding BorderBrush}"
						    BorderThickness="{TemplateBinding BorderThickness}"
						    CornerRadius="4,4,0,0"
						    Padding="{TemplateBinding Padding}">
                                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <local:TitleBar x:Name="PART_TitleBar" Title="{TemplateBinding Title}" DockPanel.Dock="Top" Style ="{StaticResource TitleBarStyleKey}"/>
                                            <Grid >
                                               
                                                <DockPanel>
                                                    <ContentPresenter DockPanel.Dock="Bottom"
									Content="{TemplateBinding StatusBar}"/>

                                                    <ContentPresenter DockPanel.Dock="Bottom"
									Content="{TemplateBinding Content}"/>
                                                </DockPanel>

                                                <Label x:Name="PART_ResizeGrip"
								HorizontalAlignment="Right"
								VerticalAlignment="Bottom"
								Visibility="Collapsed"
								IsTabStop="False"
								Cursor="SizeNWSE">
                                                    <Grid SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                                                        <Path Fill="{StaticResource Blue.ResizeGripperForegroundLight}"
										Data="M 9,1 L 11,1 L 11,3 L 9,3 Z M 5,5 L 7,5 L 7,7 L 5,7 Z M 9,5 L 11,5 L 11,7 L 9,7 Z M 1,9 L 3,9 L 3,11 L 1,11 Z M 5,9 L 7,9 L 7,11 L 5,11 Z M 9,9 L 11,9 L 11,11 L 9,11 Z"
										/>

                                                        <Path Fill="{StaticResource Blue.ResizeGripperForegroundDark}" 
										Data="M 8,0 L 10,0 L 10,2 L 8,2 Z M 4,4 L 6,4 L 6,6 L 4,6 Z M 8,4 L 10,4 L 10,6 L 8,6 Z M 0,8 L 2,8 L 2,10 L 0,10 Z M 4,8 L 6,8 L 6,10 L 4,10 Z M 8,8 L 10,8 L 10,10 L 8,10 Z"
										 />
                                                    </Grid>
                                                </Label>
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </AdornerDecorator>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsActive" Value="True">
                                    <Setter TargetName="PART_TitleBar" Property="Background" Value="{StaticResource Blue.TitleBar.ActiveBackgroundBrush}"/>
                                    <Setter TargetName="PART_TitleBar" Property="BorderBrush" Value="{StaticResource Blue.TitleBar.ActiveBorderBrush}"/>
                                    <Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{Binding Path=BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:RibbonWindow}}}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="ResizeMode" Value="CanResizeWithGrip"/>
                                        <Condition Property="WindowState" Value="Normal"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="MaximizedMode" Value="KioskStyle" />
                                        <Condition Property="WindowState" Value="Maximized" />
                                        <Condition Property="WindowStyle" Value="None" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
									<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                                </MultiTrigger>
								<Trigger Property="WindowState" Value="Maximized">
                                    
                                <Setter Property="Margin" TargetName="PART_MainBorder">
                                        <Setter.Value>
                                            <Thickness Top="4" 
											Bottom="{x:Static  SystemParameters.ResizeFrameHorizontalBorderHeight}" 
											Left="{x:Static  SystemParameters.ResizeFrameVerticalBorderWidth}" 
											Right="{x:Static  SystemParameters.ResizeFrameVerticalBorderWidth}"/>
                                        </Setter.Value>
                                    </Setter>
                                
                                </Trigger>
                                <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                                    <Setter Property="Margin" Value="7,4,7,8" TargetName="PART_MainBorder"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlueRibbonWindowStyle}" TargetType="{x:Type local:RibbonWindow}"/>

    <LinearGradientBrush   x:Key="ScreenTipBackground"  EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFEFEFF" Offset="0.014"/>
        <GradientStop Color="#FFCBDBF0" Offset="0.986"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ScreenTipBorderBrush" Color="#FF767676"/>
    <!--ScreenTip Style-->
    <Style x:Key="Office2007BlueScreenTipStyle" TargetType="{x:Type local:ScreenTip}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource ScreenTipBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource ScreenTipBackground}" />
        <Setter Property="Padding" Value="1,1,3,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ScreenTip}">
                    <Microsoft_Windows_Themes:SystemDropShadowChrome Name="Shdw" Color="Transparent" SnapsToDevicePixels="true">
                        <Border MinHeight="20"
								CornerRadius="2"
								Background="{TemplateBinding Background}"
								BorderThickness="{TemplateBinding BorderThickness}"
								BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.5*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition  />
                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontSize="12" FontWeight="Bold" FontFamily="Calibri"  Margin="4,4,1,4" Foreground="#FF4C4C4C"
										 Text="{TemplateBinding Description}" Name="Desc" />
                                <StackPanel Orientation="Horizontal" Grid.Row="1">
                                    <Border  Margin="6" Name="Image" VerticalAlignment="Center">
                                        <Image  Source="{Binding Path=ImageSource, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Border>
                                    <ContentPresenter Margin="2,1,4,6" Grid.Row="1"  Name="Text" 
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" TextBlock.Foreground="#FF4C4C4C"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </StackPanel>
                                <Border Name="PART_Seperator" Margin="4,1,4,0" Background="#FF9EBBDD" BorderBrush="White" BorderThickness="0,0,0,1"  Grid.Row="2" Height="2" SnapsToDevicePixels="True"  Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Stretch" />
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition  />
                                    </Grid.ColumnDefinitions>
                                    <Border  HorizontalAlignment="Left"   Grid.Column="0" Margin="4,4,0,4" x:Name="HelpImage">
                                        <Image Height="16" x:Name="helpImage" Width="16"  Source="{Binding Path=HelpIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Border>
                                    <TextBlock HorizontalAlignment="Left"  Name="PART_HelpText" Text="{TemplateBinding HelpText}"  Grid.ColumnSpan="2" Grid.Column="0"
                                               FontSize="12" FontWeight="Bold" FontFamily="Calibri"  Margin="28,4,1,4" Foreground="#FF4C4C4C" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Microsoft_Windows_Themes:SystemDropShadowChrome>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="true">
                            <Setter TargetName="Shdw" Property="Margin" Value="0,0,5,5" />
                            <Setter TargetName="Shdw" Property="Color" Value="#71000000" />
                        </Trigger>
                        <Trigger Property="HelpIcon" Value="{x:Null}" >
                            <Setter TargetName="helpImage" Property="Source" Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/HelpSmall.png" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Text" Property="Margin" Value="4,1,4,1" />
                        </Trigger>
                        <Trigger Property="HelpText" Value="">

                            <Setter TargetName="HelpImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Seperator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_HelpText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2007BlueScreenTipStyle}" TargetType="{x:Type local:ScreenTip}"/>

    <!--TabButton Style-->
    <Style x:Key="Office2007BlueTabButtonStyle" TargetType="{x:Type local:TabButton}">
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="Background" Value="{StaticResource TabBackground.Default}"/>
        <Setter Property="Foreground" Value="{StaticResource Blue.Foreground2}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabButton}">
                    <Border Height="23" 
                  Background="Transparent">

                        <Grid  ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="7"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Path Fill="{TemplateBinding BorderBrush}" Name="left_path" Grid.Column="0">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="0,30">
                                            <LineSegment Point="0,21.5" />
                                            <ArcSegment Point="2,19" Size="2,2" RotationAngle="0" SweepDirection="Counterclockwise"/>
                                            <LineSegment Point="2,5" />
                                            <ArcSegment Point="7,0" Size="5,5" RotationAngle="0" SweepDirection="Clockwise"/>
                                            <LineSegment Point="7,30" />
                                            <LineSegment Point="0,30" />
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <Path Name="PART_leftPath"  Fill="{TemplateBinding Background}" Grid.Column="0">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="0,23">
                                            <ArcSegment Point="3,21" Size="3,3" RotationAngle="0" SweepDirection="Counterclockwise"/>
                                            <LineSegment Point="3,5" />
                                            <ArcSegment Point="7,1" Size="4,4" RotationAngle="0" SweepDirection="Clockwise"/>
                                            <LineSegment Point="7,23" />
                                            <LineSegment Point="0,23" />
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>

                            <Border Name="PART_highlightBorder"
                      Grid.Column="1"
                      Panel.ZIndex="200"
                      Margin="-5.7,-3.5,-5.7,0"
                      BorderThickness="2,2,2,0"
                      CornerRadius="4,4,0,0"
                      Height="20"
                      Opacity="0.75"/>

                            <Border Name="PART_highlightContour" Grid.Column="1"/>

                            <Border Panel.ZIndex="100"
                      Height="22.83" Name="center_Path"
