                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

	<Style BasedOn="{StaticResource Office2007BlueApplicationMenuStyle}" TargetType="{x:Type local:ApplicationMenu}"/>
	
    <!--DropDownButton style for QuickAccessToolBar-->
    <Style x:Key="QuickAccessPopupButtonStyle" TargetType="{x:Type local:DropDownButton}">
        <Setter  Property="OverridesDefaultStyle"     Value="true"/>
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter  Property="IsTabStop" Value="false"/>
        <Setter  Property="ButtonBase.ClickMode">
            <Setter.Value>
                <x:Static
            Member="ClickMode.Press" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DropDownButton}">
                    <Border Name="PART_ToggleButton" 
           BorderThickness="{TemplateBinding BorderThickness}"
           BorderBrush="{TemplateBinding BorderBrush}" 
           Background="{TemplateBinding Panel.Background}"
           Width="13" 
           Height="{TemplateBinding Height}" 
           CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}">
                        <Grid>
                            <Path 
                    Stroke="{StaticResource Blue.Foreground2}" 
                    Fill="{StaticResource Blue.Foreground2}"              
                    StrokeThickness="1"
                    Data="{TemplateBinding PathGeometry}"/>
                            <Popup Name="PART_Popup"  
                Placement="Bottom"                  
                Focusable="False"                       
                PopupAnimation="Fade"
                AllowsTransparency="True"     
                StaysOpen="False"
                IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:DropDownButton}}}">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="PART_Shadow" Margin="0" SnapsToDevicePixels="true">
                                    <Border Background="{StaticResource Default.QuickDropDownBackground}" CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}" >
                                            <ItemsPresenter/>
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Default.QuickHoverDropDownBorder}"/>
                <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
            </Trigger>

            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter Property="Background" Value="{StaticResource Luna.PressedBrush.Default}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Default.QuickDropDownBorder}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--RibbonButtonPopupItemStyle-->
    <Style x:Key="RibbonButtonPopupItemStyle" TargetType="{x:Type local:RibbonButton}">
        <Setter  Property="OverridesDefaultStyle"     Value="true"/>
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="Foreground"                 Value="{StaticResource Blue.Foreground}"/>
        <!--<Setter Property="Height"                     Value="23"/>-->
        <Setter Property="BorderThickness"            Value="1"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonButton}">
                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}" 
                  Background="{TemplateBinding Panel.Background}"
                  Width="{TemplateBinding Width}"
                  Height="{TemplateBinding Height}"
                  MinWidth="{TemplateBinding MinWidth}"
                  MaxWidth="{TemplateBinding MaxWidth}"
                  MinHeight="{TemplateBinding MinHeight}"
                  MaxHeight="{TemplateBinding MaxHeight}" 
                  Margin="{TemplateBinding Margin}" 
                  SnapsToDevicePixels="True"
                  >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="21"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Name="PART_CheckBorder" Grid.Column="0" Visibility="Collapsed" 
                      Width="21" Height="21" BorderThickness="1" BorderBrush="{StaticResource Default.QuickCheckedButtonBorderBrush}"  
                      Background="{StaticResource Default.QuickCheckedButtonBackgroundBrush}" CornerRadius="{StaticResource Default.QuickDropDownCornerRadius}"
                      >
                                <Path Stroke="{StaticResource Blue.Foreground}" StrokeThickness="1.4">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="6 9" EndPoint="9 16"/>
                                            <LineGeometry StartPoint="9 16" EndPoint="13 3"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Border>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Name="label"  Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_CheckBorder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
                        </Trigger>
                        <Trigger Property="shared:SkinStorage.EnableTouch" Value="True">
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Padding" Value="16,9,16,9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Default.QuickDropDownButtonHoverBorder}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <ContentControl x:Key="Path">
        <ContentControl.Style>
            <Style>
                <Setter Property="Control.OverridesDefaultStyle"  Value="True"/>
                <Setter Property="Control.HorizontalAlignment" Value="Center"/>
                <Setter Property="Control.VerticalAlignment" Value="Top"/>
                <Setter Property="Control.Height" Value="14"/>
                <Setter Property="Control.Margin" Value="0,-1,0,0"/>
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border>
                                <Path Data="M0,0L3.5,4 7,0z" Margin="0,6,0,0"  HorizontalAlignment="Center" Fill="{StaticResource Blue.Path.Fill}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ContentControl.Style>
    </ContentControl>

    <!--DropDownButton style for RibbonBar-->
    <Style x:Key="RibbonDropDownToggleButton" TargetType="{x:Type local:DropDownButton}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Blue.Foreground}"/>
        <Setter Property="Background" Value="{StaticResource Blue.DropDownButton.BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue.DropDownButton.BackgroundBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DropDownButton}">
                    <Border Name="PART_ToggleButton"
              CornerRadius="2"
              BorderThickness="{TemplateBinding BorderThickness}"
              BorderBrush="{TemplateBinding BorderBrush}"
              Background="{TemplateBinding Background}" >

                        <DockPanel Margin="1,4,1,1"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Top">

                            <Border DockPanel.Dock="Top"
						  Name="PART_ImageBorder"
						  CornerRadius="3"
						  BorderThickness="1"
						  BorderBrush="{StaticResource Blue.ImageBorder.BorderBrush}"
						  Background="{StaticResource Blue.ImageBorder.BackgroundBrush}"
						  HorizontalAlignment="Center" >

                                <Grid MinWidth="31" MinHeight="31">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="7"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Row="0"  Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
								 Width="16" Height="16" />
                                    <Border Grid.Row="1" Background="{StaticResource Blue.ImageBorder.BackgroundBottom}"/>
                                </Grid>
                            </Border>

                            <local:CustomItemsControl Focusable="False" Margin="3,1,3,1" DockPanel.Dock="Bottom" Path="{StaticResource Path}" ItemsSource="{Binding Path=Label, Mode=OneWay, Converter={StaticResource TextWrappingConverter}, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:MultilinePanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </local:CustomItemsControl>

                            <Popup Name="PART_Popup"
						 HorizontalAlignment="Center"
						 VerticalAlignment="Center"
						 Placement="Bottom"
						 PlacementTarget="{Binding ElementName=PART_ToggleButton}"
						 Focusable="False"
						 AllowsTransparency="True"
						 StaysOpen="False"
						 IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource AncestorType={x:Type local:DropDownButton}}}"
						 PopupAnimation="Fade">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome  Name="PART_Shadow" Margin="0" SnapsToDevicePixels="true">
                                        <ItemsPresenter/>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,4,4"/>
                        </Trigger>
						
						<DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CollapseImage}" Value="{x:Null}">                            
                            <Setter TargetName="PART_ImageBorder" Property="Opacity" Value="0"/>
                        </DataTrigger> 

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
                         Value="True">
                            <Setter TargetName="PART_ImageBorder" Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
                         Value="False"/>
                                <Condition Binding="{Binding ElementName=PART_ToggleButton, Path=IsMouseOver}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_ToggleButton" Property="Background" Value="{StaticResource Blue.DropDownButton.BackgroundHoverBrush}"/>
                            <Setter TargetName="PART_ImageBorder" Property="Background" Value="{StaticResource Blue.ImageBorder.BackgroundHover}"/>
                            <Setter TargetName="PART_ToggleButton" Property="BorderBrush" Value="{StaticResource Blue.ImageBorder.BackgroundHover}"/>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},
                           Path=SelectedTabItem.HasContextTabGroup}"
                           Value="False"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self},  Path=IsDropDownOpen}"
                           Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_ImageBorder" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="PART_ImageBorder" Property="Background" Value="{StaticResource Blue.ImageBorder.BackgroundChecked}"/>
                            <Setter TargetName="PART_ToggleButton" Property="BorderBrush" Value="{StaticResource Blue.ImageBorder.BackgroundChecked}"/>
                            <Setter TargetName="PART_ToggleButton" Property="Background" Value="{StaticResource Blue.DropDownButton.BackgroundHoverSelected}"/>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},
                           Path=SelectedTabItem.HasContextTabGroup}"
                           Value="True"/>
                                <Condition Binding="{Binding ElementName=PART_ToggleButton, Path=IsMouseOver}" 
                           Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_ToggleButton" Property="BorderBrush" Value="{StaticResource RibbonBarButton.Context.Hover.BorderBrush}"/>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},
                           Path=SelectedTabItem.HasContextTabGroup}"
                           Value="True"/>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self},  Path=IsDropDownOpen}"
                           Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_ToggleButton" Property="Background" Value="{StaticResource RibbonBarButton.Context.IsDropDownOpen.BackgroundBrush}"/>
                            <Setter TargetName="PART_ToggleButton" Property="BorderBrush" Value="{StaticResource RibbonBarButton.Context.IsDropDownOpen.BorderBrush}"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=SelectedTabItem.HasContextTabGroup}"
                   Value="True">
                <Setter Property="Background" Value="{StaticResource RibbonBarButton.Context.BackgroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--RibbonBarLauncherButton style-->
    <Style x:Key="RibbonBarLauncherButton" TargetType="{x:Type local:RibbonButton}">
        <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
        <Setter Property="CornerRadius" Value="0,0,1,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#5D41A0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonButton}">
                    <Border VerticalAlignment="Center" 
            HorizontalAlignment="Center"
			CornerRadius="{TemplateBinding CornerRadius}"
			BorderThickness="{TemplateBinding BorderThickness}"
			BorderBrush="{TemplateBinding BorderBrush}"
			Background="{TemplateBinding Background}"
			SnapsToDevicePixels="True" Name="Background"
			Width="{TemplateBinding Width}"
			Height="{TemplateBinding Height}">
                        <Border x:Name="PART_InnerBorder" 
              Width="13" 
              Height="12"
			  VerticalAlignment="Center" 
              HorizontalAlignment="Center"
		      CornerRadius="{TemplateBinding CornerRadius}"
			  BorderThickness="{TemplateBinding BorderThickness}"
			  BorderBrush="{TemplateBinding BorderBrush}"
			  Background="{TemplateBinding Background}" 
              SnapsToDevicePixels="True">
                            <Canvas Margin="1,0,0,0" Width="8" Height="8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Path Stroke="{StaticResource Blue.Path.Fill}">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0.5,0" EndPoint="0.5,6"/>
                                            <LineGeometry StartPoint="0,0.5" EndPoint="6,0.5"/>
                                            <LineGeometry StartPoint="3,3.5" EndPoint="4,3.5"/>
                                            <LineGeometry StartPoint="4,4.5" EndPoint="6,4.5"/>
                                            <LineGeometry StartPoint="4,5.5" EndPoint="6,5.5"/>
                                            <LineGeometry StartPoint="3,6.5" EndPoint="7,6.5"/>
                                            <LineGeometry StartPoint="6.5,3" EndPoint="6.5,7"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                                <Path x:Name="PART_WhitePath" Stroke="{StaticResource Blue.TextBoxBackgroundHover}">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="1.5,1" EndPoint="1.5,6"/>
                                            <LineGeometry StartPoint="1,1.5" EndPoint="6,1.5"/>
                                            <LineGeometry StartPoint="4,3.5" EndPoint="5,3.5"/>
                                            <LineGeometry StartPoint="4,7.5" EndPoint="8,7.5"/>
                                            <LineGeometry StartPoint="7.5,3" EndPoint="7.5,8"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_InnerBorder" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="PART_InnerBorder" Property="BorderBrush" Value="White"/>
                            <Setter TargetName="PART_InnerBorder" Property="Opacity" Value="0.8"/>
                            <Setter TargetName="PART_WhitePath" Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_InnerBorder" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="PART_InnerBorder" Property="BorderBrush" Value="White"/>
                            <Setter TargetName="PART_WhitePath" Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource Blue.ToggleButton.IsMouseOverBorderBrush}"/>
                            <Setter TargetName="Background" Property="Background" Value="{StaticResource Luna.MouseOverBrush.Default}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource Blue.ToggleButton.IsCheckedBorder}"/>
                            <Setter TargetName="Background" Property="Background" Value="{StaticResource Blue.LauncharPressedBrush}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--RibbonBar style-->
    <Style x:Key="Office2007BlueRibbonBarStyle" TargetType="{x:Type local:RibbonBar}">
	  <!-- <Setter Property="CollapseImage" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},  Path=RibbonBarCollapseImage}"/> -->
        <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonBar}">
                    <Border Background="{TemplateBinding Background}" 
            CornerRadius="3,3,3,3"
					  BorderBrush="{TemplateBinding BorderBrush}"
					  BorderThickness="{TemplateBinding BorderThickness}">
