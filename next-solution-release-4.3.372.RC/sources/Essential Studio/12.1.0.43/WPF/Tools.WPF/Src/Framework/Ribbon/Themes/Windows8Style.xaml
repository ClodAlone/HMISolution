                                              Data="M0,0 L100.25,0 100.25,20 80,20 80,39.75 60.5,39.75 60.5,60 39.75,60 39.75,39.75 20.75,39.75 20.75,20 0,20 z"
                                              Fill="#FF000000"
                                              Stretch="Fill" />
                                <Rectangle x:Name="path1_Copy"
