    <Style x:Key="RibbonToggleButtonStyle" TargetType="{x:Type local:RibbonToggleButton}">
        <Setter Property="Height" Value="24" />
        <Setter Property="Width" Value="22" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonToggleButton}">
                    <Border x:Name="border"
                                    Width="22"
                                    Height="23"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="White"
                                    BorderBrush="White"
                                    BorderThickness="1">
                        <Border x:Name="border1" BorderThickness="1">
                            <Path x:Name="path"
                                          Width="7"
                                          Height="6"
                                          Margin="0,0,0,1"
                                          Data="M18,0 L24,0 L24,6 L30,6 L30,12 L36,12 L36,18 L41.999996,18 L41.999996,29 L42,36 L36,36 L36,30 L29.999996,30 L29.999996,24 L24,24 L24,18 L18,18 L18,24 L12,24 L12,30 L6,30 L6,36 L0,36 L0,30 L0,29 L0,18 L6,18 L6,12 L12,12 L12,6 L18,6 z"
                                          Fill="#FF777777"
                                          Stretch="Fill" />
                        </Border>

                    </Border>
                    <ControlTemplate.Triggers>


                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Ribbon}}, Path=RibbonState}" Value="Hide">
                            <Setter TargetName="path" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="path" Property="RenderTransformOrigin" Value="0.5,0.5" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Ribbon}}, Path=RibbonState}" Value="Adorner">

