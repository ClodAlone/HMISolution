        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RibbonWindow}">
                    <AdornerDecorator x:Name="PART_Adorner" Margin="0,-30,0,0">
                        <Grid>

                            <DockPanel HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               Background="Transparent">
                                <local:TitleBar x:Name="PART_TitleBar"
                                                        Title="{TemplateBinding Title}"
                                                        DockPanel.Dock="Top"
                                                        Style="{StaticResource Windows8TitleBarStyle}" />
                                <Border x:Name="PART_ContentBorder"
                                                BorderBrush="#FF5B93D1"
                                                BorderThickness="1"
                                                Padding="0,1,0,0">

                                    <Grid x:Name="PART_Grid">
                                        <DockPanel>
                                            <ContentPresenter Content="{TemplateBinding StatusBar}" DockPanel.Dock="Bottom" />

                                            <ContentPresenter Content="{TemplateBinding Content}" />

                                        </DockPanel>

                                        <Label x:Name="PART_ResizeGrip"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       Cursor="SizeNWSE"
                                                       IsTabStop="False"
                                                       Visibility="Collapsed">
                                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                <Path Data="M 9,1 L 11,1 L 11,3 L 9,3 Z M 5,5 L 7,5 L 7,7 L 5,7 Z M 9,5 L 11,5 L 11,7 L 9,7 Z M 1,9 L 3,9 L 3,11 L 1,11 Z M 5,9 L 7,9 L 7,11 L 5,11 Z M 9,9 L 11,9 L 11,11 L 9,11 Z" Fill="{StaticResource Blue.ResizeGripperForegroundLight}" />

                                                <Path Data="M 8,0 L 10,0 L 10,2 L 8,2 Z M 4,4 L 6,4 L 6,6 L 4,6 Z M 8,4 L 10,4 L 10,6 L 8,6 Z M 0,8 L 2,8 L 2,10 L 0,10 Z M 4,8 L 6,8 L 6,10 L 4,10 Z M 8,8 L 10,8 L 10,10 L 8,10 Z" Fill="{StaticResource Blue.ResizeGripperForegroundDark}" />
                                            </Grid>
                                        </Label>
                                    </Grid>
                                </Border>

                            </DockPanel>
                        </Grid>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_Grid" Property="Margin" Value="0,-1,0,0" />
                            <Setter TargetName="PART_ContentBorder" Property="Padding" Value="0" />
                        </Trigger>
                        <Trigger Property="IsActive" Value="False">

                            <Setter TargetName="PART_ContentBorder" Property="BorderBrush" Value="#FFDADADA" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ResizeMode" Value="CanResizeWithGrip" />
                                <Condition Property="WindowState" Value="Normal" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsGlassActive}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=WindowState}" Value="Maximized" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_TitleBar" Property="Margin" Value="0,6,0,-4" />
                            <Setter TargetName="PART_ContentBorder" Property="Margin" Value="0,-1,0,0" />
                        </MultiDataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ResizeMode" Value="CanResizeWithGrip" />
                                <Condition Property="WindowState" Value="Normal" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="MaximizedMode" Value="KioskStyle" />
                                <Condition Property="WindowState" Value="Maximized" />
                                <Condition Property="WindowStyle" Value="None" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
							<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsGlassActive" Value="False">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonWindow}">
                            <AdornerDecorator x:Name="PART_Adorner">
                                <Grid>
                                    <Border Name="PART_MainBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4,4,0,0"
                                                    Padding="{TemplateBinding Padding}">
                                        <Border BorderThickness="1" CornerRadius="4,4,0,0">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0.206,-0.209" EndPoint="0.825,1.242">
                                                    <GradientStop Offset="0.492" Color="#FF7CD0EE" />
                                                    <GradientStop Offset="1" Color="#FF7CD0EE" />
                                                    <GradientStop Color="White" />
                                                    <GradientStop Offset="0.48" Color="White" />
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <Border>
                                                <Border.Margin>
                                                    <Thickness Bottom="{x:Static SystemParameters.ResizeFrameHorizontalBorderHeight}"
                                                                       Left="{x:Static SystemParameters.ResizeFrameVerticalBorderWidth}"
                                                                       Right="{x:Static SystemParameters.ResizeFrameVerticalBorderWidth}"
                                                                       Top="0" />
                                                </Border.Margin>

                                                <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <local:TitleBar x:Name="PART_TitleBar"
                                                                            Title="{TemplateBinding Title}"
                                                                            DockPanel.Dock="Top"
                                                                            Style="{StaticResource Windows8TitleBarStyle}" />
                                                    <Border x:Name="PART_ContentBorder1"
                                                                    BorderBrush="#FFB9D1EA"
                                                                    BorderThickness="1,2,1,1">
                                                        <Grid>

                                                            <DockPanel>
                                                                <ContentPresenter Content="{TemplateBinding StatusBar}" DockPanel.Dock="Bottom" />

                                                                <ContentPresenter Content="{TemplateBinding Content}" DockPanel.Dock="Bottom" />
                                                            </DockPanel>

                                                            <Label x:Name="PART_ResizeGrip"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Bottom"
                                                                           Cursor="SizeNWSE"
                                                                           IsTabStop="False"
                                                                           Visibility="Collapsed">
                                                                <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                                    <Path Data="M 9,1 L 11,1 L 11,3 L 9,3 Z M 5,5 L 7,5 L 7,7 L 5,7 Z M 9,5 L 11,5 L 11,7 L 9,7 Z M 1,9 L 3,9 L 3,11 L 1,11 Z M 5,9 L 7,9 L 7,11 L 5,11 Z M 9,9 L 11,9 L 11,11 L 9,11 Z" Fill="{StaticResource Blue.ResizeGripperForegroundLight}" />

                                                                    <Path Data="M 8,0 L 10,0 L 10,2 L 8,2 Z M 4,4 L 6,4 L 6,6 L 4,6 Z M 8,4 L 10,4 L 10,6 L 8,6 Z M 0,8 L 2,8 L 2,10 L 0,10 Z M 4,8 L 6,8 L 6,10 L 4,10 Z M 8,8 L 10,8 L 10,10 L 8,10 Z" Fill="{StaticResource Blue.ResizeGripperForegroundDark}" />
                                                                </Grid>
                                                            </Label>
                                                        </Grid>
                                                    </Border>
                                                </DockPanel>
                                            </Border>
                                        </Border>
                                    </Border>
                                </Grid>
                            </AdornerDecorator>
                            <ControlTemplate.Triggers>

                                <Trigger Property="IsActive" Value="False">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Offset="0.004" Color="#FFC2D0DE" />
                                                <GradientStop Offset="0.049" Color="#FFD7E4F2" />
                                                <GradientStop Offset="0.998" Color="#FFD7E4F2" />
                                                <GradientStop Offset="1" Color="#FFE9ECF3" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="PART_ContentBorder1" Property="BorderBrush" Value="#FFDADADA" />

                                </Trigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="ResizeMode" Value="CanResizeWithGrip" />
                                        <Condition Property="WindowState" Value="Normal" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="MaximizedMode" Value="KioskStyle" />
                                        <Condition Property="WindowState" Value="Maximized" />
                                        <Condition Property="WindowStyle" Value="None" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
									<Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                                </MultiTrigger>
                                <Trigger Property="WindowState" Value="Maximized">
                                    <Setter Property="Margin" Value="0,-4,0,0" TargetName="PART_TitleBar"/>
                                    <Setter TargetName="PART_MainBorder" Property="Margin">
                                        <Setter.Value>
                                            <Thickness Bottom="{x:Static SystemParameters.ResizeFrameHorizontalBorderHeight}"
                                                               Left="{x:Static SystemParameters.ResizeFrameVerticalBorderWidth}"
                                                               Right="{x:Static SystemParameters.ResizeFrameVerticalBorderWidth}"
                                                               Top="4" />
                                        </Setter.Value>
                                    </Setter>

                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource Windows8RibbonWindowStyle}" TargetType="{x:Type local:RibbonWindow}" />


    <LinearGradientBrush x:Key="Windows8ScreenTipBackground" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0.043" Color="#FFFEFEFE" />
        <GradientStop Offset="0.948" Color="#FFE6EDF7" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Windows8ScreenTipBorderBrush" Color="#FF767676" />
    <SolidColorBrush x:Key="Windows8ScreentipForeground" Color="#FF4A4C4F" />
    <!--  ScreenTip Style  -->
    <Style x:Key="Windows8ScreenTipStyle" TargetType="{x:Type local:ScreenTip}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Windows8ScreenTipBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource Windows8ScreenTipBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Windows8ScreentipForeground}" />
        <Setter Property="Padding" Value="1,1,3,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ScreenTip}">
                    <Microsoft_Windows_Themes:SystemDropShadowChrome Name="Shdw"
                                                                             SnapsToDevicePixels="true"
                                                                             Color="Transparent">
                        <Border MinHeight="20"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.5*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>

                                <TextBlock Name="Desc"
                                                   Grid.Row="0"
                                                   Grid.ColumnSpan="2"
                                                   Margin="4,4,1,4"
                                                   FontFamily="Calibri"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource Windows8ScreentipForeground}"
                                                   Text="{TemplateBinding Description}" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <Border Name="Image"
                                                    Margin="6"
                                                    VerticalAlignment="Center">
                                        <Image Source="{Binding Path=ImageSource, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Border>
                                    <ContentPresenter Name="Text"
                                                              Grid.Row="1"
                                                              Margin="2,1,4,6"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                              TextBlock.Foreground="#FF4C4C4C" />
                                </StackPanel>
                                <Border Name="PART_Seperator"
                                                Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                                Height="1"
                                                Margin="4,1,4,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                Background="{StaticResource Windows8RibbonBarSeparatorBrush}"
                                                BorderBrush="{StaticResource Windows8RibbonBarSeparatorBrush}"
                                                BorderThickness="0,0,0,1"
                                                SnapsToDevicePixels="True" />
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="HelpImage"
                                                    Grid.Column="0"
                                                    Margin="4,4,0,4"
                                                    HorizontalAlignment="Left">
                                        <Image x:Name="helpImage"
                                                       Width="16"
                                                       Height="16"
                                                       Source="{Binding Path=HelpIcon,
                                                                        Mode=OneWay,
                                                                        RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Border>
                                    <TextBlock Name="PART_HelpText"
                                                       Grid.Column="0"
                                                       Grid.ColumnSpan="2"
                                                       Margin="28,4,1,4"
                                                       HorizontalAlignment="Left"
                                                       FontFamily="Calibri"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource Windows8ScreentipForeground}"
                                                       Text="{TemplateBinding HelpText}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Microsoft_Windows_Themes:SystemDropShadowChrome>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="true">
                            <Setter TargetName="Shdw" Property="Margin" Value="0,0,5,5" />
                            <Setter TargetName="Shdw" Property="Color" Value="#71000000" />
                        </Trigger>
                        <Trigger Property="HelpIcon" Value="{x:Null}">
                            <Setter TargetName="helpImage" Property="Source" Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/HelpSmall.png" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Text" Property="Margin" Value="4,1,4,1" />
                        </Trigger>
                        <Trigger Property="HelpText" Value="">

                            <Setter TargetName="HelpImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Seperator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_HelpText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Windows8ScreenTipStyle}" TargetType="{x:Type local:ScreenTip}" />

    <SolidColorBrush x:Key="Windows8RibbonTabItemForeground" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="Windows8TabItemSelectedBackground" Color="#FFF5F6F7" />
    <SolidColorBrush x:Key="Windows8TabItemSelectedBorderBrush" Color="#FFDADBDC" />
    <SolidColorBrush x:Key="windows8tabItemHoverBrush" Color="#FFFDFDFF" />
    <SolidColorBrush x:Key="Windows8TabItemHoverBorderBrush" Color="#FFEBECEC" />
    <!--  TabButton Style  -->
    <Style x:Key="Windows8TabButtonStyle" TargetType="{x:Type local:TabButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Windows8RibbonTabItemForeground}" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabButton}">

                    <Grid MinHeight="23" Margin="1,0,1,0">





                        <Border Name="center_Path"
                                        Grid.Column="1"
                                        Margin="-1,0,-1,0"
                                        Panel.ZIndex="100"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1,1,1,0">

                            <shared:TrippleBorder>
                                <Grid>
                                    <ContentPresenter x:Name="PART_CaptionContent"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},
                                                                                        Path=ItemTemplate}"
                                                              ContentTemplateSelector="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},
                                                                                                Path=ItemTemplateSelector}" />
                                    <TextBlock Name="PART_Caption"
                                                       VerticalAlignment="Center"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       Text="{TemplateBinding Caption}"
                                                       TextAlignment="Center" />
                                </Grid>
                            </shared:TrippleBorder>
                        </Border>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=HasContextTabGroup}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=ContextColor, Converter={StaticResource colorToBrushConverter}}" />
                            <Setter TargetName="center_Path" Property="Margin" Value="-1,0,-1,-1" />
                            <Setter Property="Background" Value="White" />
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=HasContextTabGroup}" Value="False" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource Windows8TabItemSelectedBackground}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Windows8TabItemSelectedBorderBrush}" />
                            <Setter TargetName="center_Path" Property="Margin" Value="-1,0,-1,-1" />
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=HasContextTabGroup}" Value="False" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="false" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>

                            <Setter Property="Background" Value="{StaticResource windows8tabItemHoverBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Windows8TabItemHoverBorderBrush}" />
                        </MultiDataTrigger>


                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=HasContextTabGroup}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>

                            <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=ContextColor, Converter={StaticResource colorToBrushConverter}}" />


                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=HasContextTabGroup}" Value="False" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="true                                                    " />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource Windows8TabItemSelectedBackground}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Windows8TabItemSelectedBorderBrush}" />
                            <Setter TargetName="center_Path" Property="Margin" Value="-1,0,-1,-1" />

                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=HasContextTabGroup}" Value="False" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="False" />
                            </MultiDataTrigger.Conditions>


                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=HasContextTabGroup}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />

                            </MultiDataTrigger.Conditions>


                            <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RibbonTab}}, Path=ContextColor, Converter={StaticResource colorToBrushConverter}}" />

                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource Windows8TabButtonStyle}" TargetType="{x:Type local:TabButton}" />

    <!--  QuickAccessToolBar style  -->
    <Style x:Key="Windows8QuickAccessToolBarStyle" TargetType="{x:Type local:QuickAccessToolBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HasGeometry" Value="False"/>
        <Setter Property="Control.Foreground" Value="{StaticResource Windows8RibbonButtonForeground}" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinWidth" Value="94"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:QuickAccessToolBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Rectangle Grid.Column="0"
                                           Width="3"
                                           Height="15"
                                           Margin="4,0,0,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Fill="#FF52779F"
                                           RadiusX="1"
                                           RadiusY="1"
                                           SnapsToDevicePixels="True"
                                           Stroke="#FF98C5F8"
                                           Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},
                                                                Path=IsQATBelow,
                                                                Converter={StaticResource BooleanToVisibilityConvertor}}" />
                        <Border Grid.Column="1"
                                        Width="{TemplateBinding Width}"
                                        Height="{TemplateBinding Height}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                            <local:TwoItemsLayoutPanelEx Name="PART_PanelEx" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                                 MaxRightWidth="30"
                                                                 MinRightWidth="30">
                                <ItemsControl Name="PART_Main"
                                                      Grid.Column="0"
                                                      Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <local:QuickAccessToolBarPanel HasGeometry="{Binding Path=HasGeometry, Mode=TwoWay, RelativeSource={RelativeSource  AncestorType={x:Type local:QuickAccessToolBar}}}" HorizontalAlignment="Left"
                                                                                   Background="Transparent"
                                                                                   ClipToBounds="True" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="1"
                                                       Width="3"
                                               IsHitTestVisible="False"
                                                       Height="15"
                                                       Margin="-1,0,0,0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Fill="#FF52779F"
                                                       RadiusX="1"
                                                       RadiusY="1"
                                                       Stroke="#FF98C5F8"
                                                       Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},
                                                                            Path=IsQATBelow,
                                                                            Converter={StaticResource BooleanToVisibilityConvertor}}" />

                                    <local:DropDownButton Name="PART_PopupButton"
                                                                  Grid.Column="0"
                                                                  Width="23"
                                                                  Style="{StaticResource QuickAccessPopupButtonStyle}">
                                        <local:DropDownButton.PathGeometry>
                                            <GeometryGroup>
                                                <LineGeometry StartPoint="4,7" EndPoint="9,7" />
                                                <PathGeometry>
                                                    <PathFigure IsClosed="True"
                                                                        IsFilled="True"
                                                                        StartPoint="5,10">
                                                        <LineSegment Point="8,10" />
                                                        <LineSegment Point="6.5,12.5" />
                                                    </PathFigure>
                                                </PathGeometry>
                                            </GeometryGroup>
                                        </local:DropDownButton.PathGeometry>

                                        <Border Grid.Column="1"
                                                        Width="auto"
                                                        Background="{StaticResource Windows8PopupBackground}"
                                                        BorderBrush="{StaticResource Windows8PopupBorderBrush}"
                                                        BorderThickness="0"
                                                        Padding="2">
                                            <Grid>
                                                <DockPanel>
                                                    <Border Width="25"
                                                                    HorizontalAlignment="Left"
                                                                    Background="Transparent"
                                                                    BorderBrush="{StaticResource Windows8QATPopupheaderBorderBrush}"
                                                                    BorderThickness="0,0,1,0"
                                                                    DockPanel.Dock="Left" />
                                                </DockPanel>
                                                <StackPanel>
                                                    <Border Width="auto"
                                                                    Height="22"
                                                                    Margin="0,0,0,1"
                                                                    Background="{StaticResource Windows8QATpopupheaderBrush}"
                                                                    BorderBrush="{StaticResource Windows8QATPopupheaderBorderBrush}"
                                                                    BorderThickness="0,0,0,1">
                                                        <TextBlock Width="auto"
                                                                           Margin="6,0,3,0"
                                                                           VerticalAlignment="Center"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource Windows8QATPopupHeaderForeground}"
                                                                           Text="{Binding Source={StaticResource ResourceWrapperKey},
                                                                                          Path=CustomizeQAT}"
                                                                           x:Uid="CustomizeQATTextBlock" />
                                                    </Border>
                                                    <ItemsControl Name="PART_QATMenu">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                                                                    <StackPanel.Resources>
                                                                        <Style TargetType="{x:Type local:RibbonButton}">
                                                                            <Setter Property="OverridesDefaultStyle" Value="true" />
                                                                            <Setter Property="Background" Value="Transparent" />

                                                                            <Setter Property="Foreground" Value="{StaticResource Windows8MenuItemForeground}" />
                                                                            <Setter Property="Height" Value="23" />
                                                                            <Setter Property="BorderThickness" Value="1" />

                                                                            <Setter Property="Template">
                                                                                <Setter.Value>

                                                                                    <ControlTemplate TargetType="{x:Type local:RibbonButton}">
                                                                                        <Border Width="{TemplateBinding Width}"
                                                                                                        Height="{TemplateBinding Height}"
                                                                                                        MinWidth="{TemplateBinding MinWidth}"
                                                                                                        MinHeight="{TemplateBinding MinHeight}"
                                                                                                        MaxWidth="{TemplateBinding MaxWidth}"
                                                                                                        MaxHeight="{TemplateBinding MaxHeight}"
                                                                                                        Margin="{TemplateBinding Margin}"
                                                                                                        Background="{TemplateBinding Panel.Background}"
                                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                                                        SnapsToDevicePixels="True">
                                                                                            <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="21" />
                                                                                                    <ColumnDefinition Width="Auto" />
                                                                                                </Grid.ColumnDefinitions>

                                                                                                <Border Name="PART_CheckBorder"
                                                                                                                Grid.Column="0"
                                                                                                                Width="21"
                                                                                                                Height="21"
                                                                                                                Background="{StaticResource MenuItemcheckBoxBackground}"
                                                                                                                BorderBrush="{StaticResource MenuItemCheckBoxBorderBrush}"
                                                                                                                BorderThickness="1"
                                                                                                                Visibility="Collapsed">
                                                                                                    <Path Width="12"
                                                                                                                  Height="10"
                                                                                                                  HorizontalAlignment="Center"
                                                                                                                  VerticalAlignment="Center"
                                                                                                                  Data="M242,236 L245.87619,240.34612 251.51429,233.16647"
                                                                                                                  Fill="Transparent"
                                                                                                                  Stretch="Fill"
                                                                                                                  Stroke="Black"
                                                                                                                  StrokeThickness="2.5" />
                                                                                                </Border>
                                                                                                <TextBlock Name="label"
                                                                                                                   Grid.Column="1"
                                                                                                                   Margin="10,0,0,0"
                                                                                                                   VerticalAlignment="Center"
                                                                                                                   Foreground="{TemplateBinding Foreground}"
                                                                                                                   Text="{TemplateBinding Label}" />
                                                                                            </Grid>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                                <Setter TargetName="PART_CheckBorder" Property="Visibility" Value="Visible" />
                                                                                            </Trigger>

                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>


                                                                                </Setter.Value>
                                                                            </Setter>

                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="{StaticResource Windows8MenuItemHoverBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource Windows8ButtonHoverBorderBrush}" />
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Resources>
                                                                </StackPanel>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                    <Separator Name="TopSeperator"
                                                                       Height="2"
                                                                       Margin="30,0,0,0"
                                                                       Background="{StaticResource Windows8MenuSeparatorBrush}"
                                                                       Visibility="Collapsed" />
                                                    <local:RibbonButton Name="PART_MoreCommands"
                                                                                Width="auto"
                                                                                Command="local:RibbonCommands.QATMoreCommands"
                                                                                Label="{Binding Source={StaticResource ResourceWrapperKey},
                                                                                                Path=QATMoreCommands}"
                                                                                Style="{StaticResource RibbonButtonPopupItemStyle}"
                                                                                Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},
                                                                                                     Path=EnableMoreCommands,
                                                                                                     Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <local:RibbonButton Name="PART_AboveButton"
                                                                                Width="auto"
                                                                                Command="local:RibbonCommands.PlaceQATAbove"
                                                                                Label="{Binding Source={StaticResource ResourceWrapperKey},
                                                                                                Path=QATShowAbove}"
                                                                                Style="{StaticResource RibbonButtonPopupItemStyle}"
                                                                                Visibility="Collapsed" />
                                                    <local:RibbonButton Name="PART_BelowButton"
                                                                                Width="auto"
                                                                                Command="local:RibbonCommands.PlaceQATBelow"
                                                                                Label="{Binding Source={StaticResource ResourceWrapperKey},
                                                                                                Path=QATShowBelow}"
                                                                                Style="{StaticResource RibbonButtonPopupItemStyle}" />
                                                    <Separator Height="2"
                                                                       Margin="30,0,0,0"
                                                                       Background="{StaticResource Windows8MenuSeparatorBrush}" />
                                                    <local:RibbonButton Name="PART_MinimizeButton"
                                                                                Width="auto"
                                                                                Command="local:RibbonCommands.MinimizeRibbon"
                                                                                IsToggle="True"
                                                                                Label="{Binding Source={StaticResource ResourceWrapperKey},
                                                                                                Path=MinimizeRibbon}"
                                                                                Style="{StaticResource RibbonButtonPopupItemStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </local:DropDownButton>
                                    <local:DropDownButton Name="PART_OverflowButton"
                                                                  Grid.Column="1"
                                                                  DockPanel.Dock="Right"
                                                                  Style="{StaticResource QuickAccessPopupButtonStyle}"
                                                                  Visibility="Collapsed">
                                        <local:DropDownButton.PathGeometry>
                                            <GeometryGroup>
                                                <PathGeometry>
                                                    <PathFigure IsClosed="True"
                                                                        IsFilled="True"
                                                                        StartPoint="3.5,8">
                                                        <LineSegment Point="4.5,9" />
                                                        <LineSegment Point="3.5,10" />
                                                    </PathFigure>
                                                </PathGeometry>
                                                <PathGeometry>
                                                    <PathFigure IsClosed="True"
                                                                        IsFilled="True"
                                                                        StartPoint="7.5,8">
                                                        <LineSegment Point="8.5,9" />
                                                        <LineSegment Point="7.5,10" />
                                                    </PathFigure>
                                                </PathGeometry>
                                            </GeometryGroup>
                                        </local:DropDownButton.PathGeometry>

                                        <StackPanel MaxHeight="21" Orientation="Horizontal">
                                            <ItemsControl Name="PART_PopupItemsControl">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center"
                                                                            Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <local:DropDownButton Name="PART_PopupButtonOverflowed" Style="{StaticResource QuickAccessPopupButtonStyle}">
                                                <local:DropDownButton.PathGeometry>
                                                    <GeometryGroup>
                                                        <LineGeometry StartPoint="4,7" EndPoint="9,7" />
                                                        <PathGeometry>
                                                            <PathFigure IsClosed="True"
                                                                                IsFilled="True"
                                                                                StartPoint="5,10">
                                                                <LineSegment Point="8,10" />
                                                                <LineSegment Point="6.5,12.5" />
                                                            </PathFigure>
                                                        </PathGeometry>
                                                    </GeometryGroup>
                                                </local:DropDownButton.PathGeometry>

                                                <Border Width="220"
                                                                BorderBrush="Gray"
                                                                BorderThickness="0.5"
                                                                Padding="2">
                                                    <Grid>
                                                        <DockPanel>
                                                            <Border Width="25"
                                                                            HorizontalAlignment="Left"
                                                                            BorderBrush="{StaticResource Windows8MenuSeparatorBrush}"
                                                                            BorderThickness="0,0,1,0"
                                                                            DockPanel.Dock="Left" />
                                                        </DockPanel>
                                                        <StackPanel>
                                                            <Border Height="22"
                                                                            Margin="0,0,0,1"
                                                                            Background="{StaticResource Windows8QATpopupheaderBrush}"
                                                                            BorderBrush="{StaticResource Windows8QATPopupheaderBorderBrush}"
                                                                            BorderThickness="0,0,0,1">
                                                                <TextBlock Margin="3,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{StaticResource Windows8QATPopupHeaderForeground}"
                                                                                   Text="{Binding Source={StaticResource ResourceWrapperKey},
                                                                                                  Path=CustomizeQAT}"
                                                                                   x:Uid="CustomizeQATTextBlock" />
                                                            </Border>
                                                            <ItemsControl Name="PART_QATMenuOverFlow" ItemContainerStyle="{StaticResource RibbonButtonPopupItemStyle}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                            <Separator Name="TopSeperatorOverFlow"
                                                                               Height="1"
                                                                               Margin="30,0,0,0"
                                                                               Background="{StaticResource Windows8MenuSeparatorBrush}"
                                                                               Visibility="Collapsed" />
                                                            <local:RibbonButton Command="local:RibbonCommands.QATMoreCommands"
                                                                                        Label="{Binding Source={StaticResource ResourceWrapperKey},
                                                                                                        Path=QATMoreCommands}"
                                                                                        Style="{StaticResource RibbonButtonPopupItemStyle}"
                                                                                        Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Ribbon}},
                                                                                                             Path=EnableMoreCommands,
                                                                                                             Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <local:RibbonButton Command="local:RibbonCommands.PlaceQATAbove"
                                                                                        Label="{Binding Source={StaticResource ResourceWrapperKey},
                                                                                                        Path=QATShowAbove}"
                                                                                        Style="{StaticResource RibbonButtonPopupItemStyle}"
                                                                                        Visibility="{Binding ElementName=PART_AboveButton,
                                                                                                             Path=Visibility,
                                                                                                             Mode=TwoWay}" />
                                                            <local:RibbonButton Command="local:RibbonCommands.PlaceQATBelow"
                                                                                        Label="{Binding Source={StaticResource ResourceWrapperKey},
                                                                                                        Path=QATShowBelow}"
                                                                                        Style="{StaticResource RibbonButtonPopupItemStyle}"
                                                                                        Visibility="{Binding ElementName=PART_BelowButton,
                                                                                                             Path=Visibility,
                                                                                                             Mode=TwoWay}" />
                                                            <Separator Height="1"
                                                                               Margin="30,0,0,0"
                                                                               Background="{StaticResource Windows8MenuSeparatorBrush}" />
                                                            <local:RibbonButton Command="local:RibbonCommands.MinimizeRibbon"
                                                                                        IsSelected="{Binding ElementName=PART_MinimizeButton,
                                                                                                             Path=IsSelected,
                                                                                                             Mode=TwoWay}"
                                                                                        IsToggle="True"
                                                                                        Label="{Binding Source={StaticResource ResourceWrapperKey},
                                                                                                        Path=MinimizeRibbon}"
                                                                                        Style="{StaticResource RibbonButtonPopupItemStyle}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </local:DropDownButton>
                                        </StackPanel>
                                    </local:DropDownButton>
                                </Grid>
                            </local:TwoItemsLayoutPanelEx>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasOverflowChildren" Value="True">
                            <Setter TargetName="PART_PopupButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_OverflowButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger SourceName="PART_QATMenu" Property="HasItems" Value="True">
                            <Setter TargetName="TopSeperator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger SourceName="PART_QATMenuOverFlow" Property="HasItems" Value="True">
                            <Setter TargetName="TopSeperatorOverFlow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasGeometry" Value="False">
                            <Setter TargetName="PART_AboveButton" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_BelowButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers />
    </Style>

    <Style BasedOn="{StaticResource Windows8QuickAccessToolBarStyle}" TargetType="{x:Type local:QuickAccessToolBar}" />




    <!--  ButtonPanel  -->
    <SolidColorBrush x:Key="Windows8ButtonPanelSeparatorBrush" Color="#FFE2E3E4" />
    <SolidColorBrush x:Key="Windows8ButtonPanelBackgroundBrush" Color="Transparent" />
    <Style TargetType="{x:Type local:ButtonPanel}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{StaticResource Windows8ButtonPanelBackgroundBrush}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ButtonPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                        Height="{TemplateBinding Height}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ClipToBounds="True">
                            <ItemsPresenter />
                        </Border>
                        <Rectangle Grid.Column="1"
                                           Width="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Stretch"
                                           Stroke="{StaticResource Windows8ButtonPanelSeparatorBrush}"
                                           Visibility="{TemplateBinding SeparatorVisibility}" />

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:ButtonLayoutPanel ClipToBounds="True" SeparatorBrush="Transparent" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  RibbonButton style  -->
    <Style x:Key="Windows8RibbonButtonStyle" TargetType="{x:Type local:RibbonButton}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Windows8RibbonButtonForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Label" Value="New Button" />
        <Setter Property="LargeIcon" Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/WordArt32.png" />
        <Setter Property="SmallIcon" Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/WordArt16.png" />
        <Style.Triggers>
            <Trigger Property="SizeForm" Value="ExtraSmall">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonButton}">
                            <Border Name="Bd"
                                            Height="22"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            IsEnabled="{TemplateBinding IsEnabled}"
                                            Opacity="{TemplateBinding Opacity}">
                                <Image Width="16"
                                               Height="16"
                                               Margin="2"
                                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                               Source="{Binding Path=SmallIcon,
                                                                Mode=OneWay,
                                                                RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonHoverBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonHoverBackground}" />
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonHoverBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonHoverBackground}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonPressedBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonPressedBackground}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonHoverBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonHoverBackground}" />
                                </MultiTrigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonPressedBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonPressedBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="SizeForm" Value="Small">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonButton}">
                            <Grid VerticalAlignment="{TemplateBinding VerticalAlignment}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                                <Border Name="Bd"
                                                MinHeight="22"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                IsEnabled="{TemplateBinding IsEnabled}"
                                                Opacity="{TemplateBinding Opacity}">
                                    <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Border Name="PART_ImageBorder" Grid.Column="0">
                                            <Image Width="16"
                                                           Height="16"
                                                           Margin="2"
                                                           Source="{Binding Path=SmallIcon,
                                                                            Mode=OneWay,
                                                                            RelativeSource={RelativeSource TemplatedParent}}" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                           Margin="2,2,4,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{TemplateBinding FontFamily}"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           Text="{TemplateBinding Label}" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSmallImageVisible" Value="False">
                                    <Setter TargetName="PART_ImageBorder" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonHoverBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonHoverBackground}" />
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonHoverBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonHoverBackground}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonPressedBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonPressedBackground}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonHoverBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonHoverBackground}" />
                                </MultiTrigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonPressedBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonPressedBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="SizeForm" Value="Large">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:RibbonButton}">
                            <Border Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            IsEnabled="{TemplateBinding IsEnabled}"
                                            Opacity="{TemplateBinding Opacity}">
                                <StackPanel HorizontalAlignment="{Binding Path=HorizontalContentAlignment,
                                                                                  RelativeSource={RelativeSource AncestorType={x:Type local:RibbonButton}}}"
                                                    VerticalAlignment="{Binding Path=VerticalContentAlignment,
                                                                                RelativeSource={RelativeSource AncestorType={x:Type local:RibbonButton}}}"
                                                    Orientation="Vertical">
                                    <Border Name="PART_ImageBorder" Margin="3">
                                        <Image Width="32"
                                                       Height="32"
                                                       Source="{Binding Path=LargeIcon,
                                                                        Mode=OneWay,
                                                                        RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Border>

                                    <ItemsControl x:Name="PART_Label"
                                                          Margin="0,3,0,2"
                                                          Focusable="False"
                                                          Foreground="{TemplateBinding Foreground}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <local:MultilinePanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsLargeImageVisible" Value="False">
                                    <Setter TargetName="PART_ImageBorder" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonHoverBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonHoverBackground}" />
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonHoverBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonHoverBackground}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonPressedBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonPressedBackground}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonHoverBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonHoverBackground}" />
                                </MultiTrigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Windows8ButtonPressedBorderBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Windows8ButtonPressedBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource Windows8RibbonButtonStyle}" TargetType="{x:Type local:RibbonButton}" />


    <!--  DropDown Button Style  -->
    <Style x:Key="Windwos8DropDownButtonStyle" TargetType="{x:Type local:DropDownButton}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Windows8RibbonButtonForeground}" />
        <Setter Property="Label" Value="New Button" />
        <!--
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                -->
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="LargeIcon" Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/WordArt32.png" />
        <Setter Property="SmallIcon" Value="pack://application:,,,/Syncfusion.Tools.WPF;component/Framework/Ribbon/Resources/WordArt16.png" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="SizeForm" Value="ExtraSmall">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:DropDownButton}">
                            <Border Name="PART_ToggleButton"
                                            Height="22"
                                            Background="{TemplateBinding Panel.Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
