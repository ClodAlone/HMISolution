                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=WindowState}"
                       Value="Maximized" />
                </MultiDataTrigger.Conditions>
                <!--<Setter TargetName="PART_RibbonAdorner" Property="Margin" Value="0,-22,0,0" />-->
                <Setter TargetName="PART_TitleBar" Property="Margin" Value="0,8,0,-8"/>
                <Setter TargetName="PART_ContentBorder" Property="Margin" Value="0,8,0,0"/>
            </MultiDataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="WindowState" Value="Maximized" />
                    <Condition Property="WindowStyle" Value="None" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--RibbonWindow style-->
    <Style TargetType="{x:Type local:RibbonWindow}">        
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="MinHeight" Value="150"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource Window.ActiveBorderBrush}"/>   
        <Setter Property="Background" Value="{StaticResource Window.BackgroundBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Template" Value="{StaticResource Office2007BlueRibbonWindowTemplate}"/>
        
        <Style.Triggers>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="BorderBrush" Value="{StaticResource Window.ActiveBorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Black.Window.Background}"/>
                <Setter Property="Template" Value="{StaticResource Office2007BlackRibbonWindowTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="BorderBrush" Value="{StaticResource Window.ActiveBorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Silver.Window.Background}"/>
                <Setter Property="Template" Value="{StaticResource Office2007SilverRibbonWindowTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="BorderBrush" Value="{StaticResource Window.ActiveBorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Office2003.WindowBackgroundBrush}"/>
                <Setter Property="Template" Value="{StaticResource Office2003RibbonWindowTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="BorderBrush" Value="{StaticResource Blend.Window.ActiveBorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource Blend.WindowBackground}"/>
                <Setter Property="Template" Value="{StaticResource BlendRibbonWindowTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyRed}"/>
                <Setter Property="Background" Value="{StaticResource WindowBackgroundBrushKey.ShinyRed}"/>
                <Setter Property="Template" Value="{StaticResource ShinyRedRibbonWindowTemplate}"/>
            </Trigger>
            <Trigger Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="BorderBrush" Value="{StaticResource NormalBorderBrushKey.ShinyBlue}"/>
                <Setter Property="Background" Value="{StaticResource RibbonBarBackgroundBrushKey.ShinyBlue}"/>
                <Setter Property="Template" Value="{StaticResource ShinyBlueRibbonWindowTemplate}"/>
            </Trigger>
            <Trigger Property="IsGlassActive" Value="True">
                <Setter Property="Template" Value="{StaticResource Office2007BlueRibbonWindowGlassTemplate}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Black"/>
                    <Condition Property="IsGlassActive" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource Office2007BlackRibbonWindowGlassTemplate}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver"/>
                    <Condition Property="IsGlassActive" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource Office2007SilverRibbonWindowGlassTemplate}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2003"/>
                    <Condition Property="IsGlassActive" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource Office2003RibbonWindowGlassTemplate}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Blend"/>
                    <Condition Property="IsGlassActive" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource BlendRibbonWindowGlassTemplate}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyRed"/>
                    <Condition Property="IsGlassActive" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource ShinyRedRibbonWindowGlassTemplate}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue"/>
                    <Condition Property="IsGlassActive" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource ShinyBlueRibbonWindowGlassTemplate}"/>
            </MultiTrigger>
            <Trigger Property="IsGlassActive" Value="False">
                <Setter Property="Template" Value="{StaticResource Office2007BlueRibbonWindowTemplate}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Black"/>
                    <Condition Property="IsGlassActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource Office2007BlackRibbonWindowTemplate}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver"/>
                    <Condition Property="IsGlassActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource Office2007SilverRibbonWindowTemplate}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Office2003"/>
                    <Condition Property="IsGlassActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource Office2003RibbonWindowTemplate}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="Blend"/>
                    <Condition Property="IsGlassActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource BlendRibbonWindowTemplate}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyRed"/>
                    <Condition Property="IsGlassActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource ShinyRedRibbonWindowTemplate}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="shared:SkinStorage.VisualStyle" Value="ShinyBlue"/>
                    <Condition Property="IsGlassActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template" Value="{StaticResource ShinyBlueRibbonWindowTemplate}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
