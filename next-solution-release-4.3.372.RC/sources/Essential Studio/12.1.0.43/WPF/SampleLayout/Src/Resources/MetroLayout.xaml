<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Grid"
                    xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
                    xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
                    xmlns:syncfusion="http://schemas.syncfusion.com/wpf">

    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="1" Color="#FF6F92BC" />
        <GradientStop Offset="0" Color="#FF345683" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GridViewBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0.047" Color="#FF519BDD" />
        <GradientStop Offset="0.475" Color="#FF2360A4" />
        <GradientStop Offset="0.901" Color="#FF165195" />
    </LinearGradientBrush>

    <Style x:Key="DocumentUriButton" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid>
                            <Grid Name="backgroundGrid"
                                  Width="24"
                                  Height="24"
                                  Visibility="Visible">
                                <Ellipse x:Name="OuterEllipse"
                                         Fill="Gray"
                                         Visibility="Visible" />
                            </Grid>
                            <Path Width="14"
                                  Height="14"
                                  Margin="0,0,0,0"
                                  Data="M16.509904,50.800396L28.400504,50.800396 28.400504,62.689999 16.509904,62.689999z M22.177083,0C28.996274,0 34.425509,1.7890273 38.46503,5.3573213 42.49454,8.9256158 44.5143,13.072685 44.5143,17.81024 44.5143,20.428875 43.774405,22.906968 42.294493,25.256224 40.814704,27.594746 37.645186,30.782395 32.795714,34.810391 30.286149,36.899052 28.72629,38.578766 28.116383,39.84758 27.516484,41.077355 27.236491,43.375859 27.29642,46.673798L16.50789,46.673798C16.477864,45.075093 16.457846,44.175213 16.457846,43.775048 16.457846,40.317044 17.03785,37.448548 18.197614,35.19006 19.357499,32.931572 21.667138,30.392968 25.136784,27.57425 28.606311,24.756506 30.67599,22.906968 31.355958,22.037341 32.395861,20.658238 32.9257,19.139567 32.9257,17.470589 32.9257,15.161347 31.995889,13.173213 30.146151,11.533516 28.3063,9.8850341 25.81663,9.0554252 22.677018,9.0554252 19.657508,9.0554252 17.137812,9.9143147 15.108044,11.634045 13.078275,13.3528 11.678431,15.981196 10.918519,19.498738L0,18.149891C0.30989633,13.102941 2.4696532,8.8153272 6.4591306,5.2968087 10.448608,1.7695071 15.687926,0 22.177083,0z"
                                  Fill="#FFFFFFFF"
                                  Stretch="Uniform">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <TransformGroup.Children>
                                            <RotateTransform Angle="0" />
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </TransformGroup.Children>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <TextBlock x:Name="Label"
                                   Margin="0,0,0,-15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   FontFamily="Segoe WP"
                                   Foreground="Gray"
                                   Text="Documentation" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterEllipse" Property="Fill" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LayoutBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LayoutBrush}" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterEllipse" Property="Fill" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LayoutBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=LayoutBrush}" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:LayoutControl}">
        <Setter Property="HeaderPanelBackground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:LayoutControl}">
                    <Border x:Name="RootBorder"
                            Grid.ColumnSpan="2"
                            Margin="{TemplateBinding Margin}"
                            Background="White"
                            BorderBrush="#FF4A4541"
                            BorderThickness="0">
                        <Grid Margin="0,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="95" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Header Panel Implementation  -->
                            <Border Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding HeaderPanelBackground}"
                                    Visibility="{TemplateBinding HeaderPanelVisibility}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Name="border1"
                                            Width="20"
                                            Height="45"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="{TemplateBinding LayoutBrush}"
                                            BorderBrush="{TemplateBinding LayoutBrush}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True" />

                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Margin="10,10,0,0"
                                                   HorizontalAlignment="Left"
                                                   FontFamily="Segoe WP"
                                                   FontSize="35"
                                                   Foreground="{TemplateBinding LayoutBrush}"
                                                   Text="{TemplateBinding HeaderText}" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="10,0,0,7"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Bottom"
                                                   FontFamily="Segoe WP"
                                                   FontSize="16"
                                                   Text="{TemplateBinding HeaderDescriptionText}"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <StackPanel Grid.Column="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Background="Transparent"
                                                Visibility="{TemplateBinding SkinPickerVisibility}">
                                        <ComboBox x:Name="SkinChooser"
                                                  Width="100"
                                                  Height="25"
                                                  Margin="0,27,10,0"
                                                  VerticalAlignment="Top"
                                                  VerticalContentAlignment="Center"
                                                  Background="White"
                                                  BorderBrush="{TemplateBinding LayoutBrush}"
                                                  BorderThickness="1"
                                                  Foreground="#FF8A8A8A"
                                                  SelectedValue="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                                          Path=VisualStyle,
                                                                          Mode=OneWayToSource}" />
                                    </StackPanel>
                                    <Button x:Name="PART_UserGuide"
                                            Grid.Column="3"
                                            Margin="0,12,30,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource DocumentUriButton}"
                                            Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <!--  GridView and UserOptions  -->
                            <Grid Grid.Row="{TemplateBinding HeaderRowCount}"
                                  Grid.RowSpan="{TemplateBinding HeaderRowSpan}"
                                  Margin="35,0,35,35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78*" />
                                    <ColumnDefinition Width="22*" />
                                </Grid.ColumnDefinitions>

                                <!--  Grid View Implementation  -->
                                <Grid Grid.Column="0" Grid.ColumnSpan="{TemplateBinding ColSpan}">
                                    <Border>
                                        <ContentControl Margin="0"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        Content="{TemplateBinding GridView}" />
                                    </Border>
                                </Grid>

                                <!--  User Options Implementation  -->
                                <Grid Grid.Column="1"
                                      Margin="15,0,0,0"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Visibility="{TemplateBinding UserOptionsVisibility}">
                                    <ItemsControl HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ItemsSource="{TemplateBinding UserOptionsView}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:UserOptions}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HeaderBackground" Value="{StaticResource GridViewBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:UserOptions}">
                    <Border Grid.Row="1"
                            Margin="5,5,0,5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            BorderThickness="0">

                        <Grid Grid.Row="0" Grid.RowSpan="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="2,2,15,2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Text="{TemplateBinding HeaderText}" />
                                <Border Grid.Row="1"
                                        Height="5"
                                        Margin="1,0,0,0"
                                        HorizontalAlignment="Stretch">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Offset="0.736" Color="#FF119EDA" />
                                            <GradientStop Offset="1" Color="White" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="2">
                                <ContentPresenter Margin="3"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
