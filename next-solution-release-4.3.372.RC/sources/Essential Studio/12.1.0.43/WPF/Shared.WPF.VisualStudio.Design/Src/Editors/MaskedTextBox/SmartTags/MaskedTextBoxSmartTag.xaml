<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.MaskedTextBoxSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="MaskedEditTextBox Tasks">
        
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7">
            <TextBlock FontWeight="Bold" Margin="0,7,0,0">Essential Tools - MaskedEditTextBox</TextBlock>
            <Border BorderBrush="Black" BorderThickness="0.4" Margin="0,7,0,0" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="0,7,0,0"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5,7,0,0"  HorizontalAlignment="Left" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="0,7,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,7,0,0">Appearance</TextBlock>

                <TextBlock Text="Corner Radius" Grid.Row="3" Grid.Column="0" Margin="0,7,0,0" />
                <syncfusion:IntegerTextBox Name="CoenerRadius" Grid.Row="3" Grid.Column="1" Margin="5,7,0,0" HorizontalAlignment="Stretch"/>
                
                
                <TextBlock Text="Mask" Grid.Row="4" Grid.Column="0" Margin="0,7,0,0"/>
                <TextBox x:Name="txtMask" Grid.Row="4" Grid.Column="1" Margin="5,7,0,0"  HorizontalAlignment="Stretch" />

                <TextBlock Text="Watermark Text" Grid.Row="5" Grid.Column="0" Margin="0,7,0,0"/>
                <TextBox x:Name="txtWatermarkText" Grid.Row="5" Grid.Column="1" Margin="5,7,0,0"  HorizontalAlignment="Stretch" />

                <TextBlock Text="WatermarkTextMode" Grid.Row="6" Grid.Column="0" Margin="0,7,0,0"/>
                <ComboBox Name="comboWatermarkTextMode" Grid.Row="6" Grid.Column="1" Margin="5,7,0,0"  HorizontalAlignment="Stretch" />

                
                <TextBlock Text="WaterMark Opacity" Grid.Row="7" Grid.Column="0" Margin="0,7,0,0"/>
                <syncfusion:IntegerTextBox x:Name="WaterMarkOpacity" Grid.Row="7" Grid.Column="1" Margin="5,7,0,0"  HorizontalAlignment="Stretch" />

                <TextBlock Text="TextSelectionOnFocus" Margin="0,7,0,0" Grid.Row="8" Grid.Column="0"/>
                <CheckBox Name="TextSelectionOnFocus" Grid.Row="8" Grid.Column="1" Margin="5,7,0,0" />

                <TextBlock Text="IsUndoEnabled" Margin="0,7,0,0" Grid.Row="9" Grid.Column="0"/>
                <CheckBox Name="IsUndoEnabled" Grid.Row="9" Grid.Column="1" Margin="5,7,0,0" />
            </Grid>
            </StackPanel>
            <StackPanel Margin="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                    <Border BorderBrush="Black" BorderThickness="0.4" Margin="0,7,0,0" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" />

                    <TextBlock FontWeight="Bold" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0">Behavior</TextBlock>
                    <TextBlock Text="Is WaterMark Visible" Margin="0,7,0,0" Grid.Row="2" Grid.Column="0"/>
            <CheckBox Name="checkWatermarkTextIsVisible" Grid.Row="2" Grid.Column="1" Margin="5,7,0,0" />
                    <TextBlock Text="Is ReadOnly" Margin="0,7,0,0" Grid.Row="3" Grid.Column="0"/>
            <CheckBox Name="ReadOnly" Grid.Row="3" Grid.Column="1" Margin="5,7,0,0"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>