<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.DoubleTextBoxSmartTag"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                    syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                    Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="DoubleTextBox Tasks">
        
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="2">
            <TextBlock FontWeight="Bold" Margin="5,7,0,0">Essential Tools - DoubleTextBox</TextBlock>
            <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,7,0,0" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5,5,0,0" Width="130" Height="25" HorizontalAlignment="Stretch" />

    
                <TextBlock FontWeight="Bold" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Appearance</TextBlock>

                <TextBlock Text="Value" Grid.Row="3" Grid.Column="0" Margin="5,5,0,0"/>
                <syncfusion:DoubleTextBox x:Name="txtText" Grid.Row="3" Grid.Column="1" Margin="5,5,0,0" Text="0.00000" Width="130" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="Number Decimal Digits" Grid.Row="4" Grid.Column="0" Margin="5,5,0,0"/>
                <syncfusion:IntegerTextBox x:Name="txtNumberDecimalDigits" MinValue="0" MaxValue="99"  Grid.Row="4" Grid.Column="1" 
                                          Margin="5,5,0,0"
                                          Text="5" Width="130"                                           
                                          Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="Number Decimal Separator" Grid.Row="5" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtNumberDecimalSeperator" Grid.Row="5" Grid.Column="1" Margin="5,5,0,0" 
                         Text="." 
                         MaxLength="1"                         
                         Width="130" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="Number Group Separator" Grid.Row="6" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtNumberGroupSeperator" Grid.Row="6" Grid.Column="1" Margin="5,5,0,0" 
                         Text="," 
                         MaxLength="1"
                         Width="130" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="Corner Radius" Grid.Row="8" Grid.Column="0" Margin="5,5,0,0"/>
                <syncfusion:MaskedTextBox Name="txtCornerRadius" Grid.Row="8" Grid.Column="1" Margin="5,5,0,0"
                                          Width="130" 
                                          Height="25" 
                                          Mask="00,00,00,00"
                                          Text="00,00,00,00"
                                          TextMaskFormat="IncludeLiterals"
                                          HorizontalAlignment="Stretch" />

                <TextBlock Text="Horizontal Content Alignment" Grid.Row="9" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox Name="comboHorizontalContentAlignment" Grid.Row="9" Grid.Column="1" Margin="5,5,0,0" Width="130" Height="25" HorizontalAlignment="Stretch" />



                 <TextBlock FontWeight="Bold" Margin="5,5,0,0" Grid.Row="11">Behavior</TextBlock>

                <TextBlock Margin="5,5,0,0" Grid.Row="12" Grid.Column="0" Text="Enter To Move Next"/>
                <CheckBox Name="checkBoxEnterToMoveNext" Margin="5,5,0,0"  Grid.Row="12" Grid.Column="1"/>

                <TextBlock Text="Scroll Interval" Grid.Row="14" Grid.Column="0" Margin="5,5,0,0"/>
                <syncfusion:DoubleTextBox x:Name="txtScrollInterval" Grid.Row="14" Grid.Column="1" 
                                          Margin="5,5,0,0"
                                          Text="1.00" Width="130"                                           
                                          Height="25" HorizontalAlignment="Stretch" />


            </Grid>
        </StackPanel>

    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>