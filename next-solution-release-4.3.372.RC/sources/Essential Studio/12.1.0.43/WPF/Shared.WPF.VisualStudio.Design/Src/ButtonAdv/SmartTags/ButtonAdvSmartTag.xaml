<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.ButtonAdvSmartTag"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
       xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="485" d:DesignWidth="300">
    <syncfusion:SmartTagPresenter Title="ButtonAdv Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Height="275" Width="254">
            <Grid Width="246">
                <Grid.RowDefinitions>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="Bold" Text="Essential Tools - ButtonAdv" Grid.ColumnSpan="2" Margin="0,0,7,0"/>
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,22,0,0" Grid.ColumnSpan="2"/>
                <TextBlock FontWeight="Bold" Margin="0,7,0,0" Grid.Row="1" Grid.ColumnSpan="2"> Actions</TextBlock>
                <TextBlock Text="Name"  Grid.Row="2" VerticalAlignment="Bottom"/>
                <TextBox x:Name="txtName" Width="100" Grid.Column="1" Grid.Row="2" Height="22" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Text="Label" VerticalAlignment="Bottom"  Grid.Row="3"/>
                <TextBox x:Name="txtLabel" Width="100" Height="22" Grid.Column="1" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,22,0,0" Grid.ColumnSpan="2" Grid.Row="4"/>
                <TextBlock FontWeight="Bold" Margin="0,0,7,0" Text="Appearance" Grid.Row="5" VerticalAlignment="Bottom"/>
                <TextBlock VerticalAlignment="Center" Text="SizeMode" Grid.Row="6" Grid.Column="0" Margin="0,7,0,0" />
                <ComboBox x:Name="SizeModeCombo" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" Width="100" Height="22" />
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,22,0,0" Grid.ColumnSpan="2" Grid.Row="7"/>
                <TextBlock FontWeight="Bold" Grid.Row="8" VerticalAlignment="Bottom">Behavior</TextBlock>
                <TextBlock VerticalAlignment="Bottom" Text="IsMultiline" Grid.Row="9"/>
                <TextBlock VerticalAlignment="Bottom" Text="IsCheckable" Grid.Row="10"/>
                <CheckBox x:Name="IsMultiLine" Grid.Column="1" Grid.Row="9" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                <CheckBox x:Name="IsCheckable" Grid.Column="1" Grid.Row="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
            </Grid>
        </StackPanel>

    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
