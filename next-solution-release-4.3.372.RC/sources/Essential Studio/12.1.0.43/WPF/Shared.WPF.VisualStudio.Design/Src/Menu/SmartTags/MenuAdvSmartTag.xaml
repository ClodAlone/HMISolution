<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.MenuAdvSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="MenuAdv Control Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">

            <StackPanel Margin="7" Name="panel1" Orientation="Vertical">


                <TextBlock FontWeight="Bold">Essential Tools - MenuAdv</TextBlock>

                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,7,0,0" />


                <TextBlock FontWeight="Bold" Margin="0,7,0,0">Actions</TextBlock>
                <TextBlock Margin="0,7,0,0">
                <Hyperlink Tag="{x:Type syncfusion:MenuItemAdv}" Click="AddChildControls">Add New MenuItemAdv</Hyperlink>
                </TextBlock>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />

                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Name" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"/>
                    <TextBox Name="NameTextBox"  Margin="0,7,0,0" Width="115" Grid.Row="1" Grid.Column="1"/>

                </Grid>


                <Border BorderBrush="Black" BorderThickness="0.5"  Margin="0,7,0,0"/>


            </StackPanel>


            <StackPanel  Margin="7" Name="Panel2">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>





                    <TextBlock VerticalAlignment="Center" Text="Orientation" Grid.Row="2" Grid.Column="0" Margin="0,7,0,0" />
                    <ComboBox Name="OrientationSelector" Margin="0,7,0,0" Width="115" Grid.Row="2" Grid.Column="1" />



                    <TextBlock VerticalAlignment="Center" Text="Popup Animation Type" Grid.Row="3" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="PopupAnimationType" Margin="0,7,0,0" Width="115" Grid.Row="3" Grid.Column="1"/>




                    <TextBlock VerticalAlignment="Center" Text="Expand Mode" Grid.Row="4" Grid.Column="0" Margin="0,7,0,0"/>
                    <ComboBox Name="ExpandModeCombo" Margin="0,7,0,0" Width="115" Grid.Row="4" Grid.Column="1"/>



                    <Border BorderBrush="Black"  Grid.Row="5" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>



                    <TextBlock FontWeight="Bold" Grid.Row="6" Margin="0,7,0,0">Behavior</TextBlock>

                    <StackPanel Grid.Row="7"  Margin="0,7,0,0">

                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <CheckBox Name="FocusOnAltChkBox"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                        Focus On Alt Key
                            </TextBlock>
                        </StackPanel>


                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal" >
                            <CheckBox Name="IsScrollEnabledChkBox"/>
                            <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                       Scrolling Enabled
                            </TextBlock>
                        </StackPanel>

                       
                    </StackPanel>


                </Grid>

            </StackPanel>



        </StackPanel>


    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>