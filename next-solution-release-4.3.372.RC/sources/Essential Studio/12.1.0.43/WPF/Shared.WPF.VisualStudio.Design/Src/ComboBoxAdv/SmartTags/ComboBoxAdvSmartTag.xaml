<syncfusion:SmartTagBase  x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.ComboBoxAdvSmartTag"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             syncfusion:SkinStorage.VisualStyle="Office2007Blue"
             Height="24" Width="24">
    <syncfusion:SmartTagPresenter Title="ComboBox SmartTag">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>
        <StackPanel Orientation="Vertical" Background="#FFDCEBFE">
            <StackPanel Margin="7">
                <TextBlock FontWeight="Bold">Essential Tools - ComboBoxAdv</TextBlock>
            </StackPanel>
            <Border BorderBrush="Black" BorderThickness="0.5"  Margin="7,7,7,0"/>
            <StackPanel Margin="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0"/>
                    <TextBox Name="NameTextBox" HorizontalAlignment="Right" Margin="3" Width="115" Grid.Row="0" Grid.Column="1"/>
                    <TextBlock Text="DefaultText" VerticalAlignment="Center" Grid.Column="0" Grid.Row="1"/>
                    <TextBox Name="DefaultTextTextBox" HorizontalAlignment="Right" Margin="3" Width="115" Grid.Row="1" Grid.Column="1"/>
                    
                    <Border BorderBrush="Black"  Grid.Row="2" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>
                </Grid>
            </StackPanel>
            <StackPanel Margin="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition/>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="Bold" Grid.Row="0">Appearance</TextBlock>
                    <TextBlock Text="MaxDropDownHeight" VerticalAlignment="Center" Grid.Column="0" Margin="0,7,0,0" Grid.Row="1"/>
                    <TextBox Name="MaxDropDownHeightTextBox" HorizontalAlignment="Right" Margin="0,7,0,0"  Width="55"  Grid.Row="1" Grid.Column="1"/>
                    <TextBlock Text="SelectedValueDelimiter" Margin="0,7,0,0" VerticalAlignment="Center" Grid.Column="0" Grid.Row="2"/>
                    <TextBox Name="SelectedValueDelimiterTextBox" Margin="0,7,0,0" HorizontalAlignment="Right" Width="55" Grid.Row="2" Grid.Column="1"/>
                    <Border BorderBrush="Black"  Grid.Row="3" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>

                </Grid>
              </StackPanel>
            <StackPanel Margin="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition/>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="Bold" Margin="0,7,0,0" Grid.Row="0">Behavior</TextBlock>
                    <TextBlock Text="IsEditable" VerticalAlignment="Center" Grid.Column="0" Margin="0,7,0,0" Grid.Row="1"/>
                    <CheckBox Name="IsEditable" Margin="0,7,0,0" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1"/>
                    
                    <TextBlock Margin="0,7,0,0"  VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Text="AllowMultiSelect"/>
                    <CheckBox Name="AllowMultiSelect" Margin="0,7,0,0" VerticalAlignment="Center" Grid.Row="2" Grid.Column="1"  />
                    
                    <Border BorderBrush="Black"  Grid.Row="3" BorderThickness="0.5"  Grid.ColumnSpan="2"  Margin="0,7,0,0"/>

                </Grid>
            </StackPanel>


        </StackPanel>


    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
