<syncfusion:SmartTagBase x:Class="Syncfusion.Shared.WPF.VisualStudio.Design.BusyIndicatorSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">
    <syncfusion:SmartTagPresenter Title="BusyIndicator Tasks">
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>


        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Height="410" Width="255">
            <Grid Width="250">
                <Grid.RowDefinitions>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="Bold" Margin="0,0,7,0" Grid.ColumnSpan="2">Essential Tools - BusyIndicator</TextBlock>
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,22,0,0" Grid.ColumnSpan="2"/>
                <TextBlock FontWeight="Bold" Margin="0,7,0,0" Grid.Row="1">Actions</TextBlock>
                <TextBlock Text="Name" VerticalAlignment="Bottom" Margin="0,0,7,0" Grid.Row="2" />
                <TextBox VerticalAlignment="Bottom" x:Name="txtName"  Margin="0,0,7,0" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" Width="100" Height="20" />
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,22,0,0" Grid.ColumnSpan="2" Grid.Row="3"/>
                <TextBlock FontWeight="Bold" Margin="0,0,7,0" Grid.Row="4" VerticalAlignment="Bottom">Appearance</TextBlock>
                <TextBlock VerticalAlignment="Bottom" Text="CancelButtonVisible" Grid.Row="7" Margin="0,7,0,0" />
                <ComboBox Grid.Column="1" x:Name="CancelButtonVisible" Grid.Row="7" Width="100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="20" Margin="0,0,7,0" />
                <TextBlock VerticalAlignment="Bottom" Text="CloseButtonVisible" Grid.Row="6" Margin="0,7,0,0" />
                <ComboBox x:Name="CloseButtonVisible" Grid.Row="6" Grid.Column="1" Width="100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="20" Margin="0,0,7,0"/>
                <TextBlock VerticalAlignment="Center" Text="EnableGrayScaleEffect" Grid.Row="5" Grid.Column="0" Margin="0,7,0,0" />
                <CheckBox Grid.Column="1" x:Name="EnableGrayScaleEffect" VerticalAlignment="Bottom" HorizontalAlignment="Left" Grid.Row="5"/>
                <TextBlock VerticalAlignment="Bottom" Text="DescriptionPlacement" Grid.Row="8" Margin="0,0,7,0" HorizontalAlignment="Left" Width="120" />
                <ComboBox x:Name="DescriptionPlacement" Grid.Row="8" HorizontalAlignment="Left" Width="100" VerticalAlignment="Bottom" Height="20" Grid.Column="1" />
                <TextBlock VerticalAlignment="Bottom" Text="HeaderAlignment" Grid.Row="9" Margin="0,0,7,0" />
                <ComboBox x:Name="HeaderAlignment" Grid.Row="9" Grid.Column="1" HorizontalAlignment="Left" Width="100" VerticalAlignment="Bottom" Height="20" />
                <TextBlock VerticalAlignment="Bottom" Text="Header" Grid.Row="10"/>
                <TextBox Grid.Column="1" x:Name="Header" Grid.Row="10" VerticalAlignment="Bottom" HorizontalAlignment="Left" Height="20" Width="100" />
                <TextBlock VerticalAlignment="Bottom" Text="LoadingDescription" Grid.Row="11"/>
                <TextBox Grid.Column="1" x:Name="LoadingDescription" Grid.Row="11" VerticalAlignment="Bottom" Height="20" Width="100" HorizontalAlignment="Left"/>
                <Border BorderBrush="Black" BorderThickness="0.5" Margin="0,22,0,0" Grid.ColumnSpan="2" Grid.Row="12"/>
                <TextBlock Text="Behaviour" FontWeight="Bold" Grid.Row="13"  VerticalAlignment="Bottom"/>
                <TextBlock VerticalAlignment="Bottom" Text="IsInDeterminite" Grid.Row="14"/>
                <CheckBox Grid.Column="1" x:Name="IsIndeterminate" VerticalAlignment="Bottom" HorizontalAlignment="Left" Grid.Row="14"/>
                <TextBlock VerticalAlignment="Bottom" Text="Delay" Grid.Row="15"/>
                <TextBox Grid.Column="1" x:Name="Delay" Grid.Row="15" Width="100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="20" />
                <TextBlock VerticalAlignment="Bottom" Text="ProgressValue" Grid.Row="16"/>
                <TextBox Grid.Column="1" x:Name="ProgressValue" Grid.Row="16" VerticalAlignment="Bottom" Height="20" HorizontalAlignment="Left" Width="100"/>
            </Grid>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
