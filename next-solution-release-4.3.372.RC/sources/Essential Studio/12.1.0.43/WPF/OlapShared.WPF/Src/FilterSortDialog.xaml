<syncfusion:ChromelessWindow Name="filterSortingDialogWindow"
                             x:Class="Syncfusion.Windows.Shared.Olap.FilterSortDialog"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                             xmlns:resources="clr-namespace:Syncfusion.Windows.Shared.Olap.Resources"
                             Icon="App.ico"
                             WindowStartupLocation="CenterScreen"
                             WindowStyle="ToolWindow"
                             ResizeMode="NoResize"
                             Title="{Binding ElementName=textBlockDialogTitle, Path=Text}">
    <syncfusion:ChromelessWindow.Resources>
            <resources:ResourceWrapper x:Key="ResourceWrapperKeys" />
    </syncfusion:ChromelessWindow.Resources>
    <Grid>
        <!-- Since, Resource wrapper is added as resource of the window. We can't bind the title directly. 
            So, we are binding this text block with the title. The Title will bind to this text block-->
        <TextBlock x:Name="textBlockDialogTitle" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilteringSortingDlgTitle}" Visibility="Collapsed" />
        <GroupBox HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="1">
			<GroupBox.Header>
                <Label Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgHeader}"/>
			</GroupBox.Header>
			<Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
				<syncfusion:TabControlExt x:Name="tabControl" Height="300" HorizontalAlignment="Stretch" CloseButtonType="Hide">
                    <syncfusion:TabItemExt x:Name="tabItemFilterInfo" Header="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgFilterTab}">
						<Grid Name="gridEmptyResults" >
							<Grid.ColumnDefinitions>
								<ColumnDefinition/>
								<ColumnDefinition/>
								<ColumnDefinition/>
								<ColumnDefinition/>
								<ColumnDefinition/>
								<ColumnDefinition/>
								<ColumnDefinition/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
							</Grid.RowDefinitions>
                            <GroupBox Header="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgEmptyResultHeader}" x:Name="emptyResultsGroup" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="7" Margin="2,2,2,2">
								<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
									<Grid.ColumnDefinitions>
										<ColumnDefinition/>
										<ColumnDefinition/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition/>
									</Grid.RowDefinitions>
                                    <CheckBox x:Name="filterEmptyRowCheckBox" IsChecked="True"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" TabIndex="0" VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgFilterEmptyRows}"/>
                                    <CheckBox x:Name="filterEmptyColumnCheckBox" IsChecked="True"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" TabIndex="0" VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgFilterEmptyColumns}"/>
								</Grid>
							</GroupBox>
							<GroupBox x:Name="filterOneGroup" Grid.Row="2" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="7" Margin="2,2,2,2">
								<GroupBox.Header>
                                    <CheckBox x:Name="filterOneGroupCheckBox" Checked="filterOneGroupCheckBox_Checked" TabIndex="1"  Unchecked="filterOneGroupCheckBox_Unchecked" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgFilter1Header}" />
								</GroupBox.Header>
								<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="57"/>
										<ColumnDefinition/>
										<ColumnDefinition Width="50"/>
										<ColumnDefinition Width="60"/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition/>
										<RowDefinition/>
									</Grid.RowDefinitions>
                                    <TextBlock x:Name ="measuresTextOne" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" Height="20" Width="50" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgFilterOn}"/>
									<ComboBox x:Name="measuresBoxOne" Grid.Row="1" Grid.Column="1" Height="20" VerticalAlignment="Center" TabIndex="2" Margin="6,2,0,2"/>
                                    <TextBlock x:Name ="conditionOneText" Grid.Row="0" Grid.Column="0" Width="55" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingFilterCondition}"/>
									<ComboBox x:Name="conditionBoxOne" Grid.Row="0" Grid.Column="1" Margin="6,2,50,2" HorizontalAlignment="Stretch" TabIndex="3" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="valueTextOne" Grid.Row="1" Grid.Column="2" Height="20" Margin="0" HorizontalAlignment="Right" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgFilterOnValue}"/>
									<TextBox x:Name="valueTextBoxOne" Grid.Row="1" Grid.Column="3" Height="20" Margin="2,2,2,2" HorizontalAlignment="Stretch" TabIndex="4" VerticalAlignment="Center" />
								</Grid>
							</GroupBox>
							<GroupBox x:Name="filterTwoGroup" Grid.Row="5" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="7" Margin="2,2,2,2">
								<GroupBox.Header>
                                    <CheckBox x:Name="filterTwoGroupCheckBox" Checked="filterTwoGroupCheckBox_Checked" TabIndex="5" Unchecked="filterTwoGroupCheckBox_Unchecked" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgFilter2Header}" />
								</GroupBox.Header>
								<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="57"/>
										<ColumnDefinition/>
										<ColumnDefinition Width="50"/>
										<ColumnDefinition Width="60"/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition/>
										<RowDefinition/>
									</Grid.RowDefinitions>
                                    <TextBlock x:Name ="measuresTextTwo" Grid.Row="1" Grid.Column="0" Width="50" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgFilterOn}"/>
									<ComboBox x:Name="measuresBoxTwo" Grid.Row="1" Grid.Column="1" Height="20" TabIndex="6" VerticalAlignment="Center" Margin="6,2,0,2" />
                                    <TextBlock x:Name ="conditionTwoText" Grid.Row="0" Grid.Column="0" Width="55" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingFilterCondition}"/>
									<ComboBox x:Name="conditionBoxTwo" Grid.Row="0" Grid.Column="1" Margin="6,2,50,2" TabIndex="7"  HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="valueTextTwo" Grid.Row="1" Grid.Column="2" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgFilterOnValue}"/>
									<TextBox x:Name="valueTextBoxTwo" Grid.Row="1" Grid.Column="3" Height="20" TabIndex="8" Margin="2,2,2,2" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
								</Grid>
							</GroupBox>
						</Grid>
					</syncfusion:TabItemExt>
                    <syncfusion:TabItemExt x:Name="tabItemSortingInfo" Header="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgSortingTab}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition />
								<ColumnDefinition />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
							</Grid.RowDefinitions>
							<GroupBox x:Name="sortingGroup" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="6" Margin="5,10,5,10">
								<GroupBox.Header>
                                    <CheckBox x:Name="sortingGroupCheckBox" TabIndex="0" Checked="sortingGroupCheckBox_Checked" Unchecked="sortingGroupCheckBox_Unchecked" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgSortHeader}" />
								</GroupBox.Header>
							</GroupBox>
                            <TextBlock x:Name ="sortingMeasuresText" Grid.Row="1" Grid.Column="0" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgSortingOn}"/>
							<ComboBox x:Name="sortingMeasuresBox" Grid.Row="1" Grid.Column="1" TabIndex="1" Height="20" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="6,0,0,0"/>
                            <RadioButton x:Name="sortingTypeAsc" GroupName="Sorting" TabIndex="2" IsChecked="True" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgSortAsc}"/>
                            <RadioButton x:Name="sortingTypeDesc" GroupName="Sorting" TabIndex="3" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgSortDesc}"/>
                            <CheckBox x:Name="sortingHierarchy" Grid.Row="4" Grid.Column="1" TabIndex="4" Grid.ColumnSpan="3" VerticalAlignment="Center" IsChecked="True" HorizontalAlignment="Left" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgSortPreserverHierarchy}"/>
						</Grid>
					</syncfusion:TabItemExt>
				</syncfusion:TabControlExt>
				<Grid Grid.Row="1">
                    <Button x:Name ="Update" Width="80" Height="26" TabIndex="9" Click="updateOlapDataManager" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgUpdate}" IsDefault="True" HorizontalAlignment="Right" Margin="2,4,92,4"/>
                    <Button x:Name="Cancel" Width="80" Height="26" TabIndex="10" Click="CancelOlapDataManager" Content="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsFilterSortingDlgCancel}" IsCancel="True" HorizontalAlignment="Right" Margin="2,4,2,4"/>
				</Grid>
            </Grid>
		</GroupBox>
	</Grid>
</syncfusion:ChromelessWindow>