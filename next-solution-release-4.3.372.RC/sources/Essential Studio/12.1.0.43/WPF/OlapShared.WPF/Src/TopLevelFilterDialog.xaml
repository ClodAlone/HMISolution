<syncfusion:ChromelessWindow Name="TopLevelfilterDialogWindow" x:Class="Syncfusion.Windows.Shared.Olap.TopLevelFilter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" syncfusion:SkinStorage.VisualStyle="Default"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    Icon="App.ico" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Title="Top Level Filter"  
    Height="300" Width="300">
    <Grid>
        <GroupBox HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8,8,8,8" BorderThickness="1">
            <GroupBox.Header>
                <Label Content="Top Level Filtering"/>
            </GroupBox.Header>
            <StackPanel>
                <GroupBox x:Name="TopfilterOneGroup" Grid.Row="2" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="7" Margin="2,2,2,2">
                    <GroupBox.Header>
                        <CheckBox x:Name="TopfilterOneGroupCheckBox" Content="Columns" Checked="TopfilterOneGroupCheckBox_Checked" TabIndex="0" Unchecked="TopfilterOneGroupCheckBox_Unchecked" />
                    </GroupBox.Header>
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="13"/>
                            <ColumnDefinition Width="67*" />
                            <ColumnDefinition Width="154*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name ="lbl_MeasureNameone" VerticalAlignment="Center" Grid.ColumnSpan="2" Height="15.96"><Run Text="Measure Name"/></TextBlock>
                        <ComboBox x:Name="ddlMeasureNameone" Grid.Column="2" Margin="6,5,18,5" TabIndex="1"  HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        <TextBlock x:Name ="lbl_FieldCountone" VerticalAlignment="Center" Grid.Row="1" Grid.ColumnSpan="2" Height="15.96"><Run Text="Field Count"/></TextBlock>
                        <syncfusion:UpDown Name="fieldCountone" Grid.Row="1" Grid.Column="2" Margin="6,6,50,5" Height="20" TabIndex="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" MinValue="2" Value="2" Step="1"></syncfusion:UpDown>
                    </Grid>
                </GroupBox>
                <GroupBox x:Name="TopfilterTwoGroup" Grid.Row="2" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="7" Margin="2,2,2,2">
                    <GroupBox.Header>
                        <CheckBox x:Name="TopfilterTwoGroupCheckBox" Content="Rows" TabIndex="3" Checked="TopfilterTwoGroupCheckBox_Checked" Unchecked="TopfilterTwoGroupCheckBox_Unchecked" />
                    </GroupBox.Header>
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name ="lbl_MeasureNametwo" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"><Run Text="Measure Name"/></TextBlock>
                        <ComboBox x:Name="ddlMeasureNametwo" Grid.Row="0" Grid.Column="1" Margin="6,5,18,5" TabIndex="4"  HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        <TextBlock x:Name ="lbl_FieldCounttwo" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"><Run Text="Field Count"/></TextBlock>
                        <syncfusion:UpDown Name="fieldCounttwo" Grid.Row="2" Grid.Column="1" Margin="6,6,50,5" Height="20" TabIndex="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" MinValue="2" Value="2" Step="1"></syncfusion:UpDown>
                    </Grid>
                </GroupBox>
                <Grid>
                    <Button x:Name ="Update" Width="80" TabIndex="6" Content="Update" HorizontalAlignment="Left" Margin="80,4,0,4" Click="updateOlapDataManager" />
                    <Button x:Name="Cancel" Width="80" Height="26" Click="CancelOlapDataManager" TabIndex="7" Content="Cancel" HorizontalAlignment="Right" Margin="2,4,2,4" />
                </Grid>
            </StackPanel>
        </GroupBox>
    </Grid>
</syncfusion:ChromelessWindow>