<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:syn="http://schemas.syncfusion.com/wpf"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Wpf" xmlns:local="clr-namespace:Syncfusion.Windows.Chart.Olap"
                    >
    
    <SolidColorBrush x:Key="Blend.ExpanderBorderBrush" Color="#FF5F5F5F"/>
    <SolidColorBrush x:Key="Blend.ExpanderBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Blend.ExpanderSignBrush" Color="Black"/>

    <Pen Brush="#B1B1B1" x:Key="Blend.AxisPen" Thickness="0.2"/>
    
    <!--ExpanderStyle-->

    <SolidColorBrush x:Key="TreeViewFill.Black" Color="#FF898989"/>

    <LinearGradientBrush x:Key="ToolTipBackground.Black"  StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#FFB5B5B5"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonMouseOverBrush.Black" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1"/>
            <GradientStop Color="#FFFFE8A7" Offset="0.4"/>
            <GradientStop Color="#FFFFD767" Offset="0.4"/>
            <GradientStop Color="#FFFFFCDE"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFE3E3E3" x:Key="BlendOlapChartGridBackground"/>

    <SolidColorBrush Color="#FF8B8C8C" x:Key="Blend.BorderBackground"/>
    <SolidColorBrush x:Key="BlendChartBackgroundBrush" Color="#FF404040"/>

    <SolidColorBrush  x:Key="Blend.LegendBackground" Color="Transparent" />


    <SolidColorBrush x:Key="Blend.LegendForeground"
                   Color="White"/>
    <SolidColorBrush x:Key="Blend.LegendBorderBackground"
                   Color="#FFD5D7D8"/>
    <CornerRadius x:Key="Blend.LegendCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>

    <Style x:Key="Blend.ExpanderStyle"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="{StaticResource ToolTipBackground.Black}"/>
        <Setter Property="Foreground"  Value="{StaticResource ToolTipBackground.Black}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TreeViewFill.Black}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                           BorderBrush="Transparent" 
                                            CornerRadius="1" 
                                            Width="11" 
                                            BorderThickness="0" 
                                           
                                            Background="Transparent"   HorizontalAlignment="Right"  >
                            <Path x:Name="ExpandPath" Data="M437,100.33334 L455,100.33334 L445.6665,109.66684 z" Margin="2.874,2.032,1.126,0" Stretch="Fill"  Height="6.032" VerticalAlignment="Top" Fill="#FF9B9B9B" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-90"></RotateTransform>
                                </Path.RenderTransform>
                            </Path>


                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"
                                              RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="RenderTransform"  TargetName="ExpandPath" >
                                <Setter.Value>
                                    <RotateTransform Angle="0"></RotateTransform>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="Fill"
                                    Value="#FFFFFFFF"
                                    TargetName="ExpandPath"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type syn:ChartLegend}" x:Key="BlendChartLegendStyle">
        <Setter Property="BorderBrush" Value="{StaticResource Blend.LegendBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Blend.LegendBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Blend.LegendForeground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Blend.LegendCornerRadius}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
    </Style>

    <Style x:Key="BlendOlapChartStyle" TargetType="{x:Type local:OlapChart}">
        <Setter Property="GridLineStroke" Value="{StaticResource Blend.AxisPen}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource Blend.ExpanderStyle}"/>
        <Setter Property="GridBackground" Value="{StaticResource BlendOlapChartGridBackground}"/>
        <Setter Property="LabelForeground" Value="{StaticResource Blend.LegendForeground}" />
    </Style>

    <Style x:Key="BlendChartStyle" TargetType="{x:Type syn:Chart}" >
        <Setter Property="BorderBrush" Value="{StaticResource Blend.BorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource BlendChartBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="LegendStyle" Value="{StaticResource BlendChartLegendStyle}"/>
    </Style>

    <Style TargetType="{x:Type syn:Chart}" BasedOn="{StaticResource BlendChartStyle}"/>
    <Style TargetType="{x:Type local:OlapChart}" BasedOn="{StaticResource BlendOlapChartStyle}"/>
</ResourceDictionary>    
