<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:syn="http://schemas.syncfusion.com/wpf"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Syncfusion.Windows.Chart.Olap">

    <SolidColorBrush x:Key="Office2007Silver.ExpanderBorderBrush" Color="#FF969696"/>
    <SolidColorBrush x:Key="Office2007Silver.ExpanderSignBrush" Color="#FF040404"/>
    <LinearGradientBrush x:Key="Office2007Silver.ExpanderBackgroundBrush"
                         EndPoint="0,1" 
                         StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="#FFEAEAEA"/>
            <GradientStop Offset="0.15" Color="#FFEAEAEA"/>
            <GradientStop Offset="0.2" Color="#FFE3E3E3"/>
            <GradientStop Offset="0.50" Color="#FFCCCCCC"/>
            <GradientStop Offset="0.55" Color="#FFA0A0A4"/>
            <GradientStop Offset="0.65" Color="#FFA0A0A4"/>
            <GradientStop Offset="0.7" Color="#FFB2B2B2"/>
            <GradientStop Offset="1" Color="#FFCBCBCB"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <Pen Brush="#6C7278" x:Key="Office2007Silver.AxisPen" Thickness="0.2"/>

    <!--Expander Style-->

    <SolidColorBrush x:Key="TreeViewFill.Silver" Color="#FFA5A6A6"/>

    <LinearGradientBrush x:Key="ToolTipBackground.Silver"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#FFDDDDE0"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonMouseOverBrush.Silver" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1"/>
            <GradientStop Color="#FFFFE8A7" Offset="0.4"/>
            <GradientStop Color="#FFFFD767" Offset="0.4"/>
            <GradientStop Color="#FFFFFCDE"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE3AD" Offset="0"/>
        <GradientStop Color="#FFFFF4CB" Offset="0.02"/>
        <GradientStop Color="#FFFFDB75" Offset="1"/>
    </LinearGradientBrush>
    
    <SolidColorBrush Color="#FFFFC06F" x:Key="ButtonHoverBorderBrush1"/>

    <LinearGradientBrush   x:Key="Office2007Silver.ChartBackground" EndPoint="0.5,0" StartPoint="0.5,1">
        <GradientStop Color="#FFE0E0E0" Offset="0"/>
        <GradientStop Color="sc#1, 0.8307699, 0.838799, 0.838799" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Office2007Silver.ExpanderStyle"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                           BorderBrush="{StaticResource TreeViewFill.Silver}"
                                            CornerRadius="1" 
                                            Width="11" 
                                            BorderThickness="1" 
                                            SnapsToDevicePixels="True"
                                            Background="{StaticResource ToolTipBackground.Silver}">
                            <Path Margin="2" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" 
                                              Fill="{StaticResource TreeViewFill.Silver}" Name="ExpandPath" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"
                                              RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="Background"
                                    Value="{StaticResource ButtonHoverBackgroundBrush1}"
                                    TargetName="border"/>
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource ButtonHoverBorderBrush1}"
                                    TargetName="border"/>
                            <Setter Property="Fill" TargetName="ExpandPath" Value="Black"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <LinearGradientBrush x:Key="Office2007SilverGridBackground" EndPoint="0.5,-0.04" StartPoint="0.5,0.051">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="#FFD7D7D7" Offset="0.683"/>
        <GradientStop Color="#FFE0E0E0" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush Color="Transparent" x:Key="Office2007Silver.LegendBackground"/>

    <SolidColorBrush x:Key="Office2007Silver.LegendForeground"
                   Color="Black"/>

    <SolidColorBrush x:Key="Office2007Silver.LegendBorderBackground"
                   Color="#FF5F5F5F"/>
    <CornerRadius x:Key="Office2007Silver.LegendCornerRadius" 
                TopLeft="6" BottomLeft="6" BottomRight="6" TopRight="6"/>


    <Style TargetType="{x:Type syn:ChartLegend}" x:Key="Office2007SilverChartLegendStyle">
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Silver.LegendBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Office2007Silver.LegendBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Office2007Silver.LegendForeground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Office2007Silver.LegendCornerRadius}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
    </Style>
    
    <Style x:Key="Office2007SilverOlapChartStyle" TargetType="{x:Type local:OlapChart}">
        <Setter Property="GridLineStroke" Value="{StaticResource Office2007Silver.AxisPen}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource Office2007Silver.ExpanderStyle}"/>
        <Setter Property="GridBackground" Value="{StaticResource Office2007SilverGridBackground}"/>
        <Setter Property="LabelForeground" Value="{StaticResource Office2007Silver.LegendForeground}"/>
    </Style>

    <Style TargetType="{x:Type syn:Chart}" x:Key="Office2007SilverChartStyle">
        <Setter Property="BorderBrush" Value="#FFA5A6A6"/>
        <Setter Property="Background" Value="{StaticResource Office2007Silver.ChartBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="LegendStyle" Value="{StaticResource Office2007SilverChartLegendStyle}"/>
    </Style>



    <Style TargetType="{x:Type syn:Chart}" BasedOn="{StaticResource Office2007SilverChartStyle}"/>
    <Style TargetType="{x:Type local:OlapChart}" BasedOn="{StaticResource Office2007SilverOlapChartStyle}"/>
    
</ResourceDictionary>    
