
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:local="clr-namespace:Syncfusion.Windows.Chart.Olap"
	xmlns:syn="http://schemas.syncfusion.com/wpf"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<DataTemplate x:Key="Status">
		<Image
			x:Name="StatusImage"
			Width="16"
			Height="32"
			Margin="1,1,1,32"
			/>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding Path=Item}" Value="1">
				<Setter TargetName="StatusImage" Property="Source" Value="pack://application:,,,/Syncfusion.OlapChart.WPF;component//Images/KPI/Circle.png"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding Path=Item}" Value="0">
				<Setter TargetName="StatusImage" Property="Source" Value="pack://application:,,,/Syncfusion.OlapChart.WPF;component//Images/KPI/Triangle.png"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding Path=Item}" Value="-1">
				<Setter TargetName="StatusImage" Property="Source" Value="pack://application:,,,/Syncfusion.OlapChart.WPF;component//Images/KPI/Diamond.png"/>
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>
	<DataTemplate x:Key="StatusRoadSigns">
		<Grid>
			<Image
				Name="StatusRoadSignsImage"
				Width="16"
				Height="32"
				Margin="1,1,1,32"/>
		</Grid>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding Path=Item}" Value="1">
				<Setter TargetName="StatusRoadSignsImage" Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapChart.WPF;component//Images/KPI/Green.png"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding Path=Item}" Value="0">
				<Setter TargetName="StatusRoadSignsImage" Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapChart.WPF;component//Images/KPI/Yellow.png"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding Path=Item}" Value="-1">
				<Setter TargetName="StatusRoadSignsImage" Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapChart.WPF;component//Images/KPI/Red.png"/>
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>
	<DataTemplate x:Key="Trend">
		<Grid>
			<Image
				Name="TrendImage"
				Width="16"
				Height="16"
				Margin="1,1,1,16"/>
		</Grid>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding Path=Item}" Value="1">
				<Setter TargetName="TrendImage" Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapChart.WPF;component//Images/KPI/UpArrow.png"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding Path=Item}" Value="0">
				<Setter TargetName="TrendImage" Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapChart.WPF;component//Images/KPI/RightArrow.png"/>
			</DataTrigger>
			<DataTrigger Binding="{Binding Path=Item}" Value="-1">
				<Setter TargetName="TrendImage" Property="Image.Source" Value="pack://application:,,,/Syncfusion.OlapChart.WPF;component//Images/KPI/DownArrow.png"/>
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>
	<local:PieLabelConvertor x:Key="labelconvert"/>
	<DataTemplate x:Key="PieLabelsTemplate">
		<Border
			Background="Transparent"
			BorderThickness="0"
			CornerRadius="0"
			Padding="2">
			<TextBlock
				FontFamily="Tahoma"
				FontSize="11"
				FontWeight="Regular"
				Foreground="Black"
				Text="{Binding Converter={StaticResource labelconvert}}"/>
		</Border>
	</DataTemplate>
	<DataTemplate x:Key="PieConnectorTemplate">
		<Line
			Stroke="Black"
			X1="0"
			X2="12"
			Y1="0"
			Y2="0"/>
	</DataTemplate>
	<local:PieLegendConvertor x:Key="legendconvertor"/>
	<DataTemplate x:Key="LegendTemplate">
		<StackPanel Orientation="Horizontal">
			<CheckBox
				Name="chbox"
				Margin="{Binding ElementMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type syn:ChartLegend}}}"
				VerticalAlignment="Center"
				IsChecked="{Binding CorrespondingPoints[0].DataPoint.Visible, Mode=TwoWay}"
				Tag="{Binding}"
				Visibility="{Binding CheckBoxVisibility, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type syn:ChartLegend}}}"/>
			<Ellipse
				Width="15"
				Height="15"
				Fill="{Binding Interior}"
				Visibility="{Binding IconVisibility, RelativeSource={RelativeSource AncestorType={x:Type syn:ChartLegend}},Mode=TwoWay}"/>
            <TextBlock Margin="2,0,1,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type syn:ChartLegend}}}" Text="{Binding Converter={StaticResource legendconvertor}}"/>
        </StackPanel>
    </DataTemplate>
    <local:IEnumLegendConvertor x:Key="ienumconvertor" />
    <DataTemplate x:Key="LegendTemplate2" >
    <StackPanel Orientation="Horizontal">
        <CheckBox
				Name="chbox"
				Margin="{Binding ElementMargin, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type syn:ChartLegend}}}"
				VerticalAlignment="Center"
				IsChecked="{Binding CorrespondingPoints[0].DataPoint.Visible, Mode=TwoWay}"
				Tag="{Binding}"
				Visibility="{Binding CheckBoxVisibility, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type syn:ChartLegend}}}"/>
        <Ellipse
				Width="15"
				Height="15"
				Fill="{Binding Interior}"
				Visibility="{Binding IconVisibility, RelativeSource={RelativeSource AncestorType={x:Type syn:ChartLegend}},Mode=TwoWay}"/>
            <TextBlock Margin="2,0,1,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type syn:ChartLegend}}}" Text="{Binding Converter={StaticResource ienumconvertor}}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>