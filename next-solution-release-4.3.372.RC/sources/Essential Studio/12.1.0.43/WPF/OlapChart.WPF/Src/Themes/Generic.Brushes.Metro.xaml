<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syn="http://schemas.syncfusion.com/wpf"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Wpf" xmlns:local="clr-namespace:Syncfusion.Windows.Chart.Olap"
                    >

   <Pen Brush="#FF333333" x:Key="MetroAxisPen" Thickness="0.5"/>

    <SolidColorBrush x:Key="MetroThemeForeground" Color="#FF119EDA"/>

    <SolidColorBrush  x:Key="MetroThemeLegendBackground" Color="#FFEBEBEB" />
    <SolidColorBrush x:Key="MetroThemeLegendForeground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroThemeLegendBorderBrush"  Color="#FFCCCCCC"/>
    <CornerRadius x:Key="MetroThemeLegendCornerRadius"  TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>

    <Style x:Key="MetroExpanderStyle" TargetType="{x:Type ToggleButton}">      
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border" BorderBrush="Transparent" CornerRadius="1" Width="11" BorderThickness="0" Background="Transparent"   HorizontalAlignment="Right"  >
                            <Path x:Name="ExpandPath" Data="M357,301 L357.5,352.5 422.5,325.5 z" Margin="2.874,2.032,1.126,0" Stretch="Fill"  Height="6.032" VerticalAlignment="Top" Fill="{DynamicResource MetroForegroundBrush}" RenderTransformOrigin="0.5,0.5"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" SnapsToDevicePixels="True"  RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M290.5,329 L312.5,329.5 302.5,347.5 z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"  Value="true">
                            <Setter Property="Fill" Value="{DynamicResource MetroForegroundBrush}" TargetName="ExpandPath"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type syn:ChartLegend}" x:Key="MetroChartLegendStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource MetroBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MetroBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource MetroThemeLegendCornerRadius}"/>
    </Style>
    
    <Style x:Key="MetroOlapChartStyle" TargetType="{x:Type local:OlapChart}">
        <Setter Property="GridLineStroke" Value="{StaticResource MetroAxisPen}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource MetroExpanderStyle}"/>
        <Setter Property="GridBackground" Value="{DynamicResource MetroPanelBackgroundBrush}"/>
        <Setter Property="LabelForeground" Value="{StaticResource MetroThemeLegendForeground}"/>
    </Style>

    <Style TargetType="{x:Type syn:Chart}" x:Key="MetroChartStyle">
        <Setter Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource MetroPanelBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource MetroThemeForeground}"/>
        <Setter Property="LegendStyle" Value="{StaticResource MetroChartLegendStyle}"/>
    </Style>

    <Style TargetType="{x:Type syn:Chart}" BasedOn="{StaticResource MetroChartStyle}"/>
    <Style TargetType="{x:Type local:OlapChart}" BasedOn="{StaticResource MetroOlapChartStyle}"/>
</ResourceDictionary>    
