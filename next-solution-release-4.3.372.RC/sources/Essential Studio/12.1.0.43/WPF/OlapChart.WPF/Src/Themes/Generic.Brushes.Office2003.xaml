    <SolidColorBrush x:Key="Office2003.ExpanderSignBrush" Color="#FF333366"/>
    <SolidColorBrush x:Key="Office2003.ExpanderBorderBrush" Color="#FFB2B2B2"/>
    <LinearGradientBrush x:Key="Office2003.ExpanderBackgroundBrush"
                         EndPoint="1,1" 
                         StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0.2" Color="#FFFFFFFF"/>
            <GradientStop Offset="1" Color="#FF99CCCC"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <Pen Brush="#2971AD" x:Key="Office2003.AxisPen"/>
    
    <!--Expander Style-->
    <LinearGradientBrush x:Key="ButtonMouseOverBrush.Blue" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1"/>
            <GradientStop Color="#FFFFE8A7" Offset="0.4"/>
            <GradientStop Color="#FFFFD767" Offset="0.4"/>
            <GradientStop Color="#FFFFFCDE"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TreeViewFill.Blue" Color="#FF7F9DB9"/>

    <LinearGradientBrush x:Key="ToolTipBackground.Blue"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#E4E5F0"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE3AD" Offset="0"/>
        <GradientStop Color="#FFFFF4CB" Offset="0.02"/>
        <GradientStop Color="#FFFFDB75" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFFFC06F" x:Key="ButtonHoverBorderBrush1"/>

    <SolidColorBrush Color="Transparent" x:Key="Office2003.LegendBackground"/>
    <SolidColorBrush x:Key="Office2003.LegendForeground"
                   Color="#2971AD"/>

    <SolidColorBrush x:Key="Office2003.LegendBorderBackground"
                   Color="#4885BB"/>
    <CornerRadius x:Key="Office2003.LegendCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>
    
    <Style x:Key="Office2003Blue.ExpanderStyle"
           TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                           BorderBrush="{StaticResource TreeViewFill.Blue}"
                                            CornerRadius="1" 
                                            Width="11" 
                                            BorderThickness="1" 
                                            SnapsToDevicePixels="True"
                                            Background="{StaticResource ToolTipBackground.Blue}">
                            <Path Margin="2" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" 
                                              Fill="{StaticResource TreeViewFill.Blue}" Name="ExpandPath" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"
                                              RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="Background"
                                    Value="{StaticResource ButtonHoverBackgroundBrush1}"
                                    TargetName="border"/>
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource ButtonHoverBorderBrush1}"
                                    TargetName="border"/>
                            <Setter Property="Fill" TargetName="ExpandPath" Value="Black"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type syn:ChartLegend}" x:Key="Office2003ChartLegendStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2003.LegendBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Office2003.LegendBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Office2003.LegendForeground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Office2003.LegendCornerRadius}"/>
    </Style>

    <Style x:Key="Office2003OlapChartStyle" TargetType="{x:Type local:OlapChart}">
        <Setter Property="GridLineStroke" Value="{StaticResource Office2003.AxisPen}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource Office2003Blue.ExpanderStyle}"/>
        <Setter Property="LabelForeground" Value="{StaticResource Office2003.LegendForeground}"/>
    </Style>

    <Style TargetType="{x:Type syn:Chart}" x:Key="Office2003ChartStyle">
        <Setter Property="BorderBrush" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource Office2003.ChartBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="LegendStyle" Value="{StaticResource Office2003ChartLegendStyle}"/>
    </Style>

    <Style TargetType="{x:Type syn:Chart}" BasedOn="{StaticResource Office2003ChartStyle}"/>
    <Style TargetType="{x:Type local:OlapChart}" BasedOn="{StaticResource Office2003OlapChartStyle}"/>
</ResourceDictionary>    
