<syncfusion:SmartTagBase x:Class="Syncfusion.Diagram.WPF.VisualStudio.Design.DiagramViewSmartTag"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                     syncfusion:SkinStorage.VisualStyle="Office2007Blue"
                     Height="24" Width="24">

    <syncfusion:SmartTagPresenter Title="DiagramView Tasks">
        
        <syncfusion:SmartTagPresenter.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.Shared.WPF;component/SkinManager/SkinManager.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </syncfusion:SmartTagPresenter.Resources>

        <StackPanel Orientation="Vertical" Background="#FFDCEBFE" Margin="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name" Grid.Row="0" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="5,5,0,0"  Width="120" Height="25" HorizontalAlignment="Left" />

                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Appearance</TextBlock>

                <TextBlock Text="Background" Grid.Row="4" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbBackground" Grid.Row="4" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="Foreground" Grid.Row="5" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbForeground" Grid.Row="5" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="ZoomFactor" Grid.Row="8" Grid.Column="0" Margin="5,5,0,0"/>
                <TextBox x:Name="txtZoomFactor" Grid.Row="8" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <TextBlock Text="PortVisibility" Grid.Row="9" Grid.Column="0" Margin="5,5,0,0"/>
                <ComboBox x:Name="cmbPortVisibility" Grid.Row="9" Grid.Column="1" Margin="5,5,0,0" Text="" Width="Auto" Height="25" HorizontalAlignment="Stretch" />

                <CheckBox x:Name="chkline4" Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,5,0,0" Content="ShowHorizontalGridLine" Width="Auto" Height="25" HorizontalAlignment="Stretch" />
                <CheckBox x:Name="chkline5" Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,5,0,0" Content="ShowVerticalGridLine" Width="Auto" Height="25" HorizontalAlignment="Stretch" />
                
                <Border BorderBrush="Black" BorderThickness="0.4" Margin="5,5,0,0" Grid.Row="17" Grid.Column="0" Grid.ColumnSpan="3" />

                <TextBlock FontWeight="Bold" Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,0">Behavior</TextBlock>

                <CheckBox x:Name="chkline1" Grid.Row="19" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,5,0,0" Content="IsZoomEnabled" Width="Auto" Height="25" HorizontalAlignment="Stretch" />
                <CheckBox x:Name="chkline2" Grid.Row="20" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,5,0,0" Content="IsPageEditable" Width="Auto" Height="25" HorizontalAlignment="Stretch" />
                <CheckBox x:Name="chkline3" Grid.Row="21" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,5,0,0" Content="IsPanEnabled" Width="Auto" Height="25" HorizontalAlignment="Stretch" />               
                
            </Grid>
        </StackPanel>
    </syncfusion:SmartTagPresenter>
</syncfusion:SmartTagBase>
    