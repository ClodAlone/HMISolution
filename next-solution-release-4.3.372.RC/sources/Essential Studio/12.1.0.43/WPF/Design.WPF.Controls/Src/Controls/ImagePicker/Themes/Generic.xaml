<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="clr-namespace:Syncfusion.Design.Controls">

    <!--DataTemplate for ImagePickerItem -->
    <DataTemplate x:Key="ImagePickerItemTemplate" DataType="{x:Type design:ImagePickerItem}">
        <Border Height="28" Name="border">
            <DockPanel ClipToBounds="True">
                <Border Name="icon"  Height="33" Width="33" Margin="1" Opacity="1">
                    <Border.Background>
                        <ImageBrush Stretch="Uniform">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="pack://application:,,,/Syncfusion.Tools.WPF;component/Controls/FontListBox/Images/tt.png"></BitmapImage>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                </Border>
                <TextBlock Margin="2" VerticalAlignment="Center" FontSize="16"  Text="{Binding Path=Name}" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"/>
				<TextBlock Margin="2" VerticalAlignment="Center" FontSize="16" FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"/>
			</DockPanel>
        </Border>
    </DataTemplate>


    <!--ImagePickerInternalItem template-->
    <ControlTemplate x:Key="ImagePickerInternalItemTemplate" TargetType="{x:Type design:ImagePickerInternalItem}">
        <Border Background="{TemplateBinding Background}" 
                BorderThickness="{TemplateBinding BorderThickness}"
                BorderBrush="{TemplateBinding BorderBrush}">
            <ContentPresenter MinWidth="0" 
                              ContentSource="Content"
					          ContentTemplate="{TemplateBinding ContentTemplate}"
				              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
        </Border>
        <!--<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{utilsOuter:SkinObject ItemMouseOverBrush}"/>
				<Setter Property="Opacity" Value="1"/>
				<Setter Property="BorderBrush" Value="{utilsOuter:SkinObject ItemBorderBrush}"/>
				<Setter Property="BorderThickness" Value="1"/>	
                <Setter Property="Foreground" Value="{utilsOuter:SkinObject ItemMouseOverForegroundBrush}"/>
			</Trigger>
        </ControlTemplate.Triggers>-->
    </ControlTemplate>

    <Style x:Key="{x:Type design:ImagePickerInternalItem}" TargetType="{x:Type design:ImagePickerInternalItem}">
        <Setter Property="ContentTemplate" Value="{StaticResource ImagePickerItemTemplate}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Blue"/>
        <!--<Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type design:FontListBox}}}"/>-->
        <Setter Property="Template" Value="{StaticResource ImagePickerInternalItemTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="AliceBlue" />
            </Trigger>
        </Style.Triggers>
    </Style>




    <!--ImagePicker template-->
    <ControlTemplate x:Key="ImagePickerTemplate" TargetType="{x:Type design:ImagePicker}" >
        <Border BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="{TemplateBinding BorderThickness}" 
                Background="{TemplateBinding Background}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>                
            
            
            <design:ImagePickerInternal Grid.Row="1">
                
            </design:ImagePickerInternal>
            </Grid>

