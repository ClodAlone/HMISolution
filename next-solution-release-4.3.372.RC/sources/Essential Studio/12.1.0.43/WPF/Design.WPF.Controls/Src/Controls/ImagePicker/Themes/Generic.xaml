    </Border>
    </ControlTemplate>
	
    
    <Style x:Key="{x:Type design:ImagePicker}" TargetType="{x:Type design:ImagePicker}">
        <Setter Property="Background" Value="LightGreen"/>
        <Setter Property="Template" Value="{StaticResource ImagePickerTemplate}"/>
    </Style>


