<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Grid">
    
    <Geometry x:Key="DownArrowGeometry">M 0 0 L 3.5 4 L 7 0 Z</Geometry>
    <Style x:Key="ButtonFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle SnapsToDevicePixels="true" Margin="2" Stroke="Black" StrokeDashArray="1 2" StrokeThickness="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <SolidColorBrush x:Key="ButtonNormalBorder" Color="#FF707070"/>
    <LinearGradientBrush x:Key="ButtonPressedBackground" StartPoint="0.526496,0.0149253" EndPoint="0.526496,0.970149">
        <GradientStop Color="#FFF3B276" Offset="0"/>
        <GradientStop Color="#FFF47912" Offset="0.488584"/>
        <GradientStop Color="#FFFEAE01" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonHoverBackground" StartPoint="0.526496,0.0149254" EndPoint="0.526496,0.970149">
        <GradientStop Color="#FFFEFEFA" Offset="0"/>
        <GradientStop Color="#FFFED948" Offset="0.488584"/>
        <GradientStop Color="#FFFEE47F" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="ToggleButtonStyle1" TargetType="{x:Type ToggleButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonNormalBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="Bd" Background="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RecognizesAccessKey="True" Margin="2" />
                        <Border Grid.Row="2" BorderThickness="0.1" BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" CornerRadius="2">
                            <Path Name="Arrow"
	                                  Margin="2"
	                                  Fill="Black"
	                                  Data="{StaticResource DownArrowGeometry}"
	                                  HorizontalAlignment="Center"
	                                  VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter Property="Background" Value="{StaticResource ButtonPressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" Value="{StaticResource ButtonHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" Value="{StaticResource ButtonPressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="#ADADAD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:GridSplitButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GridSplitButton}">
                    <Grid>
                        <ToggleButton 
                            Content="{TemplateBinding Content}" 
                            Style="{DynamicResource ToggleButtonStyle1}" 
                            Foreground="White" 
                            x:Name="PART_ToggleButton" 
                            />
                        <Popup 
                            IsOpen="{Binding Path=IsChecked, ElementName=PART_ToggleButton, Mode=OneWay}"
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            Placement="Bottom" 
                            StaysOpen="False"
                            >
                            <Grid 
                                Width="{Binding Path=Width, ElementName=PART_ToggleButton, Mode=Default}" 
                                Height="{Binding Path=Height, ElementName=PART_ToggleButton, Mode=Default}"
                                >
                                <ListBox 
                                    IsSynchronizedWithCurrentItem="True" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Bottom" 
                                    Width="{Binding Path=Width, ElementName=PART_ToggleButton, Mode=Default}" 
                                    Height="{StaticResource {x:Static local:GridSplitButton.PopupMaxDropDownHeight}}"
                                    Name="PART_ListBox"
                                    SelectedItem="{TemplateBinding SelectedItem}"
                                    />
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
