                <Setter TargetName="OuterBorder" Property="Stroke" Value="{StaticResource SunBlackMenuItemPressedBorderBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
