                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Top"
                                                                 Content="{Binding Source={x:Static local:GridDataResourceWrapper.VCenter}}"
                                                                 Foreground="{TemplateBinding Foreground}"
                                                                 IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                                                     Path=VAlignment,
                                                                                     Converter={StaticResource enumBooleanConverter},
                                                                                     ConverterParameter=Center}" />
                                                    <RadioButton Width="83"
                                                                 Height="19"
                                                                 Margin="6,4.155,0,0"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Top"
                                                                 Content="{Binding Source={x:Static local:GridDataResourceWrapper.VTop}}"
                                                                 Foreground="{TemplateBinding Foreground}"
                                                                 IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                                                     Path=VAlignment,
                                                                                     Converter={StaticResource enumBooleanConverter},
                                                                                     ConverterParameter=Top}" />
                                                    <RadioButton Grid.Row="1"
                                                                 Grid.Column="1"
                                                                 Width="60"
                                                                 Height="17"
                                                                 Margin="8,8,26,0"
                                                                 VerticalAlignment="Top"
                                                                 Content="{Binding Source={x:Static local:GridDataResourceWrapper.VStretch}}"
                                                                 Foreground="{TemplateBinding Foreground}"
                                                                 IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent},
                                                                                     Path=VAlignment,
                                                                                     Converter={StaticResource enumBooleanConverter},
                                                                                     ConverterParameter=Stretch}" />
                                                </Grid>
                                            </TabItem>

                                        </TabControl>

                                        <TextBlock Grid.Row="6"
                                                   Grid.ColumnSpan="3"
                                                   Height="22"
                                                   Margin="21,2,122,2"
                                                   VerticalAlignment="Top"
                                                   Focusable="False"
                                                   FontSize="12"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   IsHitTestVisible="False"
                                                   Text="{Binding Source={x:Static local:GridDataResourceWrapper.TextAlignment}}"
                                                   TextWrapping="NoWrap" />
                                    </Grid>
                                </Border>
                            </Expander>
                            <Expander Grid.Row="1"
                                      Margin="0,4,0,0"
                                      FontSize="13"
                                      Foreground="{TemplateBinding Foreground}"
                                      Header="{Binding Source={x:Static local:GridDataResourceWrapper.WidthOptions}}"
                                      Padding="0,0,10,0">
                                <Border Margin="15,1,2,8"
                                        BorderBrush="{TemplateBinding Foreground}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Grid Height="Auto">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="0.051*" />
                                            <RowDefinition Height="0.140*" />
                                            <RowDefinition Height="0.060*" />
                                        </Grid.RowDefinitions>
                                        <CheckBox Name="PART_ChkAutoFit"
                                                  Grid.Row="0"
                                                  Width="60"
                                                  Margin="20,10,2,10"
                                                  HorizontalAlignment="Left"
                                                  Content="{Binding Source={x:Static local:GridDataResourceWrapper.AutoFit}}"
                                                  FontSize="12"
                                                  Foreground="{TemplateBinding Foreground}" />
                                        <Grid Grid.Row="1" Height="65">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="25" />
                                                <RowDefinition Height="30" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Margin="20,0,0,0"
                                                       FontSize="12"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       Text="{Binding Source={x:Static local:GridDataResourceWrapper.Width}}" />
                                            <Border Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Height="30"
                                                    Margin="15,2,2,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    CornerRadius="8">
                                                <StackPanel Background="Transparent" Orientation="Horizontal">
                                                    <Slider x:Name="PART_WidthSetter"
                                                            Width="180"
                                                            Margin="2,2,2,2"
                                                            Background="Transparent"
                                                            Focusable="{Binding ElementName=PART_ChkAutoFit,
                                                                                Path=IsChecked}"
                                                            Maximum="500"
                                                            Minimum="0" />
                                                    <TextBlock Margin="0,2"
                                                               FontSize="12"
                                                               Text="{Binding ElementName=PART_WidthSetter,
                                                                              Path=Value,
                                                                              Converter={StaticResource DoubleToIntConverter}}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Button x:Name="PART_OkButton"
                                                Grid.Row="2"
                                                Width="130"
                                                Height="26"
                                                Margin="2,4,2,8"
                                                VerticalAlignment="Bottom"
                                                Content="{Binding Source={x:Static local:GridDataResourceWrapper.ApplyWidthSettings}}"
                                                FontSize="12" />
                                    </Grid>
                                </Border>
                            </Expander>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="DefaultTextTemplate">
        <TextBlock Name="PART_TextBlock"
                   HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                   VerticalAlignment="Stretch"
                   OverridesDefaultStyle="False"
                   SnapsToDevicePixels="True"
                   Foreground="{TemplateBinding TextElement.Foreground}"
                   Text="{Binding}"
                   TextAlignment="{TemplateBinding Property=HorizontalAlignment,
                                                   Converter={StaticResource textAlignmentConverter}}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="{Binding Path=Tag,
                                          ElementName=PART_ContentPresenter}" />
    </DataTemplate>

    <Style TargetType="{x:Type local:GridDataHeaderCellControl}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="ContentDataTemplate" Value="{StaticResource DefaultTextTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GridDataHeaderCellControl}">
                    <Border Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding HeaderInnerBorderBrush}"
                            BorderThickness="{TemplateBinding HeaderInnerBorderThickness}"
                            Padding="0"
                            SnapsToDevicePixels="True">
                        <Grid Name="MainGrid"
                              Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}"
                              SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="0" MinWidth="{Binding Path=SortVisibility, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource MinWidthConverter}}" />
                                <ColumnDefinition Width="0" MinWidth="{Binding Path=FilterButtonVisibility, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource MinWidthConverter}}" />
                                <ColumnDefinition Width="0" MinWidth="{Binding Path=ColumnOptionsButtonVisibility, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource MinWidthConverter}}" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="border"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Background="Transparent"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Grid.Column="0"
                                                  Margin="2,2,0,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Text}"
                                                  ContentTemplate="{TemplateBinding ContentDataTemplate}"
                                                  Tag="NoWrap" />
                                <!--  SD17324 Set Default TextWrppaing For TextBlock Part  -->
                            </Border>
                            <Border x:Name="border1"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="{x:Static local:GridDataHeaderCellControl.MinimumWidth}"
                                    Margin="0,0,0,1"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True"
                                    Visibility="{Binding Path=SortVisibility,
                                                         Mode=TwoWay,
                                                         RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="10.84"
                                          Height="9.87"
                                          Margin="5,0,0,0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="{TemplateBinding SortPath}"
                                          Fill="{TemplateBinding SortBrush}"
                                          SnapsToDevicePixels="True"
                                          Stretch="Fill" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="10"
                                               Foreground="{TemplateBinding SortBrush}"
                                               Text="{TemplateBinding SortString}" />
                                </Grid>
                            </Border>
                            <!--  Set WantsMouseInput true so that the filter button will receive mouse events.  -->
                            <Border x:Name="border2"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="0,0,0,1"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <local:GridDataFilterToggleButton Name="toggleButton"
                                                                      FilterAppliedInnerBrush="{TemplateBinding FilterAppliedInnerBrush}"
                                                                      FilterHoverInnerBrush="{TemplateBinding FilterHoverInnerBrush}"
                                                                      FilterHoverOuterBrush="{TemplateBinding FilterHoverOuterBrush}"
                                                                      FilterInnerBrush="{TemplateBinding FilterInnerBrush}"
                                                                      FilterOuterBrush="{TemplateBinding FilterOuterBrush}"
                                                                      IsChecked="{Binding Path=IsDropDownOpen,
                                                                                          Mode=TwoWay,
                                                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                                                      IsFilterApplied="{TemplateBinding IsFilterApplied}"
                                                                      IsTabStop="False"
                                                                      SnapsToDevicePixels="True"
                                                                      Visibility="{Binding Path=FilterButtonVisibility,
                                                                                           Mode=TwoWay,
                                                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                                                      gridcommon:VisualContainer.WantsMouseInput="True" />
                                    <Popup Name="PART_Popup"
                                           AllowsTransparency="true"
                                           Placement="Bottom"
                                           PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                                           StaysOpen="False"
                                           Visibility="Visible">
                                        <Popup.IsOpen>
                                            <MultiBinding Converter="{StaticResource isOpenConverter}">
                                                <Binding Mode="TwoWay"
                                                         Path="IsDropDownOpen"
                                                         RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Mode="OneWay"
                                                         Path="IsAdvanceFiltering"
                                                         RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </Popup.IsOpen>
                                        <theme:SystemDropShadowChrome Name="Shdw"
                                                                      MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}"
                                                                      Color="Transparent">
                                            <Grid>
                                                <Border x:Name="PART_DropDownBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        Visibility="Visible" />
                                            </Grid>

                                        </theme:SystemDropShadowChrome>
                                        <Popup.Style>
                                            <Style TargetType="{x:Type Popup}">
                                                <Setter Property="StaysOpen" Value="False" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=PART_DropDownBorder}" Value="True">
                                                        <Setter Property="StaysOpen" Value="True" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=PART_DropDownBorder}" Value="False">
                                                        <Setter Property="StaysOpen" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Popup.Style>
                                    </Popup>
                                    <!--  ExcelLike Filtering  -->

                                    <local:GridDataExcelLikeFilterPane x:Name="PART_FilterDropDown"
                                                                       IsOpen="{Binding Path=IsDropDownOpen,
                                                                                        Mode=TwoWay,
                                                                                        RelativeSource={RelativeSource TemplatedParent}}"
                                                                       StaysOpen="{Binding IsChecked,
                                                                                           ElementName=toggleButton}"
                                                                       gridcommon:VisualContainer.WantsMouseInput="True" />


                                </Grid>
                            </Border>
                            <Border x:Name="border3"
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Margin="0,0,1,1"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Grid Background="Transparent">
                                    <ToggleButton Name="optionsButton"
                                                  Grid.Row="0"
                                                  Grid.Column="0"
                                                  Margin="2"
                                                  Background="{TemplateBinding ColumnOptionsButtonBackground}"
                                                  BorderBrush="{TemplateBinding ColumnOptionsButtonBorderBrush}"
                                                  IsChecked="{Binding Path=IsColumnOptionsDropDownOpen,
                                                                      Mode=TwoWay,
                                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                                  IsTabStop="False"
                                                  Style="{StaticResource OptionButtonStyle}"
                                                  ToolTip="{Binding Source={x:Static local:GridDataResourceWrapper.ShowColumnOptionsFilter}}"
                                                  Visibility="{Binding Path=ColumnOptionsButtonVisibility,
                                                                       Mode=TwoWay,
                                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                                  gridcommon:VisualContainer.WantsMouseInput="True" />

                                </Grid>
                            </Border>
                            <Popup Name="PART_ColumnOptionsPopup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding Path=IsColumnOptionsDropDownOpen,
                                                    RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=optionsButton}"
                                   SnapsToDevicePixels="True"
                                   StaysOpen="False" gridcommon:VisualContainer.WantsMouseInput="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger SourceName="PART_Popup" Property="Popup.HasDropShadow" Value="true">
                            <Setter TargetName="Shdw" Property="Margin" Value="0,0,5,5" />
                            <Setter TargetName="Shdw" Property="SnapsToDevicePixels" Value="true" />
                            <Setter TargetName="Shdw" Property="Color" Value="#71000000" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="true">
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="IsTabStop" Value="false" />
                        </Trigger>

                        <Trigger SourceName="border" Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HoverBackground}" />
                            <Setter TargetName="PART_ContentPresenter" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HoverForeground}" />
                        </Trigger>
                        <Trigger SourceName="border1" Property="IsMouseOver" Value="True">
                            <Setter TargetName="border1" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HeaderOptionsHoverBackground}" />

                            <Setter TargetName="border1" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HeaderOptionsBorderBrush}" />
                        </Trigger>

                        <Trigger SourceName="border2" Property="IsMouseOver" Value="True">
                            <Setter TargetName="border2" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HeaderOptionsHoverBackground}" />


                            <Setter TargetName="border2" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HeaderOptionsBorderBrush}" />
                        </Trigger>

                        <Trigger Property="IsAdvanceFiltering" Value="True">
                            <Setter TargetName="PART_FilterDropDown" Property="Visibility" Value="Collapsed" />
                        </Trigger>


                        <Trigger SourceName="toggleButton" Property="IsChecked" Value="True">
                            <Setter TargetName="border2" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HeaderOptionsCheckedBackground}" />


                            <Setter TargetName="border2" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HeaderOptionsBorderBrush}" />
                        </Trigger>
                        <Trigger SourceName="border3" Property="IsMouseOver" Value="True">
                            <Setter TargetName="border3" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HeaderOptionsHoverBackground}" />

                            <Setter TargetName="border3" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HeaderOptionsBorderBrush}" />

                        </Trigger>
                        <Trigger SourceName="optionsButton" Property="IsChecked" Value="True">
                            <Setter TargetName="border3" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HeaderOptionsCheckedBackground}" />

                            <Setter TargetName="border3" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HeaderOptionsBorderBrush}" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EnableLegacyStyle" TargetType="{x:Type local:GridDataHeaderCellControl}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GridDataHeaderCellControl}">
                    <Border Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding HeaderInnerBorderBrush}"
                            BorderThickness="{TemplateBinding HeaderInnerBorderThickness}"
                            Padding="0">
                        <Grid Name="MainGrid"
                              Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}"
                              SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="0" MinWidth="{Binding Path=SortVisibility, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource MinWidthConverter}}" />
                                <ColumnDefinition Width="0" MinWidth="{Binding Path=FilterButtonVisibility, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource MinWidthConverter}}" />
                                <ColumnDefinition Width="0" MinWidth="{Binding Path=ColumnOptionsButtonVisibility, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource MinWidthConverter}}" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Name="PART_TextBlock"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="2,1,2,1"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"
                                       Text="{TemplateBinding Text}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Width="{x:Static local:GridDataHeaderCellControl.MinimumWidth}"
                                    Height="15"
                                    BorderThickness="0"
                                    Visibility="{Binding Path=SortVisibility,
                                                         Mode=TwoWay,
                                                         RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="15" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="14"
                                          Height="12"
                                          Data="{TemplateBinding SortPath}"
                                          Fill="{TemplateBinding SortBrush}"
                                          Stretch="Fill" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="10"
                                               Foreground="{TemplateBinding SortBrush}"
                                               Text="{TemplateBinding SortString}" />
                                </Grid>
                            </Border>
                            <!--  Set WantsMouseInput true so that the filter button will receive mouse events.  -->
                            <Border Grid.Row="0"
                                    Grid.Column="2"
                                    Width="20"
                                    Height="20"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Grid>
                                    <local:GridDataFilterToggleButton x:Name="toggleButton"
                                                                      Margin="2"
                                                                      FilterAppliedInnerBrush="{TemplateBinding FilterAppliedInnerBrush}"
                                                                      FilterHoverInnerBrush="{TemplateBinding FilterHoverInnerBrush}"
                                                                      FilterHoverOuterBrush="{TemplateBinding FilterHoverOuterBrush}"
                                                                      FilterInnerBrush="{TemplateBinding FilterInnerBrush}"
                                                                      FilterOuterBrush="{TemplateBinding FilterOuterBrush}"
                                                                      IsChecked="{Binding Path=IsDropDownOpen,
                                                                                          Mode=TwoWay,
                                                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                                                      IsFilterApplied="{TemplateBinding IsFilterApplied}"
                                                                      Style="{StaticResource LegacyStyleToggleButton}"
                                                                      Visibility="{Binding Path=FilterButtonVisibility,
                                                                                           Mode=TwoWay,
                                                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                                                      gridcommon:VisualContainer.WantsMouseInput="True" />

                                    <!--  ExcelLike Filtering  -->
                                    <local:GridDataExcelLikeFilterPane x:Name="PART_FilterDropDown"
                                                                       IsOpen="{Binding Path=IsDropDownOpen,
                                                                                        Mode=TwoWay,
                                                                                        RelativeSource={RelativeSource TemplatedParent}}"
                                                                       Visibility="{Binding Path=ExcelLikeFilterPaneVisibility,
                                                                                            Mode=TwoWay,
                                                                                            RelativeSource={RelativeSource TemplatedParent}}"
                                                                       gridcommon:VisualContainer.WantsMouseInput="True" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="0"
                                  Grid.Column="3"
                                  Width="20"
                                  Height="20"
                                  Background="Transparent">
                                <ToggleButton Name="optionsButton"
                                              Grid.Row="0"
                                              Grid.Column="0"
                                              Margin="2"
                                              Background="{TemplateBinding ColumnOptionsButtonBackground}"
                                              IsChecked="{Binding Path=IsColumnOptionsDropDownOpen,
                                                                  Mode=TwoWay,
                                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                              Style="{StaticResource LegacyOptionButtonStyle}"
                                              ToolTip="Show Column Options"
                                              Visibility="{Binding Path=ColumnOptionsButtonVisibility,
                                                                   Mode=TwoWay,
                                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                              gridcommon:VisualContainer.WantsMouseInput="True" />
                                <Popup Name="PART_Popup"
                                       AllowsTransparency="true"
                                       Placement="Bottom"
                                       PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                                       StaysOpen="False">
                                    <Popup.IsOpen>
                                        <MultiBinding Converter="{StaticResource isOpenConverter}">
                                            <Binding Mode="TwoWay"
                                                     Path="IsDropDownOpen"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Mode="OneWay"
                                                     Path="IsAdvanceFiltering"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Popup.IsOpen>
                                    <theme:SystemDropShadowChrome Name="Shdw"
                                                                  MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}"
                                                                  Color="Transparent">

                                        <Grid>

                                            <Border x:Name="PART_DropDownBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1"
                                                    Visibility="Visible" />
                                        </Grid>
                                    </theme:SystemDropShadowChrome>
                                    <Popup.Style>
                                        <Style TargetType="{x:Type Popup}">
                                            <Setter Property="StaysOpen" Value="False" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=PART_DropDownBorder}" Value="True">
                                                    <Setter Property="StaysOpen" Value="True" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=PART_DropDownBorder}" Value="False">
                                                    <Setter Property="StaysOpen" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Popup.Style>
                                </Popup>
                            </Grid>
                            <Popup Name="PART_ColumnOptionsPopup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding Path=IsColumnOptionsDropDownOpen,
                                                    RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="MousePoint"
                                   SnapsToDevicePixels="True"
                                   StaysOpen="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger SourceName="PART_Popup" Property="Popup.HasDropShadow" Value="true">
                            <Setter TargetName="Shdw" Property="Margin" Value="0,0,5,5" />
                            <Setter TargetName="Shdw" Property="SnapsToDevicePixels" Value="true" />
                            <Setter TargetName="Shdw" Property="Color" Value="#71000000" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="true">
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="IsTabStop" Value="false" />
                        </Trigger>

                        <Trigger Property="IsAdvanceFiltering" Value="True">
                            <Setter TargetName="PART_FilterDropDown" Property="Visibility" Value="Collapsed" />
                        </Trigger>


                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HoverBackground}" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>