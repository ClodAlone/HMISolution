<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Grid"
                    xmlns:s="clr-namespace:System;assembly=mscorlib"
                    xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF">
    <local:TextAlignmentConverter x:Key="textAlignmentConverter" />
    <local:GridDataMinWidthConverter x:Key="MinWidthConverter" />
    <ControlTemplate x:Key="GridTreeControlTemplate" TargetType="{x:Type local:GridTreeControl}">
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ScrollViewer"
                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <!--  Style="{TemplateBinding ScrollViewerStyle}"  -->
                <local:GridTreeControlImpl Name="PART_GridControl" />
            </ScrollViewer>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="false">
                <!--
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    <Setter Property="Background" Value="#FFF4F4F4"/>
                -->
                <Setter Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Default">
                <Setter Property="VisualStyle" Value="0" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Blue">
                <Setter Property="VisualStyle" Value="1" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Silver">
                <Setter Property="VisualStyle" Value="2" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2007Black">
                <Setter Property="VisualStyle" Value="3" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2003">
                <Setter Property="VisualStyle" Value="4" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Blend">
                <Setter Property="VisualStyle" Value="5" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="ShinyBlue">
                <Setter Property="VisualStyle" Value="10" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="VS2010">
                <Setter Property="VisualStyle" Value="20" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="ShinyRed">
                <Setter Property="VisualStyle" Value="9" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Metro">
                <Setter Property="VisualStyle" Value="23" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2010Blue">
                <Setter Property="VisualStyle" Value="17" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2010Silver">
                <Setter Property="VisualStyle" Value="18" />
            </Trigger>
            <Trigger Property="sfshared:SkinStorage.VisualStyle" Value="Office2010Black">
                <Setter Property="VisualStyle" Value="19" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <DataTemplate x:Key="DefaultTextTemplate">
        <TextBlock Name="PART_TextBlock"
                   HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                   VerticalAlignment="Stretch"
                   OverridesDefaultStyle="False"
                   SnapsToDevicePixels="True"
                   Text="{Binding}"
                   Foreground="{TemplateBinding TextElement.Foreground}"
                   TextAlignment="{TemplateBinding Property=HorizontalAlignment,
                                                   Converter={StaticResource textAlignmentConverter}}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="{Binding Path=Tag,
                                          ElementName=PART_ContentPresenter}" />
    </DataTemplate>

    <Style TargetType="local:GridTreeHeaderCellControl">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="ContentDataTemplate" Value="{StaticResource DefaultTextTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GridTreeHeaderCellControl">
                    <Border Name="PART_MainBorder"
                            Background="{TemplateBinding Background}"
                            ClipToBounds="True"
                            Padding="0">

                        <Grid Name="PART_MainGrid"
                              Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}"
                              SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="0" MinWidth="{Binding Path=SortVisibility, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource MinWidthConverter}}" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="border"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Background="Transparent"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Grid.Column="0"
                                                  Margin="2,2,0,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Text}"
                                                  ContentTemplate="{TemplateBinding ContentDataTemplate}"
                                                  Tag="NoWrap" />

                            </Border>
                            <Border x:Name="border1"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="{x:Static local:GridTreeHeaderCellControl.MinimumWidth}"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True"
                                    Visibility="{Binding Path=SortVisibility,
                                                         Mode=TwoWay,
                                                         RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="10.84"
                                          Height="9.87"
                                          Margin="5,0,0,0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="{TemplateBinding SortPath}"
                                          Fill="{TemplateBinding SortBrush}"
                                          SnapsToDevicePixels="True"
                                          Stretch="Fill" />
                                </Grid>
                            </Border>

                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="border" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_MainBorder" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HoverBackground}" />
                            <Setter TargetName="PART_ContentPresenter" Property="TextElement.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent},Path=HoverForeground}"/>  
                        </Trigger>
                        <Trigger SourceName="border1" Property="IsMouseOver" Value="True">
                            <Setter TargetName="border1" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SortWidgetBorderHoverBackgroundBrush}" />

                            <Setter TargetName="border1" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SortWidgetBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="GridTreeControlImplStyle" TargetType="{x:Type local:GridTreeControl}">
        <Setter Property="Template" Value="{StaticResource GridTreeControlTemplate}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="{x:Static ScrollBarVisibility.Auto}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="{x:Static ScrollBarVisibility.Auto}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="BorderThickness" Value="1,1,1,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    </Style>

    <Style BasedOn="{StaticResource GridTreeControlImplStyle}" TargetType="{x:Type local:GridTreeControl}" />

</ResourceDictionary>
