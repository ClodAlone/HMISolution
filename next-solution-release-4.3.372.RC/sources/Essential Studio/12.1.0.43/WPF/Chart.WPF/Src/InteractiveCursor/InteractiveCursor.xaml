<ResourceDictionary
    xmlns:local="clr-namespace:Syncfusion.Windows.Chart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <local:ContentConverter x:Key="contentConverter"/>
    <DataTemplate x:Key="VerticalLabelTemplate">
        <Border Name="Border" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplatedParent.Background}"
                     BorderBrush="#888" BorderThickness="1">
            <TextBlock Text="{Binding Converter={StaticResource contentConverter},ConverterParameter=Y}" Padding="2" Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplatedParent.Foreground}"/>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="HorizontalLabelTemplate">
        <Border Margin="0,2,0,0" Name="Border" Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplatedParent.Background}"
                    BorderBrush="#888" BorderThickness="1">
            <TextBlock Text="{Binding Converter={StaticResource contentConverter},ConverterParameter=X}" Padding="2" Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplatedParent.Foreground}"/>
        </Border>
    </DataTemplate>

    <Style TargetType="{x:Type local:InteractiveCursor}">
        <Setter  Property="VerticalCursorTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Line Cursor="{Binding Cursor,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}" 
                              X1="{Binding OffsetX,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}" 
                              X2="{Binding OffsetX,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}" 
                              Y1="0" 
                              Y2="{Binding ActualHeight,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}"
                              Stroke="{Binding VerticalCursorStroke,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}" StrokeThickness="{Binding CursorStrokeThickness,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}"
                              Visibility="{Binding VerticalCursorVisibility,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}" x:Name="VLine"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalCursorTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Line Cursor="{Binding Cursor,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}" 
                              X1="0"
                              X2="{Binding ActualWidth,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}" 
                              Y1="{Binding OffsetY,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}" 
                              Y2="{Binding OffsetY,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}"
                              Stroke="{Binding HorizontalCursorStroke,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}" StrokeThickness="{Binding CursorStrokeThickness,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}"
                              Visibility="{Binding HorizontalCursorVisibility,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}" x:Name="HLine"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="InteractiveCursorSymbolTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Ellipse Fill="{Binding CursorSymbolStroke,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}"
                             Width="{Binding CursorSymbolWidth,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}" 
                             Height="{Binding CursorSymbolHeight,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:InteractiveCursor}">
                    <Canvas Visibility="{Binding CursorVisibility,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InteractiveCursor}}}" x:Name="IC_canvas">
                        <Canvas x:Name="VerticalCursorCanvas">
                            <ContentPresenter Visibility="{TemplateBinding VerticalCursorVisibility}" ContentTemplate="{TemplateBinding VerticalCursorTemplate}"/>
                        </Canvas>
                        <Canvas x:Name="HorizontalCursorCanvas">
                            <ContentPresenter Visibility="{TemplateBinding HorizontalCursorVisibility}" ContentTemplate="{TemplateBinding HorizontalCursorTemplate}"/>
                        </Canvas>
                        <Canvas x:Name="InteractiveCursorSymbolCanvas">
                            <ContentPresenter Canvas.Left="{TemplateBinding LeftPosition}" Content="{TemplateBinding DataPoint}" Canvas.Top="{TemplateBinding TopPosition}" Visibility="{TemplateBinding InteractiveCursorSymbolVisibility}" ContentTemplate="{TemplateBinding InteractiveCursorSymbolTemplate}"/>
                        </Canvas>
                        <Rectangle x:Name="Rect"  Fill="LightGreen" Opacity="0.25" Visibility="Collapsed"/>
                        <Rectangle x:Name="Rect1"  Fill="LightGreen" Opacity="0.25" Visibility="Collapsed"/>
                        <ContentPresenter  Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ContentPresenter Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>
