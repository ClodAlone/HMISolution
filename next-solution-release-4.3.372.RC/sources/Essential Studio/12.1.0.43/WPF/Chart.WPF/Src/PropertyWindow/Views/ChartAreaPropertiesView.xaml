<UserControl x:Class="Syncfusion.Windows.Chart.ChartAreaPropertiesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"  Loaded="UserControl_Loaded"             
             xmlns:local="clr-namespace:Syncfusion.Windows.Chart" xmlns:sync="clr-namespace:Syncfusion.Windows.Tools;assembly=Syncfusion.Shared.Wpf" xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero">
             
    <UserControl.Resources>
        <local:ChartResourceWrapper x:Key="ResourceWrapper"/>
        <local:LegendEnableConverter x:Key="LegendPropertiesEnableConverterKey"/>
        <local:PropertyDialogHeaderConverter x:Key="PropertyDialogHeaderConverterKey"/>
        <local:PropertyDialogHeaderConverter x:Key="PropertyDialogHeaderConverterKey1"/>
        <local:ChartControlsNameConverter x:Key="ChartControlsNameConverterKey"/>
       
    </UserControl.Resources>
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Width="320" HorizontalAlignment="Left" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
            
                <GroupBox VerticalAlignment="Top" Margin="0,5,5,0" >
                    <GroupBox.Header>
                        <Label Content="{Binding Source={StaticResource ResourceWrapper}, Path=SelectChartArea}" FontSize="16"/>
                    </GroupBox.Header>
                    <ComboBox x:Name="ChartAreasList"   ItemsSource="{Binding Areas, Mode=TwoWay, Converter={StaticResource ChartControlsNameConverterKey}}" Margin="55,5,50,5" TabIndex="0" DisplayMemberPath="Name" SelectedIndex="0"/>
                </GroupBox>
                <GroupBox Grid.Row="1" Margin="0,0,5,0"  DataContext="{Binding ElementName=ChartAreasList, Path=SelectedItem}">
                    <GroupBox.Header>
                        <Label Content="{Binding Source={StaticResource ResourceWrapper}, Path=Settings}"  FontSize="16"/>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        
                        <Expander Margin="0,5,5,0" >
                            <Expander.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Source={StaticResource ResourceWrapper}, Path=HeaderSettings}" Margin="0,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.46*" />
                                    <ColumnDefinition Width="0.6*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27"/>
                                </Grid.RowDefinitions>
                                <Label VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper}, Path=Header}" HorizontalAlignment="Left" Grid.Column="0"></Label>
                                <TextBox Grid.Column="1" HorizontalAlignment="Left" Text="{Binding Header, Mode=TwoWay, Converter={StaticResource PropertyDialogHeaderConverterKey}}"/>
                            </Grid>
                        </Expander>
                        <Expander Grid.Row="1" Margin="0,5,5,0" >
                            <Expander.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Source={StaticResource ResourceWrapper}, Path=Appearance}" Margin="0,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <Grid Margin="0,5,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.46*" />
                                    <ColumnDefinition Width="0.6*" />
                                </Grid.ColumnDefinitions>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=Background}" HorizontalAlignment="Left" Grid.Column="0"></Label>
                                <syncfusion:ColorPicker Margin="2,0,0,0" HorizontalAlignment="Left"  Grid.Column="1"  Brush="{Binding Background, Mode=TwoWay}"/>
                                <Label  VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=BorderBrush}" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0"></Label>
                                <syncfusion:ColorPicker Margin="2,0,0,0" HorizontalAlignment="Left"   Grid.Row="1" Grid.Column="1"  Brush="{Binding BorderBrush, Mode=TwoWay}"/>
                                <Label VerticalAlignment="Center"   Content="{Binding Source={StaticResource ResourceWrapper}, Path=BorderThickness}" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="0"></Label>
                                <TextBox  HorizontalAlignment="Left"   Text="{Binding BorderThickness, Mode=TwoWay}" Grid.Column="1" Grid.Row="2"/>
                                <Label  VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=CornerRadius}" HorizontalAlignment="Left" Grid.Row="3" Grid.Column="0"></Label>
                                <TextBox  HorizontalAlignment="Left"   Text="{Binding CornerRadius, Mode=TwoWay}" Grid.Column="1" Grid.Row="3"/>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=Foreground}" HorizontalAlignment="Left" Grid.Row="4" Grid.Column="0"></Label>
                                <syncfusion:ColorPicker Margin="2,0,0,0"  HorizontalAlignment="Left"   Grid.Column="1" Grid.Row="4" Brush="{Binding Foreground, Mode=TwoWay}"/>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=Margin}" HorizontalAlignment="Left" Grid.Row="5" Grid.Column="0"></Label>
                                <TextBox  HorizontalAlignment="Left"   Text="{Binding Margin, Mode=TwoWay}" Grid.Column="1" Grid.Row="5"/>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=Padding}" HorizontalAlignment="Left" Grid.Row="6" Grid.Column="0"></Label>
                                <TextBox  HorizontalAlignment="Left"  Text="{Binding Padding, Mode=TwoWay}" Grid.Column="1" Grid.Row="6"/>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=GridBackground}" Grid.Row="7" HorizontalAlignment="Left" Grid.Column="0"></Label>
                                <syncfusion:ColorPicker Margin="2,0,0,0" HorizontalAlignment="Left"  Grid.Column="1"  Brush="{Binding GridBackground, Mode=TwoWay}"  Grid.Row="7"/>

                            </Grid>
                        </Expander>
                        <Expander Grid.Row="2" Margin="0,5,5,0" >
                            <Expander.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Source={StaticResource ResourceWrapper}, Path=GridRegionProperties}" Margin="0,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                   <ColumnDefinition Width="0.46*" />
                                    <ColumnDefinition Width="0.6*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27"/>
                                    <RowDefinition Height="27"/>
                                    <RowDefinition Height="27"/>
                                    <RowDefinition Height="27"/>
                                </Grid.RowDefinitions>
                               <!--<CheckBox Content="EnableAlternative Grid Background" Grid.ColumnSpan="2" Grid.Row="1" Margin="5,0,0,0" IsChecked="{Binding SelectedModel.AlternativeGridBackgound}" VerticalAlignment="Center"/>-->
                                <Label VerticalAlignment="Center"  Grid.Row="1" Content="{Binding Source={StaticResource ResourceWrapper}, Path=AlternatingBackgoundMode}" HorizontalAlignment="Left" Grid.Column="0"></Label>
                                <ComboBox HorizontalAlignment="Left" Margin="4,0,0,0" x:Name="AlternatingFillMode" Grid.Column="1" SelectedItem="{Binding AlternatingFillMode, Mode=TwoWay}" />
                                <Label VerticalAlignment="Center"  Grid.Row="0"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=AlternatingBackgoundDirection}" HorizontalAlignment="Left" Grid.Column="0" ></Label>
                                <ComboBox  Margin="4,0,0,0" HorizontalAlignment="Left"  x:Name="AlternatingFillDirection" Grid.Column="1" SelectedItem="{Binding AlternatingFillDirection, Mode=TwoWay}" Grid.Row="1" />
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=AlternativeGridBackground}" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="2"></Label>
                                <syncfusion:ColorPicker  Margin="4,0,0,0" HorizontalAlignment="Left"  Grid.Column="1"  Brush="{Binding AlternatingGridBackground, Mode=TwoWay}" Grid.Row="2" />
                            </Grid>
                        </Expander>
                        <Expander Grid.Row="3" Margin="0,5,5,0" >
                            <Expander.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Source={StaticResource ResourceWrapper}, Path=InteractiveFeatures}" Margin="0,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.4*" />
                                    <ColumnDefinition Width="0.6*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27"/>
                                    <RowDefinition Height="27"/>
                                </Grid.RowDefinitions>
                                <CheckBox Content="{Binding Source={StaticResource ResourceWrapper}, Path=EnableZoomOnScroll}" Margin="5,0,0,0"  IsChecked="{Binding EnableZoomOnScroll, Mode=TwoWay}" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
                                <CheckBox Content="{Binding Source={StaticResource ResourceWrapper}, Path=EnableContextMenu}" Margin="5,0,0,0" IsChecked="{Binding IsContextMenuEnabled, Mode=TwoWay}" VerticalAlignment="Center" Grid.Row="1" Grid.ColumnSpan="2"/>
                            </Grid>
                        </Expander>
                        <Expander Grid.Row="4" Margin="0,5,5,0" x:Name="Legend" IsEnabled="{Binding Legend, Converter = {StaticResource LegendPropertiesEnableConverterKey}}">
                            <Expander.Header>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Source={StaticResource ResourceWrapper}, Path=ChartAreaLegend}" Margin="0,0,0,0" />
                                </StackPanel>
                            </Expander.Header>
                            <Grid Margin="0,10,0,0" DataContext="{Binding Legend}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                    <RowDefinition Height="27" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.47*" />
                                    <ColumnDefinition Width="0.6*" />
                                </Grid.ColumnDefinitions>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=Background}" HorizontalAlignment="Left" Grid.Column="0"></Label>
                                <syncfusion:ColorPicker Grid.Column="1"  Brush="{Binding Background, Mode=TwoWay}"/>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=BorderBrush}" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0"></Label>
                                <syncfusion:ColorPicker Grid.Row="1" Grid.Column="1"  Brush="{Binding BorderBrush, Mode=TwoWay}"/>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=BorderThickness}" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="0"></Label>
                                <TextBox Text="{Binding BorderThickness}" Grid.Column="1" Grid.Row="2"/>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=CornerRadius}" HorizontalAlignment="Left" Grid.Row="3" Grid.Column="0"></Label>
                                <TextBox Text="{Binding CornerRadius}" Grid.Column="1" Grid.Row="3"/>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=Foreground}" HorizontalAlignment="Left" Grid.Row="4" Grid.Column="0"></Label>
                                <syncfusion:ColorPicker Grid.Column="1" Grid.Row="4"  Brush="{Binding Foreground, Mode=TwoWay}"/>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=Margin}" HorizontalAlignment="Left" Grid.Row="5" Grid.Column="0"></Label>
                                <TextBox Text="{Binding Margin, Mode=TwoWay}" Grid.Column="1" Grid.Row="5"/>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=Padding}" HorizontalAlignment="Left" Grid.Row="6" Grid.Column="0"></Label>
                                <TextBox Text="{Binding Padding, Mode=TwoWay}" Grid.Column="1" Grid.Row="6"/>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=CheckBoxVisibility}" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="7"></Label>
                                <ComboBox x:Name="CheckBoxVisibility" Grid.Column="1" Grid.Row="7" SelectedItem="{Binding CheckBoxVisibility, Mode=TwoWay}"/>
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=IconVisibility}" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="8"></Label>
                                <ComboBox x:Name="IconVisibility" Grid.Column="1" Grid.Row="8" SelectedItem="{Binding IconVisibility, Mode=TwoWay}"/>
                                <!--<Label Content="{Binding Source={StaticResource ResourceWrapper}, Path=ShowSymbol}" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="8"></Label>
                                <ComboBox x:Name="IconVisibility" Grid.Column="1" Grid.Row="8" SelectedItem="{Binding ShowSymbol, Mode=TwoWay}"/>-->
                                <Label VerticalAlignment="Center"  Content="{Binding Source={StaticResource ResourceWrapper}, Path=Header}" HorizontalAlignment="Left" Grid.Row="9" Grid.Column="0"></Label>
                                <TextBox Text="{Binding Header, Mode=TwoWay, Converter={StaticResource PropertyDialogHeaderConverterKey1}}" Grid.Column="1" Grid.Row="9"/>
                                <Label VerticalAlignment="Center"  Content="Legend Dock Position :" HorizontalAlignment="Left" Grid.Row="10" Grid.Column="0"></Label>
                                <ComboBox x:Name="DockPosition" SelectionChanged="DockPosition_SelectionChanged" Grid.Column="1" Grid.Row="10" />
                            </Grid>
                        </Expander>
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

    