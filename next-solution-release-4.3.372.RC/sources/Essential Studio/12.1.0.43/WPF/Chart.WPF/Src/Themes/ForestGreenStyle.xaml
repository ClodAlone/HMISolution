        <GradientStop Color="Green" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="DarkBlue" x:Key="ForestGreen.BorderBackground"/>
    
<SolidColorBrush Color="DarkBlue" x:Key="ForestGreen.ChartBorderBackground"/>

