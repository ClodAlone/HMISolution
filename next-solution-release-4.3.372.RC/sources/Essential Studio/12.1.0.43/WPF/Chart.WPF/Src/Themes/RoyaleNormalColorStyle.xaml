<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Chart"
                    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Wpf">

    <ResourceDictionary.MergedDictionaries>
        <local:SharedResourceDictionary Source="/Syncfusion.Chart.Wpf;component/Themes/Generic.Common.Converter.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    
    <LinearGradientBrush x:Key="Royale.NormalColor.WindowBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFFFF" Offset="0"/>
    <GradientStop Color="#FFA6B8CF" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush Color="#C0BFBB" x:Key="Royale.NormalColor.BorderBackground"/>

  <SolidColorBrush Color="#FFE3EBF3" x:Key="Royale.NormalColor.ChartBackground"/>

  <Pen Brush="#000000" x:Key="Royale.NormalColor.AxisPen"/>
  
  <LinearGradientBrush x:Key="Royale.NormalColor.LegendBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFFFF" Offset="0"/>
    <GradientStop Color="#FFE3EBF3" Offset="0.5"/>
    <GradientStop Color="#FFD0DCEB" Offset="0.5"/>
    <GradientStop Color="#FFA6B8CF" Offset="1"/>
  </LinearGradientBrush>

    <SolidColorBrush x:Key="Royale.NormalColor.LegendForeground"
                   Color="#000000"/>
    
    <SolidColorBrush x:Key="Royale.NormalColor.LegendBorderBackground"
                   Color="#C0BFBB"/>
  <CornerRadius x:Key="Royale.NormalColor.LegendCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>
    <SolidColorBrush x:Key="Royale.NormalColor.ToolBarBackground" 
                      Color="#dfecfd"/>
    <LinearGradientBrush x:Key="Royale.NormalColor.ToolBarHeaderBackground"  StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#f2f6f8" Offset="0"/>
            <GradientStop Color="#adc2d4" Offset="1"/>

        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Royale.NormalColor.ToolBarBorderBackground" 
                      Color="#97acbf"/>
    <SolidColorBrush x:Key="Royale.NormalColor.ToolBarItemBackground" 
                      Color="Transparent"/>

    <SolidColorBrush x:Key="Royale.NormalColor.ToolBarItemForeground" 
                      Color="#5C6E7D"/>

    <SolidColorBrush x:Key="Royale.NormalColor.ToolBarGlyphColor" 
                      Color="#91A1AF"/>

    <CornerRadius x:Key="Royale.NormalColor.ToolBarCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>


    <SolidColorBrush x:Key="Royale.NormalColor.ToolBarMouseOverBorderBrush" Color="#FFCCECFF"/>


    <LinearGradientBrush x:Key="Royale.NormalColor.ToolBarMouseOverBackground"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#dfecfd" Offset="0"/>
            <GradientStop Color="#d1d8e8" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Royale.NormalColor.ToolBarSelectedBrush"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#889eb3" Offset="0"/>
            <GradientStop Color="#dfecfd" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Royale.NormalColor.AreaBorderBackground"
                   Color="#C0BFBB"/>
  <LinearGradientBrush x:Key="Royale.NormalColor.AreaBackground" 
                       StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFFFF" Offset="0"/>
    <GradientStop Color="#FFE3EBF3" Offset="0.2"/>
    <GradientStop Color="#FFD0DCEB" Offset="0.8"/>
    <GradientStop Color="#FFA6B8CF" Offset="1"/>
  </LinearGradientBrush>
  <CornerRadius x:Key="Royale.NormalColor.AreaCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>
  <Thickness x:Key="Royale.NormalColor.AreaPadding" 
             Top="10" Bottom="10" Left ="10" Right="10"/>
  <Thickness x:Key="Royale.NormalColor.AreaBorderThickness" 
             Bottom="2" Left="2" Right="2" Top="2"/>

    <Style TargetType="{x:Type local:Chart}" x:Key="RoyaleNormalColorChartStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Royale.NormalColor.BorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Royale.NormalColor.ChartBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Pen Brush="#000000" x:Key="RoyaleNormalColorChartAreaAxisPen"/>

    <Pen  x:Key="RoyaleNormalColorSmallChartAreaAxisPen">
        <Pen.Brush>
            <SolidColorBrush Color="#000000" Opacity="0.2"/>
        </Pen.Brush>
    </Pen>

    <Style TargetType="{x:Type local:ChartArea}" x:Key="RoyaleNormalColorChartAreaStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="local:ChartArea.GridLineStroke" Value="{StaticResource RoyaleNormalColorChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartArea.GridLineStroke" Value="{StaticResource RoyaleNormalColorSmallChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartAxis.LineStroke" Value="{StaticResource RoyaleNormalColorChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartAxis.TickLineStroke" Value="{StaticResource RoyaleNormalColorChartAreaAxisPen}"/>
        <Setter Property="local:ChartAxis.SmallTickLineStroke" Value="{StaticResource RoyaleNormalColorChartAreaAxisPen}"/>
        <Setter Property="IsTabStop" Value="False"/>

        <Setter Property="Background" Value="{StaticResource Royale.NormalColor.AreaBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Royale.NormalColor.AreaBorderBackground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Royale.NormalColor.AreaCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource Royale.NormalColor.AreaPadding}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Royale.NormalColor.AreaBorderThickness}"/>
        <Setter Property="GridBackground" Value="{x:Null}"/>


    </Style>

    <Style TargetType="{x:Type local:ChartLegend}" x:Key="RoyaleNormalColorChartLegendStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Royale.NormalColor.LegendBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Royale.NormalColor.LegendBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Royale.NormalColor.LegendForeground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Royale.NormalColor.LegendCornerRadius}"/>
    </Style>

    <Style TargetType="{x:Type local:ChartToolBar}" x:Key="RoyaleNormalColorChartToolBarStyle">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Royale.NormalColor.ToolBarBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Royale.NormalColor.ToolBarBackground}"/>
        <Setter Property="HeaderBackground" Value="{StaticResource Royale.NormalColor.ToolBarHeaderBackground}"/>

        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel  Orientation="{Binding ItemsOrientation, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartToolBar}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChartToolBar}">
                    <Border  Margin="5" BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"                  
                             Padding="{TemplateBinding Padding}"
                             Background="{TemplateBinding Background}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--Header Area with close Button-->
                            <Grid Height="20" Grid.Row="0" Background="{TemplateBinding HeaderBackground}"   Visibility="{TemplateBinding TitleBarVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85*" />
                                    <ColumnDefinition Width="15" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PART_ToolBarCloseButton" Grid.Column="1" Visibility="{TemplateBinding CloseButtonVisibility}" Width="15" Height="15" Command="ApplicationCommands.Close" Margin="1"  >
                                    <Button.Template>
                                        <ControlTemplate>
                                            <Border x:Name="CloseButtonBorder"  BorderBrush="#9D9DA1" CornerRadius="1" Background="Transparent">
                                                <Image HorizontalAlignment="Center" VerticalAlignment="Center" Source="pack://application:,,,/Syncfusion.Chart.Wpf;component//Resources/closemc.ico" Height="16" Width="16" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" TargetName="CloseButtonBorder" Value="{StaticResource Royale.NormalColor.ToolBarMouseOverBackground}" />
                                                    <Setter Property="BorderBrush" TargetName="CloseButtonBorder"  Value="{StaticResource Royale.NormalColor.ToolBarMouseOverBorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <!--ItemsPresenter to host Chart ToolBarItem-->
                            <ItemsPresenter x:Name="ToolBarItemsPanel"  Grid.Row="1"  />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ToolBarItem}" x:Key="RoyaleNormalColorToolBarItemStyle">
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Royale.NormalColor.ToolBarItemBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Royale.NormalColor.ToolBarItemForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Royale.NormalColor.ToolBarBorderBackground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToolBarItem}">
                    <Border  
                        x:Name="DropownButton" 
                        CornerRadius="2" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid HorizontalAlignment="{TemplateBinding HorizontalAlignment}" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto"  />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--ToolBarITem - Image, Text, DropDown-->
                            <Image Visibility="{TemplateBinding ItemImageSource, Converter={StaticResource ContentTovisibilityConv}}"  Source="{TemplateBinding ItemImageSource}"  Width="16" Height="16" Stretch="UniformToFill" />
                            <TextBlock Foreground="{TemplateBinding Foreground}" Grid.Column="1"  Text="{TemplateBinding Text}" HorizontalAlignment="Left"   />
                            <Image Grid.Column="2" Width="7" Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Forward}" Margin="0,0,0,2" HorizontalAlignment="Right"  VerticalAlignment="Bottom"  Stretch="None" >
                                <Image.Source>
                                    <DrawingImage>
                                        <DrawingImage.Drawing>
                                            <GeometryDrawing  >
                                                <GeometryDrawing.Pen>
                                                    <Pen Thickness="1"  Brush="Black" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <PathGeometry>
                                                            <PathFigure  StartPoint="5,10"  IsFilled="True" IsClosed="True">
                                                                <LineSegment Point="8,10"/>
                                                                <LineSegment Point="6.5,12.5"/>
                                                            </PathFigure>
                                                        </PathGeometry>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingImage.Drawing>
                                    </DrawingImage>
                                </Image.Source>
                            </Image>
                            <Border HorizontalAlignment="Stretch" Grid.ColumnSpan="3" DockPanel.Dock="Left"   >
                                <Popup x:Name="PART_Popup" Placement="Right" Focusable="False"  PopupAnimation="Fade"
                                    AllowsTransparency="True" HorizontalAlignment="Left" StaysOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}"
                                    IsOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}">
                                    <Border Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Reverse}" BorderThickness="1" CornerRadius="2" Background="#FAFAFA" BorderBrush="{TemplateBinding BorderBrush}">
                                        <ItemsPresenter />
                                    </Border>
                                </Popup>
                            </Border>

                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource Royale.NormalColor.ToolBarMouseOverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource Royale.NormalColor.ToolBarSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Chart}" BasedOn="{StaticResource RoyaleNormalColorChartStyle}" />
    <Style TargetType="{x:Type local:ChartArea}" BasedOn="{StaticResource RoyaleNormalColorChartAreaStyle}" />
    <Style TargetType="{x:Type local:ChartLegend}" BasedOn="{StaticResource RoyaleNormalColorChartLegendStyle}" />
    <Style TargetType="{x:Type local:ChartToolBar}" BasedOn="{StaticResource RoyaleNormalColorChartToolBarStyle}" />
    <Style TargetType="{x:Type local:ToolBarItem}" BasedOn="{StaticResource RoyaleNormalColorToolBarItemStyle}" />

</ResourceDictionary>
