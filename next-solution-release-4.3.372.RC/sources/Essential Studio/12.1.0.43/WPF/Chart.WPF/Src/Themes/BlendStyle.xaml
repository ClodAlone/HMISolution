    <SolidColorBrush  x:Key="Blend.LegendBackground" Color="Transparent" />
  

    <SolidColorBrush x:Key="Blend.LegendForeground"
                   Color="White"/>
    <SolidColorBrush x:Key="Blend.LegendBorderBackground"
                   Color="#FFD5D7D8"/>
    <CornerRadius x:Key="Blend.LegendCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>

    <SolidColorBrush x:Key="Blend.ToolBarBackground" 
                      Color="#3A3A3A"/>
    <LinearGradientBrush x:Key="Blend.ToolBarHeaderBackground"  StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#595959" Offset="0"/>
            <GradientStop Color="#595959" Offset="1"/>

        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Blend.ToolBarBorderBackground" 
                      Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Blend.ToolBarItemBackground" 
                      Color="Transparent"/>

    <SolidColorBrush x:Key="Blend.ToolBarItemForeground" 
                      Color="Black"/>

    <SolidColorBrush x:Key="Blend.ToolBarGlyphColor" 
                      Color="#3A3A3A"/>

    <CornerRadius x:Key="Blend.ToolBarCornerRadius" 
                TopLeft="6" BottomLeft="6" BottomRight="6" TopRight="6"/>


    

    <LinearGradientBrush x:Key="Blend.ToolBarMouseOverBackground"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#3A3A3A" Offset="0"/>
            <GradientStop Color="#707070" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Blend.ToolBarSelectedBrush"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#AAAAAA" Offset="0"/>
            <GradientStop Color="#3A3A3A" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Blend.AreaBorderBackground"
                   Color="Transparent"/>
    
    <SolidColorBrush x:Key="Blend.AreaBackground"
                   Color="Transparent"/>
    
  
    
   
    <CornerRadius x:Key="Blend.AreaCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>
    <Thickness x:Key="Blend.AreaPadding" 
             Top="10" Bottom="10" Left ="10" Right="10"/>
    <Thickness x:Key="Blend.AreaBorderThickness" 
             Bottom="1" Left="1" Right="1" Top="1"/>
    <Pen Brush="#B1B1B1" x:Key="Blend.AxisPen"/>
    
    <SolidColorBrush x:Key="Blend.ContextMenuBackground" Color="#FF333333"/>
    <SolidColorBrush x:Key="Blend.ContextMenuBorderBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BlendChartBackgroundBrush" Color="#FF404040"/>
    <Style TargetType="{x:Type local:Chart}" x:Key="BlendChartStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blend.BorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource BlendChartBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Pen Brush="#B1B1B1" x:Key="BlendChartAreaAxisPen"/>

    <Pen  x:Key="BlendSmallChartAreaAxisPen">
        <Pen.Brush>
            <SolidColorBrush Color="#B1B1B1" Opacity="0.2"/>
        </Pen.Brush>
    </Pen>

    <Style TargetType="{x:Type local:ChartArea}" x:Key="BlendChartAreaStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="local:ChartArea.GridLineStroke" Value="{StaticResource BlendChartAreaAxisPen}">
        </Setter>

        <Setter Property="local:ChartArea.SmallGridLineStroke" Value="{StaticResource BlendSmallChartAreaAxisPen}">
        </Setter>

        <Setter Property="local:ChartAxis.LineStroke" Value="{StaticResource BlendChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartAxis.TickLineStroke" Value="{StaticResource BlendChartAreaAxisPen}"/>
        <Setter Property="local:ChartAxis.SmallTickLineStroke" Value="{StaticResource BlendChartAreaAxisPen}"/>
        <Setter Property="IsTabStop" Value="False"/>

        <Setter Property="Background" Value="{StaticResource Blend.AreaBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blend.AreaBorderBackground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Blend.AreaCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource Blend.AreaPadding}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Blend.AreaBorderThickness}"/>
        <Setter Property="GridBackground" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="White"/>

    </Style>

    <Style TargetType="{x:Type local:ChartLegend}" x:Key="BlendChartLegendStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blend.LegendBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Blend.LegendBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Blend.LegendForeground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Blend.LegendCornerRadius}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
    </Style>

    <Style TargetType="{x:Type local:ChartToolBar}" x:Key="BlendChartToolBarStyle">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blend.ToolBarBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Blend.ToolBarBackground}"/>
        <Setter Property="HeaderBackground" Value="{StaticResource Blend.ToolBarHeaderBackground}"/>

        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel  Orientation="{Binding ItemsOrientation, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartToolBar}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChartToolBar}">
                    <Border  Margin="5" BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"                  
                             Padding="{TemplateBinding Padding}"
                             Background="{TemplateBinding Background}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--Header Area with close Button-->
                            <Grid Height="20" Grid.Row="0" Background="{TemplateBinding HeaderBackground}"   Visibility="{TemplateBinding TitleBarVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85*" />
                                    <ColumnDefinition Width="15" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PART_ToolBarCloseButton" Grid.Column="1" Visibility="{TemplateBinding CloseButtonVisibility}" Width="15" Height="15" Command="ApplicationCommands.Close" Margin="1"  >
                                    <Button.Template>
                                        <ControlTemplate>
                                            <Border x:Name="CloseButtonBorder"  BorderBrush="#9D9DA1" CornerRadius="1" Background="Transparent">
                                                <Image HorizontalAlignment="Center" VerticalAlignment="Center" Source="pack://application:,,,/Syncfusion.Chart.Wpf;component//Resources/closemc.ico" Height="16" Width="16" />
                                            </Border>
                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" TargetName="CloseButtonBorder"  Value="{StaticResource Blend.ToolBarMouseOverBackground}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <!--ItemsPresenter to host Chart ToolBarItem-->
                            <ItemsPresenter x:Name="ToolBarItemsPanel"  Grid.Row="1"  />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="{x:Type local:ToolBarItem}" x:Key="BlendToolBarItemStyle">
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Blend.ToolBarItemBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Blend.ToolBarItemForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blend.ToolBarBorderBackground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToolBarItem}">
                    <Border  
                        x:Name="DropownButton" 
                        CornerRadius="2" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid HorizontalAlignment="{TemplateBinding HorizontalAlignment}" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto"  />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--ToolBarITem - Image, Text, DropDown-->
                            <Image Visibility="{TemplateBinding ItemImageSource, Converter={StaticResource ContentTovisibilityConv}}"  Source="{TemplateBinding ItemImageSource}"  Width="16" Height="16" Stretch="UniformToFill" />
                            <TextBlock Foreground="{TemplateBinding Foreground}" Grid.Column="1"  Text="{TemplateBinding Text}" HorizontalAlignment="Left"   />
                            <Image Grid.Column="2" Width="7" Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Forward}" Margin="0,0,0,2" HorizontalAlignment="Right"  VerticalAlignment="Bottom"  Stretch="None" >
                                <Image.Source>
                                    <DrawingImage>
                                        <DrawingImage.Drawing>
                                            <GeometryDrawing  >
                                                <GeometryDrawing.Pen>
                                                    <Pen Thickness="1"  Brush="Black" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <PathGeometry>
                                                            <PathFigure  StartPoint="5,10"  IsFilled="True" IsClosed="True">
                                                                <LineSegment Point="8,10"/>
                                                                <LineSegment Point="6.5,12.5"/>
                                                            </PathFigure>
                                                        </PathGeometry>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingImage.Drawing>
                                    </DrawingImage>
                                </Image.Source>
                            </Image>
                            <Border HorizontalAlignment="Stretch" Grid.ColumnSpan="3" DockPanel.Dock="Left"   >
                                <Popup x:Name="PART_Popup" Placement="Right" Focusable="False"  PopupAnimation="Fade"
                                    AllowsTransparency="True" HorizontalAlignment="Left" StaysOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}"
                                    IsOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}">
                                    <Border Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Reverse}" BorderThickness="1" CornerRadius="2" Background="#FAFAFA" BorderBrush="{TemplateBinding BorderBrush}">
                                        <ItemsPresenter />
                                    </Border>
                                </Popup>
                            </Border>

                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource Blend.ToolBarMouseOverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource Blend.ToolBarSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BlendChartAreaContextMenuStyle" TargetType="{x:Type local:ChartAreaContextMenu}">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MenuFontFamilyKey}}"/>
        <Setter Property="FontSize" Value="{DynamicResource {x:Static SystemFonts.MenuFontSizeKey}}"/>
        <Setter Property="FontStyle" Value="{DynamicResource {x:Static SystemFonts.MenuFontStyleKey}}"/>
        <Setter Property="FontWeight" Value="{DynamicResource {x:Static SystemFonts.MenuFontWeightKey}}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="true"/>
        <Setter Property="HasDropShadow" Value="{DynamicResource {x:Static SystemParameters.DropShadowKey}}"/>

        <Setter Property="Background" Value="{StaticResource Blend.ContextMenuBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blend.ContextMenuBorderBrush}"/>
        <Setter Property="Template" Value="{StaticResource BlendChartAreaContextMenu}">
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Chart}" BasedOn="{StaticResource BlendChartStyle}" />
    <Style TargetType="{x:Type local:ChartArea}" BasedOn="{StaticResource BlendChartAreaStyle}" />
    <Style TargetType="{x:Type local:ChartLegend}" BasedOn="{StaticResource BlendChartLegendStyle}" />
    <Style TargetType="{x:Type local:ChartToolBar}" BasedOn="{StaticResource BlendChartToolBarStyle}" />
    <Style TargetType="{x:Type local:ToolBarItem}" BasedOn="{StaticResource BlendToolBarItemStyle}" />
</ResourceDictionary>    
