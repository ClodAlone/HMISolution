    <SolidColorBrush Color="Transparent" x:Key="Office2007Blue.LegendBackground" />
    <SolidColorBrush x:Key="Office2007Blue.LegendForeground"
                   Color="DarkBlue"/>
    
    <SolidColorBrush x:Key="Office2007Blue.LegendBorderBackground"
                   Color="#FF4670AF"/>
    <CornerRadius x:Key="Office2007Blue.LegendCornerRadius" 
                TopLeft="6" BottomLeft="6" BottomRight="6" TopRight="6"/>
<SolidColorBrush x:Key="Office2007Blue.ToolBarBackground" 
                      Color="#e6f0fc"/>
    <LinearGradientBrush x:Key="Office2007Blue.ToolBarHeaderBackground"  StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#e0edff" Offset="0"/>
            <GradientStop Color="#b1d3ff" Offset="1"/>

        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
