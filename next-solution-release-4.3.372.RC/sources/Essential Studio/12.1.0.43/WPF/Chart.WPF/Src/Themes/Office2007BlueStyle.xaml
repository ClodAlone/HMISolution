                      Color="#6593cf"/>
    <SolidColorBrush x:Key="Office2007Blue.ToolBarItemBackground" 
                      Color="Transparent"/>

    <SolidColorBrush x:Key="Office2007Blue.ToolBarItemForeground" 
                      Color="Black"/>

    <SolidColorBrush x:Key="Office2007Blue.ToolBarGlyphColor" 
                      Color="Transparent"/>

    <CornerRadius x:Key="Office2007Blue.ToolBarCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>


    <SolidColorBrush x:Key="Office2007Blue.ToolBarMouseOverBorderBrush" Color="#6593cf"/>


