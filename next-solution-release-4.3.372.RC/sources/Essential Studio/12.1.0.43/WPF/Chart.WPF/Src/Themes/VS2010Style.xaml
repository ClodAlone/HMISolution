<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Chart"
                    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Wpf">
    <ResourceDictionary.MergedDictionaries>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/Themes/Generic.Common.Converter.xaml"/>
    </ResourceDictionary.MergedDictionaries>




    <SolidColorBrush Color="Transparent" x:Key="VS2010.BorderBackground"/>
    <LinearGradientBrush x:Key="VS2010.ChartBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF8C9AB1"/>
        <GradientStop Color="#FF60708A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VS2010.LegendBackground" EndPoint="0.5,0" StartPoint="0.5,1">
        <GradientStop Color="#FFD4D8DE" Offset="0.996"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="VS2010.LegendForeground"
                   Color="#FF7C8BA2"/>
    <SolidColorBrush x:Key="VS2010.LegendBorderBackground"
                   Color="#FF35496A"/>
    <CornerRadius x:Key="VS2010.LegendCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>

    <SolidColorBrush x:Key="VS2010.ToolBarBackground" 
                      Color="#FFBCC7D8"/>
    <SolidColorBrush x:Key="VS2010.ToolBarHeaderBackground" 
                      Color="#FF475B7E"/>
    <SolidColorBrush x:Key="VS2010.ToolBarBorderBackground" 
                      Color="#FF35496A"/>
    <SolidColorBrush x:Key="VS2010.ToolBarItemBorderBackground" 
                      Color="Transparent"/>
    <SolidColorBrush x:Key="VS2010.ToolBarItemBackground" 
                      Color="Transparent"/>

    <SolidColorBrush x:Key="VS2010.ToolBarItemForeground" 
                      Color="Black"/>

    <SolidColorBrush x:Key="VS2010.ToolBarGlyphColor" 
                      Color="#FFFFFFFF"/>

    <CornerRadius x:Key="VS2010.ToolBarCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>

    <LinearGradientBrush x:Key="VS2010.ToolBarMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFCF2" Offset="0.045"/>
        <GradientStop Color="#FFFFF3CF" Offset="0.492"/>
        <GradientStop Color="#FFFFECB5" Offset="0.496"/>
        <GradientStop Color="#FFFFECB5" Offset="0.99"/>
        <GradientStop Color="#FFE5C365" Offset="0.995"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="VS2010.ToolBarMouseOverBorder" 
                      Color="#FFE5C365"/>
    <SolidColorBrush x:Key="VS2010.ToolBarSelectedBrush" 
                      Color="#FFFFE8A6"/>

    <SolidColorBrush x:Key="VS2010.AreaBorderBackground"
                   Color="Transparent"/>

    <LinearGradientBrush x:Key="VS2010.AreaBackground" EndPoint="0.5,-0.0399999991059303" StartPoint="0.5,0.0509999990463257">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="#FFABB4C2" Offset="0.683"/>
        <GradientStop Color="#FFA8D899" Offset="1"/>
    </LinearGradientBrush>

    <CornerRadius x:Key="VS2010.AreaCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>
    <Thickness x:Key="VS2010.AreaPadding" 
             Top="10" Bottom="10" Left ="10" Right="10"/>
    <Thickness x:Key="VS2010.AreaBorderThickness" 
             Bottom="1" Left="1" Right="1" Top="1"/>
    <Pen Brush="Red" x:Key="VS2010.AxisPen"/>

    <SolidColorBrush x:Key="VS2010.ContextMenuBackground" Color="#FF333333"/>
    <SolidColorBrush x:Key="VS2010.ContextMenuBorderBrush" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="ToolTipBorderBrushKey" Color="#FF767676"/>

    <LinearGradientBrush x:Key="ToolTipBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFCFCFD" Offset="0.134"/>
        <GradientStop Color="#FFE4E5F0" Offset="0.992"/>
        <GradientStop Color="#FF767676" Offset="1"/>
    </LinearGradientBrush>
    <Style TargetType="{x:Type local:Chart}" x:Key="VS2010ChartStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource VS2010.BorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource VS2010.ChartBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <!--<Setter Property="DataContext" Value="{Binding}"/>-->
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Pen Brush="Red" x:Key="VS2010ChartAreaAxisPen"/>

    <Pen  x:Key="VS2010SmallChartAreaAxisPen">
        <Pen.Brush>
            <SolidColorBrush Color="Yellow" Opacity="1"/>
        </Pen.Brush>
    </Pen>

    <Pen Brush="#FF35496A" x:Key="gridlinestroke" Thickness="1" />

    <Style TargetType="{x:Type local:ChartArea}" x:Key="VS2010ChartAreaStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <!--<Setter Property="local:ChartArea:ShowGridLines" Value="False"/>-->
        <Setter Property="local:ChartArea.GridLineStroke" Value="{StaticResource VS2010ChartAreaAxisPen}">
        </Setter>

        <Setter Property="local:ChartArea.SmallGridLineStroke" Value="{StaticResource VS2010SmallChartAreaAxisPen}">
        </Setter>

        <Setter Property="local:ChartAxis.LineStroke" Value="{StaticResource VS2010ChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartAxis.TickLineStroke" Value="{StaticResource VS2010ChartAreaAxisPen}"/>
        <Setter Property="local:ChartAxis.SmallTickLineStroke" Value="{StaticResource VS2010ChartAreaAxisPen}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource VS2010.AreaBorderBackground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource VS2010.AreaCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource VS2010.AreaPadding}"/>
        <Setter Property="BorderThickness" Value="{StaticResource VS2010.AreaBorderThickness}"/>
        <Setter Property="GridBackground" Value="{StaticResource VS2010.AreaBackground}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="PrimaryAxisStyle">
            <Setter.Value>
                <Style TargetType="{x:Type local:ChartAxis}">
                    <Setter Property="LabelForeground" Value="White"/>
                    <Setter Property="LabelFontFamily" Value="Calibri"/>
                    <Setter Property="LabelFontSize" Value="12"/>
                    <!--<Setter Property="local:ChartArea.ShowGridLines" Value="false"/>-->
                    <Setter Property="local:ChartArea.GridLineStroke" Value="{StaticResource gridlinestroke}"/>
                    <Setter Property="LineStroke" Value="{StaticResource gridlinestroke}"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="SecondaryAxisStyle">
            <Setter.Value>
                <Style  TargetType="{x:Type local:ChartAxis}">
                    <Setter Property="LabelForeground" Value="White"/>
                    <Setter Property="LabelFontFamily" Value="Calibri"/>
                    <Setter Property="LabelFontSize" Value="12"/>
                    <Setter Property="LabelForeground" Value="White"/>
                    <!--<Setter Property="local:ChartArea.ShowGridLines" Value="false"/>-->
                    <Setter Property="local:ChartArea.GridLineStroke" Value="{StaticResource gridlinestroke}"/>
                    <Setter Property="LineStroke" Value="{StaticResource gridlinestroke}"/>
                </Style>
            </Setter.Value>
        </Setter>

    </Style>

    <Style TargetType="{x:Type local:ChartLegend}" x:Key="VS2010ChartLegendStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource VS2010.LegendBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource VS2010.LegendBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource VS2010.LegendForeground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource VS2010.LegendCornerRadius}"/>
    </Style>

    <Style TargetType="{x:Type local:ChartToolBar}" x:Key="VS2010ChartToolBarStyle">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource VS2010.ToolBarBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource VS2010.ToolBarBackground}"/>
        <Setter Property="HeaderBackground" Value="{StaticResource VS2010.ToolBarHeaderBackground}"/>

        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel  Orientation="{Binding ItemsOrientation, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartToolBar}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChartToolBar}">
                    <Border  Margin="5" BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"                  
                             Padding="{TemplateBinding Padding}"
                             Background="{TemplateBinding Background}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--Header Area with close Button-->
                            <Grid Height="20" Grid.Row="0" Background="{TemplateBinding HeaderBackground}"   Visibility="{TemplateBinding TitleBarVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PART_ToolBarCloseButton" Grid.Column="1" Visibility="{TemplateBinding CloseButtonVisibility}" Width="15" Height="15" Command="ApplicationCommands.Close" Margin="0"  >
                                    <Button.Template>
                                        <ControlTemplate>
                                            <Border x:Name="CloseButtonBorder"  BorderBrush="#9D9DA1" CornerRadius="1" Background="Transparent">
                                                <Path Name="path" Stretch="Fill" Fill="#FFCED4DD" Stroke="Transparent" Margin="3" Data="M1.7378059,0.5 L2.6141474,0.5 C3.1662261,0.50000006 3.8039908,0.75809938 4.4048114,1.5 4.5550169,1.685475 4.9485269,2.160322 5.4658298,2.7821105 L5.4860015,2.8063081 5.5061731,2.7821105 C6.0234754,2.1603227 6.4169869,1.6854752 6.5671916,1.5 7.1680121,0.75809938 7.805777,0.50000006 8.3578553,0.5 L9.2341971,0.5 C9.7862759,0.50000006 10.979304,0.58072393 10.233824,1.5 9.8610825,1.9596381 8.6079334,3.4697623 7.345519,4.9849148 L7.3238601,5.0108548 9.0990157,7.1366935 C9.6334218,7.7765244 10.052589,8.2784384 10.237003,8.5 10.974663,9.3862554 9.7894541,9.5 9.2373757,9.5 L8.3610196,9.5 C7.8089409,9.5 7.3899587,9.4595025 6.5703706,8.5 6.4679222,8.3800621 6.3116059,8.195097 6.1150331,7.9614411 L5.4860015,7.2116037 4.8569698,7.9614411 C4.6603975,8.195097 4.5040812,8.3800621 4.4016328,8.5 3.5820441,9.4595032 3.1630621,9.5 2.6109833,9.5 L1.7346272,9.5 C1.1825502,9.5 -0.0026579946,9.3862555 0.73499992,8.5 0.91941352,8.2784385 1.338581,7.7765249 1.8729872,7.1366935 L3.6481428,5.0108552 3.6264839,4.9849148 C2.36407,3.4697629 1.1109188,1.9596384 0.73817882,1.5 -0.0073020967,0.58072303 1.1857272,0.50000006 1.7378059,0.5 z"/>
                                            </Border>
                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" TargetName="CloseButtonBorder"  Value="{StaticResource VS2010.ToolBarMouseOverBackground}"/>
                                                    <Setter Property="BorderBrush" TargetName="CloseButtonBorder"  Value="{StaticResource VS2010.ToolBarMouseOverBorder}"/>
                                                    <Setter Property="Fill" TargetName="path"  Value="#FF000000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <!--ItemsPresenter to host Chart ToolBarItem-->
                            <ItemsPresenter x:Name="ToolBarItemsPanel"  Grid.Row="1"  />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="{x:Type local:ToolBarItem}" x:Key="VS2010ToolBarItemStyle">
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource VS2010.ToolBarItemBackground}" />
        <Setter Property="Foreground" Value="{StaticResource VS2010.ToolBarItemForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource VS2010.ToolBarItemBorderBackground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToolBarItem}">
                    <Border  
                        x:Name="DropownButton" 
                        CornerRadius="2" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid HorizontalAlignment="{TemplateBinding HorizontalAlignment}" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto"  />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--ToolBarITem - Image, Text, DropDown-->
                            <Image Visibility="{TemplateBinding ItemImageSource, Converter={StaticResource ContentTovisibilityConv}}"  Source="{TemplateBinding ItemImageSource}"  Width="16" Height="16" Stretch="UniformToFill" />
                            <TextBlock Foreground="{TemplateBinding Foreground}" Grid.Column="1"  Text="{TemplateBinding Text}" HorizontalAlignment="Left"   />
                            <Image Grid.Column="2" Width="7" Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Forward}" Margin="0,0,0,2" HorizontalAlignment="Right"  VerticalAlignment="Bottom"  Stretch="None" >
                                <Image.Source>
                                    <DrawingImage>
                                        <DrawingImage.Drawing>
                                            <GeometryDrawing  >
                                                <GeometryDrawing.Pen>
                                                    <Pen Thickness="1"  Brush="Black" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <PathGeometry>
                                                            <PathFigure  StartPoint="5,10"  IsFilled="True" IsClosed="True">
                                                                <LineSegment Point="8,10"/>
                                                                <LineSegment Point="6.5,12.5"/>
                                                            </PathFigure>
                                                        </PathGeometry>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingImage.Drawing>
                                    </DrawingImage>
                                </Image.Source>
                            </Image>
                            <Border HorizontalAlignment="Stretch" Grid.ColumnSpan="3" DockPanel.Dock="Left"   >
                                <Popup x:Name="PART_Popup" Placement="Right" Focusable="False"  PopupAnimation="Fade"
                                    AllowsTransparency="True" HorizontalAlignment="Left" StaysOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}"
                                    IsOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}">
                                    <Border Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Reverse}" BorderThickness="1" CornerRadius="2" Background="#FAFAFA" BorderBrush="{TemplateBinding BorderBrush}">
                                        <ItemsPresenter />
                                    </Border>
                                </Popup>
                            </Border>

                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource VS2010.ToolBarMouseOverBackground}"/>
                            <Setter Property="BorderBrush" TargetName="DropownButton"  Value="{StaticResource VS2010.ToolBarMouseOverBorder}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource VS2010.ToolBarSelectedBrush}"/>
                            <Setter Property="BorderBrush" TargetName="DropownButton"  Value="{StaticResource VS2010.ToolBarMouseOverBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VS2010ChartAreaContextMenuStyle" TargetType="{x:Type local:ChartAreaContextMenu}">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static SystemFonts.MenuFontFamilyKey}}"/>
        <Setter Property="FontSize" Value="{DynamicResource {x:Static SystemFonts.MenuFontSizeKey}}"/>
        <Setter Property="FontStyle" Value="{DynamicResource {x:Static SystemFonts.MenuFontStyleKey}}"/>
        <Setter Property="FontWeight" Value="{DynamicResource {x:Static SystemFonts.MenuFontWeightKey}}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="true"/>
        <Setter Property="HasDropShadow" Value="{DynamicResource {x:Static SystemParameters.DropShadowKey}}"/>

        <Setter Property="Background" Value="{StaticResource VS2010.ContextMenuBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource VS2010.ContextMenuBorderBrush}"/>
        <Setter Property="Template" Value="{StaticResource VS2010ChartAreaContextMenu}">
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Chart}" BasedOn="{StaticResource VS2010ChartStyle}" />
    <Style TargetType="{x:Type local:ChartArea}" BasedOn="{StaticResource VS2010ChartAreaStyle}" />
    <Style TargetType="{x:Type local:ChartLegend}" BasedOn="{StaticResource VS2010ChartLegendStyle}" />
    <Style TargetType="{x:Type local:ChartToolBar}" BasedOn="{StaticResource VS2010ChartToolBarStyle}" />
    <Style TargetType="{x:Type local:ToolBarItem}" BasedOn="{StaticResource VS2010ToolBarItemStyle}" />

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="BorderBrush"
               Value="{StaticResource ToolTipBorderBrushKey}"/>
        <Setter Property="Background"
                Value="{StaticResource ToolTipBackgroundBrushKey}"/>
        <Setter Property="Foreground"
                Value="Black"/>
        <Setter Property="Padding"
                Value="5,1,5,4"/>
        <Setter Property="HorizontalContentAlignment"
                Value="Left"/>
        <Setter Property="VerticalContentAlignment"
                Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <!--<theme:SystemDropShadowChrome Name="Shdw"
                                                  Color="Transparent"
                                                  SnapsToDevicePixels="true"
                                                  CornerRadius="2">-->
                    <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <!--</theme:SystemDropShadowChrome>-->

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



</ResourceDictionary>    
