    <Pen x:Key="GridStroke" Brush="Black" Thickness="1" StartLineCap="Flat" EndLineCap="Flat" LineJoin="Miter" MiterLimit="4"/>

    <Pen x:Key="TickLineStroke" Brush="Black" Thickness="1" StartLineCap="Flat" EndLineCap="Flat" LineJoin="Miter" MiterLimit="4" />

    <Pen x:Key="BlendGridStroke" Brush="White" Thickness="1" StartLineCap="Flat" EndLineCap="Flat" LineJoin="Miter" MiterLimit="4" />

