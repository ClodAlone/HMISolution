                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>
    <SolidColorBrush x:Key="Classic.ToolBarBackground" 
                      Color="#d3d3d3"/>


    <LinearGradientBrush x:Key="Classic.ToolBarHeaderBackground"  StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#D0D1DB" Offset="0"/>
            <GradientStop Color="#B2B1C7" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Classic.ToolBarBorderBackground" 
                      Color="#6d6d6d"/>
