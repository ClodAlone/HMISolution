             Top="10" Bottom="10" Left ="10" Right="10"/>
  <Thickness x:Key="Classic.AreaBorderThickness" 
             Bottom="1" Left="1" Right="1" Top="1"/>
  <Pen Brush="#000000" x:Key="Classic.AxisPen"/>

