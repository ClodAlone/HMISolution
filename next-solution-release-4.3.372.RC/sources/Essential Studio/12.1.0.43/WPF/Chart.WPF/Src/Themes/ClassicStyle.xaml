                      Color="Transparent"/>

    <SolidColorBrush x:Key="Classic.ToolBarItemForeground" 
                      Color="Black"/>

    <SolidColorBrush x:Key="Classic.ToolBarGlyphColor" 
                      Color="#C5BFBF"/>

    <CornerRadius x:Key="Classic.ToolBarCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>

    <LinearGradientBrush x:Key="Classic.ToolBarMouseOverBackground"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#d3d3d3" Offset="0"/>
            <GradientStop Color="#aaaaaa " Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Classic.ToolBarSelectedBrush"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#5b5b5b " Offset="0"/>
            <GradientStop Color="#d3d3d3" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>


    <SolidColorBrush x:Key="Classic.ToolBarMouseOverBorderBrush" Color="#FFCCECFF"/>


