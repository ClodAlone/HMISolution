    <Pen Brush="#000000" x:Key="DefaultChartAreaAxisPen"/>

    <Pen  x:Key="DefaultSmallChartAreaAxisPen">
        <Pen.Brush>
            <SolidColorBrush Color="#000000" Opacity="0.2"/>
        </Pen.Brush>
    </Pen>

    <Style TargetType="{x:Type local:ChartArea}" x:Key="DefaultChartAreaStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="local:ChartArea.GridLineStroke" Value="{StaticResource DefaultChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartArea.SmallGridLineStroke" Value="{StaticResource DefaultSmallChartAreaAxisPen}"/>
        <Setter Property="local:ChartAxis.LineStroke" Value="{StaticResource DefaultChartAreaAxisPen}">
        </Setter>
        <Setter Property="local:ChartAxis.TickLineStroke" Value="{StaticResource DefaultChartAreaAxisPen}"/>
        <Setter Property="local:ChartAxis.SmallTickLineStroke" Value="{StaticResource DefaultChartAreaAxisPen}"/>
        <Setter Property="IsTabStop" Value="False"/>

        <Setter Property="Background" Value="{StaticResource Classic.AreaBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Classic.AreaBorderBackground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Classic.AreaCornerRadius}"/>
        <Setter Property="Padding" Value="{StaticResource Classic.AreaPadding}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Classic.AreaBorderThickness}"/>
        <Setter Property="GridBackground" Value="{x:Null}"/>
    </Style>

    <Style TargetType="{x:Type local:ChartLegend}" x:Key="DefaultChartLegendStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Classic.LegendBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Classic.LegendBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Classic.LegendForeground}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Classic.LegendCornerRadius}"/>
    </Style>

    <Style TargetType="{x:Type local:ChartToolBar}" x:Key="DefaultChartToolBarStyle">
        <Setter Property="DataContext" Value="{Binding}"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Classic.ToolBarBorderBackground}"/>
        <Setter Property="Background" Value="{StaticResource Classic.ToolBarBackground}"/>
        <Setter Property="HeaderBackground" Value="{StaticResource Classic.ToolBarHeaderBackground}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel  Orientation="{Binding ItemsOrientation, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:ChartToolBar}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChartToolBar}">
                    <Border  Margin="5" BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"                  
                             Padding="{TemplateBinding Padding}"
                             Background="{TemplateBinding Background}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--Header Area with close Button-->
                            <Grid Height="20" Grid.Row="0" Background="{TemplateBinding HeaderBackground}"   Visibility="{TemplateBinding TitleBarVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85*" />
                                    <ColumnDefinition Width="15" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PART_ToolBarCloseButton" Grid.Column="1" Visibility="{TemplateBinding CloseButtonVisibility}" Width="15" Height="15" Command="ApplicationCommands.Close" Margin="1"  >
                                    <Button.Template>
                                        <ControlTemplate>
                                            <Border x:Name="CloseButtonBorder"  BorderBrush="#9D9DA1" CornerRadius="1" Background="Transparent">
                                                <Image HorizontalAlignment="Center" VerticalAlignment="Center" Source="pack://application:,,,/Syncfusion.Chart.Wpf;component//Resources/closemc.ico" Height="16" Width="16" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" TargetName="CloseButtonBorder" Value="{StaticResource Classic.ToolBarMouseOverBackground}" />
                                                    <Setter Property="BorderBrush" TargetName="CloseButtonBorder"  Value="{StaticResource Classic.ToolBarMouseOverBorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <!--ItemsPresenter to host Chart ToolBarItem-->
                            <ItemsPresenter x:Name="ToolBarItemsPanel"  Grid.Row="1"  />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="{x:Type local:ToolBarItem}" x:Key="DefaultToolBarItemStyle">
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Classic.ToolBarItemBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Classic.ToolBarItemForeground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Classic.ToolBarBorderBackground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToolBarItem}">
                    <Border  
                        x:Name="DropownButton" 
                        CornerRadius="2" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid HorizontalAlignment="{TemplateBinding HorizontalAlignment}" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto"  />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--ToolBarITem - Image, Text, DropDown-->
                            <Image Visibility="{TemplateBinding ItemImageSource, Converter={StaticResource ContentTovisibilityConv}}"  Source="{TemplateBinding ItemImageSource}"  Width="16" Height="16" Stretch="UniformToFill" />
                            <TextBlock Foreground="{TemplateBinding Foreground}" Grid.Column="1"  Text="{TemplateBinding Text}" HorizontalAlignment="Left"   />
                            <Image Grid.Column="2" Width="7" Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Forward}" Margin="0,0,0,2" HorizontalAlignment="Right"  VerticalAlignment="Bottom"  Stretch="None" >
                                <Image.Source>
                                    <DrawingImage>
                                        <DrawingImage.Drawing>
                                            <GeometryDrawing  >
                                                <GeometryDrawing.Pen>
                                                    <Pen Thickness="1"  Brush="Black" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <PathGeometry>
                                                            <PathFigure  StartPoint="5,10"  IsFilled="True" IsClosed="True">
                                                                <LineSegment Point="8,10"/>
                                                                <LineSegment Point="6.5,12.5"/>
                                                            </PathFigure>
                                                        </PathGeometry>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingImage.Drawing>
                                    </DrawingImage>
                                </Image.Source>
                            </Image>
                            <Border HorizontalAlignment="Stretch" Grid.ColumnSpan="3" DockPanel.Dock="Left"   >
                                <Popup x:Name="PART_Popup" Placement="Right" Focusable="False"  PopupAnimation="Fade"
                                    AllowsTransparency="True" HorizontalAlignment="Left" StaysOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}"
                                    IsOpen="{Binding Path=IsOpen, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:ToolBarItem}}}">
                                    <Border Visibility="{TemplateBinding IsDropDown, Converter={StaticResource visibilityConverter}, ConverterParameter=Reverse}" BorderThickness="1" CornerRadius="2" Background="#FAFAFA" BorderBrush="{TemplateBinding BorderBrush}">
                                        <ItemsPresenter />
                                    </Border>
                                </Popup>
                            </Border>

                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource Classic.ToolBarMouseOverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="DropownButton"  Value="{StaticResource Classic.ToolBarSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Chart}" BasedOn="{StaticResource DefaultChartStyle}" />
    <Style TargetType="{x:Type local:ChartArea}" BasedOn="{StaticResource DefaultChartAreaStyle}" />
    <!--<Style TargetType="{x:Type local:ChartLegend}" BasedOn="{StaticResource DefaultChartLegendStyle}" />-->
    <Style TargetType="{x:Type local:ChartToolBar}" BasedOn="{StaticResource DefaultChartToolBarStyle}" />
    <Style TargetType="{x:Type local:ToolBarItem}" BasedOn="{StaticResource DefaultToolBarItemStyle}" />



</ResourceDictionary>    
