    <GradientStop Color="#FF000000" Offset="0"/>
    <GradientStop Color="#FF9C9898" Offset="1"/>
  </LinearGradientBrush>

  <VisualBrush x:Key="Aero.NormalColor.AreaBorderBackground" 
               Stretch="Fill"
               Visual="{StaticResource Aero.NormalColor.AreaBorderBackgroundVisual}"/>
  <!--<SolidColorBrush Color="#056EAB" x:Key="Aero.NormalColor.AreaBorderBackground"/>-->
  <VisualBrush x:Key="Aero.NormalColor.AreaBackground" 
               Stretch="Fill"
               Visual="{StaticResource Aero.NormalColor.AreaBackgroundVisual}"/>
  <CornerRadius x:Key="Aero.NormalColor.AreaCornerRadius" 
                TopLeft="0" BottomLeft="0" BottomRight="0" TopRight="0"/>
  <Thickness x:Key="Aero.NormalColor.AreaPadding" 
             Top="30" Bottom="30" Left ="30" Right="30"/>
  <Thickness x:Key="Aero.NormalColor.AreaBorderThickness" 
             Bottom="10" Left="10" Right="10" Top="10"/>
  
  <VisualBrush x:Key="Aero.NormalColor.LegendBackground" 
               Stretch="Fill"
               Visual="{StaticResource Aero.NormalColor.LegendBackgroundVisual}"/>

    <SolidColorBrush x:Key="Aero.NormalColor.LegendForeground"
                   Color="Black"/>
    
    <SolidColorBrush Color="#056EAB" x:Key="Aero.NormalColor.LegendBorderBackground"/>
  <CornerRadius x:Key="Aero.NormalColor.LegendCornerRadius" 
                TopLeft="0" BottomLeft="0" BottomRight="0" TopRight="0"/>
    <SolidColorBrush x:Key="Aero.NormalColor.ToolBarBackground" 
                      Color="#92c4e2"/>
    <LinearGradientBrush x:Key="Aero.NormalColor.ToolBarHeaderBackground"  StartPoint="0,0" EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#609cc4" Offset="0"/>
            <GradientStop Color="#103e68" Offset="1"/>

        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Aero.NormalColor.ToolBarBorderBackground" 
                      Color="#056eab"/>
    <SolidColorBrush x:Key="Aero.NormalColor.ToolBarItemBackground" 
                      Color="Transparent"/>

    <SolidColorBrush x:Key="Aero.NormalColor.ToolBarItemForeground" 
                      Color="#0A5C8B"/>

    <SolidColorBrush x:Key="Aero.NormalColor.ToolBarGlyphColor" 
                      Color="#0A5C8B"/>

    <CornerRadius x:Key="Aero.NormalColor.ToolBarCornerRadius" 
                TopLeft="10" BottomLeft="10" BottomRight="10" TopRight="10"/>


    <SolidColorBrush x:Key="Aero.NormalColor.ToolBarMouseOverBorderBrush" Color="#FFCCECFF"/>


    <LinearGradientBrush x:Key="Aero.NormalColor.ToolBarMouseOverBackground"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#92c4e2" Offset="0"/>
            <GradientStop Color="#6a96b7" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Aero.NormalColor.ToolBarSelectedBrush"
                         EndPoint="0,0" 
                         StartPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#174671" Offset="0"/>
            <GradientStop Color="#92c4e2" Offset="1"/>
        </LinearGradientBrush.GradientStops>
