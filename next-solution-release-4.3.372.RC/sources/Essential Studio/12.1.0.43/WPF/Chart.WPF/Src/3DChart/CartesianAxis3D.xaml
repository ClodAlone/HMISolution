<ResourceDictionary
    xmlns:local="clr-namespace:Syncfusion.Windows.Chart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >

    <local:ChartAxisTypeConverter x:Key="ChartAxisPositionConverter"/>
    
    <Style TargetType="{x:Type local:CartesianAxis3D}" x:Key="CartesianAxis3DStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CartesianAxis3D}">
                    <ControlTemplate.Resources>
                        <!--<local:ChartAxisTypeConverter x:Key="ChartAxisPositionConverter"/>-->
                        <local:TitleToAlignmentConverter x:Key="TitleToAlignmentConverterKey"/>
                    </ControlTemplate.Resources>
                    <local:ChartCartesianAxisPanel  Visibility="{Binding AxisVisibility}" Orientation="{Binding Orientation}" OpposedPosition="{Binding OpposedPosition}">

                        <Grid x:Name="AxisTitle">
                            <Grid.HorizontalAlignment>
                                <Binding Path="HeaderAlignment"
                   Converter="{StaticResource TitleToAlignmentConverterKey}" 
                   ConverterParameter="Horizontal"/>
                            </Grid.HorizontalAlignment>
                            <Grid.VerticalAlignment>
                                <Binding Path="HeaderAlignment"
                   Converter="{StaticResource TitleToAlignmentConverterKey}" 
                   ConverterParameter="Vertical"/>
                            </Grid.VerticalAlignment>

                            <Grid.LayoutTransform>
                                <RotateTransform>
                                    <RotateTransform.Angle>
                                        <MultiBinding Converter="{StaticResource ChartAxisPositionConverter}" ConverterParameter="Title">
                                            <Binding Path="Orientation"/>
                                            <Binding Path="OpposedPosition"/>
                                        </MultiBinding>
                                    </RotateTransform.Angle>
                                </RotateTransform>
                            </Grid.LayoutTransform>
                            <ContentPresenter Content="{Binding Header}"/>
                        </Grid>

                        <ItemsControl ClipToBounds="False"
                    ItemsSource="{Binding VisibleLabels}"
                    ItemTemplate="{Binding LabelTemplate}"
                    TextBlock.FontSize="{Binding LabelFontSize}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:ChartCartesianAxisLabelsPanel Axis="{Binding}" 
                                              Orientation="{Binding Orientation}"
                                              LabelRotateAngle="{Binding LabelRotateAngle}" 
                                              IntersectAction="{Binding IntersectAction}" 
                                              OpposedPosition="{Binding OpposedPosition}"
																							Margin="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="local:ChartCartesianAxisLabelsPanel.Position" Value="{Binding Position}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <local:ChartCartesianAxisElement Axis="{Binding}"
                                    LineStroke="{Binding LineStroke}"  
                                    TickSize="{Binding TickSize}" 
                                    Orientation="{Binding Orientation}"
                                    Labels="{Binding VisibleLabels}"/>
                    </local:ChartCartesianAxisPanel>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
