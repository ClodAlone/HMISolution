<ResourceDictionary
    xmlns:local="clr-namespace:Syncfusion.Windows.Chart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
    
    <ResourceDictionary.MergedDictionaries>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartArea/ChartNoneArea.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartArea/ChartCartesianArea.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartArea/ChartPolarArea.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <Style TargetType="{x:Type local:ChartArea}">
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ChartArea}">
                    <Border ClipToBounds="{TemplateBinding ClipToBounds}" 
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                            IsEnabled="{TemplateBinding IsEnabled}"
                  CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <local:ChartDockPanel x:Name="PART_CHARTDOCKPANEL" Background="Transparent" ElementMargin="{TemplateBinding ElementMargin}" Margin="{TemplateBinding Padding}">

                                <!--<Canvas    VerticalAlignment="Stretch" Margin="0,0,0,2">
                                    <Thumb Height="2" BorderThickness="1"  DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}" Margin="{TemplateBinding AxesThickness}"  />
                                </Canvas>-->
                                <ContentPresenter local:ChartDockPanel.Dock="Top" ContentSource="Header"   TextBlock.FontWeight="ExtraLight" TextBlock.FontFamily="Segoe UI"  TextBlock.FontSize="39"  HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0" />
                                
                                <local:ChartDockPanel.RootElement>
                                    <local:ChartAreaPresenter />
                                </local:ChartDockPanel.RootElement>
                            </local:ChartDockPanel>
                            <ContentPresenter Content="{Binding Footer, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Right" Grid.Row="1" Margin="0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="local:ChartZoomingToolkit.ZoomInIconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Image Source='pack://application:,,,/Syncfusion.Chart.Wpf;component//Resources/zoomin.png' Height='24' Width='24'/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="local:ChartZoomingToolkit.ZoomOutIconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Image Source='pack://application:,,,/Syncfusion.Chart.Wpf;component//Resources/zoomout.png' Height='24' Width='24'/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="local:ChartZoomingToolkit.ZoomCloseIconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Image Source='pack://application:,,,/Syncfusion.Chart.Wpf;component//Resources/close.png' Height='24' Width='24'/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="local:ChartZoomingToolkit.ZoomResetIconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Image Source='pack://application:,,,/Syncfusion.Chart.Wpf;component//Resources/zoomreset.png' Height='24' Width='24'/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="local:ChartZoomingToolkit.ZoomPanningIconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Image Source='pack://application:,,,/Syncfusion.Chart.Wpf;component//Resources/Hand.png' Height='24' Width='24'/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <local:ChartAreaTemplateSelector x:Key="ChartAreaTemplateSelectorKey"
                                   CartesianTemplate="{StaticResource ChartCartesianAreaKey}"
                                   PolarTemplate="{StaticResource ChartPolarAreaKey}"
                                   NoneTemplate="{StaticResource ChartNoneAreaKey}"/>

    <Style TargetType="{x:Type local:SyncChartAreas}" x:Key="syncChartArea">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SyncChartAreas}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <local:ChartDockPanel x:Name="PART_CHARTDOCKPANEL" Background="Transparent" ElementMargin="{TemplateBinding ElementMargin}" Margin="{TemplateBinding Padding}">
                                <ContentPresenter local:ChartDockPanel.Dock="Top" ContentSource="Header"  TextBlock.FontWeight="ExtraLight" TextBlock.FontFamily="Segoe UI"  TextBlock.FontSize="39"  HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0" />
                                <local:ChartDockPanel.RootElement>
                                    <ItemsControl ItemsPanel="{TemplateBinding AreasPanel}"  x:Name="Part_Presenter" ItemsSource="{TemplateBinding Areas}"/>
                                </local:ChartDockPanel.RootElement>
                            </local:ChartDockPanel>
                            <ContentPresenter Content="{Binding Footer, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Right" Grid.Row="1" Margin="0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



</ResourceDictionary>
