<!--Defines the following
    1) Defines the look and feel for the ChartArea when the AreaType is set to ChartAxesType.None.
    -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Chart">

    <ResourceDictionary.MergedDictionaries>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartSeries/ChartSeries.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <!-- None Area Template -->
  <DataTemplate x:Key="ChartNoneAreaKey">
    <Grid>
    <ItemsControl x:Name="PART_SeriesContainer" 
                  ItemsSource="{Binding VisibleSeries}"
                  ItemTemplate="{StaticResource ChartSeriesTemplate}"
                  ClipToBounds="True">
      <ItemsControl.Template>
        <ControlTemplate>
          <ItemsPresenter/>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Grid/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
      <local:ChartAdornmentsPresenter VisibleSeries="{Binding VisibleSeries}"
                                      Area="{Binding}" ClipToBounds="True"/>
    </Grid>
  </DataTemplate>
  
</ResourceDictionary>