<!--Defines the following:
    1) Template for the Polar Area type.-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Syncfusion.Windows.Chart">

  <ResourceDictionary.MergedDictionaries>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartAxis/ChartPolarAxis.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartAxis/ChartCartesianAxis.xaml"/>
        <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/ChartSeries/ChartSeries.xaml"/>
    </ResourceDictionary.MergedDictionaries>

  <!-- Polar Area Template -->
  <DataTemplate x:Key="ChartPolarAreaKey">
    <local:ChartPanel>
      <local:ChartPolarAreaGrid XAxis="{Binding PrimaryAxis}" 
                                YAxis="{Binding SecondaryAxis}"
                                Margin="{Binding AxesThickness}"
                                Background="{Binding GridBackground}" 
                                ClipToBounds="true"/>

      <Grid>
        <ItemsControl ItemsSource="{Binding VisibleSeries}"
                    ItemTemplate="{StaticResource ChartSeriesTemplate}"
                    Margin="{Binding AxesThickness}"
                    IsEnabled="{Binding IsEnabled}" 
                    ClipToBounds="true">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Grid/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <!--TextBlock.FontFamily="{Binding AdornmentsInfo.SegmentLabelFontFamily}"
                                      TextBlock.FontSize="{Binding AdornmentsInfo.SegmentLabelFontSize}"
                                      TextBlock.FontWeight="{Binding AdornmentsInfo.SegmentLabelFontWeight}"-->
                <local:ChartAdornmentsPresenter Margin="{Binding AxesThickness}" VisibleSeries="{Binding VisibleSeries}" IsEnabled="{Binding IsEnabled}" 
                                        Area="{Binding}" Axes="{Binding Axes}" ClipToBounds="True"/>
      </Grid>
      <local:ChartPolarPanel AxesThickness="{Binding AxesThickness, Mode=OneWayToSource}">
        <local:ChartPolarPanel.CartesianAxis>
          <ContentPresenter ContentTemplate="{StaticResource ChartCartesianAxisTemplateKey}" 
                            Content="{Binding SecondaryAxis}" IsEnabled="{Binding SecondaryAxis.IsEnabled}"/>
        </local:ChartPolarPanel.CartesianAxis>
        <local:ChartPolarPanel.PolarAxis>
          <ContentPresenter ContentTemplate="{StaticResource ChartPolarAxisTemplateKey}"
                            Content="{Binding PrimaryAxis}" IsEnabled="{Binding PrimaryAxis.IsEnabled}" />
        </local:ChartPolarPanel.PolarAxis>
      </local:ChartPolarPanel>
    </local:ChartPanel>
  </DataTemplate>

</ResourceDictionary>