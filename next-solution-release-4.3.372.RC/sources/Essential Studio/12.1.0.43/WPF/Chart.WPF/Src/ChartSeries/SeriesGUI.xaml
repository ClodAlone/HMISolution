<!--Defines the series template (ChartSeries.ItemTemplate) for the different chart types.-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       
    xmlns:local="clr-namespace:Syncfusion.Windows.Chart">
    <local:EnableEffectsConverter x:Key="effectsConverter"/>
    <local:EffectPathConverter x:Key="pathselector"/>
    <local:LineEffectsConverter x:Key="lineeffects"/>
    <local:Visibilityselector x:Key="visibilityselector"/>
    <local:AnimationEnableEffectConverter x:Key="animationconverter"/>
    <local:DebugErrorConverter x:Key="debugConverter" />
    <local:ColumnMarginConverter x:Key="ColumnMargin" />
    <!--ColumnChartTemplate-->


    <LinearGradientBrush x:Key="LightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#FFF" Offset="0.0"/>
                <GradientStop Color="#EEE" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SolidBorderBrush" Color="#888" />
  
    <ToolTip x:Key="DefaultTooltips"  >
        <ToolTip.Template>
            <ControlTemplate>
            <Border 
                    Name="Border"
                    Background="{StaticResource LightBrush}"
                    BorderBrush="{StaticResource SolidBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    >
                <TextBlock Background="Transparent" Text="{Binding Path=Series.TooltipString}" Padding="2" />
            </Border>
            </ControlTemplate>
            
            <!--<ControlTemplate>
                <Border Background="White" BorderBrush="Black" BorderThickness="1">
                    <ContentPresenter Content="{Binding Series.TooltipString}" Margin="5">
                    </ContentPresenter>
                </Border>
            </ControlTemplate>-->
        </ToolTip.Template>

    </ToolTip>

    <!--VS2010 ToolTip Style-->

    <SolidColorBrush x:Key="ToolTipBorderBrushKey" Color="#FF767676"/>

    <LinearGradientBrush x:Key="ToolTipBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFCFCFD" Offset="0.134"/>
        <GradientStop Color="#FFE4E5F0" Offset="0.992"/>
        <GradientStop Color="#FF767676" Offset="1"/>
    </LinearGradientBrush>

    <ToolTip x:Key="VS2010TooltipStyle" >
        <ToolTip.Template>
            <ControlTemplate>
                <Border 
                    Name="Border"
                    Background="{StaticResource ToolTipBackgroundBrushKey}"
                    BorderBrush="{StaticResource ToolTipBorderBrushKey}"
                    BorderThickness="1"
                    CornerRadius="4" SnapsToDevicePixels="True"
                    >
                    <TextBlock Background="Transparent" Text="{Binding Path=Series.TooltipString}" Padding="2" />
                </Border>
            </ControlTemplate>
        </ToolTip.Template>

    </ToolTip>

    <DataTemplate x:Key="{x:Type local:ChartColumnSegment}">
        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.EdgeMode="Aliased" Height="{Binding Height}" Width="{Binding Width}">
            <Grid.Margin>
                <MultiBinding Converter="{StaticResource ColumnMargin}">
                    <Binding Path="X" />
                    <Binding Path="Y" />
                </MultiBinding>
            </Grid.Margin>
            <Rectangle     Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Interior}" Stroke="{Binding Stroke}" 
                 StrokeThickness="{Binding StrokeThickness}" ToolTip="{Binding ToolTip}" />
           <!--<Rectangle Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="{Binding Width}" Height="{Binding Height}" Stroke="Transparent" 
                 StrokeThickness="{Binding StrokeThickness}" ToolTip="{Binding ToolTip}" Visibility="{Binding Series.EnableEffects, Converter={StaticResource effectsConverter}}"
                       Fill="{Binding LayerBrush}">
            </Rectangle>
            <ContentPresenter ContentTemplate="{Binding Series.Type, Converter={StaticResource pathselector}}" Visibility="{Binding Series.EnableEffects, Converter={StaticResource effectsConverter}}"
                             />-->
            <Popup IsOpen="False" Opacity="0.5" PopupAnimation="Fade" AllowsTransparency="True">
                <Rectangle  Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Interior}" Stroke="{Binding Stroke}" 
                 StrokeThickness="{Binding StrokeThickness}" ToolTip="{Binding ToolTip}" Opacity="0.5"/>
            </Popup>
        </Grid>
    </DataTemplate>
    
    <!-- Chart MetroTheme ToolTip-->
    
    <SolidColorBrush x:Key="MetroThemeToolTipBackground" Color="#FFD8D8D9"/>
    
    <SolidColorBrush x:Key="MetroThemeToolTipBorderBrush" Color="Transparent"/>
    
    <SolidColorBrush x:Key="MetroThemeToolTipForeground" Color="#FF333333"/>

    <ToolTip x:Key="MetroThemeTooltipStyle" >
        <ToolTip.Template>
            <ControlTemplate>
                <Border 
                    Name="Border"
                    Background="{StaticResource MetroThemeToolTipBackground}"
                    BorderBrush="{StaticResource MetroThemeToolTipBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4" SnapsToDevicePixels="True"
                    >
                    <TextBlock Foreground="{StaticResource MetroThemeToolTipForeground}" Text="{Binding Path=Series.TooltipString}" Padding="2" />
                </Border>
            </ControlTemplate>
        </ToolTip.Template>

    </ToolTip>

    <!--ColumnChart Effects Template-->
    <DataTemplate x:Key="Column">
        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Height="{Binding Height}" Width="{Binding Width}">
            <Grid.Margin>
                <MultiBinding Converter="{StaticResource ColumnMargin}">
                    <Binding Path="X" />
                    <Binding Path="Y" />
                </MultiBinding>
            </Grid.Margin>
            <Rectangle  Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Interior}" Stroke="{Binding Stroke}" 
                 StrokeThickness="{Binding StrokeThickness}" ToolTip="{Binding ToolTip}"/>
            <Rectangle  Width="{Binding Width}" Height="{Binding Height}" Stroke="Transparent" 
                 StrokeThickness="{Binding StrokeThickness}" ToolTip="{Binding ToolTip}" Visibility="{Binding  Converter={StaticResource effectsConverter}}"
                       Fill="{Binding LayerBrush}">
            </Rectangle>
            <ContentPresenter ContentTemplate="{Binding Converter={StaticResource pathselector}}" Visibility="{Binding Converter={StaticResource effectsConverter}}"
                             />
        </Grid>
    </DataTemplate>
    
    <DataTemplate x:Key="EmptyPointSymbolAndInterior">
        <Canvas Margin="-5,-5,0,0">
        <Ellipse Canvas.Left="{Binding X}" Canvas.Top  ="{Binding Y}" Fill="{Binding Series.EmptyPointInterior}" Height="10" Width="10" Stroke="Black"/>
            </Canvas>
    </DataTemplate>

    <DataTemplate x:Key="EmptyPointInterior">
        <Canvas Margin="-5,-5,0,0">
            <Ellipse Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Fill="{Binding Series.Interior}" Height="10" Width="10" Stroke="Black"/>
        </Canvas>
    </DataTemplate>

    <DataTemplate x:Key="ColumnEffectsPath">
        <Canvas>
            <Path Data="M200,200 L300,200 290,205 210,205" Stroke="Transparent" Stretch="Fill" Height="10"  Width="{Binding Width}">
                <Path.Fill>
                    <LinearGradientBrush EndPoint="0.5,1.908" StartPoint="0.5,0">
                        <GradientStop Color="#33D7D0D0" Offset="0.296"/>
                        <GradientStop Color="#3FEAE5E5" Offset="0.561"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Canvas>
    </DataTemplate>
    
    <DataTemplate x:Key="BarEffectsPath">
        <Canvas>
            <Path  Data="M200,200 L200,300 190,280 190,220" Stroke="Transparent" Stretch="Fill" Width="10" Height="{Binding Height}">
                <Path.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="{Binding Width}"/>
                        <TranslateTransform X="-10"/>
                    </TransformGroup>
                </Path.RenderTransform>
                <Path.Fill>
                    <LinearGradientBrush EndPoint="0.5,1.908" StartPoint="0.5,0">
                        <GradientStop Color="#33D7D0D0" Offset="0.296"/>
                        <GradientStop Color="#3FEAE5E5" Offset="0.561"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Canvas>
    </DataTemplate>

    <!--AreaChartTemplate-->
  <DataTemplate x:Key="{x:Type local:ChartAreaSegment}">
    <Path Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Fill="{Binding Interior}" 
          Data="{Binding Geometry}" ToolTip="{Binding ToolTip}"/>
  </DataTemplate>

  <!--BoxAndWhiskerChartTemplate-->
  <DataTemplate x:Key="{x:Type local:ChartBoxAndWhiskerSegment}">
    <Canvas SnapsToDevicePixels="True">
      <Line Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding CenterLineWhiskerX1}" X2="{Binding CenterLineWhiskerX2}" Y1="{Binding CenterLineWhiskerY1}" Y2="{Binding CenterLineWhiskerY2}" />
      <Line Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding TopWhiskerX1}" X2="{Binding TopWhiskerX2}" Y1="{Binding TopWhiskerY1}" Y2="{Binding TopWhiskerY2}" />
      <Line Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding BottomWhiskerX1}" X2="{Binding BottomWhiskerX2}" Y1="{Binding BottomWhiskerY1}" Y2="{Binding BottomWhiskerY2}" />
      <Rectangle Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" ToolTip="{Binding ToolTip}"/>
      <Line Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding MedianWhiskerX1}" X2="{Binding MedianWhiskerX2}" Y1="{Binding MedianWhiskerY1}" Y2="{Binding MedianWhiskerY2}" />
            <Popup IsOpen="False">
                <Canvas>
                <Line Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding CenterLineWhiskerX1}" X2="{Binding CenterLineWhiskerX2}" Y1="{Binding CenterLineWhiskerY1}" Y2="{Binding CenterLineWhiskerY2}" />
                <Line Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding TopWhiskerX1}" X2="{Binding TopWhiskerX2}" Y1="{Binding TopWhiskerY1}" Y2="{Binding TopWhiskerY2}" />
                <Line Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding BottomWhiskerX1}" X2="{Binding BottomWhiskerX2}" Y1="{Binding BottomWhiskerY1}" Y2="{Binding BottomWhiskerY2}" />
                <Rectangle Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" ToolTip="{Binding ToolTip}"/>
                <Line Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding MedianWhiskerX1}" X2="{Binding MedianWhiskerX2}" Y1="{Binding MedianWhiskerY1}" Y2="{Binding MedianWhiskerY2}" />
                </Canvas>
            </Popup>
        </Canvas>
  </DataTemplate>

  <!--BubbleChart Effects Template-->
  <DataTemplate x:Key="Bubble">
    <Canvas>
      <Ellipse Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
               Margin="{Binding StrokeThickness}" />
            <Ellipse Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="{Binding Width}" Height="{Binding Height}" Stroke="Transparent" StrokeThickness="0" Visibility="{Binding Converter={StaticResource effectsConverter}}" ToolTip="{Binding ToolTip}">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.554,0.302" GradientOrigin="0.535,0.134" RadiusX="1.03" RadiusY="0.812">
                        <RadialGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterX="0.55400002002716064" CenterY="0.30199998617172241"/>
                                <SkewTransform AngleX="0" AngleY="0" CenterX="0.55400002002716064" CenterY="0.30199998617172241"/>
                                <RotateTransform Angle="-34.7" CenterX="0.55400002002716064" CenterY="0.30199998617172241"/>
                                <TranslateTransform X="0"/>
                            </TransformGroup>
                        </RadialGradientBrush.RelativeTransform>
                        <GradientStop Color="#7FF4F2F2" Offset="0.233"/>
                        <GradientStop Color="#BFFFFFFF"/>
                        <GradientStop Color="#4CB1ABAB" Offset="0.471"/>
                        <GradientStop Color="#3FE4D7D7" Offset="0.722"/>
                        <GradientStop Color="#33E4D7D7" Offset="0.583"/>
                        <GradientStop Color="#26E4D7D7" Offset="0.717"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        <ContentPresenter ContentTemplate="{Binding Converter={StaticResource pathselector}}" Visibility="Visible"
                             />
    </Canvas>
  </DataTemplate>

    <!--BubbleChartTemplate-->
    <DataTemplate x:Key="{x:Type local:ChartBubbleSegment}">
        <Canvas>
            <Ellipse Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
               Margin="{Binding StrokeThickness}" ToolTip="{Binding ToolTip}"/>
            <Popup IsOpen="False"  Opacity="0.5" PopupAnimation="Fade" AllowsTransparency="True">
                <Ellipse Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
               Margin="{Binding StrokeThickness}" ToolTip="{Binding ToolTip}" Opacity="0.5"/>
            </Popup>
        </Canvas>
    </DataTemplate>

    <!--CandleChartTemplate-->
  <DataTemplate x:Key="{x:Type local:ChartCandleSegment}">
    <Canvas SnapsToDevicePixels="True">
      <Line Stroke="{Binding Stroke}" Fill="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding HighX}" X2="{Binding LowX}" Y1="{Binding HighY}" Y2="{Binding LowY}"  />
            <Rectangle  Margin="{Binding StrokeThickness}" Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding FillBrush}" Stroke="{Binding Stroke}" 
                  StrokeThickness="{Binding StrokeThickness}" ToolTip="{Binding ToolTip}"/>
    </Canvas>
  </DataTemplate>

  <!--FastLine-->
  <DataTemplate x:Key="{x:Type local:ChartFastLineSegment}">
        <Grid>
            <Polyline Stroke="{Binding Series.FastTypePen.Brush}" StrokeDashArray="{Binding Series.FastTypePen.DashStyle.Dashes}" StrokeDashCap="{Binding Series.FastTypePen.DashCap}" StrokeLineJoin="{Binding Series.FastTypePen.LineJoin}" StrokeMiterLimit="{Binding Series.FastTypePen.MiterLimit}" StrokeStartLineCap="{Binding Series.FastTypePen.StartLineCap}" StrokeEndLineCap="{Binding Series.FastTypePen.EndLineCap}" StrokeThickness="{Binding StrokeThickness}"  Points="{Binding Points}" ToolTip="{Binding ToolTip}" />

        <local:FastLinePresenter Points="{Binding Points}" Series="{Binding Series}" ToolTip="{Binding Series.ToolTip}" />
        </Grid>
    </DataTemplate>
    <!--FastSpline-->    
    <DataTemplate x:Key="{x:Type local:ChartFastSplineSegment}">        
        <Grid>            
            <Path Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}"  Data="{Binding Geometry}" ToolTip="{Binding ToolTip}"/>                
                <local:FastSplinePresenter Points="{Binding Points}" Series="{Binding Series}" ToolTip="{Binding Series.ToolTip}" />                
        </Grid>        
    </DataTemplate>    
    <!--FastLine-->
    <!--TestFastType-->
    <!--<DataTemplate x:Key="TestFastType">  
            <local:FastLineScatterPresenter Points="{Binding Points}" Series="{Binding Series}" ToolTip="{Binding Series.ToolTip}" />
    </DataTemplate>-->

  <!--FunnelChartTemplate-->
  <DataTemplate x:Key="{x:Type local:ChartFunnelSegment}">
    <Path Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Fill="{Binding Interior}" 
          Data="{Binding Geometry}" ToolTip="{Binding ToolTip}"/>
  </DataTemplate>

  <!--HiLoOpenClose-->
  <DataTemplate x:Key="{x:Type local:ChartHiLoOpenCloseSegment}">
    <Canvas SnapsToDevicePixels="True">
      <Line Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding HighX}" X2="{Binding LowX}" Y1="{Binding HighY}" Y2="{Binding LowY}" ToolTip="{Binding ToolTip}"/>
      <Line Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding StartOpenX}" X2="{Binding EndOpenX}" Y1="{Binding StartOpenY}" Y2="{Binding EndOpenY}"  ToolTip="{Binding ToolTip}"/>
      <Line Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding StartCloseX}" X2="{Binding EndCloseX}" Y1="{Binding StartCloseY}" Y2="{Binding EndCloseY}"  ToolTip="{Binding ToolTip}"/>
    </Canvas>
  </DataTemplate>

  <!--HiLo-->
  <DataTemplate x:Key="{x:Type local:ChartHiLoSegment}">
    <Canvas SnapsToDevicePixels="True">
      <Line Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding HighX}" X2="{Binding LowX}" 
            Y1="{Binding HighY}" Y2="{Binding LowY}" ToolTip="{Binding ToolTip}"/>
    </Canvas>
  </DataTemplate>

  <!--HistogramChartTemplate-->
  <DataTemplate x:Key="{x:Type local:ChartHistogramSegment}">
        <Grid HorizontalAlignment="Left" VerticalAlignment="Top"  Height="{Binding Height}" Width="{Binding Width}" SnapsToDevicePixels="True"   >
            <Grid.Margin>
                <MultiBinding Converter="{StaticResource ColumnMargin}">
                    <Binding Path="X" />
                    <Binding Path="Y" />
                </MultiBinding>
            </Grid.Margin>
            <Rectangle     Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Interior}" Stroke="{Binding Stroke}" 
                 StrokeThickness="{Binding StrokeThickness}" ToolTip="{Binding ToolTip}"  Margin="{Binding StrokeThickness}"/>
           
        </Grid>
        <!--<Canvas SnapsToDevicePixels="True">
      <Rectangle Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                 Margin="{Binding StrokeThickness}" ToolTip="{Binding ToolTip}"/>
    </Canvas>-->
  </DataTemplate>

  <!--HistogramDistributionTemplate-->
  <DataTemplate x:Key="{x:Type local:ChartHistogramDistributionSegment}">
    <Polyline Stroke="Black" Points="{Binding Points}" ToolTip="{Binding ToolTip}"/>
  </DataTemplate>

    <!--LineChartTemplate-->
    <DataTemplate x:Key="{x:Type local:ChartLineSegment}">
        <Grid>
            <Line Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding X1}" X2="{Binding X2}" 
          Y1="{Binding Y1, Converter={StaticResource debugConverter}}" Y2="{Binding Y2, Converter={StaticResource debugConverter}}"  ToolTip="{Binding ToolTip}"/>
        </Grid>
    </DataTemplate>

    <!--LineChart Effects Template-->
  <DataTemplate x:Key="Line">
        <Canvas>
            <Line Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" X1="{Binding X1}" X2="{Binding X2}" 
          Y1="{Binding Y1}" Y2="{Binding Y2}"  ToolTip="{Binding ToolTip}"/>
            <Ellipse Fill="{Binding Interior}" Stroke="{Binding Stroke}" Canvas.Left="{Binding X1, Converter={StaticResource animationconverter}}"  Canvas.Top="{Binding Y1, Converter={StaticResource animationconverter}}" StrokeThickness="{Binding StrokeThickness}" Width="10" Height="10" Opacity="{Binding Opacity}" 
                     Visibility="{Binding Converter={StaticResource effectsConverter}}" ToolTip="{Binding ToolTip}" >
            </Ellipse>
            <Ellipse Fill="{Binding Interior}" Stroke="{Binding Stroke}" Canvas.Left="{Binding X2, Converter={StaticResource animationconverter}}" Canvas.Top="{Binding Y2, Converter={StaticResource animationconverter}}" StrokeThickness="{Binding StrokeThickness}" Width="10" Height="10" Opacity="{Binding Opacity}" 
                     ToolTip="{Binding ToolTip}"  Visibility="{Binding Converter={StaticResource effectsConverter}}"  >              
            </Ellipse>
            <ContentPresenter ContentTemplate="{Binding Converter={StaticResource pathselector}}" Visibility="{Binding Series,Converter={StaticResource visibilityselector}}"
                             />
        </Canvas>
  </DataTemplate>

    <!--PieChartTemplate-->
    <DataTemplate x:Key="{x:Type local:ChartPieSegment}">
        <Path Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Fill="{Binding Interior}" 
          Data="{Binding Geometry}" ToolTip="{Binding ToolTip}"/>
    </DataTemplate>

    <!--PieChart Effects Template-->
  <DataTemplate x:Key="Pie">
        <Grid>
            <Path Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Fill="{Binding Interior}" 
          Data="{Binding Geometry}" ToolTip="{Binding ToolTip}"/>
            <Path Data="{Binding ExternalPoints}" Clip="{Binding Geometry}" Fill="{Binding LayerBrush}" ToolTip="{Binding ToolTip}"
                   Visibility="{Binding Series.EnableEffects, Converter={StaticResource effectsConverter}}"/>
        </Grid>
    </DataTemplate>

    <!--PyramidChartTemplate-->
  <DataTemplate x:Key="{x:Type local:ChartPyramidSegment}">
    <Path Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Fill="{Binding Interior}" 
          Data="{Binding Geometry}" ToolTip="{Binding ToolTip}"/>
  </DataTemplate>

  <!--RangeAreaChartTemplate-->
  <DataTemplate x:Key="{x:Type local:ChartRangeAreaSegment}">
    <Path Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Fill="{Binding FillBrush}" 
          Data="{Binding Geometry}" ToolTip="{Binding ToolTip}"/>
  </DataTemplate>

  <!--SplineChartTemplate-->
  <DataTemplate x:Key="{x:Type local:ChartSplineSegment}">
    <Path Stroke="{Binding Interior}" StrokeThickness="{Binding StrokeThickness}" 
          Data="{Binding Geometry}" ToolTip="{Binding ToolTip}"/>
  </DataTemplate>

  <!--StepLine-->
  <DataTemplate x:Key="{x:Type local:ChartStepLineSegment}">
    <Polyline SnapsToDevicePixels="True" StrokeThickness="{Binding StrokeThickness}" Stroke="{Binding Interior}" 
              Points="{Binding Points}" ToolTip="{Binding ToolTip}"/>
  </DataTemplate>

  <!--KagiChartTemplate-->
  <DataTemplate  x:Key="{x:Type local:ChartKagiSegment}">
    <Polyline x:Name="KagiLine" StrokeThickness="{Binding StrokeThickness}" Points="{Binding Points}" ToolTip="{Binding ToolTip}"/>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Path=IsPriceUp}" Value="True" >
                <Setter Property="Stroke" Value="{Binding FillBrush}" TargetName="KagiLine" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Path=IsPriceDown}" Value="True" >
                <Setter Property="Stroke" Value="{Binding FillBrush}" TargetName="KagiLine" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!--PointAndFigureChartTemplate-->
  <DataTemplate x:Key="{x:Type local:ChartPointAndFigureSegment}">
    <Canvas>
            <Path x:Name="PointAndFigurePath" Stretch="Fill" Stroke="{Binding StrokeColor}" StrokeThickness="1" 
            Data="{Binding Geometry}" Width="{Binding Width}" Height="{Binding Height}"  Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
            ToolTip="{Binding ToolTip}">               
            </Path>
        </Canvas>   
  </DataTemplate>

  <!--RenkoChartTemplate-->
  <DataTemplate x:Key="{x:Type local:ChartRenkoSegment}">
    <Path x:Name="RenkoRect" SnapsToDevicePixels="True" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Fill="{Binding Interior}" 
          Data="{Binding Geometry}" ToolTip="{Binding ToolTip}"/>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Path=IsPriceUp}" Value="True" >
          <Setter Property="Stroke" Value="Green" TargetName="RenkoRect" />
      </DataTrigger>

      <DataTrigger Binding="{Binding Path=IsPriceDown}" Value="True" >
          <Setter Property="Stroke" Value="Red" TargetName="RenkoRect" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!--ScatterChart Effects Template-->
  <DataTemplate x:Key="Scatter">
    <Canvas >
      <Ellipse Width="{Binding Path=scatterWidth}" Height="{Binding Path=scatterHeight}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Fill="{Binding Interior}" 
               Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" ToolTip="{Binding ToolTip}" RenderTransformOrigin="0.25,0.25">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="180" />
                </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Stroke="Transparent" StrokeThickness="0" Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" ToolTip="{Binding ToolTip}" Width="{Binding Path=scatterWidth}" Height="{Binding Path=scatterHeight}"
                     Visibility="{Binding Converter={StaticResource effectsConverter}}" RenderTransformOrigin="0.25,0.25">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="180" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.554,0.302" GradientOrigin="0.535,0.134" RadiusX="1.03" RadiusY="0.812">
                        <RadialGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterX="0.55400002002716064" CenterY="0.30199998617172241"/>
                                <SkewTransform AngleX="0" AngleY="0" CenterX="0.55400002002716064" CenterY="0.30199998617172241"/>
                                <RotateTransform Angle="-34.7" CenterX="0.55400002002716064" CenterY="0.30199998617172241"/>
                                <TranslateTransform X="0"/>
                            </TransformGroup>
                        </RadialGradientBrush.RelativeTransform>
                        <GradientStop Color="#7FF4F2F2" Offset="0.233"/>
                        <GradientStop Color="#BFFFFFFF"/>
                        <GradientStop Color="#4CB1ABAB" Offset="0.471"/>
                        <GradientStop Color="#3FE4D7D7" Offset="0.722"/>
                        <GradientStop Color="#33E4D7D7" Offset="0.583"/>
                        <GradientStop Color="#26E4D7D7" Offset="0.717"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
    </Canvas>
  </DataTemplate>
    <local:HeightConverter x:Key="heightConverter"/>
    <local:WidthConverter x:Key="widthConverter"/>
    <local:MarginConverter x:Key="margincon"/>
    <local:MarginMulConverter x:Key="margincon1"/>
    <!--<local:EmptyPointMarCon x:Key="MarCon"/>-->
    <!--ScatterChartTemplate-->
    <DataTemplate x:Key="{x:Type local:ChartSymbolSegment}">
        <Canvas>
            <Ellipse Width="{Binding Path=scatterWidth}" Height="{Binding Path=scatterHeight}" 
                     Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Fill="{Binding Interior}" 
                     ToolTip="{Binding ToolTip}" Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" RenderTransformOrigin="0.25,0.25">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="180" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Popup IsOpen="False"  Opacity="0.5" PopupAnimation="Fade" AllowsTransparency="True">
                <Ellipse Width="{Binding Path=scatterWidth}" Height="{Binding Path=scatterHeight}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Fill="{Binding Interior}" 
                 ToolTip="{Binding ToolTip}" Opacity="0.5">                   
                </Ellipse>
            </Popup>
        </Canvas>
    </DataTemplate>


    <DataTemplate   x:Key="{x:Type local:ChartEmptySymbolSegment}">

        <Canvas  Name="canvas_emptypt"   >
            <Canvas.Margin >
                <MultiBinding Converter="{StaticResource margincon1}">
                    <Binding ElementName="Emp_cont_con" Path="ActualWidth"/>
                    <Binding ElementName="Emp_cont_con" Path="ActualHeight"/>
                </MultiBinding>
            </Canvas.Margin>
                <ContentControl Name="Emp_cont_con" Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                        ContentTemplate="{Binding Path=Template}"  >                
            </ContentControl>
   </Canvas>
    </DataTemplate>

    <!--ThreeLineBreakChartTemplate-->
  <DataTemplate x:Key="{x:Type local:ChartLineBreakSegment}">
    <Canvas>
      <Rectangle x:Name="LineBreakRect" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="{Binding Width}" Height="{Binding Height}" 
                 Margin="{Binding StrokeThickness}" ToolTip="{Binding ToolTip}"/>
    </Canvas>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Path=IsPriceUp}" Value="True" >
          <Setter Property="Fill" Value="Green" TargetName="LineBreakRect" />
      </DataTrigger>

      <DataTrigger Binding="{Binding Path=IsPriceDown}" Value="True" >
          <Setter Property="Fill" Value="Red" TargetName="LineBreakRect" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

    <DataTemplate x:Key="{x:Type local:ChartFastColumnSegment}">
        <local:FastColumnPresenter SnapsToDevicePixels="True" Points="{Binding Points}" Series="{Binding Series}" ToolTip="{Binding Series.ToolTip}" Interior="{Binding Interior}" />
    </DataTemplate>

    <DataTemplate x:Key="{x:Type local:ChartFastStackingColumnSegment}">
        <DataTemplate.Resources>
            <local:FastSegmentsPropertiesConverter x:Key="fastSegmentProperrtiesConverter"/>
        </DataTemplate.Resources>
        <local:ChartFastStackingColumnPresenter AffectRender="{Binding AffectRender}"  SegmentInteriorList="{Binding Series.FastSegmentProperties, Converter={StaticResource fastSegmentProperrtiesConverter}}"  ToolTip="{Binding Series.ToolTip}" DrawingPoints="{Binding Points}" Interior="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"/>
    </DataTemplate>

    <DataTemplate x:Key="{x:Type local:ChartFastScatterSegment}">
        <local:FastScatterPresenter Points="{Binding Points}" Series="{Binding Series}" ToolTip="{Binding Series.ToolTip}" Interior="{Binding Interior}" />
    </DataTemplate>
    
    <!--<DataTemplate x:Key="{x:Type local:ChartFastBarSegment}">
        <local:FastBarPresenter Points="{Binding Points}" Series="{Binding Series}" ToolTip="{Binding Series.ToolTip}" />
    </DataTemplate>-->

    <DataTemplate x:Key="{x:Type local:ChartFastHiLoOpenCloseSegment}">
        <DataTemplate.Resources>
            <local:FastSegmentsPropertiesConverter x:Key="fastSegmentProperrtiesConverter"/>
        </DataTemplate.Resources>
        <local:ChartFastHiLoOpenClosePresenter AffectRender="{Binding AffectRender}"  SegmentInteriorList="{Binding Series.FastSegmentProperties, Converter={StaticResource fastSegmentProperrtiesConverter}}"    ToolTip="{Binding Series.ToolTip}" DrawingPoints="{Binding Points}" Interior="{Binding Interior}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}" />
    </DataTemplate>

</ResourceDictionary>