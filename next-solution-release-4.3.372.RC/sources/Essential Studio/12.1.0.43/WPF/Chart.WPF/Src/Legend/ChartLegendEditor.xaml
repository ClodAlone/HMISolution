<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    x:Class="Syncfusion.Windows.Chart.ChartLegendEditor"
    xmlns:local="clr-namespace:Syncfusion.Windows.Chart"
    WindowStartupLocation="CenterScreen"	
    Height="200" Width="300" 
	ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SharedResourceDictionary  Source="/Syncfusion.Chart.Wpf;component/Themes/LangDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:ChartResourceWrapper x:Key="ChartWrapperResources" />
        </ResourceDictionary>
    </Window.Resources>
    <Window.Title>
        <Binding Source="{StaticResource ChartWrapperResources}" Path="LegendWindowTitle"/>
    </Window.Title>
  <Grid Margin="15">
        <Grid.Resources>
            <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type sys:Enum}" x:Key="visibilityValues">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Visibility"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </Grid.Resources>
            <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Border BorderThickness="1" BorderBrush="#FF808080">
			<Grid Grid.Row="0" Margin="2" VerticalAlignment="Center" HorizontalAlignment="Center">
				<Grid.RowDefinitions>
					<RowDefinition/>
					<RowDefinition/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>

                <TextBlock Margin="5" Grid.Row="0" Grid.Column="0" Text="{Binding Source={StaticResource ChartWrapperResources}, Path=LegendWindowIcon}" ></TextBlock>
				<ComboBox Margin="5" Grid.Row="0" Grid.Column="1" Width="100"
                          ItemsSource="{Binding Source={StaticResource visibilityValues}}"
                          SelectedItem="{Binding IconVisibility}"/>

                <TextBlock x:Uid="txtBlkLegendCheckBox" Margin="5" Grid.Row="1" Grid.Column="0" Text="{Binding Source={StaticResource ChartWrapperResources}, Path=LegendWindowCheckBox}"></TextBlock>
				<ComboBox Margin="5" Grid.Row="1" Grid.Column="1" Width="100"
                          ItemsSource="{Binding Source={StaticResource visibilityValues}}"
                          SelectedItem="{Binding CheckBoxVisibility}"/>

			</Grid>
		</Border>
    <StackPanel Height="30" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Margin="3" Width="60" Content="{Binding Source={StaticResource ChartWrapperResources}, Path=LegendWindowOK}" IsCancel="True"/>
            <Button Margin="3" Width="60" Content="{Binding Source={StaticResource ChartWrapperResources}, Path=LegendWindowCancel}" Click="OnCancelClick"/>
    </StackPanel>
  </Grid>
</Window>
