<syncfusion:ChromelessWindow x:Class="Syncfusion.Windows.Tools.Olap.KPIEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Olap"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Icon="../Images/App.ico"
             Title="KPI Editor"
             d:DesignHeight="300" Height="500" Width="700" d:DesignWidth="300">
    <Grid Margin="5">
        <Grid.Resources>
            <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Syncfusion.OlapTools.WPF;component/CubeDimensionBrowser/Themes/MainTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="GraphicTemplate">
                <StackPanel Orientation="Horizontal">
                    <Image Width="14" Height="14" Source="{Binding ImagePath}"/>
                    <TextBlock Margin="10 0 0 0" Text="{Binding Title}"/>
                </StackPanel>
            </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40*" />
            <RowDefinition Height="251*" />
            <RowDefinition Height="24*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <local:CubeDimensionBrowser Grid.RowSpan="3"  Margin="0,0,5,0" x:Name="vkpicubeDimensionBrowser" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IncludeMembers="True" AllowDrop="True" AllowNodeDragging="True" Style="{StaticResource DefaultCubeDimensionBrowser}" />
        <Grid Grid.Column="1">
            <!--<Grid.RowDefinitions>
                <RowDefinition Height="54*" />
                <RowDefinition Height="56*" />
            </Grid.RowDefinitions>-->
            <TextBlock Text="KPI Name :"/>
            <TextBox Height="24" x:Name="txtKpiName" Margin="10 5 10 0"/>
            <!--<TextBlock Grid.Row="1" Text="Associated measure group :"/>
            <ComboBox Grid.Row="1" Height="24" Margin="10 5 10 0"/>-->
        </Grid>
        <TabControl Grid.Row="1" Grid.Column="1">
            <TabItem Name="_value" Header="Value">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20*" />
                        <RowDefinition Height="168*" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Bottom" Margin="5 0 0 0" Text="Value Expression :"/>
                    <TextBox x:Name="txtValueExpression" Grid.Row="1" AcceptsReturn="True" Margin="5" AllowDrop="True" PreviewDragEnter="ExpressionText_PreviewDragEnter" PreviewDragOver="ExpressionText_PreviewDragEnter" PreviewDrop="ExpressionText_PreviewDrop" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
            <TabItem Name="_goal" Header="Goal">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20*" />
                        <RowDefinition Height="168*" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Bottom" Margin="5 0 0 0" Text="Goal Expression :"/>
                    <TextBox x:Name="txtGoalExpression"  Grid.Row="1" AllowDrop="True" PreviewDragEnter="ExpressionText_PreviewDragEnter" PreviewDragOver="ExpressionText_PreviewDragEnter" PreviewDrop="ExpressionText_PreviewDrop" AcceptsReturn="True" Margin="5" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
            <TabItem Name="_status" Header="Status">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20*" />
                        <RowDefinition Height="168*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="5 0 0 0" VerticalAlignment="Center" Text="Status indicator :"/>
                        <ComboBox x:Name="cmbStatusList" ItemTemplate="{StaticResource GraphicTemplate}" SelectedIndex="0" Margin="30 0 0 0" Width="200" Height="24">
                        </ComboBox>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Bottom" Margin="5 0 0 0" Text="Status Expression :"/>
                        <TextBox x:Name="txtStatusExpression" Grid.Row="1" AllowDrop="True" PreviewDragEnter="ExpressionText_PreviewDragEnter" PreviewDragOver="ExpressionText_PreviewDragEnter" PreviewDrop="ExpressionText_PreviewDrop" AcceptsReturn="True" Margin="5" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Name="_trend" Header="Trend">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20*" />
                        <RowDefinition Height="168*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="5 0 0 0" VerticalAlignment="Center" Text="Trend indicator :"/>
                        <ComboBox Margin="30 0 0 0"  ItemTemplate="{StaticResource GraphicTemplate}" SelectedIndex="0" x:Name="cmbTrendList" Width="200" Height="24">
                        </ComboBox>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Bottom" Margin="5 0 0 0" Text="Trend Expression :"/>
                        <TextBox x:Name="txtTrendExpression" Grid.Row="1" AcceptsReturn="True" AllowDrop="True" PreviewDragEnter="ExpressionText_PreviewDragEnter" PreviewDragOver="ExpressionText_PreviewDragEnter" PreviewDrop="ExpressionText_PreviewDrop" Margin="5" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Row="2" Grid.Column="1">
            <Button Height="23" MinWidth="75" Content="OK" x:Name="btnOk" Click="btnOk_Click" />
            <Button Margin="10 0 10 0" MinWidth="75" Height="23" Content="Cancel" x:Name="btnCancel" Click="btnCancel_Click" />
        </StackPanel>
    </Grid>
</syncfusion:ChromelessWindow>
