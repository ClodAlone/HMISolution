<UserControl
	x:Class="Syncfusion.Windows.Tools.Olap.AxisElementBuilder"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Olap" xmlns:sync="http://schemas.syncfusion.com/wpf"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/DefaultStyle.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!--Axis elements list-->
        <ListBox
			Name="listBoxAxisElements"
			AllowDrop="True"
			DragOver="ListBox_DragOver"
			Drop="ListBox_Drop" 
			IsSynchronizedWithCurrentItem="True"
			MouseMove="ListBoxBox_MouseMove">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                    <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                    <Setter Property="Padding" Value="2,0,0,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true" Margin="2">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="true"/>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="true"/>
                                            <Condition Property="Selector.IsSelectionActive" Value="false"/>
                                        </MultiTrigger.Conditions>
                                    </MultiTrigger>
                                    <Trigger Property="IsEnabled" Value="false"/>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <!--List item template-->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <local:SplitButton 
							HorizontalAlignment="Center"
							Host="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:AxisElementBuilder}}}"
							MetaTreeNode="{Binding}"
							Text="{Binding}">
                        </local:SplitButton>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <!--List item context menu-->
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="MenuItem_Remove_Click" Header="Remove"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Style.Triggers>                      
                        <Trigger Property="sync:SkinStorage.VisualStyle" Value="Blend">
                            <Setter Property="Background" Value="#FF333333"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                        <Trigger Property="sync:SkinStorage.VisualStyle" Value="Office2007Blue">
                            <Setter Property="Background" Value="#FFFFFFFF"/>
                            <Setter Property="BorderBrush" Value="#FFADD1FF"/>
                        </Trigger>
                        <Trigger Property="sync:SkinStorage.VisualStyle" Value="Office2007Black">
                            <Setter Property="Background" Value="#FFFFFFFF"/>
                            <Setter Property="BorderBrush" Value="#FF898989"/>
                        </Trigger>
                        <Trigger Property="sync:SkinStorage.VisualStyle" Value="Office2007Silver">
                            <Setter Property="Background" Value="#FFFFFFFF"/>
                            <Setter Property="BorderBrush" Value="#FFA9B1B8"/>
                        </Trigger>
                        <Trigger Property="sync:SkinStorage.VisualStyle" Value="Office2003">
                            <Setter Property="Background" Value="#FFFFFFFF"/>
                            <Setter Property="BorderBrush" Value="#FFADD1FF"/>
                        </Trigger>
                        <Trigger Property="sync:SkinStorage.VisualStyle" Value="Office2010Black">
                            <Setter Property="Background" Value="#FFFFFFFF"/>
                            <Setter Property="BorderBrush" Value="#FF3B3B3B"/>
                        </Trigger>
                        <Trigger Property="sync:SkinStorage.VisualStyle" Value="Office2010Blue">
                            <Setter Property="Background" Value="#FFFAFCFF"/>
                            <Setter Property="BorderBrush" Value="#FF849DBD"/>
                        </Trigger>
                        <Trigger Property="sync:SkinStorage.VisualStyle" Value="Office2010Silver">
                            <Setter Property="Background" Value="#FFFAFCFF"/>
                            <Setter Property="BorderBrush" Value="#FFA5ACB5"/>
                        </Trigger>
                        <Trigger Property="sync:SkinStorage.VisualStyle" Value="Transparent">
                            <Setter Property="Background" Value="#64FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#FF535353"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
        </ListBox>
    </Grid>
</UserControl>