    <resources:SplitButtonResourceWrapper x:Key="ResourceWrapperKeys" />

        <Style TargetType="{x:Type local:SplitButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SplitButton}">
                    <Grid>
                        <Border x:Name="PART_SplitButton_Border"  >
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFEBEBEB"/>
                                    <Style.Triggers>
                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue">
                                            <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush.Blue}"/>
                                        </Trigger>
                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                                            <Setter Property="Background" Value="#FF595959"/>
                                            <Setter Property="TextBlock.Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                                            <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush.Black}"/>
                                        </Trigger>
                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                                            <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush.Silver}"/>
                                        </Trigger>
                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                                            <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush.Office2003}"/>
                                        </Trigger>
                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Metro">
                                            <Setter Property="Background" Value="#FFEBEBEB"/>
                                        </Trigger>
                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2010Blue">
                                            <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush.Office2010Blue}"/>
                                        </Trigger>
                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2010Black">
                                            <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush.Office2010Black}"/>
                                        </Trigger>
                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2010Silver">
                                            <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush.Office2010Silver}"/>
                                        </Trigger>
                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Transparent">
                                            <Setter Property="Background" Value="#80FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock  x:Name="txtblock" Text="{Binding Path=Caption}" Margin="6,3,6,6" Grid.Column="0"/>
                                <Button x:Name="PART_SplitButton" Grid.Column="1" BorderThickness="0" >
                                    <Button.Content>                                        
                                        <Image VerticalAlignment="Center" Name="Image1" Width="8" Height="8">
                                            <Image.Style>
                                                <Style>
                                                    <Setter Property="Image.Source" Value="{StaticResource Blue.Arrow}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Blue">
                                                            <Setter Property="Image.Source" Value="{StaticResource Blue.Arrow}"/>
                                                        </Trigger>
                                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Black">
                                                            <Setter Property="Image.Source" Value="{StaticResource Black.Arrow}"/>
                                                        </Trigger>
                                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2007Silver">
                                                            <Setter Property="Image.Source" Value="{StaticResource Silver.Arrow}"/>
                                                        </Trigger>
                                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Default">
                                                            <Setter Property="Image.Source" Value="{StaticResource Blue.Arrow}"/>
                                                        </Trigger>
                                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Office2003">
                                                            <Setter Property="Image.Source" Value="{StaticResource Blue.Arrow}"/>
                                                        </Trigger>
                                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Blend">
                                                            <Setter Property="Image.Source" Value="{StaticResource Blend.Arrow}"/>
                                                        </Trigger>
                                                        <Trigger Property="shared:SkinStorage.VisualStyle" Value="Metro">
                                                            <Setter Property="Image.Source" Value="{StaticResource Metro.Arrow}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </Border>
                        <Popup Name="PART_OptionPopup"
                           PlacementTarget="{Binding ElementName=PART_SplitButton}"
                           Placement="Top"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           HorizontalOffset="-30"
                           VerticalOffset="-8">
                            <Border BorderBrush="LightGray" Background="White" BorderThickness="1">
                                <ToolBar>
                                    <Button x:Name="PART_Moveup" IsEnabled="False" ToolTip="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsEditorSplitButtonMoveUpToolTip}">
                                        <Image Source="{StaticResource Modeup}"/>
                                    </Button>
                                    <Button x:Name="PART_Movedown" IsEnabled="False" ToolTip="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsEditorSplitButtonMoveDownToolTip}">
                                        <Image Source="{StaticResource Modedown}"/>
                                    </Button>
                                    <Button x:Name="PART_Delete" ToolTip="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsEditorSplitButtonDeleteToolTip}" >
                                        <Image Source="{StaticResource Delete}"/>
                                    </Button>
                                </ToolBar>
                            </Border>
                        </Popup>
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>        
    </Style>
</ResourceDictionary>