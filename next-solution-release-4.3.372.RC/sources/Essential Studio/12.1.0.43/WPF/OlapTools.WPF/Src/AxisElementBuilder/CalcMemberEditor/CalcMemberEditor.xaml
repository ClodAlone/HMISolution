<syncfusion:ChromelessWindow
    Name="calcMemberEditorWindow"
    x:Class="Syncfusion.Windows.Tools.Olap.CalcMemberEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Olap"
    xmlns:sfshared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:Syncfusion.Windows.Tools.Olap.Resources"
    MinHeight="400" MinWidth="570" Height="400" Width="570"
    DataContext="{Binding RelativeSource={RelativeSource self}}"
    Icon="../../Images/App.ico"
    ResizeMode="CanResizeWithGrip" FontSize="12"
    Title="{Binding ElementName=textBlockTitle, Path=Text}"  WindowStyle="ToolWindow">
    <syncfusion:ChromelessWindow.Resources>       
        <ResourceDictionary>			
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Syncfusion.OlapTools.WPF;component/CubeDimensionBrowser/Themes/MainTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ControlTemplate x:Key="buttonTemplate"/>
            <System:Double x:Key="FontSize">12</System:Double>
            <resources:CalcMemberEditorResourceWrapper x:Key="ResourceWrapperKeys" />
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </syncfusion:ChromelessWindow.Resources>
    <Grid>
        <!-- Since, Resource wrapper is added as resource of the window. We can't bind the title directly. 
            So, we are binding this text block with the title. The Title will bind to this text block-->
        <TextBlock x:Name="textBlockTitle" Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=OlapToolsCalcMemberEditorTitle}" Visibility="Collapsed" />
        <Grid x:Name="LayoutRoot" Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="0.5*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="CalcMeasureTreeViewBorder" Visibility="Collapsed" Opacity="0.5" Background="Gray" Canvas.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="2" SnapsToDevicePixels="True"  />
                <local:CubeDimensionBrowser Margin="0,0,5,0" x:Name="CalcMeasureTreeView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IncludeMembers="True" AllowDrop="True" AllowNodeDragging="True" Style="{StaticResource DefaultCubeDimensionBrowser}" />
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="2" Background="LightGray" />
                <Grid Grid.Column="2" Margin="5,0,0,0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="25" />
                        <RowDefinition Height="25" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=CalcMemberEditorCaptionText}" />
                    <Border x:Name="CaptionTextBorder" Grid.Row="1" Visibility="Collapsed" Opacity="0.5" Background="Gray" Margin="5,1" Canvas.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <TextBox x:Name="CaptionText" Margin="5,1" Grid.Row="1" />
                    <TextBlock Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=CalcMemberEditorExpression}" Grid.Row="2" />
                    <TextBox TextWrapping="Wrap" Margin="5,1" x:Name="ExpressionText" HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch" AllowDrop="True" PreviewDragEnter="ExpressionText_PreviewDragEnter" PreviewDragOver="ExpressionText_PreviewDragEnter" PreviewDrop="ExpressionText_PreviewDrop" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="3" />                        
                    <TextBlock Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=CalcMemberEditorType}" Grid.Row="4" AllowDrop="True" />
                    <Border x:Name="MemberTypeBorder" Grid.Row="5" Visibility="Collapsed" Opacity="0.5" Background="Gray" Margin="5,1" Canvas.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <ComboBox x:Name="MemberTypeBox" Margin="5,1" SelectedIndex="0" Grid.Row="5" SelectionChanged="MemberTypeBox_SelectionChanged">
                        <ComboBoxItem Content="Measure" />
                        <ComboBoxItem Content="Dimension" />
                    </ComboBox>
                    <Border x:Name="MemberTypeTextBorder" Grid.Row="6" Visibility="Collapsed" Opacity="0.5" Background="Gray" Margin="5,1" Canvas.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <ComboBox x:Name="MemberTypeText" Margin="5,1" Grid.Row="6" Visibility="Collapsed" />
                    <TextBlock Text="{Binding Source={StaticResource ResourceWrapperKeys}, Path=CalcMemberEditorFormatText}" Grid.Row="7" />
                    <Border x:Name="FormatBoxBorder" Grid.Row="8" Visibility="Collapsed" Opacity="0.5" Background="Gray" Margin="5,1" Canvas.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <ComboBox x:Name="FormatBox" Margin="5,1" SelectedIndex="0" Grid.Row="8" SelectionChanged="FormatBox_SelectionChanged">
                        <ComboBoxItem Content="Standard" />
                        <ComboBoxItem Content="Currency" />
                        <ComboBoxItem Content="Percent" />
                        <ComboBoxItem Content="Custom" />
                    </ComboBox>
                    <Border x:Name="FormatTextBorder" Grid.Row="9" Visibility="Collapsed" Opacity="0.5" Background="Gray" Margin="5,1" Canvas.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <TextBox x:Name="FormatText" Margin="5,1" Grid.Row="9" Visibility="Collapsed" />
                </Grid>
            </Grid>
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Width="75" Height="23" HorizontalAlignment="Right" Margin="0,5,5,5" Grid.Row="1" IsCancel="True" />
            <Button x:Name="OKButton" Content="OK" Click="OKButton_Click" Width="75" Height="23" HorizontalAlignment="Right" Margin="0,5,85,5" Grid.Row="1" IsDefault="True" />
        </Grid>
    </Grid>
</syncfusion:ChromelessWindow>