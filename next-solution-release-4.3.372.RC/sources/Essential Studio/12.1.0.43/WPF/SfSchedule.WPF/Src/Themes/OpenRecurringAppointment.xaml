<Window x:Class="Syncfusion.UI.Xaml.Schedule.OpenRecurringAppointment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="http://schemas.syncfusion.com/wpf" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" input:SkinStorage.VisualStyle="Metro"
        WindowStyle="None"  BorderThickness="1" BorderBrush="LightGray" 
        Title="OpenRecurringAppointment" Height="220" Width="300">

    <Grid>
        <StackPanel  Orientation="Vertical">
            <Border Background="Gray" Height="30" x:Name="TitleBar" MouseDown="TitleBar_MouseDown" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Open Recurring Item" FontSize="17"  Foreground="White" Margin="20,2,0,0" FontFamily="Segoe UI" FontWeight="Normal"/>
                    <Border x:Name="CloseBorder" Background="Gray" Opacity="0.6" MouseEnter="Close_MouseEnter" MouseLeave="Close_MouseLeave"
                            MouseDown="Close_MouseDown" Height="20" Width="20" Margin="5,5,0,5" Grid.Column="1"  HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Grid>
                            <Line Stroke="White"  X1="0" X2="10" Y1="5" Y2="15" StrokeThickness="2.5"/>
                            <Line Stroke="White"  X1="0" X2="10" Y1="15" Y2="5" StrokeThickness="2.5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Text="This is one appointment in a series. What do you want to open?" Height="50" Width="249" HorizontalAlignment="Center" TextWrapping="WrapWithOverflow" VerticalAlignment="Center" FontSize="15" FontFamily="Segoe UI" FontWeight="Normal" Margin="27,20,22,0" />
            <RadioButton Content="Just this one" GroupName="Recurrence" Height="20" IsChecked="True" x:Name="One" FontSize="15" Width="110" HorizontalAlignment="Left" Margin="35,0,0,0"/>
            <RadioButton Content="The Entire Series" GroupName="Recurrence" Height="20"  x:Name="series" FontSize="15" Width="140" HorizontalAlignment="Left" Margin="35,10,0,0"/>
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="OpenOne" Grid.Column="0" Background="White" Click="OpenOne_Click"  FontFamily="Segoe UI" FontSize="14" FontWeight="Normal" Margin="10,0,10,0" Height="25" Width="100" Content="OK"/>
                <Button x:Name="Series" Grid.Column="1" Background="White" Click="Series_Click"  FontFamily="Segoe UI" FontSize="14" FontWeight="Normal" Margin="10,0,10,0" Height="25" Width="100" Content="Cancel"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
