    <Style TargetType="{x:Type local:LineItem}">
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="EditControlFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="0,0,0,0"
                               StrokeThickness="0"
                               Stroke="Transparent"
                               StrokeDashArray="1 2"
                               SnapsToDevicePixels="true" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonButtonStyle" TargetType="{x:Type syncfusion:RibbonButton}">
        <Setter  Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Background" Value="{DynamicResource MetroBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MetroForegroundBrush}" />
        <Setter Property="Height" Value="23" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe WP" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type syncfusion:RibbonButton}">
                    <Border Name="Border" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Panel.Background}"
						Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}" MinHeight="{TemplateBinding MinHeight}"
						MaxHeight="{TemplateBinding MaxHeight}"  Margin="{TemplateBinding Margin}"  SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="21" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Name="PART_CheckBorder" Grid.Column="0" Visibility="Collapsed"
								Width="21" Height="23" BorderThickness="1" BorderBrush="{DynamicResource MetroFocusedBorderBrush}"
								Background="{DynamicResource MetroBrush}" CornerRadius="0">
                                <Path Stroke="{DynamicResource MetroHighlightedForegroundBrush}" StrokeThickness="1.4">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="6 9" EndPoint="9 16" />
                                            <LineGeometry StartPoint="9 16" EndPoint="13 3" />
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Border>
                            <TextBlock Grid.Column="1"  Name="label" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"  Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource MetroBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource MetroFocusedBorderBrush}" />
                            <Setter Property="Foreground" TargetName="label" Value="{DynamicResource MetroHighlightedForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource MetroHoverBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}" />
                            <Setter Property="Foreground" TargetName="label" Value="{DynamicResource MetroForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MetroSplitButtonStyle" TargetType="{x:Type syncfusion:SplitButton}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource MetroBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MetroForegroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe WP" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type syncfusion:SplitButton}">
                    <Border	CornerRadius="0" Height="24" Name="Bd" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Opacity="{TemplateBinding Opacity}" IsEnabled="{TemplateBinding IsEnabled}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="15" />
                            </Grid.ColumnDefinitions>

                            <Border Name="PART_Button" Grid.Column="0" Background="Transparent" CornerRadius="2,0,2,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Image Name="PART_Image" Grid.Column="0" Margin="2" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed" />
                                    <TextBlock Grid.Column="1" Name="label" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="{TemplateBinding VerticalAlignment}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" Margin="2,0,2,0" />
                                </Grid>
                            </Border>

                            <Border Name="PART_ToggleButton" CornerRadius="0" Grid.Column="2" ToolTip="{TemplateBinding ToggleButtonToolTip}" BorderThickness="1,0,0,0" Background="Transparent" BorderBrush="Transparent">

                                <Path Name="path" Fill="{DynamicResource MetroForegroundBrush}"
										  HorizontalAlignment="Center"
										  VerticalAlignment="Center"
										  StrokeThickness="0"
										  Stroke="{DynamicResource MetroForegroundBrush}"
										  Data="{StaticResource PathData}"
										  Focusable="False" />
                            </Border>

                            <Popup Name="PART_Popup" Placement="Bottom" Focusable="False" PopupAnimation="Fade" AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource AncestorType={x:Type syncfusion:DropDownButton}}}">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="true">
                                    <Border Background="{DynamicResource MetroPanelBackgroundBrush}" MinHeight="14" MinWidth="28" BorderThickness="1" CornerRadius="2" BorderBrush="{StaticResource QuickDropDownBorderBrush}">
                                        <ItemsPresenter />
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5" />
                        </Trigger>

                        <Trigger Property="IsSmallImageVisible" Value="True">
                            <Setter TargetName="PART_Image" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True" SourceName="Bd">
                            <Setter TargetName="PART_ToggleButton" Property="Background" Value="{DynamicResource MetroPanelBackgroundBrush}" />
                            <Setter TargetName="PART_ToggleButton" Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MetroHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True" SourceName="PART_ToggleButton">
                            <Setter TargetName="PART_ToggleButton" Property="Background" Value="{StaticResource RibbonButtonMouseOverBackground}" />
                            <Setter TargetName="PART_ToggleButton" Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MetroHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MetroBorderBrush}" />
                        </Trigger>

                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="PART_ToggleButton" Property="BorderBrush" Value="{DynamicResource MetroFocusedBorderBrush}" />
                            <Setter TargetName="PART_ToggleButton" Property="Background" Value="{DynamicResource MetroBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MetroPanelBackgroundBrush}" />
                            <Setter TargetName="path" Property="Fill" Value="White" />
                            <Setter Property="ToolTipService.IsEnabled" Value="False" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type syncfusion:RibbonMenuItem}">
        <Setter Property="Padding" Value="1,0,3,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MetroForegroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type syncfusion:RibbonMenuItem}">
                    <Border CornerRadius="2" Name="Bd">
                        <Grid Grid.ColumnSpan="3">
                            <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0" Width="25" RadiusY="0" HorizontalAlignment="Left" Fill="{DynamicResource MetroPanelBackgroundBrush}" RadiusX="0" />
                            <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="25,0,0,0" Width="1" HorizontalAlignment="Left" Fill="Transparent" />
                            <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="26,0,0,0" Width="1" HorizontalAlignment="Left" Fill="Transparent" />
                            <Border BorderThickness="{TemplateBinding BorderThickness}"
									Background="{TemplateBinding Panel.Background}"
									Width="{TemplateBinding Width}"
									Height="{TemplateBinding Height}"
									MinWidth="{TemplateBinding MinWidth}"
									MaxWidth="{TemplateBinding MaxWidth}"
									MinHeight="{TemplateBinding MinHeight}"
									MaxHeight="{TemplateBinding MaxHeight}"
									Margin="{TemplateBinding Margin}"
									Padding="{TemplateBinding Padding}"
									CornerRadius="2"
									Name="Border"
									SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="17" />
                                    </Grid.ColumnDefinitions>

                                    <Border Name="PART_CheckBorder" Grid.Column="0" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="2">
                                        <ContentPresenter Content="{TemplateBinding Icon}" Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}" RenderOptions.BitmapScalingMode="NearestNeighbor"
													Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                                    </Border>
                                    <Label Grid.Column="1" Margin="11,0,10,0" Padding="-5"  Content="{TemplateBinding MenuItem.Header}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                    <Path Width="17" Visibility="{TemplateBinding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}"
										  Grid.Column="2" Data="M0,0L4,3.5 0,7z" Fill="{TemplateBinding Foreground}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    <Popup Name="PART_Popup"
										   StaysOpen="False"
										   PopupAnimation="Fade"
										   MinWidth="10"
										   MinHeight="10"
										   HorizontalOffset="1"
										   VerticalOffset="0"
										   AllowsTransparency="true"
										   Placement="Right"
										   Focusable="false"
										   IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Microsoft_Windows_Themes:SystemDropShadowChrome Name="PART_Shadow" SnapsToDevicePixels="true">
                                            <Border BorderBrush="{StaticResource QuickDropDownBorderBrush}" CornerRadius="0" BorderThickness="1" Background="{DynamicResource MetroPanelBackgroundBrush}">
                                                <Grid>
                                                    <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0" Width="25" RadiusY="2" HorizontalAlignment="Left" Fill="{DynamicResource MetroPanelBackgroundBrush}" RadiusX="2" />
                                                    <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="25,0,0,0" Width="1" HorizontalAlignment="Left" Fill="Transparent" />
                                                    <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="26,0,0,0" Width="1" HorizontalAlignment="Left" Fill="Transparent" />
                                                    <ScrollViewer Margin="0,0,1,0" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}" CanContentScroll="True" Grid.ColumnSpan="2">
                                                        <ItemsPresenter Name="Presenter" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Grid.IsSharedSizeScope="true" />
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </Microsoft_Windows_Themes:SystemDropShadowChrome>
                                    </Popup>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5" />
                        </Trigger>
                        <Trigger Property="MenuItem.IsChecked" Value="True">
                            <Setter TargetName="PART_CheckBorder" Property="Background" Value="{DynamicResource MetroPanelBackgroundBrush}" />
                            <Setter TargetName="PART_CheckBorder" Property="BorderBrush" Value="{DynamicResource MetroForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" TargetName="Border" Value="{StaticResource RibbonMenuItemMouseOverBorderBrush}" />
                            <Setter Property="Background" TargetName="Border" Value="{StaticResource RibbonMenuItemMouseOverBackground}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton" x:Key="ExpandButtonStyle">
        <Setter Property="FrameworkElement.Focusable" Value="False" />
        <Setter Property="FrameworkElement.Width" Value="19" />
        <Setter Property="FrameworkElement.Height" Value="15" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border VerticalAlignment="Center"  HorizontalAlignment="Center" Background="{Binding Path=OutliningAreaBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}">
                        <Border Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" Background="{Binding Path=OutliningAreaBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" IsHitTestVisible="True"
                                             BorderBrush="{Binding Path=BlockIndicatorLineStroke, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}"
                                            CornerRadius="1,1,1,1"
                                            BorderThickness="{Binding Path=BlockIndicatorLineThickness, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}"
                                            SnapsToDevicePixels="True"
>
                            <Path Margin="1,1,1,1" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" Fill="{Binding Path=BlockIndicatorLineStroke, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" x:Name="ExpandPath" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton" x:Key="LineButtonStyle">
        <Setter Property="FrameworkElement.Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True" Background="{Binding Path=OutliningAreaBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}">
                        <Line SnapsToDevicePixels="True" Y1="0" Y2="{Binding LineHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" Stroke="{Binding Path=BlockIndicatorLineStroke, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}"
                              StrokeThickness="{Binding Path=BlockIndicatorLineThickness, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton" x:Key="EmpyLineButtonStyle">
        <Setter Property="FrameworkElement.Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="19" Background="{Binding Path=OutliningAreaBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}">
                        <Line Y1="0" Y2="{Binding LineHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" Stroke="Transparent" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton" x:Key="EndLineButtonStyle">
        <Setter Property="FrameworkElement.Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True" Background="{Binding Path=OutliningAreaBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" Height="{Binding Path=LineHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}">
                        <Grid.Resources>
                            <local:EndLineToLineHeightConverter x:Key="lineHeightConverter" />
                        </Grid.Resources>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.5*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0.5*" />
                        </Grid.RowDefinitions>
                        <Line Y1="0" Stroke="{Binding Path=BlockIndicatorLineStroke, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}"
                              StrokeThickness="{Binding Path=BlockIndicatorLineThickness, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" HorizontalAlignment="Center">
                            <Line.Y2>
                                <MultiBinding Converter="{StaticResource lineHeightConverter}" ConverterParameter="Top">
                                    <Binding Path="LineHeight" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}" />
                                    <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}" />
                                    <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Line.Y2>
                        </Line>
                        <Line X1="2.75" X2="7" Stroke="{Binding Path=BlockIndicatorLineStroke, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}"
                              StrokeThickness="{Binding Path=BlockIndicatorLineThickness, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Row="1" />
                        <Line Y1="0" Stroke="{Binding Path=BlockIndicatorLineStroke, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}"
