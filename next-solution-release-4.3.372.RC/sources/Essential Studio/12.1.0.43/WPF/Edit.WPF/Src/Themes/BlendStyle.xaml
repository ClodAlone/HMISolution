<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:syncfusion="http://schemas.syncfusion.com/wpf" xmlns:Microsoft_Windows_Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
    xmlns:local="clr-namespace:Syncfusion.Windows.Edit">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Shared.WPF;component/SkinManager/BlendStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="VisibilityConverter" />

    <local:Int32ToStringConverter x:Key="StringConverter" />

    <local:BooleanToBackgroundBrushConverter x:Key="BrushConverter" />

    <local:BooleanToBorderBrushConverter x:Key="BorderBrushConverter" />

    <local:InvertedBooleanToBorderBrushConverter x:Key="InvertedBorderBrushConverter" />

    <local:InvertedBooleanToBackgroundBrushConverter x:Key="InvertedBackgroundBrushConverter" />

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <syncfusion:SizeToDoubleConverter x:Key="SizeToDoubleConverter" />

    <!--Brushes-->

    <SolidColorBrush x:Key="FindReplaceControlBackground" Color="#FF666666" />
    <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#FF444444" />
    <SolidColorBrush x:Key="TitleBarBackground" Color="#FF444444" />
    <SolidColorBrush x:Key="TitleBarForeground" Color="White" />

    <Style TargetType="{x:Type Popup}" x:Key="PopUpStyle">
        <Setter Property="Width" Value="320" />
        <Setter Property="Height" Value="500" />
        <Setter Property="StaysOpen" Value="True" />
        <Setter Property="AllowsTransparency" Value="False" />
    </Style>

    <Style TargetType="ToggleButton" x:Key="ToggleButtonStyle">
        <Setter Property="FrameworkElement.Focusable" Value="False" />
        <Setter Property="FrameworkElement.Width" Value="19" />
        <Setter Property="FrameworkElement.Height" Value="13" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border VerticalAlignment="Center"  HorizontalAlignment="Center" Width="19" Background="#00FFFFFF">
                        <Border Height="9" Background="Transparent"
                                             BorderBrush="Black"
                                            CornerRadius="1,1,1,1"
                                            Width="9"
                                            BorderThickness="1,1,1,1"
                                            SnapsToDevicePixels="True"
>
                            <Path Margin="1,1,1,1" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" Fill="#FF000000" Name="ExpandPath" />
                        </Border>
                        <Border.Triggers>
                        </Border.Triggers>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:LineItem}">
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="EditControlFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="0,0,0,0"
                               StrokeThickness="0"
                               Stroke="Transparent"
                               StrokeDashArray="1 2"
                               SnapsToDevicePixels="true" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton" x:Key="ExpandButtonStyle">
        <Setter Property="FrameworkElement.Focusable" Value="False" />
        <Setter Property="FrameworkElement.Width" Value="19" />
        <Setter Property="FrameworkElement.Height" Value="15" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border VerticalAlignment="Center"  HorizontalAlignment="Center" Background="{Binding Path=OutliningAreaBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}">
                        <Border Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" Background="{Binding Path=OutliningAreaBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" IsHitTestVisible="True"
                                             BorderBrush="{Binding Path=BlockIndicatorLineStroke, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}"
                                            CornerRadius="1,1,1,1"
                                            BorderThickness="{Binding Path=BlockIndicatorLineThickness, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}"
                                            SnapsToDevicePixels="True"
>
                            <Path Margin="1,1,1,1" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" Fill="{Binding Path=BlockIndicatorLineStroke, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" x:Name="ExpandPath" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton" x:Key="LineButtonStyle">
        <Setter Property="FrameworkElement.Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True" Background="{Binding Path=OutliningAreaBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}">
                        <Line SnapsToDevicePixels="True" Y1="0" Y2="{Binding LineHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" Stroke="{Binding Path=BlockIndicatorLineStroke, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}"
                              StrokeThickness="{Binding Path=BlockIndicatorLineThickness, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton" x:Key="EmpyLineButtonStyle">
        <Setter Property="FrameworkElement.Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="19" Background="{Binding Path=OutliningAreaBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}">
                        <Line Y1="0" Y2="{Binding LineHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" Stroke="Transparent" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton" x:Key="EndLineButtonStyle">
        <Setter Property="FrameworkElement.Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True" Background="{Binding Path=OutliningAreaBackground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" Height="{Binding Path=LineHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}">
                        <Grid.Resources>
                            <local:EndLineToLineHeightConverter x:Key="lineHeightConverter" />
                        </Grid.Resources>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.5*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0.5*" />
                        </Grid.RowDefinitions>
                        <Line Y1="0" Stroke="{Binding Path=BlockIndicatorLineStroke, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}"
                              StrokeThickness="{Binding Path=BlockIndicatorLineThickness, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" HorizontalAlignment="Center">
                            <Line.Y2>
                                <MultiBinding Converter="{StaticResource lineHeightConverter}" ConverterParameter="Top">
                                    <Binding Path="LineHeight" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}" />
                                    <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}" />
                                    <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Line.Y2>
                        </Line>
                        <Line X1="2.75" X2="7" Stroke="{Binding Path=BlockIndicatorLineStroke, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}"
                              StrokeThickness="{Binding Path=BlockIndicatorLineThickness, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Row="1" />
                        <Line Y1="0" Stroke="{Binding Path=BlockIndicatorLineStroke, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}"
                              StrokeThickness="{Binding Path=BlockIndicatorLineThickness, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}}" HorizontalAlignment="Center" Grid.Row="2">
                            <Line.Y2>
                                <MultiBinding Converter="{StaticResource lineHeightConverter}" ConverterParameter="Bottom">
                                    <Binding Path="LineHeight" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}" />
                                    <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type local:EditControl}}" />
                                    <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Line.Y2>
                        </Line>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="close" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Name="border" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Name="text" Text="r" Margin="1" Foreground="#FFB0B0B0" FontSize="11" FontFamily="Webdings" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#FFDFDFDF" TargetName="text" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="AutoHidePathFillBrush" Color="#FFC5C5C5" />
    <SolidColorBrush x:Key="AutoHidePathStrokeBrush" Color="#FF404040" />
    <SolidColorBrush x:Key="AutoHidePathHoverFillBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AutoHidePathHoverStrokeBrush" Color="#FF262626" />

