    <Style x:Key="BlendSplitButtonStyle" TargetType="{x:Type syncfusion:SplitButton}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource SplitButtonAdvBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SplitButtonAdvBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SplitButtonAdvForeground}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type syncfusion:SplitButton}">
                    <Border	CornerRadius="3" Height="24" Name="Bd" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Opacity="{TemplateBinding Opacity}" IsEnabled="{TemplateBinding IsEnabled}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="15" />
                            </Grid.ColumnDefinitions>

                            <Border Name="PART_Button" Grid.Column="0" Background="Transparent" CornerRadius="2,0,2,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Image Name="PART_Image" Grid.Column="0" Margin="2" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed" />
                                    <TextBlock Grid.Column="1" Name="label" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="{TemplateBinding VerticalAlignment}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" Margin="2,0,2,0" />
                                </Grid>
                            </Border>

                            <Border Name="PART_ToggleButton" CornerRadius="0,2,0,2" Grid.Column="2" ToolTip="{TemplateBinding ToggleButtonToolTip}" BorderThickness="1,0,0,0" Background="Transparent" BorderBrush="Transparent">

                                <Path Name="path" Fill="{StaticResource Blend.PathFill1}" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="2" Stroke="{StaticResource Blend.PathFill}" Data="{StaticResource Blend.PathData}" Focusable="False" />
                            </Border>

                            <Popup Name="PART_Popup" Placement="Bottom" Focusable="False" PopupAnimation="Fade" AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource AncestorType={x:Type syncfusion:DropDownButton}}}">
                                <Microsoft_Windows_Themes:SystemDropShadowChrome x:Name="PART_Shadow" SnapsToDevicePixels="true">
                                    <Border Background="{StaticResource Blend.QuickDropDownBackground}" MinHeight="14" MinWidth="28" BorderThickness="1" CornerRadius="2" BorderBrush="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}">
                                        <ItemsPresenter />
                                    </Border>
                                </Microsoft_Windows_Themes:SystemDropShadowChrome>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasDropShadow" Value="True" SourceName="PART_Popup">
                            <Setter TargetName="PART_Shadow" Property="Margin" Value="0,0,5,5" />
                        </Trigger>

                        <Trigger Property="IsSmallImageVisible" Value="True">
                            <Setter TargetName="PART_Image" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger SourceName="PART_ToggleButton" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Button" Property="Background" Value="{StaticResource SplitButtonAdvHoverBackgroundBrush}" />
                            <Setter TargetName="PART_ToggleButton" Property="Background" Value="{StaticResource SplitButtonAdvDropDownHoverBackgroundBrush}" />
                            <Setter TargetName="path" Property="Stroke" Value="{StaticResource SplitButtonAdvHoverForeground}" />
                        </Trigger>

                        <Trigger SourceName="PART_Button" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Button" Property="Background" Value="{StaticResource SplitButtonAdvDropDownHoverBackgroundBrush}" />
                            <Setter TargetName="PART_ToggleButton" Property="Background" Value="{StaticResource SplitButtonAdvHoverBackgroundBrush}" />
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource SplitButtonAdvHoverForeground}" />
                        </Trigger>

                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF595959" />
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource SplitButtonAdvHoverForeground}" />
                            <Setter Property="ToolTipService.IsEnabled" Value="False" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type syncfusion:RibbonMenuItem}">
        <Setter Property="Padding" Value="1,0,3,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Blend.Foreground2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type syncfusion:RibbonMenuItem}">
                    <Border CornerRadius="2" Name="Bd">
                        <Grid Grid.ColumnSpan="3">
                            <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0" Width="25" RadiusY="0" HorizontalAlignment="Left" Fill="{StaticResource Blend.QATContextMenuLeftBarBackground}" RadiusX="0" />
                            <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="25,0,0,0" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Blend.QATContextMenuBorderBrush}" />
                            <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="26,0,0,0" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Blend.QATContextMenuBorderBrush}" />
                            <Border BorderThickness="{TemplateBinding BorderThickness}"
									Background="{TemplateBinding Panel.Background}"
									Width="{TemplateBinding Width}"
									Height="{TemplateBinding Height}"
									MinWidth="{TemplateBinding MinWidth}"
									MaxWidth="{TemplateBinding MaxWidth}"
									MinHeight="{TemplateBinding MinHeight}"
									MaxHeight="{TemplateBinding MaxHeight}"
									Margin="{TemplateBinding Margin}"
									Padding="{TemplateBinding Padding}"
									CornerRadius="{StaticResource Blend.QuickDropDownCornerRadius}"
									Name="Border"
									SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="17" />
                                    </Grid.ColumnDefinitions>

                                    <Border Name="PART_CheckBorder" Grid.Column="0" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="{StaticResource Blend.QuickDropDownCornerRadius}">
                                        <ContentPresenter Content="{TemplateBinding Icon}" Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}" RenderOptions.BitmapScalingMode="NearestNeighbor"
													Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverter}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                                    </Border>
                                    <Label Grid.Column="1" Margin="11,0,10,0" Padding="-5"  Content="{TemplateBinding MenuItem.Header}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                    <Path Width="17" Visibility="{TemplateBinding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}"
										  Grid.Column="2" Data="M0,0L4,3.5 0,7z" Fill="{TemplateBinding Foreground}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    <Popup Name="PART_Popup"
										   StaysOpen="False"
										   PopupAnimation="Fade"
										   MinWidth="10"
										   MinHeight="10"
										   HorizontalOffset="1"
										   VerticalOffset="0"
										   AllowsTransparency="true"
										   Placement="Right"
										   Focusable="false"
										   IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Microsoft_Windows_Themes:SystemDropShadowChrome Name="PART_Shadow" SnapsToDevicePixels="true">
                                            <Border BorderBrush="{StaticResource Blend.QuickDropDownBorderBrush}" CornerRadius="0" BorderThickness="1" Background="{StaticResource Blend.QuickDropDownBackground}">
                                                <Grid>
                                                    <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0" Width="25" RadiusY="2" HorizontalAlignment="Left" Fill="{StaticResource Blend.QATContextMenuLeftBarBackground}" RadiusX="2" />
                                                    <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="25,0,0,0" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Blend.QATContextMenuBorderBrush}" />
                                                    <Rectangle Visibility="{TemplateBinding IconBarEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="26,0,0,0" Width="1" HorizontalAlignment="Left" Fill="{StaticResource Blend.QATContextMenuBorderBrush}" />
                                                    <ScrollViewer Margin="0,0,1,0" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}" CanContentScroll="True" Grid.ColumnSpan="2">
                                                        <ItemsPresenter Name="Presenter" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Grid.IsSharedSizeScope="true" />
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </Microsoft_Windows_Themes:SystemDropShadowChrome>
                                    </Popup>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="#FFAAAAAA" />
                <Setter Property="Foreground" Value="{StaticResource Blend.Foreground3}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BlendFindReplaceControlStyle" TargetType="{x:Type local:FindReplaceControl}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource EditControlFocusVisualStyle}" />
        <Setter Property="MinWidth" Value="350" />
        <Setter Property="Background" Value="{StaticResource FindReplaceControlBackground}" />
        <Setter Property="FocusManager.IsFocusScope" Value="True" />
        <Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=PART_FindWhat}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FindReplaceControl}">
                    <Grid Background="{TemplateBinding Background}"  x:Name="PART_MainGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="{Binding ElementName=PART_Find, Path=Background}" BorderBrush="DarkGray" BorderThickness="1" Margin="-1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid x:Name="PART_TitleGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="4*" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="PART_TitleContentGrid" Margin="5,0,5,0">
                                    <syncfusion:RibbonButton x:Name="PART_RibbonFind" Margin="0,0,0,0" Height="20" Label="" Grid.Column="2" Padding="0,2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" SmallIcon="{x:Null}" IsToggle="True" ClickMode="Press" IsHitTestVisible="False" Style="{StaticResource RibbonButtonStyle}">
                                        <syncfusion:RibbonButton.IsSelected>
                                            <MultiBinding Converter="{StaticResource tabselectionConverter}">
                                                <Binding Path="IsFindTabActive" />
                                                <Binding Path="IsFindSymbolTabActive" />
                                            </MultiBinding>
                                        </syncfusion:RibbonButton.IsSelected>
                                    </syncfusion:RibbonButton>
                                    <syncfusion:SplitButton x:Name="PART_FindButton" SizeForm="Small" Style="{StaticResource BlendSplitButtonStyle}" SmallIcon="{x:Null}" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" Label="">
                                        <syncfusion:RibbonMenuItem Header="Quick Find" x:Name="PART_FindMenu" />
                                        <syncfusion:RibbonMenuItem Header="Find Symbol" x:Name="PART_FindSymbolMenu" />
                                        <syncfusion:SplitButton.ToolTip>
                                            <ToolTip Content="Switch to Quick Find">
                                            </ToolTip>
                                        </syncfusion:SplitButton.ToolTip>
                                    </syncfusion:SplitButton>
                                    <TextBlock Grid.RowSpan="1" HorizontalAlignment="Left" Margin="5,0,0,0" x:Name="PART_FindButtonText" VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Text>
                                             <MultiBinding Converter="{StaticResource tabTextConverter}">
                                                <Binding Path="IsFindTabActive" />
                                                <Binding Path="IsFindSymbolTabActive" />
                                                 <Binding Path="Text" RelativeSource="{RelativeSource Self}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                                <Border Grid.Column="1" Background="DarkGray" Margin="0,5" Width="0.5" />
                                <Grid Grid.Column="2" FocusVisualStyle="{StaticResource EditControlFocusVisualStyle}">
                                    <syncfusion:RibbonButton x:Name="PART_ReplaceButton" Label="" FocusVisualStyle="{StaticResource EditControlFocusVisualStyle}" Grid.Column="2" Padding="0,2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" SmallIcon="{x:Null}" IsSelected="{Binding IsReplaceTabActive}" IsToggle="False" ClickMode="Press" Style="{StaticResource RibbonButtonStyle}">
                                        <syncfusion:RibbonButton.ToolTip>
                                            <ToolTip Content="Switch to Quick Replace" />
                                        </syncfusion:RibbonButton.ToolTip>
                                    </syncfusion:RibbonButton>
                                    <TextBlock Margin="5,0,16,0" Name="textBlock5" Text="Quick Replace" FocusVisualStyle="{StaticResource EditControlFocusVisualStyle}" VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Label Grid.Row="1" x:Name="PART_FindWhat_Label" Content="Fi_nd what" VerticalAlignment="Center" Margin="3" Grid.ColumnSpan="3" Target="{Binding ElementName=PART_FindWhat}" Padding="3,0" />
                        <syncfusion:AutoComplete x:Name="PART_FindWhat" CustomSource="{Binding FindHistory}"  Text="{Binding FindText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" MinHeight="25" Margin="4" Grid.ColumnSpan="3" />
                        <Label Content="Re_place with" Grid.Row="3" VerticalAlignment="Center" Margin="3" Grid.ColumnSpan="3" Visibility="{Binding IsReplaceTabActive, Converter={StaticResource VisibilityConverter}}" Target="{Binding ElementName=PART_ReplaceWith}" Padding="3,0" />
                        <syncfusion:AutoComplete MinHeight="25" IsHistory="True" CustomSource="{Binding ReplaceHistory}"  x:Name="PART_ReplaceWith" Text="{Binding ReplaceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsReplaceTabActive, Converter={StaticResource VisibilityConverter}}" Grid.Row="4" Margin="4" Grid.ColumnSpan="3" />
                        <Label Content="_Look in" Grid.Row="5" VerticalAlignment="Center" Margin="3" Grid.ColumnSpan="3" Target="{Binding ElementName=PART_LookIn}" Padding="3,0" />
