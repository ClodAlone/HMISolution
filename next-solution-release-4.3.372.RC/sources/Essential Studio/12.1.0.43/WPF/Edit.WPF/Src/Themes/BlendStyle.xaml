                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource AutoHidePathHoverStrokeBrush}" TargetName="autohidepath" />
                            <Setter Property="Fill" Value="{StaticResource AutoHidePathHoverFillBrush}" TargetName="autohidepath" />
                        </Trigger>
