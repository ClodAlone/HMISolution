    <local:EditTypeInfoToImageSourceConverter x:Key="typeinfoconverter" />

    <SolidColorBrush x:Key="ExpanderButtonForeground" Color="#FF262626" />
    <SolidColorBrush x:Key="ExpanderButtonBackground" Color="#FFCDCDCD" />
    <SolidColorBrush x:Key="ExpanderButtonBorderBrush" Color="#FF333333" />
    <SolidColorBrush x:Key="ExpanderButtonHoverBackground" Color="#FF777777" />
    <SolidColorBrush x:Key="ExpanderButtonHoverBorderBrush" Color="#FF333333" />
    <SolidColorBrush x:Key="ExpanderButtonSelectedBackground" Color="#FF525252" />
    <SolidColorBrush x:Key="ExpanderButtonSelectedBorderBrush" Color="#FF333333" />
    <SolidColorBrush x:Key="ExpanderButtonSelectedForeground" Color="#FFCCCCCC" />

    <Style TargetType="{x:Type ToggleButton}" x:Key="toggleButtonStyle">
        <Setter Property="Content" Value="-" />
        <Setter Property="Foreground" Value="{StaticResource ExpanderButtonForeground}" />
        <Setter Property="Background" Value="{StaticResource ExpanderButtonBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource ExpanderButtonBorderBrush}" />
        <Setter Property="IsChecked" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ExpanderButtonHoverBackground}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ExpanderButtonHoverBorderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ExpanderButtonSelectedForeground}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ExpanderButtonSelectedForeground}" />
                            <Setter Property="Background" Value="{StaticResource ExpanderButtonSelectedBackground}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ExpanderButtonSelectedBorderBrush}" />
                            <Setter Property="Content" Value="+" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource ExpanderButtonHoverBackground}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ExpanderButtonHoverBorderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ExpanderButtonSelectedForeground}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

