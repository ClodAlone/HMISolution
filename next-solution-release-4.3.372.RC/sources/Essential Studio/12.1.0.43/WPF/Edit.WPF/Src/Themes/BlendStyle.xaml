                        <Grid Margin="0,4,0,0">
                            <Path Name="autohidepath1" Data="M24.799999,0 L72.799999,0 72.799999,10.4 72.741001,10.4 72.741001,64 100.8,64 100.8,74.400001 54.82,74.400001 54.82,105.433 44.699999,105.433 44.699999,74.400001 0,74.400001 0,64 24.86,64 24.86,10.4 24.799999,10.4 z" Stroke="#FF2C2C2C" Fill="#FF2C2C2C" Stretch="Fill" Height="10" Width="11" VerticalAlignment="Center" RenderTransformOrigin="0.44,0.454" StrokeThickness=".5" />
                            <Path Name="autohidepath" Data="M24.799999,0 L72.799999,0 72.799999,10.4 72.741001,10.4 72.741001,64 100.8,64 100.8,74.400001 54.82,74.400001 54.82,105.433 44.699999,105.433 44.699999,74.400001 0,74.400001 0,64 24.86,64 24.86,10.4 24.799999,10.4 z" Stroke="{StaticResource AutoHidePathStrokeBrush}" Fill="{StaticResource AutoHidePathFillBrush}" Stretch="Fill" Height="10" Width="11" VerticalAlignment="Center" RenderTransformOrigin="0.44,0.454" StrokeThickness=".5" Margin="-2,-1,1,0" />
