                                                </Syncfusion:RibbonMenuItem.Items>
                                            </Syncfusion:RibbonMenuItem>
                                            <!--<Syncfusion:RibbonMenuItem Header="{Binding Source={StaticResource ribbonResources},Path=RenameSheet}"/>-->
                                        </Syncfusion:RibbonMenuGroup>
                                    </Syncfusion:DropDownButton>

                                </Syncfusion:RibbonBar>
                                
                            </Syncfusion:RibbonTab>

                            <Syncfusion:RibbonTab x:Name="OthersRibbonTab" Caption="{Binding Source={StaticResource ribbonResources},Path=Others}">
                                <!--Picture-->
                                <Syncfusion:RibbonBar HorizontalAlignment="Center" VerticalAlignment="Center" Header="{Binding Source={StaticResource ribbonResources},Path=Illustrations}" IsLauncherButtonVisible="False">
                                    <Syncfusion:RibbonButton Margin="7,0,0,0"  HorizontalAlignment="Center" VerticalAlignment="Center" IsToggle="False" Label="{Binding Source={StaticResource ribbonResources},Path=Picture}" SizeForm="Large" LargeIcon="{StaticResource PictureIcon}"
                                                             Command="{Binding Path=InsertPictureCommand}"/>
                                </Syncfusion:RibbonBar>
                                
                                <!--Links-->
                                <Syncfusion:RibbonBar Header="{Binding Source={StaticResource ribbonResources},Path=Links}" IsLauncherButtonVisible="False">
                                    <Syncfusion:RibbonButton Margin="0,0,4,0" HorizontalAlignment="Center" VerticalAlignment="Center" IsToggle="False" Label="{Binding Source={StaticResource ribbonResources},Path=Hyperlink}" SizeForm="Large" LargeIcon="{StaticResource HyperlinkIcon}"
                                                             Command="{Binding Path=HyperlinkCommand}"/>
                                </Syncfusion:RibbonBar>

                                <Syncfusion:RibbonBar Header="{Binding Source={StaticResource ribbonResources},Path=Show}" IsLauncherButtonVisible="False"
                                                      IsEnabled="{Binding Path=GridProperties.IsEditing,Mode=TwoWay,Converter={StaticResource InverseBoolConverter}}">
                                    <StackPanel Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <Syncfusion:RibbonCheckBox Content="{Binding Source={StaticResource ribbonResources},Path=GridLines}" IsChecked="{Binding Path=GridProperties.ShowGridLines,Mode=TwoWay}"  />
                                            <Syncfusion:RibbonCheckBox Content="{Binding Source={StaticResource ribbonResources},Path=FormulaBar}" IsChecked="{Binding Path=FormulaBarVisibility,Mode=TwoWay,Converter={StaticResource boolToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <Syncfusion:RibbonCheckBox Content="{Binding Source={StaticResource ribbonResources},Path=Headings}" IsChecked="{Binding Path=GridProperties.IsRowColumnHeadersVisible,Mode=TwoWay}" />
                                    </StackPanel>
                                </Syncfusion:RibbonBar>

                                <Syncfusion:RibbonBar Header="{Binding Source={StaticResource ribbonResources},Path=Data}" IsLauncherButtonVisible="False">
                                    <Syncfusion:RibbonButton Margin="0,0,3,0" IsToggle="False" Label="{Binding Source={StaticResource ribbonResources},Path=DataValidation}" SizeForm="Large" LargeIcon="{StaticResource DataValidationIcon}" Command="{Binding DataValidationCommand}"/>
                                </Syncfusion:RibbonBar>
                                <!--View-->
                                <Syncfusion:RibbonBar Header="{Binding Source={StaticResource ribbonResources},Path=View}" IsLauncherButtonVisible="False">
                                    <Syncfusion:DropDownButton Margin="0,0,4,0" Label="{Binding Source={StaticResource ribbonResources},Path=Freeze}" SizeForm="Large" LargeIcon="{StaticResource FreezePanesIcon}"
                                                               IsEnabled="{Binding Path=GridProperties.IsEditing,Mode=TwoWay,Converter={StaticResource InverseBoolConverter}}">
                                        <Syncfusion:RibbonMenuGroup Width="180" MinWidth="320" IconBarEnabled="False">
                                            <Syncfusion:RibbonMenuItem Height="38" IconSize="32,32" Header="{Binding Path=GridProperties.IsFrozen,Mode=TwoWay,Converter={StaticResource freezePaneTextConverter}}" Command="{Binding FreezePaneCommand}"><!--"{Binding Source={StaticResource ribbonResources},Path=FreezePanes}"-->
                                                <Syncfusion:RibbonMenuItem.CommandParameter>
                                                    <local:Freeze>FreezePanes</local:Freeze>
                                                </Syncfusion:RibbonMenuItem.CommandParameter>
                                                <Syncfusion:RibbonMenuItem.Icon>
                                                        
                                                    <Image Source="{StaticResource FreezePanesIcon}"/>
                                                </Syncfusion:RibbonMenuItem.Icon>
                                            </Syncfusion:RibbonMenuItem>
                                            <Syncfusion:RibbonMenuItem Height="38" IconSize="32,32" Header="{Binding Source={StaticResource ribbonResources},Path=FreezeTopRow}" Command="{Binding FreezePaneCommand}">
                                                <Syncfusion:RibbonMenuItem.CommandParameter>
                                                    <local:Freeze>FreezeTopRow</local:Freeze>
                                                </Syncfusion:RibbonMenuItem.CommandParameter>
                                                <Syncfusion:RibbonMenuItem.Icon>
                                                    <Image Source="{StaticResource FreezeTopRowIcon}"/>
                                                </Syncfusion:RibbonMenuItem.Icon>
                                            </Syncfusion:RibbonMenuItem>
                                            <Syncfusion:RibbonMenuItem Height="38"  IconSize="32,32" Header="{Binding Source={StaticResource ribbonResources},Path=FreezeTopColumn}" Command="{Binding FreezePaneCommand}">
                                                <Syncfusion:RibbonMenuItem.CommandParameter>
                                                    <local:Freeze>FreezeFirstColumn</local:Freeze>
                                                </Syncfusion:RibbonMenuItem.CommandParameter>
                                                <Syncfusion:RibbonMenuItem.Icon>
                                                    <Image Source="{StaticResource FreezeFirstColumnIcon}"/>
                                                </Syncfusion:RibbonMenuItem.Icon>
                                            </Syncfusion:RibbonMenuItem>
                                        </Syncfusion:RibbonMenuGroup>
                                    </Syncfusion:DropDownButton>
                                </Syncfusion:RibbonBar>
                                
                                <!--Comments-->
                                <Syncfusion:RibbonBar Header="{Binding Source={StaticResource ribbonResources},Path=Comments}" IsLauncherButtonVisible="False">
                                    <Syncfusion:RibbonButton IsToggle="False" Label="{Binding Source={StaticResource ribbonResources},Path=NewComment}" SizeForm="Large" LargeIcon="{StaticResource CommentIcon}"
                                                             Visibility="{Binding Path=GridProperties.CurrentCellStyle.Comment,Mode=TwoWay,Converter={StaticResource NewCommentVisibilityConverter}}"
                                                             Command="{Binding Path=InsertCommentCommand}"/>
                                    <Syncfusion:RibbonButton IsToggle="False" Label="{Binding Source={StaticResource ribbonResources},Path=EditComments}" SizeForm="Large" LargeIcon="{StaticResource EditCommentIcon}"
                                                             Visibility="{Binding Path=GridProperties.CurrentCellStyle.Comment,Mode=TwoWay,Converter={StaticResource EditCommentVisibilityConverter}}"
                                                             Command="{Binding Path=InsertCommentCommand}"/>

                                    <Syncfusion:RibbonButton Margin="0,0,4,0" IsToggle="False" Label="{Binding Source={StaticResource ribbonResources},Path=DeleteComments}" SizeForm="Large" LargeIcon="{StaticResource DeleteCommentIcon}"
                                  IsEnabled="{Binding Path=GridProperties.CurrentCellStyle.Comment,Mode=TwoWay,Converter={StaticResource DeleteCommentEnableConverter}}"                                  
                                                             Command="{Binding Path=DeleteCommentCommand}"/>
                                </Syncfusion:RibbonBar>

                                <Syncfusion:RibbonBar Header="{Binding Source={StaticResource ribbonResources},Path=Changes}" IsLauncherButtonVisible="False">
                                    <Syncfusion:RibbonButton IsToggle="False" Label="{Binding Source={StaticResource ribbonResources},Path=ProtectSheet}" Width="60" SizeForm="Large" LargeIcon="{StaticResource ProtectSheetIcon}"
                                                             Command="{Binding ProtectCurrentSheetCommand}"  Visibility="{Binding Path=ExcelProperties.IsPasswordProtected,Mode=TwoWay,Converter={StaticResource protectSheetVisibleConverter}}"  />
                                    <Syncfusion:RibbonButton  IsToggle="False" Label="{Binding Source={StaticResource ribbonResources},Path=UnProtectSheet}" SizeForm="Large" LargeIcon="{StaticResource ProtectSheetIcon}"
                                                             Command="{Binding ProtectCurrentSheetCommand}" Visibility="{Binding Path=ExcelProperties.IsPasswordProtected,Mode=TwoWay,Converter={StaticResource unProtectSheetVisibleConverter}}" />
                                    <Syncfusion:RibbonButton Margin="0,0,3,0" IsToggle="True" IsSelected="{Binding Path=ExcelProperties.IsWorkBookProtected,Mode=OneWay}" Label="{Binding Source={StaticResource ribbonResources},Path=ProtectWorkbook}"  SizeForm="Large" LargeIcon="{StaticResource ProtectWorkBookIcon}"
                                                             Command="{Binding ProtectWorkbookCommand}"/>
                                </Syncfusion:RibbonBar>

                                <Syncfusion:RibbonBar Header="{Binding Source={StaticResource ribbonResources},Path=Outline}" Syncfusion:RibbonBar.LauncherCommand="{Binding GroupOptionsCommand}" 
                                                      IsLauncherButtonVisible="True">

                                    <Syncfusion:RibbonButton IsToggle="False" Label="{Binding Source={StaticResource ribbonResources},Path=Group}"  SizeForm="Large" LargeIcon="{StaticResource GroupIcon}"
                                                             Command="{Binding GroupCommand}" />

                                    <Syncfusion:RibbonButton IsToggle="False" Label="{Binding Source={StaticResource ribbonResources},Path=Ungroup}"  SizeForm="Large" LargeIcon="{StaticResource UngroupIcon}"
                                                             Command="{Binding UngroupCommand}" />
                                </Syncfusion:RibbonBar>
                            </Syncfusion:RibbonTab>
                        </Syncfusion:Ribbon>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource ExcelEditorRibbonStyle}" TargetType="local:SpreadsheetRibbon"/>    
</ResourceDictionary>