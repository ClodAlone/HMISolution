    <Style TargetType="local:VirtualizingCellsControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#FF7fd0de" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

