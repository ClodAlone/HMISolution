                    <Grid Background="Transparent">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverButtonBorder" Storyboard.TargetProperty="Opacity" To="1"/>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Pressed">
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="MouseOverButtonBorder" Width="14" Opacity="0" Height="14" Background="{StaticResource TabControlAdvButtonBackgroundBrushKey}" BorderBrush="{StaticResource TabControlAdvButtonBorderBrushKey}" BorderThickness="1"/>
                        <Border x:Name="ButtonBorder" Width="14" Height="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="PART_Path1" Data="M0,0L4,3.5 0,7" Stroke="{StaticResource TabControlAdvButtonPathBrushKey}" 
                                      Fill="{StaticResource TabControlAdvButtonPathBrushKey}"/>
                                <Path x:Name="PART_Path2" Data="M4,0L8,3.5 4,7"  Stroke="{StaticResource TabControlAdvButtonPathBrushKey}" 
                                      Fill="{StaticResource TabControlAdvButtonPathBrushKey}" Visibility="Collapsed"/>
                                <Path x:Name="PART_Path3" Data="M5,0L5,7" Stroke="{StaticResource TabControlAdvButtonPathBrushKey}" 
                                      Fill="{StaticResource TabControlAdvButtonPathBrushKey}" Visibility="Collapsed"/>
                                <Path x:Name="PART_Path4" Data="M8,0L4,3.5 8,7" Stroke="{StaticResource TabControlAdvButtonPathBrushKey}" 
                                      Fill="{StaticResource TabControlAdvButtonPathBrushKey}" Visibility="Collapsed"/>
                                <Path x:Name="PART_Path5" Data="M4,0L0,3.5 4,7" Stroke="{StaticResource TabControlAdvButtonPathBrushKey}" 
                                      Fill="{StaticResource TabControlAdvButtonPathBrushKey}" Visibility="Collapsed"/>
                                <Path x:Name="PART_Path6" Data="M2,0L2,7" Stroke="{StaticResource TabControlAdvButtonPathBrushKey}" 
                                      Fill="{StaticResource TabControlAdvButtonPathBrushKey}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource local:ScrollingButton}" TargetType="local:ScrollingButton"/>

    <Style TargetType="local:MenuButton" x:Key="local:MenuButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MenuButton">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverButtonBorder" Storyboard.TargetProperty="Opacity" To="1"/>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="MouseOverButtonBorder" Width="14" Height="14" Opacity="0" Background="{StaticResource TabControlAdvButtonBackgroundBrushKey}" BorderBrush="{StaticResource TabControlAdvButtonBorderBrushKey}" BorderThickness="1"/>
                        <Border x:Name="ButtonBorder" Width="14" Height="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Path x:Name="PathButton"
				                Fill="{StaticResource TabControlAdvButtonPathBrushKey}"
				                HorizontalAlignment="Center" VerticalAlignment="Center"
				                Width="8" Height="8">
                                <Path.Data>
                                    <GeometryGroup>
                                        <PathGeometry>
                                            <PathFigure StartPoint="0,1" IsFilled="True" IsClosed="True">
                                                <LineSegment Point="8,1"/>
                                                <LineSegment Point="8,3"/>
                                                <LineSegment Point="0,3"/>
                                            </PathFigure>
                                        </PathGeometry>
                                        <PathGeometry>
                                            <PathFigure StartPoint="0,4" IsFilled="True" IsClosed="True">
                                                <LineSegment Point="4,8"/>
                                                <LineSegment Point="8,4"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource local:MenuButton}" TargetType="local:MenuButton"/>

    <Style TargetType="local:CloseButton" x:Key="local:CloseButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CloseButton">
                    <Grid Background="Transparent">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverButtonBorder" Storyboard.TargetProperty="Opacity" To="1"/>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="MouseOverButtonBorder" Width="14" Height="14" Opacity="0" Background="{StaticResource TabControlAdvButtonBackgroundBrushKey}" BorderBrush="{StaticResource TabControlAdvButtonBorderBrushKey}" BorderThickness="1"/>

                        <Border x:Name="ButtonBorder" Width="14" Height="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Path x:Name="CrossPath"
				                    Stroke="{StaticResource TabControlAdvButtonPathBrushKey}"
				                    StrokeThickness="1.5"
                                    Data="M1,1 L7,7 M1,7 L7,1"
				                    HorizontalAlignment="Center" VerticalAlignment="Center"
				                    Width="8" Height="8"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource local:CloseButton}" TargetType="local:CloseButton"/>

    <Style TargetType="local:TabPanelAdv" x:Key="local:TabPanelAdv">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabPanelAdv">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
							Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid Background="Transparent" Height="18">
                            <Border HorizontalAlignment="Stretch" Height="2" VerticalAlignment="Bottom" BorderThickness="1,0,1,0" 
                                    BorderBrush="{StaticResource TabControlAdvHoverSelectedBorderBrushKey}" Background="{StaticResource TabControlAdvLightBorderBrushKey}"/>
                            <Border x:Name="BottomBorder" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                    BorderThickness="0" BorderBrush="{StaticResource TabControlAdvHoverSelectedBorderBrushKey}" 
                                    CornerRadius="3">
                                <Border BorderThickness="0" BorderBrush="{StaticResource TabControlAdvLightBorderBrushKey}" CornerRadius="3">
                                    <Border BorderThickness="0" BorderBrush="{StaticResource TabControlAdvBlueBorderBrushKey}">
                                        <Border BorderThickness="1" BorderBrush="{StaticResource TabControlAdvHoverSelectedBorderBrushKey}"/>
                                    </Border>
                                </Border>
                            </Border>
                            <controlsToolkit:DockPanel x:Name="DockPanel" LastChildFill="False">
                                <Border x:Name="ButtonsBorder" controlsToolkit:DockPanel.Dock="Right">
                                    <controlsToolkit:DockPanel>
                                        <local:CloseButton 
                                            x:Name="PART_CloseButton" Width="14" Height="14"
                                            Style="{StaticResource local:CloseButton}"               
                                            controlsToolkit:DockPanel.Dock="Right"/>
                                        <StackPanel x:Name="MenuPanel" controlsToolkit:DockPanel.Dock="Right" Width="14" Height="14">
                                            <local:TabPopupMenu 
                                                x:Name="TabPopupMenu"
                                                Style="{StaticResource local:TabPopupMenu}"/>
                                            <local:MenuButton 
                                                x:Name="PART_MenuButton"
                                                Style="{StaticResource local:MenuButton}" 
                                                Width="14" Height="14"/>
                                        </StackPanel>
                                        <Border Background="{StaticResource ScrollingButtonBackgroundBrush}"  BorderBrush="#FF343434" BorderThickness="0,0,0,1" Margin="0,0,1,1">
                                            <local:ScrollingPanel x:Name="PART_ScrollingPanel" HorizontalAlignment="Center" Background="Transparent" controlsToolkit:DockPanel.Dock="Left">
                                                <local:ScrollingButton 
                                                x:Name="FirstTab" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="FirstTab" Visibility="Collapsed"/>
                                                <local:ScrollingButton 
                                                x:Name="PrevPage"
                                                
                                                ScrollDirection="PrevPage" Visibility="Collapsed"/>
                                                <local:ScrollingButton 
                                                x:Name="PrevTab" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="PrevTab"/>
                                                <local:ScrollingButton 
                                                x:Name="NextTab"
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="NextTab"/>
                                                <local:ScrollingButton 
                                                x:Name="NextPage" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="NextPage" Visibility="Collapsed"/>
                                                <local:ScrollingButton 
                                                x:Name="LastTab" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="LastTab" Visibility="Collapsed"/>
                                            </local:ScrollingPanel>
                                        </Border>
                                    </controlsToolkit:DockPanel>
                                </Border>
                                <ContentPresenter Name="PART_TabItems" 
                                        controlsToolkit:DockPanel.Dock="Right">
                                </ContentPresenter>
                            </controlsToolkit:DockPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource local:TabPanelAdv}" TargetType="local:TabPanelAdv"/>

    <Style TargetType="local:TabItemAdv" x:Key="TabItemAdvStyle">
        <Setter Property="Margin" Value="0,0,-18,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabItemAdv">
                    <Grid Background="Transparent">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Margin">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="3,0,3,3"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard >
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Margin">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="3,0,3,3"/>
                                        </ObjectAnimationUsingKeyFrames>                                       
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="SelectionStates">
                                <vsm:VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Margin">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="-3,0,0,-3"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="UnSelected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Margin">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="3,0,3,3"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="FocusStates">
                                <vsm:VisualState x:Name="LostFocus"/>
                                <vsm:VisualState x:Name="GotFocus"/>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <local:TabItemAdvBorderAero x:Name="TabItemBorder"
                            Background="{TemplateBinding Background}" Style="{StaticResource local:TabItemAdvBorderAero}"
                            >
                            <controlsToolkit:DockPanel x:Name="PART_DockPanel" LastChildFill="True">
                                <local:DragMarker 
                                x:Name="DragMarker"
                                Style="{StaticResource local:DragMarker}"/>
                                <local:CloseButton 
                                x:Name="PART_CloseButton"
                                Style="{StaticResource local:CloseButton}"
                                Width="15" Height="14" Margin="2,0,3,0" controlsToolkit:DockPanel.Dock="Right"
                                VerticalAlignment="Center"/>
                                <Image x:Name="PART_Image" Stretch="None" Margin="4,0,4,0"
                               VerticalAlignment="Center"/>
                                <local:TabContentPanel x:Name="TabContentPanel" Background="{TemplateBinding Background}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                    <TextBox x:Name="PART_TextBox"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Visibility="Collapsed"
                                      Margin="0,0,2,0"/>
                                    <ContentPresenter x:Name="PART_Content"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Visibility="Visible"
                                      Margin="0,0,2,0">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock" >
                                                <Setter Property="Foreground" Value="Black"/>
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </local:TabContentPanel>
                            </controlsToolkit:DockPanel>
                        </local:TabItemAdvBorderAero>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <Style BasedOn="{StaticResource TabItemAdvStyle}" TargetType="local:TabItemAdv"/>

    <Style TargetType="local:TabControlAdv" >
        <Setter Property="TabScrollButtonVisibility" Value="Visible"/>
        <Setter Property="ShowTabListContextMenu" Value="False"/>
	<Setter property="TabStripPlacement" Value="Bottom" />
        <Setter Property="TabScrollStyle" Value="Extended"/>
        <Setter Property="CloseButtonType" Value="Hide"/>
        <Setter Property="MinHeight"   Value="100"/>       
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:TabLayoutPanel x:Name="TabLayoutPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabControlAdv">
                    <Grid Background="Transparent" VerticalAlignment="Stretch">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="TopPlacement">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 0, 1, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel2" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 0, 1, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel3" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 0, 1, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel4" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 0, 1, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel5" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 0, 1, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="LeftPlacement">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0, 1, 1, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel2" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0, 1, 1, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel3" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0, 1, 1, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel4" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0, 1, 1, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel5" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0, 1, 1, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="RightPlacement">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 0, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel2" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 0, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel3" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 0, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel4" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 0, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel5" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 0, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="BottomPlacement">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel2" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel3" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel4" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel5" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>                     
                            <local:TabControlPanel x:Name="TabControlPanel" Background="{TemplateBinding Background}">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#FF6A6A6A">
                                    <local:TabPanelAdv 
                                    x:Name="TabPanel" Background="Transparent"
                                    Style="{StaticResource local:TabPanelAdv}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!--<ItemsPresenter x:Name="ItemsPresenter"/>-->
                                        <local:TabLayoutPanel x:Name="TabLayoutPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </local:TabPanelAdv>
                                </Grid>
                                <Border x:Name="ContentPanel" Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent" CornerRadius="0">
                                    <Border x:Name="ContentPanel2" BorderBrush="{StaticResource TabControlAdvLightBorderBrushKey}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                        <Border x:Name="ContentPanel3" BorderBrush="Transparent">
                                            <Border x:Name="ContentPanel4" BorderBrush="Transparent">
                                                <Border x:Name="ContentPanel5" BorderBrush="Transparent">
                                                    <ContentPresenter Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                </Border>
                                            </Border>
                                        </Border>
                                    </Border>
                                </Border>
                            </local:TabControlPanel>                     
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="MenuItemStyle" Value="{StaticResource local:TabPopupMenuItem}"/>
    </Style>

 

</ResourceDictionary>
