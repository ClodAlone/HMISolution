                                    <Rectangle x:Name="BackgroundGradient" Fill="{StaticResource ScrollBarHorizontalRepeatButtonGradientBrushKey}" Stroke="#FF424242" StrokeThickness="1" Opacity="0"/>

                                    <Rectangle x:Name="Highlight" Stroke="{StaticResource FocusedBorderBrushKey}" StrokeThickness="1" RadiusX="1" RadiusY="1" Margin="1" IsHitTestVisible="false" Opacity="0"/>
                                    <Path Stretch="Uniform" Height="8" Width="10" Fill="{StaticResource ScrollBarGlyphBrushKey}" Data="F1 M 110.692,342.252L 110.692,352.682L 104.594,347.467L 110.692,342.252 Z "/>

