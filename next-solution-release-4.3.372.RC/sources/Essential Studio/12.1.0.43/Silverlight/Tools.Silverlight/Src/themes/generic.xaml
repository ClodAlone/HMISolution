                                <DoubleAnimation To="0" Duration="0:0:0.25"
												 Storyboard.TargetName="PopupBorder"
												 Storyboard.TargetProperty="Opacity" />
                            </Storyboard>
                            <Storyboard x:Key="aniMouseOver" >
                                <ColorAnimation Duration="0:0:0.25"
												Storyboard.TargetName="ContentPresenterBorder"
												Storyboard.TargetProperty="(UIElement.Background).(SolidColorBrush.Color)" To="White" />
                            </Storyboard>
                        </Grid.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PopupBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource Default_NavigationToolbarItem_OverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOut">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
									Storyboard.TargetName="PopupBorder" To="1" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PopupBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource Default_GroupBar_HeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectStates">
                                <VisualState x:Name="Select">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PopupBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource Default_NavigationToolbarItem_SelectedBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unselect">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PopupBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource Default_GroupBar_HeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="NavPaneStates">
                                <VisualState x:Name="NavPaneSelected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="#C2CFE5" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="NavPaneUnselected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="White" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="NavPaneMouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource Default_NavigationPaneMouseOverColor}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="NavPaneMouseOut">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="White" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                        </VisualStateManager.VisualStateGroups>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="25"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="MainHostGrid" Background="{TemplateBinding Background}"  Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="HeaderGrid" Background="{StaticResource Default_GroupBar_HeaderBrush}" Grid.Row="0" Height="30" >
                                <ContentControl x:Name="ItemHeaderText" Margin="15,2,2,2"  VerticalAlignment="Center" />
                                <Border x:Name="CollapseButton" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Right" Width="16" Height="15" Background="Transparent" Visibility="{TemplateBinding AllowCollapseVisibility}">
                                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center" Width="8" Height="7">
                                        <Path Data="M 3, 0 L 0, 3 3, 6" HorizontalAlignment="Center" Stroke="{StaticResource Default_CollapseArrowColor}" x:Name="PART1_Path1" VerticalAlignment="Center"/>
                                        <Path Data="M 7, 0 L 4, 3 7, 6" HorizontalAlignment="Center" Stroke="{StaticResource Default_CollapseArrowColor}" x:Name="PART1_Path2" VerticalAlignment="Center"/>
                                    </Canvas>
                                </Border>

                                <Border x:Name="ExpandButton" Visibility="Collapsed" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Right" Width="16" Height="15" Background="Transparent">
                                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center" Width="8" Height="7">
                                        <Path Data="M 1, 0 L 4, 3 1, 6" HorizontalAlignment="Center" Stroke="{StaticResource Default_CollapseArrowColor}" x:Name="PART2_Path1" VerticalAlignment="Center"/>
                                        <Path Data="M 5, 0 L 8, 3 5, 6" HorizontalAlignment="Center" Stroke="{StaticResource Default_CollapseArrowColor}" x:Name="PART2_Path2" VerticalAlignment="Center"/>
                                    </Canvas>
                                </Border>
                            </Grid>

                            <Border x:Name="ItemBorder" Grid.Row="1" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                <Grid x:Name="ItemHost">
                                    <Grid x:Name="ItemGrid" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                    <local:PopupMenu x:Name="NavPanePopup"/>

                                    <ScrollViewer x:Name="NavPaneScrollBar" BorderBrush="Transparent" BorderThickness="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                                        <ContentControl x:Name="NavPanelContent" Margin="0,70,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                            <ContentControl.Content>
                                                <Grid x:Name="NavPaneGrid" Background="Transparent" Visibility="Collapsed">
                                                    <Border x:Name="NavPaneBorder"  RenderTransformOrigin="0,0">
                                                        <TextBlock x:Name="NavPaneText" Text="{TemplateBinding NavigationPaneText}" TextAlignment="Center" HorizontalAlignment="Center" Visibility="{TemplateBinding ShowNavigationPaneTextVisibility}">
                                                        </TextBlock>
                                                    </Border>
                                                    <Grid.RenderTransform>
                                                        <RotateTransform Angle="-90"/>
                                                    </Grid.RenderTransform>
                                                </Grid>
                                            </ContentControl.Content>
                                        </ContentControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border x:Name="GroupBarSplitter" Grid.Row="2" Background="{StaticResource Default_Splitter_BackgroundBrush}" BorderBrush="{StaticResource Default_GroupBar_Splitter}" BorderThickness="1" Height="7" HorizontalAlignment="Stretch">
                            <Border Grid.Row="2" Width="25" Height="7" HorizontalAlignment="Stretch">
                                <Canvas Margin="2,0,0,0">
                                    <Line X1="1" Y1="1" X2="3" Y2="2" Stroke="White" StrokeThickness="2"/>
                                    <Line X1="5" Y1="1" X2="7" Y2="2" Stroke="White" StrokeThickness="2"/>
                                    <Line X1="9" Y1="1" X2="11" Y2="2" Stroke="White" StrokeThickness="2"/>
                                    <Line X1="13" Y1="1" X2="15" Y2="2" Stroke="White" StrokeThickness="2"/>
                                    <Line X1="17" Y1="1" X2="19" Y2="2" Stroke="White" StrokeThickness="2"/>

                                    <Line X1="0" Y1="2" X2="2" Y2="2" Stroke="Blue" StrokeThickness="2" Opacity="0.5"/>
                                    <Line X1="4" Y1="2" X2="6" Y2="2" Stroke="Blue" StrokeThickness="2" Opacity="0.5"/>
                                    <Line X1="8" Y1="2" X2="10" Y2="2" Stroke="Blue" StrokeThickness="2" Opacity="0.5"/>
                                    <Line X1="12" Y1="2" X2="14" Y2="2" Stroke="Blue" StrokeThickness="2" Opacity="0.5"/>
                                    <Line X1="16" Y1="2" X2="18" Y2="2" Stroke="Blue" StrokeThickness="2" Opacity="0.5"/>
                                </Canvas>
                            </Border>
                        </Border>

                        <Grid x:Name="ItemsGrid" Grid.Row="3">
                            <Border x:Name="StackItemsHost" Grid.Row="3" >
                            </Border>
                            <ItemsPresenter/>
                        </Grid>

                        <StackPanel Grid.Row="4" Orientation="Horizontal"  Background="{StaticResource Default_GroupBar_HeaderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        </StackPanel>

                        <StackPanel x:Name="NavPanel" Grid.Row="4" Orientation="Horizontal" Background="{StaticResource Default_GroupBar_HeaderBrush}" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                            <StackPanel x:Name="NavigationToolBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                            </StackPanel>
                            <StackPanel x:Name="DropDownMenu" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border x:Name="PopupBorder" HorizontalAlignment="Left" Height="20" Width="20" Margin="2" Background="{StaticResource Default_GroupBar_HeaderBrush}">
                                    <Canvas Width="5" Height="3" VerticalAlignment="Center"	HorizontalAlignment="Center">
                                        <Line X1="0" Y1="1" X2="5" Y2="1" StrokeThickness="1" Stroke="{StaticResource Default_NavigationToolbarItem_ArrowBrush2}"/>
                                        <Line X1="1" Y1="2" X2="4" Y2="2" StrokeThickness="1" Stroke="{StaticResource Default_NavigationToolbarItem_ArrowBrush2}"/>
                                        <Line X1="2" Y1="3" X2="3" Y2="3" StrokeThickness="1" Stroke="{StaticResource Default_NavigationToolbarItem_ArrowBrush2}"/>

                                        <Line X1="0" Y1="0" X2="5" Y2="0" StrokeThickness="1" Stroke="{StaticResource Default_NavigationToolbarItem_ArrowBrush2}"/>
                                        <Line X1="1" Y1="1" X2="4" Y2="1" StrokeThickness="1" Stroke="{StaticResource Default_NavigationToolbarItem_ArrowBrush2}"/>
                                        <Line X1="2" Y1="2" X2="3" Y2="2" StrokeThickness="1" Stroke="{StaticResource Default_NavigationToolbarItem_ArrowBrush2}"/>
                                    </Canvas>
                                </Border>
                                <local:PopupMenu x:Name="PopupMenu"/>
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:StackGrid" BasedOn="{StaticResource local:StackGrid}"/>

   

    <Style x:Key="local:GroupBar" TargetType="local:GroupBar">
        <!--<Setter Property="sm:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Background" Value="{StaticResource Default_GroupBar_Content}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Default_GroupBar_BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GroupBar">
                    <ScrollViewer Padding="{TemplateBinding Padding}"
								x:Name="ScrollViewer"    
                                Visibility="Visible"
								BorderThickness="{TemplateBinding BorderThickness}"
								BorderBrush="{TemplateBinding BorderBrush}"
								HorizontalScrollBarVisibility="Disabled"
								VerticalScrollBarVisibility="Disabled">
                        <Border x:Name="OuterBorder" Background="{TemplateBinding Background}">
                            <Grid x:Name="MainHost">
                                <local:NonStackGrid x:Name="NonStackGrid"/>
                                <local:StackGrid x:Name="StackGrid" NavigationPaneText="{TemplateBinding NavigationPaneText}"/>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:GroupBar" BasedOn="{StaticResource local:GroupBar}"/>

   
    <Style x:Key="local:GroupBarItem" TargetType="local:GroupBarItem">
        <!--<Setter Property="sm:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Background" Value="{StaticResource Default_GroupBar_Content}"/>
        <Setter Property="HeaderBackground" Value="{StaticResource Default_GroupBar_HeaderBrush}"/>
        <Setter Property="HeaderForeground" Value="Black"/>
        <Setter Property="HeaderFontFamily" Value="Arial"/>
        <Setter Property="HeaderFontSize" Value="12"/>
        <Setter Property="HeaderFontWeight" Value="Normal"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GroupBarItem">
                    <Grid x:Name="ItemHost">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightHeaderElement"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource Default_GroupBarItem_OverBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOut">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
									Storyboard.TargetName="HeaderElement" To="1" Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightHeaderElement"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource Default_GroupBar_HeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="SelectStates">
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightHeaderElement"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource Default_GroupBarItem_SelectedBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightOuterBorder"
                                        Storyboard.TargetProperty="BorderBrush" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF316AC5"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="UnSelected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightHeaderElement"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource Default_GroupBar_HeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ExpandStates">
                                <VisualState x:Name="Expanded">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PanelContent"
									Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightExpandPath"
									Storyboard.TargetProperty="Data" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"                                               
                                                    Value = "M 0 2 L 0 3 L 5 3 L 5 2 Z"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpandPath"
									Storyboard.TargetProperty="Data" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"                                               
                                                    Value = "M 0 2 L 0 3 L 5 3 L 5 2 Z"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
									Storyboard.TargetName="PanelContent"  From="0.0" To="1.0"
									Duration="0:0:0.2" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightHeaderElement"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource Default_GroupBarItem_SelectedBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Collapsed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PanelContent"
									Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightExpandPath"
									Storyboard.TargetProperty="Data" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"                                               
                                                    Value = "M 0 2 L 0 3 L 2 3 L 2 5 L 3 5 L 3 3 L 5 3 L 5 2 L 3 2 L 3 0 L 2 0 L 2 2 Z"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpandPath"
									Storyboard.TargetProperty="Data" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"                                               
                                                    Value = "M 0 2 L 0 3 L 2 3 L 2 5 L 3 5 L 3 3 L 5 3 L 5 2 L 3 2 L 3 0 L 2 0 L 2 2 Z"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HighlightHeaderElement"
									Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0"
										Value="{StaticResource Default_GroupBar_HeaderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="UnderLine" Background="Transparent" Height="2" Grid.Row="0"/>

                        <Border x:Name="HighlightOuterBorder" Grid.Row="1">
                            <Grid x:Name="HighlightHeaderElement" Background="{TemplateBinding HeaderBackground}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="HighlightHeaderElementTranslateTransform" X="0" Y="0"/>
                                </Grid.RenderTransform>

                                <Border x:Name="HighlightExpandBorder" Grid.Column="0" Height="9" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Left" BorderBrush="#FF7898B5" CornerRadius="1,1,1,1" Width="9" BorderThickness="1,1,1,1">
                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                            <LinearGradientBrush.GradientStops>
                                                <GradientStop Offset="0.2" Color="#FFFFFFFF"/>
                                                <GradientStop Offset="1" Color="#FFC0B7A6"/>
                                            </LinearGradientBrush.GradientStops>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Margin="1,1,1,1" Fill="Black" x:Name="HighlightExpandPath" Data="M 0 2 L 0 3 L 2 3 L 2 5 L 3 5 L 3 3 L 5 3 L 5 2 L 3 2 L 3 0 L 2 0 L 2 2 Z"/>
                                </Border>

                                <Image x:Name="HighlightImage" Grid.Column="0" Source="{TemplateBinding HeaderImageSource}" Margin="3" Height="{TemplateBinding ImageHeight}" Width="{TemplateBinding ImageWidth}" HorizontalAlignment="Left" Stretch="UniformToFill"/>
                                <ContentControl x:Name="HighlightHeaderText" Grid.Column="1" Margin="5,2,2,2" Content="{TemplateBinding HeaderText}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{TemplateBinding HeaderForeground}" FontFamily="{TemplateBinding HeaderFontFamily}" FontSize="{TemplateBinding HeaderFontSize}" FontWeight = "{TemplateBinding HeaderFontWeight}" HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border x:Name="OuterBorder" Grid.Row="1">
                            <Grid x:Name="HeaderElement" Background="{TemplateBinding HeaderBackground}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="HeaderElementTranslateTransform" X="0" Y="0"/>
                                </Grid.RenderTransform>

                                <Border x:Name="ExpandBorder" Grid.Column="0" Height="9" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Left" BorderBrush="#FF7898B5" CornerRadius="1,1,1,1" Width="9" BorderThickness="1,1,1,1">
                                    <Border.Background>
                                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                            <LinearGradientBrush.GradientStops>
                                                <GradientStop Offset="0.2" Color="#FFFFFFFF"/>
                                                <GradientStop Offset="1" Color="#FFC0B7A6"/>
                                            </LinearGradientBrush.GradientStops>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Path Margin="1,1,1,1" Fill="Black" x:Name="ExpandPath" Data="M 0 2 L 0 3 L 2 3 L 2 5 L 3 5 L 3 3 L 5 3 L 5 2 L 3 2 L 3 0 L 2 0 L 2 2 Z"/>
                                </Border>

                                <Image x:Name="Image" Grid.Column="0" Source="{TemplateBinding HeaderImageSource}" Margin="3" Height="{TemplateBinding ImageHeight}" Width="{TemplateBinding ImageWidth}" HorizontalAlignment="Left" Stretch="UniformToFill"/>
                                <ContentControl x:Name="HeaderText" Grid.Column="1" Margin="5,2,2,2" Content="{TemplateBinding HeaderText}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{TemplateBinding HeaderForeground}" FontFamily="{TemplateBinding HeaderFontFamily}" FontSize="{TemplateBinding HeaderFontSize}" FontWeight = "{TemplateBinding HeaderFontWeight}" HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border x:Name="BorderContent" Visibility="Collapsed" Grid.Row="2" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
								VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="ContentContainer" Background="{TemplateBinding Background}" Grid.Row="2" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition  Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="PanelContent" Visibility="Collapsed">
                                    </Border>
				    <ContentControl Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:GroupBarItem" BasedOn="{StaticResource local:GroupBarItem}"/>
    
    <!-- NumericUpDown -->

    <!--Repeat Button Style-->
    <Style x:Key="UpDownButtonStyle" TargetType="RepeatButton">
        <Setter Property="Background" Value="#FF1F3B53"/>
        <Setter Property="Foreground" Value="#FF000000"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFA3AEB9" Offset="0"/>
                    <GradientStop Color="#FF8399A9" Offset="0.375"/>
                    <GradientStop Color="#FF718597" Offset="0.375"/>
                    <GradientStop Color="#FF617584" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BackgroundAnimation" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="(Rectangle.Fill).(GradientBrush.GradientStops)[1].(GradientStop.Color)">
                                            <SplineColorKeyFrame KeyTime="0" Value="#F2FFFFFF"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="(Rectangle.Fill).(GradientBrush.GradientStops)[2].(GradientStop.Color)">
                                            <SplineColorKeyFrame KeyTime="0" Value="#CCFFFFFF"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="(Rectangle.Fill).(GradientBrush.GradientStops)[3].(GradientStop.Color)">
                                            <SplineColorKeyFrame KeyTime="0" Value="#7FFFFFFF"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BackgroundAnimation" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="(Rectangle.Fill).(GradientBrush.GradientStops)[0].(GradientStop.Color)">
                                            <SplineColorKeyFrame KeyTime="0" Value="#D8FFFFFF"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="(Rectangle.Fill).(GradientBrush.GradientStops)[1].(GradientStop.Color)">
