    <Style x:Key="BlendPropertyCatagoryViewItemStyle" TargetType="local:PropertyCatagoryViewItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PropertyCatagoryViewItem">
                    <Border Background="Transparent"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="ItemStates">
                                <vsm:VisualState x:Name="Expanded">
                                    <Storyboard>
                                        
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Presenter" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="PART_Presenter" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>

                                        <!--<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_Presenter" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:2" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_Presenter" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:2" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>-->

    </Storyboard>
    </vsm:VisualState>

    <vsm:VisualState x:Name="Collapsed">
        <Storyboard>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Presenter" Storyboard.TargetProperty="Visibility" Duration="0">
                <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                    <DiscreteObjectKeyFrame.Value>
                        <Visibility>Collapsed</Visibility>
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="PART_Presenter" Storyboard.TargetProperty="(UIElement.Opacity)">
                <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </vsm:VisualState>

    </vsm:VisualStateGroup>
    </vsm:VisualStateManager.VisualStateGroups>

    <Grid Background="{TemplateBinding LineColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ToggleButton x:Name="PART_Expander" Margin="2" IsTabStop="False"
                                      IsChecked="{Binding Path=IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"  
                                      Opacity="1" IsThreeState="False"  Width="12" Height="12"
                                      Style="{StaticResource ExpanderButtonStyle}">
        </ToggleButton>

        <ContentControl Content="{TemplateBinding Header}" x:Name="PART_Header" Background="{TemplateBinding LineColor}" Grid.Column="1"/>

        <Border Background="{TemplateBinding Background}" Grid.Column="1" Grid.Row="1">
            <ItemsPresenter Grid.Column="1" Grid.Row="1" x:Name="PART_Presenter"/>
        </Border>
    </Grid>
    </Border>
    </ControlTemplate>
    </Setter.Value>
    </Setter>
    </Style>
    <Style BasedOn="{StaticResource BlendPropertyCatagoryViewItemStyle}" TargetType="local:PropertyCatagoryViewItem"/>

    <Style x:Key="BlendPropertyViewStyle" TargetType="local:PropertyView">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PropertyView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid x:Name="LayoutRoot">

                            <!--<ScrollViewer x:Name="ScrollViewer"
                                              VerticalScrollBarVisibility="Auto" 
                                              HorizontalScrollBarVisibility="Auto"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              Background="{TemplateBinding Background}" 
                                              BorderThickness="{TemplateBinding BorderThickness}">-->

                            <ItemsPresenter x:Name="PART_Presenter"/>

                            <!--</ScrollViewer>-->
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource BlendPropertyViewStyle}" TargetType="local:PropertyView"/>

    <Style x:Key="BlendPropertyGridStyle" TargetType="local:PropertyGrid">
        <Setter Property="LineColor" Value="{StaticResource LineColor}"/>
        <Setter Property="ViewBackgroundColor" Value="{StaticResource ViewBackgroundColor}"/>
        <Setter Property="CategoryForeground" Value="{StaticResource CategoryForeground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="Foreground" Value="{StaticResource ViewForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PropertyGrid">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{StaticResource LineColor}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton  Visibility="{TemplateBinding ButtonPanelVisibility}" x:Name="PART_GroupButton" HorizontalAlignment="Left" Width="20" Height="20" Background="LightGray" Margin="5"   VerticalAlignment="Center"
                                              IsChecked="{Binding EnableGrouping,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Style="{StaticResource ToggleGroupButtonStyle}">
                                </ToggleButton>

                                <ToggleButton  Visibility="{TemplateBinding ButtonPanelVisibility}" Grid.Column="1" x:Name="PART_SortButton" HorizontalAlignment="Left" Width="20" Height="20" Background="LightGray" Margin="5" 
                                              IsChecked="{Binding EnableGrouping,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay,Converter={StaticResource InvertBooleanConverter}}" 
                                              Style="{StaticResource ToggleSortButtonStyle}"  VerticalAlignment="Center">
                                </ToggleButton>

                                <Border Grid.Column="2" Background="#FF333333" BorderBrush="#FF707070" BorderThickness="1" Margin="4,3,4,5" Visibility="{TemplateBinding SearchBoxVisibility}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="22"/>
                                        </Grid.ColumnDefinitions>
                                        <shared:MaskedTextBox x:Name="PART_SearchText" Margin=".5" VerticalAlignment="Center" HorizontalAlignment="Stretch"  Background="Transparent" BorderBrush="Transparent"
                                                      WatermarkText="Search"  WatermarkTextIsVisible="True" Grid.Column="0" Cursor="IBeam" Height="20"/>
                                        <Button x:Name="PART_Clear" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Width="18" Height="18" Grid.Column="1" >
                                            <Button.Content>
                                                <Path Name="pathButton"
				Stroke="{TemplateBinding Foreground}"
				StrokeThickness="1.5"
                Data="M1,1 L7,7 M1,7 L7,1"
				HorizontalAlignment="Center" VerticalAlignment="Center"
				Width="8" Height="8"/>
                                            </Button.Content>
                                        </Button>
                                    </Grid>
                                </Border>


                            </Grid>

                            <ScrollViewer Grid.Row="1" Padding="0" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource LineColor}" Width="14" Visibility="{Binding EnableGrouping, Converter={StaticResource InvertBooleanVisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <local:PropertyView Grid.Column="1" ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Properties}" 
                                                EnableGrouping="{TemplateBinding EnableGrouping}" x:Name="PART_PropertyView"
                                                ViewBackgroundColor="{Binding Path=ViewBackgroundColor,RelativeSource={RelativeSource TemplatedParent}}"
                                                LineColor="{Binding Path=LineColor,RelativeSource={RelativeSource TemplatedParent}}" 
                                                CategoryForeground="{Binding CategoryForeground,RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Grid>
                            </ScrollViewer>

                            <Border Grid.Row="2" Visibility="{TemplateBinding DescriptionPanelVisibility}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0 1 0 0" Background="{StaticResource LineColor}">
                                <StackPanel >
                                    <TextBlock Margin="5" FontWeight="Bold" Text="{Binding Path=SelectedItem, ElementName=PART_PropertyView, Converter={StaticResource NameConverter}, ConverterParameter=Name}"/>
                                    <TextBlock Margin="5" TextWrapping="Wrap" Text="{Binding Path=SelectedItem, ElementName=PART_PropertyView, Converter={StaticResource NameConverter}, ConverterParameter=Description}"/>
                                </StackPanel>
                            </Border>
                        </Grid>                     
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource BlendPropertyGridStyle}" TargetType="local:PropertyGrid"/>

</ResourceDictionary>
