<sync:WindowControl x:Class="Syncfusion.Windows.Tools.Controls.HyperlinkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" AnimationType="None"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="hyperlinkDialog"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" VisualStyle="Aero"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" WindowStartupLocation="CenterScreen" Width="350" Height="220"
    mc:Ignorable="d" xmlns:sync="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
    xmlns:Syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight" 
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls" Title="Hyperlink" ResizeMode="NoResize" IconSize="0,0" >
   
    <StackPanel Background="#FFF0F0F0" Margin="-1,-4,-1,-1">
        <StackPanel.Resources>
            <local:StringToBooleanConverter x:Key="StringToBoolean"/>
        </StackPanel.Resources>
        <Border BorderBrush="#FF898C95" Background="White" Margin="0,0,0,10" BorderThickness="1">
            <Grid x:Name="LayoutRoot" Background="White" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Text      :" Grid.Row="0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0"/>
                <TextBox x:Name="txthyperText" Margin="10" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" HorizontalAlignment="Left" FontSize="12" VerticalAlignment="Center" Margin="15,0,0,0" Text="Address :"/>
                <TextBox Grid.Row="1" x:Name="txtAddress" Margin="10" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
				<TextBlock Grid.Row="2" HorizontalAlignment="Left" FontSize="12" Text="Link      :" Margin="15,0,0,0" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Name="cmbTarget" HorizontalAlignment="Left" SelectedIndex="0" Margin="10" VerticalAlignment="Center" Width="130" Grid.Column="1">
                    <ComboBoxItem>New Window</ComboBoxItem>
                    <ComboBoxItem>Self</ComboBoxItem>
                </ComboBox>

            </Grid>
        </Border>
        <Grid HorizontalAlignment="Right" Margin="0,-3,2,0" VerticalAlignment="Center" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"></ColumnDefinition>
                <ColumnDefinition Width="84"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Content="OK" Width="75" Grid.Column="0" IsEnabled="{Binding Path=Text, ElementName=txtAddress, Converter={StaticResource StringToBoolean}}" HorizontalAlignment="Left"  Click="btnAccept_Click"  Margin="0,4,0,4"></Button>
            <Button Name="btnAccept" Grid.Column="1" Content="Cancel" HorizontalAlignment="Right" VerticalAlignment="Center" Width="75" Margin="4" Click="Button_Click"/>
        </Grid>
    </StackPanel>
   
</sync:WindowControl>

    