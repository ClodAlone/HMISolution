<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"   xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
    xmlns:gridcommon="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.GridCommon.Silverlight"
    xmlns:contextmenu="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"
    xmlns:local="clr-namespace:Syncfusion.Silverlight.Grid.Olap">
    <SolidColorBrush x:Key="Classic.GridBackground" Color="#FFFFFF"/>

    <SolidColorBrush Color="#FF595959" x:Key="BlendGridBackground"/>



   
    <SolidColorBrush x:Key="Blend.ColumnHeaderBackgroundBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="Blend.RowHeaderBackgroundBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="Blend.ValueCellBackgroundBrush" Color="#FF414141"/>
    <SolidColorBrush x:Key="Blend.SummaryColumnBackgroundBrush" Color="#FF2E2E2E"/>
    <SolidColorBrush x:Key="Blend.SummaryRowBackgroundBrush" Color="#FF2E2E2E"/>

    <SolidColorBrush x:Key="Blend.ColumnHeaderForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Blend.RowHeaderForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Blend.ValueCellForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Blend.SummaryColumnForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Blend.SummaryRowForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Blend.GridLineStroke" Color="Black"/>

    <Style TargetType="local:OlapGridExpandHyperlinkCell">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OlapGridExpandHyperlinkCell">
                    <Grid x:Name="RootElement">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <SolidColorBrush Color="Red"/>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="TextDecorations">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Underline
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="19px"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!--Expanders-->
                        <ToggleButton VerticalAlignment="Top"   x:Name="PART_Expander" Margin="4,2,0,5" Style="{Binding Path=ExpanderStyle,RelativeSource={RelativeSource TemplatedParent}}"
                          IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" 
                          Visibility="{Binding Path=HasChildren,RelativeSource={RelativeSource TemplatedParent}}"/>
                        <!--Textblock of expander cells-->
                        <TextBlock Margin="1,0,2,0" 
                                   x:Name="PART_InnerTextBlock" 
                                   Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CellDescriptor.CellValue}"
                                   Foreground="{Binding Path=Foreground,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontFamily="{Binding Path=FontFamily,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontWeight="{Binding Path=FontWeight,RelativeSource={RelativeSource TemplatedParent}}" />
                        <contextmenu:ContextMenuAdvService.ContextMenuAdv>
                            <contextmenu:ContextMenuAdv x:Name="PART_ContextMenuAdv" Visibility="Collapsed" 
                                                        Foreground="{Binding Path=Foreground,RelativeSource={RelativeSource TemplatedParent}}"
                                                        Background="{Binding Path=Background,RelativeSource={RelativeSource TemplatedParent}}">
                            </contextmenu:ContextMenuAdv>
                        </contextmenu:ContextMenuAdvService.ContextMenuAdv>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExpanderStyle"
           TargetType="ToggleButton">


        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="White"/>
                                        </ObjectAnimationUsingKeyFrames >
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="White"/>
                                        </ObjectAnimationUsingKeyFrames >
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CheckStates">
                                <vsm:VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                           BorderBrush="Transparent" 
                                            CornerRadius="1" 
                                            Width="11" 
                                            BorderThickness="0" 
                                           
                                            Background="Transparent"   HorizontalAlignment="Right"  >
                            <Grid>
                                <Path x:Name="UncheckedVisual" Data="M357,301 L357.5,352.5 422.5,325.5 z" Margin="2.874,2.032,1.126,0" Stretch="Fill"  Height="6.032" VerticalAlignment="Top" Fill="#FF9B9B9B">

                                </Path>
                                <Path x:Name="CheckedVisual" Data="M290.5,329 L312.5,329.5 302.5,347.5 z" Margin="2.874,2.032,1.126,0" Stretch="Fill"  Height="6.032" VerticalAlignment="Top" Fill="#FF9B9B9B" >



                                </Path>

                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                            />
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style 
        TargetType="local:OlapGrid">
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <local:OlapGridCellStyle Background="{StaticResource Blend.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Blend.ColumnHeaderForegroundBrush}" 
                             FontFamily="Calibri"/>
            </Setter.Value>
        </Setter>
        <Setter Property="RowHeaderStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource Blend.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Blend.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"/>
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryColumnStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource Blend.SummaryColumnBackgroundBrush}"
                             Foreground="{StaticResource Blend.SummaryColumnForegroundBrush}"
                             FontFamily="Calibri"/>
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryRowStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource Blend.SummaryRowBackgroundBrush}"
                             Foreground="{StaticResource Blend.SummaryRowForegroundBrush}"
                             FontFamily="Calibri"/>
            </Setter.Value>
        </Setter>
        <Setter Property="ValueCellStyle">
            <Setter.Value>
                <local:OlapGridCellStyle Background="{StaticResource Blend.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Blend.ValueCellForegroundBrush}"
                             FontFamily="Calibri"/>
            </Setter.Value>
        </Setter>
        <Setter Property="GridLineStroke"  Value="{StaticResource Blend.GridLineStroke}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource ExpanderStyle}"/>
        <Setter Property="Background" Value="{StaticResource BlendGridBackground}"/>
    </Style>
</ResourceDictionary>
