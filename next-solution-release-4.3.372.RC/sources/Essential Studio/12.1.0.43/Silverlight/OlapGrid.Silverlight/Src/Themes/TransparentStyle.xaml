<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"   xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
    xmlns:gridcommon="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.GridCommon.Silverlight"
    xmlns:contextmenu="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"
    xmlns:local="clr-namespace:Syncfusion.Silverlight.Grid.Olap">
    <SolidColorBrush x:Key="Classic.GridBackground" Color="#4CFFFFFF"/>

    <SolidColorBrush Color="#4CFFFFFF" x:Key="TransparentGridBackground"/>


    <LinearGradientBrush  x:Key="Transparent.ColumnHeaderBackgroundBrush" EndPoint="0.032,0.957" StartPoint="0.032,0.066">
        <GradientStop Color="#ECF8FBFD"/>
        <GradientStop Color="#7EA3A3A3" Offset="1"/>
        <GradientStop Color="#C0FFFFFF"/>
        <GradientStop Color="#9BFFFFFF" Offset="0.511"/>
        <GradientStop Color="#83C7C7C7" Offset="0.515"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Transparent.RowHeaderBackgroundBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="Transparent.ValueCellBackgroundBrush" Color="#4CFFFFFF"/>
    <SolidColorBrush x:Key="Transparent.SummaryColumnBackgroundBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="Transparent.SummaryRowBackgroundBrush" Color="#B3FFFFFF"/>

    <SolidColorBrush x:Key="Transparent.ColumnHeaderForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Transparent.RowHeaderForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Transparent.ValueCellForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Transparent.SummaryColumnForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Transparent.SummaryRowForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Transparent.GridLineStroke" Color="#000000"/>
    <!--<LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#E3A96B" Offset="1"/>
        <GradientStop Color="#F6A963" Offset="0.65"/>
        <GradientStop Color="#E68736" Offset="0.6"/>
        <GradientStop Color="#F8C35C" Offset="0.25"/>
        <GradientStop Color="#FDD065" Offset="0.05"/>
        <GradientStop Color="#FDD165" Offset="0"/>
    </LinearGradientBrush>-->
    <LinearGradientBrush x:Key="ButtonHoverBackgroundBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFEB9C" Offset="0.036"/>
        <GradientStop Color="#FFFFE279" Offset="0.308"/>
        <GradientStop Color="#FFFFE585" Offset="0.574"/>
        <GradientStop Color="#FFFFEEA4" Offset="0.638"/>
        <GradientStop Color="#FFFFEEA4" Offset="0.638"/>
        <GradientStop Color="#FFFFFCE0" Offset="0.955"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#4CFFFFFF" x:Key="ButtonHoverBorderBrush1"/>
    <SolidColorBrush Color="#4CFFFFFF" x:Key="ButtonBorderBrush"/>

    <Style TargetType="local:OlapGridExpandHyperlinkCell">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OlapGridExpandHyperlinkCell">
                    <Grid x:Name="RootElement">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <SolidColorBrush Color="Red"/>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="TextDecorations">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Underline
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="19px"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!--Expanders-->
                        <ToggleButton VerticalAlignment="Top"   x:Name="PART_Expander" Margin="4,2,0,5" Style="{Binding Path=ExpanderStyle,RelativeSource={RelativeSource TemplatedParent}}"
                          IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" 
                          Visibility="{Binding Path=HasChildren,RelativeSource={RelativeSource TemplatedParent}}"/>
                        <!--Textblock of expander cells-->
                        <TextBlock Margin="1,0,2,0" 
                                   x:Name="PART_InnerTextBlock" 
                                   Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CellDescriptor.CellValue}"
                                   Foreground="{Binding Path=Foreground,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontFamily="{Binding Path=FontFamily,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontWeight="{Binding Path=FontWeight,RelativeSource={RelativeSource TemplatedParent}}" />
                        <contextmenu:ContextMenuAdvService.ContextMenuAdv>
                            <contextmenu:ContextMenuAdv x:Name="PART_ContextMenuAdv" Visibility="Collapsed" 
                                                        Foreground="{Binding Path=Foreground,RelativeSource={RelativeSource TemplatedParent}}"
                                                        Background="{Binding Path=Background,RelativeSource={RelativeSource TemplatedParent}}">
                            </contextmenu:ContextMenuAdv>
                        </contextmenu:ContextMenuAdvService.ContextMenuAdv>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExpanderStyle"
           TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ColorAnimation Duration="0" To="#F3545454" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="CheckedVisual"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="fill">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="White"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Effect">
                                            <DiscreteObjectKeyFrame  KeyTime="0" >
                                                <DiscreteObjectKeyFrame.Value>
                                                    <DropShadowEffect Color="#FFD09D0F" ShadowDepth="0" BlurRadius="9" Direction="231"/>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Effect">
                                            <DiscreteObjectKeyFrame  KeyTime="0" >
                                                <DiscreteObjectKeyFrame.Value>
                                                    <DropShadowEffect Color="#FFD09D0F" ShadowDepth="0" BlurRadius="7" Direction="231"/>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ColorAnimation Duration="0" To="#FFE5E5E5" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" Storyboard.TargetName="UncheckedVisual" />
                                        <ColorAnimation Duration="0" To="#FFE5E5E5" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" Storyboard.TargetName="CheckedVisual" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled"/>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimation Duration="0" To="#CCE5E5E5" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" Storyboard.TargetName="UncheckedVisual"/>
                                        <ColorAnimation Duration="0" To="#F3545454" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="CheckedVisual"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
					BorderBrush="Transparent" 
					CornerRadius="1" 
					Width="11" 
					BorderThickness="0" 
                                           
					Background="Transparent"   HorizontalAlignment="Right"  >
                            <Grid>
                                <Path x:Name="UncheckedVisual" Data="M357,301 L357.5,352.5 422.5,325.5 z" Width="6" Margin="2.874,2.032,1.126,0" Stretch="Fill"  Height="8.032" VerticalAlignment="Top" Fill="Black" StrokeThickness="0.5" Stroke="#FFA8A8A8"/>
                                <Path x:Name="CheckedVisual" Data="M357,301 L357.5,352.5 422.5,325.5 z" Margin="5.074,2.032,0.126,0" Stretch="Fill"  Height="8.032" Width="5" VerticalAlignment="Top" Stroke="#FF252525" StrokeThickness="0.5" Fill="White" >
                                    <Path.RenderTransform>
                                        <CompositeTransform Rotation="45"/>
                                    </Path.RenderTransform>


                                </Path>

                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1"
					Margin="4,0,0,0"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
                                            />
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style 
        TargetType="local:OlapGrid">
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <local:OlapGridCellStyle Background="{StaticResource Transparent.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Transparent.ColumnHeaderForegroundBrush}" 
                             FontFamily="Segoe UI"/>
            </Setter.Value>
        </Setter>
        <Setter Property="RowHeaderStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource Transparent.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Transparent.RowHeaderForegroundBrush}"
                             FontFamily="Segoe UI"/>
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryColumnStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource Transparent.SummaryColumnBackgroundBrush}"
                             Foreground="{StaticResource Transparent.SummaryColumnForegroundBrush}"
                             FontFamily="Segoe UI"/>
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryRowStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource Transparent.SummaryRowBackgroundBrush}"
                             Foreground="{StaticResource Transparent.SummaryRowForegroundBrush}"
                             FontFamily="Segoe UI"/>
            </Setter.Value>
        </Setter>
        <Setter Property="ValueCellStyle">
            <Setter.Value>
                <local:OlapGridCellStyle Background="{StaticResource Transparent.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Transparent.ValueCellForegroundBrush}"
                             FontFamily="Segoe UI"/>
            </Setter.Value>
        </Setter>
        <Setter Property="GridLineStroke"  Value="{StaticResource Transparent.GridLineStroke}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource ExpanderStyle}"/>
        <Setter Property="Background" Value="{StaticResource TransparentGridBackground}"/>
    </Style>
</ResourceDictionary>
