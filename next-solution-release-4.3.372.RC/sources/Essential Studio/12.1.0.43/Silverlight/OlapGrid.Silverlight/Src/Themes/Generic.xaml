                                        <EasingPointKeyFrame KeyTime="0:0:0.8" Value="-0.004,0.742"/>
                                        <EasingPointKeyFrame KeyTime="0:0:0.9" Value="-0.011,0.429"/>
                                        <EasingPointKeyFrame KeyTime="0:0:1" Value="0.028,0.077"/>
