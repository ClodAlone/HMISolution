<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
    xmlns:gridcommon="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.GridCommon.Silverlight"
    xmlns:contextmenu="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"
    xmlns:resource="clr-namespace:Syncfusion.Silverlight.Grid.Olap.Resources"
    xmlns:local="clr-namespace:Syncfusion.Silverlight.Grid.Olap">

    <!--Value cells, Tooltip converter -->
    <local:ValueCellToolTipConvertor x:Key="valueConverter"/>
    

    <SolidColorBrush x:Key="Classic.GridBackground" Color="#FFFFFF"/>


    
    <LinearGradientBrush x:Key="Classic.ColumnHeaderBackgroundBrush" EndPoint="0.994,0.922" StartPoint="0.994,0.101">
        <GradientStop Color="#FFF5FAFF" Offset="0.099"/>
        <GradientStop Color="#FFE6F0FA" Offset="0.515"/>
        <GradientStop Color="#FFDCE6F4" Offset="0.52"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FFECF2F9" x:Key="Classic.RowHeaderBackgroundBrush"/>

    <LinearGradientBrush x:Key="Classic.SummaryColumnBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFEAEAEA" Offset="0"/>
        <GradientStop Color="#FFCCD9EA" Offset="0.007"/>
        <GradientStop Color="#FFE8EEF7" Offset="0.046"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Classic.SummaryRowBackgroundBrush"  EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFEAEAEA" Offset="0"/>
        <GradientStop Color="#FFCCD9EA" Offset="0.007"/>
        <GradientStop Color="#FFE8EEF7" Offset="0.046"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Classic.ValueCellBackgroundBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Classic.ColumnHeaderForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Classic.RowHeaderForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Classic.ValueCellForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Classic.SummaryColumnForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Classic.SummaryRowForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Classic.GridLineStroke" Color="#FFA4A9B4"/>

    <!--OlapGrid Kpi cells renderer-->
    <Style TargetType="local:OlapGridKpiCell">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OlapGridKpiCell">
                    <Grid x:Name="RootElement">
                        <Image Width="16" Height="16" 
                               Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ImageSource}" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--OlapGrid Expander cells-->
    <Style TargetType="local:OlapGridExpandHyperlinkCell">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OlapGridExpandHyperlinkCell">
                    <Grid x:Name="RootElement">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <SolidColorBrush Color="Red"/>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_InnerTextBlock" Storyboard.TargetProperty="TextDecorations">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Underline
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="19px"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!--Expanders-->
                        <ToggleButton VerticalAlignment="Top"   x:Name="PART_Expander" Margin="4,2,0,5" Style="{Binding Path=ExpanderStyle,RelativeSource={RelativeSource TemplatedParent}}"
                          IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" 
                          Visibility="{Binding Path=HasChildren,RelativeSource={RelativeSource TemplatedParent}}"/>
                        <!--Textblock of expander cells-->
                        <TextBlock Margin="1,0,2,0" 
                                   x:Name="PART_InnerTextBlock" 
                                   Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CellDescriptor.CellValue}"
                                   Foreground="{Binding Path=Foreground,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontFamily="{Binding Path=FontFamily,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource TemplatedParent}}"
                                   FontWeight="{Binding Path=FontWeight,RelativeSource={RelativeSource TemplatedParent}}" />
                        <contextmenu:ContextMenuAdvService.ContextMenuAdv>
                            <contextmenu:ContextMenuAdv x:Name="PART_ContextMenuAdv" Visibility="Collapsed" 
                                                        Foreground="{Binding Path=Foreground,RelativeSource={RelativeSource TemplatedParent}}"
                                                        Background="{Binding Path=Background,RelativeSource={RelativeSource TemplatedParent}}">
                            </contextmenu:ContextMenuAdv>
                        </contextmenu:ContextMenuAdvService.ContextMenuAdv>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Expander Style -->
    <Style x:Key="ExpanderStyle"
           TargetType="ToggleButton">


        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="#FF27C7F7"/>
                                        </ObjectAnimationUsingKeyFrames >
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="#FF27C7F7"/>
                                        </ObjectAnimationUsingKeyFrames >
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="fill">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="White"/>
                                        </ObjectAnimationUsingKeyFrames >
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame  KeyTime="0" Value="White"/>
                                        </ObjectAnimationUsingKeyFrames >
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Effect">
                                            <DiscreteObjectKeyFrame  KeyTime="0" >
                                                <DiscreteObjectKeyFrame.Value>
                                                    <DropShadowEffect Color="#FF27C7F7" ShadowDepth="0" BlurRadius="9" Direction="231"></DropShadowEffect>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames >
                                        <ObjectAnimationUsingKeyFrames  Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Effect">
                                            <DiscreteObjectKeyFrame  KeyTime="0" >
                                                <DiscreteObjectKeyFrame.Value>
                                                    <DropShadowEffect Color="#FF27C7F7" ShadowDepth="0" BlurRadius="7" Direction="231"></DropShadowEffect>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames >
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CheckStates">
                                <vsm:VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                           BorderBrush="Transparent" 
                                            CornerRadius="1" 
                                            Width="11" 
                                            BorderThickness="0" 
                                           
                                            Background="Transparent"   HorizontalAlignment="Right"  >
                            <Grid>
                                <Path x:Name="UncheckedVisual" Data="M357,301 L357.5,352.5 422.5,325.5 z" Width="6" Margin="2.874,2.032,1.126,0" Stretch="Fill"  Height="8.032" VerticalAlignment="Top" Fill="White" StrokeThickness="1" Stroke="#FFA8A8A8">

                                </Path>
                                <Path x:Name="CheckedVisual" Data="M357,301 L357.5,352.5 422.5,325.5 z" Margin="5.074,2.032,0.126,0" Stretch="Fill"  Height="8.032" Width="5" VerticalAlignment="Top" Fill="#FF595959" Stroke="#FF252525" StrokeThickness="1" >
                                    <Path.RenderTransform>
                                        <CompositeTransform Rotation="45"/>
                                    </Path.RenderTransform>


                                </Path>

                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                            />
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Hyperlink Cell-->
    <Style TargetType="local:OlapGridHyperlinkCell">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OlapGridHyperlinkCell">
                    <Grid>
                        <Grid.RowDefinitions >
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_CellValueTextBlock" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <SolidColorBrush Color="Red"/>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_CellValueTextBlock" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_CellValueTextBlock" Storyboard.TargetProperty="TextDecorations">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Underline
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBlock x:Name="PART_CellValueTextBlock" HorizontalAlignment="{Binding Path=HAlignment,RelativeSource={RelativeSource TemplatedParent}}" 
                                           VerticalAlignment="Center" Margin="0,0,5,0"  Grid.Row="0"  
                                           Text="{Binding Path=CellValue}"                                           
                                           Foreground="{Binding Path=Foreground,RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{Binding Path=FontFamily,RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="{Binding Path=FontWeight,RelativeSource={RelativeSource TemplatedParent}}">
                        </TextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- OlapGrid -->
    <Style TargetType="local:OlapGrid">
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <local:OlapGridCellStyle Background="{StaticResource Classic.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Classic.ColumnHeaderForegroundBrush}"
                             FontFamily="Calibri"/>
            </Setter.Value>
        </Setter>
        <Setter Property="RowHeaderStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource Classic.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Classic.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"/>
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryColumnStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource Classic.SummaryRowBackgroundBrush}"
                             Foreground="{StaticResource Classic.SummaryColumnForegroundBrush}"
                             FontFamily="Calibri" />
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryRowStyle">
            <Setter.Value>
                <local:OlapGridCellStyle  Background="{StaticResource Classic.SummaryRowBackgroundBrush}"
                             Foreground="{StaticResource Classic.SummaryRowForegroundBrush}"
                             FontFamily="Calibri"  />
            </Setter.Value>
        </Setter>
        <Setter Property="ValueCellStyle">
            <Setter.Value>
                <local:OlapGridCellStyle Background="{StaticResource Classic.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Classic.ValueCellForegroundBrush}"
                             FontFamily="Calibri"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OlapGrid">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.Resources>
                            <DataTemplate x:Key="toolTipValueTemplate" >
                                <Border Background="White" BorderBrush="Black" BorderThickness="1" CornerRadius="4" >
                                    <Grid>
                                        <Grid.Resources>
                                            <resource:ResourceWrapper x:Key="resourceWrapper"/>
                                        </Grid.Resources>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <!--Tooltip header cells-->
                                        <TextBlock Grid.Column="0" Grid.Row="0" Margin="3,2,2,1" Text="{Binding TooltipMeasure,Source={StaticResource resourceWrapper}}"/>
                                        <TextBlock Grid.Column="0" Grid.Row="1" Margin="3,1,2,1" Text="{Binding TooltipColumn,Source={StaticResource resourceWrapper}}"/>
                                        <TextBlock Grid.Column="0" Grid.Row="2" Margin="3,1,2,1" Text="{Binding TooltipRow,Source={StaticResource resourceWrapper}}"/>
                                        <TextBlock Grid.Column="0" Grid.Row="3" Margin="3,1,2,1" Text="{Binding TooltipValue,Source={StaticResource resourceWrapper}}"/>
                                        <!--Tooltip Semi colon-->
                                        <TextBlock Grid.Column="1" Grid.Row="0" Text=":"/>
                                        <TextBlock Grid.Column="1" Grid.Row="1" Text=":"/>
                                        <TextBlock Grid.Column="1" Grid.Row="2" Text=":"/>
                                        <TextBlock Grid.Column="1" Grid.Row="3" Text=":"/>
                                        <!--Tooltip Value Bindings-->
                                        <TextBlock Grid.Column="2" Grid.Row="0" Margin="3,2,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Measure'}"/>
                                        <TextBlock Grid.Column="2" Grid.Row="1" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Columns'}"/>
                                        <TextBlock Grid.Column="2" Grid.Row="2" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Rows'}"/>
                                        <TextBlock Grid.Column="2" Grid.Row="3" Margin="3,1,2,1" Text="{Binding Converter={StaticResource valueConverter}, ConverterParameter='Value'}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </Grid.Resources>
                        <!--Displaying the procesing popup-->
                        <Popup x:Name="PART_OlapGridProgressbarPopup" HorizontalAlignment="Center" VerticalAlignment="Center">
