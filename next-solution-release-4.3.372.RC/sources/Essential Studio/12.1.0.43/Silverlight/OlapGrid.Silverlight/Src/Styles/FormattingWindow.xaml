<controls:ChildWindow x:Class="Syncfusion.Silverlight.Grid.Olap.FormattingWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
           xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls"
           xmlns:tools="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"   
           xmlns:shared="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
           xmlns:resource="clr-namespace:Syncfusion.Silverlight.Grid.Olap.Resources"
           xmlns:syncfusion="clr-namespace:Syncfusion.Silverlight.Grid.Olap;assembly=Syncfusion.OlapGrid.Silverlight"
           Width="370" Height="390"  Background="AliceBlue" BorderThickness="2" FontSize="13" FontFamily="Trebuchet MS,Calibri,MS Sans Serif" Padding="15"  BorderBrush="Black" 
             >
    <controls:ChildWindow.Resources>
        <resource:ResourceWrapper x:Key="resourceWrapper"/>
    </controls:ChildWindow.Resources>
    <Grid x:Name="LayoutRoot" Margin="2"   >
        <Grid.ColumnDefinitions >
            <ColumnDefinition  />

        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="320" />
            <RowDefinition />

        </Grid.RowDefinitions>
        <controls:TabControl Name="Design" FontSize="12" TabStripPlacement="Top" Background="AliceBlue" >
            <controls:TabItem Header="{Binding Source={StaticResource resourceWrapper},Path=HeaderStyle}" Background="AliceBlue" FontSize="12"  >
                <Grid >
                    <Grid.ColumnDefinitions >
                        <ColumnDefinition  />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition  />
                        <RowDefinition  />
                        <RowDefinition  />

                    </Grid.RowDefinitions>
                    <syncfusion:GroupBox Grid.Row="0" FontSize="12"  Grid.Column="0" Header="{Binding Source={StaticResource resourceWrapper},Path=ColumnHeader}" Height="80"  >
                        <Grid >
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="150"  />
                                <ColumnDefinition Width="150"  />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition  Height="25" />
                                <RowDefinition Height="25" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" FontSize="12"  Grid.Row="0" HorizontalAlignment="Left"  VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=Background}"></TextBlock>
                            <shared:ColorPickerPalette FontSize="12"  Grid.Column="1" Width="55" Grid.Row="0" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Name="HeaderColumnBackColor" />
                            <TextBlock Grid.Column="0" FontSize="12"  Grid.Row="1"  HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=Foreground}"></TextBlock>
                            <shared:ColorPickerPalette FontSize="12"   Grid.Column="1" Grid.Row="1" Width="55"  Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Name="HeaderColumnForeColor" />

                        </Grid>
                    </syncfusion:GroupBox>
                    <syncfusion:GroupBox Header="{Binding Source={StaticResource resourceWrapper},Path=RowHeader}" FontSize="12" Grid.Column="0"  Grid.Row="1" Height="80" >
                        <Grid >
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition  Width="150" />
                                <ColumnDefinition  Width="150"  />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="25" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" FontSize="12"  Grid.Row="0" HorizontalAlignment="Left"  VerticalAlignment="Center"  Text="{Binding Source={StaticResource resourceWrapper},Path=Background}" ></TextBlock>
                            <shared:ColorPickerPalette FontSize="12"  Width="55" Grid.Column="1" Grid.Row="0" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Name="HeaderRowBackColor" />

                            <TextBlock Grid.Column="0" Grid.Row="1" FontSize="12"   HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=Foreground}"></TextBlock>
                            <shared:ColorPickerPalette Width="55" FontSize="12"   Grid.Column="1" Grid.Row="1"  Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Name="HeaderRowForeColor" />
                        </Grid>
                    </syncfusion:GroupBox>
                    <syncfusion:GroupBox Header="{Binding Source={StaticResource resourceWrapper},Path=HeaderFont}" FontSize="12"  Grid.Column="0" Grid.Row="2" Height="85">
                        <Grid >
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition  Width="150" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="26" />

                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" FontSize="12"  Grid.Row="1"  HorizontalAlignment="Left" Width="120"  VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=FontName}"></TextBlock>
                            <ComboBox  Grid.Column="1" FontSize="12"  Grid.Row="1"  Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Name="HeaderFontName" />
                            <TextBlock Grid.Column="0" FontSize="12"  HorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=FontSize}"></TextBlock>
                            <tools:NumericUpDown  MaxValue="30" FontSize="12"  MinValue="12" Interval="1"  Grid.Column="1" Grid.Row="0"  Height="26" Width="56"  HorizontalAlignment="Left" VerticalAlignment="Center" Name="HeaderFontSize" />

                        </Grid>
                    </syncfusion:GroupBox>
                </Grid>
            </controls:TabItem>
            <controls:TabItem  Header="{Binding Source={StaticResource resourceWrapper},Path=SummaryStyle}" Background="AliceBlue">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition  />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <syncfusion:GroupBox Header="{Binding Source={StaticResource resourceWrapper},Path=ColumnSummary}" Grid.Row="0"   Grid.Column="0" Height="80" >
                        <Grid >
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition  Height="25"  />
                                <RowDefinition  Height="25"  />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=Background}" ></TextBlock>
                            <shared:ColorPickerPalette Width="55" Grid.Column="1" Grid.Row="0"  Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Name="SummaryColumnBackColor" />
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=Foreground}" ></TextBlock>
                            <shared:ColorPickerPalette Width="55" Grid.Column="1" Grid.Row="1"  Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Name="SummaryColumnForeColor" />

                        </Grid>
                    </syncfusion:GroupBox>
                    <syncfusion:GroupBox Header="{Binding Source={StaticResource resourceWrapper},Path=RowSummary}" Grid.Row="1" Height="80"  Grid.Column="0" >
                        <Grid >
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150"  />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"  />
                                <RowDefinition Height="25"  />

                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=Background}"></TextBlock>
                            <shared:ColorPickerPalette Width="55" Grid.Column="1" Grid.Row="0"  Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Name="SummaryRowBackColor" />
                            <TextBlock Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=Foreground}"></TextBlock>
                            <shared:ColorPickerPalette Width="55" Grid.Column="1" Grid.Row="1"  Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Name="SummaryRowForeColor" />
                        </Grid>
                    </syncfusion:GroupBox>
                    <syncfusion:GroupBox Header="{Binding Source={StaticResource resourceWrapper},Path=SummaryFont}" Grid.Column="0" Grid.Row="2" Height="85"  >
                        <Grid >
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150"  />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=FontSize}"></TextBlock>
                            <tools:NumericUpDown  MaxValue="30" MinValue="12" Interval="1"  Grid.Column="1" Grid.Row="0"   Height="26" Width="56"  HorizontalAlignment="Left" VerticalAlignment="Center" Name="SummaryFontSize" />
                            <TextBlock Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="120" Text="{Binding Source={StaticResource resourceWrapper},Path=FontName}"></TextBlock>
                            <ComboBox Grid.Column="1" Grid.Row="1"  Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" Name="SummaryFontName">
                            </ComboBox >
                        </Grid>
                    </syncfusion:GroupBox>
                </Grid>
            </controls:TabItem>
            <controls:TabItem Header="{Binding Source={StaticResource resourceWrapper},Path=CellStyles}" Background="AliceBlue">
                <Grid>
                    <Grid.ColumnDefinitions >
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <!--<RowDefinition />-->
                    </Grid.RowDefinitions>
                    <syncfusion:GroupBox Header="{Binding Source={StaticResource resourceWrapper},Path=CellFontStyles}" Margin="0,7.5,0,0"  Grid.Column="0" Grid.Row="0"  >
                        <Grid>
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26.5"  />
                                <RowDefinition Height="26.5"  />
                                <RowDefinition Height="26.5"  />
                                <RowDefinition Height="26.5"  />
                                <RowDefinition Height="26.5"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0" Width="120"  HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=FontName}"></TextBlock>
                            <ComboBox  Grid.Column="1" Grid.Row="0"  Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" Name="CellFontName">
                            </ComboBox >
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=FontStyle}"></TextBlock>
                            <ComboBox  Grid.Column="1" Grid.Row="1"  Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" Name="CellFontStyle">
                            </ComboBox >
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=FontColor}"></TextBlock>
                            <shared:ColorPickerPalette Width="55" Grid.Column="1" Grid.Row="2"  Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" Name="CellFontColor" />
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Grid.Row="3" VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=FontSize}"></TextBlock>
                            <tools:NumericUpDown Width="56" MaxValue="30" MinValue="12" Interval="1"  Grid.Column="1" Grid.Row="3"    Height="26"  HorizontalAlignment="Left" VerticalAlignment="Center" Name="CellFontSize">
                            </tools:NumericUpDown >
                        </Grid>
                    </syncfusion:GroupBox>

                </Grid>
            </controls:TabItem>
            <controls:TabItem Header="{Binding Source={StaticResource resourceWrapper},Path=Common}" Background="AliceBlue">
                <Grid >
                    <Grid.ColumnDefinitions >
                        <ColumnDefinition  />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="130" />
                        <RowDefinition Height=" 40"/>
                    </Grid.RowDefinitions>
                    <syncfusion:GroupBox Header="{Binding Source={StaticResource resourceWrapper},Path=CommonStyles}"  Margin="0,-54,0,0"   Grid.Column="0" Grid.Row="0" Height="60">
                        <Grid>
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"  />
                                <!--<RowDefinition Height="25"  />
                                <RowDefinition Height="30"  />-->
                                <RowDefinition  />
                            </Grid.RowDefinitions>
                            <!--<TextBlock Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" >Grid BackGround</TextBlock>
                            <shared:ColorPickerPalette Width="55" Grid.Column="1" Grid.Row="0"  Height="20" VerticalAlignment="Center"  HorizontalAlignment="Left" Name="GridBackGround">
                            </tools:ColorPickerPalette  >-->
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Center" Text="{Binding Source={StaticResource resourceWrapper},Path=GridlineColor}"></TextBlock>
                            <shared:ColorPickerPalette Width="55" Grid.Column="1" Grid.Row="0"  Height="20" VerticalAlignment="Center"  HorizontalAlignment="Left" Name="GridlineColor" />
                            <!--<TextBlock Grid.Column="0" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Center" >Gridline Thickness</TextBlock>
                            <tools:NumericUpDown  Grid.Column="1" Grid.Row="2"  MaxValue="25" MinValue="2" Interval="1"    Height="26" Width="55"  VerticalAlignment="Center" HorizontalAlignment="Left" Name="GridlineThickness" />-->

                        </Grid>
                    </syncfusion:GroupBox>
                </Grid>
            </controls:TabItem>
        </controls:TabControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1">
            <Button x:Name="OKButton"  Content="{Binding Source={StaticResource resourceWrapper},Path=Button_OK}" Click="OKButton_Click" MinWidth="55" Height="23"  />
            <Button x:Name="CancelButton" Margin="5 0 0 0" Content="{Binding Source={StaticResource resourceWrapper},Path=Button_Cancel}" Click="CancelButton_Click" MinWidth="55" Height="23"   />
        </StackPanel>
    </Grid>
</controls:ChildWindow>