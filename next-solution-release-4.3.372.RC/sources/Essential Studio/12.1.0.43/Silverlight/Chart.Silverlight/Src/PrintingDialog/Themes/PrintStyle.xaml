    <Style TargetType="syncfusion:ChartPrintDialog">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="syncfusion:ChartPrintDialog">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="0.3*"/>
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="#FFCDD2D7" BorderThickness="1.5" Margin="5" Grid.Column="0">
                                <Grid Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid Grid.Column="0">
                                        <Rectangle x:Name="BorderRect" VerticalAlignment="Center" Height="450" Width="350" HorizontalAlignment="Center" Fill="Gray" >
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform X="4" Y="4"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Border x:Name="previewborder" VerticalAlignment="Center" Height="450" Width="350" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="Black" Background="White">
                                            <Grid>
                                                <!--<Rectangle x:Name="PreviewRect" Stroke="Black" StrokeThickness="1" />-->
                                                <Image x:Name="ViewPortImage"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border BorderBrush="#FFCDD2D7" BorderThickness="1.5" Margin="5" Grid.Column="1" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Grid HorizontalAlignment="Left" Height="200" Margin="5,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.5*"/>
                                            <ColumnDefinition Width="0.5*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Print Mode" Grid.Row="0" Grid.Column="0" Margin="5" HorizontalAlignment="Stretch"/>
                                        <ComboBox x:Name="PrintModeCmb" Width="100" Style="{StaticResource SilverComboBoxStyle}" Grid.Row="0"  Grid.Column="1" Margin="5" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Style="{StaticResource Office14SilverComboBoxItemStyleHeader}" >Portrait</ComboBoxItem>
                                            <ComboBoxItem Style="{StaticResource Office14SilverComboBoxItemStyleHeader}" >LandScape</ComboBoxItem>
                                        </ComboBox>
                                        <TextBlock Text="Shrink To Fit" Grid.Row="1" Grid.Column="0" Margin="5" HorizontalAlignment="Stretch"/>
                                        <CheckBox x:Name="ShrinkToFitChk" Style="{StaticResource SilverCheckBoxStyle}"  IsChecked="True" Grid.Row="1" Margin="5"  Grid.Column="1" HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="Print Chart Alone" Margin="5" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch"/>
                                        <CheckBox x:Name="HideZoomingToolKitChk" IsChecked="False" IsEnabled="False" Style="{StaticResource SilverCheckBoxStyle}"  Margin="5" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.5*"/>
                                            <ColumnDefinition Width="0.5*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="Printbutton" Margin="5" Style="{StaticResource OfficeSilverPrintButtonStyle}" Grid.Row="0" Grid.Column="0"  Width="75" HorizontalAlignment="Stretch">

                                        </Button>
                                        <Button Content="Close" Style="{StaticResource OfficeSilverCloseButtonStyle}" x:Name="Cancelbutton" Margin="5" Grid.Row="0" Grid.Column="1" Width="75" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
