    <LinearGradientBrush x:Key="PrintDialogButtonPressedBrush" MappingMode="RelativeToBoundingBox" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FFF6C867" Offset="0"/>
        <GradientStop Color="#FFFFE48A" Offset="0.073"/>
        <GradientStop Color="#FFFFE48A" Offset="0.62"/>
        <GradientStop Color="#FFFFE471" Offset="0.636"/>
