        <GradientStop Color="#FFFDEEB3" Offset="0.012"/>
        <GradientStop Color="#FFFDE388" Offset="0.112"/>
        <GradientStop Color="#FFFCE286" Offset="0.623"/>
        <GradientStop Color="#FFFCE26E" Offset="0.626"/>
        <GradientStop Color="#FFFCE26E" Offset="0.641"/>
        <GradientStop Color="#FFFCE286" Offset="0.644"/>
        <GradientStop Color="#FFFBE186" Offset="0.867"/>
