<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.Silverlight"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Chart">
    
    <Style TargetType="syncfusion:DataAxis">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="syncfusion:DataAxis">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ViewStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.0">

                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Non_Cartesian_Axis_State">
                                    <Storyboard >
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Horizontal_NotOpposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="smallTickLine" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>-->
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Horizontal_Opposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Vertical_NotOpposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Vertical_Opposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Horizontal_NotOpposed_State">
                                    <Storyboard >
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Horizontal_NotOpposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Horizontal_Opposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Vertical_NotOpposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Vertical_Opposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Horizontal_Opposed_State">
                                    <Storyboard >
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Horizontal_NotOpposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Horizontal_Opposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Vertical_NotOpposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Vertical_Opposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Vertical_NotOpposed_State">
                                    <Storyboard >
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Horizontal_NotOpposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Horizontal_Opposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Vertical_NotOpposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Vertical_Opposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Vertical_Opposed_State">
                                    <Storyboard >
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Horizontal_NotOpposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Horizontal_Opposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Vertical_NotOpposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Vertical_Opposed" Storyboard.TargetProperty="Visibility">
                                            <ObjectAnimationUsingKeyFrames.KeyFrames>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames.KeyFrames>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid Background="Transparent" x:Name="Horizontal_NotOpposed" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!--<Line x:Name="smallTickLine" Stroke="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.SmallTicksStroke}"
                                  StrokeThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.SmallTicksStrokeThickness}"
                                  Stretch="Fill" X1="0" Y1="0" X2="0" Y2="5" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Width="Auto" Height="Auto" Visibility="Visible"/>-->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" RenderTransformOrigin="0.5,0.5" 
                                     
                                    RenderTransform="{TemplateBinding LabelRotateTransform}"
                                    CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelCornerRadius}"
                                    BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelBorderBrush}"
                                    BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelBorderThickness}"
                                    Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelBackground}" >
                                <ContentControl Content="{TemplateBinding Label}" RenderTransformOrigin="0.5,0.5"
                                                Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelForeground}"
                                                FontFamily="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontFamily}"
                                                FontSize="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontSize}"
                                                FontWeight="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontWeight}"
                                                FontStyle="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontStyle}"
                                                ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelTemplate}"
                                                >
                                </ContentControl>

                            </Border>
                        </Grid>

                        <Grid Background="Transparent" x:Name="Horizontal_Opposed" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!--<Line Stroke="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.SmallTicksStroke}"
                                  StrokeThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.SmallTicksStrokeThickness}"
                                  Stretch="Fill" X1="0" Y1="0" X2="0" Y2="5" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Width="Auto" Height="Auto"/>-->
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" RenderTransformOrigin="0.5,0.5" 
                                    
                                    RenderTransform="{TemplateBinding LabelRotateTransform}"
                                    CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelCornerRadius}"
                                    BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelBorderBrush}"
                                    BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelBorderThickness}"
                                    Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelBackground}">
                                <ContentControl Content="{TemplateBinding Label}" RenderTransformOrigin="0.5,0.5"
                                                Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelForeground}"
                                                FontFamily="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontFamily}"
                                                FontSize="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontSize}"
                                                FontWeight="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontWeight}"
                                                FontStyle="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontStyle}"
                                                ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelTemplate}"
                                                />
                            </Border>
                        </Grid>

                        <Grid Background="Transparent" x:Name="Vertical_NotOpposed" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" RenderTransformOrigin="0.5,0.5" 
                                    RenderTransform="{TemplateBinding LabelRotateTransform}"
                                    CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelCornerRadius}"
                                    BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelBorderBrush}"
                                    BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelBorderThickness}"
                                    Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelBackground}">
                                <ContentControl Content="{TemplateBinding Label}"  RenderTransformOrigin="0.5,0.5"
                                                Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelForeground}"
                                                FontFamily="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontFamily}"
                                                FontSize="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontSize}"
                                                FontWeight="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontWeight}"
                                                FontStyle="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontStyle}"
                                                ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelTemplate}"/>
                            </Border>
                            <!--<Line Stroke="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.SmallTicksStroke}"
                                  StrokeThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.SmallTicksStrokeThickness}" 
                                  Stretch="Fill" X1="0" Y1="0" X2="5" Y2="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="Auto" Height="Auto"/>-->
                        </Grid>

                        <Grid Background="Transparent" x:Name="Vertical_Opposed" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" RenderTransformOrigin="0.5,0.5" 
                                    RenderTransform="{TemplateBinding LabelRotateTransform}"
                                    CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelCornerRadius}"
                                    BorderBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelBorderBrush}"
                                    BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelBorderThickness}"
                                    Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelBackground}">
                                <ContentControl Content="{TemplateBinding Label}"  RenderTransformOrigin="0.5,0.5"
                                                Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelForeground}"
                                                FontFamily="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontFamily}"
                                                FontSize="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontSize}"
                                                FontWeight="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontWeight}"
                                                FontStyle="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelFontStyle}"
                                                ContentTemplate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.LabelTemplate}"/>
                            </Border>
                            <!--<Line Stroke="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.SmallTicksStroke}"
                                  StrokeThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedAxis.SmallTicksStrokeThickness}"
                                  Stretch="Fill" X1="0" Y1="0" X2="5" Y2="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>-->
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
