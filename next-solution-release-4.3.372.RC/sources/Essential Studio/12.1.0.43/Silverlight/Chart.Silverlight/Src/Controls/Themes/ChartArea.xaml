<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.Silverlight"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"
    xmlns:common="clr-namespace:System.Windows;assembly=System.Windows.Controls"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Chart">


    <LinearGradientBrush EndPoint="0.503,0.941" StartPoint="0.5,-0.061" x:Key="DefaultChartEffectsColor">
        <GradientStop Color="#E5FFFFFF" Offset="0.057"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Default.AreaBorderBackground"
                   Color="#FFA0BEE4"/>

    <SolidColorBrush Color="#FF15428B" x:Key="ChartAreaForeground"/>

    <syncfusion:BoolToVisibilityConverter x:Key="boolvisibilityconverter"/>

    <syncfusion:LegendVisibilityConverter x:Key="legendvisible"/>
    <syncfusion:WatermarkContentConverter x:Key="watermarkContentConverter"/>
    <syncfusion:WatermarkAlignmentConverter x:Key="watermarkAlignmentConverter"/>

    <!--Chart Area template-->
    <Style TargetType="syncfusion:ChartArea">
        <Setter Property="EffectsBrush" Value="{StaticResource DefaultChartEffectsColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Default.AreaBorderBackground}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin"  Value="1" />
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="GridBackground" Value="#00000000"/>
        <Setter Property="EnableChartAreaEffects" Value="False"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RangeSelectionTemplate">
            <Setter.Value >
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="0.5">
                        <Grid>
                            <Rectangle Fill="LightGray" Opacity="0.3"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="RangeSelectionOnMouseOverTemplate">
            <Setter.Value >
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="0.5">
                        <Grid>
                            <Rectangle Fill="LightGray" Opacity="0.15" Margin="{TemplateBinding RangeSelectionMouseMoveMargin}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
                
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="syncfusion:ChartArea">                   
                    <Grid x:Name="MainGrid"  >                    
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="MainBorder" Grid.Row="0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Background="{TemplateBinding Background}"  CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                            <Grid Background="Transparent" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25*"/>
                                    <RowDefinition Height="75*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding EffectsBrush}" Width="{Binding Width}" Height="{Binding Height}" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=EnableChartAreaEffects, Converter={StaticResource boolvisibilityconverter}}"/>
                                <syncfusion:ChartDockPanel x:Name="ChartArea_dock" LastChildFill="True" Background="Transparent" Grid.Row="0" Grid.RowSpan="2" >                                   
                                    <ContentPresenter x:Name="ChartHeader" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" syncfusion:ChartDockPanel.Dock="Top" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <ContentPresenter x:Name="ChartLegends" HorizontalAlignment="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Legends.HorizontalAlignment}" VerticalAlignment="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Legends.VerticalAlignment}" 
                                                  Content="{TemplateBinding Legends}"
                                                  syncfusion:ChartDockPanel.Dock="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Legends.DockPosition}" 
                                                  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Legends, Converter={StaticResource legendvisible}}"/>

                                    <Grid x:Name="LayoutRoot" Background="Transparent" Margin="5,15,15,5" >
                                        <syncfusion:ChartAreaWatermarkControl x:Name="watermarkControl" Axes="{TemplateBinding Axes}" Margin="{TemplateBinding AxesThickness}">
                                            <syncfusion:ChartAreaWatermarkControl.Background>
                                                <ImageBrush ImageSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource watermarkContentConverter}, ConverterParameter=Image}" 
                                                            AlignmentX="{TemplateBinding WatermarkAlignmentX}" AlignmentY="{TemplateBinding WatermarkAlignmentY}"
                                                            Opacity="{TemplateBinding WatermarkOpacity}" Stretch="{TemplateBinding WatermarkImageStretch}">
                                                    <ImageBrush.RelativeTransform>
                                                        <RotateTransform Angle="{TemplateBinding WatermarkRotationAngle}" CenterX="0.5" CenterY="0.5"></RotateTransform>
                                                    </ImageBrush.RelativeTransform>
                                                </ImageBrush>
                                            </syncfusion:ChartAreaWatermarkControl.Background>
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource watermarkContentConverter}, ConverterParameter=Text}" 
                                                       Opacity="{TemplateBinding WatermarkOpacity}" FontSize="{TemplateBinding WatermarkTextFontSize}" RenderTransformOrigin="0.5,0.5"
                                                       FontFamily="{TemplateBinding WatermarkTextFontFamily}" FontWeight="{TemplateBinding WatermarkTextFontWeight}"
                                                       HorizontalAlignment="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource watermarkAlignmentConverter}, ConverterParameter=AlignmentX}" 
                                                       VerticalAlignment="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource watermarkAlignmentConverter}, ConverterParameter=AlignmentY}">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="{TemplateBinding WatermarkRotationAngle}"></RotateTransform>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </syncfusion:ChartAreaWatermarkControl>
                                            
                                        <syncfusion:StripLinePanel x:Name="stripLinePanel" Background="{TemplateBinding GridBackground}" Axes="{TemplateBinding Axes}" Margin="{TemplateBinding AxesThickness}" Area="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=.}"  />
                                        
                                        <syncfusion:SmallTickLinesPanel x:Name="smalltickgridLinesPanel" Background="Transparent" Axes="{TemplateBinding Axes}" Margin="{TemplateBinding AxesThickness}" Visibility="Visible" />
                                        <syncfusion:ChartAxesGridLinesPanel x:Name="gridLinesPanel" Background="Transparent" Axes="{TemplateBinding Axes}" Margin="{TemplateBinding AxesThickness}"/>
                                        

                                      


                                        <Grid x:Name="InternalCanvas" Background="Transparent" Margin="{TemplateBinding AxesThickness}" IsHitTestVisible="True">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ItemsControl ItemsSource="{TemplateBinding Series}" x:Name="ItemsControlSeries">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Grid />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <ItemsControl x:Name="interactiveCursor"  ItemsSource="{TemplateBinding InteractiveCursors}" IsHitTestVisible="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Grid Background="Transparent"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <Canvas Name="secondaryaxis" Height="auto" Width="auto"  />
                                           
                                            <syncfusion:ZoomingToolKit x:Name="ZoomTool" Visibility="Visible" HorizontalAlignment="Left" VerticalAlignment="Top" />

                                            <syncfusion:ZoomingScrollBar x:Name="HorizontalBar" Orientation="Horizontal" Grid.Row="1"  Visibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                                            <syncfusion:ZoomingScrollBar x:Name="VerticalBar" Orientation="Vertical" Grid.Column="1" Visibility="{TemplateBinding VerticalScrollBarVisibility}"/>

                                            <Rectangle Fill="#FFE9EEF4" Grid.Column="1" Grid.Row="1"/>

                                            <Grid x:Name="rangeSelectionGrid">
                                                <Button x:Name="RangeSelectionClose" Width="15" Height="15" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="{TemplateBinding CloseButtonVisibility}" Margin="{TemplateBinding RangeSelectionMargin}" >
                                                    <Button.Template>
                                                        <ControlTemplate>
                                                            <Grid Background="Transparent">
                                                                <Image Source="/Syncfusion.Chart.Silverlight;component/Resources/RangeSelectionClose.png" />
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>                                                
                                                <ContentPresenter x:Name="rangeSelection" IsHitTestVisible="False" Height="{TemplateBinding RangeSelectionHeight}" Width="{TemplateBinding RangeSelectionWidth}" VerticalAlignment="Top" HorizontalAlignment="Left" ContentTemplate="{TemplateBinding RangeSelectionTemplate}"  Margin="{TemplateBinding RangeSelectionMargin}">
                                                </ContentPresenter>

                                                <ContentPresenter x:Name="rangeSelectionMouseOver" IsHitTestVisible="False" Height="{TemplateBinding RangeSelectionMouseOverHeight}" Width="{TemplateBinding RangeSelectionMouseOverWidth}" VerticalAlignment="Top" HorizontalAlignment="Left" ContentTemplate="{TemplateBinding RangeSelectionOnMouseOverTemplate}"  Margin="{TemplateBinding RangeSelectionMouseMoveMargin}" >
                                                </ContentPresenter>
                                            </Grid>

                                        </Grid>
                                       
                                        <syncfusion:ChartScaleBreakPresenter x:Name="scaleBreakItemsControl" Margin="{TemplateBinding AxesThickness}"  Area="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                                             XAxis="{TemplateBinding PrimaryAxis}" YAxis="{TemplateBinding SecondaryAxis}" Background="{TemplateBinding GridBackground}"
                                                                             IsTabStop="False" ItemsSource="{Binding Breaks, RelativeSource={RelativeSource TemplatedParent}}">
                                            <syncfusion:ChartScaleBreakPresenter.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <syncfusion:ChartScaleBreakPanel x:Name="scaleBreakPanel"/>
                                                </ItemsPanelTemplate>
                                            </syncfusion:ChartScaleBreakPresenter.ItemsPanel>
                                        </syncfusion:ChartScaleBreakPresenter>

                                        <ItemsControl ItemsSource="{TemplateBinding Axes}" IsHitTestVisible="False" >
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <syncfusion:ChartAxesPanel Background="Transparent" x:Name="ChartAxis"></syncfusion:ChartAxesPanel>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>
                                </syncfusion:ChartDockPanel>
                                <ContentPresenter x:Name="ChartFooter" Content="{TemplateBinding Footer}" syncfusion:ChartDockPanel.Dock="Bottom" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="2"/>
                                <Rectangle x:Name="splitter" Grid.Row="3" Height="{TemplateBinding SplitterWidth}" Margin="{TemplateBinding AxesThickness}"  Visibility="Collapsed" Fill="{TemplateBinding SplitterBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="syncfusion:SyncChartAreas" >
        <Setter Property="AreasPanel">
            <Setter.Value>
                <ItemsPanelTemplate >
                    <syncfusion:SyncAreasPanel />
                </ItemsPanelTemplate>
            </Setter.Value>

        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="syncfusion:SyncChartAreas">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <syncfusion:ChartDockPanel x:Name="SyncChartArea_dock" Background="Transparent" Margin="{TemplateBinding Padding}">
<ContentPresenter x:Name="SyncChartLegends" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                  Content="{TemplateBinding Legends}"
                                                  syncfusion:ChartDockPanel.Dock="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Legends.DockPosition}" 
                                                  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Legends, Converter={StaticResource legendvisible}}"/>

                            <ItemsControl  ItemsPanel="{TemplateBinding AreasPanel}"  x:Name="Part_Presenter" ItemsSource="{TemplateBinding Areas}"/>

                        </syncfusion:ChartDockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="syncfusion:InteractiveCursor" >
        <Setter Property="HorizontalCursorTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Canvas>
                        <Line X1="0" X2="0" Stroke="Black" Y1="0" Y2="{Binding ElementName=cursor, Path=Height}" StrokeThickness="2"/>
                        <Ellipse Width="10" Height="10" Fill="Black" Stroke="Black" StrokeThickness="1" Canvas.Top="{Binding ElementName=cursor, Path=YPosition}" Margin="-5,-5,0,0"/>
                    </Canvas>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="VerticalCursorTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Canvas>
                        <Line X1="0" X2="{Binding ElementName=cursor, Path=Width}" Stroke="Black" Y1="0" Y2="0" StrokeThickness="2"/>
                        <Ellipse Width="10" Height="10" Fill="Black" Stroke="Black" StrokeThickness="1" Canvas.Left="{Binding ElementName=cursor, Path=XPosition}" Margin="-5,-5,0,0"/>
                    </Canvas>
                </DataTemplate>
            </Setter.Value>
        </Setter>        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="syncfusion:InteractiveCursor" >
                    <Canvas x:Name="interactivecursor">
                        <Canvas x:Name="horizontalCursor" Background="{TemplateBinding HorizontalCursorInterior}" Canvas.Left="{TemplateBinding XPosition}" Height="{Binding Height, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter ContentTemplate="{TemplateBinding HorizontalCursorTemplate}"  Visibility="{TemplateBinding HorizontalCursorVisibility}" />                 
                        </Canvas>

                        <Canvas x:Name="verticalCursor" Background="{TemplateBinding VerticalCursorInterior}" Canvas.Top="{TemplateBinding YPosition}" Width="{Binding Width, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter ContentTemplate="{TemplateBinding VerticalCursorTemplate}" Visibility="{TemplateBinding VerticalCursorVisibility}" />
                        </Canvas>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
