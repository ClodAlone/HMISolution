<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:toolkit="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.Silverlight"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Chart">


    <LinearGradientBrush EndPoint="0.5,-0.676" StartPoint="0.5,0.427" x:Key="Default.LegendBackground" >
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="sc#1, 0.7036201, 0.708942533, 0.7143452" Offset="0.78167599439620972"/>
        <GradientStop Color="#FFABADAF" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="syncfusion:ChartLegend">
        <Setter Property="Background" Value="{StaticResource Default.LegendBackground}"/>
        <Setter Property="BorderBrush" Value="#FF808080"/>
        <Setter Property="Foreground" Value="#FF15428B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel  Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="syncfusion:ChartLegend">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Background="{TemplateBinding Background}" Margin="{TemplateBinding Margin}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter x:Name="legendItems" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="syncfusion:LegendItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="syncfusion:LegendItem">
                    <StackPanel  Orientation="Horizontal">
                        <CheckBox x:Name="legendCheckBox" DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{TemplateBinding IsChecked}" Visibility="{TemplateBinding CheckboxVisibility}" VerticalAlignment="Center" />
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Stretch" DataContext="{TemplateBinding DataContext}" Content="{TemplateBinding IconContent}" ContentTemplate="{TemplateBinding IconTemplate}" Visibility="{TemplateBinding IconVisibility}" />
                        <TextBlock x:Name="legendlabel" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{TemplateBinding Label}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="syncfusion:LegendEditor">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="syncfusion:LegendEditor">

                    <StackPanel HorizontalAlignment="Center">
                        <Border BorderBrush="Black" BorderThickness="1" Margin="5">
                            <Grid Margin="5"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.5*"/>
                                    <RowDefinition Height="0.5*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="0.5*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Icon" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Width="100" x:Name="IconCombo" Margin="0,5,0,0">
                                    <ComboBoxItem Content="Visible"/>
                                    <ComboBoxItem Content="Collapsed"/>
                                </ComboBox>

                                <TextBlock Text="CheckBox" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" Margin="0,15,0,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="100" x:Name="CheckBoxCombo" Margin="0,15,0,0">
                                    <ComboBoxItem Content="Visible"/>
                                    <ComboBoxItem Content="Collapsed"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                            <Button Content="Ok" x:Name="Okbutton" Margin="5" Width="75"/>
                            <Button Content="Cancel" x:Name="Cancelbutton" Margin="5" Width="75"/>
                        </StackPanel>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
