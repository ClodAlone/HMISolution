<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Chart">

    <LinearGradientBrush EndPoint="0.503,0.941" StartPoint="0.5,-0.061" x:Key="Blue2007ChartEffectsColor">
        <GradientStop Color="#E5FFFFFF" Offset="0.057"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,1.152" StartPoint="0.5,0" x:Key="Blue2007ChartAreaBackground">
        <GradientStop Color="#B2FFFFFF" Offset="0"/>
        <GradientStop Color="#66F4F5FB" Offset="0.074432373046875"/>
        <GradientStop Color="#B2EAEDF7" Offset="0.274"/>
        <GradientStop Color="#00E2E5F4" Offset="0.28974699974060059"/>
        <GradientStop Color="#00DCE0F2" Offset="1"/>
        <GradientStop Color="sc#1, 0.708375752, 0.7379104, 0.8879231" Offset="1"/>
        <GradientStop Color="#00DBDFF2" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" x:Key="Blue2007ChartBackground">
        <GradientStop Color="#FFDDEBFF" Offset="0"/>
        <GradientStop Color="#FFAFD1FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,-0.04" StartPoint="0.5,0.051" x:Key="Blue2007areaGridBackground">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="sc#1, 0.7036201, 0.708942533, 0.7143452" Offset="0.78167599439620972"/>
        <GradientStop Color="#FFABADAF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,-0.676" StartPoint="0.5,0.427" x:Key="Office2007Blue.LegendBackground">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="sc#1, 0.7036201, 0.708942533, 0.7143452" Offset="0.78167599439620972"/>
        <GradientStop Color="#FFABADAF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush Color="DarkBlue" x:Key="Office2007Blue.BorderBackground"/>
   
    <SolidColorBrush x:Key="Office2007Blue.LegendForeground"
                   Color="#FF15428B"/>

    <SolidColorBrush x:Key="Office2007Blue.LegendBorderBackground"
                   Color="#FFA0BEE4"/>

    <SolidColorBrush x:Key="Office2007Blue.AreaBorderBackground"
                   Color="Transparent"/>
    <SolidColorBrush x:Key="Office2007Blue.AreaBackground"
                   Color="Transparent"/>
    <SolidColorBrush Color="#FF1B50FD" x:Key="Office2007Blue.AxisPen"/>


    <Style TargetType="syncfusion:Chart" x:Key="Chart">
        <Setter Property="Background" Value="{StaticResource Blue2007ChartBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Blue.BorderBackground}"/>
    </Style>

    <Style TargetType="syncfusion:ChartLegend"  x:Key="ChartLegend">
        <Setter Property="Background" Value="{StaticResource Office2007Blue.LegendBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Blue.LegendBorderBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style TargetType="syncfusion:ChartArea"  x:Key="ChartArea">
        <Setter Property="EffectsBrush" Value="{StaticResource Blue2007ChartEffectsColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue2007ChartAreaBackground}"/>
        <Setter Property="Foreground" Value="#FF15428B"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="GridBackground" Value="White"/>
        <Setter Property="EnableChartAreaEffects" Value="True"/>
    </Style>

    <Style TargetType="syncfusion:ChartAxis"  x:Key="ChartAxis">
        <Setter Property="LineStroke" Value="{StaticResource Office2007Blue.AxisPen}"/>
        <Setter Property="SmallTicksStroke" Value="{StaticResource Office2007Blue.AxisPen}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource Office2007Blue.AxisPen}"/>
        <Setter Property="LabelForeground" Value="#FF15428B"/>
        <Setter Property="LineStrokeThickness" Value="0.25"/>
        <Setter Property="GridLineStrokeThickness" Value="0.25"/>
        <Setter Property="SmallTicksStrokeThickness" Value="0.25"/>
    </Style>

    <Style TargetType="syncfusion:ChartSeries"  x:Key="ChartSeries">
        <Setter Property="Stroke" Value="#8A53564F"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

</ResourceDictionary>