<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Chart">

    <LinearGradientBrush EndPoint="0.503,0.941" StartPoint="0.5,-0.061" x:Key="SilverChartEffectsColor">
        <GradientStop Color="#E5FFFFFF" Offset="0.057"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.504,0.249" StartPoint="0.507,0.009" x:Key="Silver2007ChartAreaBackground">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="sc#1, 0.9091532, 0.918646932, 0.964187145" Offset="0.074432373046875"/>
        <GradientStop Color="sc#1, 0.83081913, 0.84849894, 0.933306932" Offset="0.16609090566635132"/>
        <GradientStop Color="sc#1, 0.7674812, 0.79178, 0.9083384" Offset="0.28974699974060059"/>
        <GradientStop Color="sc#1, 0.7243403, 0.753147364, 0.8913318" Offset="0.5042881965637207"/>
        <GradientStop Color="sc#1, 0.7156935, 0.7454042, 0.8879231" Offset="1"/>
        <GradientStop Color="#FFDCE0F2" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,0" StartPoint="0.5,1" x:Key="Silver2007ChartBackground">
        <GradientStop Color="#FFE0E0E0" Offset="0"/>
        <GradientStop Color="sc#1, 0.753371835, 0.754121244, 0.754121244" Offset="0.527618408203125"/>
        <GradientStop Color="sc#1, 0.7701632, 0.772491932, 0.772491932" Offset="0.71626543998718262"/>
        <GradientStop Color="sc#1, 0.792361856, 0.79677844, 0.79677844" Offset="0.85117101669311523"/>
        <GradientStop Color="sc#1, 0.8188563, 0.8257649, 0.8257649" Offset="0.96028566360473633"/>
        <GradientStop Color="sc#1, 0.8307699, 0.838799, 0.838799" Offset="1"/>
        <GradientStop Color="#FFEBECEC" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,-0.04" StartPoint="0.5,0.051" x:Key="Silver2007GridAreaBackground">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="sc#1, 0.7036201, 0.708942533, 0.7143452" Offset="0.78167599439620972"/>
        <GradientStop Color="#FFABADAF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,-0.676" StartPoint="0.5,0.427" x:Key="Office2007Silver.LegendBackground">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="sc#1, 0.7036201, 0.708942533, 0.7143452" Offset="0.78167599439620972"/>
        <GradientStop Color="#FFABADAF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush Color="#6C7278" x:Key="Office2007Silver.ChartBorderBackground"/>

   
    <SolidColorBrush x:Key="Office2007Silver.LegendForeground"
                   Color="#FF15428B"/>

    <SolidColorBrush x:Key="Office2007Silver.LegendBorderBackground"
                   Color="#FFA0BEE4"/>

    <SolidColorBrush x:Key="Office2007Silver.AreaBorderBackground"
                   Color="#FF6D6F71"/>

    <SolidColorBrush x:Key="Office2007Silver.AreaBackground"
                   Color="Transparent"/>
    <SolidColorBrush Color="#FF545456" x:Key="Office2007Silver.AxisPen"/>
    
     <Style TargetType="syncfusion:Chart" x:Key="Chart">
        <Setter Property="Background" Value="{StaticResource Silver2007ChartBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Silver.ChartBorderBackground}"/>
    </Style>

   <Style TargetType="syncfusion:ChartLegend" x:Key="ChartLegend">
        <Setter Property="Background" Value="{StaticResource Office2007Silver.LegendBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Silver.LegendBorderBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Office2007Silver.LegendForeground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style TargetType="syncfusion:ChartArea" x:Key="ChartArea">
        <Setter Property="BorderBrush" Value="{StaticResource Office2007Silver.AreaBorderBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource Office2007Silver.LegendForeground}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="GridBackground" Value="White"/>
        <Setter Property="EffectsBrush" Value="{StaticResource SilverChartEffectsColor}"/>
        <Setter Property="EnableChartAreaEffects" Value="True"/>
    </Style>

    <Style TargetType="syncfusion:ChartAxis" x:Key="ChartAxis">
        <Setter Property="LineStroke" Value="{StaticResource Office2007Silver.AxisPen}"/>
        <Setter Property="SmallTicksStroke" Value="{StaticResource Office2007Silver.AxisPen}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource Office2007Silver.AxisPen}"/>
        <Setter Property="LineStrokeThickness" Value="0.25"/>
        <Setter Property="GridLineStrokeThickness" Value="0.25"/>
        <Setter Property="SmallTicksStrokeThickness" Value="0.25"/>
    </Style>

    <Style TargetType="syncfusion:ChartSeries" x:Key="ChartSeries">
        <Setter Property="Stroke" Value="#8A53564F"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

</ResourceDictionary>