    <SolidColorBrush  x:Key="ScreenTipBackgroundBrushKey" Color="#FF666666"/>
    <Style TargetType="local:ScreenTip" x:Key="BlendScreenTipStyle">
        <Setter Property="Background" Value="{StaticResource ScreenTipBackgroundBrushKey}" />
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushKey}"/>
        <Setter Property="Foreground" Value="{StaticResource ForgroundBrushKey}" />
        <Setter Property="HelpImage" Value="/Syncfusion.Ribbon.Silverlight;component/Ribbon/Resources/Help.png" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScreenTip">
                    <Grid Background="Transparent">
                        <Grid.Resources>
                            <local:TextToVisibilityConverter x:Key="TextToVisibilityConverterKey" />
                            <local:SizeToDoubleConverter x:Name="SizeToDoubleConverterKey" />
                        </Grid.Resources>
                        <local:RibbonShadow Margin="5,5,0,0"/>

                        <Border MinHeight="20" CornerRadius="4" Background="{TemplateBinding Background}" 
                            BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition MinHeight="20" />
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Desc" Foreground="{TemplateBinding Foreground}"
                                           Grid.Row="0" Grid.ColumnSpan="2" FontSize="12" FontWeight="Bold" FontFamily="Calibri" 
                                           Text="{TemplateBinding Description}" />
                                <Border Grid.Row="1" Grid.Column="0" x:Name="Image" Margin="0,0,2,0">
                                    <Image Source="{TemplateBinding ImageSource}" Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}"
                                        Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap"
                                    Grid.Row="1" Grid.Column="1" x:Name="Text" Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Content}"
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Top" />

                                <Grid Visibility="{Binding RelativeSource={RelativeSource TemplatedParent},Path=HelpText,Converter={StaticResource TextToVisibilityConverterKey}}" 
                                      Grid.ColumnSpan="2" Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <local:RibbonSeparator Margin="0,3" Grid.Row="0" Grid.ColumnSpan="2" 
                                                           VerticalAlignment="Center" HorizontalAlignment="Stretch" x:Name="PART_Separator"  Style="{StaticResource BlendribbonSeparatorStyle}" />
                                    <Image Margin="2" Source="{TemplateBinding HelpImage}" Grid.Row="1" x:Name="PART_HelpImage" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PART_HelpText" VerticalAlignment="Center"
                                               Text="{TemplateBinding HelpText}" Grid.Row="1" Grid.Column="1"  
                                               FontSize="12" FontWeight="Bold" FontFamily="Calibri" Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource BlendScreenTipStyle}" TargetType="local:ScreenTip"/>
    <Style TargetType="local:RibbonButton" x:Key="BlendRibbonButtonStyle">
        <Setter Property="Foreground" Value="{StaticResource RibbonItemForeground}" />
        <Setter Property="SmallIcon" Value="/Syncfusion.Ribbon.Silverlight;component/Ribbon/Resources/WordArt16.png"/>
        <Setter Property="LargeIcon" Value="/Syncfusion.Ribbon.Silverlight;component/Ribbon/Resources/WordArt32.png"/>
        <Setter Property="Label" Value="Ribbon Button"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonButton">
                    <Grid>
                        <Grid.Resources>
                            <local:MultiLineConverter x:Key="TextConverter"/>
                        </Grid.Resources>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="RibbonButtonStates">

                                <vsm:VisualState x:Name="Normal" />

                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFAAAAAA" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFAAAAAA" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder1" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFAAAAAA" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder1" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFAAAAAA" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Text" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF333333" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_TextAreaLarge" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF333333" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonButtonhoverBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF444444" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder1" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonButtonhoverBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder1" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF444444" />
                                        </ObjectAnimationUsingKeyFrames>
                                        
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Text" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemForeground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_TextAreaLarge" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemForeground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="UnChecked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Duration="0:0:0.25" Storyboard.TargetProperty="Opacity">
