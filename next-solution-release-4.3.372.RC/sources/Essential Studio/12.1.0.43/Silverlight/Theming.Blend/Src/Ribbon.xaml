                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation To="0.75" Duration="0:0:0.25"
														 Storyboard.TargetName="DisabledElement"
														 Storyboard.TargetProperty="Opacity"/>
                                    </Storyboard>
                                </VisualState>

                            </VisualStateGroup>

                            <VisualStateGroup>
                            </VisualStateGroup>

