    <SolidColorBrush x:Key="GalleryBorderBrush" Color=" #FF595959"/>
    <Style TargetType="local:RibbonGallery">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="ItemWidth" Value="60.0"/>
        <Setter Property="ItemHeight" Value="60.0"/>
        <Setter Property="BorderBrush" Value="{StaticResource GalleryBorderBrush}"/>
        <Setter Property="Background" Value="#FF333333"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonGallery">
                    <Border BorderThickness="1" CornerRadius="2" VerticalAlignment="Top"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}" >

                        <vsm:VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="RibbonGalleryMode">

                                <VisualState x:Name="General"/>

                                <VisualState x:Name="Fixed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GeneralHost" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FixedHost" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ScrollUpButton" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ScrollDownButton" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DropDownButton" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                            </VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer x:Name="GeneralHost" Style="{StaticResource ScrollViewerStyle}" Grid.RowSpan="3" BorderThickness="0" Padding="0" >
                                <ItemsPresenter x:Name="ItemsPresenter" Margin="4"/>
                            </ScrollViewer>
                            <ContentControl x:Name="FixedHost" Grid.RowSpan="3" Visibility="Collapsed"
												Height="{TemplateBinding ItemHeight}"
												Foreground="{TemplateBinding Foreground}"/>
                         
                                <primitives:RepeatButton x:Name="ScrollUpButton" Grid.Column="1" Grid.Row="0" IsEnabled="False" Visibility="Collapsed"
														 Style="{StaticResource RibbonGalleryUpRepeatButtonStyle}" BorderThickness="1" >
                              
                            </primitives:RepeatButton>
                            <primitives:RepeatButton x:Name="ScrollDownButton" Grid.Column="1" Grid.Row="1" IsEnabled="False" Visibility="Collapsed"
														 Style="{StaticResource RibbonGalleryDownRepeatButtonStyle}" BorderThickness="1,0,1,0" >
                              
                            </primitives:RepeatButton>
                            <local:RibbonDropDownItem x:Name="DropDownButton" Grid.Column="1" Grid.Row="2" Height="20" Visibility="Collapsed"
													  Style="{StaticResource RibbonGalleryDropDownButtonStyle}" >
                                <local:RibbonDropDownItem.DropDown>
                                    <local:RibbonDropDown MinHeight="{TemplateBinding ItemHeight}" >
                                        <Grid>
                                            <local:RibbonShadow Margin="4,4,0,0"/>

                                            <Border BorderThickness="1" CornerRadius="2"
														Background="{TemplateBinding Background}"
														BorderBrush="{TemplateBinding BorderBrush}" >
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <ScrollViewer x:Name="PopupHost"  Style="{StaticResource ScrollViewerStyle}"  BorderThickness="0" Padding="0"
																	  Foreground="{TemplateBinding Foreground}"
																	  MinHeight="{TemplateBinding ItemHeight}" />

                                                    <ContentControl Grid.Row="1" Margin="4,0,0,0"
																		Foreground="{TemplateBinding Foreground}"
																		Content="{TemplateBinding Footer}"
																		ContentTemplate="{TemplateBinding FooterTemplate}"/>

                                                    <Border x:Name="ThumbBorder" Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="Transparent" 
																Background="{StaticResource Gallery.Bottom.Background}">
                                                        <Border x:Name="ResizeThumb" Height="10" Background="#FF595959" Cursor="SizeNWSE"
																	HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Path Margin="0,0,2,2"  HorizontalAlignment="Right" VerticalAlignment="Bottom" >
                                                                <Path.Data>
                                                                    <GeometryGroup>
                                                                        <EllipseGeometry Center="0,0" RadiusX="1" RadiusY="1" />
                                                                        <EllipseGeometry Center="4,0" RadiusX="1" RadiusY="1" />
                                                                        <EllipseGeometry Center="4,-4" RadiusX="1" RadiusY="1" />
                                                                    </GeometryGroup>
                                                                </Path.Data>
                                                                <Path.Fill>
                                                                    <SolidColorBrush Color="#FF3A3A3A"/>
                                                                </Path.Fill>
                                                            </Path>
                                                        </Border>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                        </Grid>
                                    </local:RibbonDropDown>
                                </local:RibbonDropDownItem.DropDown>
                            </local:RibbonDropDownItem>
                            
                        </Grid>

                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:RibbonGalleryPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

