                                                    <Grid Opacity="0" x:Name="PART_poup">
                                                        <local:RibbonShadow Margin="3,3,0,0"/>
                                                        <Border Background="{StaticResource MenugroupBackground}" >
                                                            <ItemsPresenter />
                                                        </Border>
                                                    </Grid>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF777777" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonButtonhoverBorderBrush1}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="linepath" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFFFF" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Path1" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFFFF" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Path1" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFFFF" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFB2B2B2}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFB2B2B2" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="linepath" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF333333" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Path1" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF333333" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Path1" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF333333" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To=".55" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="DisabledVisualElement"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked" />
                                <VisualState x:Name="Unchecked"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid Background="Transparent" x:Name="PART_ToggleButton">
                            <Border x:Name="Background" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="3">
                                <Grid Background="{TemplateBinding Background}" Margin="1">
                                    <Border x:Name="BackgroundAnimation" Background="#FFFFF5D9" Opacity="0"/>
                                    <Border x:Name="BackgroundGradient" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="2" />
                                </Grid>
                            </Border>
                            <Grid Width="5" Background="Transparent">
                                <StackPanel VerticalAlignment="Center">
                                    <Line Fill="Black" VerticalAlignment="Bottom" X2="1" Stretch="Fill" Stroke="#FFC5C5C5" x:Name="linepath" />
                                    <Path  x:Name="Path1" Data="M3.375,8.3987293 L8.0413799,8.4820175 L5.6247015,12.896584 z" Fill="#FFC5C5C5" StrokeStartLineCap="Flat" Stretch="Fill" StrokeEndLineCap="Flat" Stroke="#FFC5C5C5" StrokeThickness="1" StrokeMiterLimit="10" StrokeLineJoin="Miter" Height="3.3" Grid.Row="1" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                            <Rectangle x:Name="DisabledVisualElement" Fill="#FFFFFFFF" IsHitTestVisible="false" Opacity="0" RadiusY="3" RadiusX="3"/>
                            <Rectangle x:Name="FocusVisualElement" IsHitTestVisible="false" Margin="1" Opacity="0" RadiusY="2" RadiusX="2" Stroke="#FF6DBDD1" StrokeThickness="1"/>
                        </Grid>
                        <local:RibbonDropDown Grid.Row="1" x:Name="PART_RibbonDropDown">
                            <local:RibbonMenuGroup x:Name="PART_RibbonMenuGroup" Header="Customize Quick Access Toolbar" IconBarEnabled="True">
                                <local:RibbonMenuItem x:Name="PART_MoreCommands" />
                                <local:RibbonMenuItem x:Name="PART_ShowBelowtheRibbon" />
                                <local:RibbonSeparator Margin="24,0,5,0"/>
                                <local:RibbonMenuItem x:Name="PART_MinimizeRibbon" IsCheckable="True"/>
                            </local:RibbonMenuGroup >
                        </local:RibbonDropDown>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource BlendQATDropDownControlStyle}" TargetType="local:QATDropDownControl"/>
    <Style TargetType="local:QuickAccessToolBar" x:Key="BlendQuickAccessToolBarStyle">
        <Setter Property="Height" Value="22"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:QuickAccessToolBar">
                    <Grid x:Name="PART_RootElement">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OverFlowBackgroundGradient" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemMouseOverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OverFlowBackgroundGradient" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OverFlowBackgroundGradient" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OverFlowBackgroundGradient" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonItemBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To=".55" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="OverFlowDisabledVisualElement"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked" />
                                <VisualState x:Name="Unchecked"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="LayoutRoot" Height="22" Background="{TemplateBinding Background}">
                            <Grid.Resources>
                                <local:VisibilityInverter x:Key="PART_VisibilityInverter" />
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RibbonToolbarBorder" Grid.Column="1" Margin="-1,0,0,0" BorderThickness="0,1,0,0" 
                                    Visibility="{TemplateBinding PathGeometryVisibility}"
                                    Background="{StaticResource RibbonToolbarActiveBrush}" BorderBrush="{StaticResource RibbonToolbarStroke}" />
                            <ItemsPresenter x:Name="Part_ItemsPresenter" Grid.Column="1" Margin="2,1,5,1" VerticalAlignment="Center" />
                            <Path x:Name="PathBeg" Grid.Column="0" StrokeLineJoin="Round" 
                                  Visibility="{TemplateBinding PathGeometryVisibility}"
                                  Fill="{StaticResource RibbonToolbarActiveBrush}" Stroke="{StaticResource RibbonToolbarStroke}" StrokeThickness="1" Stretch="UniformToFill">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="22,22">
                                            <ArcSegment Point="0,0" Size="22,22" SweepDirection="Counterclockwise"/>
                                            <LineSegment Point="22,0"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <Path x:Name="PathEnd" Grid.Column="2" Margin="-1,0,0,0" StrokeLineJoin="Round" 
                                  Visibility="{TemplateBinding PathGeometryVisibility}"
                                  Fill="{StaticResource RibbonToolbarActiveBrush}" Stroke="{StaticResource RibbonToolbarStroke}" StrokeThickness="1" Stretch="UniformToFill" >
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="0,0">
                                            <ArcSegment Point="0,22" Size="11,11" SweepDirection="Clockwise"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <Grid Grid.Column="3" x:Name="PART_NormalContainer" Visibility="{Binding OverFlowVisibility, Converter={StaticResource PART_VisibilityInverter}, RelativeSource={RelativeSource TemplatedParent}}" Width="15">
                                <local:QATDropDownControl x:Name="PART_QATDropDownControl" Style="{StaticResource BlendQATDropDownControlStyle}" QATButtonCaption="{TemplateBinding QATButtonCaption}" />
                            </Grid>
                            <Grid Grid.Column="3" Visibility="{TemplateBinding OverFlowVisibility}" x:Name="PART_OverFlowContainer" Width="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid Background="Transparent" x:Name="PART_OverFlowToggleButton">
                                    <Border x:Name="OverFlowBackground" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="3">
                                        <Grid Background="{TemplateBinding Background}" Margin="1">
                                            <Border x:Name="OverFlowBackgroundAnimation" Background="#FFFFF5D9" Opacity="0" CornerRadius="2"/>
                                            <Border x:Name="OverFlowBackgroundGradient" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Height="22" HorizontalAlignment="Center">
                                        <Path Data="M0.46875,6.0625 L0.46875,10.438004 L4.5625,8.0627766 z" Fill="#FF00156E" Height="5.376" Margin="0" Stretch="Fill" Stroke="#FF00156E" VerticalAlignment="Center" Width="3"/>
                                        <Path Data="M0.46875,6.0625 L0.46875,10.438004 L4.5625,8.0627766 z" Fill="#FF00156E" Height="5.376" Margin="2,0,0,0" Stretch="Fill" Stroke="#FF00156E" VerticalAlignment="Center" Width="3"/>
                                    </StackPanel>
                                    <Rectangle x:Name="OverFlowDisabledVisualElement" Fill="#FFFFFFFF" IsHitTestVisible="false" Opacity="0" RadiusY="3" RadiusX="3"/>
                                    <Rectangle x:Name="OverFlowFocusVisualElement" IsHitTestVisible="false" Margin="1" Opacity="0" RadiusY="2" RadiusX="2" Stroke="#FF6DBDD1" StrokeThickness="1"/>
                                </Grid>
                                <local:RibbonDropDown Grid.Row="1" x:Name="PART_OverflowRibbonDropDown">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" x:Name="PART_OverflowItemsControl" />
                                        <Grid x:Name="PART_OverFlowTopContainer" Width="15" Background="Transparent" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </local:RibbonDropDown>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource BlendQuickAccessToolBarStyle}" TargetType="local:QuickAccessToolBar"/>
   
    <Style TargetType="local:Ribbon" x:Key="BlendRibbonStyle">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="QuickAccessToolbarStyle" Value="{StaticResource BlendQuickAccessToolBarStyle}"/>
        <Setter Property="ApplicationMenuStyle" Value="{StaticResource BlendApplicationmenuStyle}"/>
        <Setter Property="Foreground" Value="{StaticResource RibbonForeground}" />
        <Setter Property="Title" Value="My Application"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <!--<Grid/>-->
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Ribbon">
                    <Grid x:Name="Ribbon" Background="{StaticResource RibbonBackground}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <!--<RowDefinition Height="24" />-->
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" MaxWidth="42" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <shared:ContextMenuAdvService.ContextMenuAdv>
                            <shared:ContextMenuAdv>
                                <shared:ContextMenuItemAdv Header="Customize Quick Access Toolbar..." Name="PART_MoreCommands"/>
                                <shared:ContextMenuItemAdv Header="Show Quick Access Toolbar below the Ribbon" Name="PART_ShowBelow"/>
                                <shared:ContextMenuItemAdv Header="Minimize Ribbon" Name="PART_Minimize" IsCheckable="True"/>
                            </shared:ContextMenuAdv>
                        </shared:ContextMenuAdvService.ContextMenuAdv>


                        <Border x:Name="Title" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="0 -24" Height="24" BorderThickness="0"  BorderBrush="{StaticResource DarkBorder}" Background="{StaticResource TitleBackground}"/>

                        <Border x:Name="TabBar" Grid.Row="0" Grid.ColumnSpan="2" BorderThickness="0"  BorderBrush="{StaticResource LightBorder}">
                        </Border>

                        <ContentControl Grid.RowSpan="1" Margin="0 -24 0 0" Grid.Row="0" BorderThickness="0" Content="{TemplateBinding ApplicationMenu}" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center"/>

                        <Grid Margin="-15,-48,0,0" Grid.Column="1" VerticalAlignment="Center" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="PART_QATAboveContainer">
                                <ContentControl BorderThickness="0" Content="{TemplateBinding QuickAccessToolBar}" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <local:RibbonTitlePanel x:Name="Part_TitlePanel" VerticalAlignment="Top" Height="24" Margin="0 -24 0 0" Grid.Column="1" Caption="{TemplateBinding Title}" Foreground="{StaticResource RibbonCaptionForeground}" Background="Transparent"/>

                        <Border CornerRadius="1" Margin="1" x:Name="Part_QATBorderContainer" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" 
                                BorderThickness="1" Background="#FF3A3A3A" BorderBrush="#FF3A3A3A">
                           
                            <Grid x:Name="PART_QATBelowContainer" />
                        </Border>

                        <ContentPresenter x:Name="Part_NormalTabHost" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch">
                            <ContentControl                                      
                                FontFamily="{TemplateBinding FontFamily}" 
                                FontSize="{TemplateBinding FontSize}" 
                                FontStretch="{TemplateBinding FontStretch}"
                                FontStyle="{TemplateBinding FontStyle}"
                                FontWeight ="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}">
                                <ItemsPresenter  x:Name="Part_TabPresenter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </ContentControl>
                        </ContentPresenter>

                        <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Height="1" Fill="{StaticResource DarkBorder}" VerticalAlignment="Bottom"/>

                        <local:RibbonDropDown x:Name="Part_PopupTabHost" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch">
                            <local:RibbonDropDown.Template>
                                <ControlTemplate>
                                    <Popup x:Name="Part_Popup" >
                                        <Canvas>
                                            <Rectangle x:Name="Part_OutsideRect"/>
                                            <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                                                <local:RibbonShadow Margin="4,4,0,0"/>
                                                <ContentPresenter />
                                            </Grid>
                                        </Canvas>
                                    </Popup>
                                </ControlTemplate>
                            </local:RibbonDropDown.Template>
                        </local:RibbonDropDown>

                        <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,-1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:RibbonTabStrip x:Name="Part_TabStrip" Background="{StaticResource RibbonTabStripBackground}" >


                            </local:RibbonTabStrip>
                            <ContentControl Content="{TemplateBinding TabPanelItem}" Grid.Column="1" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource BlendRibbonStyle}" TargetType="local:Ribbon"/>
</ResourceDictionary>
