                                                    <ContentPresenter x:Name="Part_CollapsedHost"/>
                                                </Border>
                                            </Grid>
                                        </Canvas>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
