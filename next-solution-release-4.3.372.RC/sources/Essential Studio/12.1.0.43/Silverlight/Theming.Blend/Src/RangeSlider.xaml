                    </VisualState>
                    <VisualState x:Name="Unfocused">

                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Path Stretch="Fill" x:Name="paththumb" Stroke="{StaticResource RangeSliderThumbBorderBrushKey}" StrokeThickness="1" Fill="{StaticResource RangeSliderThumbBrushKey}"  Data="M0.125,0.125 L0.125,9.25 L5.125,17.875 L10.75,9 L10.75,0 z">

            </Path>
        </Grid>
    </ControlTemplate>

