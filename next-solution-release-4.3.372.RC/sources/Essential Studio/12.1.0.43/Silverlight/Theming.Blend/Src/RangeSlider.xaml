                            </ObjectAnimationUsingKeyFrames>



                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="paththumb" Storyboard.TargetProperty="Fill">
