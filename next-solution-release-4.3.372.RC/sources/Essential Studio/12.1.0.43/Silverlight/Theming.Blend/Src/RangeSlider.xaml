                            </ObjectAnimationUsingKeyFrames>


                        </Storyboard>

                    </VisualState>
                    <VisualState x:Name="MouseEnter">

                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="paththumb" Storyboard.TargetProperty="Fill">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RangeSliderThumbBrushKey}"/>
                            </ObjectAnimationUsingKeyFrames>



                        </Storyboard>

                    </VisualState>
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="paththumb" Storyboard.TargetProperty="Fill">
