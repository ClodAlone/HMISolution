<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight" >

    <!-- Brushes -->

    <SolidColorBrush x:Key="RangeSliderRepeatButtonBackgroundGradientBrushKey" Color="#FF595959"/>

    <SolidColorBrush x:Key="RangeSliderRepeatButtonBackgroundAnimationBrushKey" Color="#FF595959"/>

    <SolidColorBrush x:Key="RangeSliderThumbMouseOverBrushKey" Color="#FF808080"/>

    <SolidColorBrush x:Key="RangeSliderThumbBrushKey" Color="#FF595959"/>

    <SolidColorBrush x:Key="DisabledBackgroundBrushKey" Color="#FF666666"/>

    <SolidColorBrush x:Key="FocusedBorderBrushKey" Color="#FF808080"/>

    <SolidColorBrush x:Key="TextBrushKey" Color="#FF333333"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrushKey" Color="#FF595959"/>

    <SolidColorBrush x:Key="RangeSliderThumbBorderBrushKey" Color="#FF333333"/>

    <SolidColorBrush x:Key="RangeSliderRepeatButtonBackgroundGradientPressedBrushKey" Color="#FF595959"/>
        
    <SolidColorBrush x:Key="RangeSliderRepeatButtonBackgroundGradientPressedStrokeKey" Color="#FF333333"/> 
    <SolidColorBrush x:Key="RangeSliderBorderBrushKey" Color="#FF333333"/>

    <SolidColorBrush x:Key="RangeSliderBackgroundBrushKey" Color="#FF525252"/>
    


    <!-- Styles -->

    <ControlTemplate x:Key="RangeSliderRepeatButtonTemplate1" TargetType="RepeatButton">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <Storyboard>
                            <DoubleAnimation Duration="0" Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Opacity" To="1"/>
                            <DoubleAnimation Duration="0" Storyboard.TargetName="Background" Storyboard.TargetProperty="Opacity" To="1"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="MouseOver">
                        <Storyboard>
                            <DoubleAnimation Duration="0" Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Opacity" To="1"/>
                            <DoubleAnimation Duration="0" Storyboard.TargetName="Background" Storyboard.TargetProperty="Opacity" To="1"/>
                            <ColorAnimation Duration="0" Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="(Rectangle.Fill).(SolidColorBrush.Color)" To="#FFAAAAAA"/>
                            <ColorAnimation Duration="0" Storyboard.TargetName="contentPresenter"  Storyboard.TargetProperty="(Control.Foreground).(SolidColorBrush.Color)" To="#FFE9E9E9"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <ColorAnimation Duration="0" Storyboard.TargetName="Background" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FF333333"/>
                            <DoubleAnimation Duration="0" Storyboard.TargetName="Background" Storyboard.TargetProperty="Opacity" To="1"/>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RangeSliderRepeatButtonBackgroundGradientPressedBrushKey}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <ColorAnimation Duration="0" Storyboard.TargetName="contentPresenter"  Storyboard.TargetProperty="(Control.Foreground).(SolidColorBrush.Color)" To="#FFFFFFFF"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Focused">
                    </VisualState>
                    <VisualState x:Name="Unfocused" >
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Background" CornerRadius="5" Opacity="0" Background="{TemplateBinding Background}" BorderThickness="0" BorderBrush="{TemplateBinding BorderBrush}">
                <Grid Background="Transparent">
                    <Rectangle x:Name="BackgroundGradient"  RadiusX="0" RadiusY="0" Opacity="1" Fill="{StaticResource RangeSliderRepeatButtonBackgroundGradientBrushKey}" Stroke="{StaticResource RangeSliderRepeatButtonBackgroundGradientPressedStrokeKey}">
                    </Rectangle>
                </Grid>
            </Border>
            <ContentControl 
                              x:Name="contentPresenter"
                              Content="3" FontFamily="Webdings"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="{TemplateBinding Padding}" Foreground="#FFBCBCBC"
                                 />
            <Rectangle x:Name="DisabledVisualElement" RadiusX="3" RadiusY="3" Fill="{StaticResource DisabledBackgroundBrushKey}" Opacity="0" IsHitTestVisible="false" />
            <Rectangle x:Name="FocusVisualElement" RadiusX="2" RadiusY="2" Margin="1" Stroke="{StaticResource FocusedBorderBrushKey}" StrokeThickness="1" Opacity="0" IsHitTestVisible="false" />
        </Grid>
    </ControlTemplate>


