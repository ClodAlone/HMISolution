                                        <data:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Height="27" Tag="{Binding Path=FileName}" Style="{StaticResource FileUploadButtonStyle1}"   Width="27" Cursor="Hand" Command="{Binding CancelUploadCommand}" >
