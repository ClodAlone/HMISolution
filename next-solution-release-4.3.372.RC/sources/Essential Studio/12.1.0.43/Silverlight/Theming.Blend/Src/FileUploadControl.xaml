                            <Grid Margin="0,10,0,0" Grid.Row="2"  x:Name="ButtonsGrid" Height="100">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2.5*" />
                                </Grid.ColumnDefinitions>

                                <Button Style="{StaticResource FileUploadButtonStyle}" Width="100" Content="Browse..." Margin="0,0,5,0"  Command="{Binding RelativeSource={RelativeSource TemplatedParent},Path=BrowseCommand}"
                                            Height="25" x:Name="BtnBrowse" FontSize="12" Grid.Column="0"/>
                                <Button Style="{StaticResource FileUploadButtonStyle}" Width="100" Content="Upload" Margin="0,0,5,0" Command="{Binding RelativeSource={RelativeSource TemplatedParent},Path=UploadCommand}"
                                            x:Name="BtnUpload" FontSize="12" Grid.Column="1"/>
                                <Button Style="{StaticResource FileUploadButtonStyle}" Width="100" Content="Clear All" Margin="0,0,5,0" Command="{Binding RelativeSource={RelativeSource TemplatedParent},Path=ClearCommand}"
                                            x:Name="BtnClear" FontSize="12" FontFamily="Arial" Grid.Column="2"/>

                                <Image HorizontalAlignment="Right" VerticalAlignment="Center"  x:Name="ThumbnailImage" Grid.Column="3" Grid.RowSpan="2" Grid.Row="1" Margin="0,0,10,0">
                                    <Image.Effect>
                                        <DropShadowEffect/>
                                    </Image.Effect>
                                </Image>

                                <Grid Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0" x:Name="DetailsGrid" 
                                    Visibility="{Binding RelativeSource={RelativeSource TemplatedParent},Path=EnableDetails,Converter={StaticResource BooleanToVisibilityConverter}}" >
                                    <Grid.ColumnDefinitions >
                                        <ColumnDefinition Width="60"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="TxtDetails" Text="Details" Foreground="Gray"  FontSize="14" FontWeight="Bold" Grid.Column="0" Margin="5,0,0,0"></TextBlock>
                                    <StackPanel Grid.Column="1"  Margin="15,2,0,0">
                                        <StackPanel Orientation="Horizontal" >
                                            <TextBlock  x:Name="TxtTotalFilesHeading" Foreground="Gray" Text="Total Files Uploaded   : " />
                                            <TextBlock  x:Name="TxtTotalFiles"  Foreground="Gray" Text="0"/>
                                        </StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" >
                                                <TextBlock x:Name="TxtTotalBytesHeading" Foreground="Gray" Text="Total Bytes Uploaded : " />
                                                <TextBlock x:Name="TxtTotalBytes"  Foreground="Gray" Text="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource BlendFileUploadControlStyle}" TargetType="local:FileUploadControl"/>


</ResourceDictionary>
