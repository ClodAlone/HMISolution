                                    <data:DataGridTextColumn Binding="{Binding Path=FileName}" IsReadOnly="True" Header="File Name" Width="Auto"/>
                                    <data:DataGridTextColumn Binding="{Binding Path=FileSize}" IsReadOnly="True" Header="File Size" Width="Auto" SortMemberPath="FileLength"  />
                                    <data:DataGridTextColumn Binding="{Binding Path=FileStatus}" IsReadOnly="True" Header="Status" Width="Auto"/>
                                    <data:DataGridTextColumn Binding="{Binding Path=SizeUploaded}" IsReadOnly="True" Header="Size Uploaded" Width="Auto"/>
                                    <data:DataGridTemplateColumn Header="Progress" Width="Auto" IsReadOnly="True">
                                        <data:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar MinWidth="50" Height="20" Maximum="100" Minimum="0"  Value="{Binding PercentageUploaded}"/>
                                            </DataTemplate>
                                        </data:DataGridTemplateColumn.CellTemplate>
                                    </data:DataGridTemplateColumn>

