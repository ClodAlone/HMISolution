                                        <data:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Height="27" Tag="{Binding Path=FileName}" Command="{Binding RemoveUploadCommand}"  Style="{StaticResource FileUploadButtonStyle1}"  Width="27" Cursor="Hand" >
