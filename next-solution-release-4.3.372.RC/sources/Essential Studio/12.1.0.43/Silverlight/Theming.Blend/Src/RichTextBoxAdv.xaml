<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"
    xmlns:rich="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.RichTextBoxAdv.Silverlight">
    <SolidColorBrush Color="#FF2D2D2D" x:Key="PageViewerBackgroundBrush" />
    <Style x:Key="BlendContextMenuItemAdvStyle" TargetType="local:ContextMenuItemAdv">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Theme" Value="Blend"/>
        <Setter Property="Padding" Value="4,3,2,3"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ContextMenuItemAdv">
                    <Grid Height="{TemplateBinding Height}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="Presenter" Storyboard.TargetProperty="Opacity" To="0.5"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="1"/>
                                        <ColorAnimation Duration="0" Storyboard.TargetName="InnerBorder" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)" To="#FFAAAAAA"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Rectangle  Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                        <Rectangle x:Name="Bg"  Stroke="#FFAAAAAA" Fill="#FFAAAAAA" StrokeThickness="1" Opacity="0">
                        </Rectangle>
                        <Rectangle x:Name="InnerBorder" RadiusX="2" RadiusY="2" Stroke="Transparent" Margin="1"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="Auto"
                                    MinWidth="24"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="17"/>
                                <ColumnDefinition Width="0"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl x:Name="PART_Content" Margin="1" VerticalAlignment="Center" Height="17" Width="17" HorizontalAlignment="Center" Grid.Column="0" />

                            <Border BorderThickness="1" CornerRadius="3" BorderBrush="#FF3A3A3A" Background="#FF3A3A3A" x:Name="GlyphPanel" 
                                    Visibility="{TemplateBinding CheckBoxVisibility}"
                                    Width="22" Height="22" Margin="1">
                                <Path Data="M0,5.1L1.7,5.2 3.4,7.1 8,0.4 9.2,0 3.3,10.8z" Fill="#FFF6F6F6" x:Name="Glyph" Width="9" Height="11" FlowDirection="LeftToRight"/>
                            </Border>

                            <Border x:Name="GlyphPanel1" BorderThickness="1" CornerRadius="3" BorderBrush="#FF3A3A3A" Background="#FF3A3A3A" Visibility="{TemplateBinding RadioButtonVisibility}">
                                <Ellipse x:Name="Background"
								            StrokeThickness="1" Height="6" Margin="1" Width="6">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.65625,0.218746" GradientOrigin="0.65625,0.218746">
                                            <RadialGradientBrush.GradientStops>
                                                <GradientStop Color="#FFF6F6F6" Offset="0"/>
                                                <GradientStop Color="#FFF6F6F6" Offset="1"/>
                                            </RadialGradientBrush.GradientStops>
                                            <RadialGradientBrush.RelativeTransform>
                                                <TransformGroup>
                                                    <RotateTransform CenterX="0.65625" CenterY="0.218746" Angle="120.379"/>
                                                </TransformGroup>
                                            </RadialGradientBrush.RelativeTransform>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Border>

                            <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Header}" VerticalAlignment="Center" Margin="10,0,0,0" ContentTemplate="{TemplateBinding HeaderTemplate}" 
                                              Grid.Column="2"/>

                            <Border x:Name="ExtendBtn" Grid.Column="3" Visibility="{TemplateBinding ExtendButtonVisibility}">
                                <Path x:Name="extendPath" Fill="#FFF6F6F6" Stretch="Fill" Grid.Column="3" Stroke="#FFF6F6F6" HorizontalAlignment="Left" Margin="5,0,0,0" Width="5" Height="5" 
                                      UseLayoutRounding="False" Data="M129,173 L129,282 L246,222 z" />
                            </Border>

                            <Popup x:Name="PART_Popup" Grid.Column="4" IsOpen="{TemplateBinding IsOpen}">
                                <Border BorderBrush="{TemplateBinding SubMenuBorderBrush}" BorderThickness="{TemplateBinding SubMenuBorderThickness}" 
                                Background="{TemplateBinding SubMenuBackground}" CornerRadius="2">
                                    <!--<Border.Effect>
                                        <DropShadowEffect
                                Color="#FF191919"
                                ShadowDepth="1"/>
                                    </Border.Effect>-->
                                    <Grid>
                                        <Rectangle RadiusX="2" RadiusY="2" Fill="#FF3A3A3A" Width="28" Margin="2" HorizontalAlignment="Left"/>
                                        <Rectangle Fill="#FF3A3A3A" Width="1" Margin="30,2,0,2" HorizontalAlignment="Left"/>
                                        <Rectangle Fill="#FF3A3A3A" Width="1" Margin="31,2,0,2" HorizontalAlignment="Left"/>
                                        <ItemsPresenter Margin="2"/>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource BlendContextMenuItemAdvStyle}" TargetType="local:ContextMenuItemAdv"/>

    <Style x:Key="BlendSeparatorAdvStyle" TargetType="local:SeparatorAdv">
        <Setter Property="Background" Value="#FF474747"/>
        <Setter Property="BorderBrush" Value="#FF474747"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Margin" Value="32,2,2,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SeparatorAdv">
                    <StackPanel>
                        <Border
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Background="{TemplateBinding Background}"
                        Height="1"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource BlendSeparatorAdvStyle}" TargetType="local:SeparatorAdv"/>

    <Style x:Key="BlendContextMenuAdvStyle" TargetType="local:ContextMenuAdv">
        <Setter Property="Background" Value="#FF3A3A3A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#FF515151"/>
        <Setter Property="SubMenuBackground" Value="#FF3A3A3A"/>
        <Setter Property="SubMenuBorderThickness" Value="1"/>
        <Setter Property="SubMenuBorderBrush" Value="#FF515151"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource BlendContextMenuItemAdvStyle}"/>
        <Setter Property="VisualStyle" Value="Blend"/>

        <Setter Property="Padding" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ContextMenuAdv">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="2">
                        <Grid>
                            <Rectangle RadiusX="2" RadiusY="2" Fill="#FF3A3A3A" Width="28" Margin="2" HorizontalAlignment="Left"/>
                            <Rectangle Fill="#FF3A3A3A" Width="1" Margin="30,2,0,2" HorizontalAlignment="Left"/>
                            <Rectangle Fill="#FF3A3A3A" Width="1" Margin="31,2,0,2" HorizontalAlignment="Left"/>
                            <ItemsPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource BlendContextMenuAdvStyle}" TargetType="local:ContextMenuAdv"/>

    <Style TargetType="rich:RichTextBoxAdv">
        <!--<Setter Property="SelectionFillColor" Value="{StaticResource SelectionFillColor}"></Setter>-->
        <Setter Property="Background" Value="{StaticResource PageViewerBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PageViewerBackgroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:RichTextBoxAdv">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Background="{TemplateBinding Background}" >
                        <local:ContextMenuAdvService.ContextMenuAdv>
                            <local:ContextMenuAdv x:Name="PART_ContextMenu" Style="{StaticResource BlendContextMenuAdvStyle}">
                                <local:ContextMenuItemAdv x:Name="PART_Cut" Header="Cut" Style="{StaticResource BlendContextMenuItemAdvStyle}" Command="{TemplateBinding CutCommand}" >
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Cut16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Copy" Header="Copy" Style="{StaticResource BlendContextMenuItemAdvStyle}" Command="{TemplateBinding CopyCommand}" >
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Copy16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Paste" Header="Paste" Style="{StaticResource BlendContextMenuItemAdvStyle}" Command="{TemplateBinding PasteCommand}" >
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Paste16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:SeparatorAdv Style="{StaticResource BlendSeparatorAdvStyle}"/>
                                <local:ContextMenuItemAdv x:Name="PART_Font" Header="Font..."  Style="{StaticResource BlendContextMenuItemAdvStyle}" Command="{TemplateBinding FontDialogCommand}">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Fontdialog.png" Width="16" Height="16" Margin="3 0 0 0" />
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Paragraph" Header="Paragraph..." Style="{StaticResource BlendContextMenuItemAdvStyle}" Command="{TemplateBinding ParagraphDialogCommand}">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Paragraphdialog.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Bullet" Header="Bullet" Style="{StaticResource BlendContextMenuItemAdvStyle}" Command="{TemplateBinding ChangeListTypeCommand}" CommandParameter="Bulleted">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Bullets16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:ContextMenuItemAdv x:Name="PART_Numbering" Header="Numbering" Style="{StaticResource BlendContextMenuItemAdvStyle}" Command="{TemplateBinding ChangeListTypeCommand}" CommandParameter="Numbered">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Numbering16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                                <local:SeparatorAdv Style="{StaticResource BlendSeparatorAdvStyle}"/>
                                <local:ContextMenuItemAdv x:Name="PART_Hyperlink" Header="Hyperlink"  Style="{StaticResource BlendContextMenuItemAdvStyle }" Command="{TemplateBinding HyperlinkDialogCommand}">
                                    <local:ContextMenuItemAdv.Icon>
                                        <Image Source="/Syncfusion.RichTextBoxAdv.Silverlight;component/Images/Hyperlink16.png" Width="16" Height="16" Margin="3 0 0 0"/>
                                    </local:ContextMenuItemAdv.Icon>
                                </local:ContextMenuItemAdv>
                            </local:ContextMenuAdv>
                        </local:ContextMenuAdvService.ContextMenuAdv>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ContentControl x:Name="content" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" Grid.Column="0"/>
                            <ScrollBar x:Name="HorizontalScrollBar" Grid.Column="0" Height="16" Visibility="Collapsed" IsTabStop="False" Minimum="0" Orientation="Horizontal" Grid.Row="1"/>
                            <ScrollBar x:Name="VerticalScrollBar" Grid.Column="1" IsTabStop="False" Visibility="Collapsed" Minimum="0" Orientation="Vertical" Grid.Row="0" Width="16"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="rich:PageLayoutViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:PageLayoutViewer">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter></ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="rich:CaretAdv">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:CaretAdv">
                    <Rectangle x:Name="rectangle" Fill="{TemplateBinding Background}"></Rectangle>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="rich:PageAdv">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="rich:PageAdv">
                    <Grid>
                        <Border x:Name="PART_shadowEfffect" Background="Black" Opacity="0.3" CornerRadius="0" BorderThickness="0">
                            <Border.Effect>
                                <BlurEffect Radius="15"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </Border.RenderTransform>
                        </Border>
                        <Border Background="White" x:Name="PART_border" CornerRadius="0" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="IBeam">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
