<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight">

    <SolidColorBrush x:Key="CalendarControlBackgroundBrushKey" Color="#FF333333"/>

    <SolidColorBrush x:Key="TextBrushKey" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="GlyphBrushKey" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="CalendarControlBorderBrushKey" Color="#FF333333"/>

    <SolidColorBrush x:Key="CalendarControlHeaderTextBrushKey" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="ScrollButtonFillKey" Color="#FF808080"/>    

    <SolidColorBrush x:Key="MouseHoverCellBackgroundKey" Color="#FF808080"/>

    <SolidColorBrush x:Key="MouseHoverScrollButtonFillKey" Color="White"/>

    <SolidColorBrush x:Key="MouseHoverCellBorderBrushKey" Color="#FF333333"/>
    <SolidColorBrush x:Key="SelectedCellBorderBrushKey" Color="#FF333333"/>
    
    <SolidColorBrush x:Key="MouseHoverCellForegroundKey" Color="White"/>
    
    <SolidColorBrush x:Key="NextMonthDaysForegroundKey" Color="Gray"/>
    <SolidColorBrush x:Key="PreviousMonthDaysForegroundKey" Color="Gray"/>

   

    <SolidColorBrush x:Key="SelectedCellBackgroundKey" Color="#FFAAAAAA"/>
    
    <SolidColorBrush x:Key="SelectedCellForegroundKey" Color="#FF333333"/>



    <Style x:Key="BlendCalendarControlStyle" TargetType="local:CalendarControl" >
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource CalendarControlBackgroundBrushKey}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CalendarControlBorderBrushKey}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="HeaderForeground" Value="{StaticResource CalendarControlHeaderTextBrushKey}"/>
        <Setter Property="MouseHoverScrollButtonFill" Value="{StaticResource MouseHoverScrollButtonFillKey}"/>
        <Setter Property="ScrollButtonFill" Value="{StaticResource ScrollButtonFillKey}"/>
        <Setter Property="HeaderBackground" Value="Transparent"/>
        <Setter Property="DayForeground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="DateForeground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="MouseHoverCellBackground" Value="{StaticResource MouseHoverCellBackgroundKey}"/>
        <Setter Property="MouseHoverCellBorderBrush" Value="{StaticResource MouseHoverCellBorderBrushKey}"/>
        <Setter Property="MouseHoverCellForeground"  Value="{StaticResource MouseHoverCellForegroundKey}"/>
        <Setter Property="NextMonthDaysForeground" Value="{StaticResource NextMonthDaysForegroundKey}"/>
        <Setter Property="PreviousMonthDaysForeground" Value="{StaticResource PreviousMonthDaysForegroundKey}"/>
        <Setter Property="SelectedCellBackground" Value="{StaticResource SelectedCellBackgroundKey}"/>
        <Setter Property="SelectedCellBorderBrush" Value="{StaticResource SelectedCellBorderBrushKey}"/>
        <Setter Property="SelectedCellForeground" Value="{StaticResource SelectedCellForegroundKey}"/>
    <Setter Property="Padding" Value="2" /> 
    </Style>
   
    <Style TargetType="local:CalendarControl" BasedOn="{StaticResource BlendCalendarControlStyle}"/>


</ResourceDictionary>
