<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
 xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight">
   
    <!-- Brushes -->   

    <LinearGradientBrush x:Key="PressedBrushKey" StartPoint="0.726314,-0.00145453" EndPoint="0.726314,0.940256">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFE87F03" Offset="0"/>
            <GradientStop Color="#FFEFAC3E" Offset="0.528754"/>
            <GradientStop Color="#FFF7D979" Offset="0.990868"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PressedBorderBrushKey" Color="#6E6F73"/>

    <SolidColorBrush x:Key="ButtonMouseOverBorderBrushKey" Color="#FFB79E73"/>  

    <LinearGradientBrush x:Key="SelectedBrushKey" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFED498" Offset="0"/>
        <GradientStop Color="#FFFECD86" Offset="0.4"/>
        <GradientStop Color="#FFFDB759" Offset="0.4"/>
        <GradientStop Color="#FFFDEB9F" Offset="1"/>
    </LinearGradientBrush>

    <!-- DateTimeEdit -->

    <SolidColorBrush x:Key="DateTimeEditMouseOverBrushKey" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="DateTimeEditCaretBackgroundBrushKey" Color="Black"/>

    <SolidColorBrush x:Key="DateTimeEditBackgroundBrushKey" Color="#FFF5F6F7"/>
    <SolidColorBrush x:Key="DateTimeEditBorderBrushKey" Color="#929396"/>



    <SolidColorBrush x:Key="DisabledBackgroundBrushKey" Color="#FF666666"/>

    <SolidColorBrush x:Key="FocusedBorderBrushKey" Color="#FF808080"/>


    <!-- Button -->

    <SolidColorBrush x:Key="ButtonBorderBrushKey" Color="#FF6E6F73"/>    

    <LinearGradientBrush x:Key="ButtonMouseOverBrushKey" StartPoint="0.63454,0.0262204" EndPoint="0.63454,0.934904">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFEFEDC" Offset="0"/>
            <GradientStop Color="#FFFADF9D" Offset="0.528754"/>
            <GradientStop Color="#FFF7C15E" Offset="0.990868"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonBackgroundBrushKey" StartPoint="0.466664,1.03887" EndPoint="0.466664,-0.00453544">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFF1F3F4" Offset="0.00904159"/>
            <GradientStop Color="#FFF8F9F9" Offset="0.532971"/>
            <GradientStop Color="#FFFFFFFF" Offset="0.990868"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>   

    <SolidColorBrush x:Key="CalendarControlBackgroundBrushKey" Color="#FF333333"/>

    <SolidColorBrush x:Key="TextBrushKey" Color="Black"/>

    <SolidColorBrush x:Key="GlyphBrushKey" Color="#5F6469"/>

    <SolidColorBrush x:Key="CalendarControlBorderBrushKey" Color="#FF333333"/>

    <SolidColorBrush x:Key="CalendarControlHeaderTextBrushKey" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="ScrollButtonFillKey" Color="#FF595959"/>

    <SolidColorBrush x:Key="MouseHoverCellBackgroundKey" Color="#FF808080"/>

    <SolidColorBrush x:Key="MouseHoverScrollButtonFillKey" Color="#FF808080"/>

    <SolidColorBrush x:Key="MouseHoverCellBorderBrushKey" Color="#FF333333"/>
    <SolidColorBrush x:Key="SelectedCellBorderBrushKey" Color="#FF333333"/>

    <SolidColorBrush x:Key="MouseHoverCellForegroundKey" Color="#FF333333"/>

    <SolidColorBrush x:Key="NextMonthDaysForegroundKey" Color="Gray"/>
    <SolidColorBrush x:Key="PreviousMonthDaysForegroundKey" Color="Gray"/>

    <SolidColorBrush x:Key="SelectedCellBackgroundKey" Color="#FFAAAAAA"/>

    <SolidColorBrush x:Key="SelectedCellForegroundKey" Color="#FF333333"/>

    <!-- Styles -->

    <Style x:Key="Office2007SilverCalendarControlStyle" TargetType="local:CalendarControl" >
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource CalendarControlBackgroundBrushKey}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CalendarControlBorderBrushKey}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="HeaderForeground" Value="{StaticResource CalendarControlHeaderTextBrushKey}"/>
        <Setter Property="MouseHoverScrollButtonFill" Value="{StaticResource MouseHoverScrollButtonFillKey}"/>
        <Setter Property="ScrollButtonFill" Value="{StaticResource ScrollButtonFillKey}"/>
        <Setter Property="HeaderBackground" Value="Transparent"/>
        <Setter Property="DayForeground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="DateForeground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="MouseHoverCellBackground" Value="{StaticResource MouseHoverCellBackgroundKey}"/>
        <Setter Property="MouseHoverCellBorderBrush" Value="{StaticResource MouseHoverCellBorderBrushKey}"/>
        <Setter Property="MouseHoverCellForeground" Value="{StaticResource MouseHoverCellForegroundKey}"/>
        <Setter Property="NextMonthDaysForeground" Value="{StaticResource NextMonthDaysForegroundKey}"/>
        <Setter Property="PreviousMonthDaysForeground" Value="{StaticResource PreviousMonthDaysForegroundKey}"/>
        <Setter Property="SelectedCellBackground" Value="{StaticResource SelectedCellBackgroundKey}"/>
        <Setter Property="SelectedCellBorderBrush" Value="{StaticResource SelectedCellBorderBrushKey}"/>
        <Setter Property="SelectedCellForeground" Value="{StaticResource SelectedCellForegroundKey}"/>
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style TargetType="local:CalendarControl" BasedOn="{StaticResource Office2007SilverCalendarControlStyle}"/>

    <Style x:Key="BrushEditToggleButtonStyle1" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrushKey}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrushKey}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonMouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonMouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PressedBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PressedBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".55"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SelectedBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Background" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid >
                                <Rectangle x:Name="BackgroundGradient" Fill="{TemplateBinding Background}"/>
                            </Grid>
                        </Border>

                        <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        <Rectangle x:Name="DisabledVisualElement" Fill="{StaticResource DisabledBackgroundBrushKey}" RadiusX="3" RadiusY="3" IsHitTestVisible="false" Opacity="0"/>
                        <Rectangle x:Name="FocusVisualElement" Stroke="{StaticResource FocusedBorderBrushKey}" StrokeThickness="1" Margin="1" IsHitTestVisible="false" Opacity="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>
