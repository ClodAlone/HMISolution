        <GradientStop Color="#FFBE7360" Offset="0.85"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WindowBackground" Color="#D9FFFFFF"/>

    <SolidColorBrush x:Key="WindowBorderBrush" Color="#7F000000" />

    <LinearGradientBrush x:Key="WindowHeaderBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7FFFFFFF" Offset="0.008"/>
        <GradientStop Color="#7FFFFFFF" Offset="0.487"/>
        <GradientStop Color="#7F808080" Offset="0.531"/>
        <GradientStop Color="#7F979797" Offset="0.788"/>
        <GradientStop Color="#7FD2D2D2" Offset="0.994"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="OverflowPopupBackground" Color="#E5FFFFFF"/>

    <SolidColorBrush x:Key="OverflowPopupBorderBrush" Color="#99000000"/>

    <LinearGradientBrush x:Key="MouseOverBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="1"/>
        <GradientStop Color="#7EE5E5E5" Offset="0.968"/>
        <GradientStop Color="#A5FFFFFF" Offset="0.504"/>
        <GradientStop Color="White"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="MouseOverBorderBrush" Color="#99000000"/>

    <LinearGradientBrush x:Key="OverflowButtonCheckedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#A5FFFFFF" Offset="0.008"/>
        <GradientStop Color="#CFFFFFFF" Offset="0.487"/>
        <GradientStop Color="#72C2C2C2" Offset="0.531"/>
        <GradientStop Color="#A7FFFFFF" Offset="0.788"/>
        <GradientStop Color="#B2FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="OverflowButtonCheckedBorderBrush" Color="#99000000"/>

    <LinearGradientBrush x:Key="ToolBarBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#7FBEBEBE" Offset="1"/>
        <GradientStop Color="#99FFFFFF"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ToolBarBorderBrush" Color="#99000000"/>

    <SolidColorBrush x:Key="ToolBarForeground" Color="#FF000000"/>

    <SolidColorBrush x:Key="DropDownButtonAdvBackground" Color="#7EFFFFFF"/>

    <SolidColorBrush x:Key="DropDownButtonAdvBorderBrush" Color="#99000000"/>
    
    <LinearGradientBrush x:Key="HeaderButton_FillBrush" EndPoint="0.5,1" StartPoint="0.5,0">
