    xmlns:tools="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight">
    <tools:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    
    <!-- Brushes -->

