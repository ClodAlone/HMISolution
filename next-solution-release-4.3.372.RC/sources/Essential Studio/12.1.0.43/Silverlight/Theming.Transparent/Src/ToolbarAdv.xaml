    <SolidColorBrush x:Key="ButtonCheckedBorderBrush" Color="#99000000"/>

    <SolidColorBrush x:Key="FocusedBorderBrushKey" Color="#FFE5C365"/>
    
    <SolidColorBrush x:Key="DisabledBackgroundBrushKey" Color="#FFFFFFFF"/>

    <LinearGradientBrush x:Key="DropDownMouseOverBrush" Opacity="0.4" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFAFAFA" Offset="0"/>
        <GradientStop Color="White" Offset="0.491"/>
        <GradientStop Color="#FFC8C8C8" Offset="0.531"/>
        <GradientStop Color="#FFB6B6B6" Offset="0.789"/>
        <GradientStop Color="#FFD5D5D5" Offset="0.996"/>
