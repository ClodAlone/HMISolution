                                            <data:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Height="27" Tag="{Binding Path=FileName}" Command="{Binding RemoveUploadCommand}"  Style="{StaticResource FileUploadButtonStyle1}"  Width="27" Cursor="Hand" >
                                                        <Button.Content>
                                                            <Canvas Margin="-10">
                                                                <Canvas>
                                                                    <Canvas>
                                                                        <Path Data="F1 M 9.000000,0.161133 C 13.879883,0.161133 17.836914,4.119141 17.836914,9.003906 C 17.836914,13.880859 13.879883,17.838867 9.000000,17.838867 C 4.116211,17.838867 0.155273,13.880859 0.155273,9.003906 C 0.155273,4.119141 4.116211,0.161133 9.000000,0.161133 Z">
