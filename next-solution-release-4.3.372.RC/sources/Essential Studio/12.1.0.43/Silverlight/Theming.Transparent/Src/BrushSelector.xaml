<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
     xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
     xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
     xmlns:Editors="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="BrushEdit.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Brushes -->

   


    <!-- Style -->
    <LinearGradientBrush x:Key="ButtonMouseOverBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFF9E9" Offset="0.104"/>
        <GradientStop Color="#FFFFF3CF" Offset="0.485"/>
        <GradientStop Color="#FFFFECB5" Offset="0.492"/>
        <GradientStop Color="#FFFFECB5" Offset="0.986"/>
        <GradientStop Color="#FFE5C365" Offset="0.993"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TextBoxMouseOverBorderBrushKey" Color="#FFE5C365"/>
    <SolidColorBrush x:Key="AutoCompleteBorderBrushKey" Color="#FF8591A2"/>
    <SolidColorBrush x:Key="ButtonCheckedBackground" Color="#FFFFE8A6"/>
    <SolidColorBrush x:Key="TransparentColorPickerBackground" Color="#FFF4F4F5" Opacity="0.60"/>

    <SolidColorBrush x:Key="TransparentColorPickerBorderBrush" Color="#FF000000" Opacity="0.60"/>
    <SolidColorBrush x:Key="TransparentColorPickerInnerBorderBrush" Color="White"  Opacity="0.90"/>
    <SolidColorBrush x:Key="TransparentColorPickerForeground" Color="#FF000000"/>
    <Style x:Key="VS2010BrushSelectorStyle" TargetType="local:BrushSelector" >
        <Setter Property="Background" Value="{StaticResource TransparentColorPickerBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource TransparentColorPickerBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:BrushSelector">
                    <Border  Margin="0">
                        <Grid Width="{TemplateBinding Width}" MaxHeight="25" x:Name="MainGrid">
                            <Grid.Resources>
                                <LinearGradientBrush x:Key="TransparentToggleButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.3">
                                    <GradientStop Color="#FFF6F2ED" Offset="0"/>
                                    <GradientStop Color="#FFEDE3D6" Offset="0.253"/>
                                    <GradientStop Color="#FFC6C6C6" Offset="0.483"/>
                                    <GradientStop Color="#FF8B8B8B" Offset="0.513"/>
                                    <GradientStop Color="#FFBABABA" Offset="1"/>
                                    <GradientStop Color="White" Offset="1"/>
                                </LinearGradientBrush>

                                

                                <SolidColorBrush x:Key="TransparentToggleButtonBorderBrush" Color="#FF000000" Opacity="0.60"/>

                                <SolidColorBrush x:Key="TransparentToggleButtonForeground" Color="#FF000000"/>

                                <LinearGradientBrush x:Key="TransparentToggleButtonSelectedBackground"  EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.60">
                                    <GradientStop Color="#FF838383" Offset="1"/>
                                    <GradientStop Color="#FFEDE3D6" Offset="0.747"/>
                                    <GradientStop Color="#FFC6C6C6" Offset="0.517"/>
                                    <GradientStop Color="#FFCCCCCC" Offset="0.487"/>
                                    <GradientStop Color="#FF313131" Offset="0.01"/>
                                    <GradientStop Color="White"/>
                                </LinearGradientBrush>

                                <SolidColorBrush x:Key="TransparentToggleButtonSelectedBorderBrush" Color="#FF000000" Opacity="0.60"/>

                                <LinearGradientBrush x:Key="TransparentToggleButtonMouseOverBackground"  EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.60">
                                    <GradientStop Color="#FFF6F2ED" Offset="0.277"/>
                                    <GradientStop Color="#FF8B8B8B" Offset="0.6"/>
                                    <GradientStop Color="#FFBABABA" Offset="1"/>
                                </LinearGradientBrush>

                                <SolidColorBrush x:Key="TransparentToggleButtonMouseOverBorderBrush" Color="#FF000000" Opacity="0.60"/>

                                <SolidColorBrush x:Key="TransparentToggleButtonArrowBrush" Color="#FF000000"/>
                                <SolidColorBrush Color="White" Opacity="0.70" x:Key="TransparentButtonInnerBorderBrush"/>
                                <Style x:Key="TransparentToggleButtonStyle" TargetType="ToggleButton">
                               
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal"/>
                                                            <VisualState x:Name="MouseOver">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ToggleGradient" Storyboard.TargetProperty="Background">
                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentToggleButtonMouseOverBackground}"/>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                   
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ToggleGradient" Storyboard.TargetProperty="Background">
                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentToggleButtonSelectedBackground}"/>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                   
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Disabled">
                                                                <Storyboard>
                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="Opacity">
                                                                        <SplineDoubleKeyFrame KeyTime="0" Value=".55"/>
                                                                    </DoubleAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                        <VisualStateGroup x:Name="CheckStates">
                                                            <VisualState x:Name="Checked">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ToggleGradient" Storyboard.TargetProperty="Background">
                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentToggleButtonSelectedBackground}"/>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                   
                                                                </Storyboard>
                                                                <!--<Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ToggleGradient" Storyboard.TargetProperty="Background">
                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroBrush}"/>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="pathArrow" Storyboard.TargetProperty="Fill">
                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="pathArrow" Storyboard.TargetProperty="Stroke">
                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>-->
                                                            </VisualState>
                                                            <VisualState x:Name="Unchecked"/>
                                                        </VisualStateGroup>
                                                        <VisualStateGroup x:Name="FocusStates">
                                                            <VisualState x:Name="Focused">
                                                                <Storyboard>
                                                                    <!--<DoubleAnimationUsingKeyFrames Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="Opacity">
                                                                        <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                                                    </DoubleAnimationUsingKeyFrames>-->
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Unfocused"/>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <Border x:Name="Background" Background="{TemplateBinding Background}" CornerRadius="0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                        <Border BorderBrush="{StaticResource TransparentColorPickerInnerBorderBrush}" BorderThickness="1">
                                                        <Grid >
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="9*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="1" x:Name="ToggleGradient" Background="{StaticResource  TransparentToggleButtonBackground}" BorderBrush="{StaticResource TransparentColorPickerBorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Margin="0,-2,-2,-2">
                                                                    <Border BorderBrush="{StaticResource TransparentColorPickerInnerBorderBrush}" BorderThickness="1"/>
                                                                    </Border>
                                                                   
                                                            <!--<Path x:Name="pathArrow" Stretch="Fill" Height="4" HorizontalAlignment="Center" Grid.Column="1" VerticalAlignment="Center" Width="7" UseLayoutRounding="False" Fill="{StaticResource MetroForegroundBrush}" Stroke="{StaticResource MetroForegroundBrush}" Data="M-136,132 L-122,132 L-129,141 z">
                                                            </Path>-->
                                                            <Path x:Name="pathArrow" Data="M 0 0 L 3.5 4 L 7 0 Z" Fill="{TemplateBinding Foreground}" Margin="1,0,0,0" Grid.Column="1" HorizontalAlignment="Center" Height="4" Stretch="Uniform" Width="8">
                                                            </Path>
                                                        </Grid>
                                                        </Border>
                                                    </Border>
                                                    <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Left" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                  
                                                    <Rectangle x:Name="FocusVisualElement" Stroke="White" StrokeThickness="1" RadiusX="0" RadiusY="0" Margin="0" IsHitTestVisible="false" Opacity="0"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>
                            <ToggleButton  BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Grid.Column="2" x:Name="colorToggleButton" Style="{StaticResource TransparentToggleButtonStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" >
                                    <Rectangle Name="selectedColorRect" HorizontalAlignment="Left"  Fill="{TemplateBinding SelectedBrush}" Width="20" Height="20" Margin="1"/>
                                    <TextBlock  Name="colortext" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <Popup HorizontalOffset="-2" Margin="0,5,0,0" VerticalOffset="20" Name="BrushEditPopup" IsOpen="{Binding ElementName=colorToggleButton, Path=IsChecked}">
                                <Canvas x:Name="OutsideCanvas">
                                    <Canvas x:Name="OutsidePopupCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    <local:BrushEdit Name="BrushEdit"  MinWidth="250" VisualizationStyle="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VisualizationStyle,Mode=TwoWay}" EnableGradientToSolidSwitch="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=EnableGradientToSolidSwitch,Mode=TwoWay}" SelectedBrush="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedBrush,Mode=TwoWay}" BrushMode="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BrushMode,Mode=TwoWay}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
                                </Canvas>
                            </Popup>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:BrushSelector" BasedOn="{StaticResource VS2010BrushSelectorStyle}"/>


</ResourceDictionary>
