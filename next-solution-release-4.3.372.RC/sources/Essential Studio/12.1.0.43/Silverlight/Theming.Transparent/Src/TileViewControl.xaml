<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlsToolkit="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.Silverlight"
    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"  
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight" 
            xmlns:resources="clr-namespace:Syncfusion.Windows.Shared.Resources;assembly=Syncfusion.Shared.Silverlight"
	    	      >
    <SolidColorBrush Color="#80FFFFFF" x:Key="TransaperentTileViewControlBackgroundBrush"/>
    <SolidColorBrush Color="#80FFFFFF" x:Key="TransparentTileViewItemBackgroundBrush"/>
    <SolidColorBrush Color="#7F000000" x:Key="TransparentTileViewItemBorderBrush"/>
    <SolidColorBrush Color="Black" x:Key="TransparentTileViewForegroundBrush"/>
    <LinearGradientBrush Opacity="0.6" x:Key="TransparentTileViewItemHeaderBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF4F4F4" Offset="0.062"/>
        <GradientStop Color="Gainsboro" Offset="0.49"/>
        <GradientStop Color="#FFA5A5A5" Offset="0.53"/>
        <GradientStop Color="#FFB4B4B4" Offset="0.79"/>
        <GradientStop Color="#FFD2D2D2" Offset="0.995"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#7F000000" x:Key="TransparentTileViewItemHeaderBorderBrush"/>
    <SolidColorBrush x:Key="MinMaxButtonBorderBrush" Color="#FFABBAD0"/>
    <SolidColorBrush x:Key="MinMaxButtonPathBrush" Color="#FF1E395B" />
    
    <SolidColorBrush x:Key="TransparentInnerBorderBrush" Color="#CCFFFFFF" />

    <Style x:Key="TileViewCloseButtonStyle" TargetType="Button">
        <Setter Property="IsEnabled" Value="true"/>
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="2"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="Focused"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>                                        
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="path" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                        </ObjectAnimationUsingKeyFrames>                                      
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>                                        
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="path" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled"/>
                                <VisualState x:Name="Normal"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Name="OuterBorder" VerticalAlignment="Center" Height="19"  HorizontalAlignment="Center" Margin="0,3,8,-1" Background="Transparent" BorderBrush="Transparent" Width="20" BorderThickness="1" CornerRadius="0">
                            <Canvas Width="15" Height="12" HorizontalAlignment="Center" Margin="5,0,0,0">
                                <Path x:Name="path" Stretch="Fill" Data="F1 M 330.03,-219.979L 345.605,-219.979L 345.605,-235.894L 361.206,-235.894L 361.206,-251.804L 376.781,-251.804L 376.781,-267.071L 329.995,-267.071L 329.995,-251.804L 314.42,-251.804L 314.42,-235.894L 298.854,-235.894L 298.854,-251.804L 283.244,-251.804L 283.244,-267.071L 236.458,-267.071L 236.458,-251.804L 252.06,-251.804L 252.06,-235.894L 267.635,-235.894L 267.635,-219.979L 283.244,-219.979L 283.244,-204.066L 283.244,-189.447L 267.635,-189.447L 267.635,-173.533L 252.06,-173.533L 252.06,-157.619L 236.458,-157.619L 236.458,-141.709L 283.244,-141.709L 283.244,-157.619L 298.854,-157.619L 298.854,-173.533L 314.42,-173.533L 314.42,-157.619L 329.995,-157.619L 329.995,-141.709L 376.781,-141.709L 376.781,-157.619L 361.206,-157.619L 361.206,-173.533L 345.605,-173.533L 345.605,-189.447L 330.03,-189.447L 330.03,-204.066L 330.03,-219.979 Z "  Width="10" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="Black" StrokeThickness="0.6" Fill="#FFDADEE1"/>
                            </Canvas>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>     
   
    <Style TargetType="ToggleButton" x:Key="TileViewMinMaxButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MinMaxButtonPathBrush}"/>
        <Setter Property="BorderBrush"  Value="{StaticResource MinMaxButtonBorderBrush}"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Width" Value="35" />
        <Setter Property="Height" Value="20" />
        <Setter Property="IsChecked" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="1"/>        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal">                                   
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="maxHoverButton" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="maxButton" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>                                      
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="maxpath5" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="maxpath2" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="maxHoverButton" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="maxButton" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>                                      
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="maxpath5" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="maxpath2" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFFFFF"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CheckStates">
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="minButton" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="outergrid" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>                                       
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="maxButton" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="minButton" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="maxHoverButton" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="outerBorder" Background="Transparent"    BorderBrush="Transparent" Width="25" Height="19" BorderThickness="1" CornerRadius="0" Margin="0,2,0,-1">
                            <Canvas Margin="2,4,0,0">
                                <Grid x:Name="outergrid">
                                <Canvas HorizontalAlignment="Center" Name="maxButton" Height="15" VerticalAlignment="Center" Width="21" Margin="4,0,0,0">
