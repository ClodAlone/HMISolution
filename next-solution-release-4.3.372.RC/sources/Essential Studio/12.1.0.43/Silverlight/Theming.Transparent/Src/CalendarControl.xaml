<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight">    

    <SolidColorBrush x:Key="ForegroundBrush" Color="Black"/>    
    <SolidColorBrush x:Key="CalendarControlBackgroundBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="MonthPopupBackground" Color="#E5FFFFFF"/>    
    <SolidColorBrush Color="#7F000000" x:Key="CalendarControlBorderBrush"/>
    <SolidColorBrush Color="#7F000000" x:Key="MonthPopupBorderBrush"/>   
    <SolidColorBrush Color="Black" Opacity="0.5"  x:Key="TransparentThemeCalendarEditNotCurrentMonthForegroundBrush"/>
    <LinearGradientBrush Opacity="0.395" x:Key="TransparentThemeCalendarEditCellsHoverBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE2E2E2" Offset="1"/>
        <GradientStop Color="#FFFEFEFE" Offset="0.846"/>
        <GradientStop Color="#FFDFDFDF" Offset="0.486"/>
        <GradientStop Color="#FF4D4D4D" Offset="0.055"/>
        <GradientStop Color="#FFF9F9F9"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FF494949" Opacity="0.395" x:Key="TransparentThemeCalendarEditCellsHoverBorderBrush"/>
    <LinearGradientBrush EndPoint="0.5,1" x:Key="TransparentThemeCalendarEditCellSelectedBrush" Opacity="0.395" StartPoint="0.5,0">
        <GradientStop Color="#FFE2E2E2"/>
        <GradientStop Color="#FFFEFEFE" Offset="0.154"/>
        <GradientStop Color="#FFDFDFDF" Offset="0.514"/>
        <GradientStop Color="#FF4D4D4D" Offset="0.945"/>
        <GradientStop Color="#FFF9F9F9" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FF494949" Opacity="0.395" x:Key="TransparentThemeCalendarEditCellSelectedBorderBrush"/>
    <SolidColorBrush Color="#FF232323" Opacity="0.55" x:Key="TransparentThemeCalendarEditTodayCellBorderBrush"/>
    
    <SolidColorBrush x:Key="TransparentInnerBorderBrush" Color="#CCFFFFFF"/>
    
    <Style x:Key="TransparentCalendarControlStyle" TargetType="local:CalendarControl" >
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource CalendarControlBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CalendarControlBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="DayForeground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="DateForeground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="HeaderForeground" Value="{StaticResource ForegroundBrush}"/>

        <Setter Property="MouseHoverScrollButtonFill" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="ScrollButtonFill" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="HeaderBackground" Value="Transparent"/>

        <Setter Property="MouseHoverCellBackground" Value="{StaticResource TransparentThemeCalendarEditCellsHoverBackgroundBrush}"/>
        <Setter Property="MouseHoverCellBorderBrush" Value="{StaticResource TransparentThemeCalendarEditCellsHoverBorderBrush}"/>
        <Setter Property="MouseHoverCellForeground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="MouseHoverCellCornerRadius" Value="0"/>

        <Setter Property="NextMonthDaysForeground" Value="{StaticResource TransparentThemeCalendarEditNotCurrentMonthForegroundBrush}"/>
        <Setter Property="PreviousMonthDaysForeground" Value="{StaticResource TransparentThemeCalendarEditNotCurrentMonthForegroundBrush}"/>

        <Setter Property="SelectedCellBackground" Value="{StaticResource TransparentThemeCalendarEditCellSelectedBrush}"/>
        <Setter Property="SelectedCellBorderBrush" Value="{StaticResource TransparentThemeCalendarEditCellSelectedBorderBrush}"/>
        <Setter Property="SelectedCellForeground" Value="{StaticResource ForegroundBrush}"/>
        <Setter Property="SelectedCellCornerRadius" Value="0"/>
        <Setter Property="Padding" Value="2" />

        <!--<Setter Property="MonthPopupBackground" Value="{StaticResource MonthPopupBackground}"/>
        <Setter Property="MonthPopupBorderBrush" Value="{StaticResource MonthPopupBorderBrush}"/>-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CalendarControl">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Border BorderBrush="{StaticResource TransparentInnerBorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid x:Name="RootElement" Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition  Height="25" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="25" />
                            </Grid.ColumnDefinitions>
                            <Border Margin="0,0,-2,0" Background="{TemplateBinding HeaderBackground}" Grid.Column="0" Grid.Row="0">
                                <Grid>
                                    <Ellipse 
                                     Width="19"
                                     Height="19"
                                     Stroke="{StaticResource ForegroundBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="Transparent"/>
                                        <Ellipse 
                                     Width="17"
                                     Height="17"
                                     Stroke="{StaticResource TransparentInnerBorderBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="Transparent"/>
                                        <Polygon x:Name="Previous" Margin="0,-2,0,0" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Points="-1,8 5,3 5,13 -1,8" Fill="{TemplateBinding ScrollButtonFill}" Stroke="{StaticResource TransparentInnerBorderBrush}" StrokeThickness="0.5"/>
                                </Grid>
                            </Border>
                            <Border Background="{TemplateBinding HeaderBackground}" Grid.Column="1" Grid.Row="0">
                                    <TextBlock x:Name="MonthText" Grid.Column="1" Foreground="{TemplateBinding HeaderForeground}" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                         <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.35"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                            </Border>
                            <Border Margin="-2,0,-2,0" Background="{TemplateBinding HeaderBackground}" Grid.Column="2" Grid.Row="0">
                                <Grid>
                                    <Ellipse 
                                     Width="19"
                                     Height="19"
                                     Stroke="{StaticResource ForegroundBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="Transparent"/>
                                        <Ellipse 
                                     Width="17"
                                     Height="17"
                                     Stroke="{StaticResource TransparentInnerBorderBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="Transparent"/>
                                     <Polygon x:Name="Next" Grid.Column="2" Margin="0,0,3,2" Grid.Row="0" HorizontalAlignment="Center"  Points="9,9 3,3 3,13 9,9" VerticalAlignment="Center" Fill="{TemplateBinding ScrollButtonFill}" StrokeThickness="1"/>
                                </Grid>
                            </Border>
                            <Grid x:Name="weekGrid" Grid.Column="0" Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <Grid x:Name="DateGrid" ShowGridLines="True" Grid.ColumnSpan="3" Grid.Column="1" Grid.Row="1">
                            </Grid>
                            <StackPanel Margin="2" Grid.ColumnSpan="3" Background="{TemplateBinding HeaderBackground}" Grid.Column="0" Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock x:Name="TodayDatebtn"  Grid.Column="0" Grid.Row="2" Text="  Today: " Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                         <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.35"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                <TextBlock x:Name="TodayDate" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                     <TextBlock.Effect>
                                          <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.35"/>
                                     </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:CalendarControl" BasedOn="{StaticResource TransparentCalendarControlStyle}"/>
</ResourceDictionary>
