    <Style TargetType="local:QATDropDownControl" x:Key="QATDropDownControlKey">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:QATDropDownControl">
                    <Grid Background="Transparent">
                        <Grid.Resources>
                            <LinearGradientBrush x:Key="RibbonMenuBottomBrush" EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FFDEE7EE" Offset="0.278"/>
                                <GradientStop Color="#FF9ECEF9" Offset="0.389"/>
                                <GradientStop Color="#FF3771AB" Offset="0.778"/>
                                <GradientStop Color="#FF569FE5" Offset="0.889"/>
                                <GradientStop Color="#FF3D5DE4" Offset="0.994"/>
                            </LinearGradientBrush>
                            <SolidColorBrush Color="#7F000000" x:Key="TransparentThemeMenuPopupBorderBrush" />
                            <SolidColorBrush Color="White" x:Key="TransparentThemeMenuPopupLeftBarBackground" Opacity="0.6"/>

                            <SolidColorBrush Color="#EFFFFFFF"  x:Key="TransparentThemeMenuPopupBackgroundBrush"/>
                            <SolidColorBrush Color="Black"  x:Key="TransparentForegroundBrush"/>
                            <LinearGradientBrush x:Key="TransparentMenuGroupHeaderBackground" EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.6">
                                <GradientStop Color="#FFFAFAFA" Offset="0"/>
                                <GradientStop Color="#FFC8C8C8" Offset="0.491"/>
                                <GradientStop Color="#FF999999" Offset="0.531"/>
                                <GradientStop Color="#FFB6B6B6" Offset="0.789"/>
                                <GradientStop Color="#FFD5D5D5" Offset="0.996"/>
                            </LinearGradientBrush>
                            <SolidColorBrush x:Key="TransparentGroupHeaderBorderBrush" Color="#7F000000" />
                            <Style TargetType="local:RibbonMenuGroup" >

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="local:RibbonMenuGroup">
                                            <Grid Name="gri">
                                                <Grid.Resources>
                                                    <local:TextToVisibilityConverter x:Key="TextConverter"/>
                                                    <local:BooleanToVisibilityConverter x:Key="BoolConverter"/>
                                                    <local:VisibilityToThicknessConverter x:Key="ThicknessConverter"/>
                                                </Grid.Resources>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Background="{StaticResource TransparentMenuGroupHeaderBackground}" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource TextConverter}}" Height="22" Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource TransparentThemeMenuPopupBorderBrush}">
                                                    <ContentControl Content="{TemplateBinding Header}" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource TransparentForegroundBrush}" Margin="5,0,0,0" HorizontalContentAlignment="Left">
                                                        <ContentControl.Effect>
                                                            <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="#03FFFFFF" Opacity="0.5"/>
                                                        </ContentControl.Effect>
                                                    </ContentControl>
                                                </Border>
                                                <Border Grid.Row="1" Background="Transparent" >
                                                    <Grid>
                                                        <Border x:Name="IconTray" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IconBarEnabled, Converter={StaticResource BoolConverter}}"  Background="{StaticResource TransparentThemeMenuPopupLeftBarBackground}"  Width="30" HorizontalAlignment="Left"/>
                                                        <Border>
                                                            <ScrollViewer TabNavigation="Cycle" Padding="-1" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}" BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ScrollBarVisibility, Converter={StaticResource ThicknessConverter} }">
                                                                <ItemsPresenter/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Row="2">
                                                    <Grid>
                                                        <Border BorderBrush="#CCFFFFFF" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMoreItemsIconTrayEnabled, Converter={StaticResource BoolConverter} }" Background="#FFFFFFFF" BorderThickness="0,0,2,0" Width="28" HorizontalAlignment="Left"/>
                                                        <ItemsControl ItemsSource="{TemplateBinding MoreItems}"/>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Row="3" Background="{StaticResource RibbonMenuBottomBrush}" Width="{Binding ElementName=PART_ResizeThumb, Path=ActualWidth}" HorizontalAlignment="Stretch" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsResizable, Converter={StaticResource BoolConverter}}">
                                                    <Grid>
                                                        <Border HorizontalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Background="#FF849DBD" CornerRadius="2" Height="3" Width="3"/>

                                                                <Border  Background="#FF849DBD" CornerRadius="2"  Height="3" Width="3" Margin="-5,0,0,0"/>
                                                                <Border Background="#FF849DBD" CornerRadius="2" Height="3" Width="3" Margin="3,0,0,0"/>

                                                                <Border  Background="#FF849DBD" CornerRadius="2"  Height="3" Width="3"  Margin="-5,0,0,0"/>
                                                                <Border Background="#FF849DBD" CornerRadius="2" Height="3" Width="3" Margin="3,0,0,0"/>
                                                                <Border  Background="#FF849DBD" CornerRadius="2"  Height="3" Width="3"  Margin="-5,0,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Thumb x:Name="PART_ResizeThumb" Opacity="0" Cursor="SizeNS"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            
                            <LinearGradientBrush x:Key="RibbonItemMouseOverBrush" EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#99FAFAFA" Offset="0"/>
                                <GradientStop Color="#99FFFFFF" Offset="0.491"/>
                                <GradientStop Color="#99E2E2E2" Offset="0.531"/>
                                <GradientStop Color="#99B6B6B6" Offset="0.789"/>
                                <GradientStop Color="#99D5D5D5" Offset="0.996"/>
                            </LinearGradientBrush>
                            <SolidColorBrush x:Key="RibbonItemBorderBrush" Color="#FFF9D56A" />

                            <SolidColorBrush x:Key="ButtonHoverOuterBackgroundBrush" Color="#FFFFFFFF"/>

                            <SolidColorBrush  x:Key="ButtonHoverOuterBorderBrush" Color="#FFF7C840"/>

                            <LinearGradientBrush x:Key="ButtonHoverInnerBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FFFFEB9C" Offset="0.036"/>
                                <GradientStop Color="#FFFFE279" Offset="0.308"/>
                                <GradientStop Color="#FFFFE585" Offset="0.574"/>
                                <GradientStop Color="#FFFFEEA4" Offset="0.638"/>
                                <GradientStop Color="#FFFFFCE0" Offset="0.955"/>
                            </LinearGradientBrush>

                            <SolidColorBrush  x:Key="ButtonHoverInnerBorderBrush" Color="#FFFEFEFE"/>

                            <SolidColorBrush x:Key="ButtonSelectedHoverInnerBorderBrush" Color="#FFFFF7CE"/>


                            <LinearGradientBrush x:Key="ButtonSelectedBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FFFFEC79" Offset="0.028"/>
                                <GradientStop Color="#FFFFD86B" Offset="0.428"/>
                                <GradientStop Color="#FFFFE072" Offset="0.917"/>
                            </LinearGradientBrush>

                            <SolidColorBrush x:Key="ButtonPressedOuterBackgroundBrush" Color="#FFF6C867"/>
                            <LinearGradientBrush x:Key="ButtonPressedOuterBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FFC09467" Offset="0.005"/>
                                <GradientStop Color="#FFC2792C" Offset="0.011"/>
                                <GradientStop Color="#FFC29B45" Offset="0.995"/>
                                <GradientStop Color="#FFBFA976" Offset="1"/>
                            </LinearGradientBrush>

                            <LinearGradientBrush x:Key="ButtonPressedInnerBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FFFDDD81" Offset="0.054"/>
                                <GradientStop Color="#FFFEE287" Offset="0.984"/>
                                <GradientStop Color="#FFFAD77A" Offset="0.989"/>
                            </LinearGradientBrush>

                            <SolidColorBrush  x:Key="ButtonPressedInnerBorderBrush" Color="#FFF6C867"/>

                            <LinearGradientBrush x:Key="TransparentThemeRibbonMenuItemHoverBrush" Opacity="0.4" EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FFFAFAFA" Offset="0"/>
                                <GradientStop Color="White" Offset="0.491"/>
                                <GradientStop Color="#FFC8C8C8" Offset="0.531"/>
                                <GradientStop Color="#FFB6B6B6" Offset="0.789"/>
                                <GradientStop Color="#FFD5D5D5" Offset="0.996"/>
                            </LinearGradientBrush>

                            <SolidColorBrush x:Key ="TransparentRibbonMenuItemHoverBorderBrush"  Color="#7F000000"/>
                            <SolidColorBrush x:Key="TransparentRibbonMenuItemForegroundBrush" Color="Black" />
                            <SolidColorBrush x:Key="TransparentThemeChkBoxBorderBrush" Opacity="0.5" Color="#FF333333"/>

                            <SolidColorBrush x:Key="TransparentThemeChkBoxPathFill" Color="#FF333333"/>
                            <LinearGradientBrush x:Key="TransparentThemeChkBoxBackground" Opacity="0.5" EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FFE6E6E6" Offset="0"/>
                                <GradientStop Color="#FFFCFCFC" Offset="1"/>
                            </LinearGradientBrush>
                            <Style TargetType="local:RibbonMenuItem"  >
                                <Setter Property="BorderThickness" Value="1"/>

                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="local:RibbonMenuItem">
                                            <Grid>
                                                <Grid.Resources>
                                                    <local:BooleanToVisibilityConverter x:Key="BoolConverter"/>
                                                </Grid.Resources>
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="RibbonMenuItemStates">
                                                        <VisualStateGroup.Transitions>

                                                        </VisualStateGroup.Transitions>

                                                        <VisualState x:Name="Normal">
                                                            <Storyboard>
                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PART_poup">
                                                                    <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                                                                    <!--<EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>-->
                                                                </DoubleAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="MouseOver">
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="BorderBrush">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentRibbonMenuItemHoverBorderBrush}" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TransparentThemeRibbonMenuItemHoverBrush}" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="innerborder" Storyboard.TargetProperty="BorderBrush">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#CCFFFFFF" />
                                                                </ObjectAnimationUsingKeyFrames>


                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PART_poup">
                                                                    <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                                                                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
                                                                </DoubleAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>

                                                <Border  Margin="2,0,2,0" Name="Bd" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                                                    <Border BorderThickness="1" x:Name="innerborder">
                                                        <Grid Margin="0,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="21"/>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="20"/>
                                                        </Grid.ColumnDefinitions>

                                                        
                                                            <ContentControl Content="{TemplateBinding Header}" Grid.Column="1" Margin="6,2,2,2"/>
                                                        <ContentControl Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" Content="4" FontFamily="Webdings" Grid.Column="2" Margin="3" FontSize="14"/>
                                                        <Border Margin="2" >
                                                            <ContentControl Content="{TemplateBinding Icon}" BorderThickness="2" Height="16" Width="16" Margin="1"/>
                                                        </Border>
                                                        <Border Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolConverter}}" x:Name="PART_CheckedBorder" Margin="2" Background="{StaticResource TransparentThemeChkBoxBackground}" BorderBrush="{StaticResource TransparentThemeChkBoxBorderBrush}" BorderThickness="1">
                                                            <Path x:Name="CheckIcon" 
                                          Data="M102.03442,598.79645 L105.22962,597.78918 L106.78825,600.42358 C106.78825,600.42358 108.51028,595.74304 110.21724,593.60419 C112.00967,591.35822 114.89314,591.42316 114.89314,591.42316 C114.89314,591.42316 112.67844,593.42645 111.93174,594.44464 C110.7449,596.06293 107.15683,604.13837 107.15683,604.13837 z" 
                                          Fill="{StaticResource TransparentThemeChkBoxPathFill}" FlowDirection="LeftToRight" Height="10" Stretch="Fill" Width="10.5"/>
                                                        </Border>
                                                    </Grid>
                                                    </Border>
                                                </Border>

                                                <Popup Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HasItems, Converter={StaticResource BoolConverter}}" x:Name="PART_DropDown" Canvas.ZIndex="10">
                                                    <Grid Opacity="0" x:Name="PART_poup">
                                                        <!--<local:RibbonShadow Margin="3,3,0,0"/>-->
                                                        <Border Background="{StaticResource TransparentThemeMenuPopupBackgroundBrush}" BorderThickness="1" BorderBrush="{StaticResource TransparentThemeMenuPopupBorderBrush}">
                                                            <ItemsPresenter />
                                                        </Border>
                                                    </Grid>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonAdvHoverBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonAdvHoverBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                      
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonAdvPressedBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonAdvPressedBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                       
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="path1" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonDisabledForeground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="path1" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonDisabledForeground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="line1" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonDisabledForeground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="line1" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonDisabledForeground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked" />
                                <VisualState x:Name="Unchecked"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="23" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid Background="Transparent" x:Name="PART_ToggleButton">
                            <Border  x:Name="Background" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" >
                               
                            </Border>
                          
                            <Grid Width="5" Background="Transparent">


                                <StackPanel VerticalAlignment="Center">
                                    <Line x:Name="line1" Fill="Black" VerticalAlignment="Bottom" X2="1" Stretch="Fill" Stroke="#FF000000" >
                                        <Line.Effect>
                                            <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="White"/>
                                        </Line.Effect>
                                    </Line>
                                    <Path x:Name="path1"  Data="M3.375,8.3987293 L8.0413799,8.4820175 L5.6247015,12.896584 z" Fill="#FF000000" StrokeStartLineCap="Flat" Stretch="Fill" StrokeEndLineCap="Flat" Stroke="#FF000000" StrokeThickness="1" StrokeMiterLimit="10" StrokeLineJoin="Miter" Height="3.3" Grid.Row="1" Margin="0,2,0,0" >
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="0" ShadowDepth="1" Direction="270" Color="White"/>
                                        </Path.Effect>
                                    </Path>
                                </StackPanel>
                            </Grid>
                            <Rectangle x:Name="DisabledVisualElement" Fill="#FFFFFFFF" IsHitTestVisible="false" Opacity="0" RadiusY="3" RadiusX="3"/>
                            <Rectangle x:Name="FocusVisualElement" IsHitTestVisible="false" Margin="1" Opacity="0" RadiusY="2" RadiusX="2" Stroke="#FF6DBDD1" StrokeThickness="1"/>
                        </Grid>
                        <local:RibbonDropDown Grid.Row="1" x:Name="PART_RibbonDropDown">
                            <local:RibbonMenuGroup x:Name="PART_RibbonMenuGroup" IconBarEnabled="True">
                                <local:RibbonMenuItem Margin="0,0,0,0" x:Name="PART_MoreCommands" />
                                <local:RibbonMenuItem Margin="0,0,0,0" x:Name="PART_ShowBelowtheRibbon" />
                                <local:RibbonSeparator Margin="29,-4,0,0"/>
                                <local:RibbonMenuItem Margin="0,-6,0,3" x:Name="PART_MinimizeRibbon" IsCheckable="True"/>
                            </local:RibbonMenuGroup >
                        </local:RibbonDropDown>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="local:QuickAccessToolBar" x:Key="Office2010BlueQuickAccessToolBarStyle">
        <Setter Property="Height" Value="24"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:QuickAccessToolBar">
                    <Grid x:Name="PART_RootElement">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OverFlowBackgroundGradient" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonAdvHoverBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OverFlowBackgroundGradient" Storyboard.TargetProperty="BorderBrush">
