        <Setter Property="FloatWindowActiveHeaderBackground" Value="{StaticResource VS2010.ActiveWindowHeaderBarBackground}"/>


        <Setter Property="FloatWindowBorderThickness" Value="1"/>
        <Setter Property="FloatWindowContentBorderThickness" Value="1"/>
        <Setter Property="FloatWindowCornerRadius" Value="2"/>

        <Setter Property="WindowContentBorderBrush" Value="Transparent"/>
        <Setter Property="WindowContentBorderThickness" Value="1,1,1,1"/>
        <Setter Property="WindowContentConrnerRadius" Value="3"></Setter>
        <Setter Property="WindowCornerRadius" Value="2"/>
        <Setter Property="WindowContentBackground" Value="{StaticResource VS2010.WindowContentBackground}"></Setter>


        <Setter Property="FloatWindowActiveBorderBrush" Value="Gray"/>
        <Setter Property="FloatWindowContentBorderBrush" Value="Transparent"/>



    </Style>



