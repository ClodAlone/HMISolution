                                        <Path Name="awlbuttonpath1" Data="M34.579998,10.4 L34.579998,64 55.073,64 55.073,10.4 z M24.799999,0 L72.799999,0 72.799999,10.4 72.741001,10.4 72.741001,64 100.8,64 100.8,74.400001 54.82,74.400001 54.82,105.433 44.699999,105.433 44.699999,74.400001 0,74.400001 0,64 24.86,64 24.86,10.4 24.799999,10.4 z"  Fill="#FFCED4DD" Stretch="Fill" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border.RenderTransform>
