                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Rectangle Grid.Row="0" Height="14" Fill="{StaticResource ApplicationMenuTopBackground}" />
                                                <Border Grid.Row="1" Background="{StaticResource ApplicationMenuSidesBackground}">
                                                    <Border Margin="2,0,2,0" BorderThickness="1" BorderBrush="{StaticResource ApplicationMenuOuterBorder}">
                                                        <Border BorderThickness="1" BorderBrush="{StaticResource ApplicationMenuInnerBorder}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border BorderBrush="{StaticResource DarkBorder}" Background="{TemplateBinding Background}" BorderThickness="0,0,1,0">
                                                                    <ContentPresenter x:Name="Part_MainPanelPresenter"/>
                                                                </Border>

                                                                <Border Grid.Column="1" BorderBrush="{StaticResource LightBorder}" Background="{StaticResource ApplicationMenuContentBackground}" BorderThickness="1,0,0,0">
                                                                    <ContentPresenter x:Name="Part_MenuPanelPresenter"/>
                                                                </Border>
                                                                <Popup Grid.Column="1" x:Name="PART_ApplicationSplitPopup" HorizontalOffset="-2" />
                                                            </Grid>
                                                        </Border>
                                                    </Border>
                                                </Border>

                                                <Border Grid.Row="2" MinHeight="12" Background="{StaticResource ApplicationMenuBottomBackground}">
                                                    <ContentPresenter x:Name="Part_SystemPanelPresenter"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Canvas>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ApplicationMenu" BasedOn="{StaticResource VS2010ApplicationMenuStyle}"/>

        <!--Ribbon Brushes-->
    <SolidColorBrush x:Key="RibbonToolbarBelowOutterBorderBrush" Color="#FF7EA1CD"/>
    <SolidColorBrush x:Key="RibbonForeground" Color="#FF10418C"/>
    <SolidColorBrush x:Key="RibbonCaptionForeground" Color="#FFFFFFFF"/>

    <!--Ribbon-->
    <Style x:Key="VS2010RibbonStyle" TargetType="local:Ribbon">
        <Setter Property="QuickAccessToolbarStyle" Value="{StaticResource VS2010QuickAccessToolBarStyle}"/>
        <Setter Property="ApplicationMenuStyle" Value="{StaticResource VS2010ApplicationMenuStyle}"/>
        <Setter Property="Foreground" Value="{StaticResource RibbonForeground}" />
        <Setter Property="Title" Value="My Application"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <!--<Grid/>-->
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Ribbon">
                    <Grid x:Name="Ribbon" Background="{StaticResource RibbonBackground}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" MaxWidth="42" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <shared:ContextMenuAdvService.ContextMenuAdv>
                            <shared:ContextMenuAdv VisualStyle="VS2010">
                                <shared:ContextMenuItemAdv Header="Customize Quick Access Toolbar..." Name="PART_MoreCommands"/>
                                <shared:ContextMenuItemAdv Header="Show Quick Access Toolbar below the Ribbon" Name="PART_ShowBelow"/>
                                <shared:ContextMenuItemAdv Header="Minimize Ribbon" Name="PART_Minimize" IsCheckable="True"/>
                            </shared:ContextMenuAdv>
                        </shared:ContextMenuAdvService.ContextMenuAdv>


                        <Border x:Name="Title" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="0 -24" Height="24" BorderThickness="0,0,0,1"  BorderBrush="{StaticResource DarkBorder}" Background="{StaticResource TitleBackground}"/>

                        <Border x:Name="TabBar" Grid.Row="0" Grid.ColumnSpan="2" BorderThickness="0" BorderBrush="{StaticResource LightBorder}">
                        </Border>

                        <ContentControl Grid.RowSpan="1" Margin="0 -24 0 0" Grid.Row="0" BorderThickness="0" Content="{TemplateBinding ApplicationMenu}" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Foreground="Black"  />

                        <Grid Margin="-15,-48,0,0" Grid.Column="1" VerticalAlignment="Center" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="PART_QATAboveContainer">
                                <ContentControl BorderThickness="0" Content="{TemplateBinding QuickAccessToolBar}" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <local:RibbonTitlePanel x:Name="Part_TitlePanel" VerticalAlignment="Top" Height="24" Margin="0 -24 0 0" Grid.Column="1" Caption="{TemplateBinding Title}" Foreground="{StaticResource RibbonCaptionForeground}" Background="Transparent"/>

                        <Border CornerRadius="1" Margin="1" x:Name="Part_QATBorderContainer" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" 
                                BorderThickness="1" BorderBrush="{StaticResource RibbonToolbarBelowOutterBorderBrush}">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0,1">
                                    <GradientStop Color="#FFB2CDED" />
                                    <GradientStop Color="#FFAAC5EA" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid x:Name="PART_QATBelowContainer" />
                        </Border>

                        <ContentPresenter x:Name="Part_NormalTabHost" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch">
                            <ContentControl                                      
                                FontFamily="{TemplateBinding FontFamily}" 
                                FontSize="{TemplateBinding FontSize}" 
                                FontStretch="{TemplateBinding FontStretch}"
                                FontStyle="{TemplateBinding FontStyle}"
                                FontWeight ="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}">
                                <ItemsPresenter  x:Name="Part_TabPresenter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </ContentControl>
                        </ContentPresenter>

                        <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Height="1" Fill="{StaticResource DarkBorder}" VerticalAlignment="Bottom"/>

                        <local:RibbonDropDown x:Name="Part_PopupTabHost" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch">
                            <local:RibbonDropDown.Template>
                                <ControlTemplate>
                                    <Popup x:Name="Part_Popup" >
                                        <Canvas>
                                            <Rectangle x:Name="Part_OutsideRect"/>
                                            <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                                                <local:RibbonShadow Margin="4,4,0,0"/>
                                                <ContentPresenter />
                                            </Grid>
                                        </Canvas>
                                    </Popup>
                                </ControlTemplate>
                            </local:RibbonDropDown.Template>
                        </local:RibbonDropDown>

                        <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,-1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:RibbonTabStrip x:Name="Part_TabStrip" Background="Transparent">


                            </local:RibbonTabStrip>
                            <ContentControl Content="{TemplateBinding TabPanelItem}" Grid.Column="1" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource VS2010RibbonStyle}" TargetType="local:Ribbon"/>
