    <!--RibbonBar-->
    <Style x:Key="VS2010RibbonBarStyle" TargetType="local:RibbonBar">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="CollapseImage" Value="/Syncfusion.Ribbon.Silverlight;component/Ribbon/Resources/WordArt32.png" />
        <Setter Property="Header" Value="Ribbon Bar" />
        <Setter Property="Background" Value="{StaticResource RibbonBarBackground}" />
        <Setter Property="Foreground" Value="{StaticResource RibbonBarForeground2}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:RibbonBarPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonBar">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>

                            <vsm:VisualStateGroup x:Name="RibbonBarStates">

                                <vsm:VisualState x:Name="Normal" />

                                <vsm:VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Part_Header" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonBarHeaderBackgroundHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>

                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Part_Border" Duration="0:0:0.25" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".5" />
                                        </DoubleAnimationUsingKeyFrames>

                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>

                            <vsm:VisualStateGroup x:Name="DropDownStates">
                                <vsm:VisualState x:Name="DropDownNormal">
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="DropDownSelected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonBarSelectedBackground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonBarSelectedBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="DropDownPressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonBarDropDownButtonPressedBackground}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonBarSelectedBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Part_BorderImage" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RibbonBarImageBorderBackgroundChecked}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>

                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="Border" Margin="1,2,1,2" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource RibbonBarBorderBrush}" Background="{TemplateBinding Background}">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter x:Name="Part_ExpandedHost">
                                    <Grid x:Name="Part_RibbonBarStrip">
                                        <Grid.Resources>
                                            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverterKey" />
                                        </Grid.Resources>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="68"></RowDefinition>
                                            <RowDefinition Height="15"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Border x:Name="Part_Border" BorderBrush="{StaticResource RibbonBarInnerBordrBrush}" CornerRadius="3,3,0,0" BorderThickness="1,1,1,0" Grid.ColumnSpan="2">
                                            <ItemsPresenter Margin="1"/>
                                        </Border>
                                        <Border x:Name="Part_Header" Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="0,0,2,2" Background="{StaticResource RibbonBarHeaderBackground}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock x:Name="Part_Text" Text="{TemplateBinding Header}"  VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                                <local:RibbonButton x:Name="Part_LauncherButton" Style="{StaticResource RibbonBarLauncherButton}" Width="15" Height="15"
                                                                    Visibility="{Binding IsLauncherButtonVisible,Converter={StaticResource BooleanToVisibilityConverterKey},RelativeSource={RelativeSource TemplatedParent}}"
                                                                    Command="{TemplateBinding LauncherCommand}" SizeMode="Small" Grid.Column="1" />
                                            </Grid>

                                        </Border>
                                    </Grid>
                                </ContentPresenter>
                                <Grid x:Name="Part_DropDown" Margin="0,4,0,0" Visibility="Collapsed" Background="Transparent">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto"  />
                                        <RowDefinition Height="*"  />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" x:Name="Part_BorderImage" BorderBrush="{StaticResource RibbonBarImageBorderBrush}" Background="{StaticResource RibbonBarImageBorderBackgroundBrush}" BorderThickness="1" Margin="3,0,3,0" CornerRadius="3"  HorizontalAlignment="Center">
                                        <Grid MinWidth="31" MinHeight="31">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="7"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Row="0" Source="{TemplateBinding CollapseImage}" Stretch="None" />
                                            <Border Grid.Row="1" Background="{StaticResource RibbonBarImageBorderBackgroundBottom}"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{TemplateBinding Header}" Margin="3,0,3,0"  HorizontalAlignment="Center" />
                                    <Path Grid.Row="2" x:Name="Part_ItemArrow" Fill="{StaticResource RibbonSplitItemPathFill}" Data="M 0 0 L 4 4 L 8 0 Z" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    <Popup x:Name="Part_Popup" Margin="-1,1,0,0" VerticalAlignment="Bottom" Grid.Row="2">
                                        <Canvas>
                                            <Rectangle x:Name="Part_OutsideRect" Fill="Transparent" />
                                            <Grid x:Name="Part_PopupContent">
                                                <local:RibbonShadow  Margin="4,4,0,0" />
                                                <Border CornerRadius="3" Background="{StaticResource RibbonBarPopupBackground}" BorderThickness="1" BorderBrush="{StaticResource RibbonBarBorderBrush}">
                                                    <ContentPresenter x:Name="Part_CollapsedHost"/>
                                                </Border>
                                            </Grid>
                                        </Canvas>
                                    </Popup>
                                </Grid>
