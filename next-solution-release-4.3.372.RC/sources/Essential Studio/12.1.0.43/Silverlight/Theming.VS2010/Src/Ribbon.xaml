    <!--RibbonBarLauncherButton-->
    <Style x:Name="RibbonBarLauncherButton" TargetType="local:RibbonButton">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonButton">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="RibbonItemStates">
                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_OutterBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource LauncherButtonMouseOverOutterBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_OutterBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource LauncherButtonMouseOverOutterBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_WhitePath" Duration="0:0:0.25" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".6" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_WhitePath" Duration="0:0:0.25" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".6" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_OutterBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource LauncherButtonPressedOutterBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_OutterBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource LauncherButtonMouseOverOutterBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_OutterBorder" Storyboard.TargetProperty="Opacity">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value=".5" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="PART_OutterBorder" VerticalAlignment="Center" HorizontalAlignment="Center" BorderThickness="1">
                            <Border x:Name="PART_InnerBorder" Width="13" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="White">
                                <Grid Margin="1" Width="8" Height="8" Background="{TemplateBinding Background}" >
                                    <Path Stroke="{StaticResource LauncherButtonPathFill}">
                                        <Path.Data>
                                            <GeometryGroup>
                                                <LineGeometry StartPoint="0.5,0" EndPoint="0.5,6"/>
                                                <LineGeometry StartPoint="0,0.5" EndPoint="6,0.5"/>
                                                <LineGeometry StartPoint="3,3.5" EndPoint="4,3.5"/>
                                                <LineGeometry StartPoint="4,4.5" EndPoint="6,4.5"/>
                                                <LineGeometry StartPoint="4,5.5" EndPoint="6,5.5"/>
                                                <LineGeometry StartPoint="3,6.5" EndPoint="7,6.5"/>
                                                <LineGeometry StartPoint="6.5,3" EndPoint="6.5,7"/>
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                    <Path x:Name="PART_WhitePath" Stroke="White">
                                        <Path.Data>
                                            <GeometryGroup>
                                                <LineGeometry StartPoint="1.5,1" EndPoint="1.5,6"/>
                                                <LineGeometry StartPoint="1,1.5" EndPoint="6,1.5"/>
                                                <LineGeometry StartPoint="4,3.5" EndPoint="5,3.5"/>
                                                <LineGeometry StartPoint="4,7.5" EndPoint="8,7.5"/>
                                                <LineGeometry StartPoint="7.5,3" EndPoint="7.5,8"/>
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
