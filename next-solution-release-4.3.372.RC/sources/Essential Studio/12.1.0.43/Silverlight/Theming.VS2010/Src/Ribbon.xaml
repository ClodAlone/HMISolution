                                        <Canvas>
                                            <Path x:Name="path" Width="10.5" Height="10" Stretch="Fill" Fill="{StaticResource CheckBoxTextBrushKey}" Margin="-2,-1,0,0" Data="F1 M 36.6517,9.43632L 39.7763,14.1857L 40.7137,14.1232L 46.4629,3.12461L 45.4006,2.99963L 40.3777,10.1206L 39.9013,10.1862L 38.253,8.41244L 36.7767,8.12399L 36.6517,9.43632 Z " Opacity="0"/>
                                            <!--<Path x:Name="path"   Opacity="0" Fill="Yellow" >
