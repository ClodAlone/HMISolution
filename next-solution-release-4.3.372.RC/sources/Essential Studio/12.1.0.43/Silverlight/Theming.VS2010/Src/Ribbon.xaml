                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFE9ECEE" Offset="0.024"/>
                    <GradientStop Color="#FFD1D8E3" Offset="0.965"/>
