    <LinearGradientBrush x:Key="InnerEllipseCheckedFill" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFBEE" Offset="0.05"/>
        <GradientStop Color="#FFFFF3CE" Offset="0.577"/>
        <GradientStop Color="#FFFFECB5" Offset="0.582"/>
    </LinearGradientBrush>

    <!-- RibbonRadioButton -->
    <Style TargetType="local:RibbonRadioButton">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Background" Value="{StaticResource CheckRadioFillNormal}"/>
        <Setter Property="Foreground" Value="{StaticResource Foreground}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource CheckRadioStrokeNormal}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonRadioButton">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse1" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource OuterEllipseCheckedStroke}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse1" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource OuterEllipseCheckedFill}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse2" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource InnerEllipseCheckedFill}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse2" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource InnerEllipseCheckedStroke}" />
                                        </ObjectAnimationUsingKeyFrames>

                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="contentPresenter" Duration="0:0:0.25" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".55"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Duration="0:0:0.25" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0.55"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CheckStates">
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>

                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse1" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource OuterEllipseHoverStroke}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse1" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource OuterEllipseHoverFill}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource InnerEllipseHoverFill}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource InnerEllipseHoverStroke}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PathFill}" />
                                        </ObjectAnimationUsingKeyFrames>-->
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unchecked"/>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Canvas Width="13" Height="13">
                                <Ellipse x:Name="ellipse1" Width="13" Height="13" Stroke="{StaticResource OuterEllipseStroke}" Fill="{StaticResource OuterEllipseFill}">
                                </Ellipse>
                                <Ellipse x:Name="ellipse2" Fill="{StaticResource InnerEllipseFill}" Stroke="{StaticResource InnerEllipseStroke}" Canvas.Left="2" Canvas.Top="2" Width="9" Height="9">
                                </Ellipse>
                                <Ellipse x:Name="ellipse3" Fill="Transparent" Stroke="Transparent" Canvas.Left="3" Canvas.Top="3" Width="7" Height="7">
                                </Ellipse>
                                <Ellipse x:Name="ellipse" Canvas.Left="2" Canvas.Top="2" Width="9" Height="9">
                                </Ellipse>
                            </Canvas>
                            <Ellipse Height="13" x:Name="DisabledVisualElement" Width="13" Opacity="0" Fill="#FFFFFFFF"/>
                        </Grid>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="0,0.5,0,0.5" x:Name="contentPresenter" VerticalAlignment="Center" Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonTextBox -->
    <SolidColorBrush x:Key="ListBorder" Color="#FF8591A2"/>
    <Color x:Key="ControlBrushColor">White</Color>
    <SolidColorBrush x:Key="ControlTextBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#FFF1F3F8" />

    <Style TargetType="local:RibbonTextBox">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Background" Value="{StaticResource WindowBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ControlTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ListBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SelectionBackground" Value="#FFADD6FF"/>
        <Setter Property="SelectionForeground" Value="Black"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonTextBox">
                    <Grid x:Name="RootElement">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <vsm:VisualTransition From="Disabled" GeneratedDuration="0:0:0.25"/>
                                    <vsm:VisualTransition From="MouseOver" GeneratedDuration="0:0:0.25"/>
                                    <vsm:VisualTransition From="ReadOnly" GeneratedDuration="0:0:0.25"/>
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Border"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
														To="#FFE5C365" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation Storyboard.TargetName="DisabledVisualElement"
														 Storyboard.TargetProperty="Opacity"
														 To="1" />
                                        <ColorAnimation Storyboard.TargetName="Border"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
														To="{StaticResource ControlBrushColor}" />
                                        <ColorAnimation Storyboard.TargetName="ContentElement"
														Storyboard.TargetProperty="(ScrollViewer.Foreground).(SolidColorBrush.Color)"
														To="Gray" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="ReadOnly" >
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation To="1"
														 Storyboard.TargetName="ReadOnlyVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="FocusStates">
                                <!--<vsm:VisualStateGroup.Transitions>
                                    <vsm:VisualTransition From="Focused" GeneratedDuration="0:0:0.25"/>
                                </vsm:VisualStateGroup.Transitions>-->

                                <vsm:VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation To="1"
														 Storyboard.TargetName="FocusVisualElement"
														 Storyboard.TargetProperty="Opacity"/>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unfocused"/>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border x:Name="Border" Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}" >
                            <Grid Background="{TemplateBinding Background}">
                                <Border x:Name="ReadOnlyVisualElement" Background="#D2F7F7F7" Opacity="0" />
                                <Border x:Name="MouseOverBorder" BorderThickness="1" BorderBrush="Transparent">
                                    <ScrollViewer x:Name="ContentElement" Background="{TemplateBinding Background}" Style="{StaticResource ScrollViewerStyle}" BorderThickness="0" IsTabStop="False"
												  Padding="{TemplateBinding Padding}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="DisabledVisualElement" Background="#A5F7F7F7" BorderBrush="#A5F7F7F7" Opacity="0" IsHitTestVisible="False"
								BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="FocusVisualElement" Opacity="0" IsHitTestVisible="False"
								BorderBrush="#FFE5C365"
								BorderThickness="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MiniToolbar-->
    <SolidColorBrush x:Key="MiniToolBarBackground" Color="#FFBCC7D8"/>

    <Style TargetType="local:MiniToolbar">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Background" Value="{StaticResource MiniToolBarBackground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MiniToolbar">

                    <Popup x:Name="Popup">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Common states">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="Visible" GeneratedDuration="0:0:0.25"/>
                                </VisualStateGroup.Transitions>

                                <VisualState x:Name="Normal"/>

                                <VisualState x:Name="Visible">
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="Border"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Canvas x:Name="ContentPanel">
                            <Canvas x:Name="OuterCanvas" Background="Transparent" />

                            <Grid x:Name="Border" Opacity="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <local:RibbonShadow Margin="5,5,0,0" />
                                <Border CornerRadius="3"
									Background="{StaticResource MiniToolBarBackground}"
									BorderBrush="#FF9CAAC1"
									BorderThickness="{TemplateBinding BorderThickness}" >
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </Canvas>
                    </Popup>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

