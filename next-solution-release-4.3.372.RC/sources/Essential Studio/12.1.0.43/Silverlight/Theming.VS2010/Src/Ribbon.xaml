    <SolidColorBrush x:Key="Blue.Path.Fill" Color="#FF11438F"/>

    <LinearGradientBrush x:Key="Luna.MouseOverBrush.Default" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FFFFFFE7" Offset="0.99"/>
        <GradientStop Color="#FFFFE69F" Offset="0.817"/>
        <GradientStop Color="#FFFFDB6C" Offset="0.807"/>
        <GradientStop Color="#FFFFD357" Offset="0.424"/>
        <GradientStop Color="#FFFFEBA6" Offset="0.036"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonItemMouseOverBorderBrush" Color="#FFE5C365"/>

    <LinearGradientBrush x:Key="RibbonItemMouseOverBrush1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFCF3" Offset="0.027"/>
        <GradientStop Color="#FFFFF3CE" Offset="0.492"/>
        <GradientStop Color="#FFFFECB5" Offset="0.495"/>
        <GradientStop Color="#FFFFECB5" Offset="0.996"/>
        <GradientStop Color="#FFE5C365" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="RibbonItemPressedBrush1" Color="#FFFFE8A6"/>
    <ControlTemplate x:Key="RibbonScrollButtonTemplate" TargetType="primitives:RepeatButton">
        <Border x:Name="Root" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
						BorderThickness="0,0,1,0" CornerRadius="3,0,0,3"
						BorderBrush="{TemplateBinding BorderBrush}"
						Background="#FFBCC7D8"
						Opacity="{TemplateBinding Opacity}" >

            <vsm:VisualStateManager.VisualStateGroups>

                <vsm:VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition From="MouseOver"/>
                        <VisualTransition From="Pressed"/>
                    </VisualStateGroup.Transitions>

                    <vsm:VisualState x:Name="Normal"/>
                    <vsm:VisualState x:Name="Disabled"/>

                    <vsm:VisualState x:Name="MouseOver">
                        <Storyboard Duration="0">
                            <DoubleAnimation Duration="0:0:0.25" To="1"
													 Storyboard.TargetName="BackgroundAnimation"
													 Storyboard.TargetProperty="Opacity" />
                            <ObjectAnimationUsingKeyFrames Duration="0"
																   Storyboard.TargetName="BackgroundAnimation"
																   Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame Value="{StaticResource RibbonItemMouseOverBrush1}" KeyTime="0"/>

                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Duration="0"
																   Storyboard.TargetName="BackgroundAnimation"
																   Storyboard.TargetProperty="BorderBrush">
                                <DiscreteObjectKeyFrame Value="{StaticResource RibbonItemMouseOverBorderBrush}" KeyTime="0"/>

                            </ObjectAnimationUsingKeyFrames>

                        </Storyboard>
                    </vsm:VisualState>

                    <vsm:VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation To="1" Duration="0"
														 Storyboard.TargetName="BackgroundAnimation" Storyboard.TargetProperty="Opacity"/>
                            <ObjectAnimationUsingKeyFrames Duration="0"
																   Storyboard.TargetName="BackgroundAnimation"
																   Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame Value="{StaticResource RibbonItemPressedBrush1}" KeyTime="0"/>

                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Duration="0"
																   Storyboard.TargetName="BackgroundAnimation"
																   Storyboard.TargetProperty="BorderBrush">
                                <DiscreteObjectKeyFrame Value="{StaticResource RibbonItemMouseOverBorderBrush}" KeyTime="0"/>

                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </vsm:VisualState>

                </vsm:VisualStateGroup>

            </vsm:VisualStateManager.VisualStateGroups>

            <Border x:Name="BackgroundAnimation" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
							BorderBrush="White" BorderThickness="0,0,1,0" CornerRadius="3,0,0,3"
							Background="#FFBCC7D8"
							Opacity="{TemplateBinding Opacity}" >
                <Path Data="M 4 0 L 4 8 L 0 4 Z" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2"
								  Fill="#FF1B293E" />
            </Border>
        </Border>
    </ControlTemplate>


    <!-- RibbonTabStrip -->
    <Style TargetType="local:RibbonTabStrip">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScrollStrip">
                    <Grid x:Name="RootElement">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LeftScrollButtonState">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="LeftVisible" GeneratedDuration="0:0:0.25"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="LeftNormal"/>
                                <VisualState x:Name="LeftVisible">
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
