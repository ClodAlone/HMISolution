    <Style TargetType="local:RibbonComboBox">
        <Setter Property="Foreground" Value="{StaticResource WindowTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource ComboBoxBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ComboBoxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!--<Setter Property="Padding" Value="5,1,5,1"/>-->
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonComboBox">
                    <Grid x:Name="LayoutRoot">
                        <Grid.Resources>
                            <Storyboard x:Key="aniHidePopup">
                                <DoubleAnimation To="0" Duration="0:0:0.25"
												 Storyboard.TargetName="PopupBorder"
												 Storyboard.TargetProperty="Opacity" />
                            </Storyboard>
                            <Storyboard x:Key="aniOpenPopup">
                                <!--<ColorAnimation Duration="0:0:0.25"
												Storyboard.TargetName="ContentPresenterBorder"
												Storyboard.TargetProperty="(UIElement.BorderBrush).(SolidColorBrush.Color)" To="#FFE5C365" />-->
                                <DoubleAnimation To="1" Duration="0:0:0.25"
												 Storyboard.TargetName="PopupBorder"
												 Storyboard.TargetProperty="Opacity"/>
                            </Storyboard>
                            <Storyboard x:Key="aniMouseOver" >
                                <ColorAnimation Duration="0:0:0.25"
												Storyboard.TargetName="ContentPresenterBorder"
												Storyboard.TargetProperty="(UIElement.BorderBrush).(SolidColorBrush.Color)" To="#FFE5C365" />
                            </Storyboard>
                            <Style x:Key="comboToggleStyle" TargetType="ToggleButton">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1,0,0,0"/>
                                <Setter Property="ClickMode" Value="Press"/>
                                <Setter Property="Foreground" Value="#FF000000"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="2,0,2,0"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="{TemplateBinding Background}">
                                                <vsm:VisualStateManager.VisualStateGroups>
                                                    <vsm:VisualStateGroup x:Name="CommonStates">
                                                        <vsm:VisualStateGroup.Transitions>
                                                            <VisualTransition From="MouseOver" GeneratedDuration="0:0:0.25" />
                                                            <VisualTransition From="Pressed" GeneratedDuration="0:0:0.25" />
                                                        </vsm:VisualStateGroup.Transitions>

                                                        <vsm:VisualState x:Name="Normal" />
                                                        <vsm:VisualState x:Name="MouseOver">
                                                            <Storyboard>
                                                                <ColorAnimation To="#FFE5C365" Duration="0:0:0.25"
														Storyboard.TargetName="Background"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"/>
                                                                <!--<ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderThickness">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="1" />
                                                                        </ObjectAnimationUsingKeyFrames>-->
                                                                <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="Background" Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{StaticResource ComboBoxMouseOverBrush}" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </vsm:VisualState>
                                                        <vsm:VisualState x:Name="Pressed" >
                                                            <Storyboard>
                                                                <DoubleAnimation Duration="0:0:0.25" To="1"
														 Storyboard.TargetName="BtnArrowHost"
														 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" />
                                                                <DoubleAnimation Duration="0:0:0.25" To="1"
														 Storyboard.TargetName="BtnArrowHost"
														 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" />
                                                            </Storyboard>
                                                        </vsm:VisualState>
                                                        <vsm:VisualState x:Name="Disabled">
                                                            <Storyboard>
                                                                <DoubleAnimation Duration="0:0:0.25" To=".55"
														 Storyboard.TargetName="DisabledVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                                            </Storyboard>
                                                        </vsm:VisualState>
                                                    </vsm:VisualStateGroup>
                                                    <vsm:VisualStateGroup x:Name="CheckStates">
                                                        <vsm:VisualStateGroup.Transitions>
                                                            <VisualTransition From="Checked" GeneratedDuration="0:0:0.25" />
                                                        </vsm:VisualStateGroup.Transitions>

                                                        <vsm:VisualState x:Name="Checked">
                                                            <Storyboard>
                                                                <!--<ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderThickness">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="1" />
                                                                        </ObjectAnimationUsingKeyFrames>-->
                                                                <ColorAnimation To="#FFE5C365" Duration="0:0:0.25"
														Storyboard.TargetName="Background"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"/>
                                                                <!--<ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="ComboThumb" Storyboard.TargetProperty="BorderThickness">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="1" />
                                                                        </ObjectAnimationUsingKeyFrames>-->
                                                                <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="Background" Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{StaticResource ComboBoxPressedBrush}" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                                <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="ComboThumb" Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{StaticResource ComboBoxPressedBrush}" />
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </vsm:VisualState>
                                                        <vsm:VisualState x:Name="Unchecked"/>
                                                    </vsm:VisualStateGroup>
                                                    <vsm:VisualStateGroup x:Name="FocusStates">
                                                        <vsm:VisualState x:Name="Focused">
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames  Duration="0:0:0.25"
																		Storyboard.TargetName="FocusVisualElement"
																		Storyboard.TargetProperty="Visibility">
                                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="Visible"/>
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </vsm:VisualState>
                                                        <vsm:VisualState x:Name="Unfocused" />
                                                    </vsm:VisualStateGroup>
                                                </vsm:VisualStateManager.VisualStateGroups>

                                                <Border x:Name="Background" Width="16"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								Background="{TemplateBinding Background}" >
                                                    <Border x:Name="ComboThumb" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
										BorderBrush="{TemplateBinding BorderBrush}" >
                                                        <Border x:Name="BtnArrowHost">
                                                            <Border.RenderTransform>
                                                                <TranslateTransform X="0" Y="0"/>
                                                            </Border.RenderTransform>
                                                            <Path x:Name="BtnArrow" Data="M0,0L3.5,4 7,0z" Height="4" Width="8" Stretch="Uniform"
											HorizontalAlignment="Center" VerticalAlignment="Center"
											Fill="{StaticResource PathFill}"/>
                                                        </Border>
                                                    </Border>
                                                </Border>
                                                <Rectangle x:Name="DisabledVisualElement" RadiusX="1" RadiusY="1" Fill="#FFFFFFFF" Opacity="0" IsHitTestVisible="false" />
                                                <Rectangle x:Name="FocusVisualElement" RadiusX="0.5" RadiusY="0.5" Margin="1"  Stroke="#FF6DBDD1" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="false" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>

                        <vsm:VisualStateManager.VisualStateGroups>

                            <vsm:VisualStateGroup x:Name="CommonStates">

                                <vsm:VisualStateGroup.Transitions>
                                    <VisualTransition From="MouseOver" GeneratedDuration="0:0:0.25"/>
                                    <VisualTransition From="Disabled" GeneratedDuration="0:0:0.25"/>
                                </vsm:VisualStateGroup.Transitions>

                                <VisualState x:Name="Normal"/>

                                <VisualState x:Name="MouseOver" />

                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation To=".55" Duration="0:0:0.25"
														 Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="Opacity"/>
                                    </Storyboard>
                                </VisualState>

                            </vsm:VisualStateGroup>

                            <vsm:VisualStateGroup x:Name="FocusStates">

                                <vsm:VisualStateGroup.Transitions>
                                    <vsm:VisualTransition From="FocusedDropDown" GeneratedDuration="0:0:0.25"/>
                                    <vsm:VisualTransition From="Focused" GeneratedDuration="0:0:0.25"/>
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="FocusVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Unfocused"/>

                                <vsm:VisualState x:Name="FocusedDropDown">
                                    <Storyboard>
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="FocusVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="PopupBorder"
											Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>

                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border x:Name="ContentPresenterBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.Resources>

                                </Grid.Resources>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="ContentPresenter"
                                                  Margin="{TemplateBinding Padding}"  
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" >
                                    <TextBlock Text=" "/>
                                </ContentPresenter>

                                <ToggleButton x:Name="DropDownToggle" Grid.Column="1" Style="{StaticResource comboToggleStyle}" />
                            </Grid>
                        </Border>
                        <Rectangle x:Name="DisabledVisualElement" RadiusX="1" RadiusY="3" Fill="White" Opacity="0" IsHitTestVisible="false" />
                        <Rectangle x:Name="FocusVisualElement" RadiusY="2" Stroke="#FFE5C365" StrokeThickness="1.5" Opacity="0" IsHitTestVisible="false" />
                        <Popup x:Name="Popup" Canvas.ZIndex="10">
                            <Grid x:Name="PopupBorder" Opacity="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <local:RibbonShadow Margin="4,4,0,0" />
                                <Border CornerRadius="3"
									Background="{TemplateBinding Background}"
									BorderBrush="{StaticResource WindowFrameBrush}"
									BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer x:Name="ScrollViewer"  Style="{StaticResource ScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  BorderThickness="0" Padding="1" >
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonComboBoxItem -->
    <SolidColorBrush x:Key="MenuButton.OuterBorderBrush" Color="#FFCFB486"/>

    <LinearGradientBrush x:Key="MenuButton.MouseOverBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFEDE5C9" Offset="0"/>
        <GradientStop Color="#FFFFFFFE" Offset="0.028"/>
        <GradientStop Color="#FFFFEBA6" Offset="0.484"/>
        <GradientStop Color="#FFFFD75A" Offset="0.537"/>
        <GradientStop Color="#FFFFE590" Offset="0.957"/>
        <GradientStop Color="#FFFFF8B0" Offset="0.993"/>
    </LinearGradientBrush>

    <Style TargetType="local:RibbonComboBoxItem">
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonComboBoxItem">
                    <Grid Background="{TemplateBinding Background}">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <VisualTransition From="MouseOver" GeneratedDuration="0:0:0.25" />
                                    <VisualTransition From="Disabled" GeneratedDuration="0:0:0.25" />
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
																	   Storyboard.TargetName="InnerBorder"
																	   Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ComboBoxItemMouseoverBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
																	   Storyboard.TargetName="InnerBorder"
																	   Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ComboBoxItemMouseoverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Duration="0:0:0.25" To="1"
														 Storyboard.TargetName="InnerBorder"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.25" To=".55"
														 Storyboard.TargetName="contentPresenter"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="SelectionStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <VisualTransition From="Selected" GeneratedDuration="0:0:0.25" />
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Unselected" />
                                <vsm:VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
																	   Storyboard.TargetName="OuterBorder"
																	   Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ComboBoxItemMouseoverBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
																	   Storyboard.TargetName="OuterBorder"
																	   Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ComboBoxItemMouseoverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="FocusStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <VisualTransition From="Focused" GeneratedDuration="0:0:0.25" />
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.25" To="1"
														 Storyboard.TargetName="FocusVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unfocused" />
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border x:Name="OuterBorder" BorderThickness="1"
								BorderBrush="{TemplateBinding BorderBrush}"
								Background="{TemplateBinding Background}"
								Opacity="{TemplateBinding Opacity}" >
                            <Grid>
                                <Border x:Name="InnerBorder" BorderThickness="1" Opacity="0" HorizontalAlignment="Stretch"/>
                                <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Left"
												  Content="{TemplateBinding Content}"
												  ContentTemplate="{TemplateBinding ContentTemplate}"
												  Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>

                        <Rectangle x:Name="FocusVisualElement" Stroke="Transparent" StrokeThickness="1" Opacity="0" RadiusX="1" RadiusY="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonListBox -->
    <Style TargetType="local:RibbonListBox">
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Background">
