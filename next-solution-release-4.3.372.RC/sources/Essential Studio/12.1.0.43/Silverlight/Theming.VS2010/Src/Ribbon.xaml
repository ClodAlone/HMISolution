                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Canvas.Resources>
                            <Rectangle x:Name="Part_OutsideRect"/>
                            <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                                <local:RibbonShadow Margin="4,4,0,0"/>
                                <Border BorderThickness="1" BorderBrush="{StaticResource PopupOuterBorder}" CornerRadius="2">
                                    <Border Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="{StaticResource PopupInnerBorder}" CornerRadius="1">
