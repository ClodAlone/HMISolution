    <!-- RibbonGalleryItem -->
    <Style TargetType="local:RibbonGalleryItem">
        <Setter Property="ClickMode" Value="Release"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonGalleryItem">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="RibbonItemStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="Disabled" GeneratedDuration="0:0:0.25"/>
                                </VisualStateGroup.Transitions>

                                <VisualState x:Name="Normal"/>

                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OutterBorder"
																	   Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0"
																	Value="{StaticResource RibbonGalleryItem.IsMouseOver.BackgroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border"
																	   Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0"
																	Value="{StaticResource RibbonGalleryItem.IsMouseOver.BackgroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OutterBorder"
																	   Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0"
																	Value="{StaticResource RibbonGalleryItem.IsChecked.BorderBrush.Outside}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border"
																	   Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0"
																	Value="{StaticResource RibbonGalleryItem.IsChecked.BackgroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="SelectChecked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OutterBorder"
																	   Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0"
																	Value="{StaticResource RibbonGalleryItem.IsChecked.BorderBrush.Outside}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border"
																	   Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0"
																	Value="{StaticResource RibbonGalleryItem.HoverChecked.BackgroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Border"
																	   Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0"
																	Value="{StaticResource RibbonGalleryItem.IsPressed.BackgroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OutterBorder"
																	   Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0"
																	Value="{StaticResource RibbonGalleryItem.IsPressed.BorderBrush.Outside}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation To="0.75" Duration="0:0:0.25"
														 Storyboard.TargetName="DisabledElement"
														 Storyboard.TargetProperty="Opacity"/>
                                    </Storyboard>
                                </VisualState>

                            </VisualStateGroup>

                            <VisualStateGroup>
                            </VisualStateGroup>

                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border x:Name="OutterBorder" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource RibbonGalleryItemBorder}" Background="{StaticResource RibbonGalleryItemBackground}">
                            <Border x:Name="Border" CornerRadius="0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="4">
                                <Border CornerRadius="2">
                                    <ContentPresenter/>
                                </Border>
                            </Border>
                        </Border>

                        <Border x:Name="DisabledElement" CornerRadius="2" Opacity="0" Background="White"
								HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

