    <Style TargetType="local:TabButton" x:Key="Syncfusion.Windows.Tools.Controls.TabButton">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource TabItemForeground}">
        </Setter>
        <Setter Property="MinWidth" Value="23"/>
        <Setter Property="SeparatorOpacity" Value="0"/>
        <Setter Property="Height" Value="23"/>
        <Setter Property="Padding" Value="2,0,2,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabButton">
                    <Grid x:Name="RootElement">
                        <vsm:VisualStateManager.VisualStateGroups>

                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard >
                                        <Storyboard>
                                            <DoubleAnimation To="1" 
														 Storyboard.TargetName="HighlightBorder"
														 Storyboard.TargetProperty="Opacity" />
                                            <!--<DoubleAnimation To="1" 
														 Storyboard.TargetName="HighlightEdge"
														 Storyboard.TargetProperty="Opacity" />-->
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Caption" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>

                                        </Storyboard>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="Left"
														 Storyboard.TargetProperty="Opacity" />
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="Right"
														 Storyboard.TargetProperty="Opacity" />
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="SelectedBackground"
														 Storyboard.TargetProperty="Opacity" />
                                        <!--<DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="HighlightEdge"
														 Storyboard.TargetProperty="Opacity" />-->

                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Caption" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                        </ObjectAnimationUsingKeyFrames>

                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="SelectedMouseOver">
                                    <Storyboard>
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="Left"
														 Storyboard.TargetProperty="Opacity" />
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="Right"
														 Storyboard.TargetProperty="Opacity" />
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="SelectedBackground"
														 Storyboard.TargetProperty="Opacity" />
                                        <!--<DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="HighlightEdge"
														 Storyboard.TargetProperty="Opacity" />-->

                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Caption" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                        </ObjectAnimationUsingKeyFrames>

                                    </Storyboard>

                                </vsm:VisualState>

                            </vsm:VisualStateGroup>

                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border Height="23" Margin="0,0,1,0"
								BorderBrush="{TemplateBinding BorderBrush}"
								Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="HighlightBorder" Grid.Column="1" Height="23" Opacity="0"
										BorderThickness="1,1,1,1" CornerRadius="4,4,0,0" Margin="-1,0,-1,0"
										BorderBrush="{StaticResource TabItemMouseOverBorderBrushKey}"
										Background="{StaticResource TabItemAdvMouseOverBrushKey}"/>

                                <Border x:Name="HighlightEdge" Grid.Column="1" Height="21" Opacity="0"
										CornerRadius="3,3,0,0" BorderThickness="1,1,1,0" BorderBrush="WhiteSmoke"/>

                                <Grid x:Name="SelectedBackground" Grid.Column="1" Opacity="0">
                                    <Border x:Name="SelectedBackgroundBorder" Height="23" CornerRadius="2,2,0,0" Margin="-1,0,-1,0"
											Background="{StaticResource TabItemSelectedBackground}" />
                                    <Border Height="20" CornerRadius="2,2,0,0" BorderThickness="1,1,0,0" Margin="-1,0,-1,0"
											VerticalAlignment="Top"
											BorderBrush="{StaticResource TabItemSelectedBackground}"/>
                                </Grid>

                                <Border x:Name="Left" Grid.Column="0" VerticalAlignment="Bottom" Width="6" Height="6" Opacity="0"
										BorderThickness="1" CornerRadius="2,2,0,0" Margin="-3,0,0,0"
										BorderBrush="{StaticResource Ribbon.BorderBrush}">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,7,7,7"/>
                                    </Border.Clip>
                                </Border>

                                <Border x:Name="Right" Grid.Column="2" VerticalAlignment="Bottom" Width="6" Height="6" Opacity="0"
										BorderThickness="1" CornerRadius="0"
										BorderBrush="{StaticResource Ribbon.BorderBrush}">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,7,7,7"/>
                                    </Border.Clip>
                                </Border>

                                <Border Height="23" Grid.Column="1" Margin="1,0,1,0" BorderThickness="0,1,0,0" Padding="12,0" >
                                    <TextBlock x:Name="Caption" TextAlignment="Center" VerticalAlignment="Center"
											   Margin="{TemplateBinding Padding}"
											   Foreground="White"
											   Text="{TemplateBinding Caption}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" FontStyle="{TemplateBinding FontStyle}" FontWeight="{TemplateBinding FontWeight}"/>
                                </Border>

                                <Border x:Name="HighlightBorderSelected" Grid.Column="1" Height="20" Margin="-2,0,-2,0" Opacity="0" 
										CornerRadius="4,4,0,0" BorderThickness="2,2,2,0" BorderBrush="#FFF4C663"
										VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <Rectangle Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,1,0"
								   Opacity="{TemplateBinding SeparatorOpacity}">
                            <Rectangle.Fill>
                                <LinearGradientBrush>
                                    <GradientStop Offset="0.0" Color="{StaticResource Blue.RibbonTapPanel.SeparatorColor.Start}"/>
                                    <GradientStop Offset="0.3" Color="{StaticResource Blue.RibbonTapPanel.SeparatorColor.End}"/>
                                    <GradientStop Offset="1.0" Color="{StaticResource Blue.RibbonTapPanel.SeparatorColor.End}"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollStrip -->

    <LinearGradientBrush x:Key="Blue.Ribbon.Background" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FFDEE7F7" Offset="0.904"/>
        <GradientStop Color="#FFD6DFF7" Offset="0.824"/>
        <GradientStop Color="#FFC6DBEF" Offset="0.808"/>
        <GradientStop Color="#FFEEF4FF" Offset="0.015"/>
        <GradientStop Color="#FFBDEDF4"/>
    </LinearGradientBrush>

