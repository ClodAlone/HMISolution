    <!--RibbonStatusBar-->
    <Style x:Key="VS2010RibbonStatusBarStyle" TargetType="local:RibbonStatusBar">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="{StaticResource StatusBarBorderDark}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonStatusBar">
                    <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderThickness="0" BorderBrush="{TemplateBinding BorderBrush}" >
                                <Border Grid.Column="0" BorderThickness="0" BorderBrush="{StaticResource StatusBarBorderDark}" Background="{StaticResource StatusBarLightBackground}">
                                   <ContentPresenter Content="{TemplateBinding StatusItemsPane}"/>
                                </Border>
                            </Border>
                            <Border Grid.Column="1" BorderThickness="0" BorderBrush="{StaticResource StatusBarBorderDark}">
                                <Border Grid.Column="1" BorderThickness="0" BorderBrush="{StaticResource StatusBarBorderDark}" Background="{StaticResource StatusBarLightBackground}">
                                    <ContentPresenter Content="{TemplateBinding ControlItemsPane}"/>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource VS2010RibbonStatusBarStyle}" TargetType="local:RibbonStatusBar"/>

        <LinearGradientBrush x:Key="ScreenTipBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="White" Offset="0.101"/>
        <GradientStop Color="#FFCFDDF3" Offset="0.992"/>
        <GradientStop Color="#FFB3BDCC" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush Color="#FF515452" x:Key="ForgroundBrushKey" />
    <SolidColorBrush Color="#FF808588" x:Key="BorderBrushKey" />

    <Style x:Key="ScreenTipStyle" TargetType="local:ScreenTip">
        <Setter Property="Background" Value="Yellow" />
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Green"/>
        <Setter Property="Foreground" Value="Red" />
        <Setter Property="HelpImage" Value="/Syncfusion.Ribbon.Silverlight;component/Ribbon/Resources/Help.png" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScreenTip">
                    <Grid Background="Red">
                        <Grid.Resources>
                            <local:TextToVisibilityConverter x:Key="TextToVisibilityConverterKey" />
                            <local:SizeToDoubleConverter x:Name="SizeToDoubleConverterKey" />
                        </Grid.Resources>
                        <local:RibbonShadow Margin="5,5,0,0"/>

                        <Border MinHeight="100" CornerRadius="2" Background="Blue" 
                            BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid Margin="4" Background="Green">
                                <Grid.RowDefinitions>
                                    <RowDefinition MinHeight="20" />
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Desc" Foreground="{TemplateBinding Foreground}"
                                           Grid.Row="0" Grid.ColumnSpan="2" FontSize="12" FontWeight="Bold" FontFamily="Comic Sans MS" 
                                           Text="{TemplateBinding Description}" />
                                <Border Grid.Row="1" Grid.Column="0" x:Name="Image" Margin="0,0,2,0">
                                    <Image Source="{TemplateBinding ImageSource}" Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}"
                                        Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap"
                                    Grid.Row="1" Grid.Column="1" x:Name="Text" Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Content}"
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Top" />

                                <Grid Background="Red" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent},Path=HelpText,Converter={StaticResource TextToVisibilityConverterKey}}" 
                                      Grid.ColumnSpan="2" Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <local:RibbonSeparator Margin="0,3" Grid.Row="0" Grid.ColumnSpan="2" 
                                                           VerticalAlignment="Center" HorizontalAlignment="Stretch" x:Name="PART_Separator" />
                                    <Image Margin="2" Source="{TemplateBinding HelpImage}" Grid.Row="1" x:Name="PART_HelpImage" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PART_HelpText" VerticalAlignment="Center"
                                               Text="{TemplateBinding HelpText}" Grid.Row="1" Grid.Column="1"  
                                               FontSize="12" FontWeight="Bold" FontFamily="Calibri" Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ScreenTipStyle}" TargetType="local:ScreenTip"/>

</ResourceDictionary>
