    <LinearGradientBrush x:Key="TabItemSelectedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFBEE" Offset="0.09"/>
        <GradientStop Color="#FFFFF4D0" Offset="0.521"/>
        <GradientStop Color="#FFFFEDBA" Offset="0.527"/>
        <GradientStop Color="#FFFFEDBA" Offset="0.559"/>
        <GradientStop Color="#FFFFE8A6" Offset="0.566"/>
