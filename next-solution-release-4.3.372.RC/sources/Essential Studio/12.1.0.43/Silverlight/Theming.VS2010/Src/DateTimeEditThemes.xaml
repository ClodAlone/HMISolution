    xmlns:System_Windows_Controls_PrimitivesInput="clr-namespace:System.Windows.Controls.Primitives;assembly=System.Windows.Controls"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:Shared_Resources="clr-namespace:Syncfusion.Windows.Shared.Resources;assembly=Syncfusion.Shared.Silverlight">



    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="MSControls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Shared_Resources:ResourceWrapper x:Key="ResourceWrapperKey" />

    <SolidColorBrush x:Key="CalendarBackgroundBrushKey" Color="#FF2C3D5A"/>   

    <SolidColorBrush x:Key="CalendarBorderBrushKey" Color="#FF2C3D5A"/>

