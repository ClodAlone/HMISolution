<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
     xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Ribbon.Silverlight" >

    <LinearGradientBrush x:Key="RibbonMenuBottomBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFDEE7EE" Offset="0.278"/>
        <GradientStop Color="#FFE9F3FC" Offset="0.389"/>
        <GradientStop Color="#FFDDEBF9" Offset="0.778"/>
        <GradientStop Color="#FFCCDBEB" Offset="0.889"/>
        <GradientStop Color="#FFEFF4F8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenuBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE8EBEE" Offset="0.01"/>
        <GradientStop Color="#FFD1D8E2" Offset="0.99"/>
        <GradientStop Color="#FF9BA7B7" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MenuHeader" Color="#FF4A5D80"/>

    <SolidColorBrush x:Key="MenuSideBackground" Color="#FFE9ECEE"/>
    <Style x:Key="VS2010RibbonMenuGroupStyle" TargetType="local:RibbonMenuGroup">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonMenuGroup">
                    <Grid Name="gri">
                        <Grid.Resources>
                            <local:TextToVisibilityConverter x:Key="TextConverter"/>
                            <local:BooleanToVisibilityConverter x:Key="BoolConverter"/>
                            <local:VisibilityToThicknessConverter x:Key="ThicknessConverter"/>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource MenuHeader}" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource TextConverter}}" Height="22" Grid.Row="0" BorderThickness="0" BorderBrush="Transparent">
                            <ContentControl Content="{TemplateBinding Header}" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"  HorizontalContentAlignment="Left"/>
                        </Border>
                        <Border Grid.Row="1">
                            <Grid Background="{StaticResource MenuBackground}">
                                <Border x:Name="IconTray" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IconBarEnabled, Converter={StaticResource BoolConverter}}" BorderBrush="Transparent" Background="{StaticResource MenuSideBackground}" BorderThickness="0,0,2,0" Width="26" HorizontalAlignment="Left"/>
                                <Border >
                                    <ScrollViewer TabNavigation="Cycle" Padding="-1" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}" BorderThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ScrollBarVisibility, Converter={StaticResource ThicknessConverter} }">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2">
                            <Grid>
                                <Border Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMoreItemsIconTrayEnabled, Converter={StaticResource BoolConverter} }" BorderThickness="0,0,2,0" Width="22" HorizontalAlignment="Left"/>
                                <ItemsControl ItemsSource="{TemplateBinding MoreItems}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Width="{Binding ElementName=PART_ResizeThumb, Path=ActualWidth}" HorizontalAlignment="Stretch" Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsResizable, Converter={StaticResource BoolConverter}}">
                            <Grid>
                                <Border HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#FF849DBD" CornerRadius="2" Height="3" Width="3"/>

                                        <Border  Background="#FF849DBD" CornerRadius="2"  Height="3" Width="3" Margin="-5,0,0,0"/>
                                        <Border Background="#FF849DBD" CornerRadius="2" Height="3" Width="3" Margin="3,0,0,0"/>

                                        <Border  Background="#FF849DBD" CornerRadius="2"  Height="3" Width="3"  Margin="-5,0,0,0"/>
                                        <Border Background="#FF849DBD" CornerRadius="2" Height="3" Width="3" Margin="3,0,0,0"/>
                                        <Border  Background="#FF849DBD" CornerRadius="2"  Height="3" Width="3"  Margin="-5,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Thumb x:Name="PART_ResizeThumb" Opacity="0" Cursor="SizeNS"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource VS2010RibbonMenuGroupStyle}" TargetType="local:RibbonMenuGroup"/>

</ResourceDictionary>
