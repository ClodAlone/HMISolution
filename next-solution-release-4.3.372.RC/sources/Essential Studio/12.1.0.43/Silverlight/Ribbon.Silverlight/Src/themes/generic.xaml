    <Style x:Key="RibbonGalleryRepeatButtonStyle" TargetType="primitives:RepeatButton">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Background" Value="{StaticResource Blue.Gallery.RepeatButton.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Interval" Value="250"/>
        <Setter Property="Delay" Value="250"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:RepeatButton">
                    <Border x:Name="Root" BorderThickness="1"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							Opacity="{TemplateBinding Opacity}" >
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">

                                <vsm:VisualState x:Name="Normal"/>

                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard  Duration="0">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush" >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#7B6645"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background" >
                                            <DiscreteObjectKeyFrame KeyTime="0"
																	Value="{StaticResource GalleryRepeatButton.IsMouseOver.BackgroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Pressed">
                                    <Storyboard  Duration="0">
                                        <ColorAnimation To="#CAB583" Duration="0"
														Storyboard.TargetName="BackgroundAnimation"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush" >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#7B6645"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background" >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource GalleryRepeatButton.IsPressed.BackgroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard Duration="0">
                                        <DoubleAnimation To="0.65" Duration="0"
														 Storyboard.TargetName="Root"
														 Storyboard.TargetProperty="Opacity" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background" >
                                            <DiscreteObjectKeyFrame KeyTime="0"
																	Value="{StaticResource  GalleryRepeatButton.IsEnabled.BackgroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border x:Name="BackgroundAnimation" BorderBrush="WhiteSmoke" BorderThickness="1" Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"
											  Content="{TemplateBinding Content}" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonGalleryDropDownButtonStyle" TargetType="local:RibbonDropDownItem">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Background" Value="{StaticResource Blue.Gallery.RepeatButton.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonDropDownItem">
                    <Border x:Name="Part_Root" BorderThickness="1"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							Opacity="{TemplateBinding Opacity}" >
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="RibbonItemStates">

                                <vsm:VisualState x:Name="Normal"/>

                                <vsm:VisualState x:Name="Selected">
                                    <Storyboard  Duration="0">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Part_Root" Storyboard.TargetProperty="BorderBrush" >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#7B6645"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Part_Root" Storyboard.TargetProperty="Background" >
                                            <DiscreteObjectKeyFrame KeyTime="0"
																	Value="{StaticResource GalleryRepeatButton.IsMouseOver.BackgroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Pressed">
                                    <Storyboard  Duration="0">
                                        <ColorAnimation To="#CAB583" Duration="0"
														Storyboard.TargetName="ItemBorder"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Part_Root" Storyboard.TargetProperty="BorderBrush" >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#7B6645"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Part_Root" Storyboard.TargetProperty="Background" >
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource GalleryRepeatButton.IsPressed.BackgroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard Duration="0">
                                        <DoubleAnimation To="0.65" Duration="0"
														 Storyboard.TargetName="Part_Root"
														 Storyboard.TargetProperty="Opacity" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Part_Root" Storyboard.TargetProperty="Background" >
                                            <DiscreteObjectKeyFrame KeyTime="0"
																	Value="{StaticResource  GalleryRepeatButton.IsEnabled.BackgroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Grid>
                            <ContentPresenter Content="{TemplateBinding DropDown}"/>

                            <Border x:Name="ItemBorder" BorderBrush="WhiteSmoke" BorderThickness="1" Opacity="{TemplateBinding Opacity}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 0,1 L 8,1" Stroke="{StaticResource PathFill}" />
                                    <Path Data="M 0,2 L 4,6 8,2 Z" Fill="{StaticResource PathFill}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonGallery -->
    <Style TargetType="local:RibbonGallery">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="ItemWidth" Value="60.0"/>
        <Setter Property="ItemHeight" Value="60.0"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue.Ribbon.BorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonGallery">
                    <Border BorderThickness="1" CornerRadius="2" VerticalAlignment="Top"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}" >

                        <vsm:VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="RibbonGalleryMode">

                                <VisualState x:Name="General"/>

                                <VisualState x:Name="Fixed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GeneralHost" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FixedHost" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ScrollUpButton" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ScrollDownButton" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DropDownButton" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                            </VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer x:Name="GeneralHost" Style="{StaticResource ScrollViewerStyle}" Grid.RowSpan="3" BorderThickness="0" Padding="0" >
                                <ItemsPresenter x:Name="ItemsPresenter" Margin="4"/>
                            </ScrollViewer>
                            <ContentControl x:Name="FixedHost" Grid.RowSpan="3" Visibility="Collapsed"
												Height="{TemplateBinding ItemHeight}"
												Foreground="{TemplateBinding Foreground}"/>

                            <primitives:RepeatButton x:Name="ScrollUpButton" Grid.Column="1" Grid.Row="0" IsEnabled="False" Visibility="Collapsed"
														 Style="{StaticResource RibbonGalleryRepeatButtonStyle}" >
                                <Path Data="M 4,0 L 0,4 8,4 Z" Fill="{StaticResource PathFill}"/>
                            </primitives:RepeatButton>
                            <primitives:RepeatButton x:Name="ScrollDownButton" Grid.Column="1" Grid.Row="1" IsEnabled="False" Visibility="Collapsed"
														 Style="{StaticResource RibbonGalleryRepeatButtonStyle}" >
                                <Path Data="M 0,0 L 4,4 8,0 Z" Fill="{StaticResource PathFill}" />
                            </primitives:RepeatButton>
                            <local:RibbonDropDownItem x:Name="DropDownButton" Grid.Column="1" Grid.Row="2" Height="20" Visibility="Collapsed"
													  Style="{StaticResource RibbonGalleryDropDownButtonStyle}" >
                                <local:RibbonDropDownItem.DropDown>
                                    <local:RibbonDropDown MinHeight="{TemplateBinding ItemHeight}" >
                                        <Grid>
                                            <local:RibbonShadow Margin="4,4,0,0"/>

                                            <Border BorderThickness="1" CornerRadius="2"
														Background="{TemplateBinding Background}"
														BorderBrush="{TemplateBinding BorderBrush}" >
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <ScrollViewer x:Name="PopupHost"  Style="{StaticResource ScrollViewerStyle}"  BorderThickness="0" Padding="0"
																	  Foreground="{TemplateBinding Foreground}"
																	  MinHeight="{TemplateBinding ItemHeight}" />

                                                    <ContentControl Grid.Row="1" Margin="4,0,0,0"
																		Foreground="{TemplateBinding Foreground}"
																		Content="{TemplateBinding Footer}"
																		ContentTemplate="{TemplateBinding FooterTemplate}"/>

                                                    <Border x:Name="ThumbBorder" Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#DDE7EE"
																Background="{StaticResource Blue.Gallery.Bottom.Background}">
                                                        <Border x:Name="ResizeThumb" Height="10" Background="Transparent" Cursor="SizeNWSE"
																	HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Path Margin="0,0,2,2"  HorizontalAlignment="Right" VerticalAlignment="Bottom" >
                                                                <Path.Data>
                                                                    <GeometryGroup>
                                                                        <EllipseGeometry Center="0,0" RadiusX="1" RadiusY="1" />
                                                                        <EllipseGeometry Center="4,0" RadiusX="1" RadiusY="1" />
                                                                        <EllipseGeometry Center="4,-4" RadiusX="1" RadiusY="1" />
                                                                    </GeometryGroup>
                                                                </Path.Data>
                                                                <Path.Fill>
                                                                    <LinearGradientBrush>
                                                                        <GradientStop Color="#C0C6D6"/>
                                                                        <GradientStop Color="#5574A7"/>
                                                                    </LinearGradientBrush>
                                                                </Path.Fill>
                                                            </Path>
                                                        </Border>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                        </Grid>
                                    </local:RibbonDropDown>
                                </local:RibbonDropDownItem.DropDown>
                            </local:RibbonDropDownItem>
                        </Grid>

                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:RibbonGalleryPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonSeparator -->
    <!--<Style TargetType="local:RibbonSeparator">
        <Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonSeparator">
                    <StackPanel Width="Auto" VerticalAlignment="Stretch" Orientation="Horizontal">
                        <Rectangle Width="1" VerticalAlignment="Stretch" Fill="{StaticResource Blue.SeparatorBrush}"/>
                        <Rectangle Width="1" VerticalAlignment="Stretch" Fill="White"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Margin" Value="2,0,2,0"/>
    </Style>-->

    <!--RibbonTabsGroup-->
    <Style TargetType="local:RibbonTabsGroup">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--RibbonStatusBar brushes-->
    <SolidColorBrush x:Key="StatusBarBorderDark" Color="#567DB0"/>
    <SolidColorBrush x:Key="StatusBarBorderLight" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="StatusBarLightBackground" EndPoint="0,1">
        <GradientStop Offset="0" Color="#D7E6F9"/>
        <GradientStop Offset="0.3" Color="#C7DCF8"/>
        <GradientStop Offset="0.3" Color="#B3D0F5"/>
        <GradientStop Offset="1" Color="#CDE0F7"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StatusBarDarkBackground" EndPoint="0,1">
        <GradientStop Offset="0" Color="#C5DCF8"/>
        <GradientStop Offset="0.3" Color="#A9CAF7"/>
        <GradientStop Offset="0.3" Color="#90B6EA"/>
        <GradientStop Offset="1" Color="#7495C2"/>
    </LinearGradientBrush>

    <!--RibbonStatusBar-->
    <Style TargetType="local:RibbonStatusBar">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource StatusBarBorderDark}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonStatusBar">
                    <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{TemplateBinding BorderBrush}" >
                                <Border Grid.Column="0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource StatusBarBorderLight}" Background="{StaticResource StatusBarLightBackground}">
                                    <ContentPresenter Content="{TemplateBinding StatusItemsPane}"/>
                                </Border>
                            </Border>
                            <ItemsPresenter Grid.Column="1" />
                            <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{StaticResource StatusBarBorderLight}" HorizontalAlignment="Right">
                                <Border Grid.Column="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource StatusBarBorderLight}" Background="{StaticResource StatusBarDarkBackground}" HorizontalAlignment="Right">
                                    <ContentPresenter Content="{TemplateBinding ControlItemsPane}"/>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
