    <SolidColorBrush x:Key="RibbonListBoxDisabledBackground" Color="#FFD4D0C8" />
    <LinearGradientBrush x:Key="RepeatBackgroundDisabled" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Offset="0" Color="#FFF0F3F6" />
        <GradientStop Offset="0.5" Color="#FFF0F3F6" />
        <GradientStop Offset="0.55" Color="#FFEAEDF1" />
        <GradientStop Offset="0.55" Color="#FFE0E4E8" />
        <GradientStop Offset="1" Color="#FFE8EBEF" />
    </LinearGradientBrush>

    <Style TargetType="local:RibbonListBox">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Background" Value="#FFFFFFFF"/>
        <Setter Property="Foreground" Value="#FF000000"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="BorderBrush" Value="#FF7F9DB9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonListBox">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" Padding="1">
                        <ScrollViewer Style="{StaticResource ScrollViewerStyle}"  Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}" x:Name="ScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonRadioButton -->
    <Style TargetType="local:RibbonRadioButton">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Background" Value="{StaticResource CheckRadioFillNormal}"/>
        <Setter Property="Foreground" Value="{StaticResource Foreground}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource CheckRadioStrokeNormal}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonRadioButton">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse1" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CheckBoxBorderBrushHover}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse2" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CheckBoxInnerBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse3" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CheckRadioOverInnerFillBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="contentPresenter" Duration="0:0:0.25" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".55"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Duration="0:0:0.25" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0.55"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CheckStates">
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ellipse" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PathFill}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unchecked"/>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Canvas Width="13" Height="13">
                                <Ellipse x:Name="ellipse1" Width="13" Height="13" Stroke="{StaticResource CheckBoxBorderBrush}">
                                </Ellipse>
                                <Ellipse x:Name="ellipse2" Fill="{StaticResource CheckBoxInnerBorderBrush}" Canvas.Left="2" Canvas.Top="2" Width="9" Height="9">
                                </Ellipse>
                                <Ellipse x:Name="ellipse3" Fill="{StaticResource CheckRadioInnerFillBrush}" Canvas.Left="3" Canvas.Top="3" Width="7" Height="7">
                                </Ellipse>
                                <Ellipse x:Name="ellipse" Canvas.Left="4" Canvas.Top="4" Width="5" Height="5">
                                </Ellipse>
                            </Canvas>
                            <Ellipse Height="13" x:Name="DisabledVisualElement" Width="13" Opacity="0" Fill="#FFFFFFFF"/>
                        </Grid>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="0,0.5,0,0.5" x:Name="contentPresenter" VerticalAlignment="Center" Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonTextBox -->
    <SolidColorBrush x:Key="ListBorder" Color="#828790"/>
    <Color x:Key="ControlBrushColor">#EEEEEE</Color>
    <SolidColorBrush x:Key="ControlTextBrush" Color="Black"/>

    <Style TargetType="local:RibbonTextBox">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Background" Value="{StaticResource WindowBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ControlTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ListBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonTextBox">
                    <Grid x:Name="RootElement">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <vsm:VisualTransition From="Disabled" GeneratedDuration="0:0:0.25"/>
                                    <vsm:VisualTransition From="MouseOver" GeneratedDuration="0:0:0.25"/>
                                    <vsm:VisualTransition From="ReadOnly" GeneratedDuration="0:0:0.25"/>
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard Duration="0:0:0.25">
                                        <ColorAnimation Storyboard.TargetName="MouseOverBorder"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
														To="#FF99C1E2" />
                                        <ColorAnimation Storyboard.TargetName="Border"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
														To="#5577A3" />
                                        <ColorAnimation Storyboard.TargetName="Border"
														Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
														To="White" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation Storyboard.TargetName="DisabledVisualElement"
														 Storyboard.TargetProperty="Opacity"
														 To="1" />
                                        <ColorAnimation Storyboard.TargetName="Border"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
														To="{StaticResource ControlBrushColor}" />
                                        <ColorAnimation Storyboard.TargetName="ContentElement"
														Storyboard.TargetProperty="(ScrollViewer.Foreground).(SolidColorBrush.Color)"
														To="Gray" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="ReadOnly" >
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation To="1"
														 Storyboard.TargetName="ReadOnlyVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="FocusStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <vsm:VisualTransition From="Focused" GeneratedDuration="0:0:0.25"/>
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Focused">
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation To="1"
														 Storyboard.TargetName="FocusVisualElement"
														 Storyboard.TargetProperty="Opacity"/>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unfocused"/>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border x:Name="Border" Background="Transparent"
								BorderBrush="{StaticResource CheckBoxBorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}" >
                            <Grid>
                                <Border x:Name="ReadOnlyVisualElement" Background="#D2F7F7F7" Opacity="0" />
                                <Border x:Name="MouseOverBorder" BorderThickness="1" BorderBrush="Transparent">
                                    <ScrollViewer x:Name="ContentElement" Style="{StaticResource ScrollViewerStyle}" BorderThickness="0" IsTabStop="False"
												  Padding="{TemplateBinding Padding}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="DisabledVisualElement" Background="#A5F7F7F7" BorderBrush="#A5F7F7F7" Opacity="0" IsHitTestVisible="False"
								BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="FocusVisualElement" Margin="1" Opacity="0" IsHitTestVisible="False"
								BorderBrush="{StaticResource CheckBoxBorderBrushHover}"
								BorderThickness="{TemplateBinding BorderThickness}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonMiniToolBar -->
