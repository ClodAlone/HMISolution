    <!--ApplicationMenu-->
    <Style TargetType="local:ApplicationMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ApplicationMenu">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <!--<ColorAnimation Storyboard.TargetName="ButtonBackground" Storyboard.TargetProperty="(Fill).(Color)" Duration="00:00:00.3" />-->
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OB" Storyboard.TargetProperty="Ellipse.Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppButtonHoverOutterBorderFill}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OB" Storyboard.TargetProperty="Ellipse.Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppButtonHoverOutterBorder}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IB" Storyboard.TargetProperty="Ellipse.Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppButtonHoverInnerBorderFill}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IB" Storyboard.TargetProperty="Ellipse.Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppButtonHoverInnerBorder}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TH" Storyboard.TargetProperty="Ellipse.Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppButtonHoverTopHighlight}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BH" Storyboard.TargetProperty="Ellipse.Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppButtonHoverBottomHighlight}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OB" Storyboard.TargetProperty="Ellipse.Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppButtonExpandedOutterBorderFill}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OB" Storyboard.TargetProperty="Ellipse.Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppButtonExpandedOutterBorder}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IB" Storyboard.TargetProperty="Ellipse.Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppButtonExpandedInnerBorderFill}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IB" Storyboard.TargetProperty="Ellipse.Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppButtonExpandedInnerBorder}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TH" Storyboard.TargetProperty="Ellipse.Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppButtonExpandedTopHighlight}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BH" Storyboard.TargetProperty="Ellipse.Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AppButtonExpandedBottomHighlight}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid x:Name="Part_RootButton" Background="Transparent" Width="38" Height="38">
                            <Ellipse Height="37" Width="37" Name="OB" Fill="{StaticResource OutterBorderFill}" Stroke="{StaticResource OutterBorder}" StrokeThickness="1"/>
                            <Ellipse Height="37" Width="37" Stroke="{StaticResource OutterBorder}" Opacity="0.6" StrokeThickness="1">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="1" Y="0.4" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Height="35" Width="35" Fill="{StaticResource InnerBorderFill}" Name="IB" Stroke="{StaticResource InnerBorder}" />
                            <Ellipse Height="33" Width="33" Fill="{StaticResource TopHighlight}" Name="TH" />
                            <Ellipse Height="33" Width="33" Fill="{StaticResource BottomHighlight}" Name="BH" />
                            <Image Source="{TemplateBinding ApplicationButtonImage}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16" />
                        </Grid>
                        <Popup  x:Name="PART_RibbonDropDown" Grid.Row="1" VerticalOffset="-17" HorizontalOffset="-1">
                            <Canvas x:Name="Part_Root">
                                <Rectangle x:Name="Part_OutsideRect" />
                                <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                                    <Grid.OpacityMask>
                                        <RadialGradientBrush MappingMode="Absolute" Center="22,-2" GradientOrigin="22,-2" RadiusX="20" RadiusY="20">
                                            <GradientStop Offset="0.99" Color="#00000000"/>
                                            <GradientStop Offset="1" Color="#FF000000"/>
                                        </RadialGradientBrush>
                                    </Grid.OpacityMask>
                                    <local:RibbonShadow Margin="4,4,0,0" />
                                    <Border BorderThickness="1" BorderBrush="{StaticResource ApplicationMenuBorder}" CornerRadius="2">
                                        <Border BorderThickness="1" BorderBrush="{StaticResource PopupInnerBorder}" CornerRadius="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Rectangle Grid.Row="0" Height="14" Fill="{StaticResource ApplicationMenuTopBackground}" />
                                                <Border Grid.Row="1" Background="{StaticResource ApplicationMenuSidesBackground}">
                                                    <Border Margin="2,0,2,0" BorderThickness="1" BorderBrush="{StaticResource ApplicationMenuOuterBorder}">
                                                        <Border BorderThickness="1" BorderBrush="{StaticResource ApplicationMenuInnerBorder}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border BorderBrush="{StaticResource DarkBorder}" Background="{TemplateBinding Background}" BorderThickness="0,0,1,0">
                                                                    <ContentPresenter x:Name="Part_MainPanelPresenter"/>
                                                                </Border>

                                                                <Border Grid.Column="1" BorderBrush="{StaticResource LightBorder}" Background="{StaticResource ApplicationMenuContentBackground}" BorderThickness="1,0,0,0">
                                                                    <ContentPresenter x:Name="Part_MenuPanelPresenter"/>
                                                                </Border>
                                                                <Popup Grid.Column="1" x:Name="PART_ApplicationSplitPopup" HorizontalOffset="-2" />
                                                            </Grid>
                                                        </Border>
                                                    </Border>
                                                </Border>

                                                <Border Grid.Row="2" MinHeight="12" Background="{StaticResource ApplicationMenuBottomBackground}">
                                                    <ContentPresenter x:Name="Part_SystemPanelPresenter"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Canvas>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Ribbon Brushes-->
    <SolidColorBrush x:Key="RibbonToolbarBelowBackgroundBrush" Color="#FFAAC5EA"/>
    <SolidColorBrush x:Key="RibbonToolbarBelowOutterBorderBrush" Color="#FF7EA1CD"/>
    <SolidColorBrush x:Key="RibbonToolbarBelowInnerBorderBrush" Color="#FFDCE8F7"/>
    <SolidColorBrush x:Key="RibbonForeground" Color="#FF00156E"/>
    <SolidColorBrush x:Key="RibbonCaptionForeground" Color="#FF00156E"/>

    <!--Ribbon-->
    <Style TargetType="local:Ribbon">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Foreground" Value="{StaticResource RibbonForeground}" />
        <Setter Property="Title" Value="My Application"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <!--<Grid/>-->
                    <StackPanel Height="92"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Ribbon">
                    <Grid x:Name="Ribbon" Background="{StaticResource RibbonBackground}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <!--<RowDefinition Height="24" />-->
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" MaxWidth="42" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <shared:ContextMenuAdvService.ContextMenuAdv>
                            <shared:ContextMenuAdv>
                                <shared:ContextMenuItemAdv Name="PART_MoreCommands"/>
                                <shared:ContextMenuItemAdv Name="PART_ShowBelow"/>
                                <shared:ContextMenuItemAdv Name="PART_Minimize" IsCheckable="True"/>
                            </shared:ContextMenuAdv>
                        </shared:ContextMenuAdvService.ContextMenuAdv>


                        <Border x:Name="Title" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="0 -24" Height="24" BorderThickness="0,0,0,1"  BorderBrush="{StaticResource DarkBorder}" Background="{StaticResource TitleBackground}"/>
                        
                        <Border x:Name="TabBar" Grid.Row="0" Grid.ColumnSpan="2" BorderThickness="0,1,0,0"  BorderBrush="{StaticResource LightBorder}">
                        </Border>
                        
                        <ContentControl Grid.RowSpan="1" Margin="0 -24 0 0" Grid.Row="0" BorderThickness="0" Content="{TemplateBinding ApplicationMenu}" HorizontalAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                        
                        <Grid Margin="-15,-48,0,0" Grid.Column="1" VerticalAlignment="Center" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="PART_QATAboveContainer">
                                <ContentControl BorderThickness="0" Content="{TemplateBinding QuickAccessToolBar}" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        
                        <local:RibbonTitlePanel x:Name="Part_TitlePanel" VerticalAlignment="Top" Height="24" Margin="0 -24 0 0" Grid.Column="1" Caption="{TemplateBinding Title}" Foreground="{StaticResource RibbonCaptionForeground}" Background="Transparent"/>
                        
                        <Border CornerRadius="1" Margin="1" x:Name="Part_QATBorderContainer" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" 
                                BorderThickness="1" BorderBrush="{StaticResource RibbonToolbarBelowOutterBorderBrush}">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0,1">
                                    <GradientStop Color="#FFB2CDED" />
                                    <GradientStop Color="#FFAAC5EA" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid x:Name="PART_QATBelowContainer" />
                        </Border>
                        
                        <ContentPresenter x:Name="Part_NormalTabHost" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch">
                            <ContentControl                                      
                                FontFamily="{TemplateBinding FontFamily}" 
                                FontSize="{TemplateBinding FontSize}" 
                                FontStretch="{TemplateBinding FontStretch}"
                                FontStyle="{TemplateBinding FontStyle}"
                                FontWeight ="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}">
                                <ItemsPresenter  x:Name="Part_TabPresenter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </ContentControl>
                        </ContentPresenter>
                        
                        <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Height="1" Fill="{StaticResource DarkBorder}" VerticalAlignment="Bottom"/>
                        
                        <local:RibbonDropDown x:Name="Part_PopupTabHost" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch">
                            <local:RibbonDropDown.Template>
                                <ControlTemplate>
                                    <Popup x:Name="Part_Popup" >
                                        <Canvas>
                                            <Rectangle x:Name="Part_OutsideRect"/>
                                            <Grid x:Name="Part_GridPopup" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}">
                                                <local:RibbonShadow Margin="4,4,0,0"/>
                                                <ContentPresenter />
                                            </Grid>
                                        </Canvas>
                                    </Popup>
                                </ControlTemplate>
                            </local:RibbonDropDown.Template>
                        </local:RibbonDropDown>
                        
                        <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,-1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:RibbonTabStrip x:Name="Part_TabStrip" Background="Transparent">
                                
                               
                            </local:RibbonTabStrip>
                            <ContentControl Content="{TemplateBinding TabPanelItem}" Grid.Column="1" VerticalAlignment="Center" VerticalContentAlignment="Center" />
