                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonTabItem -->
    <LinearGradientBrush x:Key="Blue.TabButton.SelectedBrush" EndPoint="0.5, 0" StartPoint="0.5, 1">
        <GradientStop Color="#FFDEE8F5" Offset="0"/>
        <GradientStop Color="#FFF4F9FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Blue.TabButton.HoverTabHighlight" EndPoint="0.5, 1" StartPoint="0.5, 0">
        <GradientStop Color="#FFE3D198" Offset="1"/>
        <GradientStop Color="Transparent" Offset="0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Blue.Ribbon.BorderBrush" Color="#FF8DB2E3"/>
    <Color x:Key="Blue.RibbonTapPanel.SeparatorColor.Start">#328DB2E3</Color>
    <Color x:Key="Blue.RibbonTapPanel.SeparatorColor.End"  >#FF8DB2E3</Color>
    <Color x:Key="Blue.Foreground">#FF00156E</Color>

    <Style TargetType="local:TabButton" x:Key="Syncfusion.Windows.Tools.Controls.RibbonTabItem">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Foreground">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Blue.Foreground}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="MinWidth" Value="23"/>
        <Setter Property="SeparatorOpacity" Value="0"/>
        <Setter Property="Height" Value="23"/>
        <Setter Property="Padding" Value="2,0,2,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabButton">
                    <Grid x:Name="RootElement">
                        <vsm:VisualStateManager.VisualStateGroups>

                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <vsm:VisualTransition From="MouseOver" GeneratedDuration="0:0:0.25"/>
                                    <vsm:VisualTransition From="Selected" GeneratedDuration="0:0:0.25"/>
                                    <vsm:VisualTransition From="SelectedMouseOver" GeneratedDuration="0:0:0.25"/>
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Normal" />

                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard Duration="0:0:0.25">
                                        <Storyboard>
                                            <DoubleAnimation To="0.75" Duration="0:0:0.25"
														 Storyboard.TargetName="HighlightBorder"
														 Storyboard.TargetProperty="Opacity" />
                                            <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="HighlightEdge"
														 Storyboard.TargetProperty="Opacity" />
                                        </Storyboard>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Selected">
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="Left"
														 Storyboard.TargetProperty="Opacity" />
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="Right"
														 Storyboard.TargetProperty="Opacity" />
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="SelectedBackground"
														 Storyboard.TargetProperty="Opacity" />
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="HighlightEdge"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="SelectedMouseOver">
                                    <Storyboard Duration="0:0:0.25">
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="Left"
														 Storyboard.TargetProperty="Opacity" />
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="Right"
														 Storyboard.TargetProperty="Opacity" />
                                        <DoubleAnimation To="0.75" Duration="0:0:0.25"
														Storyboard.TargetName="HighlightBorderSelected"
														Storyboard.TargetProperty="Opacity"/>
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="SelectedBackground"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>

                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border Height="23" Margin="0,0,1,0"
								BorderBrush="{TemplateBinding BorderBrush}"
								Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="HighlightBorder" Grid.Column="1" Height="23" Opacity="0"
										BorderThickness="1,1,1,1" CornerRadius="4,4,0,0" Margin="-1,0,-1,0"
										BorderBrush="{StaticResource Blue.Ribbon.BorderBrush}"
										Background="{StaticResource Blue.TabButton.HoverTabHighlight}"/>
                                <Border x:Name="HighlightEdge" Grid.Column="1" Height="21" Opacity="0"
										CornerRadius="3,3,0,0" BorderThickness="1,1,1,0" BorderBrush="WhiteSmoke"/>

                                <Grid x:Name="SelectedBackground" Grid.Column="1" Opacity="0">
                                    <Border x:Name="SelectedBackgroundBorder" Height="23" CornerRadius="4,4,0,0" Margin="-1,0,-1,0"
											Background="{StaticResource Blue.TabButton.SelectedBrush}" />
                                    <Border Height="20" CornerRadius="4,4,0,0" BorderThickness="1,1,1,0" Margin="-1,0,-1,0"
											VerticalAlignment="Top"
											BorderBrush="{StaticResource Blue.Ribbon.BorderBrush}"/>
                                </Grid>

                                <Border x:Name="Left" Grid.Column="0" VerticalAlignment="Bottom" Width="6" Height="6" Opacity="0"
										BorderThickness="1" CornerRadius="3" Margin="-3,0,0,0"
										BorderBrush="{StaticResource Blue.Ribbon.BorderBrush}">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="3,3,3,3"/>
                                    </Border.Clip>
                                </Border>

                                <Border x:Name="Right" Grid.Column="2" VerticalAlignment="Bottom" Width="6" Height="6" Opacity="0"
										BorderThickness="1" CornerRadius="3"
										BorderBrush="{StaticResource Blue.Ribbon.BorderBrush}">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,3,3,3"/>
                                    </Border.Clip>
                                </Border>

                                <Border Height="23" Grid.Column="1" Margin="1,0,1,0" BorderThickness="0,1,0,0" Padding="12,0">
                                    <TextBlock x:Name="Caption" TextAlignment="Center" VerticalAlignment="Center"
											   Margin="{TemplateBinding Padding}"
											   Foreground="{TemplateBinding Foreground}" TextTrimming="WordEllipsis"
											   Text="{TemplateBinding Caption}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" FontStyle="{TemplateBinding FontStyle}" FontWeight="{TemplateBinding FontWeight}"/>
                                </Border>

                                <Border x:Name="HighlightBorderSelected" Grid.Column="1" Height="20" Margin="-2,0,-2,0" Opacity="0" 
										CornerRadius="4,4,0,0" BorderThickness="2,2,2,0" BorderBrush="#FFF4C663"
										VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <Rectangle Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,1,0"
								   Opacity="{TemplateBinding SeparatorOpacity}">
                            <Rectangle.Fill>
                                <LinearGradientBrush>
                                    <GradientStop Offset="0.0" Color="{StaticResource Blue.RibbonTapPanel.SeparatorColor.Start}"/>
                                    <GradientStop Offset="0.3" Color="{StaticResource Blue.RibbonTapPanel.SeparatorColor.End}"/>
                                    <GradientStop Offset="1.0" Color="{StaticResource Blue.RibbonTapPanel.SeparatorColor.End}"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollStrip -->
    <LinearGradientBrush x:Key="Blue.Ribbon.Background" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#E7F2FF" Offset="0.0"/>
        <GradientStop Color="#C9D9ED" Offset="0.77"/>
        <GradientStop Color="#CFDDEF" Offset="0.77"/>
        <GradientStop Color="#E0EAF6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Blue.ImageBorder.BorderBrush" Color="#FFAAC3D9"/>
    <SolidColorBrush x:Key="Blue.Path.Fill" Color="#FF567DB1"/>
    <LinearGradientBrush x:Key="Luna.MouseOverBrush.Default" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FFF9D1" Offset="1"/>
        <GradientStop Color="#FFEAA3" Offset="0.65"/>
        <GradientStop Color="#FFD75C" Offset="0.6"/>
        <GradientStop Color="#FFD456" Offset="0.25"/>
        <GradientStop Color="#FFE395" Offset="0.05"/>
        <GradientStop Color="#FFEAAD" Offset="0"/>
    </LinearGradientBrush>

    <ControlTemplate x:Key="RibbonScrollButtonTemplate" TargetType="primitives:RepeatButton">
        <Border x:Name="Root" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
						BorderThickness="0,0,1,0" CornerRadius="3,0,0,3"
						BorderBrush="{TemplateBinding BorderBrush}"
						Background="{TemplateBinding Background}"
						Opacity="{TemplateBinding Opacity}" >

            <vsm:VisualStateManager.VisualStateGroups>

                <vsm:VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition From="MouseOver"/>
                        <VisualTransition From="Pressed"/>
                    </VisualStateGroup.Transitions>

                    <vsm:VisualState x:Name="Normal"/>
                    <vsm:VisualState x:Name="Disabled"/>

                    <vsm:VisualState x:Name="MouseOver">
                        <Storyboard Duration="0">
                            <DoubleAnimation Duration="0:0:0.25" To="1"
													 Storyboard.TargetName="BackgroundAnimation"
													 Storyboard.TargetProperty="Opacity" />
                            <ObjectAnimationUsingKeyFrames Duration="0"
																   Storyboard.TargetName="BackgroundAnimation"
																   Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame Value="{StaticResource Luna.MouseOverBrush.Default}" KeyTime="0"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </vsm:VisualState>

                    <vsm:VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation To="1" Duration="0"
														 Storyboard.TargetName="BackgroundAnimation" Storyboard.TargetProperty="Opacity"/>
                        </Storyboard>
                    </vsm:VisualState>

                </vsm:VisualStateGroup>

            </vsm:VisualStateManager.VisualStateGroups>

            <Border x:Name="BackgroundAnimation" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
							BorderBrush="White" BorderThickness="0,0,1,0" CornerRadius="3,0,0,3"
							Background="{TemplateBinding Background}"
							Opacity="{TemplateBinding Opacity}" >
                <Path Data="M 4 0 L 4 8 L 0 4 Z" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2"
								  Fill="{StaticResource Blue.Path.Fill}" />
            </Border>
        </Border>
    </ControlTemplate>


    <!-- RibbonTabStrip -->
    <Style TargetType="local:RibbonTabStrip">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
        	<Setter.Value>
        		<ControlTemplate TargetType="local:ScrollStrip">
			        <Grid x:Name="RootElement">
			            <vsm:VisualStateManager.VisualStateGroups>
			                <VisualStateGroup x:Name="LeftScrollButtonState">
			                    <VisualStateGroup.Transitions>
			                        <VisualTransition From="LeftVisible" GeneratedDuration="0:0:0.25"/>
			                    </VisualStateGroup.Transitions>
			                    <VisualState x:Name="LeftNormal"/>
			                    <VisualState x:Name="LeftVisible">
			                        <Storyboard Duration="0:0:0.25">
			                            <DoubleAnimation To="1" Duration="0:0:0.25"
																	 Storyboard.TargetName="LeftScroll"
																	 Storyboard.TargetProperty="Opacity" />
			                            <ObjectAnimationUsingKeyFrames
														Storyboard.TargetName="LeftScroll"
														Storyboard.TargetProperty="Visibility">
			                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
			                            </ObjectAnimationUsingKeyFrames>
			                            <ObjectAnimationUsingKeyFrames
														Storyboard.TargetName="LeftScroll"
														Storyboard.TargetProperty="IsEnabled">
			                                <DiscreteObjectKeyFrame KeyTime="0" Value="True"/>
			                            </ObjectAnimationUsingKeyFrames>
			                        </Storyboard>
			                    </VisualState>

			                </VisualStateGroup>

			                <VisualStateGroup x:Name="RightScrollButtonState">
			                    <VisualStateGroup.Transitions>
			                        <VisualTransition From="RightVisible" GeneratedDuration="0:0:0.25"/>
			                    </VisualStateGroup.Transitions>

			                    <VisualState x:Name="RightNormal" />

			                    <VisualState x:Name="RightVisible">
			                        <Storyboard Duration="0:0:0.25">
			                            <DoubleAnimation To="1" Duration="0:0:0.25"
																	 Storyboard.TargetName="RightScroll"
																	 Storyboard.TargetProperty="Opacity" />
			                            <ObjectAnimationUsingKeyFrames
														Storyboard.TargetName="RightScroll"
														Storyboard.TargetProperty="Visibility">
			                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
			                            </ObjectAnimationUsingKeyFrames>
			                            <ObjectAnimationUsingKeyFrames
														Storyboard.TargetName="RightScroll"
														Storyboard.TargetProperty="IsEnabled">
			                                <DiscreteObjectKeyFrame KeyTime="0" Value="True"/>
			                            </ObjectAnimationUsingKeyFrames>
			                        </Storyboard>
			                    </VisualState>

			                </VisualStateGroup>

			                <vsm:VisualStateGroup x:Name="FocusStates">
			                    <vsm:VisualState x:Name="Focused" />
			                    <vsm:VisualState x:Name="Unfocused" />
			                </vsm:VisualStateGroup>

			            </vsm:VisualStateManager.VisualStateGroups>

			            <Border CornerRadius="2" x:Name="Part_Background"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}">
			                <ItemsPresenter x:Name="ItemsPresenter"/>
			            </Border>

			            <Grid>
			                <Grid.Resources>
			                    <Style x:Key="RibbonScrollButtonStyle" TargetType="primitives:RepeatButton">
			                        <Setter Property="Foreground">
			                            <Setter.Value>
			                                <SolidColorBrush Color="{StaticResource Blue.Foreground}"/>
			                            </Setter.Value>
			                        </Setter>
			                        <Setter Property="Background" Value="{StaticResource Blue.Ribbon.Background}"/>
			                        <Setter Property="BorderBrush" Value="{StaticResource Blue.ImageBorder.BorderBrush}"/>
			                        <Setter Property="VerticalAlignment" Value="Stretch"/>
			                        <Setter Property="Opacity" Value="0"/>
			                        <Setter Property="Width" Value="10"/>
			                        <Setter Property="Visibility" Value="Collapsed"/>
			                        <Setter Property="IsEnabled" Value="False"/>
			                        <Setter Property="Interval" Value="250"/>
			                        <Setter Property="Delay" Value="250"/>
			                        <Setter Property="IsTabStop" Value="False"/>
			                        <Setter Property="Template" Value="{StaticResource RibbonScrollButtonTemplate}"/>
			                    </Style>
			                </Grid.Resources>

			                <primitives:RepeatButton x:Name="LeftScroll"  HorizontalAlignment="Left"  Style="{StaticResource RibbonScrollButtonStyle}" Margin="0,1,0,1"/>
			                <primitives:RepeatButton x:Name="RightScroll" HorizontalAlignment="Right" Style="{StaticResource RibbonScrollButtonStyle}" Margin="0,1,0,1">
			                    <RepeatButton.RenderTransform>
			                        <ScaleTransform ScaleX="-1" ScaleY="1" CenterX="5"/>
			                    </RepeatButton.RenderTransform>
			                </primitives:RepeatButton>
			            </Grid>

			        </Grid>
			    </ControlTemplate>    
			</Setter.Value>      
		</Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:RibbonTabPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--RibbonTab brushes-->
    <LinearGradientBrush x:Key="RibbonTabBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#DEE8F5" />
        <GradientStop Offset="0.2" Color="#D1DFF0" />
        <GradientStop Offset="0.2" Color="#C7D8ED" />
        <GradientStop Offset="1" Color="#E3F4FF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonTabBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.9" Color="#8DB2E3" />
        <GradientStop Offset="1" Color="#96AAC4" />
    </LinearGradientBrush>

    <!-- RibbonTab -->
    <Style TargetType="local:RibbonTab">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Caption" Value="Ribbon Tab" />
        <Setter Property="Background" Value="{StaticResource RibbonTabBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RibbonTabBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!--<Setter Property="MinHeight" Value="25"/>-->
        <Setter Property="MinHeight" Value="92"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:RibbonPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="TabButtonStyle" Value="{StaticResource Syncfusion.Windows.Tools.Controls.RibbonTabItem}"/>
