                </primitives:RepeatButton>
            </Grid>

        </Grid>
    </ControlTemplate>
			</Setter.Value>
		</Setter>
    </Style>

    <!-- RibbonCheckBox -->
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" x:Key="CheckRadioInnerBorderBrush">
        <GradientStop Color="#CACFD5" Offset="0"/>
        <GradientStop Color="#F6F6F6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" x:Key="CheckRadioInnerFillBrush">
        <GradientStop Color="#A2ABB9" Offset="0"/>
        <GradientStop Color="#E4E6EA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" x:Key="CheckRadioOverInnerBorderBrush">
        <GradientStop Color="#FAD57A" Offset="0"/>
        <GradientStop Color="#FFF1CF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" x:Key="CheckRadioOverInnerFillBrush">
        <GradientStop Color="#FCE7AF" Offset="0"/>
        <GradientStop Color="#FEF8E7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CheckRadioFillNormal">
        <GradientStop Color="#FFD2D4D2" Offset="0"/>
        <GradientStop Color="#FFFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CheckRadioStrokeNormal">
        <GradientStop Color="#FF004C94" Offset="0"/>
        <GradientStop Color="#FF003C74" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" x:Key="CheckBoxInnerBorderBrush">
        <GradientStop Color="#CACFD5" Offset="0"/>
        <GradientStop Color="#F6F6F6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PathFill" Color="#FF567DB1"/>
    <Color x:Key="CheckBoxBorderBrushHover.Color1">#5577A3</Color>
    <SolidColorBrush x:Key="CheckBoxBorderBrushHover" Color="{StaticResource CheckBoxBorderBrushHover.Color1}"/>
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#ABC1DE"/>

    <Style TargetType="local:RibbonCheckBox">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Background" Value="{StaticResource CheckRadioFillNormal}"/>
        <Setter Property="Foreground" Value="{StaticResource Foreground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CheckRadioStrokeNormal}" />
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Margin" Value="3,3,3,3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonCheckBox">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="border1" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CheckBoxBorderBrushHover}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="border2" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="border3" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CheckRadioOverInnerBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="border3" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CheckRadioOverInnerFillBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="contentPresenter" Duration="0:0:0.25" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="0" Value=".55"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Duration="0:0:0.25" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0.55"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="CheckStates">
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="path" Duration="0:0:0.25" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unchecked"/>
                                <vsm:VisualState x:Name="Indeterminate">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IndeterminateIcon" Duration="0:0:0.25" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border x:Name="border1" Width="13" Height="13" BorderBrush="{StaticResource CheckBoxBorderBrush}" BorderThickness="1" Background="White">
                                <Border x:Name="border2" BorderBrush="{StaticResource CheckBoxInnerBorderBrush}" BorderThickness="1">
                                    <Border x:Name="border3" BorderThickness="1" Background="{StaticResource CheckRadioInnerFillBrush}" BorderBrush="{StaticResource CheckRadioInnerBorderBrush}">
                                        <Canvas>
                                            <Path x:Name="path"   Opacity="0" Fill="{StaticResource PathFill}" >
                                                <Path.Data>
                                                    <PathGeometry>
                                                        <PathFigure StartPoint="2,4">
                                                            <LineSegment Point="3,6"/>
                                                            <LineSegment Point="5,-1"/>
                                                            <LineSegment Point="7,-1"/>
                                                            <LineSegment Point="4,8"/>
                                                            <LineSegment Point="2,8"/>
                                                            <LineSegment Point="0,5"/>
                                                        </PathFigure>
                                                    </PathGeometry>
                                                </Path.Data>
                                            </Path>
                                        </Canvas>
                                    </Border>
                                </Border>
                            </Border>
                            <Rectangle Height="2"  x:Name="IndeterminateIcon" Width="6" Opacity="0" Fill="#FF333333"/>
                            <Rectangle Height="13" x:Name="DisabledVisualElement" Width="13" Opacity="0" Fill="#FFFFFFFF" RadiusX="1" RadiusY="1"/>
                        </Grid>
                        <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="0,0.5,0,0.5"   x:Name="contentPresenter" VerticalAlignment="Center" Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonComboBox brushes -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFEAF2FB" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFB3C7E1" />
    <SolidColorBrush x:Key="WindowTextBrush" Color="Black" />
    <SolidColorBrush x:Key="ControlColor" Color="LightGray" />
    <SolidColorBrush x:Key="WindowBrush" Color="Gainsboro" />
    <SolidColorBrush x:Key="WindowFrameBrush" Color="DarkGray" />
    <LinearGradientBrush x:Key="ComboThumbBackgroundHover" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Offset="0" Color="#FFE4F0FE" />
        <GradientStop Offset="0.5" Color="#FFDAE7F9" />
        <GradientStop Offset="0.5" Color="#FFCFDFF3" />
        <GradientStop Offset="1" Color="#FFE8F1FD" />
    </LinearGradientBrush>
    <LinearGradientBrush  x:Key="ToggleButton.IsCheckedBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FAB75A" Offset="1"/>
        <GradientStop Color="#FCDC8B" Offset="0.55"/>
        <GradientStop Color="#FDE89F" Offset="0.35"/>
        <GradientStop Color="#FDEFAA" Offset="0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenuButton.InnerBorderBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FFFFFFFA" Offset="1"/>
        <GradientStop Color="#FFFFF6BB" Offset="0.231"/>
        <GradientStop Color="#FFFFF364" Offset="0"/>
    </LinearGradientBrush>

    <!-- RibbonComboBox -->
    <Style TargetType="local:RibbonComboBox">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Foreground" Value="{StaticResource WindowTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource ComboBoxBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ComboBoxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5,1,5,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonComboBox">
                    <Grid x:Name="LayoutRoot">
                        <Grid.Resources>
                            <Storyboard x:Key="aniHidePopup">
                                <DoubleAnimation To="0" Duration="0:0:0.25"
												 Storyboard.TargetName="PopupBorder"
												 Storyboard.TargetProperty="Opacity" />
                            </Storyboard>
                            <Storyboard x:Key="aniOpenPopup">
                                <DoubleAnimation To="1" Duration="0:0:0.25"
												 Storyboard.TargetName="PopupBorder"
												 Storyboard.TargetProperty="Opacity"/>
                            </Storyboard>
                            <Storyboard x:Key="aniMouseOver" >
                                <ColorAnimation Duration="0:0:0.25"
												Storyboard.TargetName="ContentPresenterBorder"
												Storyboard.TargetProperty="(UIElement.Background).(SolidColorBrush.Color)" To="White" />
                            </Storyboard>
                        </Grid.Resources>

                        <vsm:VisualStateManager.VisualStateGroups>

                            <vsm:VisualStateGroup x:Name="CommonStates">

                                <vsm:VisualStateGroup.Transitions>
                                    <VisualTransition From="MouseOver" GeneratedDuration="0:0:0.25"/>
                                    <VisualTransition From="Disabled" GeneratedDuration="0:0:0.25"/>
                                </vsm:VisualStateGroup.Transitions>

                                <VisualState x:Name="Normal"/>

                                <VisualState x:Name="MouseOver" />

                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation To=".55" Duration="0:0:0.25"
														 Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="Opacity"/>
                                    </Storyboard>
                                </VisualState>

                            </vsm:VisualStateGroup>

                            <vsm:VisualStateGroup x:Name="FocusStates">

                                <vsm:VisualStateGroup.Transitions>
                                    <vsm:VisualTransition From="FocusedDropDown" GeneratedDuration="0:0:0.25"/>
                                    <vsm:VisualTransition From="Focused" GeneratedDuration="0:0:0.25"/>
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="FocusVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Unfocused"/>

                                <vsm:VisualState x:Name="FocusedDropDown">
                                    <Storyboard>
                                        <DoubleAnimation To="1" Duration="0:0:0.25"
														 Storyboard.TargetName="FocusVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="PopupBorder"
											Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ColorAnimation Duration="0:0:0.25"
												Storyboard.TargetName="ContentPresenterBorder"
												Storyboard.TargetProperty="(UIElement.Background).(SolidColorBrush.Color)" To="White" />
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>

                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border x:Name="ContentPresenterBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.Resources>
                                    <Style x:Key="comboToggleStyle" TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="ClickMode" Value="Press"/>
                                        <Setter Property="Foreground" Value="#FF333333"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="2,0,2,0"/>
                                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <vsm:VisualStateManager.VisualStateGroups>
                                                            <vsm:VisualStateGroup x:Name="CommonStates">
                                                                <vsm:VisualStateGroup.Transitions>
                                                                    <VisualTransition From="MouseOver" GeneratedDuration="0:0:0.25" />
                                                                    <VisualTransition From="Pressed" GeneratedDuration="0:0:0.25" />
                                                                </vsm:VisualStateGroup.Transitions>

                                                                <vsm:VisualState x:Name="Normal" />
                                                                <vsm:VisualState x:Name="MouseOver">
                                                                    <Storyboard>
                                                                        <ColorAnimation To="#FFAFC4DF" Duration="0:0:0.25"
														Storyboard.TargetName="Background"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"/>
                                                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderThickness">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="1" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="Background" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{StaticResource ComboThumbBackgroundHover}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </vsm:VisualState>
                                                                <vsm:VisualState x:Name="Pressed" >
                                                                    <Storyboard>
                                                                        <DoubleAnimation Duration="0:0:0.25" To="1"
														 Storyboard.TargetName="BtnArrowHost"
														 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" />
                                                                        <DoubleAnimation Duration="0:0:0.25" To="1"
														 Storyboard.TargetName="BtnArrowHost"
														 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" />
                                                                    </Storyboard>
                                                                </vsm:VisualState>
                                                                <vsm:VisualState x:Name="Disabled">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Duration="0:0:0.25" To=".55"
														 Storyboard.TargetName="DisabledVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                                                    </Storyboard>
                                                                </vsm:VisualState>
                                                            </vsm:VisualStateGroup>
                                                            <vsm:VisualStateGroup x:Name="CheckStates">
                                                                <vsm:VisualStateGroup.Transitions>
                                                                    <VisualTransition From="Checked" GeneratedDuration="0:0:0.25" />
                                                                </vsm:VisualStateGroup.Transitions>

                                                                <vsm:VisualState x:Name="Checked">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderThickness">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="1" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                        <ColorAnimation To="#9A8F63" Duration="0:0:0.25"
														Storyboard.TargetName="Background"
														Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"/>
                                                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="ComboThumb" Storyboard.TargetProperty="BorderThickness">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="1" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="Background" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{StaticResource ToggleButton.IsCheckedBrush}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
											Storyboard.TargetName="ComboThumb" Storyboard.TargetProperty="Background">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{StaticResource MenuButton.InnerBorderBrush}" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </vsm:VisualState>
                                                                <vsm:VisualState x:Name="Unchecked"/>
                                                            </vsm:VisualStateGroup>
                                                            <vsm:VisualStateGroup x:Name="FocusStates">
                                                                <vsm:VisualState x:Name="Focused">
                                                                    <Storyboard>
                                                                        <ObjectAnimationUsingKeyFrames  Duration="0:0:0.25"
																		Storyboard.TargetName="FocusVisualElement"
																		Storyboard.TargetProperty="Visibility">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="Visible"/>
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </vsm:VisualState>
                                                                <vsm:VisualState x:Name="Unfocused" />
                                                            </vsm:VisualStateGroup>
                                                        </vsm:VisualStateManager.VisualStateGroups>

                                                        <Border x:Name="Background" Width="16"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								Background="{TemplateBinding Background}" >
                                                            <Border x:Name="ComboThumb" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
										BorderBrush="{TemplateBinding BorderBrush}" >
                                                                <Border x:Name="BtnArrowHost">
                                                                    <Border.RenderTransform>
                                                                        <TranslateTransform X="0" Y="0"/>
                                                                    </Border.RenderTransform>
                                                                    <Path x:Name="BtnArrow" Data="M0,0L3.5,4 7,0z" Height="4" Width="8" Stretch="Uniform"
											HorizontalAlignment="Center" VerticalAlignment="Center"
											Fill="{StaticResource PathFill}"/>
                                                                </Border>
                                                            </Border>
                                                        </Border>
                                                        <Rectangle x:Name="DisabledVisualElement" RadiusX="1" RadiusY="1" Fill="#FFFFFFFF" Opacity="0" IsHitTestVisible="false" />
                                                        <Rectangle x:Name="FocusVisualElement" RadiusX="0.5" RadiusY="0.5" Margin="1"  Stroke="#FF6DBDD1" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="false" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="ContentPresenter"
                                                  Margin="{TemplateBinding Padding}"  
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" >
                                    <TextBlock Text=" "/>
                                </ContentPresenter>

                                <ToggleButton x:Name="DropDownToggle" Grid.Column="1" Style="{StaticResource comboToggleStyle}" />
                            </Grid>
                        </Border>
                        <Rectangle x:Name="DisabledVisualElement" RadiusX="1" RadiusY="3" Fill="White" Opacity="0" IsHitTestVisible="false" />
                        <Rectangle x:Name="FocusVisualElement" RadiusY="2" Margin="1"  Stroke="#FF6DBDD1" StrokeThickness="1" Opacity="0" IsHitTestVisible="false" />
                        <Popup x:Name="Popup" Canvas.ZIndex="10">
                            <Grid x:Name="PopupBorder" Opacity="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <local:RibbonShadow Margin="4,4,0,0" />
                                <Border CornerRadius="3"
									Background="{TemplateBinding Background}"
									BorderBrush="{StaticResource WindowFrameBrush}"
									BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer x:Name="ScrollViewer"  Style="{StaticResource ScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  BorderThickness="0" Padding="1" >
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonComboBoxItem -->
    <LinearGradientBrush x:Key="MenuButton.OuterBorderBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FFDDCE9A" Offset="1"/>
        <GradientStop Color="#FFC1A978" Offset="0.486"/>
        <GradientStop Color="#FFD3CEBB" Offset="0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenuButton.MouseOverBrush" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFDF8EE" Offset="0"/>
        <GradientStop Color="#FFFFECA8" Offset="0.3"/>
        <GradientStop Color="#FFFCD987" Offset="0.36666666666666664"/>
        <GradientStop Color="#FFFEDD70" Offset="0.6"/>
        <GradientStop Color="#FFFFD694" Offset="0.7"/>
        <GradientStop Color="#FFFDE599" Offset="0.93333333333333335"/>
        <GradientStop Color="#FFF3E7B5" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="local:RibbonComboBoxItem">
        <!--<Setter Property="shared:SkinManager.SkinList" Value="{StaticResource SkinList}"/>-->
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonComboBoxItem">
                    <Grid Background="{TemplateBinding Background}">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <VisualTransition From="MouseOver" GeneratedDuration="0:0:0.25" />
                                    <VisualTransition From="Disabled" GeneratedDuration="0:0:0.25" />
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
																	   Storyboard.TargetName="InnerBorder"
																	   Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuButton.InnerBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
																	   Storyboard.TargetName="InnerBorder"
																	   Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuButton.MouseOverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Duration="0:0:0.25" To="1"
														 Storyboard.TargetName="InnerBorder"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.25" To=".55"
														 Storyboard.TargetName="contentPresenter"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="SelectionStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <VisualTransition From="Selected" GeneratedDuration="0:0:0.25" />
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Unselected" />
                                <vsm:VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
																	   Storyboard.TargetName="OuterBorder"
																	   Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuButton.OuterBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0:0:0.25"
																	   Storyboard.TargetName="OuterBorder"
																	   Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuButton.MouseOverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="FocusStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <VisualTransition From="Focused" GeneratedDuration="0:0:0.25" />
                                </vsm:VisualStateGroup.Transitions>

                                <vsm:VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.25" To="1"
														 Storyboard.TargetName="FocusVisualElement"
														 Storyboard.TargetProperty="Opacity" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unfocused" />
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>

                        <Border x:Name="OuterBorder" BorderThickness="1"
								BorderBrush="{TemplateBinding BorderBrush}"
								Background="{TemplateBinding Background}"
								Opacity="{TemplateBinding Opacity}" >
                            <Grid>
                                <Border x:Name="InnerBorder" BorderThickness="1" Opacity="0" HorizontalAlignment="Stretch"/>
                                <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Left"
												  Content="{TemplateBinding Content}"
												  ContentTemplate="{TemplateBinding ContentTemplate}"
												  Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>

                        <Rectangle x:Name="FocusVisualElement" Stroke="#FF6DBDD1" StrokeThickness="1" Opacity="0" RadiusX="1" RadiusY="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RibbonListBox -->
    <SolidColorBrush x:Key="RepeatBorderBrush" Color="#FFB9D0ED"/>
    <LinearGradientBrush x:Key="RepeatBorderBackgroundEanbled" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Offset="0" Color="#FFDEEBFE" />
        <GradientStop Offset="0.5" Color="#FFE0EEFF" />
        <GradientStop Offset="0.55" Color="#FFCBDEF6" />
        <GradientStop Offset="0.55" Color="#FFC1D5F1" />
        <GradientStop Offset="1" Color="#FFCFE0F7" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RepeatBorderPressedBrush" Color="#9A8F63" />
    <LinearGradientBrush x:Key="RepeatBackgroundPressedBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FAB75A" Offset="1"/>
        <GradientStop Color="#FCDC8B" Offset="0.55"/>
        <GradientStop Color="#FDE89F" Offset="0.35"/>
        <GradientStop Color="#FDEFAA" Offset="0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RepeatBorderMouseOverBrush" Color="#DBCE99" />
    <LinearGradientBrush x:Key="RepeatBackgroundMouseOverBrush" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#FFD462" Offset="1"/>
        <GradientStop Color="#FFE083" Offset="0.55"/>
        <GradientStop Color="#FFE69B" Offset="0.2"/>
        <GradientStop Color="#FFEAA7" Offset="0"/>
