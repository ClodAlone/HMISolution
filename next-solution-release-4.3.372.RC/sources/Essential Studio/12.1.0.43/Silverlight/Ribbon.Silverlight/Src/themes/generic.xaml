                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background" Value="{StaticResource Blue.Ribbon.Background}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Blue.ImageBorder.BorderBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="Width" Value="10"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="IsEnabled" Value="False"/>
                        <Setter Property="Interval" Value="250"/>
                        <Setter Property="Delay" Value="250"/>
                        <Setter Property="IsTabStop" Value="False"/>
                        <Setter Property="Template" Value="{StaticResource RibbonScrollButtonTemplate}"/>
                    </Style>
                </Grid.Resources>

                <primitives:RepeatButton x:Name="LeftScroll"  HorizontalAlignment="Left"  Style="{StaticResource RibbonScrollButtonStyle}" Margin="0,1,0,1"/>
                <primitives:RepeatButton x:Name="RightScroll" HorizontalAlignment="Right" Style="{StaticResource RibbonScrollButtonStyle}" Margin="0,1,0,1">
                    <RepeatButton.RenderTransform>
                        <ScaleTransform ScaleX="-1" ScaleY="1" CenterX="5"/>
