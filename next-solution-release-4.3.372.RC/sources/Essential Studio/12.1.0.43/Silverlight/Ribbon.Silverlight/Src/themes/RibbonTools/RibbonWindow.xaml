<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  xmlns:context="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls" xmlns:shared="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight">

    <LinearGradientBrush x:Key="Blue.TitleBar.ActiveBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#E4EBF6" Offset="0.0"/>
                <!--<GradientStop Color="#DAE9FD" Offset="0.13"/>
        <GradientStop Color="#D5E5FA" Offset="0.14"/>-->
                <GradientStop Color="#D9E7F9" Offset="0.3"/>
                <GradientStop Color="#CADEF7" Offset="0.3"/>
                <GradientStop Color="#E4EFFD" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Blue.SystemButton.Brush1" Color="#FF656565"/>
    <SolidColorBrush x:Key="Blue.SystemButton.Brush2" Color="#FF7A8DA7"/>
    <SolidColorBrush x:Key="Blue.SystemButton.Brush3" Color="#FFF8F9FA"/>
    <SolidColorBrush x:Key="Window.ActiveBorderBrush" Color="#395984"/>
    <LinearGradientBrush x:Key="Window.BackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <!--<GradientStop Color="#BFDBFF" Offset="0.0"/>-->
        <GradientStop Color="#BFDBFF" Offset="0.2"/>
        <GradientStop Color="#608BC3" Offset="1.0"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BorderBrushHover" Color="#B9D0EC"/>

    <LinearGradientBrush x:Key="BackgroundHover" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#F8FAFF" Offset="0.356" />
        <GradientStop Color="#E4EFFD" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BorderBrushPressed" Color="#A1BEE3"/>
    <SolidColorBrush x:Key="Blue.MouseOver.BorderBrush" Color="#FFE8DEC0"/>

    <LinearGradientBrush x:Key="BackgroundPressed" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Offset="0" Color="#FFECF2FA" />
        <GradientStop Offset="0.5" Color="#FFBFDBF6" />
        <GradientStop Offset="0.5" Color="#FFBCD9F5" />
        <GradientStop Offset="1" Color="#FF97CCF8" />
    </LinearGradientBrush>



    <Style x:Key="WindowHeaderButtonStyle" TargetType="Button">
        <Setter Property="IsEnabled" Value="true"/>
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="MinWidth" Value="5"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinHeight" Value="5"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="Focused"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BackgroundHover}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BorderBrushHover}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BackgroundPressed}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BorderBrushPressed}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled"/>
                                <VisualState x:Name="Normal"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border CornerRadius="3" Background="{TemplateBinding Background}" 
                  BorderBrush="{TemplateBinding BorderBrush}" x:Name="OuterBorder"
                  BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter  Content="{TemplateBinding Content}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

   
    <Style TargetType="local:RibbonWindow">
        <Setter Property="BorderThickness" Value="2 0 2 2"/>
        <Setter Property="BorderBrush" Value="{StaticResource Blue.TitleBar.ActiveBackgroundBrush}"/>
        <Setter Property="Background" Value="{StaticResource Window.BackgroundBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TitleBarBackground" Value="{StaticResource Blue.TitleBar.ActiveBackgroundBrush}"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="MinWidth" Value="250"/>
        <Setter Property="Height" Value="300"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonWindow">
                    <Grid x:Name="PART_LayoutGrid">
                        <Grid.Resources>
                            <Storyboard x:Key="Close_Animation" Duration="0:0:1" SpeedRatio="5">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)" From="1" To="0" />
                            </Storyboard>

                            <Storyboard x:Key="Open_Animation" Duration="0:0:1" SpeedRatio="5">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)" From="0" To="1" />
                            </Storyboard>

                            <Storyboard x:Key="Overlay_Animation" SpeedRatio="8">
                                <DoubleAnimationUsingKeyFrames    
                                            Storyboard.TargetProperty="(UIElement.Opacity)">
                                    <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0" />
                                    <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.2" />
                                    <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.4" />
                                    <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.6" />
                                    <LinearDoubleKeyFrame Value="0" KeyTime="0:0:1" />
                                    <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1.2" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </Grid.Resources>
                        <Border Background="Black" CornerRadius="8" BorderThickness="0" BorderBrush="Transparent">
                            <Border.Effect>
                                <BlurEffect Radius="8"/>
                            </Border.Effect>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="0" CornerRadius="5">
                            <Border Name="_Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" 
                               >
                                <Grid x:Name="PART_Root">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="*"/>
                                        <!--<RowDefinition Height="Auto"/>-->
                                    </Grid.RowDefinitions>
                                    
                                    <Border x:Name="PART_Title" Background="{TemplateBinding TitleBarBackground}">
                                        <context:ContextMenuAdvService.ContextMenuAdv>
                                            <context:ContextMenuAdv>
                                                <context:ContextMenuItemAdv Header="Restore" x:Name="PART_Restore">
                                                    <context:ContextMenuItemAdv.Icon>
                                                        <ContentControl Content="2" FontFamily="Webdings"/>
                                                    </context:ContextMenuItemAdv.Icon>
                                                </context:ContextMenuItemAdv>
                                                <context:ContextMenuItemAdv Header="Move" x:Name="PART_Move">

                                                </context:ContextMenuItemAdv>
                                                <context:ContextMenuItemAdv Header="Size" x:Name="PART_Size">

                                                </context:ContextMenuItemAdv>
                                                <context:ContextMenuItemAdv Header="Minimize" x:Name="PART_Minimize">
                                                    <context:ContextMenuItemAdv.Icon>
                                                        <ContentControl Content="0" FontFamily="Webdings"/>
                                                    </context:ContextMenuItemAdv.Icon>
                                                </context:ContextMenuItemAdv>
                                                <context:ContextMenuItemAdv Header="Maximize" x:Name="PART_Maximize">
                                                    <context:ContextMenuItemAdv.Icon>
                                                        <ContentControl Content="1" FontFamily="Webdings"/>
                                                    </context:ContextMenuItemAdv.Icon>
                                                </context:ContextMenuItemAdv>
                                                <context:SeparatorAdv />
                                                <context:ContextMenuItemAdv FontWeight="Bold" x:Name="PART_Close">
                                                    <context:ContextMenuItemAdv.Header>
                                                        <Grid Width="100">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Close"/>
                                                            <!--<TextBlock Text="Alt+F4" HorizontalAlignment="Right" Grid.Column="1"/>-->
                                                        </Grid>
                                                    </context:ContextMenuItemAdv.Header>
                                                    <context:ContextMenuItemAdv.Icon>
                                                        <ContentControl Content="r" FontFamily="Webdings" FontWeight="Bold"/>
                                                    </context:ContextMenuItemAdv.Icon>
                                                </context:ContextMenuItemAdv>
                                            </context:ContextMenuAdv>
                                        </context:ContextMenuAdvService.ContextMenuAdv>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Thumb Grid.ColumnSpan="2" Opacity="0" x:Name="PART_TitleThumb" />
                                            <Image Source="{TemplateBinding Icon}" HorizontalAlignment="Left" Margin="2"/>
                                            <ContentControl Content="{TemplateBinding Title}" Background="Transparent" Grid.Column="1" Foreground="{TemplateBinding Foreground}" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Margin="0 0 0 0" Background="Transparent" CornerRadius="0" Width="Auto" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="PART_MinimizeButton" FontFamily="Webdings" BorderBrush="Transparent" Background="Transparent" Height="25" Width="25" HorizontalAlignment="Right" Style="{StaticResource WindowHeaderButtonStyle}" VerticalAlignment="Center">
                                                        <ToolTipService.ToolTip>
                                                            Minimize
                                                        </ToolTipService.ToolTip>
                                                        <Canvas Width="9" Height="9">
                                                            <Line X1="0" X2="8"  Y1="6" Y2="6" Stroke="{StaticResource Blue.SystemButton.Brush1}" StrokeThickness="1"/>
                                                            <Line X1="0" X2="8"  Y1="7" Y2="7" Stroke="{StaticResource Blue.SystemButton.Brush2}" StrokeThickness="1"/>
                                                            <Line X1="0" X2="8"  Y1="8" Y2="8" Stroke="{StaticResource Blue.SystemButton.Brush3}" StrokeThickness="1"/>
                                                        </Canvas>
                                                    </Button>
                                                    <Button x:Name="PART_RestoreButton" FontFamily="Webdings" BorderBrush="Transparent" Background="Transparent" Visibility="Collapsed" Height="25" Width="25" HorizontalAlignment="Right" Style="{StaticResource WindowHeaderButtonStyle}" VerticalAlignment="Center">
                                                        <ToolTipService.ToolTip>
                                                            Restore
                                                        </ToolTipService.ToolTip>
                                                        <Canvas Width="9" Height="8">
                                                            <Line X1="2" X2="9"  Y1="1.5" Y2="1.5" Stroke="{StaticResource Blue.SystemButton.Brush1}" StrokeThickness="1"/>
                                                            <Rectangle Canvas.Left="6" Canvas.Top="2"  Stroke="{StaticResource Blue.SystemButton.Brush2}" Width="3" Height="5" StrokeThickness="1"/>
                                                            <Line X1="3" X2="8"  Y1="3" Y2="3" Stroke="{StaticResource Blue.SystemButton.Brush3}" StrokeThickness="1"/>
                                                            <Line X1="2" X2="8"  Y1="7" Y2="7" Stroke="{StaticResource Blue.SystemButton.Brush3}" StrokeThickness="1"/>
                                                            <Line X1="0" X2="7"  Y1="2.5" Y2="2.5" Stroke="{StaticResource Blue.SystemButton.Brush1}" StrokeThickness="1"/>
                                                            <Rectangle Canvas.Left="0" Canvas.Top="3" Stroke="{StaticResource Blue.SystemButton.Brush2}" Width="7" Height="5" StrokeThickness="1"/>
                                                            <Line X1="1" X2="6"  Y1="4" Y2="4" Stroke="{StaticResource Blue.SystemButton.Brush3}" StrokeThickness="1"/>
                                                            <Line X1="0" X2="6"  Y1="8" Y2="8" Stroke="{StaticResource Blue.SystemButton.Brush3}" StrokeThickness="1"/>
                                                        </Canvas>
                                                    </Button>
                                                    <Button x:Name="PART_MaximizeButton" FontFamily="Webdings" BorderBrush="Transparent" Background="Transparent" Height="25" Width="25"  HorizontalAlignment="Right" Style="{StaticResource WindowHeaderButtonStyle}" VerticalAlignment="Center">
                                                        <ToolTipService.ToolTip>
                                                            Maximize
                                                        </ToolTipService.ToolTip>
                                                        <Canvas Width="9" Height="9">
                                                            <Border BorderThickness="1,3,1,1" Width="9" Margin="0,1,0,0" Height="7" BorderBrush="{StaticResource Blue.SystemButton.Brush2}"/>

                                                        </Canvas>
                                                    </Button>
                                                    <Button x:Name="PART_CloseButton" FontFamily="Webdings" BorderBrush="Transparent" Height="25" Width="25"  Background="Transparent" HorizontalAlignment="Right" Margin="0" Style="{StaticResource WindowHeaderButtonStyle}" VerticalAlignment="Center" HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
                                                        <ToolTipService.ToolTip>
                                                            Close
                                                        </ToolTipService.ToolTip>
                                                        <Canvas Width="11" Height="10">
                                                            <Path Data="M1,0.5L4,0.5 5,2.5 7,0.5 10,0.5" Stroke="{StaticResource Blue.SystemButton.Brush1}" StrokeThickness="1"/>
                                                            <Path Data="M1,0L4,0 5,2 7,0 10,0 7,4 7,5 10,8 7,8 5,6 4,8 1,8 4,5 4,4z" Fill="{StaticResource Blue.SystemButton.Brush2}"  StrokeThickness="1"/>
                                                            <Path Data="M0,8L4,8 5,6 7,8 11,8" Stroke="{StaticResource Blue.SystemButton.Brush3}" StrokeThickness="1"/>
                                                        </Canvas>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1"  Background="{TemplateBinding Background}" BorderThickness="0" BorderBrush="Black" CornerRadius="0 0 5 5">
                                        <ContentPresenter />
                                    </Border>
                                    <ContentControl x:Name="PART_Client" Grid.Row="1" />

                                </Grid>
                            </Border>
                        </Border>
                        <Thumb x:Name="PART_Top" Height="10" VerticalAlignment="Top" Opacity="0" Cursor="SizeNS" Margin="0,1,0,0"/>
                        <Thumb x:Name="PART_Right" Width="10" HorizontalAlignment="Right" Cursor="SizeWE" Opacity="0" Margin="0,0,-4,0"/>
                        <Thumb x:Name="PART_Bottom" Height="10" VerticalAlignment="Bottom" Cursor="SizeNS" Margin="0,0,0,-4" Opacity="0"/>
                        <Thumb x:Name="PART_Left" Width="10" HorizontalAlignment="Left" Cursor="SizeWE" Opacity="0" Margin="-4,0,0,0"/>

                        <Thumb x:Name="PART_TopLeft" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Background="Red" Opacity="0" Width="8" Height="8"/>
                        <Thumb x:Name="PART_TopRight" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Background="Red" Opacity="0" Width="8" Height="8"/>
                        <Thumb x:Name="PART_BottomLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Background="Red" Opacity="0" Width="8" Height="8"/>
                        <Thumb x:Name="PART_BottomRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Background="Red" Opacity="0" Width="8" Height="8"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
