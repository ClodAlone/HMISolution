<r:RibbonTitlePanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Ribbon.Silverlight"
>
    <r:RibbonTitlePanel.Template>
        <ControlTemplate TargetType="r:RibbonTitlePanel">
            <ContentControl x:Name="Part_Root" Foreground="{TemplateBinding Foreground}" Background="Transparent"/>
        </ControlTemplate>
    </r:RibbonTitlePanel.Template>
    
</r:RibbonTitlePanel>