<controls:ChildWindow xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"  x:Class="Syncfusion.Windows.Tools.Controls.QatCustomizationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls" Name="MyParent"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" OverlayOpacity="0.0" OverlayBrush="Transparent"
    mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:Syncfusion_Resources="clr-namespace:Syncfusion.Windows.Tools.Controls.Resources"
   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" d:DesignWidth="563" BorderThickness="1.5">
    <controls:ChildWindow.Resources>
        <Syncfusion_Resources:ResourceWrapper x:Key="ResourceWrapperKey" />
    </controls:ChildWindow.Resources>
    <Border BorderBrush="#FF595959" BorderThickness="0.9">
        <Grid x:Name="LayoutRoot" Background="White">
            <Grid Name="grid">
                <Border Margin="6,6,6,34" BorderBrush="LightGray" BorderThickness="0.8">
                    <Border >
                        <Border.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF5E77E3" Offset="0"/>
                                <GradientStop Color="White"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="1" Width="549">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="120"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="55"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="225*"/>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="208*"/>
                                <ColumnDefinition Width="61"/>
                            </Grid.ColumnDefinitions>

                            <ListBox Grid.Row="1" Name="PART_ListSource" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding ElementName=MyParent, Path=Source}" Height="200" Margin="28,0,0,0" HorizontalAlignment="Left" Width="183">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <Image Width="16" Height="16" Margin="0,0,10,0" Stretch="Fill" Source="{Binding Path=SmallIcon}"/>
                                            <TextBlock Text="{Binding Path=Label}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ListBox Grid.Column="2" Grid.Row="1" Margin="8,0,0,28"  ItemsSource="{Binding ElementName=MyParent, Path=Destination}" Name="PART_ListDestination" Height="180" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <Image Width="16" Height="16" Margin="0,0,10,0" Stretch="Fill" Source="{Binding Path=SmallIcon}"/>
                                            <TextBlock Text="{Binding Path=Label}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Margin="21,42,0,47"  FontSize="11" HorizontalAlignment="Left" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=ChooseOtherCommandsFrom}" x:Name="PART_lblChoose"/>
                            <ComboBox Height="25" Margin="25,65,0,0" x:Name="PART_ComboBox" 
                                  VerticalAlignment="Top" HorizontalAlignment="Stretch" 
                                  SelectionChanged="PartComboBoxSelectionChanged"/>

                            <CheckBox Content="{Binding ElementName=MyParent, Path=QATStateCaption}" Grid.Row="2" Name="PART_chkShowQATBelow" Margin="25,15,183,0" Height="16" Grid.ColumnSpan="3" VerticalAlignment="Top">
                            </CheckBox>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1">
                                <Button Margin="0,0,0,5" Height="22" Name="PART_btnAdd" Width="72" Command="{Binding ElementName=MyParent, Path=Add}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=Add}"/>
                                            <TextBlock Text="8" FontFamily="Webdings" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                                <Button Name="PART_btnRemove" Width="72" Height="22"  Command="{Binding ElementName=MyParent, Path=Remove}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="7 " FontFamily="Webdings" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=Remove}"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="2" Grid.Row="1" Margin="13,3,0,1" Name="PART_btnReset" Content="{Binding Source={StaticResource ResourceWrapperKey}, Path=Reset}"  Command="{Binding ElementName=MyParent, Path=Reset}" Height="22" VerticalAlignment="Bottom"  HorizontalAlignment="Left" Width="72">
                            </Button>

                            <TextBlock Grid.Column="0" Grid.Row="0" Margin="51,8,0,0" Grid.ColumnSpan="3" FontSize="13" Name="label1" VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATPopupHeader}"/>
                            <TextBlock Grid.Column="2" Margin="8,0,0,0" Name="label3" VerticalAlignment="Bottom" Text="{Binding Source={StaticResource ResourceWrapperKey}, Path=QATPopupHeader}" TextWrapping="Wrap"/>
                            <StackPanel Margin="6,81,37,81" Grid.Column="3" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" >
                                <Button Margin="0,0,0,5"  Command="{Binding ElementName=MyParent, Path=Up}" Name="PART_btnUp" FontFamily="Webdings" Content="5">
                                </Button>
                                <Button Name="PART_btnDown"  Command="{Binding ElementName=MyParent, Path=Down}" FontFamily="Webdings" Content="6" >
                                </Button>
                            </StackPanel>
                            <Image Stretch="Fill" Width="22" Height="29" VerticalAlignment="Top" HorizontalAlignment="Left"  Margin="25,3,0,0" Source="/Syncfusion.Ribbon.Silverlight;component/Ribbon/Resources/QATImage.png" />
                        </Grid>
                    </Border>
                </Border>
                <Button Margin="0,0,88,8" HorizontalAlignment="Right" Command="{Binding ElementName=MyParent, Path=Ok}" VerticalAlignment="Bottom" Name="PART_btnOk" Content="{Binding Source={StaticResource ResourceWrapperKey}, Path=OK}" Height="22" Width="72"></Button>
                <Button Height="22" HorizontalAlignment="Right"  Command="{Binding ElementName=MyParent, Path=Cancel}" VerticalAlignment="Bottom" Margin="0,0,5,8" Content="{Binding Source={StaticResource ResourceWrapperKey}, Path=Cancel}" Name="PART_btnCancel" Width="72"></Button>
            </Grid>
        </Grid>

    </Border>
</controls:ChildWindow>
