<sync:WindowControl x:Class="Syncfusion.Windows.Reports.Viewer.Dialogs.ExceptionDetail" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:sync="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Enter DataSource Credential"   
     Height="160" Width="400" ResizeMode="NoResize" Icon="..\Icons\error.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="213*"></RowDefinition>
            <RowDefinition Height="25"></RowDefinition>
        </Grid.RowDefinitions>
        <RichTextBox Name="textBlockStackTrace" FlowDirection="LeftToRight" HorizontalAlignment="Left" VerticalAlignment="Stretch"  IsReadOnly="True" VerticalScrollBarVisibility="Auto" Margin="2,2,2,2" Width="382">
        </RichTextBox>
        <HyperlinkButton Click="Hyperlink_Click" Content="Click here to copy issue details" Grid.Row="1" VerticalAlignment="Center"></HyperlinkButton>
    </Grid>
</sync:WindowControl>
