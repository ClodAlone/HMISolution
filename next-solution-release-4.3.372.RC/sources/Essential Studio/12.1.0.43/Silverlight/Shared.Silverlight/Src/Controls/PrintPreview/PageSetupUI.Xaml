<sync:WindowControl x:Class="Syncfusion.Windows.Tools.Controls.PageSetupUI" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:sync="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     Height="458" Width="423" >


    <Grid x:Name="grd_General" Height="425" Width="404">
        <Grid.RowDefinitions>
            <RowDefinition Height="120*" />
            <RowDefinition Height="110*" />
            <RowDefinition Height="120*" />
            <RowDefinition Height="50*" />
        </Grid.RowDefinitions>
        <Grid>
            
            <TextBlock Text="Margins" Margin="0,11,344,94" TextAlignment="Center" FontSize="13" FontWeight="Bold" />
            <sync:DoubleTextBox  TabIndex="7" x:Name="top" IsEnabled="True" Background="White" Height="22" Margin="67,60,0,42" HorizontalAlignment="Left" Width="79"/>
            <sync:DoubleTextBox  TabIndex="7" x:Name="left" IsEnabled="True" Background="White" Margin="302,60,0,42" HorizontalAlignment="Left" Width="90" />
            <sync:DoubleTextBox  x:Name="right" Background="White" Height="22" HorizontalAlignment="Left" IsEnabled="True" Margin="67,88,0,15" TabIndex="7" Width="79" />
            <sync:DoubleTextBox  x:Name="bottom" Background="White" HorizontalAlignment="Left" IsEnabled="True" Margin="302,88,0,14" TabIndex="7" Width="90"/>
            <TextBlock Margin="13,60,344,45" Text="Top" />
            <TextBlock Margin="13,88,344,17" Text="Left" />
            <TextBlock Margin="216,63,128,43" Text="Bottom" />
            <TextBlock Margin="216,92,128,15" Text="Right" />
        </Grid>

        <Grid Grid.Row="1"  VerticalAlignment="Bottom">
            <TextBlock Text="Orientation" Margin="13,12,302,76"  FontSize="13" FontWeight="Bold" />
            <RadioButton Name="portrait" TabIndex="1" Margin="18,47,0,55" GroupName="SizeAttributes"  Content="Portrait" HorizontalAlignment="Left" Width="84" IsChecked="True"/>
            <RadioButton Name="landscape" Content="Landscape" GroupName="SizeAttributes" HorizontalAlignment="Left" Margin="18,75,0,27" TabIndex="1" Width="84" />
        </Grid>
        <Grid Grid.Row="2">
         
            <ComboBox Margin="26,27,249,74" Name="pagesize"></ComboBox>
            <sync:DoubleTextBox x:Name="pageWidth" Background="White" Height="22" HorizontalAlignment="Left" IsEnabled="True" Margin="76,68,0,34" TabIndex="7" Width="79"/>
            <sync:DoubleTextBox x:Name="pageHeight" Background="White" Height="22" HorizontalAlignment="Left" IsEnabled="True" Margin="76,96,0,6" TabIndex="7" Width="79"/>
            <TextBlock Margin="22,68,335,37" Text="Width" />
            <TextBlock Margin="22,96,335,9" Text="Height" />
            <TextBlock FontSize="13" FontWeight="Bold" Margin="9,3,316,103" Text="Page Size" TextAlignment="Center" />
        </Grid>
        <Button  TabIndex="3" Margin="324,0,12,14" Name="Cancel_button" Height="23" Grid.Row="3" VerticalAlignment="Bottom"  Content="Cancel" />
        <Button  TabIndex="2" HorizontalAlignment="Left" Margin="250,0,0,14" Name="Ok_button" Width="68" Height="23" Grid.Row="3" VerticalAlignment="Bottom" Content="Ok" />
        <Button Content="Set As Default" Name="Default" Grid.Row="3" Height="25" HorizontalAlignment="Left" Margin="18,15,0,0" VerticalAlignment="Top" Width="114" />
    </Grid>

</sync:WindowControl>
