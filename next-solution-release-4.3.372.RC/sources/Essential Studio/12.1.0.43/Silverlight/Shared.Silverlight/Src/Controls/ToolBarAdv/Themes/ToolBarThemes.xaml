    <Style TargetType="shared:ToolBarAdv">
        <Setter Property="Background" Value="{StaticResource ToolBarBackBrush}"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shared:ToolBarAdv">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderThickness="0" BorderBrush="#FFB5BECE">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Orientation">
                                <VisualState x:Name="Horizontal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col0">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="8"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col1">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col2">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="12"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row0">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row1">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row2">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_ToolBarPanel">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_OverflowButton">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_ToolBarPanel">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_OverflowButton">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="verticalGripper">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="horizontalGripper">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="verticalPath">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="horizontalPath">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Vertical">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row0">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="8"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row1">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Height" Storyboard.TargetName="row2">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="12"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col0">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="*"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col1">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Width" Storyboard.TargetName="col2">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Auto"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_ToolBarPanel">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Row)" Storyboard.TargetName="PART_OverflowButton">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_ToolBarPanel">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="(Grid.Column)" Storyboard.TargetName="PART_OverflowButton">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="verticalGripper">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="horizontalGripper">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="verticalPath">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="horizontalPath">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="col0" Width="8"></ColumnDefinition>
                                <ColumnDefinition x:Name="col1" Width="*"></ColumnDefinition>
                                <ColumnDefinition x:Name="col2" Width="12"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="row0"  Height="*"></RowDefinition>
                                <RowDefinition x:Name="row1" Height="Auto"></RowDefinition>
                                <RowDefinition x:Name="row2" Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>

                            <!--<Button x:Name="PART_DragThumb" Style="{StaticResource ThumbStyle}" Margin="2 3 4 2" ></Button>-->
                            <Grid x:Name="PART_DragThumb" Background="Transparent" Margin="2 3 4 2" Cursor="Hand" Visibility="{Binding GripperVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                                <Path x:Name="verticalGripper" Data="M12.5,0.5 L13.5,0.5 L13.5,1.5 L12.5,1.5 z M8.5,0.5 L9.5,0.5 L9.5,1.5 L8.5,1.5 z M4.5,0.5 L5.5,0.5 L5.5,1.5 L4.5,1.5 z M0.5,0.5 L1.5,0.5 L1.5,1.5 L0.5,1.5 z" Fill="#FF60728C" HorizontalAlignment="Center" Height="2" Stretch="Fill" Stroke="#FF60728C" VerticalAlignment="Center" Width="14"/>
                                <Path x:Name="horizontalGripper" Data="M0.5,12.5 L1.5000002,12.5 L1.5000002,13.5 L0.5,13.5 z M0.50000137,8.5 L1.5000012,8.5 L1.5000012,9.5 L0.50000137,9.5 z M0.50000137,4.5 L1.5000012,4.5 L1.5000012,5.5 L0.50000137,5.5 z M0.50000137,0.5 L1.5000014,0.5 L1.5000014,1.5 L0.50000137,1.5 z" Fill="#FF60728C" HorizontalAlignment="Center" Height="14" Stretch="Fill" Stroke="#FF60728C" VerticalAlignment="Center" Width="2"/>
                            </Grid>
                            <shared:ToolBarPanelAdv Margin="1"  x:Name="PART_ToolBarPanel" Grid.Column="1"></shared:ToolBarPanelAdv>
                            <ToggleButton x:Name="PART_OverflowButton" Style="{StaticResource OverflowButtonStyle}"  Grid.Column="2">
                                <Grid>
                                    <Grid x:Name="horizontalPath" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"></RowDefinition>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Path x:Name="horizontalDownPath1" Data="M0,-2 L6,-2" Stroke="Black" VerticalAlignment="Bottom" Margin="0,0,0,2" Grid.Row="1" Stretch="Uniform" Height="1" StrokeThickness="1" Width="6"/>
                                        <Path x:Name="horizontalDownPath" Data="M0.5,3 L5.5,3 L3,6 z" Fill="Black" Stretch="Fill" Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,4" Stroke="Black" Width="6" Height="4" />
                                        <Path x:Name="horizontalLeftOverflowPath" Data="M88.583328,131.16667 L88.583328,111 L101.74972,121.1665 z" Fill="Black" Margin="2,3,2,3" HorizontalAlignment="Left" Height="3" Stretch="Fill" Stroke="Black" VerticalAlignment="Center" Width="2.5"/>
                                        <Path x:Name="horizontalRightOverflowPath" Data="M88.583328,131.16667 L88.583328,111 L101.74972,121.1665 z" Fill="Black" Margin="3" Height="3" HorizontalAlignment="Right" Stretch="Fill" Stroke="Black" VerticalAlignment="Center" Width="2.5"/>
                                    </Grid>
                                    <Grid x:Name="verticalPath">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="verticalDownPath" Data="M0.5,20.5 L0.5,0.5 L13.499992,10.582473 z" Grid.Column="2" Fill="Black" HorizontalAlignment="Left" Margin="0,0,4,0" Height="6" Stretch="Fill" Stroke="Black" Width="4"/>
                                        <Path x:Name="verticalDownPath1" Data="M0.5,0.5 L0.5,20" Fill="Black" Grid.Column="1" HorizontalAlignment="Right" Height="6" Margin="0,0,2,0" Stretch="Fill" Stroke="Black" Width="1"/>
                                        <Path x:Name="verticalTopOverflowPath" Data="M77,166.375 L96.111671,166.37529 L86.436386,174.8792 z" Fill="Black" Margin="3,2,3,2" HorizontalAlignment="Left" Height="2.5" Stretch="Fill" Stroke="Black" VerticalAlignment="Top" Width="3"/>
                                        <Path x:Name="verticalBottomOverflowPath" Data="M77,166.375 L96.111671,166.37529 L86.436386,174.8792 z" Fill="Black" Margin="3" HorizontalAlignment="Left" Height="2.5" Stretch="Fill" Stroke="Black" VerticalAlignment="Bottom" Width="3"/>
                                    </Grid>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_OverflowPopup" IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    
                                <Border BorderBrush="Gray" BorderThickness="1" Background="White" MaxWidth="150">
                                    
                                    <StackPanel>
                                            <shared:ToolBarOverflowPanel Margin="2" x:Name="PART_ToolBarOverflowPanel"></shared:ToolBarOverflowPanel>
                                        <shared:DropDownButtonAdv Label="Add or remove buttons"  DropDirection="Right" Margin="2" Style="{StaticResource DropDownButtonAdvStyle}">
                                            <shared:DropDownMenuGroup x:Name="PART_AddRemoveItems" ItemsSource="{TemplateBinding ToolBarItemInfoCollection}" IconBarEnabled="True">
                                                <shared:DropDownMenuGroup.ItemTemplate>
                                                    <DataTemplate>
                                                        <shared:DropDownMenuItem Header="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                                                 Style="{StaticResource MenuItemStyle}">
                                                            <shared:DropDownMenuItem.Icon>
                                                                <Image Source="{Binding Icon}"/>
                                                            </shared:DropDownMenuItem.Icon>
                                                        </shared:DropDownMenuItem>
                                                    </DataTemplate>
                                                </shared:DropDownMenuGroup.ItemTemplate>
                                            </shared:DropDownMenuGroup>
                                        </shared:DropDownButtonAdv>
                                    </StackPanel>
                                </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button">
        <Setter Property="IsEnabled" Value="true"/>
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="MinWidth" Value="5"/>
        <Setter Property="MinHeight" Value="5"/>
        <Setter Property="Background" Value="{StaticResource CloseButton_NormalBackgroundBrush}"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="Focused"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="cross1" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="cross2" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="cross1" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="cross2" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFCEEDFA"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF66B1F5"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="cross1" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="cross2" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="cross1" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="cross2" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FFB6E4F7"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="OuterBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF66B1F5"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled"/>
                                <VisualState x:Name="Normal"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="OuterBorder" HorizontalAlignment="Left" Width="14" Height="14" BorderThickness="1" Background="Transparent">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="cross1" Data="M72.416664,132.75 L82.083336,141.75" Fill="White" HorizontalAlignment="Center" Height="8" Stretch="Fill" Stroke="White" VerticalAlignment="Center" Width="8"/>
                                <Path x:Name="cross2" Data="M82.417,132.75 L73.333336,141.16667" Fill="White" HorizontalAlignment="Center" Height="8" Stretch="Fill" Stroke="White" VerticalAlignment="Center" Width="8"/>
                            </Grid>
                        </Border>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="shared:FloatingToolBar">
        <Setter Property="BorderThickness" Value="6"/>
        <Setter Property="BorderBrush" Value="{StaticResource TitleBarBackground}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="IsTopMost" Value="True"/>
        <Setter Property="CloseButtonStyle" Value="{StaticResource CloseButtonStyle}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TitleBarForeground" Value="White"/>
        <Setter Property="TitleBarBackground" Value="{StaticResource TitleBarBackground}"/>
        <Setter Property="Title" Value="Untitled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shared:FloatingToolBar">
                    <Grid x:Name="PART_LayoutGrid">
                        <Grid.Resources>
                            <Storyboard x:Key="Close_Animation" Duration="0:0:1" SpeedRatio="5">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)" From="1" To="0" />
                            </Storyboard>

                            <Storyboard x:Key="Open_Animation" Duration="0:0:1" SpeedRatio="5">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)" From="0" To="1" />
                            </Storyboard>

                            <Storyboard x:Key="Overlay_Animation" SpeedRatio="8">
                                <DoubleAnimationUsingKeyFrames    
                                            Storyboard.TargetProperty="(UIElement.Opacity)">
                                    <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0" />
                                    <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.2" />
                                    <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.4" />
                                    <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.6" />
                                    <LinearDoubleKeyFrame Value="0" KeyTime="0:0:1" />
                                    <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1.2" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>

                            <shared:SizeToDoubleConverter x:Key="SizeConverter"/>
                        </Grid.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Activated">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>

                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Deactivated">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_CloseButton" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Shadow" Background="White" CornerRadius="8" BorderThickness="0" BorderBrush="Transparent">

                        </Border>
                        <Border x:Name="Root" >
                            <Border Name="_Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">

                                <Grid x:Name="PART_Root">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <!--<RowDefinition Height="Auto"/>-->
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="1" Margin="1,0,1,1"  Background="{TemplateBinding Background}">
                                        <ContentPresenter />
                                    </Border>
                                    <ContentControl x:Name="PART_Client" Grid.Row="1" />

                                    <Border x:Name="PART_Resizegrip"  Cursor="SizeNWSE" Visibility="Collapsed" Background="Transparent" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3">
                                        <Grid Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <Path Fill="White"
										Data="M 9,1 L 11,1 L 11,3 L 9,3 Z M 5,5 L 7,5 L 7,7 L 5,7 Z M 9,5 L 11,5 L 11,7 L 9,7 Z M 1,9 L 3,9 L 3,11 L 1,11 Z M 5,9 L 7,9 L 7,11 L 5,11 Z M 9,9 L 11,9 L 11,11 L 9,11 Z"
										/>

                                            <Path  Fill="Gray"
										Data="M 8,0 L 10,0 L 10,2 L 8,2 Z M 4,4 L 6,4 L 6,6 L 4,6 Z M 8,4 L 10,4 L 10,6 L 8,6 Z M 0,8 L 2,8 L 2,10 L 0,10 Z M 4,8 L 6,8 L 6,10 L 4,10 Z M 8,8 L 10,8 L 10,10 L 8,10 Z"
										 />
                                            <Thumb x:Name="PART_ResizeGripThumb" Opacity="0.0" Cursor="SizeNWSE"/>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="PART_Title" Margin="1" Background="{TemplateBinding TitleBarBackground}" VerticalAlignment="Center" Visibility="{TemplateBinding TitleBarVisibility}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>


                                            <Image Visibility="Collapsed"  Source="{TemplateBinding Icon}" Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IconSize, Converter={StaticResource SizeConverter}, ConverterParameter=width}" 
                                                  Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IconSize, Converter={StaticResource SizeConverter}, ConverterParameter=height}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2"/>
                                            <TextBlock Text="{TemplateBinding Title}" TextTrimming="WordEllipsis" Grid.Column="1" Foreground="{TemplateBinding TitleBarForeground}" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <Thumb Grid.ColumnSpan="2" Opacity="0" x:Name="PART_TitleFloatingThumb" />
                                            <Border Grid.Column="2" Background="Transparent" CornerRadius="0" Margin="-4,0,0,0" Width="Auto" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">

                                                    <ToggleButton x:Name="PART_AddRemoveButton" Style="{StaticResource ToggleButtonStyle1}">
                                                        
                                                    </ToggleButton>
                                                    <Popup x:Name="PART_DropPopUp" IsOpen="{Binding ElementName=PART_AddRemoveButton, Path=IsChecked}">
                                                        
                                                        <Border Background="White" Padding="1" BorderBrush="Black" BorderThickness="1">
                                                            <!--<Border.Effect>
                                                                <DropShadowEffect ShadowDepth="3" BlurRadius="7" Opacity="0.5"/>
                                                            </Border.Effect>-->
                                                            <StackPanel>
                                                                <shared:DropDownButtonAdv Label="Add or remove buttons"  DropDirection="Right" Margin="2" Style="{StaticResource DropDownButtonAdvStyle}">
                                                                    <shared:DropDownMenuGroup x:Name="PART_AddRemoveItems" ItemsSource="{Binding ToolBarItemInfoCollection, RelativeSource={RelativeSource TemplatedParent}}" IconBarEnabled="True">
                                                                        <shared:DropDownMenuGroup.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <shared:DropDownMenuItem Header="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                                                 Style="{StaticResource MenuItemStyle}">
                                                                                    <shared:DropDownMenuItem.Icon>
                                                                                        <Image Source="{Binding Icon}"/>
                                                                                    </shared:DropDownMenuItem.Icon>
                                                                                </shared:DropDownMenuItem>
                                                                            </DataTemplate>
                                                                        </shared:DropDownMenuGroup.ItemTemplate>
                                                                    </shared:DropDownMenuGroup>
                                                                </shared:DropDownButtonAdv>
                                                            </StackPanel>
                                                        </Border>
                                                        
                                                    </Popup>

                                                    <Button x:Name="PART_CloseButton" HorizontalAlignment="Left" Style="{TemplateBinding CloseButtonStyle}" VerticalAlignment="Top" HorizontalContentAlignment="Left" VerticalContentAlignment="Top">


                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="Transparent" Visibility="Collapsed" x:Name="PART_SystemMenu" Grid.ColumnSpan="3" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </Border>

                                </Grid>

                            </Border>
                        </Border>
                        <Thumb x:Name="PART_TopThumb" Height="5" VerticalAlignment="Top" Opacity="0" Cursor="SizeNS" Margin="0,1,0,0"/>
                        <Thumb x:Name="PART_RightThumb" Width="5" HorizontalAlignment="Right" Cursor="SizeWE" Opacity="0" Margin="0,0,4,0"/>
                        <Thumb x:Name="PART_BottomThumb" Height="5" VerticalAlignment="Bottom" Cursor="SizeNS" Margin="0,0,0,4" Opacity="0"/>
                        <Thumb x:Name="PART_LeftThumb" Width="5" HorizontalAlignment="Left" Cursor="SizeWE" Opacity="0" Margin="4,0,0,0"/>

                        <!--<Thumb x:Name="PART_TopLeftThumb" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Background="Red" Opacity="0" Width="8" Height="8"/>
                        <Thumb x:Name="PART_TopRightThumb" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Background="Red" Opacity="0" Width="8" Height="8"/>
                        <Thumb x:Name="PART_BottomLeftThumb" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Background="Red" Opacity="0" Width="8" Height="8"/>
                        <Thumb x:Name="PART_BottomRightThumb" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Background="Red" Opacity="0" Width="8" Height="8"/>-->
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="toolBarItemSeparator" TargetType="shared:ToolBarItemSeparator">
        <Setter Property="Background" Value="Gray"/>
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="BorderThickness" Value="1,1,0,0"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shared:ToolBarItemSeparator">
                    <StackPanel Orientation="{TemplateBinding Orientation}">
                        <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Background="{TemplateBinding Background}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource toolBarItemSeparator}" TargetType="shared:ToolBarItemSeparator"/>

</ResourceDictionary>
