<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:tools="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
    xmlns:contorls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls"
    xmlns:ribbon="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Ribbon.Silverlight" >
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Syncfusion.Spreadsheet.Silverlight;component/SpreadsheetRibbon/Themes/Generic.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Spreadsheet.Silverlight;component/Helpers/FillSeries/Themes/Generic.xaml"/>
        <ResourceDictionary Source="/Syncfusion.Spreadsheet.Silverlight;component/Helpers/CopyPaste/Themes/Generic.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <ImageSource x:Key="CancelEditIcon">/Syncfusion.Spreadsheet.Silverlight;component/SpreadsheetRibbon/ExcelUI/FormulaBar/CancelEditIcon.PNG</ImageSource>
    <ImageSource x:Key="EndEditIcon">/Syncfusion.Spreadsheet.Silverlight;component/SpreadsheetRibbon/ExcelUI/FormulaBar/EndEditIcon.PNG</ImageSource>

    <Style TargetType="local:SpreadsheetGroupButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SpreadsheetGroupButton">
                    <Border Name="border" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="Path1"
                                                Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed
                                                    </Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="Path1"
                                                Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible
                                                    </Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>


                        <Grid>
                            <Grid Name="backgroundGrid" Width="20" Height="20" Visibility="Visible">
                                <Rectangle Fill="#FFBCD0E8" Stroke="#FF727F8C" Name="Rect" Visibility="Visible" />
                            </Grid>
                            <Path Name="Path1" Data="M19.833,0L32.501,0 32.501,19.833999 52.334,19.833999 52.334,32.500999 32.501,32.500999 32.501,52.333 19.833,52.333 19.833,32.500999 0,32.500999 0,19.833999 19.833,19.833999z"  Stretch="Uniform" Fill="#FF727F8C" Width="12" Height="12" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <TransformGroup.Children>
                                            <RotateTransform Angle="0" />
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </TransformGroup.Children>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>

                            <Path Name="Path2" Data="M0,0L53.333,0 53.333,8.888 0,8.888z"  Stretch="Uniform" Fill="#FF727F8C" Width="12" Height="12" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <TransformGroup.Children>
                                            <RotateTransform Angle="0" />
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </TransformGroup.Children>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <local:CurrentCellStyleToReadOnlyConverter x:Key="CurrentCellStyleToReadOnlyConverter"/>
    <local:HeightToFormulaBarVisibilityConverter x:Key="heightToFormulaBarVisibilityConverter"/>
    
    <Style x:Key="ExcelEditorControlStyle" TargetType="local:SpreadsheetControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SpreadsheetControl">
                    <Grid x:Name="MainGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="200"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="FormulaBarGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="100"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="White" VerticalAlignment="Top" BorderThickness="0,1,0,1" BorderBrush="{TemplateBinding BorderBrush}" Height="23">
                                <TextBox x:Name="NameBox" TextWrapping="NoWrap" Grid.Column="0" VerticalAlignment="Top"  HorizontalAlignment="Stretch" Height="23" MinWidth="100"
                                     Text="{Binding Path=GridProperties.CellName,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay,UpdateSourceTrigger=Explicit}" />
                            </Border>
                            <Border Background="White" VerticalAlignment="Top" BorderThickness="0,1,0,1" Grid.Column="1" BorderBrush="{TemplateBinding BorderBrush}" Height="23">
                                <Border CornerRadius="10,0,0,10" Background="{TemplateBinding Background}" VerticalAlignment="Top" BorderThickness="0" Width="60" Height="22">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" MinWidth="20"/>
                                            <ColumnDefinition Width="20" MinWidth="20"/>
                                            <ColumnDefinition Width="20" MinWidth="20"/>
                                        </Grid.ColumnDefinitions>
                                        <ribbon:RibbonButton x:Name="EndEditButton" SizeMode="Small" Background="Transparent" Width="20" Grid.Column="1" SmallIcon="{StaticResource EndEditIcon}" 
                                                              Visibility="{Binding Path=GridProperties.IsEditing,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay,Converter={StaticResource BoolToVisibilityConverter}}" Height="20" Margin="0"/>
                                        <ribbon:RibbonButton x:Name="CancelEditButton" SizeMode="Small" Background="Transparent" Width="20" Grid.Column="2" SmallIcon="{StaticResource CancelEditIcon}" 
                                                              Visibility="{Binding Path=GridProperties.IsEditing,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay,Converter={StaticResource BoolToVisibilityConverter}}" Height="20" Margin="0"/>
                                        
                                    </Grid>
                                </Border>
                            </Border>

                            <contorls:GridSplitter x:Name="Splitter" Width="5" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,7,0,0" Background="{TemplateBinding Background}" 
                                                    BorderThickness="4" BorderBrush="{TemplateBinding BorderBrush}" Grid.Column="1"/>

                            <ScrollViewer Grid.Column="2" Padding="0" Height="23" >
                                <TextBox TextWrapping="Wrap" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Name="FormulaBar" VerticalAlignment="Stretch"
                                     IsReadOnly="{Binding Path=GridProperties.CurrentCellStyle.ReadOnly,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" BorderBrush="{TemplateBinding BorderBrush}"
                                     Text="{Binding Path=GridProperties.FormattedText,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay,UpdateSourceTrigger=Explicit}"/>

                            </ScrollViewer>

                        </Grid>

                        <contorls:GridSplitter HorizontalAlignment="Stretch" Grid.Row="1" Height="7" Background="{TemplateBinding Background}" VerticalAlignment="Bottom"
                                               HorizontalContentAlignment="Stretch" Visibility="{TemplateBinding FormulaBarVisibility}"
                                               BorderBrush="{TemplateBinding BorderBrush}"/>

                        <Grid x:Name="Part_Grid" Grid.Row="2" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <local:SpreadsheetGroupPanel x:Name="ColumnGroupPanel" Orientation="Horizontal"  Grid.Column="1"/>
                            <local:SpreadsheetGroupPanel x:Name="RowGroupPanel" Orientation="Vertical"  Grid.Row="1"/>

                            <tools:TabControlAdv x:Name="ExcelTabControlAdv" Grid.Row="1"  Grid.Column="1"
                        SelectedIndex="{Binding Path=TabSelectedIndex,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                        SelectedItem="{Binding Path=TabSelectedItem,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                        Background="{Binding Path=TabStyleManager.Background,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                        TabStripPlacement="{Binding Path=TabStyleManager.TabStripPlacement,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                             TabVisualStyle="{Binding Path=TabStyleManager.TabVisualStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                             ShowTabListContextMenu="False" CloseButtonType="Hide" EnableLabelEdit="False"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ExcelEditorControlStyle}" TargetType="local:SpreadsheetControl"/>
    
</ResourceDictionary>
