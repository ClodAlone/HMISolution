<syncfusion:WindowControl x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.GroupbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources"
        VisualStyle="Aero"
        MaximizeBox="False" MinimizeBox="False" ResizeMode="NoResize" IsSystemMenuEnabled="False" x:Name="GroupWindow"
        xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
        Title="Group" Height="150" Width="250">
    <Grid>
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="1.5*"/>
        </Grid.RowDefinitions>

        <StackPanel  Grid.Row="0"  Orientation="Vertical" VerticalAlignment="Center">
            <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=Group}" Margin="10,0,0,5"/>
            <RadioButton IsChecked="{Binding Path=Rows,Mode=TwoWay,ElementName=GroupWindow}"  Content="{Binding Source={StaticResource ribbonResources},Path=Rows}" GroupName="GroupBy"  Margin="10,0,0,5"/>
            <RadioButton IsChecked="{Binding Path=Columns,Mode=TwoWay,ElementName=GroupWindow}"  Content="{Binding Source={StaticResource ribbonResources},Path=Columns}" GroupName="GroupBy" Margin="10,0,0,5"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1"  HorizontalAlignment="Right">
            <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}" Click="OnOkButtonClick"  Margin="10" Width="70" Height="25" />
            <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}" Click="OnCancelButtonClick" Margin="10" Width="70" Height="25"/>
        </StackPanel>
    </Grid>
</syncfusion:WindowControl>
