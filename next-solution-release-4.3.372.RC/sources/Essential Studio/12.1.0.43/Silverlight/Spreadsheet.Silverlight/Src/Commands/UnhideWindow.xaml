<syncfusion:WindowControl x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.UnhideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Name="formatWindow" VisualStyle="Aero" MaximizeBox="False" MinimizeBox="False" ResizeMode="NoResize" IsSystemMenuEnabled="False"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight" Width="300" Height="200"
    xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources">
    
    <Grid x:Name="LayoutRoot" Background="White">
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <StackPanel>
            <TextBlock Text="{Binding Path=Description,Mode=TwoWay,ElementName=formatWindow}" Margin="5"  Width="200" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <ListBox x:Name="sheetListBox"  Height="80" Width="270" Margin="5" HorizontalAlignment="Left" ItemsSource="{Binding Path=HiddenSheet,Mode=TwoWay,ElementName=formatWindow}"/>
            <StackPanel Margin="5,5,5,5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}"  Margin="5" Width="75" Click="OnOkButtonClick"/>
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}" Margin="5,5,0,5" Width="75" Click="OnCancelButtonClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</syncfusion:WindowControl>
