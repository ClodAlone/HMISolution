<syncfusion:WindowControl x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.CellFormatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources"
    mc:Ignorable="d" x:Name="formatWindow" VisualStyle="Aero" MaximizeBox="False" MinimizeBox="False" ResizeMode="NoResize" IsSystemMenuEnabled="False"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight" Width="200" Height="120" Title="Cell Format">
    <syncfusion:WindowControl.Resources>
        <resources:ResourceWrapper x:Key="ribbonResources"/>
    </syncfusion:WindowControl.Resources>
    <Grid x:Name="LayoutRoot" Background="White">
        <StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
            <TextBlock Text="{Binding Path=Description,Mode=TwoWay,ElementName=formatWindow}" Margin="3" Width="80" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <syncfusion:DoubleTextBox Margin="3" Value="{Binding Path=Value,Mode=TwoWay,ElementName=formatWindow}" Width="80"/>
            </StackPanel>
            <StackPanel Margin="5,5,5,5" Orientation="Horizontal">
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}"  Margin="3,3,3,3" Width="80" Click="OnOkButtonClick"/>
                <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}"  Margin="3,3,3,3" Width="80" Click="OnCancelButtonClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</syncfusion:WindowControl>
