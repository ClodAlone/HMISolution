<syncfusion:WindowControl x:Class="Syncfusion.Windows.Controls.Spreadsheet.Commands.HyperlinkWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Name="commentWindow" VisualStyle="Aero" MaximizeBox="False" MinimizeBox="False" ResizeMode="NoResize" IsSystemMenuEnabled="False"
    xmlns:syncfusion="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight" Width="320" Height="140" Title="Insert Hyperlink"
                          xmlns:resources="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet.Resources">
    
    <Grid x:Name="LayoutRoot" Background="White">
        <Grid.Resources>
            <resources:ResourceWrapper x:Key="ribbonResources"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=Texttodisplay}" Margin="5,5,4,5"/>
        <TextBox Name="DisplayText" Grid.Column="1" TabIndex="0" Margin="5" Text="{Binding ElementName=commentWindow,Path=TextToDisplay,Mode=TwoWay}"/>

        <TextBlock Text="{Binding Source={StaticResource ribbonResources},Path=Address}" Margin="4" Grid.Row="1"/>
        <TextBox Name="AddressText" Grid.Column="1" TabIndex="1" Margin="5" Text="{Binding ElementName=commentWindow,Path=Address,Mode=TwoWay}" Grid.Row="1"/>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Right">
            <Button Content="{Binding Source={StaticResource ribbonResources},Path=Ok}" TabIndex="2"  Margin="5" HorizontalAlignment="Right" Width="70" Click="OnOkButtonClick"/>
            <Button Content="{Binding Source={StaticResource ribbonResources},Path=Cancel}" TabIndex="3"  Margin="5" HorizontalAlignment="Left" Width="70" Click="OnCancelButtonClick"/>
        </StackPanel>
    </Grid>
</syncfusion:WindowControl>

    