<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:tools="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Spreadsheet">

    <ImageSource x:Key="PasteIcon">/Syncfusion.Spreadsheet.Silverlight;component/Helpers/CopyPaste/PasteIcon.png</ImageSource>

    <Style x:Key="DropDownStyle" TargetType="local:PasteDropDownItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PasteDropDownItem">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <shared:SplitButtonAdv Name="dropdownSplitter" SmallIcon="{StaticResource PasteIcon}" Label="" Background="#FFFFEEC2" BorderBrush="#FFF0D14D" BorderThickness="1">
                            <ListBox Name="FillList" BorderBrush="White">
                                <ListBox.Items>
                                    <ListBoxItem Height="26">
                                        <RadioButton Name="FormulaButton" Content="Formulas" Margin="1" GroupName="Paste" IsChecked="True"></RadioButton>
                                    </ListBoxItem>
                                    <ListBoxItem Height="26">
                                        <RadioButton Name="ValueButton" Content="Values" Margin="1" GroupName="Paste"></RadioButton>
                                    </ListBoxItem>
                                </ListBox.Items>
                            </ListBox>
                        </shared:SplitButtonAdv>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DropDownStyle}" TargetType="local:PasteDropDownItem"></Style>

</ResourceDictionary>
