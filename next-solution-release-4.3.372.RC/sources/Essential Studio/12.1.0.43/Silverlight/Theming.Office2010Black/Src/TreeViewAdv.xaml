<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight">

    <SolidColorBrush x:Key="TreeViewBorderBrushKey" Color="Transparent"/>

    <LinearGradientBrush x:Key="TreeViewBackgroundBrushKey" EndPoint="0.58,1.003" StartPoint="0.549,0">
        <GradientStop Color="#FF8B8B8B" Offset="0"/>
        <GradientStop Color="#FF484848" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TreeViewItemBackgroundBrushKey" Color="Transparent"/>

    <SolidColorBrush x:Key="TreeViewItemForegroundBrushKey" Color="White"/>

    <SolidColorBrush x:Key="GlyphBrushKey" Color="#FF333333"/>

    <SolidColorBrush x:Key="TreeViewItemAdvNormalBorderBrushKey" Color="Transparent"/>
    <SolidColorBrush x:Key="TreeViewItemAdvUnFocusedSelectionBorderBrushKey" Color="#FF525252"/>

    <SolidColorBrush x:Key="TreeViewItemAdvSelectionBorderBrushKey" Color="#FFA7CDF0"/>

    <SolidColorBrush x:Key="TreeViewItemAdvMouseOverBorderBrushKey" Color="#FFF7C840"/>

    <SolidColorBrush x:Key="TreeViewItemAdvNormalBackgroundBrushKey" Color="Transparent"/>

    <LinearGradientBrush x:Key="TreeViewItemAdvExpanderBackgroundBrushKey"  EndPoint="0.369,0.349" StartPoint="0.993,0.998">
        <GradientStop Color="#FFA0B8D0" Offset="0"/>
        <GradientStop Color="White" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TreeViewItemAdvMouseOverBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFEB9C" Offset="0"/>
        <GradientStop Color="#FFFFE279" Offset="0.305"/>
        <GradientStop Color="#FFFFE585" Offset="0.574"/>
        <GradientStop Color="#FFFFFCE0" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TreeViewItemAdvUnFocusedSelectionBackgroundBrushKey" Color="#FF525252"/>

    <!--<SolidColorBrush  x:Key="TreeViewItemAdvSelectionBackgroundBrushKey" Color="#FFA7CDF0"/>-->
    <LinearGradientBrush x:Key="TreeViewItemAdvSelectionBackgroundBrushKey" StartPoint="0.726312,-0.00145335" EndPoint="0.726312,0.940255">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFEFBB56" Offset="0"/>
            <GradientStop Color="#FFF8D77B" Offset="0.990868"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TreeViewItemAdvSelectionMouseOverBackgroundBrushKey" Color="#FFA7CDF0"/>

    <SolidColorBrush x:Key="TreeViewItemAdvSelectionMouseOverBorderBrushKey" Color="#FFA7CDF0"/>
    
    <SolidColorBrush x:Key="ExpanderUnCheckedFillKey" Color="White"/>

    <SolidColorBrush x:Key="ExpanderUnCheckedStrokeKey" Color="White"/>

    <SolidColorBrush x:Key="ExpanderCheckedStrokeKey" Color="White"/>
    
    <SolidColorBrush x:Key="ExpanderCheckedFillKey" Color="White"/>
    
    <SolidColorBrush x:Key="Office2010Black_TreeViewAdv_SelectedBorderBrush" Color="Transparent"/>

    <SolidColorBrush x:Key="Office2010Black_TreeViewAdv_SelectedBrush" Color="#FF3B3B3B"/>

    <SolidColorBrush x:Key="Office2010Black_TreeViewAdv_SelectionUnfocussedBackcolor" Color="#FFC4C4C4"/>

    <SolidColorBrush x:Key="Office2010Black_TreeViewAdv_MouseOverBorderBrush" Color="Transparent"/>
    <LinearGradientBrush x:Key="Office2010Black_TreeViewAdv_MouseOverBackground"
                         EndPoint="0,1" 
                         StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="#FFF8F8F8"/>
            <GradientStop Offset="0.55" Color="#FFF8F8F8"/>
            <GradientStop Offset="0.60" Color="#FFF1F1F1"/>
            <GradientStop Offset="0.9" Color="#FFF1F1F1"/>
            <GradientStop Offset="0.95" Color="#FFF8F8F8"/>
            <GradientStop Offset="1" Color="#FFF8F8F8"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <ControlTemplate x:Key="TreeViewItemAdvExpanderButtonStyle"  TargetType="ToggleButton">
        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5"  Height="Auto" Width="Auto">
            <vsm:VisualStateManager.VisualStateGroups>

                <vsm:VisualStateGroup x:Name="CommonStates">
                    <vsm:VisualState x:Name="Normal"/>
                    <vsm:VisualState x:Name="Disabled">
                    </vsm:VisualState>
                </vsm:VisualStateGroup>

                <vsm:VisualStateGroup x:Name="CheckStates">
                    <vsm:VisualState x:Name="Unchecked">
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                            <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                        </Storyboard>
                    </vsm:VisualState>
                    <vsm:VisualState x:Name="Checked">
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                            <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                        </Storyboard>
                    </vsm:VisualState>
                </vsm:VisualStateGroup>

            </vsm:VisualStateManager.VisualStateGroups>
            <Path x:Name="UncheckedVisual" Stroke="{StaticResource ExpanderUnCheckedStrokeKey}" Fill="{StaticResource ExpanderUnCheckedFillKey}" Margin="0,-1,0,0" Width="6" Height="8" Stretch="Fill" Data="F1 M 492.891,338.23L 492.9,334.35L 492.909,330.471L 495.488,332.417L 498.066,334.362L 495.479,336.296L 492.891,338.23 Z " StrokeThickness="0.5"/>
            <Path x:Name="CheckedVisual" Stroke="{StaticResource ExpanderCheckedStrokeKey}" Fill="{StaticResource ExpanderCheckedFillKey}"  Margin="0,-1,0,0" Width="7" Height="7" Stretch="Fill" Data="F1 M 488.338,322.896L 488.338,322.901L 495.647,322.901L 495.647,315.592L 495.644,315.592L 488.338,322.896 Z " StrokeThickness="0.5"/>
        </Grid>
    </ControlTemplate>

    <!-- TreeViewItemAdv Template-->
    <Style x:Key="Office2010BlackTreeViewItemAdvStyle" TargetType="local:TreeViewItemAdv">
        <Setter Property="Background" Value="{StaticResource TreeViewItemBackgroundBrushKey}"/>
        <Setter Property="Foreground" Value="{StaticResource TreeViewItemForegroundBrushKey}"/>
        <Setter Property="ExpanderTemplate" Value="{StaticResource TreeViewItemAdvExpanderButtonStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TreeViewItemAdv">
                    <Grid x:Name="LayoutRoot" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- VSM for TreeViewItemAdv-->
                        <vsm:VisualStateManager.VisualStateGroups>

                            <vsm:VisualStateGroup x:Name="CommonStates">

                                <vsm:VisualState x:Name="Normal" >
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodeSelection" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodeSelection" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="UnFocusedSelection">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodeunfocusedselection" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodeunfocusedselection" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="SelectedMouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodeselctionmouseover" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodeselctionmouseover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="MultiSelect">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="multiSelection" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="multiSelection" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="DeSelect">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="multiSelection" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="multiSelection" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="MouseOver">
                                    <!--<Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>                                                                                        
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodemouseover" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>-->
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>

                            <vsm:VisualStateGroup x:Name="SelectionStates">
                                <vsm:VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodeSelection" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                        </ObjectAnimationUsingKeyFrames>-->
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodeSelection" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unselected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="nodeSelection" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="nodeSelection" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>

                            <vsm:VisualStateGroup x:Name="ItemStates">
                                <vsm:VisualState x:Name="Expanded">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpandIconPart" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CollapsedIconPart" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Collapsed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="ItemsHost" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpandIconPart" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CollapsedIconPart" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Unfocused"/>
                            </vsm:VisualStateGroup>

                            <vsm:VisualStateGroup x:Name="SourceStates">
                                <vsm:VisualStateGroup.Transitions>
                                    <vsm:VisualTransition GeneratedDuration="00:00:00.2000000" To="HasItems"/>
                                    <vsm:VisualTransition GeneratedDuration="00:00:00.2000000" To="NoItems"/>
                                </vsm:VisualStateGroup.Transitions>
                                <vsm:VisualState x:Name="HasItems">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="Expander" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="NoItems">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="Expander" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Loading">
                                    <Storyboard RepeatBehavior="Forever">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Expander" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LoadingContentPresenter" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="path" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)" 
                                                                       Storyboard.TargetName="path">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:1" Value="360"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>

                        </vsm:VisualStateManager.VisualStateGroups>

                        <Grid x:Name="PART_Header" Margin="{TemplateBinding HeaderMargin}" Canvas.ZIndex="999">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid x:Name="ExpandCollapseZone"   Grid.Column="0" Grid.Row="1" 
                                HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Line X1="0" X2="25" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"  Y1="0" Y2="0" x:Name="HorizontalRootLine" Margin="11,0,0,0" 
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center" StrokeThickness="1" 
                                    StrokeDashArray="{TemplateBinding LineStrokeArray}" Stroke="{TemplateBinding RootLineStroke}" 
                                    Visibility="{TemplateBinding HorizontalLineVisibility}"></Line>

                                <Rectangle Width="1" x:Name="VerticalRootLine1"
                                HorizontalAlignment="Center"   StrokeThickness="0.5" StrokeDashArray="{TemplateBinding LineStrokeArray}" 
                                       Stroke="{TemplateBinding RootLineStroke}" Visibility="{TemplateBinding VerticalRootLine1Visibility}" ></Rectangle>

                                <ToggleButton x:Name="Expander"   Grid.RowSpan="2"
                                      IsChecked="{TemplateBinding IsExpanded}"  
                                      Opacity="0" IsThreeState="False"  Width="12" Height="12"
                                      Template="{TemplateBinding ExpanderTemplate}" Visibility="Visible">
                                </ToggleButton>
                                <Ellipse x:Name="path" StrokeThickness="2.5" Fill="{StaticResource Office2010Black_TreeViewAdv_SelectedBrush}" Stretch="Fill" Grid.RowSpan="2" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Width="16" Height="16" Visibility="Collapsed"
                                  >
                                    <Ellipse.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="-180"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Stroke>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="White" Offset="0.222"/>
                                            <GradientStop Color="#FF4E4E4E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Stroke>
                                </Ellipse>
                                <!--<Path x:Name="path" Stretch="Fill" Fill="{TemplateBinding Foreground}"  Grid.RowSpan="2" Width="12" Height="10" Visibility="Collapsed"
		                            Data="F1 M 393.948,266.865C 394.242,265.891 394.417,264.866 394.417,263.797C 394.417,257.906 389.642,253.13 383.751,253.13C 377.859,253.13 373.084,257.906 373.084,263.797C 373.084,267.029 374.527,269.918 376.796,271.874L 377.853,269.536C 376.41,268.053 375.517,266.031 375.517,263.797C 375.517,259.25 379.203,255.564 383.751,255.564C 388.299,255.564 391.984,259.25 391.984,263.797C 391.984,264.562 391.845,265.289 391.647,265.992L 388.376,264.753L 389.587,267.999L 390.799,271.247L 393.858,269.618L 396.917,267.989L 393.948,266.865 Z " 
                                      HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>-->
                            </Grid>

                            <Border x:Name="HeaderBorder" Grid.Row="1"
								Grid.Column="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
								Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid  Grid.Row="0" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                                            <Image Margin="2,0,0,0"  x:Name="ExpandIconPart"  Source="{TemplateBinding  ExpandImageSource}" HorizontalAlignment="Left"
                                                       Width="{TemplateBinding ExpandImageWidth}"
                                                        Height="{TemplateBinding ExpandImageHeight}" ></Image>
                                            <Image Margin="2,0,0,0"  x:Name="CollapsedIconPart"   Source="{TemplateBinding CollapseImageSource}"
                                                      Width="{TemplateBinding CollapseImageWidth}"
                                                      Height="{TemplateBinding CollapseImageHeight}"></Image>
                                            <Image 
                                       x:Name="LeftImage" 
                                       Source="{TemplateBinding LeftImageSource}"
                                       MaxWidth="{TemplateBinding LeftImageWidth}"
                                       MaxHeight="{TemplateBinding LeftImageHeight}"
                                       Margin="{TemplateBinding ImageMargin}"
                                       HorizontalAlignment="{TemplateBinding ImageHorizontalAlignment}"
                                       VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1"  x:Name="PART_ContentHost" 
                                           
                                            VerticalAlignment="{TemplateBinding TextVerticalAlignment}"
                                            HorizontalAlignment="{TemplateBinding TextHorizontalAlignment}"
                                            Margin="{TemplateBinding TextMargin}">

                                            <TextBox x:Name="TextBox"
    							                 Visibility="Collapsed"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Bottom" Foreground="{TemplateBinding Foreground}"
    							                 Text="{TemplateBinding Header}"
                                                
                                                 FontSize="{TemplateBinding FontSize}"
                                                 FontFamily="{TemplateBinding FontFamily}"/>


                                            <Border VerticalAlignment="Stretch" >
                                                <Grid>
                                                <ContentPresenter x:Name="ContentPresenter" Margin="4,2,4,1"
                                                      VerticalAlignment="{TemplateBinding TextVerticalAlignment}"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                                                    <ContentPresenter x:Name="LoadingContentPresenter" Margin="4,2,4,1" 
                                                      VerticalAlignment="{TemplateBinding TextVerticalAlignment}"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding LoadingHeader}"
                                                      ContentTemplate="{TemplateBinding LoadingHeaderTemplate}" Visibility="Collapsed"/>
                                                </Grid>
                                            </Border>
                                            <!--<ContentPresenter x:Name="ContentPresenter" Margin="4,2,4,1" 
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Bottom"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"/>-->

                                            
                                        </StackPanel>
                                        <Image Grid.Row="0" Grid.Column="2" 
                                       x:Name="RightImage" 
                                       Source="{TemplateBinding RightImageSource}"
                                       MaxWidth="{TemplateBinding RightImageWidth}"
                                       MaxHeight="{TemplateBinding RightImageHeight}"
                                       Margin="{TemplateBinding ImageMargin}"
                                       HorizontalAlignment="{TemplateBinding ImageHorizontalAlignment}"
                                       VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!--<Rectangle Height="1.5" Width="Auto"  Grid.Row="2" Grid.ColumnSpan="4" Margin="8,0,0,0"
                                 StrokeThickness="1.5"  Stroke="{TemplateBinding DragLineColor}" Visibility="{TemplateBinding DragLineVisibility}"></Rectangle>-->
                        </Grid>

                        <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" Opacity="1" Grid.Row="1"/>


                        <Border x:Name="nodemouseover" VerticalAlignment="Top" BorderThickness="1" HorizontalAlignment="Left"
                                                   BorderBrush="{StaticResource Office2010Black_TreeViewAdv_MouseOverBorderBrush}" Background="{StaticResource Office2010Black_TreeViewAdv_MouseOverBackground}"
                                                   Visibility="Collapsed" Opacity="0" />
                        <Border x:Name="multiSelection"  BorderThickness="1" 
                                                   Visibility="Collapsed" Opacity="0" VerticalAlignment="Top"  HorizontalAlignment="Left"/>
                        <Border x:Name="nodeunfocusedselection" VerticalAlignment="Top" BorderThickness="1" 
                                                   BorderBrush="{StaticResource Office2010Black_TreeViewAdv_SelectedBrush}" 
                                                   Background="{StaticResource Office2010Black_TreeViewAdv_SelectedBrush}"
                                                   Visibility="Collapsed" Opacity="0" HorizontalAlignment="Left"/>
                        <Border x:Name="normal"  VerticalAlignment="Top" BorderThickness="1" 
                                                   BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"
                                                   Visibility="Collapsed" Opacity="0" HorizontalAlignment="Left"/>
                        <Border x:Name="nodeSelection"  VerticalAlignment="Top" BorderThickness="0" 
                                               BorderBrush="{StaticResource Office2010Black_TreeViewAdv_SelectedBorderBrush}" Background="{StaticResource Office2010Black_TreeViewAdv_SelectedBrush}"
                                                   Visibility="Collapsed" Opacity="0" HorizontalAlignment="Left"/>
                        <Border x:Name="nodeselctionmouseover"  VerticalAlignment="Top" BorderThickness="1"
                                                   BorderBrush="{StaticResource TreeViewItemAdvSelectionMouseOverBorderBrushKey}" Background="Red"
                                                   Visibility="Collapsed" Opacity="0" HorizontalAlignment="Left"/>

                        <Grid Grid.RowSpan="2" Margin="{TemplateBinding HeaderMargin}" Width="22" HorizontalAlignment="Left">
                            <Rectangle x:Name="VerticalRootLine2" Width="1" HorizontalAlignment="Center" StrokeThickness="0.5" StrokeDashArray="{TemplateBinding LineStrokeArray}" 
                                       Stroke="{TemplateBinding RootLineStroke}" Visibility="{TemplateBinding VerticalRootLine2Visibility}" Margin="{TemplateBinding RootLineMargin}"/>

                            <Rectangle Width="1" x:Name="VerticalRootLine3" VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"   StrokeThickness="0.5" StrokeDashArray="{TemplateBinding LineStrokeArray}" 
                                       Stroke="{TemplateBinding RootLineStroke}" Visibility="{TemplateBinding VerticalRootLine3Visibility}" Height="{TemplateBinding VerticalLine3Height}"></Rectangle>
                        </Grid>
                        <Rectangle Height="1.5" Width="Auto"  Grid.Row="2" Grid.ColumnSpan="4" Margin="8,0,0,0"
                                 StrokeThickness="1.5"  Stroke="{TemplateBinding DragLineColor}" Visibility="{TemplateBinding DragLineVisibility}"></Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource Office2010BlackTreeViewItemAdvStyle}" TargetType="local:TreeViewItemAdv"/>

    <Style x:Key="Office2010BlackTreeViewAdvStyle" TargetType="local:TreeViewAdv">
        <Setter Property="RootLineVisibility" Value="Collapsed"/>
        <Setter Property="FullRowSelect" Value="True"/>
        <Setter Property="Background" Value="{StaticResource TreeViewBackgroundBrushKey}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TreeViewBorderBrushKey}"/>
        <Setter Property="Foreground" Value="{StaticResource TreeViewItemForegroundBrushKey}"/>
        <Setter Property="ExpanderTemplate" Value="{StaticResource TreeViewItemAdvExpanderButtonStyle}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Office2010BlackTreeViewItemAdvStyle}"/>
        <Setter Property="Theme" Value="Office2010Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid x:Name="LayoutRoot" >

                        <ScrollViewer x:Name="ScrollViewer"
                                              VerticalScrollBarVisibility="Auto" 
                                              HorizontalScrollBarVisibility="Auto"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              Background="{TemplateBinding Background}" 
                                              BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid x:Name="TreeViewGrid" >
                                <ItemsPresenter x:Name="TreeItems"/>
                            </Grid>
                        </ScrollViewer>
                        <Canvas x:Name="TreeViewCanvas">
                            <Popup x:Name="PopUp" IsOpen="False" >
                            </Popup>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2010BlackTreeViewAdvStyle}" TargetType="local:TreeViewAdv">
    </Style>


</ResourceDictionary>
