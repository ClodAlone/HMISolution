                        <Rectangle x:Name="DisabledVisual" Fill="{StaticResource CalendarDisabledBrushKey}" Stretch="Fill" Stroke="{StaticResource CalendarDisabledBrushKey}" StrokeThickness="1" RadiusX="2" RadiusY="2" Margin="0,2,0,2" Opacity="0" Visibility="Collapsed"/>
