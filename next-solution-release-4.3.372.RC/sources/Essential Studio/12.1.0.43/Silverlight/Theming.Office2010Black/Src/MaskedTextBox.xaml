                                    <GradientStop x:Name="RegularDayGradientEnd" Color="#FFFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </ContentControl.Foreground>
                        </ContentControl>
                        <Path x:Name="BlackoutVisual" Fill="{StaticResource CalendarDayButtonBlackOutVisualBrushKey}" Stretch="Fill" HorizontalAlignment="Stretch" Margin="3" VerticalAlignment="Stretch" Opacity="0" RenderTransformOrigin="0.5,0.5" Data="M8.1772461,11.029181 L10.433105,11.029181 L11.700684,12.801641 L12.973633,11.029181 L15.191895,11.029181 L12.844727,13.999395 L15.21875,17.060919 L12.962891,17.060919 L11.673828,15.256231 L10.352539,17.060919 L8.1396484,17.060919 L10.519043,14.042364 z"/>
                        <Rectangle x:Name="FocusVisual" Stroke="{StaticResource FocusedBorderBrushKey}" RadiusX="1" RadiusY="1" IsHitTestVisible="false" Visibility="Collapsed"/>
