                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ScrollViewer x:Name="ContentElement" BorderThickness="0" IsTabStop="False" Padding="{TemplateBinding Padding}" Visibility="{TemplateBinding ContentElementVisibility}"/>

                                        <ContentControl  x:Name="PART_Watermark" 
                                Visibility="{TemplateBinding WaterMarkVisibility}" Content="{TemplateBinding WaterMarkText}"
                                IsTabStop="False" IsHitTestVisible="False"
                                FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                FontStretch="{TemplateBinding FontStretch}" FontStyle="{TemplateBinding FontStyle}" FontWeight="{TemplateBinding FontWeight}"
                                Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" 
                                Foreground="{TemplateBinding Foreground}"
                                                Opacity="0.5"
                                ContentTemplate="{TemplateBinding WaterMarkTemplate}">
                                        </ContentControl>

                                        <Button x:Name="PART_Button" Template="{StaticResource DropDownButtonTemplate}" Width="20" 
                                        Margin="2,0,2,0" Foreground="Blue" BorderThickness="2" BorderBrush="Black" Visibility="{TemplateBinding DropDownButtonVisibility}" Grid.Column="1"/>
                                    </Grid>

                                </Border>
                                <Border/>

                                <Popup x:Name="PART_Popup" Grid.Row="1">
                                    <Canvas x:Name="OutsideCanvas">
                                        <Canvas x:Name="OutsidePopupCanvas"/>
                                        <Grid x:Name="PART_PopupGrid" Background="{StaticResource CalendarBackgroundBrushKey}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5*"/>
                                                <ColumnDefinition Width="5*"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:Calendar x:Name="Calender" Grid.ColumnSpan="2" Style="{StaticResource controls:Calendar}"/>
                                            <Button Content="Today" Grid.Row="1" Grid.Column="0" x:Name="Button_CurrDate" Style="{StaticResource ButtonStyle}" Margin="0,-2,0,0"/>
                                            <Button Content="None" Grid.Row="1" Grid.Column="1" x:Name="Button_NoDate" Style="{StaticResource ButtonStyle}" Margin="0,-2,0,0"/>
                                        </Grid>
                                    </Canvas>
                                </Popup>

                            </Grid>

                        </Border>
                        <Border x:Name="DisabledVisualElement" IsHitTestVisible="False" Opacity="0" Background="#A5F7F7F7" BorderBrush="#A5F7F7F7" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="FocusVisualElement" Margin="1" IsHitTestVisible="False" Opacity="0" BorderBrush="#FF6DBDD1" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <Border x:Name="ValidationErrorElement" Visibility="Collapsed" BorderBrush="#FFDB000C" BorderThickness="1" CornerRadius="1">
