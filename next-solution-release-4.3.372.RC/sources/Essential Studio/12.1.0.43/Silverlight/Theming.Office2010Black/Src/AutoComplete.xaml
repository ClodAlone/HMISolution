<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"
    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"  
    xmlns:System="clr-namespace:System;assembly=mscorlib"  
   >

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <!--<SolidColorBrush x:Key="AutoCompleteBorderBrushKey" Color="#FF898989"/>-->
    <SolidColorBrush x:Key="AutoCompleteBorderBrushKey" Color="#FF898989"/>
    <SolidColorBrush x:Key="AutoCompleteBackgroundBrushKey" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="AutoCompletePopupBackgroundBrushKey" Color="#FFE8E8E8"/>
    <LinearGradientBrush x:Key="AutoCompleteInnerPopupBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE8E8E8" Offset="0"/>
        <GradientStop Color="#FFE8E8E8" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AutoCompleteDisabledBrushKey" Color="#A5F7F7F7"/>
    <SolidColorBrush x:Key="AutoCompleteReadOnlyBrushKey" Color="#72F7F7F7"/>

    <local:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <local:BorderThicknessConverter x:Key="borderconverter"/>
    <local:ColumnSpanConverter x:Key="columnspanconverter"/>

	<!--Thumb Style-->
    <Style x:Key="AutoCompleteThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Ellipse Fill="{TemplateBinding Background}" Height="3" Width="3" Grid.Row="1" Grid.Column="1"/>
                        <Ellipse Fill="{TemplateBinding Background}" Height="3" Width="3" Grid.Row="0" Grid.Column="1"/>
                        <Ellipse Fill="{TemplateBinding Background}" Height="3" Width="3" Grid.Row="1" Grid.Column="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="Office2010BlackAutoCompleteStyle" TargetType="local:AutoComplete">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource AutoCompleteBorderBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource AutoCompleteBackgroundBrushKey}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="MinWidth" Value="45"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:AutoComplete">
                    <Grid x:Name="RootElement">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MouseOverBorder1" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DisabledVisualElement" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ReadOnly">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ReadOnlyVisualElement" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MouseOverBorder1" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused">
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ValidationStates">
                                <VisualState x:Name="Valid"/>
                                <VisualState x:Name="InvalidUnfocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ValidationErrorElement" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="InvalidFocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ValidationErrorElement" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="validationTooltip" Storyboard.TargetProperty="IsOpen">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <System:Boolean>True</System:Boolean>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border BorderBrush="{StaticResource TextBoxMouseOverBrushKey}" BorderThickness="{TemplateBinding BorderThickness}" x:Name="MouseOverBorder1" Opacity="0" />
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" x:Name="MouseOverBorder">
                            <Grid>
                                <Border x:Name="ReadOnlyVisualElement" Opacity="0" Background="{StaticResource AutoCompleteReadOnlyBrushKey}"/>
                                <Border BorderBrush="Transparent" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{TemplateBinding Text}" SelectionBackground="LightBlue"  Grid.Column="0" Foreground="{TemplateBinding Foreground}" Grid.ColumnSpan="{Binding DropDownButtonVisibility, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource columnspanconverter}}" x:Name="PART_EditableTextBox" Style="{StaticResource TextBox}" Background="{TemplateBinding Background}" BorderThickness="0"/>
                                        <Button Grid.Column="1" x:Name="PART_DropDownButton" IsTabStop="False" Visibility="{TemplateBinding DropDownButtonVisibility}" Style="{StaticResource Button}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                >
                                            <Grid>
                                                <Path Fill="{StaticResource GlyphBrushKey}" Stretch="Fill" Stroke="{StaticResource GlyphBrushKey}" Height="6.167" HorizontalAlignment="Center" VerticalAlignment="Center" Width="9.333" UseLayoutRounding="False" Data="M404,148 L412,159 L419,148 z"/>
                                                <Path Fill="#FFFFFFFF" Stretch="Fill" Stroke="{StaticResource GlyphBrushKey}" Height="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="1" UseLayoutRounding="False" Data="M371,194"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border x:Name="DisabledVisualElement" IsHitTestVisible="False" Opacity="0" Background="{StaticResource AutoCompleteDisabledBrushKey}" BorderBrush="{StaticResource AutoCompleteDisabledBrushKey}" BorderThickness="{TemplateBinding BorderThickness}" Grid.ColumnSpan="2"/>
                        <!--<Border x:Name="FocusVisualElement" Margin="1" IsHitTestVisible="False" Opacity="0" BorderBrush="#FF6DBDD1" BorderThickness="{TemplateBinding BorderThickness}" Grid.ColumnSpan="2"/>-->
                        <Border x:Name="ValidationErrorElement" Visibility="Collapsed" BorderBrush="#FFDB000C" BorderThickness="1" CornerRadius="1">
                            <ToolTipService.ToolTip>
                                <ToolTip x:Name="validationTooltip" DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}" Template="{StaticResource ValidationToolTipTemplate}" Placement="Right" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToolTip.Triggers>
                                        <EventTrigger RoutedEvent="Canvas.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="validationTooltip" Storyboard.TargetProperty="IsHitTestVisible">
                                                        <DiscreteObjectKeyFrame KeyTime="0">
                                                            <DiscreteObjectKeyFrame.Value>
                                                                <System:Boolean>true</System:Boolean>
                                                            </DiscreteObjectKeyFrame.Value>
                                                        </DiscreteObjectKeyFrame>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ToolTip.Triggers>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                            <Grid Height="12" HorizontalAlignment="Right" Margin="1,-4,-4,0" VerticalAlignment="Top" Width="12" Background="Transparent">
                                <Path Fill="#FFDC000C" Margin="1,3,0,0" Data="M 1,0 L6,0 A 2,2 90 0 1 8,2 L8,7 z"/>
                                <Path Fill="#ffffff" Margin="1,3,0,0" Data="M 0,0 L2,0 L 8,6 L8,8"/>
                            </Grid>
                        </Border>

                        <Canvas Grid.Row="1">
                            <Popup Canvas.Left="0" Canvas.Top="0" x:Name="PART_ACPopup" Visibility="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibility}}" IsOpen="{TemplateBinding IsDropDownOpen}">
								<Border>
                                    <Grid Background="{StaticResource AutoCompleteBorderBrushKey}">
                                        <local:AutoCompleteListBox Canvas.Top="0" Canvas.Left="0" x:Name="PART_Container" Height="{TemplateBinding MaxDropHeight}" MinHeight="{TemplateBinding MaxDropHeight}" Width="{Binding Path=Width, RelativeSource={RelativeSource TemplatedParent}}"
                                                                   SelectionMode="{TemplateBinding SelectionMode}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Background="{TemplateBinding Background}"
                                      Foreground="{TemplateBinding Foreground}" />
                                        <Thumb x:Name="ContainerThumb" Margin="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource AutoCompleteThumbStyle}"/>
                                    </Grid>
                                </Border>
                            </Popup>
                            <Popup x:Name="PART_HistoryPopup" IsOpen="{TemplateBinding IsHistoryDropDownOpen}">
								<Border>
                                    <Grid Background="{ StaticResource AutoCompleteBorderBrushKey}">
                                        <ListBox x:Name="PART_HistoryContainer" Width="{Binding Path=Width, RelativeSource={RelativeSource TemplatedParent}}" Height="{TemplateBinding HistoryListHeight}"
                                      BorderBrush="{TemplateBinding BorderBrush}" SelectionMode="{TemplateBinding SelectionMode}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Background="{TemplateBinding Background}"
                                      Foreground="{TemplateBinding Foreground}" />
                                        <Thumb x:Name="HistoryThumb" Margin="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource AutoCompleteThumbStyle}"/>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Canvas>
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:AutoComplete" BasedOn="{StaticResource Office2010BlackAutoCompleteStyle}"/>




</ResourceDictionary>

