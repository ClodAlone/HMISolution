<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <local:BooleanToOpacityConverter x:Key="BooleanToOpacityConvert"/>
    <local:VisibilityToBooleanConverter x:Key="VisibilityToBooleanConvert"/>

    <LinearGradientBrush x:Key="BackgroundBrush" EndPoint="0.032,0.957" StartPoint="0.032,0.066">
        <GradientStop Color="#FFEAEAEA" Offset="0.08"/>
        <GradientStop Color="#FFDFDFDF" Offset="0.936"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BorderBrush" Color="#FF3B3B3B"/>

    <LinearGradientBrush x:Key="MouseOverBrush" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFDECA9" Offset="0.011"/>
        <GradientStop Color="#FFFDE388" Offset="0.211"/>
        <GradientStop Color="#FFFBE389" Offset="0.65"/>
        <GradientStop Color="#FFFDFCF2" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="MouseOverBorderBrush" Color="#FFF1CA58"/>

    <LinearGradientBrush x:Key="SelectedBrush" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFFF37F" Offset="0.963"/>
        <GradientStop Color="#FFFFDA6C" Offset="0.665"/>
        <GradientStop Color="#FFFFD86C" Offset="0.084"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#FFC2943C"/>

    <SolidColorBrush x:Key="Foreground" Color="#FF363636"/>
    

    <Style x:Key="Office2010BlackTabNavigationControlStyle" TargetType="local:TabNavigationControl">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabNavigationControl">
                    <Grid>

                        <Border CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" 
                                Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid x:Name="Root">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Visibility="{TemplateBinding HeaderVisibility}" Background="#FF808080" BorderBrush="{StaticResource BorderBrush}" CornerRadius="8 8 0 0" Height="35">
                                    <Grid Margin="3,0,0,0">

                                        <ContentControl Content="{Binding Path=SelectedTabItem.Header, RelativeSource={RelativeSource TemplatedParent}}"
                                                    VerticalAlignment="Center" Margin="3" FontWeight="Bold" Foreground="White"/>


                                    </Grid>
                                </Border>
                                <ItemsPresenter HorizontalAlignment="Center" 
                                                Opacity="{Binding Path=TabStripVisibility,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource BooleanToOpacityConvert}}"
                                                IsHitTestVisible="{Binding Path=TabStripVisibility,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource VisibilityToBooleanConvert}}"
                                                VerticalAlignment="Center" Grid.Row="0"/>
                                <ContentControl x:Name="PART_OldContent" Grid.Row="1" />
                                <ContentControl x:Name="PART_SelectedContent" Content="{Binding Path=SelectedTabItem.Content, RelativeSource={RelativeSource TemplatedParent}}" 
                                                    Grid.Row="1" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" ContentTemplate="{Binding Path=ItemTemplate,RelativeSource={RelativeSource TemplatedParent}}">


                                </ContentControl>
                                <ContentControl x:Name="PART_FrontOldContent" Grid.Row="1" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <Button Visibility="{TemplateBinding NavigationButtonVisibility}" FontSize="20" Foreground="{StaticResource BorderBrush}" FontFamily="Wingdings 3" Grid.Row="1"  HorizontalAlignment="Left" VerticalAlignment="Center"  Margin="-20 0 0 0" Command="{Binding Path=PreviousCommand, RelativeSource={RelativeSource TemplatedParent}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid  Cursor="Hand">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="MouseOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="innerBorder" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MouseOverBrush}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="innerBorder" Storyboard.TargetProperty="BorderThickness">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ellipse" Storyboard.TargetProperty="BorderBrush">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MouseOverBorderBrush}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="innerBorder" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SelectedBrush}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="innerBorder" Storyboard.TargetProperty="BorderThickness">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ellipse" Storyboard.TargetProperty="BorderBrush">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SelectedBorderBrush}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Disabled">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ellipse" Storyboard.TargetProperty="Visibility">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="innerBorder" Storyboard.TargetProperty="Visibility">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Presenter" Storyboard.TargetProperty="Visibility">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border Height="40" Width="40" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource BackgroundBrush}" CornerRadius="12" BorderThickness="1"  x:Name="Ellipse">
                                            <Border BorderBrush="White" Background="{StaticResource BackgroundBrush}" CornerRadius="12" BorderThickness="0" x:Name="innerBorder">
                                                <Path x:Name="PART_Presenter" Data="M-68.5,52 L-54,69.5 -68.787684,85.24501" HorizontalAlignment="Center" Margin="20,0,0,0"  Stretch="Fill" Stroke="{StaticResource BorderBrush}" Width="10.03" Fill="{x:Null}" StrokeThickness="3" Height="18.553" VerticalAlignment="Center">
                                                    <Path.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform ScaleY="1" ScaleX="-1"/>
                                                            <SkewTransform AngleY="0" AngleX="0"/>
                                                            <RotateTransform Angle="0"/>
                                                            <TranslateTransform/>
                                                        </TransformGroup>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Row="1"  Visibility="{TemplateBinding NavigationButtonVisibility}" FontSize="20" Foreground="{StaticResource BorderBrush}" FontFamily="Wingdings 3" HorizontalAlignment="Right" VerticalAlignment="Center"  Margin="0 0 -20 0" Command="{Binding Path=NextCommand, RelativeSource={RelativeSource TemplatedParent}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid  Cursor="Hand">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="MouseOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="innerBorder" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MouseOverBrush}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="innerBorder" Storyboard.TargetProperty="BorderThickness">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ellipse" Storyboard.TargetProperty="BorderBrush">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MouseOverBorderBrush}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="innerBorder" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SelectedBrush}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="innerBorder" Storyboard.TargetProperty="BorderThickness">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ellipse" Storyboard.TargetProperty="BorderBrush">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SelectedBorderBrush}"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Disabled">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ellipse" Storyboard.TargetProperty="Visibility">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="innerBorder" Storyboard.TargetProperty="Visibility">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Presenter" Storyboard.TargetProperty="Visibility">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border Height="40" Width="40" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource BackgroundBrush}" BorderThickness="1" CornerRadius="12"  x:Name="Ellipse">
                                            <Border BorderBrush="White" Background="{StaticResource BackgroundBrush}" CornerRadius="12" BorderThickness="0" x:Name="innerBorder">
                                                <Path x:Name="PART_Presenter" Data="M-68.5,52 L-54,69.5 -68.787684,85.24501" HorizontalAlignment="Center" Stretch="Fill" Stroke="{StaticResource BorderBrush}" Width="10.03" Fill="{x:Null}" StrokeThickness="3" Height="18.553" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel  Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2010BlackTabNavigationControlStyle}" TargetType="local:TabNavigationControl"/>

    <Style TargetType="Button" x:Key="TabStripButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid  Cursor="Hand">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ellipse" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MouseOverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ellipse" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MouseOverBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Ellipse Stroke="{StaticResource BorderBrush}" Fill="{TemplateBinding Background}" Width="10" Height="10" x:Name="Ellipse"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Office2010BlackTabNavigationItemStyle" TargetType="local:TabNavigationItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabNavigationItem">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_TabStripButton" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource BorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="UnSelected"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Button  x:Name="PART_TabStripButton" Background="Transparent" Command="{Binding Path=SelectCommand, RelativeSource={RelativeSource TemplatedParent}}" Margin="3"  Style="{StaticResource TabStripButtonStyle}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2010BlackTabNavigationItemStyle}" TargetType="local:TabNavigationItem"/>

    <Style TargetType="local:NavigationToolTip">
        <Setter Property="Height" Value="70"/>
        <Setter Property="Width" Value="70"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:NavigationToolTip">
                    <Grid>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Background="{StaticResource BackgroundBrush}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
