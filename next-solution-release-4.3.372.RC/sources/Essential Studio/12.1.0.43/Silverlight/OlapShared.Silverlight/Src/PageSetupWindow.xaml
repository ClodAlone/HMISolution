<sync:WindowControl x:Class="Syncfusion.Silverlight.Shared.Olap.PageSetupWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
           xmlns:sync="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
           xmlns:syncControls="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.Silverlight"
           xmlns:resource="clr-namespace:Syncfusion.OlapShared.Silverlight.Resources"
           AnimationType="Zoom" ResizeMode="NoResize"
           Height="212" Width="400"
           Icon="Images/PageSettings.png">
    <sync:WindowControl.Resources>
        <resource:ResourceWrapper x:Key="resourceWrapper"/>
    </sync:WindowControl.Resources>
    <Grid x:Name="LayoutRoot" Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <StackPanel x:Name="categoricalPageSettings">
                <TextBlock Text="{Binding ColumnPageSettings,Source={StaticResource resourceWrapper}}" Margin="10" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PageSize,Source={StaticResource resourceWrapper}}" VerticalAlignment="Center" Margin="10,5" />
                    <syncControls:NumericUpDown x:Name="categoricalPageSize" Width="75" Margin="5" Minimum="1" />
                    <TextBlock Text="{Binding CurrentPage,Source={StaticResource resourceWrapper}}" VerticalAlignment="Center" Margin="5" />
                    <syncControls:NumericUpDown x:Name="categoricalCurrentPage"  Width="75" Margin="5" Minimum="1" />
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="seriesPageSettings">
                <TextBlock Text="{Binding RowPageSettings,Source={StaticResource resourceWrapper}}" Margin="10" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PageSize,Source={StaticResource resourceWrapper}}" VerticalAlignment="Center" Margin="10,5" />
                    <syncControls:NumericUpDown x:Name="seriesPageSize" Width="75" Margin="5" Minimum="1" />
                    <TextBlock Text="{Binding CurrentPage,Source={StaticResource resourceWrapper}}" VerticalAlignment="Center" Margin="5" />
                    <syncControls:NumericUpDown x:Name="seriesCurrentPage" Width="75" Margin="5" Minimum="1" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <Button x:Name="CancelButton" Content="{Binding Button_Cancel,Source={StaticResource resourceWrapper}}" Click="CancelButton_Click" Width="75" Height="23" HorizontalAlignment="Right" Margin="0,12,0,0" Grid.Row="1" />
        <Button x:Name="OKButton" Content="{Binding Button_OK,Source={StaticResource resourceWrapper}}" Click="OKButton_Click" Width="75" Height="23" HorizontalAlignment="Right" Margin="0,12,79,0" Grid.Row="1" />
    </Grid>
</sync:WindowControl>
                    