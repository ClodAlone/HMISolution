    <local:ResourceWrapper x:Key="ResourceWrapper"/>
    
    <Style TargetType="local:ScheduleRecurrenceConfirmationWindow">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleRecurrenceConfirmationWindow">
                    <Grid x:Name="grid" Background="{TemplateBinding Background}">
						<Grid.RowDefinitions>
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock x:Name="PART_Message" Margin="2" Text="{Binding Appointment.RecurrenceAlertMessage, Mode=TwoWay}" TextWrapping="Wrap"/>
                        <RadioButton Grid.Row="1" Margin="2" VerticalAlignment="Center" x:Name="PART_NonRecurrence" IsChecked="{Binding Appointment.IsRecurrenceAppointment, Converter={StaticResource RadioCheckedConverterKey}, Mode=TwoWay}" Content="{Binding Source={StaticResource ResourceWrapper},Path=RecurrenceAlertWindowOpen}"/>
                        <RadioButton Grid.Row="2" Margin="2" VerticalAlignment="Center" x:Name="PART_Recurrence" IsChecked="{Binding Appointment.IsRecurrenceAppointment, Mode=TwoWay}" Content="{Binding Source={StaticResource ResourceWrapper},Path=RecurrenceAlertWindowOpenSeries}"/>
						<StackPanel Grid.Row="3" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="{Binding Source={StaticResource ResourceWrapper},Path=Ok}" x:Name="PART_OkButton" Height="23" Width="60" Margin="2"/>
                            <Button Content="{Binding Source={StaticResource ResourceWrapper},Path=Cancel}" x:Name="PART_CancelButton" Height="23" Width="60" Margin="2"/>
						</StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>      
    <Style TargetType="local:ScheduleDaysAppointmentViewControl">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFE5E6E6" Offset="0.023"/>
                    <GradientStop Color="#FFC9CDD3" Offset="0.93"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#FFB0B6BE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Common">
                                <VisualStateGroup.Transitions>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_BorderElement" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_BorderSelectedElement" Storyboard.TargetProperty="(Shape.StrokeThickness)">
                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="2"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_SubjectText" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Thickness>2</Thickness>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_LocationText" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Thickness>2</Thickness>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_BorderSelectedElement" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FF000000"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="20*"/>
                            </Grid.RowDefinitions>
                                <Rectangle Grid.RowSpan="2" Fill="{Binding Status.Brush}" />
                                <!--<Border x:Name="PriorityBorder" Background="Transparent" Grid.RowSpan="2"/>-->
                                <!--<local:ScheduleCrosslineControl x:Name="CrossLineContol" Margin="0" Padding="0"  Grid.RowSpan="2" Visibility="Collapsed"/>-->
                                <TextBlock x:Name="PART_SubjectText" HorizontalAlignment="Stretch" VerticalAlignment="Top" Grid.Row="0" Grid.Column="1" FontFamily="Verdana" FontSize="11" FontWeight="Bold" Text="{Binding Subject}" TextWrapping="NoWrap"/>
                                <TextBlock x:Name="PART_LocationText" HorizontalAlignment="Stretch" VerticalAlignment="Top" Grid.Row="1" Grid.Column="1" FontFamily="Verdana" FontSize="11" Text="{Binding Location}" TextWrapping="NoWrap"/>
                        </Grid>
                        </Border>
                        <Grid x:Name="PART_BorderElement" Visibility="Collapsed">
                            <Rectangle x:Name="PART_BorderSelectedElement" Stroke="Transparent"/>
                            <Rectangle x:Name="PART_TopRect" Stroke="Black" Fill="White" Margin="0,-2,0,0" StrokeThickness="1" Width="5" Height="5" VerticalAlignment="Top" HorizontalAlignment="Center" />
                            <Rectangle x:Name="PART_BottomRect" Stroke="Black" Fill="White" Margin="0,0,0,-2" StrokeThickness="1" Width="5" Height="5" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                            <Border x:Name="PART_TopEdge" Height="5" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS" />
                            <Border x:Name="PART_BottomEdge" Height="5" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>	
