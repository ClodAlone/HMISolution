    <Style TargetType="local:Schedule">        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Schedule">
                    <Grid x:Name="PART_MainGrid" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Visibility">
                                <VisualState x:Name="CalendarCollapsed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_MainGrid" Storyboard.TargetProperty="(Grid.ColumnDefinitions)[0].Width">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CalendarVisible"/>                                
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>                             
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>                       
                        <Border x:Name="PART_CalendarViewBorder" Visibility="{TemplateBinding CalendarVisibility}" Background="#FFE1E5EA" Grid.Column="0">
                            <local:ScheduleCalendarViewItemsControl x:Name="PART_CalendarView" Width="auto" CalendarItemsCount="{TemplateBinding CalendarItemsCount}" />
                        </Border>
                        <controls:GridSplitter Grid.Column="0" Margin="2,0,0,0" Visibility="{TemplateBinding CalendarVisibility}" Style="{StaticResource Office14SilverGridSplitterStyle}"></controls:GridSplitter>
                        <Grid Grid.Column="2">
                           <Border BorderBrush="#FFC1CEDE" BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFC5D3E3" ShadowDepth="2"/>
                                </Border.Effect>
                            </Border >
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <local:ScheduleHeaderTitleBar x:Name="PART_HeaderTitleBar" SelectedDatesConverter="{TemplateBinding TitleBarTextConverter}"  Visibility="{TemplateBinding TitleBarVisibility}" Background="{StaticResource Office14BlackBackgroundBrush}" Foreground="{StaticResource Office14BlackForegroundBrush}" BorderBrush="{StaticResource Office14BlackBorderBrush}" FontFamily="/Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI" FontSize="16" VerticalAlignment="Center" />
                                <local:ContentViewItemsControl x:Name="PART_MainViewItems" Margin="2" Grid.Row="1" SelectedIndex="0">
                                    <local:ScheduleDaysView x:Name="PART_DaysView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" TimelineHourDivisionVisibility="{TemplateBinding TimelineHourDivisionVisibility}" TimelineVisibility="{TemplateBinding TimelineVisibility}"  />
                                    <local:ScheduleMonthView x:Name="PART_MonthView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    <local:ScheduleHorizontalView x:Name="PART_HorizontalView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" TimelineVisibility="{TemplateBinding TimelineVisibility}" />
                                </local:ContentViewItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>