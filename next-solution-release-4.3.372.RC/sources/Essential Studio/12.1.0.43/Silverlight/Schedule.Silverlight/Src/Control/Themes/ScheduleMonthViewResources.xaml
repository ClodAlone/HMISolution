<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Schedule"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight">

    <local:BoolToVisibilityConverter x:Key="BoolToVisibleConverter"/>
    <!--Side Text Content Control-->
    <LinearGradientBrush x:Key="TodayHeaderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFED79" Offset="0"/>
        <GradientStop Color="#FFFFD86B" Offset="0.5"/>
        <GradientStop Color="#FFFFEA77" Offset="0.952"/>
        <GradientStop Color="#FFA5BFE1" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="ContextMenuAdvStyle" TargetType="shared:ContextMenuAdv">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#FFB4B4B4"/>
        <Setter Property="SubMenuBackground" Value="#FFF0F0F0"/>
        <Setter Property="SubMenuBorderThickness" Value="1"/>
        <Setter Property="SubMenuBorderBrush" Value="#FFB4B4B4"/>

        <Setter Property="Padding" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shared:ContextMenuAdv">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="2">
                        <Border.Effect>
                            <DropShadowEffect
									Color="LightGray"
									ShadowDepth="3"/>
                        </Border.Effect>
                        <Grid>
                            <Rectangle RadiusX="2" RadiusY="2" Fill="White" Width="28" Margin="2" HorizontalAlignment="Left"/>
                            <Rectangle Fill="LightGray" Width="1" Margin="30,2,0,2" HorizontalAlignment="Left"/>
                            <Rectangle Fill="White" Width="1" Margin="31,2,0,2" HorizontalAlignment="Left"/>
                            <ItemsPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:ScheduleMonthViewSideContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleMonthViewSideContentControl">
                    <Grid Background="{TemplateBinding Background}" UseLayoutRounding="True" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <local:ScheduleRectangleBorder x:Name="SideTextBorder" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{TemplateBinding SelectionBackground}" BorderThickness="1,1,0,1" BottomBrush="{TemplateBinding BorderBrush}" LeftBrush="{TemplateBinding BorderBrush}" TopBrush="{TemplateBinding BorderBrush}"/>                      
                        <local:ScheduleSideTextBlock x:Name="SideTextBlock" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" Text="{TemplateBinding SideText}"/>                                               
                    </Grid>                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
   
    <Style TargetType="local:ScheduleSideTextBlock">       
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Vertical"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>        
    </Style>


    <ItemsPanelTemplate x:Key="ScheduleMonthViewSideItemsControlPanelKey">
        <local:ScheduleMonthViewSideItemsLayoutPanel ></local:ScheduleMonthViewSideItemsLayoutPanel>
    </ItemsPanelTemplate>

    <!--Side Text Items Control-->
    <Style TargetType="local:ScheduleMonthViewSideItemsControl">
        <Setter Property="ItemsPanel" Value="{StaticResource ScheduleMonthViewSideItemsControlPanelKey}"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleMonthViewSideItemsControl">
                    <Grid>
                        <ItemsPresenter Margin="0"></ItemsPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Header Content Control-->
    <Style TargetType="local:ScheduleMonthViewHeaderControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleMonthViewHeaderControl">
                    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                        <local:ScheduleRectangleBorder x:Name="DayTextBorder" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" LeftBrush="{TemplateBinding BorderBrush}" RightBrush="{TemplateBinding BorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <TextBlock x:Name="DayText" HorizontalAlignment="Center" Margin="1,0,0,1" VerticalAlignment="Center" Text="{TemplateBinding DayText}" FontSize="12" FontFamily="Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ItemsPanelTemplate x:Key="ScheduleMonthViewHeaderItemsControlPanelKey">
        <local:ScheduleMonthViewHeaderItemsLayoutPanel ></local:ScheduleMonthViewHeaderItemsLayoutPanel>
    </ItemsPanelTemplate>

    <!--HeaderItemsControl-->
    <Style TargetType="local:ScheduleMonthViewHeaderItemsControl">
        <Setter Property="ItemsPanel" Value="{StaticResource ScheduleMonthViewHeaderItemsControlPanelKey}"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleMonthViewHeaderItemsControl">
                    <Grid>
                        <ItemsPresenter></ItemsPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="Button" x:Key="NavigatorStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Path Fill="#FFBEBEBE" Stretch="Fill" Stroke="White" Margin="1.5" Height="10" Width="15" UseLayoutRounding="False" Data="M93.25,100.25 L334.25,101.25 L218.25,269.25 z"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--MonthviewDaysControl-->
    <Style TargetType="local:ScheduleMonthDateContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleMonthDateContentControl">
                    <Grid x:Name="LayoutRoot" Margin="0,0,-1,0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="VisualStategroup">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="ContentSelected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="SelectedContentRectangle" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CurrentDateNormal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DateRectangle" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TodayHeaderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="Border" Storyboard.TargetProperty="(ScheduleRectangleBorder.LeftBrush).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFEB8900"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="Border" Storyboard.TargetProperty="(ScheduleRectangleBorder.TopBrush).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFEB8900"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CurrentDateSelected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="SelectedContentRectangle" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DateRectangle" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TodayHeaderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="Border" Storyboard.TargetProperty="(ScheduleRectangleBorder.TopBrush).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFEB8900"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="Border" Storyboard.TargetProperty="(ScheduleRectangleBorder.LeftBrush).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFEB8900"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="NotCurrentMonth">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="NonMonthContentRectangle" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup>
                                <VisualState x:Name="OverFlowing">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="Navigation" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="NonOverFlowing">
                                    <Storyboard>                                       
                                        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="Navigation" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>                            
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <local:ScheduleRectangleBorder x:Name="Border" Background="{TemplateBinding ScheduleBackground}" BorderBrush="{TemplateBinding StrokeLine}"  BorderThickness="{TemplateBinding StrokeThickness}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" Grid.RowSpan="2" BottomBrush="{TemplateBinding StrokeLine}" LeftBrush="{TemplateBinding StrokeLine}" RightBrush="{TemplateBinding StrokeLine}" TopBrush="{TemplateBinding StrokeLine}"/>
                        <!--<local:ScheduleCrosslineControl x:Name="CrossLineContol" Grid.RowSpan="2" Visibility="Collapsed"/>-->
                        <Rectangle x:Name="ContentRectangle" Fill="Transparent" Grid.Row="1"/>
                        <Rectangle x:Name="SelectedContentRectangle" Visibility="Collapsed" Fill="{TemplateBinding SelectionBackground}" Grid.Row="1"/>
                        <Rectangle x:Name="NonMonthContentRectangle" Visibility="Collapsed" Fill="{TemplateBinding HeaderBrush}" Grid.Row="1"/>
                        <Rectangle x:Name="DateRectangle" Fill="{TemplateBinding HeaderBrush}" Grid.Row="0"/>
                        <TextBlock x:Name="Date" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}" FontSize="13" FontWeight="Bold" Text="{TemplateBinding DateText}" FontFamily="Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI"/>                   
                        <Button x:Name="Navigation" Style="{StaticResource NavigatorStyle}" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0"></Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ItemsPanelTemplate x:Key="ScheduleMonthViewItemsControlPanelKey">
        <local:UniformGrid  Columns="7"></local:UniformGrid>
    </ItemsPanelTemplate>

    <!--MonthViewItemsControl-->
    <Style TargetType="local:ScheduleMonthViewItemsControl">
        <Setter Property="ItemsPanel" Value="{StaticResource ScheduleMonthViewItemsControlPanelKey}"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleMonthViewItemsControl">
                    <Grid>
                        <ItemsPresenter></ItemsPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Appointment Layout Panel-->
    <Style TargetType="local:ScheduleMonthAppointmentLayoutItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:ScheduleMonthAppointmentLayoutPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleMonthAppointmentLayoutItemsControl">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <Grid>
                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--MonthView-->
    <Style TargetType="local:ScheduleMonthView">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleMonthView">
                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="0" BorderThickness="0">
                        <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.05*"/>
                                <RowDefinition Height="0.95*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <local:ScheduleMonthViewHeaderItemsControl x:Name="PART_MonthViewHeaderItemsControl" Grid.Row="0" Grid.Column="1" />
                            <local:ScheduleMonthViewSideItemsControl Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Model.MonthViewWeekHeaderVisibility}" x:Name="PART_MonthViewSideItmesControl" Margin="0" Grid.Column="0" Grid.Row="1"/>
                            <Grid Grid.Row="1" Grid.Column="1" Background="{TemplateBinding Background}">                                
                                <local:ScheduleMonthViewItemsControl x:Name="PART_MonthViewItemsControl" Grid.Column="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <shared:ContextMenuAdvService.ContextMenuAdv>
                                        <shared:ContextMenuAdv Style="{StaticResource ContextMenuAdvStyle}"  Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}" x:Name="ContextMenuMonthViewItemsControl" />
                                    </shared:ContextMenuAdvService.ContextMenuAdv>
                                </local:ScheduleMonthViewItemsControl>
                                <local:ScheduleMonthAppointmentLayoutItemsControl x:Name="PART_MonthViewAppointmentLayout" Grid.Column="1">
                                        <shared:ContextMenuAdvService.ContextMenuAdv>
                                        <shared:ContextMenuAdv Style="{StaticResource ContextMenuAdvStyle}" x:Name="ContextMenuMonthViewAppointmentLayout" Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}"/>
                                    </shared:ContextMenuAdvService.ContextMenuAdv>
                                </local:ScheduleMonthAppointmentLayoutItemsControl>
                                <local:ScheduleAppointmentNavigatorControl Grid.Column="1" x:Name="PART_AppointmentNavigatorControl"/>                               
                                <Grid x:Name="AppointmentPopUp"></Grid>
                                <Grid x:Name="PART_TodayBrushGrid" />
                            </Grid>                            
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
