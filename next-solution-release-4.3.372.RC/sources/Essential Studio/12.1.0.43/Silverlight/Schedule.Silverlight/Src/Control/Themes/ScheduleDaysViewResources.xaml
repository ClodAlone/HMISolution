<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Schedule"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"
    >
    <local:BoolToVisibilityConverter x:Key="BoolToVisibleConverter"/>
    <LinearGradientBrush x:Key="TodayHeaderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFED79" Offset="0"/>
        <GradientStop Color="#FFFFD86B" Offset="0.5"/>
        <GradientStop Color="#FFFFEA77" Offset="0.952"/>
        <GradientStop Color="#FFA5BFE1" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="ContextMenuAdvStyle" TargetType="shared:ContextMenuAdv">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#FFB4B4B4"/>
        <Setter Property="SubMenuBackground" Value="#FFF0F0F0"/>
        <Setter Property="SubMenuBorderThickness" Value="1"/>
        <Setter Property="SubMenuBorderBrush" Value="#FFB4B4B4"/>
    
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shared:ContextMenuAdv">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="2">
                        <Border.Effect>
                            <DropShadowEffect
									Color="LightGray"
									ShadowDepth="3"/>
                        </Border.Effect>
                        <Grid>
                            <Rectangle RadiusX="2" RadiusY="2" Fill="White" Width="28" Margin="2" HorizontalAlignment="Left"/>
                            <Rectangle Fill="LightGray" Width="1" Margin="30,2,0,2" HorizontalAlignment="Left"/>
                            <Rectangle Fill="White" Width="1" Margin="31,2,0,2" HorizontalAlignment="Left"/>
                            <ItemsPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:ScheduleDaysHeaderViewControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleDaysHeaderViewControl">
                    <Border x:Name="border" Margin="0,0,-2,-1" Background="{TemplateBinding HeaderBrush}" BorderBrush="{TemplateBinding StrokeLine}" BorderThickness="{TemplateBinding StrokeThickness}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="VisualStateGroup">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Current">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_CurrentRectangle" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFEB8900"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_SelectedRectangle" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CurrentAndSelected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_CurrentRectangle" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFEB8900"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <!--<ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_SelectedRectangle" Storyboard.TargetProperty="(UIElement.Fill).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FF4C535C"/>
                                        </ColorAnimationUsingKeyFrames>-->
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_SelectedRectangle" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="20"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Rectangle x:Name="PART_CurrentRectangle" Height="20" Fill="{StaticResource TodayHeaderBrush}" VerticalAlignment="Top" Visibility="Collapsed" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"/>
                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1" Grid.Row="0" Text="{TemplateBinding DateText}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" />
                            <Border VerticalAlignment="Center" Grid.Column="1" Grid.Row="0" >
                                <TextBlock HorizontalAlignment="Center" x:Name="DaysTextBlock" VerticalAlignment="Center" Text="{TemplateBinding DayText}" TextWrapping="Wrap" />
                            </Border>
                            <Rectangle x:Name="PART_HeaderRectangle" Fill="{TemplateBinding HeaderBrush}" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" />
                            <Rectangle x:Name="PART_SelectedRectangle" Fill="{TemplateBinding SelectionBackground}" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Visibility="Collapsed"/>                            
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ItemsPanelTemplate x:Key="ScheduleDaysHeaderItemsPanelKey">        
        <local:ScheduleDaysHeaderViewLayoutPanel ></local:ScheduleDaysHeaderViewLayoutPanel>
    </ItemsPanelTemplate>

    <Style TargetType="local:ScheduleDaysHeaderViewItemsControl">
        <Setter Property="ItemsPanel" Value="{StaticResource ScheduleDaysHeaderItemsPanelKey}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleDaysHeaderViewItemsControl">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <Grid>
                            <ItemsPresenter/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ScheduleTimeSlotControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleTimeSlotControl">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="VisualStateGroup">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Shaded">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_ShadedBorder" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="IsCurrent">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="(ScheduleRectangleBorder.LeftBrush).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFEB8900"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="(ScheduleRectangleBorder.RightBrush).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFEB8900"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="IsCurrentAndShaded">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_ShadedBorder" Storyboard.TargetProperty="(ScheduleRectangleBorder.LeftBrush).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFEB8900"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_ShadedBorder" Storyboard.TargetProperty="(ScheduleRectangleBorder.RightBrush).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFEB8900"/>
                                        </ColorAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_ShadedBorder" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <local:ScheduleRectangleBorder x:Name="PART_Border" Background="{TemplateBinding ScheduleBackground}" BorderThickness="{TemplateBinding StrokeThickness}" LeftBrush="{TemplateBinding StrokeLine}" BottomBrush="{TemplateBinding StrokeLine}" RightBrush="{TemplateBinding StrokeLine}" TopBrush="{TemplateBinding StrokeLine}"/>
                        <local:ScheduleRectangleBorder x:Name="PART_ShadedBorder" Background="{TemplateBinding ShadedBackground}" BorderThickness="{TemplateBinding StrokeThickness}" LeftBrush="{TemplateBinding StrokeLine}" BottomBrush="{TemplateBinding StrokeLine}" RightBrush="{TemplateBinding StrokeLine}" TopBrush="{TemplateBinding StrokeLine}" Visibility="Collapsed"/>
                        <local:UniformStackPanel x:Name="PART_TimeSlotPanel" Orientation="Vertical"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ItemsPanelTemplate x:Key="ScheduleTimeSlotItemsPanelKey">
        <local:UniformTimeSlotPanel />
    </ItemsPanelTemplate>

    <Style TargetType="local:ScheduleTimeSlotItemsControl">
        <Setter Property="ItemsPanel" Value="{StaticResource ScheduleTimeSlotItemsPanelKey}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleTimeSlotItemsControl">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <Grid>
                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="local:ScheduleDaysAppointmentLayoutItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:ScheduleDaysAppointmentLayoutPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleDaysAppointmentLayoutItemsControl">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <Grid>
                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="local:ScheduleAllDaysAppointmentItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:ScheduleAllDaysAppointmentLayoutPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleAllDaysAppointmentItemsControl">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <Grid>
                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ScheduleRectangleBorder">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleRectangleBorder">
                    <Grid Background="{TemplateBinding Background}">
                        <Line Stretch="Fill" Stroke="{TemplateBinding LeftBrush}" StrokeThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderThickness.Left}" Y2="1" HorizontalAlignment="Left" />
                        <Line Stretch="Fill" Stroke="{TemplateBinding RightBrush}" StrokeThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderThickness.Right}" Y2="0" HorizontalAlignment="Right" />
                        <Line Stretch="Fill" Stroke="{TemplateBinding TopBrush}" StrokeThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderThickness.Top}" X2="1" VerticalAlignment="Top" />
                        <Line Stretch="Fill" Stroke="{TemplateBinding BottomBrush}" StrokeThickness="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=BorderThickness.Bottom}" X2="1" VerticalAlignment="Bottom" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ScheduleRectangleBorderExt">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScheduleRectangleBorderExt">
                    <Grid x:Name="grid" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="VisualStateGroup">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="Selectedrectangle" Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Marked">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="rectangle" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)">
                                            <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFC6CBD1"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Line Stretch="Fill" Stroke="{TemplateBinding LeftBrush}" StrokeThickness="{Binding BorderThickness.Left, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left" Y2="1"/>
                        <Line Stretch="Fill" Stroke="{TemplateBinding RightBrush}" StrokeThickness="{Binding BorderThickness.Right, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Right" Y2="1"/>
                        <Line Stretch="Fill" Stroke="{TemplateBinding TopBrush}" StrokeThickness="{Binding BorderThickness.Top, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Top" X2="1"/>
                        <Line Stretch="Fill" Stroke="{TemplateBinding BottomBrush}" StrokeThickness="{Binding BorderThickness.Bottom, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Bottom" X2="1"/>
                        <Rectangle x:Name="rectangle" Margin="{TemplateBinding BorderThickness}" Fill="Transparent" />
                        <Rectangle x:Name="Selectedrectangle" Fill="{TemplateBinding SelectionBackground}" Margin="{TemplateBinding BorderThickness}" Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

