                            <Path Stretch="Fill" Height="10" HorizontalAlignment="Left" Width="10" RenderTransformOrigin="0.500000003205565,0.499999991730415" UseLayoutRounding="False" Data="M0,0 L0.09475252,0 18,17.905249 18,18 0,18 z">
