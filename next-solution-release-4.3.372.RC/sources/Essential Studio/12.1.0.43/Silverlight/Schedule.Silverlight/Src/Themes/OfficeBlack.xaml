                                            <TextBox Margin="2,0,4,2" Grid.Column="1" Height="22" FontSize="11" Grid.Row="1" Text="{Binding Appointment.Location, Mode=TwoWay}" TextWrapping="Wrap" Style="{StaticResource Office14BlackTextBoxStyle}"/>
                                    </Grid>
