                                            <TextBlock Margin="5,0,0,0" FontSize="11" Height="22" VerticalAlignment="Center" Grid.Row="1" FontFamily="Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI" Text="{Binding Source={StaticResource ResourceWrapper},Path=AppWindowEndTime}" TextWrapping="Wrap" Foreground="White"/>
                                            <controls:DatePicker x:Name="StartDatePicker" Height="22" FontFamily="Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI" FontSize="11" Margin="2" SelectedDate="{Binding Appointment.StartTime, Mode=TwoWay}" Grid.Column="1" Grid.Row="0" CalendarStyle="{StaticResource Office14BlackDatePickerCalendarStyle}" Style="{StaticResource Office14BlackDatePickerStyle}"/>
                                            <controls:DatePicker x:Name="EndDatePicker" Height="22" FontFamily="Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI" FontSize="11" Margin="2,0,2,2" SelectedDate="{Binding Appointment.EndTime, Mode=TwoWay}" Grid.Column="1" Grid.Row="1" CalendarStyle="{StaticResource Office14BlackDatePickerCalendarStyle}" Style="{StaticResource Office14BlackDatePickerStyle}"/>
                                            <ComboBox Height="22" x:Name="Start_Time" FontFamily="Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI" FontSize="11" IsEnabled="{Binding IsChecked, Converter={StaticResource CheckedToEnabledConverterKey}, ElementName=chkAllDay}" Margin="2" MaxDropDownHeight="300" ItemsSource="{Binding StartTimeIntervalSource}" SelectedItem="{Binding Appointment.StartTimeSpan, Mode=TwoWay}"  Grid.Column="2" Grid.Row="0" Style="{StaticResource Office14BlackComboBoxStyle}" ItemContainerStyle="{StaticResource Office14BlackComboBoxItemStyle}"/>
                                            <ComboBox Height="22" x:Name="End_Time" FontFamily="Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI" FontSize="11" IsEnabled="{Binding IsChecked, Converter={StaticResource CheckedToEnabledConverterKey}, ElementName=chkAllDay}" Margin="2,0,2,2"  MaxDropDownHeight="300" ItemsSource="{Binding EndTimeIntervalSource}" SelectedItem="{Binding Appointment.EndTimeSpan, Mode=TwoWay}" Grid.Column="2" Grid.Row="1" Style="{StaticResource Office14BlackComboBoxStyle}" ItemContainerStyle="{StaticResource Office14BlackComboBoxItemStyle}"/>
                                            <!--<ComboBox Visibility="{Binding ElementName=PART_TimeZonesButton, Path=IsChecked, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Grid.Row="0" Grid.Column="3" Style="{StaticResource Office14BlackComboBoxStyle}" ItemContainerStyle="{StaticResource Office14BlackComboBoxItemStyle}" Margin="2" Height="22" FontSize="11" x:Name="StartTimeZoneComboBox" Width="180"/>
                                            <ComboBox Visibility="{Binding ElementName=PART_TimeZonesButton, Path=IsChecked, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}" Grid.Row="1" Grid.Column="3" Style="{StaticResource Office14BlackComboBoxStyle}" ItemContainerStyle="{StaticResource Office14BlackComboBoxItemStyle}" Margin="2,0,2,2" Height="22" FontSize="11" x:Name="EndTimeZoneComboBox" Width="18"/>-->
                                            <CheckBox x:Name="chkAllDay" Height="22" FontFamily="Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI" FontSize="11" Margin="2,2,0,0" VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper},Path=AppWindowAllDay}" Grid.Column="4" IsChecked="{Binding Appointment.AllDay, Mode=TwoWay}" Foreground="White" Style="{StaticResource OfficeBlackCheckBoxStyle}"/>
                                    </Grid>
                                    <TextBox BorderThickness="1" FontFamily="Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI" FontSize="12" Height="326" Margin="4" AcceptsReturn="True" Text="{Binding Appointment.Notes, Mode=TwoWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource Office14BlackTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>
                            </ScrollViewer>
                            <Border BorderBrush="#FF929292" BorderThickness="0">
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="Office14BlackAppointmentScheduleWindowStyle" TargetType="controls:ChildWindow">
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="TabNavigation" Value="Cycle"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFA3AEB9" Offset="0"/>
                    <GradientStop Color="#FF8399A9" Offset="0.375"/>
                    <GradientStop Color="#FF718597" Offset="0.375"/>
                    <GradientStop Color="#FF617584" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="OverlayBrush" Value="#7F000000"/>
        <Setter Property="OverlayOpacity" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ChildWindow">
                    <Grid x:Name="Root">
                        <Grid.Resources>
                            <Style x:Key="ButtonStyle" TargetType="Button">
                                <Setter Property="Background" Value="#FF1F3B53"/>
                                <Setter Property="Foreground" Value="#FF000000"/>
                                <Setter Property="Padding" Value="3"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="#FFA3AEB9" Offset="0"/>
                                            <GradientStop Color="#FF8399A9" Offset="0.375"/>
                                            <GradientStop Color="#FF718597" Offset="0.375"/>
                                            <GradientStop Color="#FF617584" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="grid" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Width="18" Background="#02FFFFFF">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="MouseOver">
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="X_Fuzz2" Storyboard.TargetProperty="Visibility">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                                </ObjectAnimationUsingKeyFrames>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="X_Fuzz1" Storyboard.TargetProperty="Visibility">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                                </ObjectAnimationUsingKeyFrames>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="X_Fuzz0" Storyboard.TargetProperty="Visibility">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                                </ObjectAnimationUsingKeyFrames>
                                                                <DoubleAnimation Duration="0" Storyboard.TargetName="X" Storyboard.TargetProperty="Opacity" To="0.95"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>
                                                                <DoubleAnimation Duration="0" Storyboard.TargetName="X" Storyboard.TargetProperty="Opacity" To="0.85"/>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="X_Fuzz2" Storyboard.TargetProperty="Visibility">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                                </ObjectAnimationUsingKeyFrames>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="X_Fuzz1" Storyboard.TargetProperty="Visibility">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                                </ObjectAnimationUsingKeyFrames>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="X_Fuzz0" Storyboard.TargetProperty="Visibility">
                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Disabled">
                                                            <Storyboard>
                                                                <DoubleAnimation Duration="0" Storyboard.TargetName="X" Storyboard.TargetProperty="Opacity" To="0.5"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Path x:Name="X_Fuzz2" Fill="#14CECECE" Stretch="Fill" Height="10" HorizontalAlignment="Center" Margin="0,-1,0,0" VerticalAlignment="Center" Width="12" Opacity="1" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" Data="F1 M 6.742676,3.852539 L 9.110840,1.559570 L 8.910645,0.500000 L 6.838379,0.500000 L 4.902832,2.435547 L 2.967285,0.500000 L 0.895020,0.500000 L 0.694824,1.559570 L 3.062988,3.852539 L 0.527832,6.351563 L 0.689941,7.600586 L 2.967285,7.600586 L 4.897949,5.575195 L 6.854004,7.600586 L 9.115723,7.600586 L 9.277832,6.351563 L 6.742676,3.852539 Z">
                                                    <Path.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                                                        </TransformGroup>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <Path x:Name="X_Fuzz1" Fill="#14313431" Stretch="Fill" Height="10" HorizontalAlignment="Center" Margin="0,-1,0,0" VerticalAlignment="Center" Width="12" Opacity="1" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" Data="F1 M 6.742676,3.852539 L 9.110840,1.559570 L 8.910645,0.500000 L 6.838379,0.500000 L 4.902832,2.435547 L 2.967285,0.500000 L 0.895020,0.500000 L 0.694824,1.559570 L 3.062988,3.852539 L 0.527832,6.351563 L 0.689941,7.600586 L 2.967285,7.600586 L 4.897949,5.575195 L 6.854004,7.600586 L 9.115723,7.600586 L 9.277832,6.351563 L 6.742676,3.852539 Z">
                                                    <Path.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                                        </TransformGroup>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <Path x:Name="X_Fuzz0" Fill="#FFD2D2D2" Stretch="Fill" Height="10" HorizontalAlignment="Center" Margin="0,-1,0,0" VerticalAlignment="Center" Width="12" Opacity="1" Visibility="Collapsed" Data="F1 M 6.742676,3.852539 L 9.110840,1.559570 L 8.910645,0.500000 L 6.838379,0.500000 L 4.902832,2.435547 L 2.967285,0.500000 L 0.895020,0.500000 L 0.694824,1.559570 L 3.062988,3.852539 L 0.527832,6.351563 L 0.689941,7.600586 L 2.967285,7.600586 L 4.897949,5.575195 L 6.854004,7.600586 L 9.115723,7.600586 L 9.277832,6.351563 L 6.742676,3.852539 Z"/>
                                                <Path x:Name="X" Fill="#FFFFFFFF" Stretch="Fill" Height="10" HorizontalAlignment="Center" Margin="0,-1,0,0" VerticalAlignment="Center" Width="12" Opacity="0.7" Data="F1 M 6.742676,3.852539 L 9.110840,1.559570 L 8.910645,0.500000 L 6.838379,0.500000 L 4.902832,2.435547 L 2.967285,0.500000 L 0.895020,0.500000 L 0.694824,1.559570 L 3.062988,3.852539 L 0.527832,6.351563 L 0.689941,7.600586 L 2.967285,7.600586 L 4.897949,5.575195 L 6.854004,7.600586 L 9.115723,7.600586 L 9.277832,6.351563 L 6.742676,3.852539 Z" Stroke="#FF3B3B3B" StrokeThickness="0.8"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="WindowStates">
                                <VisualState x:Name="Open">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="0" Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <EasingDoubleKeyFrame KeyTime="00:00:00.3" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="0" Storyboard.TargetName="ContentRoot" Storyboard.TargetProperty="(RenderTransform).(Children)[0].ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.25" Value="0"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.4" Value="1"/>
                                            <SplineDoubleKeyFrame KeySpline="0,0,0.5,1" KeyTime="00:00:00.45" Value="1.05"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.55" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="0" Storyboard.TargetName="ContentRoot" Storyboard.TargetProperty="(RenderTransform).(Children)[0].ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.25" Value="0"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.4" Value="1"/>
                                            <SplineDoubleKeyFrame KeySpline="0,0,0.5,1" KeyTime="00:00:00.45" Value="1.05"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.55" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Closed">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="0" Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                                            <EasingDoubleKeyFrame KeyTime="00:00:00.3" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="0" Storyboard.TargetName="ContentRoot" Storyboard.TargetProperty="(RenderTransform).(Children)[0].ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2" Value="1"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.25" Value="1.05"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.45" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames BeginTime="0" Storyboard.TargetName="ContentRoot" Storyboard.TargetProperty="(RenderTransform).(Children)[0].ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.2" Value="1"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.25" Value="1.05"/>
                                            <SplineDoubleKeyFrame KeyTime="00:00:00.45" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="Overlay" HorizontalAlignment="Stretch" Margin="0" VerticalAlignment="Top" Opacity="{TemplateBinding OverlayOpacity}" Background="{TemplateBinding OverlayBrush}"/>
                        <Grid x:Name="ContentRoot" Height="{TemplateBinding Height}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}" Width="{TemplateBinding Width}" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Background="#FF6B6C6C" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="#FF323131">
                                <Border Margin="0" Background="#FF6B6C6C">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Border x:Name="Chrome" Width="Auto" BorderBrush="#FF5E5E5E" BorderThickness="0,0,0,1" Background="#FF9E9E9E">
                                            <Grid Height="Auto" Width="Auto" Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentControl FontWeight="Bold" IsTabStop="False" HorizontalAlignment="Stretch" Margin="6,0,6,0" VerticalAlignment="Center" Content="{TemplateBinding Title}" Foreground="Black"/>
                                                <Button x:Name="CloseButton" IsTabStop="False" Height="14" HorizontalAlignment="Center" Style="{StaticResource ButtonStyle}" VerticalAlignment="Center" Width="15" Grid.Column="1"/>
                                            </Grid>
                                        </Border>
                                        <Border Margin="7" Grid.Row="1" Background="{TemplateBinding Background}">
                                            <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>	
    
    <!--Schedule Control-->
    <Style x:Key="OfficeBlackScheduleStyle" TargetType="Syncfusion_Windows_Controls_Schedule:Schedule">         
		<Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Syncfusion_Windows_Controls_Schedule:Schedule">
                    <Grid x:Name="PART_MainGrid" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Visibility">
                                <VisualState x:Name="CalendarCollapsed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_MainGrid" Storyboard.TargetProperty="(Grid.ColumnDefinitions)[0].Width">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CalendarVisible"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>                       
                        <Border Visibility="{TemplateBinding CalendarVisibility}" Grid.Column="0">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="#FF818181" Offset="0.025"/>
                                    <GradientStop Color="#FF5B5B5B" Offset="0.973"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Syncfusion_Windows_Controls_Schedule:ScheduleCalendarViewItemsControl x:Name="PART_CalendarView" Visibility="{TemplateBinding CalendarVisibility}" CalendarItemsCount="{TemplateBinding CalendarItemsCount}" CalendarDayButtonStyle="{StaticResource Office14BlackCalendarDayButtonStyle}" CalendarStyle="{StaticResource Office14BlackCalendarStyle}"/>
                        </Border>
                        <controls:GridSplitter Grid.Column="0" Visibility="{TemplateBinding CalendarVisibility}" Style="{StaticResource Office14BlackGridSplitterStyle}"></controls:GridSplitter>
                        <Grid Grid.Column="1">
                            <Border BorderBrush="#FF849DBD" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFC5D3E3" ShadowDepth="2"/>
                                </Border.Effect>
                            </Border>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Syncfusion_Windows_Controls_Schedule:ScheduleHeaderTitleBar x:Name="PART_HeaderTitleBar" SelectedDatesConverter="{TemplateBinding TitleBarTextConverter}" Visibility="{TemplateBinding TitleBarVisibility}" Style="{StaticResource OfficeBlackScheduleHeaderTitleBarStyle}" Background="{StaticResource Office14BlackBackgroundBrush}" Foreground="{StaticResource Office14BlackForegroundBrush}" BorderBrush="{StaticResource Office14BlackBorderBrush}" FontFamily="/Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI" FontSize="16" VerticalAlignment="Center" />
                                <Syncfusion_Windows_Controls_Schedule:ContentViewItemsControl x:Name="PART_MainViewItems" Margin="2" Grid.Row="1" SelectedIndex="0">
                                    <Syncfusion_Windows_Controls_Schedule:ScheduleDaysView x:Name="PART_DaysView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AppointmentEditorStyle="{StaticResource Office14BlackScheduleAppointmentEditorControlStyle}" AppointmentScheduleWindowStyle="{StaticResource Office14BlackAppointmentScheduleWindowStyle}" />
                                    <Syncfusion_Windows_Controls_Schedule:ScheduleMonthView x:Name="PART_MonthView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AppointmentEditorStyle="{StaticResource Office14BlackScheduleAppointmentEditorControlStyle}" AppointmentScheduleWindowStyle="{StaticResource Office14BlackAppointmentScheduleWindowStyle}"/>
									<Syncfusion_Windows_Controls_Schedule:ScheduleHorizontalView x:Name="PART_HorizontalView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AppointmentEditorStyle="{StaticResource Office14BlackScheduleAppointmentEditorControlStyle}" AppointmentScheduleWindowStyle="{StaticResource Office14BlackAppointmentScheduleWindowStyle}"/>
                                </Syncfusion_Windows_Controls_Schedule:ContentViewItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
