                        <Grid x:Name="Overlay" HorizontalAlignment="Stretch" Margin="0" VerticalAlignment="Top" Opacity="{TemplateBinding OverlayOpacity}" Background="{TemplateBinding OverlayBrush}"/>
                        <Grid x:Name="ContentRoot" Height="{TemplateBinding Height}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}" Width="{TemplateBinding Width}" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Background="#FF707070" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="#FF494949">
                                <Border Margin="0" Background="#FF707070">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Border x:Name="Chrome" Width="Auto" BorderBrush="#FF494949" BorderThickness="0,0,0,1" Background="#FF5A595A">
                                            <Grid Height="Auto" Width="Auto" Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentControl FontWeight="Bold" IsTabStop="False" HorizontalAlignment="Stretch" Margin="6,0,6,0" VerticalAlignment="Center" Content="{TemplateBinding Title}" Foreground="White"/>
                                                <Button x:Name="CloseButton" IsTabStop="False" Height="14" HorizontalAlignment="Center" Style="{StaticResource ButtonStyle}" VerticalAlignment="Center" Width="15" Grid.Column="1"/>
                                            </Grid>
                                        </Border>
                                        <Border Margin="7" Grid.Row="1" Background="{TemplateBinding Background}">
                                            <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="BlendScheduleRecurrenceConfirmationWindowStyle" TargetType="Syncfusion_Windows_Controls_Schedule:ScheduleRecurrenceConfirmationWindow">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Syncfusion_Windows_Controls_Schedule:ScheduleRecurrenceConfirmationWindow">
                    <Grid x:Name="grid" Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="PART_Message" Margin="2" Text="{Binding Appointment.RecurrenceAlertMessage, Mode=TwoWay}" TextWrapping="Wrap"/>
                        <RadioButton x:Name="PART_NonRecurrence" Margin="2" VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper},Path=RecurrenceAlertWindowOpen}" Grid.Row="1" Style="{StaticResource BlendRadioButtonStyle}">
                            <RadioButton.IsChecked>
                                <Binding Path="Appointment.IsRecurrenceAppointment" Mode="TwoWay">
                                    <Binding.Converter>
                                        <Syncfusion_Windows_Controls_Schedule:ScheduleRecurrenceIsCheckedConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </RadioButton.IsChecked>
                        </RadioButton>
                        <RadioButton x:Name="PART_Recurrence" Margin="2" VerticalAlignment="Center" Content="{Binding Source={StaticResource ResourceWrapper},Path=RecurrenceAlertWindowOpenSeries}" Grid.Row="2" IsChecked="{Binding Appointment.IsRecurrenceAppointment, Mode=TwoWay}" Style="{StaticResource BlendRadioButtonStyle}"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="3" Orientation="Horizontal">
                            <Button x:Name="PART_OkButton" Margin="2" Width="60" Height="23" Content="{Binding Source={StaticResource ResourceWrapper},Path=Ok}"/>
                            <Button x:Name="PART_CancelButton" Margin="2" Width="60" Height="23" Content="{Binding Source={StaticResource ResourceWrapper},Path=Cancel}"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BlendScheduleDaysViewStyle" TargetType="Syncfusion_Windows_Controls_Schedule:ScheduleDaysView">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Syncfusion_Windows_Controls_Schedule:ScheduleDaysView">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="65"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Background="{TemplateBinding Background}" Style="{StaticResource ScheduleScrollViewStyle}" Grid.Column="1" Grid.Row="0">
                            <Syncfusion_Windows_Controls_Schedule:MaxHeightPanel>
                                <Syncfusion_Windows_Controls_Schedule:ScheduleDaysHeaderViewItemsControl x:Name="PART_DaysHeaderControl">
                                    <shared:ContextMenuAdvService.ContextMenuAdv >
                                        <shared:ContextMenuAdv Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}"  x:Name="ContextMenuDaysHeaderControl"  Style="{StaticResource ContextMenuAdvStyle}"/>
                                    </shared:ContextMenuAdvService.ContextMenuAdv>
                                </Syncfusion_Windows_Controls_Schedule:ScheduleDaysHeaderViewItemsControl>

                                <Syncfusion_Windows_Controls_Schedule:ScheduleAllDaysAppointmentItemsControl x:Name="PART_AllDaysAppointmentsLayout">
                                    <shared:ContextMenuAdvService.ContextMenuAdv>
                                        <shared:ContextMenuAdv Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}"  x:Name="ContextMenuAllDaysAppointmentsLayout" Style="{StaticResource ContextMenuAdvStyle}"/>
                                    </shared:ContextMenuAdvService.ContextMenuAdv>
                                </Syncfusion_Windows_Controls_Schedule:ScheduleAllDaysAppointmentItemsControl>
                            </Syncfusion_Windows_Controls_Schedule:MaxHeightPanel>
                        </ScrollViewer>
                        <ScrollViewer x:Name="PART_TimeSlotScrollViewer" Background="{TemplateBinding Background}" Style="{StaticResource ScheduleScrollViewStyle}" Grid.ColumnSpan="2" Grid.Row="1">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Syncfusion_Windows_Controls_Schedule:ScheduleTimeLineItemsControl x:Name="PART_TimeLineItemsControl" HorizontalAlignment="Left" VerticalAlignment="Top" Width="55" Grid.Column="0" LinesStroke="#FFA9B0B8" Background="White" BorderBrush="#FFA9B0B8" BorderThickness="0.5" TimelineHourDivisionVisibility="{TemplateBinding TimelineHourDivisionVisibility}" FontWeight="Light" FontStretch="Condensed">
                                    <shared:ContextMenuAdvService.ContextMenuAdv>
                                        <shared:ContextMenuAdv Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}"  Style="{StaticResource ContextMenuAdvStyle}" x:Name="ContextMenuTimeLineItemsControl" />
                                    </shared:ContextMenuAdvService.ContextMenuAdv>
                                </Syncfusion_Windows_Controls_Schedule:ScheduleTimeLineItemsControl>
                                <Syncfusion_Windows_Controls_Schedule:ScheduleTimeSlotItemsControl x:Name="PART_TimeSlot" VerticalAlignment="Top" Grid.Column="1" >
                                    <shared:ContextMenuAdvService.ContextMenuAdv>
                                        <shared:ContextMenuAdv Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}" Style="{StaticResource ContextMenuAdvStyle}" x:Name="ContextMenuTimeSlot" />
                                    </shared:ContextMenuAdvService.ContextMenuAdv>
                                </Syncfusion_Windows_Controls_Schedule:ScheduleTimeSlotItemsControl>
                                <Syncfusion_Windows_Controls_Schedule:ScheduleDaysAppointmentLayoutItemsControl x:Name="PART_AppointmentsLayout" Grid.Column="1">
                                    <shared:ContextMenuAdvService.ContextMenuAdv>
                                        <shared:ContextMenuAdv Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}" Style="{StaticResource ContextMenuAdvStyle}"  x:Name="ContextMenuAppointmentsLayout"/>
                                    </shared:ContextMenuAdvService.ContextMenuAdv>
                                </Syncfusion_Windows_Controls_Schedule:ScheduleDaysAppointmentLayoutItemsControl>
                                <Grid x:Name="PART_AppointmentPopup" Grid.Column="1" />
                            </Grid>
                        </ScrollViewer>
                        <Grid x:Name="CurrentDateGrid" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,17,0"/>
                        <Syncfusion_Windows_Controls_Schedule:ScheduleAppointmentNavigatorControl x:Name="PART_AppointmentNavigatorControl" Grid.Row="1" Grid.Column="1" Margin="0,0,18,0"></Syncfusion_Windows_Controls_Schedule:ScheduleAppointmentNavigatorControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BlendScheduleStyle" TargetType="Syncfusion_Windows_Controls_Schedule:Schedule">		 
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Syncfusion_Windows_Controls_Schedule:Schedule">
                    <Grid x:Name="PART_MainGrid" Background="{TemplateBinding ScheduleBackground}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Visibility">
                                <VisualState x:Name="CalendarCollapsed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_MainGrid" Storyboard.TargetProperty="(Grid.ColumnDefinitions)[0].Width">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CalendarVisible"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Visibility="{TemplateBinding CalendarVisibility}" Grid.Column="0" Background="#FFE1E5EA">
                            <Syncfusion_Windows_Controls_Schedule:ScheduleCalendarViewItemsControl x:Name="PART_CalendarView" CalendarItemsCount="{TemplateBinding CalendarItemsCount}" CalendarDayButtonStyle="{StaticResource BlendCalendarDayButtonStyle}" CalendarStyle="{StaticResource BlendCalendarStyle}"/>
                        </Border>
                        <controls:GridSplitter Grid.Column="0" Visibility="{TemplateBinding CalendarVisibility}" Style="{StaticResource BlendGridSplitterStyle}" ></controls:GridSplitter>
                        <Grid Grid.Column="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Syncfusion_Windows_Controls_Schedule:ScheduleHeaderTitleBar x:Name="PART_HeaderTitleBar" SelectedDatesConverter="{TemplateBinding TitleBarTextConverter}" Visibility="{TemplateBinding TitleBarVisibility}" Style="{StaticResource BlendScheduleHeaderTitleBarStyle}" Background="Black" Foreground="White" BorderBrush="#FF909090" FontFamily="/Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI" FontSize="16" VerticalAlignment="Center"/>
                                <Syncfusion_Windows_Controls_Schedule:ContentViewItemsControl x:Name="PART_MainViewItems" Margin="2" Grid.Row="1" SelectedIndex="0">
                                    <Syncfusion_Windows_Controls_Schedule:ScheduleDaysView Style="{StaticResource BlendScheduleDaysViewStyle}" x:Name="PART_DaysView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AppointmentEditorStyle="{StaticResource BlendScheduleAppointmentEditorControlStyle}" AppointmentScheduleWindowStyle="{StaticResource BlendAppointmentScheduleWindowStyle}" RecurrenceAlertWindowStyle="{StaticResource BlendScheduleRecurrenceConfirmationWindowStyle}" />
                                    <Syncfusion_Windows_Controls_Schedule:ScheduleMonthView x:Name="PART_MonthView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AppointmentEditorStyle="{StaticResource BlendScheduleAppointmentEditorControlStyle}" AppointmentScheduleWindowStyle="{StaticResource BlendAppointmentScheduleWindowStyle}" RecurrenceAlertWindowStyle="{StaticResource BlendScheduleRecurrenceConfirmationWindowStyle}" />
                                    <Syncfusion_Windows_Controls_Schedule:ScheduleHorizontalView x:Name="PART_HorizontalView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AppointmentEditorStyle="{StaticResource BlendScheduleAppointmentEditorControlStyle}" AppointmentScheduleWindowStyle="{StaticResource BlendAppointmentScheduleWindowStyle}" RecurrenceAlertWindowStyle="{StaticResource BlendScheduleRecurrenceConfirmationWindowStyle}" />
                                </Syncfusion_Windows_Controls_Schedule:ContentViewItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
 

</ResourceDictionary>
