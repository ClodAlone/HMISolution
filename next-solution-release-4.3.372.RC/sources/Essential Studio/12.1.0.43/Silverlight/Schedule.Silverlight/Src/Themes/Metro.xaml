                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Rectangle x:Name="outerBorder" Fill="{TemplateBinding Background}" Height="14" Margin="1" RadiusY="0" RadiusX="0" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}" Width="14"/>
                            <Path x:Name="CheckIcon" Data="M4279.875,659 L4283,662.5 L4289.625,653.25" Stroke="{StaticResource CheckBoxFill}" StrokeThickness="1.5" FlowDirection="LeftToRight" Height="10" Margin="0" Opacity="1" Stretch="Fill" Width="10.5"/>
