                        <ScrollViewer x:Name="PART_TimeSlotScrollViewer" Background="{TemplateBinding Background}" Style="{StaticResource MetroScrollViewerStyle}" Grid.ColumnSpan="2" Grid.Row="1">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Syncfusion_Windows_Controls_Schedule:ScheduleTimeLineItemsControl x:Name="PART_TimeLineItemsControl" HorizontalAlignment="Left" VerticalAlignment="Top" Width="55" Grid.Column="0" LinesStroke="#FFA9B0B8" Background="White" BorderBrush="#FFA9B0B8" BorderThickness="0,0,0.5,0" TimelineHourDivisionVisibility="{TemplateBinding TimelineHourDivisionVisibility}" FontWeight="Light" FontStretch="Condensed">
                                    <shared:ContextMenuAdvService.ContextMenuAdv>
                                        <shared:ContextMenuAdv Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}"  Style="{StaticResource ContextMenuAdvStyle}" x:Name="ContextMenuTimeLineItemsControl" />
                                    </shared:ContextMenuAdvService.ContextMenuAdv>
                                </Syncfusion_Windows_Controls_Schedule:ScheduleTimeLineItemsControl>
                                <Syncfusion_Windows_Controls_Schedule:ScheduleTimeSlotItemsControl x:Name="PART_TimeSlot" VerticalAlignment="Top" Grid.Column="1" >
                                    <shared:ContextMenuAdvService.ContextMenuAdv>
                                        <shared:ContextMenuAdv Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}" Style="{StaticResource ContextMenuAdvStyle}" x:Name="ContextMenuTimeSlot" />
                                    </shared:ContextMenuAdvService.ContextMenuAdv>
                                </Syncfusion_Windows_Controls_Schedule:ScheduleTimeSlotItemsControl>
                                <Syncfusion_Windows_Controls_Schedule:ScheduleDaysAppointmentLayoutItemsControl x:Name="PART_AppointmentsLayout" Grid.Column="1">
                                    <shared:ContextMenuAdvService.ContextMenuAdv>
                                        <shared:ContextMenuAdv Visibility="{Binding Model.ShowContextMenu, Converter={StaticResource BoolToVisibleConverter}}" Style="{StaticResource ContextMenuAdvStyle}"  x:Name="ContextMenuAppointmentsLayout"/>
                                    </shared:ContextMenuAdvService.ContextMenuAdv>
                                </Syncfusion_Windows_Controls_Schedule:ScheduleDaysAppointmentLayoutItemsControl>
                                <Grid x:Name="PART_AppointmentPopup" Grid.Column="1" />
                            </Grid>
                        </ScrollViewer>
                        <Grid x:Name="CurrentDateGrid" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,17,0"/>
                        <Syncfusion_Windows_Controls_Schedule:ScheduleAppointmentNavigatorControl x:Name="PART_AppointmentNavigatorControl" Grid.Row="1" Grid.Column="1" Margin="0,0,18,0"></Syncfusion_Windows_Controls_Schedule:ScheduleAppointmentNavigatorControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MetroScheduleHeaderTitleBarStyle" TargetType="Syncfusion_Windows_Controls_Schedule:ScheduleHeaderTitleBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Syncfusion_Windows_Controls_Schedule:ScheduleHeaderTitleBar">
                    <Grid Visibility="{TemplateBinding Visibility}" Margin="10,0,0,0" Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PART_DateText" Margin="5,2,0,0" FontSize="20" FontWeight="ExtraLight" VerticalAlignment="Center" Grid.Column="2" Text="{TemplateBinding Text}"/>
                        <Button x:Name="PART_NextButton" Height="40" Style="{StaticResource NextNavigationButtonStyle}" Width="40" Grid.Column="1"/>
                        <Button x:Name="PART_PrevButton" Height="40" Style="{StaticResource PrevNavigationButtonStyle}" Width="40" Grid.Column="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MetroScheduleStyle" TargetType="Syncfusion_Windows_Controls_Schedule:Schedule">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Syncfusion_Windows_Controls_Schedule:Schedule">
                    <Grid x:Name="PART_MainGrid" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Visibility">
                                <VisualState x:Name="CalendarCollapsed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="PART_MainGrid" Storyboard.TargetProperty="(Grid.ColumnDefinitions)[0].Width">
                                            <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CalendarVisible"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Visibility="{TemplateBinding CalendarVisibility}" Grid.Column="0" Background="{StaticResource MetroScheduleCalendarViewBackground}">
                            <Syncfusion_Windows_Controls_Schedule:ScheduleCalendarViewItemsControl x:Name="PART_CalendarView" Visibility="{TemplateBinding CalendarVisibility}" CalendarItemsCount="{TemplateBinding CalendarItemsCount}" CalendarDayButtonStyle="{StaticResource MetroCalendarDayButtonStyle}" CalendarStyle="{StaticResource MetroCalendarStyle}"/>
                        </Border>
                        <controls:GridSplitter Grid.Column="0" Margin="2,0,0,0" Visibility="{TemplateBinding CalendarVisibility}" Style="{StaticResource MetroGridSplitterStyle}" ></controls:GridSplitter>
                        <Grid Grid.Column="1">                          
                            <Border BorderBrush="{StaticResource MetroScheduleBorderBrush}" BorderThickness="1" Background="{StaticResource MetroScheduleBackground}"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Syncfusion_Windows_Controls_Schedule:ScheduleHeaderTitleBar x:Name="PART_HeaderTitleBar" SelectedDatesConverter="{TemplateBinding TitleBarTextConverter}" Visibility="{TemplateBinding TitleBarVisibility}" Style="{StaticResource MetroScheduleHeaderTitleBarStyle}" Foreground="{StaticResource MetroScheduleForeground}" FontFamily="/Syncfusion.Schedule.Silverlight;component/Fonts/segoeui.ttf#Segoe UI" FontSize="16" VerticalAlignment="Center" />
                                <Syncfusion_Windows_Controls_Schedule:ContentViewItemsControl x:Name="PART_MainViewItems" Margin="2" Grid.Row="1" SelectedIndex="0">
                                    <Syncfusion_Windows_Controls_Schedule:ScheduleDaysView x:Name="PART_DaysView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Style="{StaticResource MetroScheduleDaysViewStyle}" AppointmentEditorStyle="{StaticResource MetroScheduleAppointmentEditorControlStyle}" AppointmentScheduleWindowStyle="{StaticResource MetroAppointmentScheduleWindowStyle}" />
                                    <Syncfusion_Windows_Controls_Schedule:ScheduleMonthView x:Name="PART_MonthView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AppointmentEditorStyle="{StaticResource MetroScheduleAppointmentEditorControlStyle}" AppointmentScheduleWindowStyle="{StaticResource MetroAppointmentScheduleWindowStyle}"/>
                                    <Syncfusion_Windows_Controls_Schedule:ScheduleHorizontalView x:Name="PART_HorizontalView" Margin="1" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AppointmentEditorStyle="{StaticResource MetroScheduleAppointmentEditorControlStyle}" AppointmentScheduleWindowStyle="{StaticResource MetroAppointmentScheduleWindowStyle}"/>
                                </Syncfusion_Windows_Controls_Schedule:ContentViewItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



</ResourceDictionary>
