<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight">
<local:SizeToDoubleConverter x:Key="SizeToDoubleConverterKey"/>
    <SolidColorBrush x:Key="ColorGroupItemBorderBrushKey" Color="#FFA0BCE4"/>
    <SolidColorBrush x:Key="ColorGroupItemMouseOverBrushKey" Color="Orange"/>
    <SolidColorBrush x:Key="ColorGroupItemSelectedBrushKey" Color="#FF1D1F47"/>

    <SolidColorBrush x:Key="TextBrushKey" Color="#FF01156D"/>

    <SolidColorBrush x:Key="GlyphBrushKey" Color="#FF15428B"/>
    <LinearGradientBrush  x:Key="UpDownborderbrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFCDDEF6" Offset="0"/>
        <GradientStop Color="#FFCDDDF5" Offset="0.964"/>
        <GradientStop Color="#FFD6E4F8" Offset="1"/>
    </LinearGradientBrush>    

    <SolidColorBrush x:Key="ColorPickerPalettePopupBorderBrushKey" Color="#FFA0BCE4"/>

    <SolidColorBrush x:Key="ColorPickerPaletteBorderBrushKey" Color="#FFA0BCE4"/>

    <SolidColorBrush x:Key="ColorPickerPaletteBackgroundBrushKey" Color="#AAEAF2FB"/>

    <SolidColorBrush x:Key="PopupBackgroundBrushKey" Color="#FFFAFAFA"/>   

    <SolidColorBrush x:Key="ColorPickerPaletteAutoBoderBrushKey" Color="#FFD8ECFE"/>
    <SolidColorBrush x:Key="ColorPickerPaletteAutoBoder1BrushKey" Color="#FFD8ECFE"/>

    <SolidColorBrush x:Key="ColorPickerPaletteAutoBackgroundBrushKey" Color="#FFFFE7A2"/>  
   
    <SolidColorBrush x:Key="ColorPickerPaletteAutoBoderMouseOverBrushKey" Color="Orange"/>

    <SolidColorBrush x:Key="ColorPickerPaletteAutoBoder1MouseOverBrushKey" Color="#FFFFFFE6"/>

    <LinearGradientBrush x:Key="ColorPickerPaletteAutomaticColorMouseOverBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFD1C8B0" Offset="0"/>
        <GradientStop Color="#FFFDF2C9" Offset="0.005"/>
        <GradientStop Color="#FFFAE8B4" Offset="0.408"/>
        <GradientStop Color="#FFFED562" Offset="0.412"/>
        <GradientStop Color="#FFFED562" Offset="0.444"/>
        <GradientStop Color="#FFFFD14E" Offset="0.449"/>
        <GradientStop Color="#FFFFDB7D" Offset="0.968"/>
    </LinearGradientBrush>       

    <SolidColorBrush x:Key="ColorPickerPaletteAutoBoderSelectedBrushKey" Color="Orange"/>

    <SolidColorBrush x:Key="ColorPickerPaletteAutoBoder1SelectedBrushKey" Color="#FFFFFFE6"/>

    <LinearGradientBrush x:Key="ColorPickerPaletteMoreColorMouseOverBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFD1C8B0" Offset="0"/>
        <GradientStop Color="#FFFDF2C9" Offset="0.005"/>
        <GradientStop Color="#FFFAE8B4" Offset="0.408"/>
        <GradientStop Color="#FFFED562" Offset="0.412"/>
        <GradientStop Color="#FFFED562" Offset="0.444"/>
        <GradientStop Color="#FFFFD14E" Offset="0.449"/>
        <GradientStop Color="#FFFFDB7D" Offset="0.968"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ColorPickerPaletteMoreColorMouseOverBorderBrushKey" Color="#FFD1C8B0"/>

    <LinearGradientBrush x:Key="ColorPickerPaletteMouseOverBrushKey"  EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFDF2CA" Offset="0"/>
        <GradientStop Color="#FFFAE8B2" Offset="0.4"/>
        <GradientStop Color="#FFFFD049" Offset="0.4"/>
        <GradientStop Color="#FFFFDC81" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ColorPickerUpDownMouseOverBrushKey"  EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFFDF2CA" Offset="0"/>
        <GradientStop Color="#FFFAE8B2" Offset="0.4"/>
        <GradientStop Color="#FFFFD049" Offset="0.4"/>
        <GradientStop Color="#FFFFDC81" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ThemeHeaderBackGroundBrushKey" Color="#FFDEE6EF"/>

    <SolidColorBrush x:Key="ColorPickerUpDownMouseOverBorderBrushKey" Color="#FFB79E73"/>

    <SolidColorBrush x:Key="ColorPickerPaletteMouseOverBorderBrushKey" Color="#FFB79E73"/>

    <!-- Styles -->

    <Style x:Key="local:ColorGroupItem"  TargetType="local:ColorGroupItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ColorGroupItem">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 1, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorGroupItemMouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>

                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 1, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorGroupItemSelectedBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>

                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Normal">
                                    <Storyboard>


                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                        </VisualStateManager.VisualStateGroups>
                        <Border>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="ItemBorder" BorderThickness="{TemplateBinding BorderThick}" BorderBrush="{StaticResource ColorGroupItemBorderBrushKey}" Background="{TemplateBinding Color}" Width="{TemplateBinding BorderWidth}" Height="{TemplateBinding BorderHeight}" HorizontalAlignment="Left" Margin="{TemplateBinding BorderMargin}"  Grid.Row="0" >
                                    <ToolTipService.ToolTip >
                                        <TextBlock Text="{TemplateBinding ColorName}"></TextBlock>
                                    </ToolTipService.ToolTip>
                                </Border>

                                <ItemsControl  x:Name="Ic1" Grid.Row="1" Margin="{TemplateBinding ItemMargin}"   HorizontalAlignment="Left"></ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ColorGroupItem" BasedOn="{StaticResource local:ColorGroupItem}"/>

    <Style x:Key="local:ColorGroup" TargetType="local:ColorGroup">
        <Setter Property="Template" >
            <Setter.Value>
                <ControlTemplate TargetType="local:ColorGroup">
                    <Grid Visibility="{TemplateBinding PanelVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />

                            <RowDefinition  Height="*"/>

                        </Grid.RowDefinitions>


                        <Rectangle Grid.Row="0"  HorizontalAlignment="Stretch" Visibility="{TemplateBinding HeaderVisibility}" Fill="{TemplateBinding ThemeHeaderBackGround}" Margin="2,0,2,0">
                        </Rectangle>
                        <TextBlock Text="{TemplateBinding HeaderName}" Visibility="{TemplateBinding HeaderVisibility}" Grid.Row="0" VerticalAlignment="Center" FontWeight="bold" Margin="3,0,2,0"  Foreground="{TemplateBinding ThemeHeaderForeGround}" HorizontalAlignment="Left"  FontSize="11"/>

                        <ItemsControl  x:Name="Ic"  Grid.Row="1" ItemsSource="{TemplateBinding DataSource}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel  Orientation="Horizontal" ></StackPanel>

                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ColorGroup" BasedOn="{StaticResource local:ColorGroup}"/>

    <Style x:Key="local:PolygonItem" TargetType="local:PolygonItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PolygonItem">
                    <Grid>

                        <Grid>

                            <Polygon x:Name="polygon" Fill="{TemplateBinding color}" Stroke="{StaticResource GlyphBrushKey}"  StrokeThickness="0" Points="{TemplateBinding Points}">
                                <ToolTipService.ToolTip >
                                    <TextBlock Text="{TemplateBinding ColorName}"></TextBlock>
                                </ToolTipService.ToolTip>
                            </Polygon>

                        </Grid>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:PolygonItem" BasedOn="{StaticResource local:PolygonItem}"/>

    <Style x:Key="Office2007BlueColorPickerPaletteStyle" TargetType="local:ColorPickerPalette" >
        <Setter Property="Background" Value="{StaticResource ColorPickerPaletteBackgroundBrushKey}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorPickerPaletteBorderBrushKey}"/>
        <Setter Property="ThemeHeaderBackGround" Value="{StaticResource ThemeHeaderBackGroundBrushKey}"/>
        <Setter Property="ThemeHeaderForeGround" Value="{StaticResource TextBrushKey}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ColorPickerPalette"   >
                    <Grid Background="{TemplateBinding Background}" >
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="MouseOverAutomatic">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AutoBorder1" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteAutoBoderMouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AutoBorder2" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteAutoBoder1MouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Automatic1" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteAutomaticColorMouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames> 
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Automatic1" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteMoreColorMouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Automatic1_Expanded" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteAutomaticColorMouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Automatic1_Expanded" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteMoreColorMouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AutoBorder1" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Automatic1" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteAutomaticColorMouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>                                     
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Automatic1" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteMoreColorMouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Automatic1_Expanded" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteAutomaticColorMouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Automatic1_Expanded" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteMoreColorMouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AutoBorder1" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteAutoBoderSelectedBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AutoBorder2" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteAutoBoder1SelectedBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AutoBorder1" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteAutoBoderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AutoBorder2" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteAutoBoderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="MoreBorders">
                                <VisualState x:Name="MouseOverBorder">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MoreColors1" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteMoreColorMouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MoreColors1" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteMoreColorMouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="NormalBorder">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MoreColors1" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MoreColors1" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="UpDownStates">
                                <VisualState x:Name="UpDown">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ColorPickerBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteMouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ColorBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteMouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OutBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteMouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UpDownBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerUpDownMouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UpDownBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerUpDownMouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ColorMouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ColorBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteMouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ColorPickerBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteMouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OutBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteMouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UpDownBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerUpDownMouseOverBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UpDownBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerUpDownMouseOverBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="UpDownNormal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OutBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteBackgroundBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OutBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteBorderBrushKey}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UpDownBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource UpDownborderbrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border Visibility="Collapsed" Width="Auto" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" x:Name="b_Expanded" Background="{StaticResource PopupBackgroundBrushKey}" >
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <Border x:Name="Automatic1_Expanded" BorderThickness="1" Margin="2,2,2,2" Grid.Row="0" Visibility="{TemplateBinding AutomaticColorVisibility}" Background="Transparent">                                       
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AutoBorder1_Expanded" Grid.Column="0" BorderBrush="{StaticResource ColorPickerPaletteAutoBoderBrushKey}" CornerRadius="2" BorderThickness="1">
                                                <Border x:Name="AutoBorder2_Expanded" Background="{StaticResource ColorPickerPaletteAutoBackgroundBrushKey}"  BorderBrush="{StaticResource ColorPickerPaletteAutoBoder1BrushKey}" Grid.Column="0" BorderThickness="1">
                                                    <Border x:Name="aborder_Expanded" Grid.Column="0" Height="{TemplateBinding BorderHeight}" Width="{TemplateBinding BorderWidth}"  Background="{TemplateBinding AutomaticColor}"  />
                                                </Border>
                                            </Border>
                                            <TextBlock Text="Automatic" Padding="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11"></TextBlock>
                                        </Grid>
                                    </Border>

                                    <ItemsControl x:Name="ColorArea_Expanded" Grid.Row="1" Margin="2">
                                        <local:ColorGroup x:Name="item1_Expanded" HeaderName="Theme Colors" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                        <local:ColorGroup x:Name="item2_Expanded" HeaderName="Standard Colors" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                        <local:ColorGroup x:Name="item3_Expanded" HeaderName="Recently Used" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                    </ItemsControl>
                                    <Border BorderBrush="#FFDDE7EE" BorderThickness=".5" Margin="2,0,2,0" Grid.Row="2"></Border>
                                    <Border Grid.Row="3" Visibility="{TemplateBinding MoreColorOptionVisibility}" Margin="2">
                                        <Button Content="More Colors..." Background="Transparent" x:Name="MoreColors1_Expanded" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">                                           
                                            <Button.Style>
                                                <Style TargetType="Button">                                                 
                                                    <Setter Property="Padding" Value="3"/>
                                                    <Setter Property="BorderThickness" Value="1"/>                                                    
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Grid>
                                                                    <VisualStateManager.VisualStateGroups>
                                                                        <VisualStateGroup x:Name="CommonStates">
                                                                            <VisualState x:Name="Normal"/>
                                                                            <VisualState x:Name="MouseOver">
                                                                                <Storyboard>
                                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteMoreColorMouseOverBorderBrushKey}"/>
                                                                                    </ObjectAnimationUsingKeyFrames>
                                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="Background">
                                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ColorPickerPaletteMoreColorMouseOverBrushKey}"/>
                                                                                    </ObjectAnimationUsingKeyFrames>                                                                                   
                                                                                </Storyboard>
                                                                            </VisualState>                                                                      
                                                                        </VisualStateGroup>                                                                       
                                                                    </VisualStateManager.VisualStateGroups>
                                                                    <Border x:Name="Background" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}">                                                                       
                                                                    </Border>
                                                                    <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>                                                                    
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                        <Border x:Name="ColorPaletteBorder">
                            <Grid x:Name="lay"  >
                                <Grid.Resources>
                                    <ItemsPanelTemplate x:Key="ItemPanelTemplate" >
                                        <StackPanel  Orientation="Horizontal" ></StackPanel>
                                    </ItemsPanelTemplate>
                                    <ItemsPanelTemplate x:Key="ItemPanelTemplate2" >
                                        <StackPanel  Orientation="Vertical" ></StackPanel>
                                    </ItemsPanelTemplate>
                                </Grid.Resources>
                                <Border x:Name="ColorPickerBorder" BorderBrush="{TemplateBinding BorderBrush}"   BorderThickness="{TemplateBinding BorderThickness}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="OutBorder" BorderBrush="{TemplateBinding BorderBrush}"  BorderThickness="{TemplateBinding BorderThickness}" Grid.ColumnSpan="2">
                                            <Border.Background>
                                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                    <GradientStop Color="#FFD3E1F0" Offset="0.251"/>
                                                    <GradientStop Color="#FFBED5F4" Offset="0.757"/>
                                                    <GradientStop Color="#FFC0D4ED" Offset="0.484"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="ColorBorder" BorderBrush="Transparent"  Grid.Column="0">
                                            <!--<Border Name="color_border" Margin="4"></Border>-->
                                            <Border.Background>
                                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                    <GradientStop Color="#FFCDDEF6" Offset="0"/>
                                                    <GradientStop Color="#FFCDDDF5" Offset="0.964"/>
                                                    <GradientStop Color="#FFD6E4F8" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Image Source="{TemplateBinding Icon}"  Width="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=width, RelativeSource={RelativeSource TemplatedParent}}"
                                                        Height="{Binding Path=IconSize, Converter={StaticResource SizeToDoubleConverterKey}, ConverterParameter=height, RelativeSource={RelativeSource TemplatedParent}}" x:Name="image" />
                                                <Border Name="color_border" Grid.Row="1" ></Border>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="UpDownBorder" BorderBrush="Transparent" BorderThickness="1,0,0,0" Grid.Column="1">
                                            <TextBlock Text="6" x:Name="Txt"   FontFamily="Webdings" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
                                            <Border.Background>
                                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                    <GradientStop Color="#FFCDDEF6" Offset="0"/>
                                                    <GradientStop Color="#FFCDDDF5" Offset="0.964"/>
                                                    <GradientStop Color="#FFD6E4F8" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                
                                <Popup x:Name="pop">
                                    <Border BorderThickness="1" Background="{StaticResource PopupBackgroundBrushKey}" BorderBrush="{StaticResource ColorPickerPalettePopupBorderBrushKey}" x:Name="b">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border x:Name="Automatic1" Background="Transparent" Margin="2,2,2,2"  Grid.Row="0" Visibility="{TemplateBinding AutomaticColorVisibility}"  BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="AutoBorder1" Grid.Column="0" BorderBrush="{StaticResource ColorPickerPaletteAutoBoderBrushKey}" CornerRadius="2" BorderThickness="1">
                                                        <Border x:Name="AutoBorder2" Background="{StaticResource ColorPickerPaletteAutoBackgroundBrushKey}"  BorderBrush="{StaticResource ColorPickerPaletteAutoBoder1BrushKey}" Grid.Column="0" BorderThickness="1">
                                                            <Border x:Name="aborder" Grid.Column="0" Height="{TemplateBinding BorderHeight}" Width="{TemplateBinding BorderWidth}"  Background="{TemplateBinding AutomaticColor}"  />
                                                        </Border>
                                                    </Border>
                                                    <TextBlock Text="Automatic" Padding="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11"></TextBlock>
                                                </Grid>
                                            </Border>
                                            <ItemsControl x:Name="ColorArea" Grid.Row="1" Margin="2">
                                                <local:ColorGroup x:Name="item1" HeaderName="Theme Colors" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                                <local:ColorGroup x:Name="item2" HeaderName="Standard Colors" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                                <local:ColorGroup x:Name="item3" HeaderName="Recently Used" ThemeHeaderBackGround="{TemplateBinding ThemeHeaderBackGround}" ThemeHeaderForeGround="{TemplateBinding ThemeHeaderForeGround}" ></local:ColorGroup>
                                            </ItemsControl>
                                            <Border BorderBrush="#FFDDE7EE" BorderThickness=".5" Margin="2,0,2,0" Grid.Row="2"></Border>
                                            <Border Grid.Row="3" Background="Transparent" BorderThickness="1" Visibility="{TemplateBinding MoreColorOptionVisibility}" Margin="2,2,2,2" Height="{Binding ElementName=Automatic1, Path=Height , Mode=OneWay}"  x:Name="MoreColors1">
                                                <Grid>
                                                    <TextBlock Text="More Colors..."   Padding="2" VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="11"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ColorPickerPalette" BasedOn="{StaticResource Office2007BlueColorPickerPaletteStyle}"/>

</ResourceDictionary>
