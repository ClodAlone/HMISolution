                                <ToolTip x:Name="ValidationToolTip" Style="{StaticResource Office2007BlueToolTipStyle}" DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="True" Template="{StaticResource CommonValidationToolTipTemplate}" Placement="Right" PlacementTarget="{Binding ElementName=Header}"/>
