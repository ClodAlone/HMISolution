                                                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  />
                                        </StackPanel>
                                        <Border BorderBrush="DarkGray" BorderThickness="1" Margin="40,0,0,0" HorizontalAlignment="Stretch" 
                        Height="1" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <Grid Grid.Row="3">
                                        <StackPanel Orientation="Horizontal">
                                            <Canvas Width="35"/>
                                            <Border Background="DarkGray" BorderThickness="1" VerticalAlignment="Stretch" Width="3"/>
                                            <TextBlock x:Name="PART_Last" Text="Move to last" Margin="10"
                                                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  />
                                        </StackPanel>
                                        <Border BorderBrush="DarkGray" BorderThickness="1" Margin="40,0,0,0" HorizontalAlignment="Stretch" 
                        Height="1" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <Grid Grid.Row="4">
                                        <StackPanel  Orientation="Horizontal">
                                            <Canvas Width="35"/>
                                            <Border Background="DarkGray" BorderThickness="1" VerticalAlignment="Stretch" Width="3"/>
                                            <TextBlock x:Name="PART_Delete" Text="Delete" Margin="10"
                                                       VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

