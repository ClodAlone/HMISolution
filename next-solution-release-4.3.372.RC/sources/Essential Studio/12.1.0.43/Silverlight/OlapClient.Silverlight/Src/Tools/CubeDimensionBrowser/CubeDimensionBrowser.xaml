                                            </Path>

                                            <Path x:Name="CheckedVisual" Opacity="0"  Fill="{StaticResource TreeViewExpanderBrushKey}"  Width="8" Height="8" Stretch="Fill" Data="F1 M 359.979,240.986L 344.021,225.667L 344.021,255.667L 359.979,240.986 Z" RenderTransformOrigin="0.5,0.5">

                                                <Path.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform/>
                                                        <SkewTransform/>
