<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:slv="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls"  
    xmlns:syncChart="clr-namespace:Syncfusion.Silverlight.Chart.Olap;assembly=Syncfusion.OlapChart.Silverlight"
    xmlns:syncGrid="clr-namespace:Syncfusion.Silverlight.Grid.Olap;assembly=Syncfusion.OlapGrid.Silverlight" 
    xmlns:sync="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"
    xmlns:olapPager="clr-namespace:Syncfusion.Silverlight.Shared.Olap;assembly=Syncfusion.OlapShared.Silverlight"
    xmlns:theme="clr-namespace:Syncfusion.Windows.Controls.Theming;assembly=Syncfusion.Shared.Silverlight"
    xmlns:local="clr-namespace:Syncfusion.Silverlight.Client.Olap"
    xmlns:resource="clr-namespace:Syncfusion.Silverlight.Client.Olap.Resources"
    xmlns:Tools="clr-namespace:Syncfusion.Silverlight.Tools.Olap">

    <ResourceDictionary.MergedDictionaries>
        <!--<ResourceDictionary Source="/Syncfusion.OlapClient.Silverlight;component/Common/ToolsImageDictionary.xaml"/>-->
        <!--<ResourceDictionary Source="/Syncfusion.Theming.Default;component/TabControlAdv.xaml"/>-->
    </ResourceDictionary.MergedDictionaries>
    <local:GridLayoutConverter x:Key="GridLayoutConverter"/>
    <local:ChartTypeConverter x:Key="ChartTypeConverter"/>
    <local:ChartPaletteConverter x:Key="PaletteConverter"/>
    <DataTemplate x:Key="Connect_Server">
        <Image Height="28" Width="28" Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/Connect.png"/>
    </DataTemplate>

    <DataTemplate x:Key="New_Report">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/New_Report.png"/>
    </DataTemplate>

    <DataTemplate x:Key="Load_Report">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/Load_Report.png"/>
    </DataTemplate>

    <DataTemplate x:Key="Save_Report">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/Save_Report.png"/>
    </DataTemplate>

    <DataTemplate x:Key="SaveAs_Report">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/SaveAs_Report.png"/>
    </DataTemplate>

    <DataTemplate x:Key="Add_Report">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/Add_Report.png"/>
    </DataTemplate>

    <DataTemplate x:Key="Remove_Report">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/Remove_Report.png"/>
    </DataTemplate>

    <DataTemplate x:Key="Rename_Report">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/Rename_Report.png"/>
    </DataTemplate>

    <DataTemplate x:Key="ShowExpander">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/ShowExpander.png"/>
    </DataTemplate>

    <DataTemplate x:Key="AutoExecute">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/AutoExecute.png"/>
    </DataTemplate>

    <DataTemplate x:Key="TogglePivot">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/TogglePivot.png"/>
    </DataTemplate>

    <DataTemplate x:Key="GridStyleDialog">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/GridStyleDialog.png"/>
    </DataTemplate>

    <DataTemplate x:Key="FreezeGridHeader">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/FreezeGridHeader.png"/>
    </DataTemplate>

    <DataTemplate x:Key="GridCellToolTip">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/GridCellToolTip.png"/>
    </DataTemplate>

    <DataTemplate x:Key="GridToWord">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/GridToWord.png"/>
    </DataTemplate>

    <DataTemplate x:Key="GridToExl">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/GridToExl.png"/>
    </DataTemplate>

    <DataTemplate x:Key="GridToPdf">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/GridToPdf.png"/>
    </DataTemplate>

    <DataTemplate x:Key="ChartToolTip">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/ChartToolTip.png"/>
    </DataTemplate>

    <DataTemplate x:Key="ShowChartLegend">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/ShowChartLegend.png"/>
    </DataTemplate>

    <DataTemplate x:Key="NormalScreen">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/NormalScreen.png"/>
    </DataTemplate>

    <DataTemplate x:Key="FullScreen">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/FullScreen.png"/>
    </DataTemplate>

    <DataTemplate x:Key="EnablePaging">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/EnablePaging.png"/>
    </DataTemplate>

    <DataTemplate x:Key="ShowMdx">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/Show_Mdx.png"/>
    </DataTemplate>

    <DataTemplate x:Key="CalcMember">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/CalcMember.png"/>
    </DataTemplate>
    <DataTemplate x:Key="virtualKpi">
        <Image Source="/Syncfusion.OlapClient.Silverlight;component/Images/ToolBarImages/VirtualKPI.png"/>
    </DataTemplate>


    <Style TargetType="local:OlapClient">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OlapClient">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="{TemplateBinding CornerRadius}" x:Name="PART_Border">
                        <Border.Resources>
                            <resource:ResourceWrapper x:Key="resourceWrapper"/>
                        </Border.Resources>
                        <Grid>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="PART_ToolBarSpace" Height="Auto" MaxHeight="47"/>
                                    <RowDefinition x:Name="ClientSpace" Height="*"/>
                                </Grid.RowDefinitions>
                                <Tools:OlapToolBar Grid.Row="0" x:Name="PART_clientToolBar" Height="47" Margin="0,-0.7,0.3,12" 
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                    <Tools:OlapToolBarButton ToolTip="{Binding NewSessionToolTip,Source={StaticResource resourceWrapper}}" Width="38" Height="38" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                                 x:Name="PART_Server" ContentTemplate="{StaticResource Connect_Server}"/>
                                    <Tools:OlapToolBarButton ToolTip="{Binding NewReportToolTip,Source={StaticResource resourceWrapper}}" Width="38" Height="38" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                                 x:Name="PART_New" ContentTemplate="{StaticResource New_Report}"/>
                                    <Tools:OlapToolBarButton ToolTip="{Binding LoadReportToolTip,Source={StaticResource resourceWrapper}}" x:Name="PART_Lod" Width="38" Height="38" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                                 ContentTemplate="{StaticResource Load_Report}"/>
                                    <Tools:OlapToolBarButton ToolTip="{Binding SaveReportToolTip,Source={StaticResource resourceWrapper}}" Width="38" Height="38" x:Name="PART_Sav" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                                 ContentTemplate="{StaticResource Save_Report}"/>
                                    <Tools:OlapToolBarButton ToolTip="{Binding AddReportToolTip,Source={StaticResource resourceWrapper}}" Width="38" Height="38" x:Name="PART_Add" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                                 ContentTemplate="{StaticResource Add_Report}"/>
                                    <Tools:OlapToolBarButton ToolTip="{Binding RemoveReportToolTip,Source={StaticResource resourceWrapper}}" Width="38" Height="38" x:Name="PART_Rmv" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                                 ContentTemplate="{StaticResource Remove_Report}"/>
                                    <Tools:OlapToolBarButton ToolTip="{Binding RenameReportToolTip,Source={StaticResource resourceWrapper}}" Width="38" Height="38" x:Name="PART_Rnm" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                                 ContentTemplate="{StaticResource Rename_Report}"/>
                                    <Tools:OlapToolBarButton x:Name="PART_TogglePivot" ToolTip="{Binding TogglePivotToolTip,Source={StaticResource resourceWrapper}}" IsToggle="True" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                     Width="38" Height="38" ContentTemplate="{StaticResource TogglePivot}"/>
                                    <Tools:OlapToolBarButton x:Name="PART_ShowExpander" ToolTip="{Binding ShowExpanderToolTip,Source={StaticResource resourceWrapper}}" Width="38" Height="38" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                ContentTemplate="{StaticResource ShowExpander}" IsToggle="True" IsChecked="True"/>
                                    <Tools:OlapToolBarButton x:Name="PART_AutoExecute" ToolTip="{Binding AutoExecuteToolTip,Source={StaticResource resourceWrapper}}" Width="38" Height="38" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                ContentTemplate="{StaticResource AutoExecute}" IsToggle="False" Visibility="Collapsed"/>
                                    <Tools:OlapToolBarButton x:Name="PART_EnablePaging" ToolTip="{Binding EnablePagingToolTip,Source={StaticResource resourceWrapper}}" Width="38" Height="38" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                ContentTemplate="{StaticResource EnablePaging}" IsToggle="True" Visibility="Visible"/>
                                    <ComboBox x:Name="PART_ReportList" Height="23" Width="100" ToolTipService.ToolTip="{Binding ReportListToolTip,Source={StaticResource resourceWrapper}}"
                                                                 DisplayMemberPath="Name"/>
                                    <Tools:OlapToolBarButton x:Name="PART_ShowMdx" ToolTip="{Binding ShowMdxToolTip,Source={StaticResource resourceWrapper}}" Width="38" Height="38" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                ContentTemplate="{StaticResource ShowMdx}" IsToggle="False" Visibility="Visible"/>
                                    <Tools:OlapToolBarButton x:Name="PART_CreateCalcMeasure" ToolTip="{Binding CalcMeasureToolTip,Source={StaticResource resourceWrapper}}" Width="38" Height="38" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                ContentTemplate="{StaticResource CalcMember}" IsToggle="False" Visibility="Collapsed"/>
                                    <Tools:OlapToolBarButton x:Name="PART_showVirtualKpiEditor" ToolTip="Virtual KPI" Width="38" Height="38" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" 
                                                ContentTemplate="{StaticResource virtualKpi}" IsToggle="False" Visibility="Collapsed"/>
                                </Tools:OlapToolBar>
                                <Border x:Name="ToolBarBorder" Visibility="Collapsed" Opacity="0.5" Background="Gray"  Grid.Row="0" Margin="0,-0.11,0.3,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                <Grid Grid.Row="1" Margin="10,0,10,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="PART_CubeSelectorSpace" Width="0.20*" MaxWidth="400" />
                                        <ColumnDefinition Width="0.80*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="0,0,8,0" 
                                 Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                 BorderThickness="{TemplateBinding BorderThickness}"
                                 CornerRadius="{TemplateBinding CornerRadius}"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition x:Name="PART_CubeSelectorHeight" Height="50"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" HorizontalAlignment="Stretch" x:Name="PART_CubeSelectorPlaceHolder" VerticalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="23"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Margin="4,4,0,0" Text="{Binding CubeSelector,Source={StaticResource resourceWrapper}}" HorizontalAlignment="Stretch" Foreground="{Binding Path=Foreground,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                           VerticalAlignment="Stretch"></TextBlock>
                                                <ComboBox Grid.Row="1" Margin="3,0,3,3"  HorizontalAlignment="Stretch" 
                                                          VerticalAlignment="Stretch" x:Name="PART_CubeSelector"/>
                                            </Grid>
                                            <Grid Margin="0,7,0,0" Grid.Row="1" HorizontalAlignment="Stretch" x:Name="PART_CubeBrowserPlaceHolder" VerticalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="23"/>
                                                    <RowDefinition x:Name="PART_CubeDimensionBrowserLayout" Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Margin="4,0,0,0" Text="{Binding CubeDimensionBrowser,Source={StaticResource resourceWrapper}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Foreground="{Binding Path=Foreground,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
                                                </TextBlock>
                                                <Tools:CubeDimensionBrowser x:Name="PART_CubeDimensionBrowser" Grid.Row="1" Margin="-0.53,0,0,0"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{Binding Path=TreeViewStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="CubeBorder" Grid.Column="0" Margin="-11,-7,2,-10" Opacity="0.5"
                                 Background="Gray" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"/>
                                    <slv:GridSplitter Width="5" Name="PART_VerticalSplitter" Background="Transparent" BorderBrush="Transparent"
                                                      Opacity="0" Margin="3" VerticalAlignment="Stretch" HorizontalAlignment="Right" />
                                    <Border Width="2" Name="VerticalSplitterBorder" Background="Gray"
                                                      Opacity="0.5" Margin="3" VerticalAlignment="Stretch" HorizontalAlignment="Right" />
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Grid.Resources>
                                            <ResourceDictionary x:Key="pagerDictionary">
                                                <ResourceDictionary.MergedDictionaries>
                                                    <ResourceDictionary Source="/Syncfusion.OlapShared.Silverlight;component/Controls/OlapPager/Themes/Generic.xaml" />
                                                    <ResourceDictionary Source="/Syncfusion.Shared.Silverlight;component/Controls/DataPagerAdv/Themes/generic.xaml" />
                                                </ResourceDictionary.MergedDictionaries>
                                            </ResourceDictionary>
                                        </Grid.Resources>
                                        <Grid.RowDefinitions>
                                            <RowDefinition x:Name="PART_AxisElementsSpace"  Height="0.23*"/>
                                            <RowDefinition x:Name="PART_TabControl" Height="0.72*"/>
                                            <RowDefinition x:Name="PART_PagerControl" Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" HorizontalAlignment="Stretch" x:Name="PART_AxesHolder" VerticalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.30*"/>
                                                <ColumnDefinition Width="0.30*"/>
                                                <ColumnDefinition Width="0.30*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="CategoricalHeader" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                    Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    CornerRadius="{TemplateBinding CornerRadius}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" Margin="0,0,4,0">
                                                <Grid Grid.Column="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="25"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Margin="5,5,0,0" Text="{Binding CategoricalAxis,Source={StaticResource resourceWrapper}}" Foreground="{Binding Path=Foreground,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                     </TextBlock>
                                                    <Tools:AxisElementBuilder Axis="Categorical" Style="{Binding Path=AxisElementBuilderStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                         x:Name="PART_ColumnAxis" HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"  Grid.Row="1"
                                                
                                                      BorderThickness="{TemplateBinding BorderThickness}" Margin="2,5,2,2"/>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="SeriesHeader" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                CornerRadius="{TemplateBinding CornerRadius}"
                                                BorderThickness="{TemplateBinding BorderThickness}" Margin="4,0,4,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="25"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Margin="5,5,0,0" Text="{Binding SeriesAxis,Source={StaticResource resourceWrapper}}" Foreground="{Binding Path=Foreground,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                     </TextBlock>
                                                    <Tools:AxisElementBuilder Axis="Series" x:Name="PART_RowAxis" HorizontalAlignment="Stretch" Style="{Binding Path=AxisElementBuilderStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                      VerticalAlignment="Stretch"  Grid.Row="1"
                                                      BorderThickness="{TemplateBinding BorderThickness}" Margin="2,5,2,2"/>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="SlicerHeader" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="4,0,0,0"
                                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="25"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Margin="5,5,0,0"
                                                         HorizontalAlignment="Stretch" Text="{Binding SlicerAxis,Source={StaticResource resourceWrapper}}" VerticalAlignment="Stretch" Foreground="{Binding Path=Foreground,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
                                                    </TextBlock>
                                                    <Tools:AxisElementBuilder Axis="Slicer" x:Name="PART_SlicerAxis" HorizontalAlignment="Stretch" Style="{Binding Path=AxisElementBuilderStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                      VerticalAlignment="Stretch" Grid.Row="1"
                                                      BorderThickness="{TemplateBinding BorderThickness}" Margin="2,5,2,2"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <slv:GridSplitter x:Name="PART_HorizontalSplitter" Opacity="0" 
                                         Height="2" VerticalAlignment="Bottom" Background="Transparent" BorderBrush="Transparent" 
                                        HorizontalAlignment="Stretch"/>
                                        <sync:TabControlAdv x:Name="PART_OlapTabControl" Grid.Row="1" Margin="0,8,0,0" SelectedIndex="0" Style="{Binding Path=TabControlAdvStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                           Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                                            <sync:TabItemAdv x:Name="PART_OlapChartTab" Header="{Binding OlapChart_TabHeader,Source={StaticResource resourceWrapper}}" Background="Transparent">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition x:Name="PART_OlapChartArea" Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Tools:OlapToolBar Height="33" x:Name="PART_ChartToolBar" Grid.Row="0">
                                                        <Tools:OlapToolBarButton x:Name="PART_ChartToolTip" Width="27" Height="27" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                             ToolTip="{Binding OlapChart_ShowToolTip,Source={StaticResource resourceWrapper}}" IsChecked="True" IsToggle="True"
                                                             ContentTemplate="{StaticResource ChartToolTip}" />

                                                        <Tools:OlapToolBarButton IsToggle="True" IsChecked="True" ToolTip="{Binding OlapChart_ShowLegends,Source={StaticResource resourceWrapper}}" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                         x:Name="PART_ShowLegend" Height="27" Width="27"
                                                         ContentTemplate="{StaticResource ShowChartLegend}" />

                                                        <ComboBox x:Name="Part_ChartTypes" Margin="2" Width="120" ToolTipService.ToolTip="{Binding OlapChart_ChartTypes,Source={StaticResource resourceWrapper}}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Image Margin="1" Source="{Binding StyleImage}"/>
                                                                        <TextBlock  Margin="5,1,0,0" Text="{Binding StyleName}"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <ComboBox x:Name="Part_ChartPalette" ToolTipService.ToolTip="{Binding OlapChart_ColorPalette,Source={StaticResource resourceWrapper}}" 
                                                                  Margin="2" Width="120" >
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Image Margin="1" Source="{Binding StyleImage}"/>
                                                                        <TextBlock  Margin="5,1,0,0" Text="{Binding StyleName}"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Tools:OlapToolBar>
                                                    <syncChart:OlapChart Grid.Row="1" x:Name="PART_OlapChart"  
                                                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                </Grid>
                                            </sync:TabItemAdv>
                                            <sync:TabItemAdv BorderBrush="Transparent" x:Name="PART_OlapGridTab" 
                                             Header="{Binding OlapGrid_TabHeader,Source={StaticResource resourceWrapper}}" Background="Transparent">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Tools:OlapToolBar Height="33" x:Name="PART_GridToolBar" Grid.Row="0">
                                                        <Tools:OlapToolBarButton x:Name="PART_GStyle" Width="27" Height="27" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                               ToolTip="{Binding OlapGrid_StyleDialog,Source={StaticResource resourceWrapper}}" ContentTemplate="{StaticResource GridStyleDialog}" />
                                                        <Tools:OlapToolBarButton x:Name="PART_Freeze" Width="27" Height="27" ToolTip="{Binding OlapGrid_FreezeHeader,Source={StaticResource resourceWrapper}}" 
                                                               IsToggle="True" ContentTemplate="{StaticResource FreezeGridHeader}" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"/>
                                                        <Tools:OlapToolBarButton x:Name="PART_VToolTip" Width="27" Height="27" ToolTip="{Binding OlapGrid_CellToolTip,Source={StaticResource resourceWrapper}}"
                                                                IsToggle="True" IsChecked="True" ContentTemplate="{StaticResource GridCellToolTip}" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"/>

                                                        <Tools:OlapToolBarButton ToolTip="{Binding OlapGrid_ExportWord,Source={StaticResource resourceWrapper}}" x:Name="PART_GWrd" Width="27" Height="27" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                                                 ContentTemplate="{StaticResource GridToWord}"/>
                                                        <Tools:OlapToolBarButton ToolTip="{Binding OlapGrid_ExportExcel,Source={StaticResource resourceWrapper}}" x:Name="PART_GExl" Width="27" Height="27" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                                                 ContentTemplate="{StaticResource GridToExl}"/>
                                                        <Tools:OlapToolBarButton ToolTip="{Binding OlapGrid_ExportPDF,Source={StaticResource resourceWrapper}}" x:Name="PART_GPdf" Width="27" Height="27" Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                                                 ContentTemplate="{StaticResource GridToPdf}"/>
                                                        <ComboBox x:Name="PART_GLayout" Height="20" Margin="2,0,2,0" 
                                                                  ToolTipService.ToolTip="{Binding OlapGrid_Layouts,Source={StaticResource resourceWrapper}}" Width="120">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Image Height="16" Width="16" Margin="1" Source="{Binding StyleImage }"/>
                                                                        <TextBlock  Margin="5,1,0,0" Text="{Binding StyleName}"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Tools:OlapToolBar>
                                                    <syncGrid:OlapGrid Grid.Row="1" Margin="2,5,2,2" x:Name="PART_OlapGrid" FreezeHeaders="False"
                                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                </Grid>
                                            </sync:TabItemAdv>
                                        </sync:TabControlAdv>
                                        <olapPager:OlapPager Grid.Row="2" Margin="2" x:Name="PART_OlapPagerControl" Visibility="Collapsed" VerticalAlignment="Bottom" Cursor="Hand" />                                        
                                        <Border x:Name="TabBorder" Grid.Row="1" Background="Gray" Opacity="0.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"/>                                        
                                        <Tools:OlapToolBarButton x:Name="PART_FullScreenButton" IsToggle="True" HorizontalAlignment="Right"  Style="{Binding Path=ButtonStyle,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          VerticalAlignment="Top" Grid.Row="1" Margin="2,3,-0.5,0" Height="26" Width="26"/>
                                        <Border x:Name="ButtonBorder" HorizontalAlignment="Right" Opacity="0.5" Background="Gray" VerticalAlignment="Top" Grid.Row="1" Margin="2,3,-0.5,0" Height="26" Width="26" Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!--Processing Layer-->
                            <!--Processing Layer-->
                            <Canvas x:Name="PART_ProgressLayer" IsHitTestVisible="True" Height="{TemplateBinding Height}" 
                                    Width="{TemplateBinding Height}" Opacity="0.7" Background="Gray" Visibility="Collapsed"/>

                            <!--Displaying the processing popup-->
                            <Popup x:Name="PART_ProgressPopup" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Popup.Resources>
