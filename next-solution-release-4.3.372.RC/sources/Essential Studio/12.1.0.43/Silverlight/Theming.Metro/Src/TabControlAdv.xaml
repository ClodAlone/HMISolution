<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"  
    xmlns:controlsToolkit="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.Silverlight">
    <SolidColorBrush x:Key="MetroBrush" Color="#FF119EDA"/>

    <SolidColorBrush x:Key="MetroForegroundBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="MetroBackgroundBrush" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="MetroPanelBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="MetroHoverBrush" Color="#FFD8D8D9"/>
    <SolidColorBrush x:Key="MetroFocusedBrush" Color="#FF2ABFF1"/>
    <SolidColorBrush x:Key="MetroHighlightedForegroundBrush" Color="White" />
    <FontFamily x:Key="MetroFontFamily">Segoe WP</FontFamily>
    <SolidColorBrush Color="#FFCCCCCC" x:Key="MetroBorderBrush"/>

    <SolidColorBrush x:Key="GlyphBrushKey" Color="#333333" />

    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="TabItemSelectedForegroundBrush" Color="#FF000000"/>

    <SolidColorBrush x:Key="TabItemSelectedMouseOverBorderBrushKey" Color="#FFBDCDDE"/>


    <LinearGradientBrush x:Key="TabControlAdvMenuBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFDFDFE" Offset="0.046"/>
        <GradientStop Color="#FFE7E8F2" Offset="0.881"/>
    </LinearGradientBrush>


    <SolidColorBrush x:Key="TabControlAdvMenuBorderBrushKey" Color="#FF9BA7B7"/>

    <SolidColorBrush x:Key="MenuInnerLineBrushKey" Color="#FFE2E4E7"/>

    <SolidColorBrush x:Key="MenuInnerColumnBrushKey" Color="#FFE6EAED"/>

    <SolidColorBrush x:Name="SelectedBrushKey" Color="#FFFFE8A6" />

    <LinearGradientBrush   x:Key="MenuItemMouseOverBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFBEF" Offset="0"/>
        <GradientStop Color="#FFFFF3CF" Offset="0.464"/>
        <GradientStop Color="#FFFFE8A6" Offset="0.536"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="MenuItemMouseOverBorderBrushKey" Color="#FFE5C365"/>

    <SolidColorBrush x:Name="MouseOverBackgroundBrushKey" Color="#FFFFFCF4" />

    <SolidColorBrush x:Key="MouseOverBorderBrushKey" Color="#FFE5C365"/>
    <SolidColorBrush x:Key="MouseOverPathBrushKey" Color="#FF000000"/>


    <LinearGradientBrush x:Key="TabItemAdvMouseOverBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF6F7776" Offset="0.044"/>
        <GradientStop Color="#FF546375" Offset="0.805"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Name="TabItemMouseOverBorderBrushKey" Color="#FF9BA7B7" />

    <SolidColorBrush x:Key="TabItemSelectedBorderBrushKey" Color="#FFFFE8A6"/>
    <SolidColorBrush x:Key="TabControlBorderBrushKey" Color="#FF2C3D5A"/>
    <SolidColorBrush x:Key="TabPanelBackgroundBrushKey" Color="#FF2C3D5A"/>
    <LinearGradientBrush x:Key="TabItemSelectedBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFFCF2" Offset="0.028"/>
        <GradientStop Color="#FFFFF3CF" Offset="0.442"/>
        <GradientStop Color="#FFFFE8A6" Offset="0.456"/>
        <GradientStop Color="#FFFFE8A6" Offset="0.986"/>
        <GradientStop Color="White" Offset="1"/>
    </LinearGradientBrush>


    <SolidColorBrush x:Key="TabContentSelectedBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="TabControlAdvButtonBackgroundBrushKey" Color="#CEEDFA"/>

    <SolidColorBrush x:Key="TabControlAdvBorderBrushKey" Color="#9196A2"/>
    <!--Style-->

    <Style TargetType="local:TabItemAdvBorderMetro"  x:Key="local:TabItemAdvBorderMetro">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabItemAdvBorderMetro">
                    <Grid Background="Transparent">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOutterLine" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHoverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverInnerLine" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHoverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverInnerLine" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHoverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="HoverOutterLine" Storyboard.TargetProperty="Opacity" To="0"/>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="HoverInnerLine" Storyboard.TargetProperty="Opacity" To="0"/>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="SelectedOutterLine" Storyboard.TargetProperty="Opacity" To="1"/>
                                        <!--<DoubleAnimation Duration="0" Storyboard.TargetName="BottomLine" Storyboard.TargetProperty="Opacity" To="1"/>-->
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="SelectedMouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="HoverOutterLine" Storyboard.TargetProperty="Opacity" To="0"/>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="HoverInnerLine" Storyboard.TargetProperty="Opacity" To="0"/>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="SelectedOutterLine" Storyboard.TargetProperty="Opacity" To="1"/>
                                        <!--<DoubleAnimation Duration="0" Storyboard.TargetName="BottomLine" Storyboard.TargetProperty="Opacity" To="1"/>-->
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Canvas>
                            <Border x:Name="BackBorder" Background="Transparent"/>
                            <Path x:Name="SelectedOutterLine" Opacity="0" Fill="{StaticResource MetroBrush}" Stroke="{StaticResource MetroBrush}"></Path>
                            <Path x:Name="SelectedMouseOverOutterLine" Opacity="0" Fill="{StaticResource TabItemSelectedBrushKey}" Stroke="{StaticResource TabItemSelectedMouseOverBorderBrushKey}"></Path>
                            <Path x:Name="HoverSelectedLine" Opacity="0" Stroke="{StaticResource TabItemSelectedMouseOverBorderBrushKey}" Fill="Transparent"></Path>
                            <Path x:Name="HoverOutterLine" StrokeThickness="0.5" Stroke="{TemplateBinding BorderBrush}" Fill="Transparent"></Path>
                            <Path x:Name="HoverInnerLine" Stroke="{TemplateBinding BorderBrush}" Fill="{TemplateBinding Background}"></Path>
                            <Path x:Name="BottomLine" Opacity="0" Stroke="Transparent"></Path>
                            <ContentPresenter Content="{TemplateBinding Content}">
                            </ContentPresenter>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:TabItemAdvBorderMetro"  BasedOn="{StaticResource local:TabItemAdvBorderMetro}"/>

    <Style TargetType="local:DragMarker" x:Key="local:DragMarker">
        <Setter Property="Width" Value="0"/>
        <Setter Property="Height" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DragMarker">
                    <Popup x:Name="Popup" HorizontalOffset="{TemplateBinding HorizontalOffset}"
                           VerticalOffset="{TemplateBinding VerticalOffset}" Height="9" Width="8">
                        <Path x:Name="MarkerPath" Data="M3,0L3,7 L1,7 L4.5,10 L8,7 L6,7 L6,0 L2.5,0" Fill="{StaticResource TabControlAdvButtonBackgroundBrushKey}" 
                              Stroke="{StaticResource TabControlAdvBorderBrushKey}"/>
                    </Popup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource local:DragMarker}" TargetType="local:DragMarker"/>
    <SolidColorBrush x:Key="GlyphBrushKey1" Color="#333333"/>
    
    <Style TargetType="local:TabPopupMenuItem" x:Key="local:TabPopupMenuItem">
        <Setter Property="Foreground" Value="{StaticResource MetroForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabPopupMenuItem">
                    <Grid Background="Transparent">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverButtonBorder" Storyboard.TargetProperty="Opacity" To="1"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_PopUpPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>

                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="MouseOverButtonBorder" Opacity="0" Background="{StaticResource MetroBrush}"  BorderThickness="0"/>
                        <Border x:Name="ItemBorder" Background="Transparent" BorderBrush="Transparent"  BorderThickness="0">
                            <Grid x:Name="ItemGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image x:Name="ItemImage" Grid.Column="0" Width="20" Height="20" Source="{TemplateBinding HeaderImage}" Margin="1"/>
                                <ContentControl  x:Name="PART_PopUpPresenter" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                                   Margin="5,0,5,0"                  ContentTemplate="{TemplateBinding HeaderTextTemplate}" Content="{TemplateBinding HeaderText}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:TabPopupMenuItem"  BasedOn="{StaticResource local:TabPopupMenuItem}"/>

    <Style TargetType="local:TabPopupMenu" x:Key="local:TabPopupMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabPopupMenu">
                    <Popup x:Name="Popup" HorizontalOffset="{TemplateBinding HorizontalOffset}"
                           VerticalOffset="{TemplateBinding VerticalOffset}">
                        <Border x:Name="PopupBorder" Background="{StaticResource MetroPanelBackgroundBrush}" BorderThickness="1"
                                BorderBrush="{StaticResource MetroBorderBrush}">
                            <Border.Effect>
                                <DropShadowEffect
                                Color="#FFC6C3C6"
                                ShadowDepth="3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="1"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource MetroPanelBackgroundBrush}"/>
                                    <Border Grid.Column="1" Background="{StaticResource MetroBorderBrush}"/>
                                </Grid>
                                <StackPanel x:Name="PopupRoot" Grid.ColumnSpan="3">
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Popup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:TabPopupMenu"  BasedOn="{StaticResource local:TabPopupMenu}"/>

    <Style TargetType="local:ScrollingButton" x:Key="local:ScrollingButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ScrollingButton">
                    <Grid Background="Transparent">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverButtonBorder" Storyboard.TargetProperty="Opacity" To="1"/>

                                    </Storyboard>

                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroFocusedBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path1" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path1" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path2" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path2" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path3" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path3" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>

                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path4" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path4" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path5" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path5" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path6" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Path6" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="MouseOverButtonBorder" Opacity="0" Width="14" Height="14" Background="{StaticResource MetroHoverBrush}" BorderBrush="{StaticResource MouseOverBorderBrushKey}" BorderThickness="0"/>
                        <Border x:Name="ButtonBorder" Width="14" Height="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="PART_Path1" Data="M0,0L4,3.5 0,7" Stroke="{StaticResource GlyphBrushKey}" 
                                      Fill="{StaticResource GlyphBrushKey}"/>
                                <Path x:Name="PART_Path2" Data="M4,0L8,3.5 4,7"  Stroke="{StaticResource GlyphBrushKey}" 
                                      Fill="{StaticResource GlyphBrushKey}" Visibility="Collapsed"/>
                                <Path x:Name="PART_Path3" Data="M5,0L5,7" Stroke="{StaticResource GlyphBrushKey}" 
                                      Fill="{StaticResource GlyphBrushKey}" Visibility="Collapsed"/>
                                <Path x:Name="PART_Path4" Data="M8,0L4,3.5 8,7" Stroke="{StaticResource GlyphBrushKey}" 
                                      Fill="{StaticResource GlyphBrushKey}" Visibility="Collapsed"/>
                                <Path x:Name="PART_Path5" Data="M4,0L0,3.5 4,7" Stroke="{StaticResource GlyphBrushKey}" 
                                      Fill="{StaticResource GlyphBrushKey}" Visibility="Collapsed"/>
                                <Path x:Name="PART_Path6" Data="M2,0L2,7" Stroke="{StaticResource GlyphBrushKey}" 
                                      Fill="{StaticResource GlyphBrushKey}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:ScrollingButton"  BasedOn="{StaticResource local:ScrollingButton}"/>

    <Style TargetType="local:MenuButton" x:Key="local:MenuButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MenuButton">
                    <Grid>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverButtonBorder" Storyboard.TargetProperty="Opacity" To="1"/>

                                    </Storyboard>

                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroFocusedBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PathButton" Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>

                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="MouseOverButtonBorder" Width="14" Height="14" Background="{StaticResource MetroHoverBrush}" Opacity="0" BorderBrush="{StaticResource MouseOverBorderBrushKey}" BorderThickness="0"/>
                        <Border x:Name="ButtonBorder" Width="14" Height="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Path x:Name="PathButton"
				                Fill="{StaticResource GlyphBrushKey}"
				                HorizontalAlignment="Center" VerticalAlignment="Center"
				                Width="8" Height="8">
                                <Path.Data>
                                    <GeometryGroup>
                                        <PathGeometry>
                                            <PathFigure StartPoint="0,1" IsFilled="True" IsClosed="True">
                                                <LineSegment Point="8,1"/>
                                                <LineSegment Point="8,3"/>
                                                <LineSegment Point="0,3"/>
                                            </PathFigure>
                                        </PathGeometry>
                                        <PathGeometry>
                                            <PathFigure StartPoint="0,4" IsFilled="True" IsClosed="True">
                                                <LineSegment Point="4,8"/>
                                                <LineSegment Point="8,4"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:MenuButton"  BasedOn="{StaticResource local:MenuButton}"/>

    <Style TargetType="local:CloseButton" x:Key="CloseButton1">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CloseButton">
                    <Grid Background="Transparent">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CrossPath" Storyboard.TargetProperty="Stroke">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHoverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>

                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="MouseOverButtonBorder" Opacity="0" Width="14" Height="14" Background="{StaticResource MetroHoverBrush}" BorderBrush="{StaticResource MouseOverBorderBrushKey}" BorderThickness="0"/>
                        <Border x:Name="ButtonBorder" Width="14" Height="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Path x:Name="CrossPath"
				                    Stroke="White"
				                    StrokeThickness="1.5"
                                    Data="M1,1 L7,7 M1,7 L7,1"
				                    HorizontalAlignment="Center" VerticalAlignment="Center"
				                    Width="8" Height="8"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:CloseButton" x:Key="local:CloseButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CloseButton">
                    <Grid Background="Transparent">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" Storyboard.TargetName="MouseOverButtonBorder" Storyboard.TargetProperty="Opacity" To="1"/>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="MouseOverButtonBorder" Opacity="0" Width="14" Height="14" Background="{StaticResource MetroHoverBrush}" BorderBrush="{StaticResource MouseOverBorderBrushKey}" BorderThickness="0"/>
                        <Border x:Name="ButtonBorder" Width="14" Height="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Path x:Name="CrossPath"
				                    Stroke="#333333"
				                    StrokeThickness="1.5"
                                    Data="M1,1 L7,7 M1,7 L7,1"
				                    HorizontalAlignment="Center" VerticalAlignment="Center"
				                    Width="8" Height="8"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:CloseButton"  BasedOn="{StaticResource local:CloseButton}"/>

    <Style TargetType="local:TabPanelAdv" x:Key="local:TabPanelAdv">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabPanelAdv">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
							Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <controlsToolkit:DockPanel x:Name="DockPanel" LastChildFill="False">
                            <Border x:Name="ButtonsBorder" BorderThickness="0" BorderBrush="{StaticResource TabItemSelectedBorderBrushKey}" 
                                    controlsToolkit:DockPanel.Dock="Right">
                                <controlsToolkit:DockPanel>
                                    <local:CloseButton 
                                        x:Name="PART_CloseButton" 
                                        Style="{StaticResource local:CloseButton}"
                                        Width="15" Height="14" Margin="0,0,3,0"
                                        />
                                    <StackPanel x:Name="MenuPanel" controlsToolkit:DockPanel.Dock="Right" Width="14" Height="14">
                                        <local:TabPopupMenu 
                                            x:Name="TabPopupMenu"
                                            Style="{StaticResource local:TabPopupMenu}"/>
                                        <local:MenuButton 
                                            x:Name="PART_MenuButton" 
                                            Style="{StaticResource local:MenuButton}"
                                            Width="14" Height="14" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <local:ScrollingPanel x:Name="PART_ScrollingPanel" HorizontalAlignment="Center" controlsToolkit:DockPanel.Dock="Right">
                                        <local:ScrollingButton 
                                                x:Name="FirstTab" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="FirstTab" Visibility="Collapsed"/>
                                        <local:ScrollingButton 
                                                x:Name="PrevPage"
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="PrevPage" Visibility="Collapsed"/>
                                        <local:ScrollingButton 
                                                x:Name="PrevTab" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="PrevTab"/>
                                        <local:ScrollingButton 
                                                x:Name="NextTab"
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="NextTab"/>
                                        <local:ScrollingButton 
                                                x:Name="NextPage" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="NextPage" Visibility="Collapsed"/>
                                        <local:ScrollingButton 
                                                x:Name="LastTab" 
                                                Style="{StaticResource local:ScrollingButton}"
                                                ScrollDirection="LastTab" Visibility="Collapsed"/>
                                    </local:ScrollingPanel>
                                </controlsToolkit:DockPanel>
                            </Border>
                            <Grid>
                                <Border x:Name="BottomBorder" controlsToolkit:DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                        Height="1" BorderThickness="0" BorderBrush="{StaticResource TabItemSelectedBorderBrushKey}"/>
                                <ContentPresenter x:Name="PART_TabItems"
                                          HorizontalAlignment="Center"
                                          controlsToolkit:DockPanel.Dock="Left"/>
                            </Grid>
                        </controlsToolkit:DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:TabPanelAdv"  BasedOn="{StaticResource local:TabPanelAdv}"/>

    <Style TargetType="local:TabItemAdv" x:Key="MetroTabItemAdvStyle">
        <Setter Property="Foreground" Value="{StaticResource MetroForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MetroFontFamily}"/>
        <Setter Property="Margin" Value="3,3,3,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabItemAdv">
                    <Grid Background="Transparent">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">

                                <vsm:VisualState x:Name="Selected">
                                    <Storyboard>
                                        <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Margin">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0, 3, 0, 0"/>
                                        </ObjectAnimationUsingKeyFrames>-->
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CloseButton" Storyboard.TargetProperty="Style">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CloseButton1}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="UnSelected">
                                    <Storyboard>
                                        <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Margin">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0, 3, 0, 0"/>
                                        </ObjectAnimationUsingKeyFrames>-->
                                        
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Normal">
                                    <Storyboard>
                                        <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Margin">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0, 3, 0, 0"/>
                                        </ObjectAnimationUsingKeyFrames>-->
                                        <!--<ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TabItemForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>-->
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TabItemBorder" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroForegroundBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <local:TabItemAdvBorderMetro
                            x:Name="TabItemBorder" 
                            Style="{StaticResource local:TabItemAdvBorderMetro}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Foreground="{TemplateBinding Foreground}">
                            <controlsToolkit:DockPanel x:Name="PART_DockPanel" LastChildFill="True" Margin="5,3,5,3" >
                                <local:DragMarker 
                                x:Name="DragMarker"
                                Style="{StaticResource local:DragMarker}"/>
                                <local:CloseButton 
                                x:Name="PART_CloseButton" 
                                Style="{StaticResource local:CloseButton}"
                                Width="15" Height="14" Margin="1,0,1,0" controlsToolkit:DockPanel.Dock="Right"
                               VerticalAlignment="Center"/>
                                <Image x:Name="PART_Image" Stretch="None" Margin="1,0,1,0" VerticalAlignment="Center"/>
                                <local:TabContentPanel x:Name="TabContentPanel"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                    <TextBox x:Name="PART_TextBox"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Visibility="Collapsed"/>
                                    <ContentPresenter x:Name="PART_Content"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Visibility="Visible">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock"/>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </local:TabContentPanel>
                            </controlsToolkit:DockPanel>
                        </local:TabItemAdvBorderMetro>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:TabItemAdv"  BasedOn="{StaticResource MetroTabItemAdvStyle}"/>

    <SolidColorBrush x:Key="TabcontrolBorder" Color="#FF293955"/>
    <Style TargetType="local:TabControlAdv" x:Key="MetroTabControlAdvStyle">
        <Setter Property="Background" Value="{StaticResource MetroPanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetroBorderBrush}"/>
        <Setter Property="MinHeight"   Value="100"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:TabLayoutPanel x:Name="TabLayoutPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TabControlAdv">
                    <Grid Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="TopPlacement">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 0, 1, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="LeftPlacement">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0, 1, 1, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="RightPlacement">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 0, 1"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="BottomPlacement">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1, 1, 1, 0"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>
                        <local:TabControlPanel x:Name="TabControlPanel" Background="{TemplateBinding Background}">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="{StaticResource MetroBackgroundBrush}">
                                <local:TabPanelAdv 
                                    x:Name="TabPanel" 
                                    Style="{StaticResource local:TabPanelAdv}"
                                    HorizontalAlignment="Left" VerticalAlignment="Stretch">
                                    <local:TabLayoutPanel x:Name="TabLayoutPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </local:TabPanelAdv>

                            </Grid>
                            <Border x:Name="ContentPanel" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </Border>
                        </local:TabControlPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="MenuItemStyle" Value="{StaticResource local:TabPopupMenuItem}"/>
        <Setter Property="ItemContainerStyle"  Value="{StaticResource MetroTabItemAdvStyle}"/>
    </Style>
    <Style BasedOn="{StaticResource MetroTabControlAdvStyle}" TargetType="local:TabControlAdv"/>

</ResourceDictionary>
