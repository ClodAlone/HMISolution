<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
     xmlns:Effect="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Ribbon.Silverlight">

    <Effect:DisableEffect x:Key="DisableEffect"/>

    <SolidColorBrush x:Key="MetroBrush" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroForegroundBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="MetroBackgroundBrush" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="MetroPanelBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="MetroHoverBrush" Color="#FFD8D8D9"/>
    <SolidColorBrush x:Key="MetroFocusedBrush" Color="#FF2ABFF1"/>
    <SolidColorBrush x:Key="MetroHighlightedForegroundBrush" Color="White" />
    <FontFamily x:Key="MetroFontFamily">/Syncfusion.Theming.Metro;component/Fonts/SegoeWP.ttf#Segoe WP</FontFamily>
    <SolidColorBrush Color="#FFCCCCCC" x:Key="MetroBorderBrush"/>
      
    <!--Style-->

    <Style TargetType="local:RibbonButton" x:Key="MetroRibbonButtonStyle">
        <Setter Property="Foreground" Value="{StaticResource MetroForegroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MetroFontFamily}"/>
        <Setter Property="SmallIcon" Value="/Syncfusion.Ribbon.Silverlight;component/Ribbon/Resources/WordArt16.png"/>
        <Setter Property="LargeIcon" Value="/Syncfusion.Ribbon.Silverlight;component/Ribbon/Resources/WordArt32.png"/>
        <Setter Property="Label" Value="Ribbon Button"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="MinWidth" Value="22"/>
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RibbonButton">
                    <Grid>
                        <Grid.Resources>
                            <local:MultiLineConverter x:Key="TextConverter"/>
                        </Grid.Resources>
                        <vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="RibbonButtonStates">

                                <vsm:VisualState x:Name="Normal" />

                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
									
										
										<!-- Large Button Style -->
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder1" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroBorderBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder1" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>									
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroFocusedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Text" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>

                                        <!-- Large Button -->
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder1" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroFocusedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder1" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_TextAreaLarge" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MetroHighlightedForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="UnChecked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ItemBorder1" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ItemCheckedBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                                <vsm:VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Image" Storyboard.TargetProperty="Effect">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource DisableEffect}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ImageLarge" Storyboard.TargetProperty="Effect">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource DisableEffect}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>

                            </vsm:VisualStateGroup>

                        </vsm:VisualStateManager.VisualStateGroups>
                        <Border x:Name="ItemCheckedBorder" Opacity="0"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{StaticResource MetroBrush}" 
                                BorderBrush="{StaticResource MetroFocusedBrush}"/>
                        
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Name="ItemBorder">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>								
                                <Border Name="PART_ImageBorder" Grid.Column="0" Margin="2">
                                    <Image x:Name="PART_Image"
						            Width="16" Height="16"   
						            Source="{Binding Path=SmallIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" x:Name="PART_Text"
                                           Text="{TemplateBinding Label}" 
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="{TemplateBinding VerticalAlignment}"                           
                                           HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                           Margin="2,0,4,0"/>
                            </Grid>
							
                        </Border>
                        
                        <Border Background="{TemplateBinding Background}" Visibility="Collapsed"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                MinHeight="22" Name="ItemBorder1">
								<Grid>                                
                                <StackPanel Margin="2">
                                <Border Name="PART_ImageBorderLarge">
                                    <Image x:Name="PART_ImageLarge"
						            Width="26" Height="26"   
						            Source="{Binding Path=LargeIcon, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Border>
                                <ItemsControl x:Name="PART_TextAreaLarge" Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="{TemplateBinding VerticalAlignment}"                           
                                               HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                               Margin="2,0,4,0"/>
                            </StackPanel>
							</Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

	<Style BasedOn="{StaticResource MetroRibbonButtonStyle}" TargetType="local:RibbonButton"/>
	
	</ResourceDictionary>
