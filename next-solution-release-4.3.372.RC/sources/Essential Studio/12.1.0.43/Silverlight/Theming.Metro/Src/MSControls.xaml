                        <Path x:Name="EditingRowGlyph" Stretch="Fill" Fill="{StaticResource MetroDataGridCurrentRowGlyphBackground}" Height="10" HorizontalAlignment="Center" Margin="8,0,8,0" VerticalAlignment="Center" Width="6" Opacity="0" Grid.RowSpan="2" Data="F1 M 511.047,352.682L 511.047,342.252L 517.145,347.467L 511.047,352.682 Z "/>
                    </Grid>
