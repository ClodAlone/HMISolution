    <Style x:Key="MetroDataPagerStyle" TargetType="sdk:DataPager">
        <Setter Property="Background" Value="{StaticResource MetroDataPagerBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetroDataPagerBorderBrush}">
