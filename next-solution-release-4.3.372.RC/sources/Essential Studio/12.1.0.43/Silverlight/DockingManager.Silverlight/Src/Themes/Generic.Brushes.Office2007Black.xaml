    <Style x:Key="Office2007Black.ListBoxStyle1" TargetType="ListBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border BorderBrush="White" BorderThickness="1">
                        <Grid x:Name="LayoutRoot">
