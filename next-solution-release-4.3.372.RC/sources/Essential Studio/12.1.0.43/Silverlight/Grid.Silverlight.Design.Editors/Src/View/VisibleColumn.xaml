<UserControl x:Class="Syncfusion.Grid.WPF.VisualStudio.Design.VisibleColumn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Syncfusion.Grid.WPF.VisualStudio.Design"
             xmlns:loc="clr-namespace:Syncfusion.Grid.WPF.VisualStudio.Design"
             xmlns:syswin="clr-namespace:System.Windows;assembly=PresentationCore"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
             >
   
  
    <UserControl.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFE9EDF1" Offset="0.015"/>
            <GradientStop Color="#FFD1D6DC" Offset="0.937"/>
        </LinearGradientBrush>
    </UserControl.Background>
    <UserControl.Resources>
        <ObjectDataProvider MethodName="GetValues"
        ObjectType="{x:Type sys:Enum}"
        x:Key="CellTypesValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:CellTypes" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style TargetType="{x:Type TextBox}" >
            <Style.Setters>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
            </Style.Setters>
        </Style>
        <Style TargetType="{x:Type TextBlock}" >
            <Style.Setters>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
            </Style.Setters>
        </Style>
        <Style TargetType="{x:Type ComboBox}" >
            <Style.Setters>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
            </Style.Setters>
        </Style>

        <ObjectDataProvider MethodName="GetValues"
        ObjectType="{x:Type sys:Enum}"
        x:Key="DateTimePatternValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:DateTimePatternView" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <local:VisiblityConverter x:Key="visiblityConverter"/>
        <local:ListBoxVisiblityConverter x:Key="LBVisiblityConverter"/>
        <Style  TargetType="{x:Type CheckBox}">

            <Style.Setters>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="80*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="innerBorder" Margin="8,2,7,2 " Width="13" Height="13">
                                    <Border.Background>
                                        <DrawingBrush>
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <DrawingGroup.Children>
                                                        <GeometryDrawing Geometry="M2,2.0344564 L40,40.034456 M39.965481,2 L2.034519,40.068913">

                                                            <GeometryDrawing.Pen>
                                                                <Pen Thickness="15" LineJoin="Round">
                                                                    <Pen.Brush>
                                                                        <LinearGradientBrush StartPoint="0.545017,0.0107753" EndPoint="0.545017,0.995331">
                                                                            <LinearGradientBrush.GradientStops>
                                                                                <GradientStop Color="#FF5F332B" Offset="0"/>
                                                                                <GradientStop Color="#FFF70F0F" Offset="0.2"/>
                                                                                <GradientStop Color="#FFF70303" Offset="0.6"/>
                                                                                <GradientStop Color="#FFD01313" Offset="0.8"/>
                                                                            </LinearGradientBrush.GradientStops>
                                                                        </LinearGradientBrush>
                                                                    </Pen.Brush>
                                                                </Pen>
                                                            </GeometryDrawing.Pen>
                                                        </GeometryDrawing>
                                                    </DrawingGroup.Children>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Border.Background>

                                </Border>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid>
                            <ControlTemplate.Triggers>


                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="innerBorder" Property="Background">
                                        <Setter.Value>
                                            <DrawingBrush>
                                                <DrawingBrush.Drawing>
                                                    <DrawingGroup>
                                                        <DrawingGroup.Children>
                                                            <GeometryDrawing Geometry="M281,162 C294.09643,176.51227 282.01024,193.98464 304,161 311.53032,149.70451 313.918,142.541 327,136 311.96916,128.48458 306.14401,152.39199 292,163 287.63201,158.63201 288.1241,155 281,155 279.79675,158.00812 279,158.06773 279,162 279.66667,162 280.33333,162 281,162 z">
                                                                <GeometryDrawing.Brush>
                                                                    <LinearGradientBrush EndPoint="0,0.5" StartPoint="1,0.5">
                                                                        <GradientStop Color="#FF464932" Offset="0"/>
                                                                        <GradientStop Color="#FF5DE442" Offset="0.167"/>
                                                                        <GradientStop Color="#FF34DF1E" Offset="0.333"/>
                                                                        <GradientStop Color="#FF39BD02" Offset="0.667"/>
                                                                    </LinearGradientBrush>
                                                                </GeometryDrawing.Brush>
                                                            </GeometryDrawing>
                                                        </DrawingGroup.Children>
                                                    </DrawingGroup>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style.Setters>
        </Style>
        <ObjectDataProvider MethodName="GetValues"
        ObjectType="{x:Type sys:Enum}"
        x:Key="HorizontalAlignmentValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="HorizontalAlignment"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider MethodName="GetValues"
        ObjectType="{x:Type sys:Enum}"
        x:Key="VerticalAlignmentValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="VerticalAlignment"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style TargetType="ListBoxItem">

            <Setter Property="FocusVisualStyle" Value="{x:Null}"  />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">

                        <Border >
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Expander  Header ="{Binding MappingNameType}"   Expanded="Expander_Expanded" >

                                    <Border  >
                                        <Grid x:Name="RootGrid" >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="0.065*"/>
                                                <RowDefinition Height="0.065*"/>
                                                <RowDefinition Height="0.065*"/>
                                                <RowDefinition Height="0.065*"/>
                                                <RowDefinition Height="0.065*"/>
                                                <RowDefinition Height="0.065*"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="364*"/>
                                                <ColumnDefinition Width="139*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Row="0">
                                                <TextBlock Grid.Row="0" Text="Column Properties" FontSize="15.333"  Margin="4" FontFamily="Segoe UI"> 
									<TextBlock.Foreground>
										<LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">											
                                            <GradientStop Color="#FF3C342A" Offset="0"/>
					<GradientStop Color="#FF3C342A" Offset="0.923"/>
					<GradientStop Color="#FF3C342A" Offset="1"/>
										</LinearGradientBrush>
									</TextBlock.Foreground>
                                                </TextBlock>
                                                <Path Grid.Row="1" Margin="4,0,4,0" Fill="White" Stretch="Fill" Stroke="#FF4F473D" Data="M11.604,91.833333 L106.333,91.833333"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" >
                                                <TextBlock Grid.Row="0" Text="Style Properties" FontSize="15.333" Margin="4">
									<TextBlock.Foreground>
										<LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">											
                                            <GradientStop Color="#FF3C342A" Offset="0"/>
					<GradientStop Color="#FF3C342A" Offset="0.923"/>
					<GradientStop Color="#FF3C342A" Offset="1"/>
										</LinearGradientBrush>
									</TextBlock.Foreground>
                                                </TextBlock>
                                                <Path Grid.Row="1" Margin="4,0,4,0" Fill="White" Stretch="Fill" Stroke="#FF4F473D" Data="M11.604,91.833333 L106.333,91.833333"/>
                                            </StackPanel>



                                            <Border Grid.Row="1"
                              Grid.Column="0" 
                                      CornerRadius="4"
                                    >



                                                <Grid Height="Auto"  >


                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="30"/>
                                                        <RowDefinition Height="40"/>
                                                        <RowDefinition Height="40"/>

                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition  Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox 
                                           
                                            Grid.Row="0" 
                                            Grid.Column="0" 
                                            
                                            
                                            
                                                    IsChecked="{Binding AllowFilter,Mode=TwoWay}"
                                            Margin="2,4,2,4"
                                            >
                                                        <TextBlock Text="Allow Filter" Height="20" FontSize="12"/>
                                                    </CheckBox>
                                                    <CheckBox 
                                           Margin="2,4,2,4"
                                            
                                                IsChecked="{Binding AllowSort,Mode=TwoWay}"
                                            Grid.Row="0" 
                                            Grid.Column="1"  
                                           
                                                                                          
                                            >
                                                        <TextBlock Text="Allow Sort" Height="20" FontSize="12"/>
                                                    </CheckBox>
                                                    <CheckBox 
                                           
                                            
                                            Grid.Row="1" 
                                            Grid.Column="0" 
                                           
                                              IsChecked="{Binding AllowDrag, Mode=TwoWay}"
                                           Margin="2,4,2,4"
                                            >
                                                        <TextBlock Text="Allow Drag" Height="20" FontSize="12"/>
                                                    </CheckBox>

                                                    <CheckBox 
                                           Margin="2,4,2,4"
                                            
                                            Grid.Row="1" 
                                            Grid.Column="1"  
                                           
                                            
                                                    IsChecked="{Binding AllowGroup,Mode=TwoWay}"
                                            >
                                                        <TextBlock Text="Allow Group" Height="20" FontSize="12"/>
                                                    </CheckBox>
                                                    <CheckBox 
                                           
                                            
                                            Grid.Row="2" 
                                            Grid.Column="0" 
                                           
                                            Margin="2,4,2,4"
                                                    IsChecked="{Binding AllowResize,Mode=TwoWay}"
                                            >
                                                        <TextBlock Text="Allow Resize" Height="20" FontSize="12"/>
                                                    </CheckBox>
                                                    <CheckBox 
                                           
                                            
                                            Grid.Row="2" 
                                            Grid.Column="1"  
                                           
                                            
IsChecked="{Binding IsReadOnly,Mode=TwoWay}"
                                            >
                                                        <TextBlock Text="Is ReadOnly" Height="20" FontSize="12"/>
                                                    </CheckBox>



                                                    <CheckBox 
                                            Name="PART_ChkAutoFit"
                                            
                                                    Grid.Row="3"
                                                Margin="2,4,2,4"
                                                    IsChecked="{Binding AutoFit,Mode=TwoWay}"
                                            >
                                                        <TextBlock Text="Auto Fit"  Height="20" FontSize="12"/>
                                                    </CheckBox>


                                                    <Slider Grid.Row="3"
                                                    Grid.Column="1"
                                                        x:Name="PART_WidthSetter" 
                                                       Margin="2,4,2,4"
                                                        Minimum="0" 
                                                        Maximum="500" 
                                                        Width="200"
                                                         Value="{Binding ColumnWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Focusable="{Binding ElementName=PART_ChkAutoFit, Path=IsChecked}"                                                        
                                                        >
                                                        <Slider.Style>
                                                            <Style TargetType="{x:Type Slider}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=PART_ChkAutoFit}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=PART_ChkAutoFit}" Value="False">
                                                                        <Setter Property="IsEnabled" Value="True" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Slider.Style>
                                                    </Slider>

                                                    <StackPanel  Grid.Row="4" Orientation="Horizontal" Grid.ColumnSpan="2">
                                                        <TextBlock 
                                           Margin="13,10,10,10"
                                            Grid.Row="4" 
                                            Text="Header Text" 
                                            
                                            
                                                                                              
                                             />
                                                        <TextBox 
                                            
											  	Text="{Binding HeaderText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="17,10,10,10" Width="150"  Height="25"
                                            />
                                                    </StackPanel>
                                                    <StackPanel x:Uid="ColumnFormat"   Grid.Row="5" Grid.ColumnSpan="2">
                                                        <StackPanel   Orientation="Horizontal" Grid.ColumnSpan="2" DataContext="{Binding ColumnStyleModel,Mode=TwoWay}">
                                                            <TextBlock Text="Column Format" Margin="13,10,10,10" />

                                                            <ComboBox Grid.Row="5" Margin="3,10,0,10" Width="150" IsEnabled="{Binding Path=ColumnFormatEnabled}"  ItemsSource="{Binding Path=ColumnFormatSource}"  SelectedItem="{Binding Path=Format}">
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <StackPanel Margin="20,1,2,8" 
                                    x:Uid="GridCellTypes"
                                    Grid.Row="3"
                                    
                                    >


                                                <Grid DataContext="{Binding ColumnStyleModel,Mode=TwoWay}"   >

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>

                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="1" Width="Auto">
                                                        <Grid.Resources>
                                                            <Style TargetType="{x:Type TextBox}" >
                                                                <Style.Setters>
                                                                    <Setter Property="FontFamily" Value="Segoe UI"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                </Style.Setters>
                                                            </Style>
                                                            <Style TargetType="{x:Type TextBlock}" >
                                                                <Style.Setters>
                                                                    <Setter Property="FontFamily" Value="Segoe UI"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                </Style.Setters>
                                                            </Style>
                                                            <Style TargetType="{x:Type ComboBox}" >
                                                                <Style.Setters>
                                                                    <Setter Property="FontFamily" Value="Segoe UI"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                </Style.Setters>
                                                            </Style>

                                                        </Grid.Resources>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <StackPanel Orientation="Horizontal" Grid.Row="1">

                                                        </StackPanel>

                                                        <TextBlock 
                                                        FontSize="12" 
                                                            Margin="0,2,0,0"
                                                       Text="Special Cell Types"
                                                        />

                                                        <ComboBox Grid.Column="1" x:Name="SpecialCellTypes" Margin="3,0,0,0" ItemsSource="{Binding Source={StaticResource CellTypesValues}}" SelectedItem="{Binding Path=CellType}" >

                                                        </ComboBox>

                                                        <Grid Grid.Row="2" Grid.ColumnSpan="2" x:Name="ComboBox"  Visibility="{Binding ElementName=SpecialCellTypes, Path=SelectedItem, Converter={StaticResource visiblityConverter}, ConverterParameter=ComboBox}">

                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="DropDownStyle" />
                                                            <ComboBox Grid.Column="1" />
                                                            <TextBlock Text="DisplayMember" Grid.Row="1" />
                                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DisplayMember,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                        </Grid >
                                                        <Grid Grid.Row="2" Grid.ColumnSpan="2" x:Name="CurrencyEdit" Visibility="{Binding ElementName=SpecialCellTypes, Path=SelectedItem, Converter={StaticResource visiblityConverter},ConverterParameter=CurrencyEdit}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />

                                                            </Grid.ColumnDefinitions>



                                                            <TextBlock  Text="Minimum Value"  Grid.Row="0"  Grid.Column="0">
                                                            </TextBlock>


                                                            <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding MinValueCurrency,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />


                                                            <TextBlock  Grid.Row="2">Maximum Value</TextBlock>

                                                            <TextBox  Name="DecimalNo" Text="{Binding MaxValueCurrency,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"/>

                                                        </Grid>
                                                        <Grid Grid.Row="2" Grid.ColumnSpan="2"   x:Name="DateTimeEdit" Visibility="{Binding ElementName=SpecialCellTypes, Path=SelectedItem, Converter={StaticResource visiblityConverter},ConverterParameter=DateTimeEdit}">

                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>

                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="Date Format" />
                                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Source={StaticResource DateTimePatternValues}}" SelectedItem="{Binding Path=DateTimePattern}"/>

                                                            <CheckBox Content="IsVisibleRepeatButton" Grid.Row="2" IsChecked="{Binding IsVisibleRepeatButton,Mode=TwoWay}" />
                                                            <CheckBox Content="IsWatchEnabled" Grid.Row="2" Grid.Column="1" IsChecked="{Binding IsWatchEnabled,Mode=TwoWay}"/>
                                                            <TextBlock Text="NoneDateText" Grid.Row="1"  />
                                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NoneDateText,Mode=TwoWay}"/>

                                                        </Grid>
                                                        <Grid ShowGridLines="False" Grid.Row="2"  Grid.ColumnSpan="2" x:Name="DoubleEdit"  Visibility="{Binding ElementName=SpecialCellTypes, Path=SelectedItem, Converter={StaticResource visiblityConverter},ConverterParameter=DoubleEdit}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />

                                                            </Grid.ColumnDefinitions>

                                                            <!-- Set decimal seperator -->
                                                            <TextBlock  TextWrapping="Wrap"  Grid.Row="0" Margin="0 10 0 0" HorizontalAlignment="Left" Text="Decimal Separator"/>

                                                            <TextBox  Name="DecimalSeparator" Text="."  Grid.Row="0" Grid.Column="1"  />


                                                            <!-- Set the Number of decimal digits -->
                                                            <TextBlock  TextWrapping="Wrap"   Grid.Row="1" Margin="0 10 0 0" HorizontalAlignment="Left" Text="No of Decimal Digits"/>


                                                            <TextBox  Grid.Row="1" Grid.Column="1"  Name="NoOfDecimalDigits" Text="2" />


                                                            <!-- Set the AutoCorrect duration -->
                                                            <TextBlock   TextWrapping="Wrap"  Grid.Row="2" Margin="0 10 0 0" HorizontalAlignment="Left" Text="Set Number separator"/>

                                                            <TextBox Grid.Row="2" Grid.Column="1" Name="NumberSeparator" Text="," />


                                                            <!-- Set the delay time of Pop-up-->
                                                            <TextBlock Margin="0 10 0 0" Grid.Row="3" TextWrapping="Wrap" >Number Group</TextBlock>

                                                            <TextBox Grid.Row="3" Grid.Column="1" Name="NumberGroup" Text="2 3 4" />



                                                        </Grid>
                                                        <Grid Grid.Row="2" Grid.ColumnSpan="2" x:Name="DropDownList" Visibility="{Binding ElementName=SpecialCellTypes, Path=SelectedItem, Converter={StaticResource visiblityConverter},ConverterParameter=DropDownList}">

                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="DropDownStyle" />
                                                            <ComboBox Grid.Column="1" />
                                                            <TextBlock Text="DisplayMember" Grid.Row="1" />
                                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DisplayMember,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                                                        </Grid>
                                                        <Grid ShowGridLines="False" x:Name="IntegerEdit" Grid.ColumnSpan="2" Grid.Row="2" Visibility="{Binding ElementName=SpecialCellTypes, Path=SelectedItem, Converter={StaticResource visiblityConverter},ConverterParameter=IntegerEdit}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />

                                                            </Grid.ColumnDefinitions>

                                                            <!-- Set the AutoCorrect duration -->
                                                            <TextBlock  Grid.Row="0"  HorizontalAlignment="Left" Text="Number Seperator "/>

                                                            <TextBox Grid.Row="0" Grid.Column="1" Name="NumSeperator" Text="," />


                                                            <!-- Set the delay time of Pop-up-->
                                                            <TextBlock   Grid.Row="1" >Group Number</TextBlock>

                                                            <TextBox Grid.Row="1" Grid.Column="1" Name="NoLimit" Text="2 3 4" />



                                                        </Grid>
                                                        <Grid ShowGridLines="False" Grid.Row="2" Grid.ColumnSpan="2" x:Name="PercentEdit" Visibility="{Binding ElementName=SpecialCellTypes, Path=SelectedItem, Converter={StaticResource visiblityConverter},ConverterParameter=PercentEdit}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />

                                                            </Grid.ColumnDefinitions>

                                                            <!-- Set decimal seperator -->
                                                            <TextBlock  Grid.Row="0" Margin="0 10 0 0" HorizontalAlignment="Left" Text="Percent Edit Mode"/>

                                                            <ComboBox Grid.Row="0" Grid.Column="1"  x:Name="PercentEditCombo" >
                                                            </ComboBox>

                                                            <TextBlock  Grid.Row="1" Text="Percent Separator"/>

                                                            <TextBox Grid.Row="1" Grid.Column="1" Name="PercentSeparator" Text="," />


                                                            <!-- Set the Number of decimal digits -->
                                                            <TextBlock  Grid.Row="2" Text="No of Percent Decimal Digits"/>

                                                            <TextBox Grid.Row="2" Grid.Column="1"  Name="NoOfPercentDigits" Text="2" />


                                                            <!-- Set the AutoCorrect duration -->
                                                            <TextBlock TextWrapping="Wrap" Grid.Row="3" Margin="0 10 0 0" HorizontalAlignment="Left" Text="Set Percent Symbol"/>

                                                            <TextBox Grid.Row="3" Grid.Column="1"   Name="PercentSymbol" Text="," />


                                                            <!-- Set the delay time of Pop-up-->
                                                            <TextBlock  Grid.Row="4" >Number Group</TextBlock>

                                                            <TextBox Grid.Row="4" Grid.Column="1"  Text="2 3 4" />



                                                        </Grid>

                                                        <Grid Grid.Row="2"  Grid.ColumnSpan="2" x:Name="UpDownEdit" Visibility="{Binding ElementName=SpecialCellTypes, Path=SelectedItem, Converter={StaticResource visiblityConverter},ConverterParameter=UpDownEdit}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />

                                                            </Grid.ColumnDefinitions>
                                                            <!-- Set the AutoCorrect duration -->
                                                            <TextBlock  Grid.Row="0"  Text="FocusedBackground"/>

                                                            <TextBox  Name="FocusedBackground" Text="{Binding FocusedBackground,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                                            <TextBlock  Grid.Row="1" >
                                    Maximum Value
                                                            </TextBlock>
                                                            <TextBox   Name="MaxValue" Text="{Binding MaxValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" />
                                                            <TextBlock   Grid.Row="2"  >Minimum value</TextBlock>
                                                            <TextBox Name="MinValue" Text="{Binding MinValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Grid.Row="2" Grid.Column="1" />
                                                            <TextBlock TextWrapping="Wrap" Grid.Row="3" >FocusedBorderBrush</TextBlock>
                                                            <TextBox   Name="FocusedBorderBrush" Text="{Binding FocusedBorderBrush, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Grid.Row="3" Grid.Column="1" />
                                                            <TextBlock  Grid.Row="4" >FocusedForeground</TextBlock>
                                                            <TextBox  Name="FocusedForeground" Text="{Binding FocusedForeground, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Grid.Row="4" Grid.Column="1"/>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Expander>
                                <Button x:Name="PART_CloseButton"  Click="PART_CloseButton_Click" Style="{x:Null}" Grid.Column="1"
                                                        BorderBrush="White"  
                                                        Background="#FFFC5F4B"   
                                                        Height="15" 
                                                        ToolTip="Close"                                                        
                                                        Width="15" 
                                                        HorizontalAlignment="Right" 
                                                        VerticalAlignment="Top"   
                                        Margin="5"
                                                        >
                                    <Grid Grid.Column="1">

                                        <Path x:Name="path1" Stroke="White" Stretch="Fill" Data="M100.33679,95.997467 L726.36096,557.77032" StrokeThickness="2">
                                        </Path>
                                        <Path x:Name="path" Stroke="White" Stretch="Fill" StrokeThickness="2"   Data="M13,461 L621,13">
                                        </Path>
                                    </Grid>
                                    <Button.Triggers>
                                        <EventTrigger RoutedEvent="Button.MouseEnter">
                                            <EventTrigger.Actions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" AutoReverse="True" Storyboard.TargetName="path" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)">
                                                            <LinearColorKeyFrame KeyTime="00:00:00" Value="#FFFC5F4B"></LinearColorKeyFrame>

                                                        </ColorAnimationUsingKeyFrames>
                                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" AutoReverse="True" Storyboard.TargetName="path1" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)">
                                                            <LinearColorKeyFrame KeyTime="00:00:00" Value="#FFFC5F4B"></LinearColorKeyFrame>
                                                        </ColorAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger.Actions>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Button.MouseLeave">
                                            <EventTrigger.Actions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" AutoReverse="True" Storyboard.TargetName="path" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)">
                                                            <LinearColorKeyFrame KeyTime="00:00:00" Value="White"></LinearColorKeyFrame>

                                                        </ColorAnimationUsingKeyFrames>
                                                        <ColorAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" AutoReverse="True" Storyboard.TargetName="path1" Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)">
                                                            <LinearColorKeyFrame KeyTime="00:00:00" Value="White"></LinearColorKeyFrame>
                                                        </ColorAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger.Actions>
                                        </EventTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <CheckBox Content="Generate Visible Columns" Visibility="Collapsed" Background="White" VerticalAlignment="Center"  HorizontalAlignment="Center" IsChecked="{Binding GenerateVisibleColumns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" FontSize="14"  x:Name="GVC"/>
        <ToggleButton x:Name="btnGeneratColumns" Grid.Row="0" Height="40"  FontFamily="Segoe UI" FontSize="14" Content="{Binding GenerateColumnsText, Mode=TwoWay}" Margin="7" Click="Button_Click"  IsEnabled="{Binding GenerateColumnsEnabled, Mode=TwoWay}" >

        </ToggleButton>
        <TextBlock  x:Name="InfoText" TextWrapping="Wrap" Width="180"  Text="{Binding InfoText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,NotifyOnSourceUpdated=True}" Grid.Column="1" Height="40"  VerticalAlignment="Center" Padding="10,0,0,0"/>
       
        <ListBox Grid.Row="1" x:Name="visibleColumnsListBox" Grid.ColumnSpan="2"  Visibility="{Binding VisibleColumnsListBox,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,NotifyOnSourceUpdated=True}" ItemsSource="{Binding VisibleColumnsModel,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,NotifyOnSourceUpdated=True}" BorderThickness="0" >
        </ListBox>
    </Grid>
</UserControl>
