    <Grid x:Name="LayoutRoot" DataContext="{Binding}" ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Border BorderThickness="1" Grid.Row="0" Grid.Column="0" BorderBrush="LightBlue">
            <StackPanel>
                <Border Margin="4" VerticalAlignment="Top" Height="50" Width="150" BorderBrush="SkyBlue" BorderThickness="0">
                    <Button Style="{DynamicResource ButtonStyle1}" Content="Basic Properties" Click="BasicPropertie_Click" />
                </Border>
                <Border Margin="4" VerticalAlignment="Top" Height="50" Width="150" BorderBrush="SkyBlue" BorderThickness="0">
                    <Button x:Name="VisibleColumn" Style="{DynamicResource ButtonStyle2}" Content="Visible Columns" Click="BasicPropertie_Click" FontFamily="Segoe UI" Height="50" VerticalAlignment="Top" FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer  Grid.Row="0" Grid.Column="1" x:Name="scrollViewer">
            <StackPanel>
                <local:VisibleColumn Visibility="Collapsed"  x:Name="VisibleColn">
                </local:VisibleColumn>
                <local:BasicProperties Visibility="Visible" x:Name="BasicProp">
                </local:BasicProperties>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>