<UserControl x:Class="Syncfusion.Grid.WPF.VisualStudio.Design.BasicProperties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf" 
             xmlns:local="clr-namespace:Syncfusion.Grid.WPF.VisualStudio.Design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
          
             d:DesignHeight="400" d:DesignWidth="400">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBox}" >
            <Style.Setters>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
            </Style.Setters>
        </Style>
        <Style TargetType="{x:Type TextBlock}" >
            <Style.Setters>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
            </Style.Setters>
        </Style>
        <Style TargetType="{x:Type ComboBox}" >
            <Style.Setters>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
            </Style.Setters>
        </Style>
        <Style  TargetType="{x:Type CheckBox}">
            
            <Style.Setters>
                <Setter Property="FontFamily" Value="Segoe UI"/>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="80*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="innerBorder" Margin="8,2,7,2 " Width="13" Height="13">
                                <Border.Background>
                                    <DrawingBrush>
                                        <DrawingBrush.Drawing>
                                            <DrawingGroup>
                                                <DrawingGroup.Children>
                                                    <GeometryDrawing Geometry="M2,2.0344564 L40,40.034456 M39.965481,2 L2.034519,40.068913">

                                                        <GeometryDrawing.Pen>
                                                            <Pen Thickness="15" LineJoin="Round">
                                                                <Pen.Brush>
                                                                    <LinearGradientBrush StartPoint="0.545017,0.0107753" EndPoint="0.545017,0.995331">
                                                                        <LinearGradientBrush.GradientStops>
                                                                            <GradientStop Color="#FF5F332B" Offset="0"/>
                                                                            <GradientStop Color="#FFF70F0F" Offset="0.2"/>
                                                                            <GradientStop Color="#FFF70303" Offset="0.6"/>
                                                                            <GradientStop Color="#FFD01313" Offset="0.8"/>
                                                                        </LinearGradientBrush.GradientStops>
                                                                    </LinearGradientBrush>
                                                                </Pen.Brush>
                                                            </Pen>
                                                        </GeometryDrawing.Pen>
                                                    </GeometryDrawing>
                                                </DrawingGroup.Children>
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>

                            </Border>
                            <ContentPresenter Grid.Column="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="innerBorder" Property="Background">
                                    <Setter.Value>
                                        <DrawingBrush>
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <DrawingGroup.Children>
                                                        <GeometryDrawing Geometry="M281,162 C294.09643,176.51227 282.01024,193.98464 304,161 311.53032,149.70451 313.918,142.541 327,136 311.96916,128.48458 306.14401,152.39199 292,163 287.63201,158.63201 288.1241,155 281,155 279.79675,158.00812 279,158.06773 279,162 279.66667,162 280.33333,162 281,162 z">
                                                            <GeometryDrawing.Brush>
                                                                <LinearGradientBrush EndPoint="0,0.5" StartPoint="1,0.5">
                                                                    <GradientStop Color="#FF464932" Offset="0"/>
                                                                    <GradientStop Color="#FF5DE442" Offset="0.167"/>
                                                                    <GradientStop Color="#FF34DF1E" Offset="0.333"/>
                                                                    <GradientStop Color="#FF39BD02" Offset="0.667"/>
                                                                </LinearGradientBrush>
                                                            </GeometryDrawing.Brush>
                                                        </GeometryDrawing>
                                                    </DrawingGroup.Children>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            </Style.Setters>
        </Style>
        <ObjectDataProvider MethodName="GetValues"
        ObjectType="{x:Type sys:Enum}"
        x:Key="GridSelectionModeValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:GridSelectionModeView" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider MethodName="GetValues"
        ObjectType="{x:Type sys:Enum}"
        x:Key="AllowSelectionValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:GridSelectionFlagsView" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider MethodName="GetValues"
        ObjectType="{x:Type sys:Enum}"
        x:Key="GridCellActivateActionValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:GridCellActivateActionView" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider MethodName="GetValues"
        ObjectType="{x:Type sys:Enum}"
        x:Key="VisualStyleValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:VisualStyleView" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider MethodName="GetValues"
        ObjectType="{x:Type sys:Enum}"
        x:Key="GridControlLengthUnitTypeValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:GridControlLengthUnitTypeView" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

       
        
    </UserControl.Resources>

    <StackPanel Background="White">
        <Expander Header="Column Properties" FontFamily="Segoe UI" FontSize="12.5" Expanded="Expander_Expanded" IsExpanded="True" Margin="4">
            <ListBox Margin="1" BorderThickness="0"  Background="White" Name="ColumnProperties" >
                <ListBoxItem Margin="2,4,2,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Column Sizer" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <ComboBox Width="150" Grid.Column="1"  Margin="10,0,0,0" ItemsSource="{Binding Source={StaticResource GridControlLengthUnitTypeValues}}" SelectedItem="{Binding Path=ColumnSizer}" />
                    </Grid>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="10,0,0,0" Text="Visual Style" VerticalAlignment="Center"/>
                        <ComboBox Width="150"  Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding Source={StaticResource VisualStyleValues}}" SelectedItem="{Binding Path=VisualStyle}"  >
                        </ComboBox>
                    </Grid>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding AutoPopulateColumns, Mode=TwoWay}">
                        <TextBlock Text="Auto Populate Columns"  />
                    </CheckBox>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding AutoPopulateRelations, Mode=TwoWay}" >
                        <TextBlock Text="Auto Populate Relations"/>
                    </CheckBox>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding AllowSort, Mode=TwoWay}">
                        <TextBlock Text="Allow Sort"/>
                    </CheckBox>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding AllowDragColumns, Mode=TwoWay}">
                        <TextBlock Text="Allow Drag Columns"/>
                    </CheckBox>
                </ListBoxItem>

                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding AllowResizeColumns, Mode=TwoWay}">
                        <TextBlock Text="Allow Resize Columns"/>
                    </CheckBox>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding ShowColumnOptions, Mode=TwoWay}">
                        <TextBlock Text="Show Column Options"/>
                    </CheckBox>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding ShowFilters, Mode=TwoWay}">
                        <TextBlock Text="Show Filters"/>
                    </CheckBox>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding ShowGroupDropArea, Mode=TwoWay}">
                        <TextBlock Text="Show Group Drop Area"/>
                    </CheckBox>
                </ListBoxItem>
            </ListBox>
        </Expander>
        <Expander Header="Row Properties" FontFamily="Segoe UI" FontSize="12.5" Expanded="Expander_Expanded" Margin="4">
            <ListBox x:Name="RowProperties" BorderThickness="0" >
                <ListBoxItem Margin="2,4,2,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="10,0,0,0" Text="ListBoxSelectionMode" VerticalAlignment="Center"/>
                        <ComboBox Width="150" Grid.Column="1"  Margin="10,0,0,0" ItemsSource="{Binding Source={StaticResource GridSelectionModeValues}}" SelectedItem="{Binding Path=ListBoxSelectionMode}" />
                    </Grid>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding ShowAddNewRow, Mode=TwoWay}">
                        <TextBlock Text="Show Add New Row"  />
                    </CheckBox>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding ShowGroupSummaries, Mode=TwoWay}">
                        <TextBlock Text="Show Group Summaries"/>
                    </CheckBox>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding ShowRowHeader, Mode=TwoWay}">
                        <TextBlock Text="Show Row Header"/>
                    </CheckBox>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding AllowResizeRows, Mode=TwoWay}">
                        <TextBlock Text="Allow Resize Rows"/>
                    </CheckBox>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding AllowDelete, Mode=TwoWay}">
                        <TextBlock Text="Allow Delete"/>
                    </CheckBox>
                </ListBoxItem>
            </ListBox>
        </Expander>
        <Expander Header="Cell Properties" FontFamily="Segoe UI" FontSize="12.5" Expanded="Expander_Expanded" Margin="4">
            <ListBox Name="CellProperties" BorderThickness="0" >
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox  IsChecked="{Binding AllowEdit, Mode=TwoWay}">
                        <TextBlock Text="Allow Edit"  />
                    </CheckBox>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding ShowErrorTooltips, Mode=TwoWay}">
                        <TextBlock Text="Show Error Tooltips"/>
                    </CheckBox>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <CheckBox IsChecked="{Binding ShowTooltips, Mode=TwoWay}">
                        <TextBlock Text="Show Tooltips"/>
                    </CheckBox>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="10,0,0,0" Text="Allow Selection" VerticalAlignment="Center"/>
                        <ComboBox Width="150"  Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding Source={StaticResource AllowSelectionValues}}" SelectedItem="{Binding Path=AllowSelection}"  >
                        </ComboBox>
                    </Grid>
                </ListBoxItem>
                <ListBoxItem Margin="2,4,2,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="10,0,0,0" Text="Activate Current Cell" VerticalAlignment="Center"/>
                        <ComboBox Width="150" Grid.Column="1"  Margin="10,0,0,0" ItemsSource="{Binding Source={StaticResource GridCellActivateActionValues}}" SelectedItem="{Binding Path=ActivateCurrentCellBehavior}"  >
                        </ComboBox>
                    </Grid>
                </ListBoxItem>
            </ListBox>
        </Expander>
    </StackPanel>
</UserControl>
