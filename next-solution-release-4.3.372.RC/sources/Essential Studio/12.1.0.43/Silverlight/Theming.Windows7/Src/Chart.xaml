<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Chart="clr-namespace:Syncfusion.Windows.Chart;assembly=Syncfusion.Chart.Silverlight">

    <!-- Brushes -->


    <LinearGradientBrush EndPoint="0.503,0.941" StartPoint="0.5,-0.061" x:Key="DefaultChartEffectsColor">
        <GradientStop Color="#E5FFFFFF" Offset="0.057"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,1.152" StartPoint="0.5,0" x:Key="DefaultChartAreaBackground">
        <GradientStop Color="#E5FFFFFF" Offset="0"/>
        <GradientStop Color="#D8F4F5FB" Offset="0.074432373046875"/>
        <GradientStop Color="#CCEAEDF7" Offset="0.217"/>
        <GradientStop Color="#00E2E5F4" Offset="0.236"/>
        <GradientStop Color="#00DCE0F2" Offset="0.996"/>
        <GradientStop Color="sc#1, 0.708375752, 0.7379104, 0.8879231" Offset="1"/>
        <GradientStop Color="#00DBDFF2" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.48" RadiusY="0.523" x:Key="DefaultChartBackground">
        <GradientStop Color="#FFDFECFF" Offset="0"/>
        <GradientStop Color="sc#1, 0.7193159, 0.8276188, 1" Offset="0.610443115234375"/>
        <GradientStop Color="sc#1, 0.6788888, 0.8033114, 1" Offset="0.7698894739151001"/>
        <GradientStop Color="sc#1, 0.625258267, 0.771065235, 1" Offset="0.87665826082229614"/>
        <GradientStop Color="sc#1, 0.5611191, 0.7325006, 1" Offset="0.95973926782608032"/>
        <GradientStop Color="sc#1, 0.520995557, 0.708375752, 1" Offset="1"/>
        <GradientStop Color="#FFBFDBFF" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush EndPoint="0.5,-0.04" StartPoint="0.5,0.051" x:Key="DefaultGridAreaBackground">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="sc#1, 0.7036201, 0.708942533, 0.7143452" Offset="0.78167599439620972"/>
        <GradientStop Color="#FFABADAF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush EndPoint="0.5,-0.676" StartPoint="0.5,0.427" x:Key="LegendBackgroundBrushKey" >
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="sc#1, 0.7036201, 0.708942533, 0.7143452" Offset="0.78167599439620972"/>
        <GradientStop Color="#FFABADAF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush Color="#6C7278" x:Key="Office2007Silver.ChartBorderBackground"/>


    <SolidColorBrush x:Key="Default.LegendForeground"
                   Color="#FF15428B"/>

    <SolidColorBrush x:Key="Default.LegendBorderBackground"
                   Color="#6C7278"/>

    <SolidColorBrush x:Key="Default.AreaBorderBackground"
                   Color="#FFA0BEE4"/>

    <SolidColorBrush x:Key="Default.AreaBackground"
                   Color="Transparent"/>
    <SolidColorBrush Color="#FFCCCDCE" x:Key="AxisPenBrushKey"/>

    <SolidColorBrush Color="#FF15428B" x:Key="ChartAreaForeground"/>
    
    <!-- Styles -->

    <Style TargetType="Chart:ChartArea" x:Key="Chart:ChartArea">
        <Setter Property="EffectsBrush" Value="{StaticResource DefaultChartEffectsColor}"/>
        <Setter Property="Background" Value="{StaticResource DefaultChartAreaBackground}"/>
        <Setter Property="BorderBrush" Value="#6C7278"/>
        <Setter Property="Foreground" Value="{StaticResource ChartAreaForeground}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="GridBackground" Value="White"/>
        <Setter Property="EnableChartAreaEffects" Value="True"/>

    </Style>
    <Style TargetType="Chart:ChartArea" BasedOn="{StaticResource Chart:ChartArea}"/>


    <Style TargetType="Chart:ChartSeries" x:Key="Chart:ChartSeries">
        <Setter Property="Stroke" Value="#8A53564F"/>
        <Setter Property="StrokeThickness" Value="1"/>

    </Style>
    <Style TargetType="Chart:ChartSeries" BasedOn="{StaticResource Chart:ChartSeries}"/>

    <Style TargetType="Chart:ChartAxis" x:Key="Chart:ChartAxis">
        <Setter Property="LineStroke" Value="{StaticResource AxisPenBrushKey}"/>
        <Setter Property="SmallTicksStroke" Value="{StaticResource AxisPenBrushKey}"/>
        <Setter Property="GridLineStroke" Value="{StaticResource AxisPenBrushKey}"/>
        <Setter Property="LabelForeground" Value="#FF15428B"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Chart:ChartAxis">
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Chart:ChartAxis" BasedOn="{StaticResource Chart:ChartAxis}"/>



    <Style TargetType="Chart:ChartLegend" x:Key="Chart:ChartLegend">
        <Setter Property="Background" Value="{StaticResource LegendBackgroundBrushKey}"/>
        <Setter Property="BorderBrush" Value="#FFA0BEE4"/>
        <Setter Property="Foreground" Value="#FF15428B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style TargetType="Chart:ChartLegend" BasedOn="{StaticResource Chart:ChartLegend}"/>



    <Style x:Key="Chart:Chart" TargetType="Chart:Chart">
        <Setter Property="Background" Value="{StaticResource DefaultChartBackground}"/>
        <Setter Property="CornerRadius" Value="10"/>

    </Style>
    <Style TargetType="Chart:Chart" BasedOn="{StaticResource Chart:Chart}"/>

</ResourceDictionary>
