<controls:ChildWindow x:Class="Syncfusion.UI.Xaml.Schedule.OpenRecurringAppointment"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                      xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls"
                      Title="OpenRecurringAppointment" Height="220" Width="300" Background="White" BorderThickness="0">

    <Grid x:Name="LayoutRoot" Margin="2">
        <StackPanel>
            <TextBlock Text="This is one appointment in a series. What do you want to open?" Height="50" Width="220" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI" FontWeight="Normal" Margin="20,20,0,0" />
            <RadioButton Content="Just this one" GroupName="Recurrence" Height="20" IsChecked="True" x:Name="One" FontSize="13" Width="110" HorizontalAlignment="Left" Margin="30,0,0,0"/>
            <RadioButton Content="The entire series" GroupName="Recurrence" Height="20"  x:Name="series" FontSize="13" Width="140" HorizontalAlignment="Left" Margin="30,10,0,0"/>
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenOne" Grid.Column="0" Background="White" Click="OpenOne_Click"  FontFamily="Segoe UI" FontSize="14" FontWeight="Normal" Margin="10,0,10,0" Height="25" Width="100" Content="OK"/>
                <Button x:Name="Series" Grid.Column="1" Background="White" Click="Series_Click"  FontFamily="Segoe UI" FontSize="14" FontWeight="Normal" Margin="10,0,10,0" Height="25" Width="100" Content="Cancel"/>
            </Grid>
        </StackPanel>
    </Grid>

</controls:ChildWindow>