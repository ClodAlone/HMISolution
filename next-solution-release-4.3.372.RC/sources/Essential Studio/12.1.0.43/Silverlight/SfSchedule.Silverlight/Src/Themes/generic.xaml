    <!-- Region Schedule -->
    <Style TargetType="local:SfSchedule">
        <Setter Property="Foreground" Value="#606060"/>
        <Setter Property="AppointmentToolTipTemplate" >
            <Setter.Value>
                <ControlTemplate >
                    <Border Height="160" Width="250" BorderBrush="Black" BorderThickness="1.5"  >
                        <Grid Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.5*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="10" Grid.Row="0" Background="{Binding AppointmentBackground}">
                                <Rectangle Height="50" Width="5" HorizontalAlignment="Left" Fill="{Binding Status.Brush}"/>
                                <TextBlock Text="{Binding Subject}" Height="30" Width="auto" Margin="30,10,0,0" Foreground="White" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="10,0,10,10" Grid.Row="1" >
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock  Grid.Column="0"  Text="Start"  VerticalAlignment="Bottom"/>
                                        <TextBlock  Grid.Column="1"  Text="{Binding StartTime}"  VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock  Grid.Column="0"  Text="End"  VerticalAlignment="Bottom"/>
                                        <TextBlock  Grid.Column="1"  Text="{Binding EndTime}"  VerticalAlignment="Bottom"/>
                                    </Grid>

                                </Grid>
                            </Grid>
                            <Grid Margin="10,0,10,10" Grid.Row="2" >
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Text="Location"  VerticalAlignment="Bottom"/>
                                        <TextBlock  Grid.Column="1"  Text="{Binding Location}"  VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Text="Reminder"  VerticalAlignment="Bottom"/>
                                        <TextBlock  Grid.Column="1"  Text="{Binding ReminderTime}"  VerticalAlignment="Bottom"/>
                                    </Grid>


                                </Grid>
                            </Grid>
                        </Grid>

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SfSchedule">
                    <Border x:Name="border" Background="{TemplateBinding Background}" >
                        <Grid>
                            <Grid x:Name="PART_MainItem">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.2*"/>
                                    <RowDefinition Height="8.8*"/>
                                </Grid.RowDefinitions>

                                <local:HeaderTitleBarView Name="PART_HeaderTitleBarView"
                                                          CurrentScheduleType="{Binding Path=ScheduleType, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" 
                                                          SelectedDates="{Binding Path=SelectedDates,RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>

                                <ContentControl x:Name="PART_MainViewItems" Grid.Row="1" HorizontalContentAlignment="Stretch" Background="Transparent" Margin="2" 
                                                Foreground="{TemplateBinding Foreground}"/>
                            </Grid>

                            <Canvas local:Clip.ToBounds="True"  x:Name="DragDropCanvas" Visibility="Visible" >
                                <!--<Canvas.Background>
                                    <SolidColorBrush Color="Gray" Opacity="0.2" />
                                </Canvas.Background>-->
                            </Canvas>
                            <Popup x:Name="contextmenupopup" />
                            <Popup x:Name="AddnewContextmenuPopup" />

                            <Popup x:Name="editpopup" />
                            <Popup x:Name="addnewpopup"/>

                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="PreviousNavigationButtonTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Height="30" Width="250" VerticalAlignment="Center" Tag="PreviousAppointment">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="-90" CenterX="125" CenterY="15"/>
                                <TranslateTransform X="-90"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Rectangle Fill="LightGray" Height="30" Width="250" />
                        <TextBlock Text="Previous Appointment" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="NextNavigationButtonTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Height="30" Width="250" VerticalAlignment="Center" Tag="NextAppointment">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="-90" CenterX="125" CenterY="15"/>
                                <TranslateTransform X="90"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Rectangle Fill="LightGray" Height="30" Width="250"/>
                        <TextBlock Text="Next Appointment" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="NonAccessibleBlockTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border Background="{Binding Background}">
                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   FontSize="18" FontFamily="Segoe UI" FontWeight="SemiLight" Margin="0 0 30 10"/>
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
		<Setter Property="CurrentTimeIndicatorTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Rectangle Fill="#FF1BA1E2"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- EndRegion -->

    <!-- Region HeaderTitleBarView -->
    <Style TargetType="local:HeaderTitleBarView">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:HeaderTitleBarView">
                    <Grid x:Name="Header_Grid" Visibility="{TemplateBinding Visibility}" Margin="10,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Name="PART_PrevButton" Style="{StaticResource prevButton}" VerticalAlignment="Center" />

                        <Button Name="PART_NextButton" Style="{StaticResource nextButton}" Grid.Column="1" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10 0"
                                   Text="{TemplateBinding HeaderText}" Foreground="{TemplateBinding Foreground}"
                                   FontWeight="ExtraLight" FontSize="30" FontFamily="Segoe UI"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
