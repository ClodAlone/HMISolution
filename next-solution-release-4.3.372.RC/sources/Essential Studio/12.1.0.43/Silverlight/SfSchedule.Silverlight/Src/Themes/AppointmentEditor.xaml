                                <CheckBox x:Name="friday" Content="{Binding Friday, Source={StaticResource ResourceWrapper}}" FontSize="12" FontFamily="Segoe UI" Width="90"  IsChecked="{Binding EditedAppointment.RecurrenceProperites.IsWeeklyFriday, Mode=OneWay}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="saturday" Content="{Binding Saturday, Source={StaticResource ResourceWrapper}}" Width="90" FontSize="12" FontFamily="Segoe UI" IsChecked="{Binding EditedAppointment.RecurrenceProperites.IsWeeklySaturday, Mode=OneWay}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="MonthlyStackPanel" VerticalAlignment="Center"
                                    Visibility="{Binding IsChecked, Converter={StaticResource BooltoVis}, ElementName=RecurrenceOptionMonthly, Mode=TwoWay}">
