                          IsEnabled="{Binding EditedAppointment.ReadOnly, Converter={StaticResource BooltoBool}}">
                </ComboBox>
            </Grid>
            <Grid Margin="10 4" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft">
