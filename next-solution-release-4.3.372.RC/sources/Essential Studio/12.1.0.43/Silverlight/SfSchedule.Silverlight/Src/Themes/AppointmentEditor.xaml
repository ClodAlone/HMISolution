                </ComboBox>
            </Grid>
            <Grid Margin="10 6" Height="23">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12" Text="{Binding Source={StaticResource ResourceWrapper}, Path= Status }" Height="20" FontFamily="Segoe UI" FontWeight="Normal"/>
                <ComboBox x:Name="Status" Grid.Column="1" Style="{StaticResource ComboBoxStyle}" Height="20" Width="130" FontFamily="Segoe UI" FontWeight="Normal" FontSize="12" HorizontalAlignment="Left"
