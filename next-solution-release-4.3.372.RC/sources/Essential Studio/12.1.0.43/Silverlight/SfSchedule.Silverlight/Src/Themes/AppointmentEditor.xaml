                              IsEnabled="{Binding IsChecked, ElementName=allDay, Mode=TwoWay,Converter={StaticResource BooltoBool}}"
                              SelectedItem="{Binding EndTimeZone, Mode=TwoWay}" Visibility="Collapsed"/>
