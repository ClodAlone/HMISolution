                                    <ComboBoxItem Content="28" />
                                    <ComboBoxItem Content="29" />
                                    <ComboBoxItem Content="30" />
                                    <ComboBoxItem Content="31" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="40">
                                <RadioButton x:Name="EveryMonth" GroupName="RecSubMontly" Content="{Binding The, Source={StaticResource ResourceWrapper}}" FontSize="12" FontFamily="Segoe UI"
