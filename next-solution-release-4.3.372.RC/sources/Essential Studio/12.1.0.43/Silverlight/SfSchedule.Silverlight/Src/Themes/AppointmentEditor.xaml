                                <ComboBox x:Name="Weekday" Style="{StaticResource ComboBoxStyle}" Height="25" Width="100" FontSize="12" FontFamily="Segoe UI" Margin="10 0" 
                                          SelectedIndex="{Binding EditedAppointment.RecurrenceProperites.MonthlyWeekDay, Mode=OneWay}">
                                    <ComboBoxItem Content="{Binding Sunday, Source={StaticResource ResourceWrapper}}"  />
                                    <ComboBoxItem Content="{Binding Monday, Source={StaticResource ResourceWrapper}}"  />
                                    <ComboBoxItem Content="{Binding Tuesday, Source={StaticResource ResourceWrapper}}"  />
                                    <ComboBoxItem Content="{Binding Wednesday, Source={StaticResource ResourceWrapper}}"  />
                                    <ComboBoxItem Content="{Binding Thursday, Source={StaticResource ResourceWrapper}}"  />
                                    <ComboBoxItem Content="{Binding Friday, Source={StaticResource ResourceWrapper}}"/>
                                    <ComboBoxItem Content="{Binding Saturday, Source={StaticResource ResourceWrapper}}"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="YearlyStackPanel" VerticalAlignment="Center"
                                    Visibility="{Binding IsChecked, Converter={StaticResource BooltoVis}, ElementName=RecurrenceOptionYearly, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Height="40">
                                <TextBlock Text="{Binding RecurEvery, Source={StaticResource ResourceWrapper}}" VerticalAlignment="Center" FontSize="12" FontFamily="Segoe UI" Foreground="Black"/>
                                <SyncTool:NumericUpDown MinValue="1" Height="30" x:Name="EveryYearGap" Width="50" Margin="10 0"
                                                        MaxValue="1000" Value="{Binding EditedAppointment.RecurrenceProperites.YearlyEveryNYears, Mode=OneWay}"
                                                        Interval="1" NumberDecimalDigits="0" FontFamily="Segoe UI" FontSize="12"/>
                                <TextBlock Text="{Binding Yearson, Source={StaticResource ResourceWrapper}}" Foreground="Black"
                                           Width="auto" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="40">
                                <RadioButton x:Name="SpecificDate" GroupName="RecSubYearly" Content="{Binding On, Source={StaticResource ResourceWrapper}}" FontSize="12" FontFamily="Segoe UI"
                                             Checked="EveryYear_Checked"
                                             IsChecked="{Binding EditedAppointment.RecurrenceProperites.IsYearlySpecific, Mode=OneWay}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="YrSpMonth" Style="{StaticResource ComboBoxStyle}" Height="25" Width="110" FontSize="12" FontFamily="Segoe UI" Margin="10 0" 
                                          SelectedIndex="{Binding EditedAppointment.RecurrenceProperites.YearlySpecificMonth, Mode=OneWay}">
                                    <ComboBoxItem Content="{Binding January, Source={StaticResource ResourceWrapper}}"  />
                                    <ComboBoxItem Content="{Binding February, Source={StaticResource ResourceWrapper}}"  />
                                    <ComboBoxItem Content="{Binding March, Source={StaticResource ResourceWrapper}}" />
                                    <ComboBoxItem Content="{Binding April, Source={StaticResource ResourceWrapper}}" />
