                                                        Interval="1" NumberDecimalDigits="0"/>
                                <TextBlock Text="{Binding Source={StaticResource ResourceWrapper}, Path= Days}" Foreground="Black" FontSize="12" FontFamily="Segoe UI"
                                           Width="auto" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid Height="40">
                                <RadioButton x:Name="EveryWeekDay" GroupName="RecSubDaily" Content="{Binding EveryWeekDays, Source={StaticResource ResourceWrapper}}"    
