                                         IsChecked="{Binding EditedAppointment.RecurrenceProperites.IsRangeEndDate, Mode=OneWay}"
                                         Foreground="{Binding AppointmentEditorForeground, RelativeSource={RelativeSource TemplatedParent}}"/>
