                                <TextBlock Text="{Binding RecurEvery, Source={StaticResource ResourceWrapper}}" FontSize="12" FontFamily="Segoe UI" Foreground="Black" VerticalAlignment="Center"/>
                                <SyncTool:NumericUpDown MinValue="1" Height="30" x:Name="EveryMonthGap" Width="50" Margin="10 0"
                                                        MaxValue="1000" Value="{Binding EditedAppointment.RecurrenceProperites.MonthlyEveryNMonths, Mode=OneWay}"
                                                        Interval="1" NumberDecimalDigits="0" FontSize="12" FontFamily="Segoe UI"/>
                                <TextBlock Text="{Binding Monthson, Source={StaticResource ResourceWrapper}}" Foreground="Black"
                                           Width="auto" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Height="40">
                                <RadioButton x:Name="EveryXMonths" GroupName="RecSubMontly" Content="{Binding Day, Source={StaticResource ResourceWrapper}}" FontSize="12" FontFamily="Segoe UI"
                                             Checked="EveryMonths_Checked"
                                             IsChecked="{Binding EditedAppointment.RecurrenceProperites.IsMonthlySpecific, Mode=OneWay}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="EveryMonthDay" Style="{StaticResource ComboBoxStyle}" Height="25" Width="40" FontSize="12" FontFamily="Segoe UI" Margin="10 0"
                                          SelectedIndex="{Binding EditedAppointment.RecurrenceProperites.MonthlySpecificMonthDay, Mode=OneWay}">
                                    <ComboBoxItem Content="1" />
