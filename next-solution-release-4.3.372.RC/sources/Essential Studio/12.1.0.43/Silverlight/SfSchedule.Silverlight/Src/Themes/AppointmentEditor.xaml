                            IsEnabled="{Binding EditedAppointment.ReadOnly, Converter={StaticResource BooltoBool}}"></Button>
                    <Button x:Name="Save" Style="{StaticResource ButtonStyle}" BorderBrush="#D0D0D0" Background="#E7E7E7" Click="Save_Click"
