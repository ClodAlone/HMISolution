            </Grid>
            <Grid Margin="10 5" Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox FontSize="12" x:Name="allDay" Content="{Binding Source={StaticResource ResourceWrapper}, Path=AllDay}" Grid.Column="1" FontFamily="Segoe UI" FontWeight="Normal" 
                          IsChecked="{Binding AllDay,  Mode=TwoWay}" IsEnabled="{Binding EditedAppointment.ReadOnly, Converter={StaticResource BooltoBool}}" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="10 5" Height="23">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12" Text="{Binding Source={StaticResource ResourceWrapper}, Path= Reminder }" Height="20" FontFamily="Segoe UI" FontWeight="Normal"/>
                <ComboBox x:Name="Reminder" Style="{StaticResource ComboBoxStyle}" Grid.Column="1" Height="20" Width="130" FontFamily="Segoe UI" FontWeight="Normal" FontSize="12" HorizontalAlignment="Left"
