                                    <ComboBoxItem Content="{Binding June, Source={StaticResource ResourceWrapper}}" />
                                    <ComboBoxItem Content="{Binding July, Source={StaticResource ResourceWrapper}}" />
                                    <ComboBoxItem Content="{Binding August, Source={StaticResource ResourceWrapper}}" />
                                    <ComboBoxItem Content="{Binding September, Source={StaticResource ResourceWrapper}}" />
                                    <ComboBoxItem Content="{Binding October, Source={StaticResource ResourceWrapper}}" />
