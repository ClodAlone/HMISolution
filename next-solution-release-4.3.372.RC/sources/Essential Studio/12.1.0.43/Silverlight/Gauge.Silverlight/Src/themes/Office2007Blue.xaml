<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gauge="clr-namespace:Syncfusion.Windows.Gauge;assembly=Syncfusion.Gauge.Silverlight">

    <!-- Brushes -->

    <RadialGradientBrush x:Key="Office2007BlueCircularGaugeBackgroundBrushKey" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#FFEBEDFF" Offset="0"/>
        <GradientStop Color="sc#1, 0.8178063, 0.8434511, 1" Offset="0.610443115234375"/>
        <GradientStop Color="sc#1, 0.7896216, 0.8360109, 1" Offset="0.7698894739151001"/>
        <GradientStop Color="sc#1, 0.7522317, 0.826140761, 1" Offset="0.87665826082229614"/>
        <GradientStop Color="sc#1, 0.707515538, 0.814336538, 1" Offset="0.95973926782608032"/>
        <GradientStop Color="sc#1, 0.6795425, 0.806952238, 1" Offset="1"/>
        <GradientStop Color="#FFD7E8FF" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="Office2007BlueCircularGaugeInnerFrameBrushKey" EndPoint="0.807,0.913" StartPoint="0.211,0.11">
        <GradientStop Color="#FFB1D2FF" Offset="0"/>
        <GradientStop Color="sc#1, 0.6039042, 0.753818452, 1" Offset="0.29984200000762939"/>
        <GradientStop Color="#FFE3EFFF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2007BlueCircularGaugeMiddleFrameBrushKey" Color="#FFF7F7F7"/>

    <LinearGradientBrush x:Key="Office2007BlueCircularGaugeOuterFrameBrushKey" EndPoint="0.761,0.925" StartPoint="0.242,0.079">
        <GradientStop Color="#FFE3EFFF" Offset="0"/>
        <GradientStop Color="sc#1, 0.6039042, 0.753818452, 1" Offset="0.70015799999237061"/>
        <GradientStop Color="#FFB1D2FF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2007BlueCircularPointerBackgroundBrushKey" Color="#FFE91726"/>
    <SolidColorBrush x:Key="Office2007BlueCircularPointerBorderBrushKey" Color="Black"/>
    <SolidColorBrush x:Key="Office2007BlueMarkTickSetTickBackgroundKey" Color="#FF375D81"/>
    <SolidColorBrush x:Key="Office2007BlueLabelTickSetLabelForegroundKey" Color="#FF375D81"/>

    <LinearGradientBrush x:Key="Office2007BlueLinearGaugeInnerFrameBrushKey" EndPoint="0.03,0.5" StartPoint="0.981,0.5">
        <GradientStop Color="#FFE3EFFF" Offset="0"/>
        <GradientStop Color="#FFB1D2FF" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="Office2007BlueLinearGaugeBackgroundBrushKey" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="1.125" RadiusY="0.372">
        <GradientStop Color="#FFEBEDFF" Offset="0"/>
        <GradientStop Color="sc#1, 0.8178063, 0.8434511, 1" Offset="0.610443115234375"/>
        <GradientStop Color="sc#1, 0.7896216, 0.8360109, 1" Offset="0.7698894739151001"/>
        <GradientStop Color="sc#1, 0.7522317, 0.826140761, 1" Offset="0.87665826082229614"/>
        <GradientStop Color="sc#1, 0.707515538, 0.814336538, 1" Offset="0.95973926782608032"/>
        <GradientStop Color="sc#1, 0.6795425, 0.806952238, 1" Offset="1"/>
        <GradientStop Color="#FFD7E8FF" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="Office2007BlueLinearGaugeOuterFrameBrushKey" EndPoint="1.056,0.5" StartPoint="0.036,0.5">
        <GradientStop Color="#FFE3EFFF" Offset="0"/>
        <GradientStop Color="sc#1, 0.6039042, 0.753818452, 1" Offset="0.70015799999237061"/>
        <GradientStop Color="#FFB1D2FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2007BlueLinearRangeBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFDFAFA" Offset="0"/>
        <GradientStop Color="#FFF90D0D" Offset="0.808"/>
        <GradientStop Color="#FEB9AFAF" Offset="0"/>
        <GradientStop Color="#FEF03939" Offset="0.558"/>
        <GradientStop Color="#FEE6A4A4" Offset="0.344"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2007BlueLinearBarPointerBackgroundBrushKey" Color="#FF2D09B1"/>
    <SolidColorBrush x:Key="Office2007BlueLinearMarkerPointerBackgroundBrushKey" Color="#FF2D09B1"/>

    <LinearGradientBrush x:Key="Office2007BlueDigitalGaugeInnerFrameBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE2EFFF" Offset="0"/>
        <GradientStop Color="#FFB1D2FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2007BlueDigitalGaugeBackgroundBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE2EFFF" Offset="0"/>
        <GradientStop Color="#FFB1D2FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2007BlueDigitalGaugeOuterFrameBrushKey" EndPoint="0.5,-0.056" StartPoint="0.5,0.964">
        <GradientStop Color="#FFE2EFFF" Offset="0"/>
        <GradientStop Color="sc#1, 0.600090861, 0.753818452, 1" Offset="0.70015799999237061"/>
        <GradientStop Color="#FFB1D2FF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2007BlueDigitalGaugeMiddleFrameBrushKey" Color="White"/>
    <SolidColorBrush x:Key="Office2007BlueDigitalGaugeSegmentBrushKey" Color="#FF15428B"/>

    <RadialGradientBrush  x:Key="Office2007BlueRollingGaugeSegmentBackgroundKey" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="1.125" RadiusY="0.372">
        <GradientStop Color="#FFEBEDFF" Offset="0"/>
        <GradientStop Color="sc#1, 0.8178063, 0.8434511, 1" Offset="0.610443115234375"/>
        <GradientStop Color="sc#1, 0.7896216, 0.8360109, 1" Offset="0.7698894739151001"/>
        <GradientStop Color="sc#1, 0.7522317, 0.826140761, 1" Offset="0.87665826082229614"/>
        <GradientStop Color="sc#1, 0.707515538, 0.814336538, 1" Offset="0.95973926782608032"/>
        <GradientStop Color="sc#1, 0.6795425, 0.806952238, 1" Offset="1"/>
        <GradientStop Color="#FFD7E8FF" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush  x:Key="Office2007BlueRollingGaugeBorderBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFB1D2FF" Offset="0"/>
        <GradientStop Color="#FFE2EFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush  x:Key="Office2007BlueRollingGaugeSegmentBorderBrushKey" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFE2EFFF" Offset="0"/>
        <GradientStop Color="#FFB1D2FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush  x:Key="Office2007BlueRollingGaugeBackgroundBrushKey" EndPoint="0.5,-0.056" StartPoint="0.5,0.964">
        <GradientStop Color="#FFE2EFFF" Offset="0"/>
        <GradientStop Color="sc#1, 0.600090861, 0.753818452, 1" Offset="0.70015799999237061"/>
        <GradientStop Color="#FFB1D2FF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush  x:Key="Office2007BlueRollingGaugeTextBrushKey" Color="#FF15428B" />

    <!-- Styles -->

    <Style x:Key="Office2007BlueCircularGaugeStyle" TargetType="gauge:CircularGauge">
        <Setter Property="Background" Value="{StaticResource Office2007BlueCircularGaugeBackgroundBrushKey}"/>
        <Setter Property="InnerFrameBrush" Value="{StaticResource Office2007BlueCircularGaugeInnerFrameBrushKey}"/>
        <Setter Property="MiddleFrameBrush" Value="{StaticResource Office2007BlueCircularGaugeMiddleFrameBrushKey}" />
        <Setter Property="OuterFrameBrush" Value="{StaticResource Office2007BlueCircularGaugeOuterFrameBrushKey}"/>
        <Setter Property="EnableEffects" Value="True"/>
        <Setter Property="OuterFrameOffset" Value="9"/>
        <Setter Property="InnerFrameOffset" Value="5"/>
        <Setter Property="MiddleFrameOffset" Value="1"/>
    </Style>
    <Style TargetType="gauge:CircularGauge" BasedOn="{StaticResource Office2007BlueCircularGaugeStyle}"/>

    <Style x:Key="Office2007BlueGaugeBorderStyle" TargetType="gauge:GaugeBorder">
    </Style>
    <Style TargetType="gauge:GaugeBorder" BasedOn="{StaticResource Office2007BlueGaugeBorderStyle}"/>

    <Style x:Key="Office2007BlueCircularScaleStyle" TargetType="gauge:CircularScale">
        <Setter Property="ScaleBarSize" Value="10"/>
    </Style>
    <Style TargetType="gauge:CircularScale" BasedOn="{StaticResource Office2007BlueCircularScaleStyle}"/>

    <Style x:Key="Office2007BlueCircularPointerStyle" TargetType="gauge:CircularPointer">
        <Setter Property="PointerNeedleType" Value="Needle"/>
        <Setter Property="NeedleStyle" Value="Needle"/>
        <Setter Property="MarkerStyle" Value="Diamond"/>
        <Setter Property="PointerPlacement" Value="Cross"/>
        <Setter Property="Background" Value="{StaticResource Office2007BlueCircularPointerBackgroundBrushKey}"/>
        <Setter Property="BorderThickness" Value="0.2"/>
        <Setter Property="PointerWidth" Value="7"/>
    </Style>
    <Style TargetType="gauge:CircularPointer" BasedOn="{StaticResource Office2007BlueCircularPointerStyle}"/>

    <Style x:Key="Office2007BluePointerCapStyle" TargetType="gauge:PointerCap">
        <Setter Property="PointerCapRadius" Value="7"/>
    </Style>
    <Style TargetType="gauge:PointerCap" BasedOn="{StaticResource Office2007BluePointerCapStyle}"/>

    <Style x:Key="Office2007BlueCircularKnobStyle" TargetType="gauge:CircularKnob">
    </Style>
    <Style TargetType="gauge:CircularKnob" BasedOn="{StaticResource Office2007BlueCircularKnobStyle}"/>

    <Style x:Key="Office2007BlueDigitalGaugeStyle" TargetType="gauge:DigitalGauge">
        <Setter Property="MiddleFrameBrush" Value="{StaticResource Office2007BlueDigitalGaugeMiddleFrameBrushKey}"/>
        <Setter Property="InnerFrameBrush" Value="{StaticResource Office2007BlueDigitalGaugeInnerFrameBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource Office2007BlueDigitalGaugeBackgroundBrushKey}"/>
        <Setter Property="OuterFrameBrush" Value="{StaticResource Office2007BlueDigitalGaugeOuterFrameBrushKey}"/>
        <Setter Property="OuterFrameOffset" Value="12"/>
        <Setter Property="InnerFrameOffset" Value="12"/>
        <Setter Property="MiddleFrameOffset" Value="2"/>
        <Setter Property="SegmentBrush" Value="{StaticResource Office2007BlueDigitalGaugeSegmentBrushKey}"/>
    </Style>
    <Style TargetType="gauge:DigitalGauge" BasedOn="{StaticResource Office2007BlueDigitalGaugeStyle}"/>

    <Style x:Key="Office2007BlueMarkTickSetStyle" TargetType="gauge:MarkTickSet">
        <Setter Property="Tag" Value="1"/>
        <Setter Property="TickBackground" Value="{StaticResource Office2007BlueMarkTickSetTickBackgroundKey}"/>
        <Setter Property="TickShape" Value="Rectangle"/>
        <Setter Property="Angle" Value="180"/>
        <Setter Property="TickHeight" Value="5"/>
        <Setter Property="TickWidth" Value="1"/>
        <Setter Property="TickPlacement" Value="Cross"/>
    </Style>
    <Style TargetType="gauge:MarkTickSet" BasedOn="{StaticResource Office2007BlueMarkTickSetStyle}"/>

    <Style x:Key="Office2007BlueLabelTickSetStyle" TargetType="gauge:LabelTickSet">
        <Setter Property="Tag" Value="1"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="LabelForeground" Value="#FF375D81"/>
        <Setter Property="TickPlacement" Value="Inside"/>
    </Style>
    <Style TargetType="gauge:LabelTickSet" BasedOn="{StaticResource Office2007BlueLabelTickSetStyle}"/>

    <Style x:Key="Office2007BlueCircularRangeStyle" TargetType="gauge:CircularRange">
        <Setter Property="StartWidth" Value="1"/>
        <Setter Property="EndWidth" Value="5"/>
    </Style>
    <Style TargetType="gauge:CircularRange" BasedOn="{StaticResource Office2007BlueCircularRangeStyle}"/>

    <Style x:Key="Office2007BlueGaugeLabelStyle" TargetType="gauge:GaugeLabel">
    </Style>
    <Style TargetType="gauge:GaugeLabel" BasedOn="{StaticResource Office2007BlueGaugeLabelStyle}"/>

    <Style x:Key="Office2007BlueGaugeImageStyle" TargetType="gauge:GaugeImage">
    </Style>
    <Style TargetType="gauge:GaugeImage" BasedOn="{StaticResource Office2007BlueGaugeImageStyle}"/>

    <Style x:Key="Office2007BlueStateIndicatorStyle" TargetType="gauge:StateIndicator">
        <Setter Property="IndicatorWidth" Value="10"/>
        <Setter Property="IndicatorHeight" Value="10"/>
        <Setter Property="Text" Value="Off"/>
        <Setter Property="ActiveText" Value="On"/>
    </Style>
    <Style TargetType="gauge:StateIndicator" BasedOn="{StaticResource Office2007BlueStateIndicatorStyle}"/>

    <Style x:Key="Office2007BlueLinearGaugeStyle" TargetType="gauge:LinearGauge">
        <Setter Property="InnerFrameBrush" Value="{StaticResource Office2007BlueLinearGaugeInnerFrameBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource Office2007BlueLinearGaugeBackgroundBrushKey}"/>
        <Setter Property="OuterFrameBrush" Value="{StaticResource Office2007BlueLinearGaugeOuterFrameBrushKey}"/>

        <Setter Property="MiddleFrameOffset" Value="1"/>
        <Setter Property="OuterFrameOffset" Value="15"/>
        <Setter Property="InnerFrameOffset" Value="12"/>
        <Setter Property="RadiusX" Value="15"/>
        <Setter Property="RadiusY" Value="15"/>
    </Style>
    <Style TargetType="gauge:LinearGauge" BasedOn="{StaticResource Office2007BlueLinearGaugeStyle}"/>

    <Style x:Key="Office2007BlueLinearScaleStyle" TargetType="gauge:LinearScale">

        <Setter Property="Offset" Value="2"/>
        <Setter Property="RadiusX" Value="5"/>
        <Setter Property="RadiusY" Value="10"/>
    </Style>
    <Style TargetType="gauge:LinearScale" BasedOn="{StaticResource Office2007BlueLinearScaleStyle}"/>

    <Style x:Key="Office2007BlueLinearRangeStyle" TargetType="gauge:LinearRange">
        <Setter Property="StartWidth" Value="1"/>
        <Setter Property="EndWidth" Value="5"/>
        <Setter Property="Background" Value="{StaticResource Office2007BlueLinearRangeBackgroundBrushKey}"/>
    </Style>
    <Style TargetType="gauge:LinearRange" BasedOn="{StaticResource Office2007BlueLinearRangeStyle}"/>

    <Style x:Key="Office2007BlueLinearBarPointerStyle" TargetType="gauge:LinearBarPointer">
        <Setter Property="PointerWidth" Value="5"/>
        <Setter Property="Background" Value="{StaticResource Office2007BlueLinearBarPointerBackgroundBrushKey}"/>
    </Style>
    <Style TargetType="gauge:LinearBarPointer" BasedOn="{StaticResource Office2007BlueLinearBarPointerStyle}"/>

    <Style x:Key="Office2007BlueLinearMarkerPointerStyle" TargetType="gauge:LinearMarkerPointer">
        <Setter Property="PointerWidth" Value="5"/>
        <Setter Property="PointerLength" Value="5" />
        <Setter Property="MarkerStyle" Value="Diamond"/>
        <Setter Property="PointerPlacement" Value="Cross" />
        <Setter Property="Background" Value="{StaticResource Office2007BlueLinearMarkerPointerBackgroundBrushKey}" />
    </Style>
    <Style TargetType="gauge:LinearMarkerPointer" BasedOn="{StaticResource Office2007BlueLinearMarkerPointerStyle}"/>

    <Style x:Key="Office2007BlueRollingGaugeStyle" TargetType="gauge:RollingGauge">
        <Setter Property="BorderBrush" Value="{StaticResource Office2007BlueRollingGaugeBorderBrushKey}"/>
        <Setter Property="Background" Value="{StaticResource Office2007BlueRollingGaugeBackgroundBrushKey}"/>
        <Setter Property="SegmentBackground" Value="{StaticResource Office2007BlueRollingGaugeSegmentBackgroundKey}"/>
        <Setter Property="Foreground" Value="{StaticResource Office2007BlueRollingGaugeTextBrushKey}"/>
        <Setter Property="SegmentBorderBrush" Value="{StaticResource Office2007BlueRollingGaugeSegmentBorderBrushKey}"/>
    </Style>
    <Style TargetType="gauge:RollingGauge" BasedOn="{StaticResource Office2007BlueRollingGaugeStyle}"/>

    <Style x:Key="Office2007BlueRollingCharacterStyle" TargetType="gauge:RollingCharacter">
    </Style>
    <Style TargetType="gauge:RollingCharacter" BasedOn="{StaticResource Office2007BlueRollingCharacterStyle}"/>



</ResourceDictionary>
