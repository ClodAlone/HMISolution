<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gauge="clr-namespace:Syncfusion.Windows.Gauge;assembly=Syncfusion.Gauge.Silverlight">
    <!-- Brushes -->

    <!-- Circular Gauge Brushes -->

    <SolidColorBrush x:Key="MetroCircularGaugeBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MetroCircularGaugeInnerFrameBackground" Color="#FF85C9E5"/>
    <SolidColorBrush x:Key="MetroCircularGaugeOuterFrameBackground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroCircularGaugeMiddleFrameBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MetroCircularPointerBackground" Color="#FF119EDA"/>
