    <SolidColorBrush x:Key="MetroPointerCapInnerCapBackground" Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="MetroPointerCapOuterCapBackground" Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="MetroMarkTickSetBackground" Color="#FF787878"/>
    <SolidColorBrush x:Key="MetroMarkLabelTickSetForeground" Color="#FF333333"/>
    <SolidColorBrush x:Key="MetroCircularLabelBackground" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="MetroStateIndicatorBackground" Color="#FF61A301"/>
    <SolidColorBrush x:Key="MetroStateIndicatorActiveBackground" Color="#FFD61E3F"/>

    <!-- Linear Gauge Brushes -->
    <SolidColorBrush x:Key="MetroLinearGaugeBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MetroLinearGaugeInnerFrameBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MetroLinearGaugeOuterFrameBackground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroLinearGaugeMiddleFrameBackground" Color="#FF85C9E5"/>
    <SolidColorBrush x:Key="MetroLinearScaleBorderBrush" Color="#FF787878"/>
    <SolidColorBrush x:Key="MetroLinearScaleBackground" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="MetroLinearRangeBackground" Color="#FFD61E3F"/>
    <SolidColorBrush x:Key="MetroLinearMarkerPointerBackground" Color="#FF119EDA"/>
    <LinearGradientBrush x:Key="MetroLinearBarPointerBackground" StartPoint="0.951728,0.5" EndPoint="0.174809,0.5">
        <GradientStop Color="#FF96D3ED" Offset="0"/>
        <GradientStop Color="#FF119EDA" Offset="0.362"/>
    </LinearGradientBrush>

    <!-- Digital Gauge Brushes -->

    <SolidColorBrush x:Key="MetroDigitalGaugeOuterFrameBackground" Color="#FF119EDA"/>
    <SolidColorBrush x:Key="MetroDigitalGaugeMiddleFrameBackground" Color="#FF96D3ED"/>
    <SolidColorBrush x:Key="MetroDigitalGaugeInnerFrameBackground" Color="#FF96D3ED"/>
    <SolidColorBrush x:Key="MetroDigitalGaugeBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MetroDigitalGaugeSegmentBrush" Color="#FF333333"/>

    <!-- Rolling Gauge Brushes -->
    <SolidColorBrush x:Key="MetroRollingGaugeBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MetroRollingGaugeBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="MetroRollingGaugeSegmentBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MetroRollingGaugeSegmentBorderBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="MetroRollingGaugeSegmentForeground" Color="#FF119EDA"/>

    <!-- Styles -->

    <Style x:Key="MetroCircularGaugeStyle" TargetType="gauge:CircularGauge">
        <Setter Property="Background" Value="{StaticResource MetroCircularGaugeBackground}"/>
        <Setter Property="InnerFrameBrush" Value="{StaticResource MetroCircularGaugeInnerFrameBackground}"/>
        <Setter Property="MiddleFrameBrush" Value="{StaticResource MetroCircularGaugeMiddleFrameBackground}" />
        <Setter Property="OuterFrameBrush" Value="{StaticResource MetroCircularGaugeOuterFrameBackground}"/>
        <Setter Property="EnableEffects" Value="True"/>
        <Setter Property="OuterFrameOffset" Value="9"/>
        <Setter Property="InnerFrameOffset" Value="5"/>
        <Setter Property="MiddleFrameOffset" Value="1"/>
