                            <ContentPresenter x:Name="PART_DigitalDisplay" Content="{TemplateBinding DigitalValue}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}"/>
