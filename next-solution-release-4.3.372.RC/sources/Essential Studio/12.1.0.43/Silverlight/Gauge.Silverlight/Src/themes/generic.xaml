    <Style x:Key="local:GaugeBorder" TargetType="local:GaugeBorder">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GaugeBorder">
                    <local:GaugeElementPanel BorderWidth="{TemplateBinding BorderThickness}">
                        <Path x:Name="Path" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" />                        
