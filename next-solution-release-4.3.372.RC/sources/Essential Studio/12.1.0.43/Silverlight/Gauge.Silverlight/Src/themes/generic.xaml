                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:GaugeBorder" BasedOn="{StaticResource local:GaugeBorder}"/>
    
    <Style x:Key="local:CircularScale" TargetType="local:CircularScale">
        <Setter Property="Background" Value="{StaticResource CircularScaleBackgroundBrushKey}"/>
        <Setter Property="ScaleBarSize" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CircularScale">
                    <local:ScalesLayoutPanel x:Name="PART_ScalesPanel" BorderWidth="{TemplateBinding BorderThickness}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Path x:Name="PART_PathEllipse" Fill="{TemplateBinding Background}"
                              Stroke="{TemplateBinding BorderBrush}"/>
                    </local:ScalesLayoutPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:CircularScale" BasedOn="{StaticResource local:CircularScale}"/>
    
    <Style x:Key="local:CircularPointer" TargetType="local:CircularPointer">
        <Setter Property="PointerNeedleType" Value="Needle"/>
        <Setter Property="NeedleStyle" Value="Needle"/>
        <Setter Property="MarkerStyle" Value="Diamond"/>
        <Setter Property="PointerPlacement" Value="Cross"/>
        <Setter Property="Background" Value="{StaticResource CircularPointerBackgroundBrushKey}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CircularPointerBorderBrushKey}"/>
        <Setter Property="BorderThickness" Value="0.2"/>
        <Setter Property="PointerWidth" Value="7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CircularPointer">
                    <local:GaugeElementPanel BorderWidth="{TemplateBinding BorderThickness}">
                        <Path x:Name="PART_PointerPath" Fill="{TemplateBinding Background}"
                              Stroke="{TemplateBinding BorderBrush}"/>
                    </local:GaugeElementPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:CircularPointer" BasedOn="{StaticResource local:CircularPointer}"/>

    <Style x:Key="local:PointerCap" TargetType="local:PointerCap">
        <Setter Property="Background" Value="{StaticResource PointerCapBackgroundBrushKey}"/>
        <Setter Property="InnerCapBrush" Value="{StaticResource PointerCapInnerCapBrushKey}"/>
        <Setter Property="OuterCapBrush" Value="{StaticResource PointerCapOuterCapBrushKey}"/>
        <Setter Property="PointerCapRadius" Value="7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PointerCap">
                    <local:GaugeElementPanel BorderWidth="{TemplateBinding BorderThickness}">
                        <Path Name="PointerCapPathShadow">
                        </Path>
                        <Path Name="PointerCapFirstPath" Fill="{TemplateBinding OuterCapBrush}"/>
                        <Path Name="PointerCapSecondPath" Fill="{TemplateBinding InnerCapBrush}"/>
                        <Path Name="PointerCapPath" Fill="{TemplateBinding Background}"
                              Stroke="{TemplateBinding BorderBrush}">                            
                        </Path>                      
                    </local:GaugeElementPanel>                       
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:PointerCap" BasedOn="{StaticResource local:PointerCap}"/>
    
    <Style x:Key="local:CircularKnob" TargetType="local:CircularKnob">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CircularKnob">
                        <Grid  x:Name="GridKnob" RenderTransformOrigin=".5,.5" >
                        <Grid.RenderTransform>
                            <TransformGroup>
                              <RotateTransform x:Name="KnobAngle" Angle="0"/>
                            </TransformGroup>
                         </Grid.RenderTransform>
                        <Ellipse RenderTransformOrigin="0.5,0.5" Stroke="#FF000000" Name="KnobEllipse"/>
                  </Grid>
               </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:CircularKnob" BasedOn="{StaticResource local:CircularKnob}"/>

