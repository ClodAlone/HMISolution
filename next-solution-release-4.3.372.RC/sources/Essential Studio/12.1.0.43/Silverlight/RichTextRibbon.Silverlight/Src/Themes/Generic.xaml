											   HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
											   Margin="2,0,4,0">
								</ItemsControl>
							</StackPanel>
						</Border>
						<ribbon:RibbonDropDown x:Name="PART_DropDown" BorderThickness="0" Content="{TemplateBinding Content}">
						</ribbon:RibbonDropDown>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
