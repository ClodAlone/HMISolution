										<ribbon:Ribbon.ScreenTip>
                                            <ribbon:ScreenTip Description="Bullets" Width="250"  HorizontalContentAlignment="Left" Content="Make the Bulletted paragraph."/>
										</ribbon:Ribbon.ScreenTip>
									</ribbon:RibbonButton>
									<ribbon:RibbonButton SizeMode="Small" IsCheckable="True" Label="Numbering" IsChecked="{Binding Path=CurrentParagraphStyle.ListType, Converter={StaticResource ListTypeToChecked}, ConverterParameter=Numbered, Mode=TwoWay}" Command="{Binding ChangeListTypeCommand}" CommandParameter="Numbered" SmallIcon="{StaticResource NumberingIcon}">
										<ribbon:Ribbon.ScreenTip>
                                            <ribbon:ScreenTip Description="Numbering" Width="250"  HorizontalContentAlignment="Left" Content="Make the Numbered paragraph."/>
										</ribbon:Ribbon.ScreenTip>
									</ribbon:RibbonButton>
								</ribbon:ButtonPanel>
                                <ribbon:ButtonPanel Margin="6,4" Height="23">
									<ribbon:RibbonButton SizeMode="Small" Label="DecreaseIndent" Command="{Binding LeftIndentCommand}" CommandParameter="false" SmallIcon="{StaticResource DecreaseIndentIcon}">
										<ribbon:Ribbon.ScreenTip>
                                            <ribbon:ScreenTip Description="Decrease Indent" Width="250"  HorizontalContentAlignment="Left" Content="Decrease the indent level of the paragraph."/>
										</ribbon:Ribbon.ScreenTip>
									</ribbon:RibbonButton>
									<ribbon:RibbonButton SizeMode="Small"  Label="IncreaseIndent" Command="{Binding LeftIndentCommand}" CommandParameter="true" SmallIcon="{StaticResource IncreaseIndentIcon}">
										<ribbon:Ribbon.ScreenTip>
                                            <ribbon:ScreenTip Description="Increase Indent" Width="250"  HorizontalContentAlignment="Left" Content="Increase the indent level of the paragraph."/>
										</ribbon:Ribbon.ScreenTip>
									</ribbon:RibbonButton>
								</ribbon:ButtonPanel>
                                <ribbon:ButtonPanel Margin="6,4" Height="23" SeparatorVisibility="Collapsed">
									<ribbon:RibbonDropDownButton Height="23" SizeMode="Small" SmallIcon="{StaticResource LineSpacingIcon}">
										<ribbon:Ribbon.ScreenTip>
                                            <ribbon:ScreenTip Description="Line and Paragraph Spacing" Width="250" Content="Change the spacing between lines of the text."/>
										</ribbon:Ribbon.ScreenTip>
										<ribbon:RibbonMenuGroup IconBarEnabled="True">
                                            <ribbon:RibbonMenuItem Header="1.0" IsCheckable="True" IsChecked="{Binding Path=CurrentParagraphStyle.LineSpacing, Converter={StaticResource LineSpacingToChecked}, ConverterParameter=1.0, Mode=TwoWay}" Command="{Binding LineSpacingCommand}" CommandParameter="1.0"/>
                                            <ribbon:RibbonMenuItem Header="1.15" IsCheckable="True" IsChecked="{Binding Path=CurrentParagraphStyle.LineSpacing, Converter={StaticResource LineSpacingToChecked}, ConverterParameter=1.15, Mode=TwoWay}" Command="{Binding LineSpacingCommand}" CommandParameter="1.15"/>
                                            <ribbon:RibbonMenuItem Header="1.5" IsCheckable="True" IsChecked="{Binding Path=CurrentParagraphStyle.LineSpacing, Converter={StaticResource LineSpacingToChecked}, ConverterParameter=1.5, Mode=TwoWay}" Command="{Binding LineSpacingCommand}" CommandParameter="1.5"/>
                                            <ribbon:RibbonMenuItem Header="2" IsCheckable="True" IsChecked="{Binding Path=CurrentParagraphStyle.LineSpacing, Converter={StaticResource LineSpacingToChecked}, ConverterParameter=2.0, Mode=TwoWay}" Command="{Binding LineSpacingCommand}" CommandParameter="2"/>
                                            <ribbon:RibbonMenuItem Header="2.5" IsCheckable="True" IsChecked="{Binding Path=CurrentParagraphStyle.LineSpacing, Converter={StaticResource LineSpacingToChecked}, ConverterParameter=2.5, Mode=TwoWay}" Command="{Binding LineSpacingCommand}" CommandParameter="2.5"/>
                                            <ribbon:RibbonMenuItem Header="3.0" IsCheckable="True" IsChecked="{Binding Path=CurrentParagraphStyle.LineSpacing, Converter={StaticResource LineSpacingToChecked}, ConverterParameter=3.0, Mode=TwoWay}"  Command="{Binding LineSpacingCommand}" CommandParameter="3.0"/>
										</ribbon:RibbonMenuGroup>
									</ribbon:RibbonDropDownButton>
								</ribbon:ButtonPanel>
                                <ribbon:ButtonPanel Margin="6,3" Height="25" SeparatorVisibility="Collapsed">
									<ribbon:RibbonButton SizeMode="Small" IsCheckable="True" Label="Left" IsChecked="{Binding Path=CurrentParagraphStyle.TextAlignment, Converter={StaticResource TextAlignmentToChecked}, ConverterParameter=Left, Mode=TwoWay}" Command="{Binding TextAlignmentCommand}" CommandParameter="Left" SmallIcon="{StaticResource AlignLeftIcon}">\
										<ribbon:Ribbon.ScreenTip>
                                            <ribbon:ScreenTip Description="Align Text Left" Width="250" HorizontalContentAlignment="Left" Content="Align text to left."/>
										</ribbon:Ribbon.ScreenTip>
									</ribbon:RibbonButton>
									<ribbon:RibbonButton SizeMode="Small" IsCheckable="True" Label="Center" IsChecked="{Binding Path=CurrentParagraphStyle.TextAlignment, Converter={StaticResource TextAlignmentToChecked}, ConverterParameter=Center, Mode=TwoWay}" Command="{Binding TextAlignmentCommand}" CommandParameter="Center" SmallIcon="{StaticResource AlignCenterIcon}">
										<ribbon:Ribbon.ScreenTip>
                                            <ribbon:ScreenTip Description="Center" Width="250" HorizontalContentAlignment="Left" Content="Center text."/>
										</ribbon:Ribbon.ScreenTip>
									</ribbon:RibbonButton>
									<ribbon:RibbonButton SizeMode="Small" IsCheckable="True" Label="Right" IsChecked="{Binding Path=CurrentParagraphStyle.TextAlignment, Converter={StaticResource TextAlignmentToChecked}, ConverterParameter=Right, Mode=TwoWay}" Command="{Binding TextAlignmentCommand}" CommandParameter="Right" SmallIcon="{StaticResource AlignRightIcon}">
										<ribbon:Ribbon.ScreenTip>
                                            <ribbon:ScreenTip Description="Align Text Right" Width="250" HorizontalContentAlignment="Left" Content="Align Text to the right."/>
										</ribbon:Ribbon.ScreenTip>
									</ribbon:RibbonButton>
									<ribbon:RibbonButton SizeMode="Small" IsCheckable="True" Label="Justify" IsChecked="{Binding Path=CurrentParagraphStyle.TextAlignment, Converter={StaticResource TextAlignmentToChecked}, ConverterParameter=Justify, Mode=TwoWay}" Command="{Binding TextAlignmentCommand}" CommandParameter="Justify" SmallIcon="{StaticResource AlignJusifyIcon}">
										<ribbon:Ribbon.ScreenTip>
                                            <ribbon:ScreenTip Description="Justify" Width="250"  HorizontalContentAlignment="Left" Content="Align text to both the left and right Margins, adding extra space between words as necessary."/>
										</ribbon:Ribbon.ScreenTip>
									</ribbon:RibbonButton>
								</ribbon:ButtonPanel>
								
							</ribbon:RibbonBar>
							<ribbon:RibbonBar Header="Edit" IsLauncherButtonVisible="False">
								<ribbon:RibbonButton Margin="2" Label="ReadOnly" Width="60" x:Name="PART_DisableEdit" IsCheckable="True" SizeMode="Large" LargeIcon="{StaticResource DisableEditingIcon}">
									<ribbon:Ribbon.ScreenTip>
                                        <ribbon:ScreenTip Description="Restrict Editing" Width="250"  HorizontalContentAlignment="Left" Content="It disables the editing."/>
									</ribbon:Ribbon.ScreenTip>
								</ribbon:RibbonButton>
							</ribbon:RibbonBar>
						</ribbon:RibbonTab>
						<ribbon:RibbonTab Caption="Insert">
							<ribbon:RibbonBar Header="Tables" IsLauncherButtonVisible="False">
								<ribbon:RibbonDropDownButton Margin="3" Width="50" SizeMode="Large" HorizontalAlignment="Center" LargeIcon="{StaticResource TableIcon}" Label="Table">
									<ribbon:Ribbon.ScreenTip>
                                        <ribbon:ScreenTip Description="Table" Width="250"  HorizontalContentAlignment="Left" Content="Insert a table into Document."/>
									</ribbon:Ribbon.ScreenTip>
									<StackPanel>
										<ribbon:TablePickerUI CellCount="10 8" Margin="3" x:Name="PART_TablePicker" Command="{Binding InsertTableCommand}"/>
                                        <ribbon:RibbonButton Label="Insert Table" SizeMode="Normal" SmallIcon="{StaticResource InsertTableIcon}" x:Name="PART_InsertTable" Margin="3" Command="{Binding InsertTableDialogCommand}"/>
                                    </StackPanel>
								</ribbon:RibbonDropDownButton>
							</ribbon:RibbonBar>
							<ribbon:RibbonBar IsLauncherButtonVisible="False" Header="Illustrations">
								<ribbon:RibbonButton SizeMode="Large" Margin="3" Width="60" HorizontalAlignment="Center" Label="Picture" Command="{Binding InsertPictureCommand}" LargeIcon="{StaticResource PictureIcon}">
									<ribbon:Ribbon.ScreenTip>
                                        <ribbon:ScreenTip Description="Insert Picture" Width="250"  HorizontalContentAlignment="Left" Content="Insert a picture from a file."/>
									</ribbon:Ribbon.ScreenTip>
								</ribbon:RibbonButton>
								<ribbon:RibbonButton SizeMode="Large" Margin="3" Width="70" HorizontalAlignment="Center" Label="Hyperlink" LargeIcon="{StaticResource HyperlinkIcon}" Command="{Binding HyperlinkDialogCommand}">
									<ribbon:Ribbon.ScreenTip>
                                        <ribbon:ScreenTip Description="Insert Hyperlink" Width="250"  HorizontalContentAlignment="Left" Content="Create a link to a WebPage."/>
									</ribbon:Ribbon.ScreenTip>
								</ribbon:RibbonButton>
							</ribbon:RibbonBar>
						</ribbon:RibbonTab>
						<ribbon:RibbonTab Caption="Table">
							<ribbon:RibbonBar Header="Table" IsLauncherButtonVisible="False">
								<ribbon:RibbonDropDownButton SizeMode="Large" Label="Select" Width="55" Margin="3" HorizontalAlignment="Center" LargeIcon="{StaticResource SelectIcon}">
                                    <ribbon:RibbonDropDownButton.Resources>
                                        <Style TargetType="Image">
                                            <Setter Property="Height" Value="13"/>
                                            <Setter Property="Height" Value="13"/>
                                            <Setter Property="Margin" Value="0,0,0,3"/>
                                        </Style>
                                    </ribbon:RibbonDropDownButton.Resources>
                                    <ribbon:Ribbon.ScreenTip>
                                        <ribbon:ScreenTip Description="Select" Width="250"  HorizontalContentAlignment="Left" Content="Select the current cell,row,column or entire Table."/>
									</ribbon:Ribbon.ScreenTip>
									<ribbon:RibbonMenuGroup IconBarEnabled="True">
										<ribbon:RibbonMenuItem Margin="3" Header="Select Cell" Command="{Binding SelectCellCommand}">
											<ribbon:RibbonMenuItem.Icon>
												<Image Source="{StaticResource SelectCellIcon}" Height="13" Width="13"/>
											</ribbon:RibbonMenuItem.Icon>
										</ribbon:RibbonMenuItem>
										<ribbon:RibbonMenuItem Margin="3" Header="Select Column" Command="{Binding SelectColumnCommand}" >
											<ribbon:RibbonMenuItem.Icon>
                                                <Image Source="{StaticResource SelectColumnIcon}" Height="13" Width="13"/>
											</ribbon:RibbonMenuItem.Icon>
										</ribbon:RibbonMenuItem>
										<ribbon:RibbonMenuItem Margin="3" Header="Select Row" Command="{Binding SelectRowCommand}">
											<ribbon:RibbonMenuItem.Icon>
                                                <Image Source="{StaticResource SelectRowIcon}" Height="13" Width="13" />
											</ribbon:RibbonMenuItem.Icon>
										</ribbon:RibbonMenuItem>
										<ribbon:RibbonMenuItem Margin="3" Header="Select Table" Command="{Binding SelectTableCommand}">
											<ribbon:RibbonMenuItem.Icon>
                                                <Image Source="{StaticResource SelectTableIcon}" Height="13" Width="13"/>
											</ribbon:RibbonMenuItem.Icon>
										</ribbon:RibbonMenuItem>
									</ribbon:RibbonMenuGroup>
								</ribbon:RibbonDropDownButton>
							</ribbon:RibbonBar>
							<ribbon:RibbonBar Header="Rows and Columns" IsLauncherButtonVisible="False">
								<ribbon:RibbonDropDownButton SizeMode="Large" x:Name="DeleteBtn" Label="Delete" Width="55" HorizontalAlignment="Center" Margin="5,0,5,0" LargeIcon="{StaticResource DeleteIcon}">
                                    <ribbon:RibbonDropDownButton.Resources>
                                        <Style TargetType="Image">
                                            <Setter Property="Height" Value="13"/>
                                            <Setter Property="Height" Value="13"/>
                                            <Setter Property="Margin" Value="0,0,0,3"/>
                                        </Style>
                                    </ribbon:RibbonDropDownButton.Resources>
									<ribbon:Ribbon.ScreenTip>
                                        <ribbon:ScreenTip Description="Delete" Width="250"  HorizontalContentAlignment="Left" Content="Delete rows,columns, or the entire Table."/>
									</ribbon:Ribbon.ScreenTip>
									<ribbon:RibbonMenuGroup IconBarEnabled="True">
										<ribbon:RibbonMenuItem Margin="3" Header="Delete Columns" Command="{Binding DeleteColumnCommand}">
                                            <ribbon:RibbonMenuItem.Icon>
                                                <Image Source="{StaticResource DeleteColumnIcon}" Height="13" Width="13"/>
                                            </ribbon:RibbonMenuItem.Icon>
                                        </ribbon:RibbonMenuItem>
										<ribbon:RibbonMenuItem Margin="3" Header="Delete Rows" Command="{Binding DeleteRowCommand}" >
											<ribbon:RibbonMenuItem.Icon>
                                                <Image Source="{StaticResource DeleteRowIcon}" Height="13" Width="13"/>
											</ribbon:RibbonMenuItem.Icon>
										</ribbon:RibbonMenuItem>
										<ribbon:RibbonMenuItem Margin="3" Header="Delete Table" Command="{Binding DeleteTableCommand}" >
											<ribbon:RibbonMenuItem.Icon>
                                                <Image Source="{StaticResource DeleteTableIcon}" Height="13" Width="13"/>
											</ribbon:RibbonMenuItem.Icon>
										</ribbon:RibbonMenuItem>
									</ribbon:RibbonMenuGroup>
								</ribbon:RibbonDropDownButton>
								<ribbon:RibbonSeparator Orientation="Vertical" Height="50" Margin="2,4,2,3"/>
                                <ribbon:RibbonButton SizeMode="Large" Label="Insert Above" Width="52" IsMultiLine="True" HorizontalAlignment="Center"  Margin="3,0,0,3" LargeIcon="{StaticResource InsertRowAboveIcon}" Command="{Binding InsertRowCommand}" CommandParameter="Above">
									<ribbon:Ribbon.ScreenTip>
                                        <ribbon:ScreenTip Description="Insert Rows Above" Width="250"  HorizontalContentAlignment="Left" Content="Add a new row directly above the selected row."/>
									</ribbon:Ribbon.ScreenTip>
								</ribbon:RibbonButton>
                                <ribbon:RibbonButton SizeMode="Large" Label="Insert Below" IsMultiLine="True"  Width="52" HorizontalAlignment="Center" Margin="0,0,0,3" Command="{Binding InsertRowCommand}" LargeIcon="{StaticResource InsertRowBelowIcon}" CommandParameter="Below" >
									<ribbon:Ribbon.ScreenTip>
                                        <ribbon:ScreenTip Description="Insert Rows Below" Width="250"  HorizontalContentAlignment="Left" Content="Add a new row directly below the selected row."/>
									</ribbon:Ribbon.ScreenTip>
								</ribbon:RibbonButton>
                                <ribbon:RibbonButton SizeMode="Large" Label="Insert Left" IsMultiLine="True" Width="52" HorizontalAlignment="Center" Margin="0,0,0,3" Command="{Binding InsertColumnCommand}" LargeIcon="{StaticResource InsertColumnLeftIcon}" CommandParameter="Left">
									<ribbon:Ribbon.ScreenTip>
                                        <ribbon:ScreenTip Description="Insert Columns to the Left" Width="250"  HorizontalContentAlignment="Left" Content="Add a new column directly to the left of the selected column."/>
									</ribbon:Ribbon.ScreenTip>
								</ribbon:RibbonButton>
                                <ribbon:RibbonButton SizeMode="Large" Label="Insert Right" IsMultiLine="True" Width="52" HorizontalAlignment="Center" Margin="0,0,0,3" Command="{Binding InsertColumnCommand}" LargeIcon="{StaticResource InsertColumnRightIcon}" CommandParameter="Right">
									<ribbon:Ribbon.ScreenTip>
                                        <ribbon:ScreenTip Description="Insert Columns to the Right" Width="250"  HorizontalContentAlignment="Left" Content="Add a new column directly to the right of the selected column."/>
									</ribbon:Ribbon.ScreenTip>
								</ribbon:RibbonButton>
							</ribbon:RibbonBar>
							<ribbon:RibbonBar IsLauncherButtonVisible="False" Header="Merge">
                                <ribbon:RibbonButton Label="Merge Cells" SizeMode="Large" Margin="3,0" IsMultiLine="True" HorizontalAlignment="Center" Width="52" Command="{Binding MergeSelectedCellsCommand}" LargeIcon="{StaticResource MergeCellsIcon}">
									<ribbon:Ribbon.ScreenTip>
                                        <ribbon:ScreenTip Description="Merge Cells" Width="250"  HorizontalContentAlignment="Left" Content="Merge the selected cells into one cell."/>
									</ribbon:Ribbon.ScreenTip>
								</ribbon:RibbonButton>
							</ribbon:RibbonBar>
							<!--<ribbon:RibbonBar IsLauncherButtonVisible="False" Header="Table Decorations" LayoutMode="Flow" >
								<ribbon:RibbonDropDownButton Margin="5" Label="Background" SmallIcon="{StaticResource CellBackgroundIcon}" DataContext="{Binding ElementName=PART_CellBackgroundColor}" Style="{StaticResource RibbonDropDownButtonStyle}">
									<ribbon:Ribbon.ScreenTip>
                                        <ribbon:ScreenTip Description="Background Color" Width="250"  HorizontalContentAlignment="Left" Content="Color the background of the selected cell."/>
									</ribbon:Ribbon.ScreenTip>
									<shared1:ColorPickerPalette IsExpanded="True"  Background="White" x:Name="PART_CellBackgroundColor" BlackWhiteVisibility="Both" Color="Yellow" MoreColorOptionVisibility="Collapsed" />
								</ribbon:RibbonDropDownButton>
                                <this:BorderThicknessComboBox Width="135" Margin="5" Height="27" Color="{Binding Path=Color, ElementName=PART_TableBorderColor}" />
                                <ribbon:RibbonDropDownButton Margin="5" Label="Border Brush" SmallIcon="{StaticResource BorderBrushIcon}" DataContext="{Binding ElementName=PART_TableBorderColor}" Style="{StaticResource RibbonDropDownButtonStyle}">
									<ribbon:Ribbon.ScreenTip>
                                        <ribbon:ScreenTip Description="Border Brush" Width="250"  HorizontalContentAlignment="Left" Content="Color the border of the table."/>
									</ribbon:Ribbon.ScreenTip>
									<shared1:ColorPickerPalette IsExpanded="True" Background="White" x:Name="PART_TableBorderColor" BlackWhiteVisibility="Both" Color="Black" MoreColorOptionVisibility="Collapsed" />
								</ribbon:RibbonDropDownButton>
							</ribbon:RibbonBar>-->
						</ribbon:RibbonTab>
						
						<ribbon:RibbonTab Caption="Page Layout">
							<ribbon:RibbonBar Header="Page SetUp" IsLauncherButtonVisible="False">
								<ribbon:RibbonButton SizeMode="Large" Label="Flow Layout" LargeIcon="{StaticResource FlowLayoutIcon}" Command="{Binding ChangePageLayoutCommand}" CommandParameter="Continuous"/>
								<ribbon:RibbonButton SizeMode="Large" Label="Page Layout" LargeIcon="{StaticResource PageLayoutIcon}" Command="{Binding ChangePageLayoutCommand}" CommandParameter="Pages"/>
							</ribbon:RibbonBar>
						</ribbon:RibbonTab>
					</ribbon:Ribbon>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
