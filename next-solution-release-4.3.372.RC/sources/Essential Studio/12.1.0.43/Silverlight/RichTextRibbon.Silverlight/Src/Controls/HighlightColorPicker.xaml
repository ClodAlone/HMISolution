<UserControl x:Class="Syncfusion.Windows.Tools.Controls.HighlightColorPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight">
    
    <UserControl.Resources>

        <SolidColorBrush x:Key="HoverBrush" Color="#FFF29436"/>

    </UserControl.Resources>
    
    <Grid x:Name="LayoutRoot" Background="White">
        <StackPanel Orientation="Vertical" x:Name="ParentStack">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Padding" Value="3"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Width" Value="30"/>
                    <Setter Property="BorderBrush" Value="#FFE2E4E7"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="MouseOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HoverBrush}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Background">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFE294"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Background" Storyboard.TargetProperty="BorderBrush">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="#FFF29436"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient" Storyboard.TargetProperty="Background">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="#FFFFE294"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <DoubleAnimation Duration="0" To=".55" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="DisabledVisualElement"/>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                        <VisualStateGroup x:Name="FocusStates">
                                            <VisualState x:Name="Focused">
                                                <Storyboard>
                                                    <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="FocusVisualElement"/>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Unfocused"/>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Border x:Name="Background" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="0" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                                        <Grid x:Name="grid" Background="Transparent" >
                                            <Border x:Name="BackgroundGradient" Background="{TemplateBinding Background}" Margin="1"/>
                                        </Grid>
                                    </Border>
                                    <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    <Rectangle x:Name="DisabledVisualElement" Fill="#FFFFFFFF" IsHitTestVisible="false" Opacity="0" />
                                    <Rectangle x:Name="FocusVisualElement" IsHitTestVisible="false" Margin="1" Opacity="0" Stroke="#FF6DBDD1" StrokeThickness="1"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>
            <StackPanel Orientation="Horizontal">
                <Button Width="30" Height="30" Margin="3" Background="Yellow"/>
                <Button Width="30" Height="30" Margin="3" Background="Lime"/>
                <Button Width="30" Height="30" Margin="3" Background="Turquoise"/>
                <Button Width="30" Height="30" Margin="3" Background="Magenta"/>
                <Button Width="30" Height="30" Margin="3" Background="Blue"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Width="30" Height="30" Margin="3" Background="Red" />
                <Button Width="30" Height="30" Margin="3" Background="DarkBlue"/>
                <Button Width="30" Height="30" Margin="3" Background="Teal"/>
                <Button Width="30" Height="30" Margin="3" Background="Green"/>
                <Button Width="30" Height="30" Margin="3" Background="Purple"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Width="30" Height="30" Margin="3" Background="DarkRed" />
                <Button Width="30" Height="30" Margin="3" Background="Olive"/>
                <Button Width="30" Height="30" Margin="3" Background="Gray"/>
                <Button Width="30" Height="30" Margin="3" Background="Silver"/>
                <Button Width="30" Height="30" Margin="3" Background="Black"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <shared:ContextMenuItemAdv HorizontalAlignment="Center" VerticalAlignment="Center" Height="30" Width="180">
                    <shared:ContextMenuItemAdv.Icon>
                        <Rectangle Fill="White" Stroke="Goldenrod" Height="15" Width="15" />
                    </shared:ContextMenuItemAdv.Icon>
                    <shared:ContextMenuItemAdv.Header>
                        <TextBlock Margin="5,2" VerticalAlignment="Center" Text="No Color" FontSize="14"/>
                    </shared:ContextMenuItemAdv.Header>
                </shared:ContextMenuItemAdv>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
