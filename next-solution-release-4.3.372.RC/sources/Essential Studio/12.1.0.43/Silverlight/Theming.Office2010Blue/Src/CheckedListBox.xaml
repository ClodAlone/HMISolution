<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Tools.Silverlight"  >

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Brushes -->

    <SolidColorBrush x:Key="CheckListBoxBackgroundBrushKey" Color="#FFE7EDF5"/>
    <SolidColorBrush x:Key="Office2010BlueCheckListBoxBorderBrush" Color="#FFA7ABB0"/>

    <SolidColorBrush x:Key="Office2010BlueCheckListBoxItemForeground" Color="Black"/> 

    <LinearGradientBrush x:Key="Office2010BlueCheckListBoxItemMouseOverBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFF8E9A8" Offset="0.044"/>
        <GradientStop Color="#FFF8E188" Offset="0.504"/>
        <GradientStop Color="#FFFBF9E0" Offset="0.978"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Office2010BlueCheckListBoxItemMouseOverBorderBrush" Color="#FFECC757"/>

    <LinearGradientBrush x:Key="Office2010BlueSelectedBorderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFC28A30" Offset="0"/>
        <GradientStop Color="#FFC2A44D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Office2010BlueSelectedBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFFE072" Offset="0.101"/>
        <GradientStop Color="#FFFFD86C" Offset="0.449"/>
        <GradientStop Color="#FFFFF480" Offset="0.96"/>
    </LinearGradientBrush>

    <!-- Styles -->



    <Style x:Key="Office2010BlueCheckedListBoxItemStyle" TargetType="local:CheckedListBoxItem">
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CheckedListBoxItem">
                    <Grid  Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Office2010BlueCheckListBoxItemMouseOverBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="InnerBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Office2010BlueCheckListBoxItemMouseOverBackground}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Office2010BlueSelectedBackground}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Border" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource Office2010BlueSelectedBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="InnerBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>                                      
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusVisualElement" Storyboard.TargetProperty="Visibility" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>                        
                        <Border x:Name="PART_Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent">
                            <Border x:Name="InnerBorder" Margin="1" Background="Transparent">
                            <Grid x:Name="PART_Grid" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="PART_Grid1" Grid.Column="0">
                                    <CheckBox x:Name="PART_CheckBox" Style="{StaticResource CheckBox}" Grid.Column="0" IsChecked="{TemplateBinding IsChecked}"  VerticalAlignment="Center" />
                                    <RadioButton x:Name="PART_Radio" GroupName="RadioButton"  IsChecked ="{TemplateBinding IsChecked}"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>

                                <Image Grid.Column="1" 
                                       x:Name="LeftImage" 
                                       Source="{TemplateBinding LeftImageSource}"
                                       MaxWidth="{TemplateBinding LeftImageWidth}"
                                       MaxHeight="{TemplateBinding LeftImageHeight}"
                                       Margin="{TemplateBinding ImageMargin}"
                                       VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"/>
                                <ContentPresenter x:Name="PART_Content" Grid.Column="2" Margin="2"  Content="{TemplateBinding Content}" />
                                <Image Grid.Row="0" Grid.Column="3" 
                                       x:Name="RightImage" 
                                       Source="{TemplateBinding RightImageSource}"
                                       MaxWidth="{TemplateBinding RightImageWidth}"
                                       MaxHeight="{TemplateBinding RightImageHeight}"
                                       Margin="{TemplateBinding ImageMargin}"
                                       VerticalAlignment="{TemplateBinding ImageVerticalAlignment}"/>
                            </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:CheckedListBoxItem" BasedOn="{StaticResource Office2010BlueCheckedListBoxItemStyle}"/>

    <Style x:Key="Office2010BlueCheckedListBoxStyle" TargetType="local:CheckedListBox" >
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Background" Value="{StaticResource CheckListBoxBackgroundBrushKey}" />
        <Setter Property="BorderBrush" Value="{StaticResource Office2010BlueCheckListBoxBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Office2010BlueCheckListBoxItemForeground}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TabNavigation" Value="Once" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CheckedListBox">
                    <Border CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                        <ScrollViewer Style="{StaticResource ScrollViewer}" x:Name="outerScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderBrush="Transparent">
                            <ItemsPresenter x:Name="PART_ItemsHost"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:CheckedListBox" BasedOn="{StaticResource Office2010BlueCheckedListBoxStyle}"/>

</ResourceDictionary>
