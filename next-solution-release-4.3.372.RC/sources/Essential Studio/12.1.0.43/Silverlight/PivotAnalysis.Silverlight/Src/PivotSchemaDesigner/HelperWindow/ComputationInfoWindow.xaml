<sync:WindowControl x:Class="Syncfusion.Silverlight.Controls.PivotSchemaDesigner.ComputationInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:sync="clr-namespace:Syncfusion.Windows.Tools.Controls;assembly=Syncfusion.Shared.Silverlight"
        xmlns:res="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid.Resources"
        Title="Pivot Computation Information" Height="280" Width="300"
        WindowStartupLocation="CenterOwner" AnimationType="None" Icon="/Syncfusion.PivotAnalysis.Silverlight;component/PivotSchemaDesigner/Resources/Icon.png"
        ResizeMode="NoResize" >
    <sync:WindowControl.Resources>
        <res:ResourceWrapper x:Key="resourceWrapperKeys"/>
    </sync:WindowControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="115"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="33"/>
        </Grid.RowDefinitions> 
        <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaComputationalInfoDialogCaptionFieldname}"   Grid.Row="0" VerticalAlignment="Center" Margin="2"/>
        <TextBlock Text="{Binding FieldName}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="2"/>
        <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaFieldHeader}" Grid.Row="1"  VerticalAlignment="Center" Margin="2"/>
        <TextBox Grid.Row="1" Text="{Binding FieldHeader,Mode=TwoWay}"  Grid.Column="1" VerticalAlignment="Center" Margin="2"/>
        <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaComputationalInfoDialogCaptionDescription}"   Grid.Row="2" VerticalAlignment="Center" Margin="2"/>
        <TextBox Text="{Binding Description,Mode=TwoWay}" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="2"/>
        <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaComputationalInfoDialogCaptionFormat}"   Grid.Row="3" VerticalAlignment="Center" Margin="2"/>
        <TextBox x:Name="txtFormat" Text="{Binding Format, Mode=TwoWay}" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="2"/>
        <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaComputationalInfoDialogCaptionSummaryType}"  Grid.Row="4" VerticalAlignment="Center" Margin="2"/>
        <ComboBox x:Name="cmbSummaryType"  
                  Grid.Row="4" 
                  Grid.Column="1"  
                  Height="24"
                  Margin="2,0,4,0" />
        <TextBlock Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaComputationalInfoDialogCaptionCalculationType}"  Grid.Row="5" VerticalAlignment="Center" Margin="2"/>
        <ComboBox x:Name="cmbCalculationType"  
                  Grid.Row="5" 
                  Grid.Column="1"  
                  Height="24"
                  Margin="2,0,4,0" />
        <TextBlock x:Name="txtBlockBaseField" Text="{Binding Source={StaticResource resourceWrapperKeys}, Path=PivotSchemaComputationalInfoDialogCaptionBaseField}" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="2" />
        <ComboBox x:Name="cmbBaseField"  
                  Grid.Row="6" 
                  Grid.Column="1"  
                  Height="24"
                  Margin="2,0,4,0" IsEnabled="False" />
        <StackPanel Grid.Row="7" Height="28" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnOK" Content="{Binding Source={StaticResource resourceWrapperKeys}, Path=OkButtonContent}"  Margin="3" Width="75" Click="btnOK_Click" />
            <Button x:Name="btnCancel" Content="{Binding Source={StaticResource resourceWrapperKeys}, Path=CancelButtonContent}" Margin="3" Width="75" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</sync:WindowControl>
