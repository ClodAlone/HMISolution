                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <LinearGradientBrush EndPoint="0.994,0.922" StartPoint="0.994,0.101">
                                                        <GradientStop Color="#FFEDF2FA" Offset="0.501"/>
                                                        <GradientStop Color="#FFD7E4F4" Offset="0.506"/>
                                                        <GradientStop Color="#FFC1D2E8" Offset="0.969"/>
                                                    </LinearGradientBrush>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    #FFBBCADB
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>                         
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PivotRowItem ToggleButton Style-->
    <Style TargetType="ToggleButton" x:Key="PivotRowToggleButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!--<ToggleButton Margin="2,4,2,0" Content="{Binding FieldHeader}" VerticalAlignment="Center" />-->
                    <Border Margin="2,4" x:Name="brdItem" BorderThickness="1">
                        <Border.Resources>
                            <resource:ResourceWrapper x:Key="ResourceWrapperKey"/>
                        </Border.Resources>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PART_contentTxt" Grid.Column="0" TextTrimming="WordEllipsis"  
                                       Text="{Binding FieldHeader}" Margin="2,0" VerticalAlignment="Center" />

                            <Button x:Name="filterBtn" Grid.Column="1" Style="{StaticResource RowFilterButtonStyle}" Margin="2 2 2 3" Height="13"
                                     Command="{StaticResource filterCommand}" CommandParameter="{Binding}"/>


                            <Path x:Name="rowSortPath" Grid.Column="2" Height="6" Width="7"  Margin="3,7,3,7"  Stretch="Fill" Fill="#FF4F4F4F" 
                                          Data=" F1 M 181.926,180.872L 181.926,180.872C 182.055,180.872 182.16,180.671 182.16,180.419C 182.16,180.299 182.134,180.182 182.091,180.101L 178.264,174.316C 178.215,174.246 178.152,174.203 178.086,174.203C 178.019,174.203 177.957,174.246 177.908,174.316L 177.015,175.665L 174.081,180.101C 174.038,180.182 174.012,180.299 174.012,180.419C 174.012,180.671 174.116,180.872 174.245,180.872L 175.74,180.872L 180.429,180.872L 181.926,180.872 Z" 
                                          VerticalAlignment="Top" />
                            <!--<Path x:Name="dsortPath" Grid.Column="2" Margin="3,7,3,7"  Stretch="Fill" Fill="#FF4F4F4F" 
                                          Data=" F1 M 174.248,174.201L 174.248,174.201C 174.119,174.201 174.014,174.403 174.014,174.654C 174.014,174.774 174.039,174.891 174.082,174.972L 177.906,180.759C 177.956,180.83 178.018,180.873 178.084,180.873C 178.151,180.873 178.213,180.83 178.263,180.759L 179.156,179.411L 182.092,174.976C 182.135,174.896 182.161,174.778 182.161,174.659C 182.161,174.407 182.057,174.205 181.929,174.205L 180.434,174.204L 175.744,174.202L 174.248,174.201 Z" 
                                          VerticalAlignment="Top"/>-->
                            <!-- Desc Sort Path F1 M 174.248,174.201L 174.248,174.201C 174.119,174.201 174.014,174.403 174.014,174.654C 174.014,174.774 174.039,174.891 174.082,174.972L 177.906,180.759C 177.956,180.83 178.018,180.873 178.084,180.873C 178.151,180.873 178.213,180.83 178.263,180.759L 179.156,179.411L 182.092,174.976C 182.135,174.896 182.161,174.778 182.161,174.659C 182.161,174.407 182.057,174.205 181.929,174.205L 180.434,174.204L 175.744,174.202L 174.248,174.201 Z -->
                        </Grid>
                        <contextmenu:ContextMenuAdvService.ContextMenuAdv>
                            <contextmenu:ContextMenuAdv x:Name="rowToggleButtonContextMenuAdv" Visibility="Collapsed">
                                <contextmenu:ContextMenuItemAdv Header="{Binding Path=Order,Source={StaticResource ResourceWrapperKey}}" Tag="Order">
                                    <contextmenu:ContextMenuItemAdv Header="{Binding Path=MovetoBegin,Source={StaticResource ResourceWrapperKey}}" Tag="Move to Beginning"/>
                                    <contextmenu:ContextMenuItemAdv Header="{Binding Path=MovetoLeft,Source={StaticResource ResourceWrapperKey}}" Tag="Move to Left"/>
                                    <contextmenu:ContextMenuItemAdv Header="{Binding Path=MovetoRight,Source={StaticResource ResourceWrapperKey}}" Tag="Move to Right"/>
                                    <contextmenu:ContextMenuItemAdv Header="{Binding Path=MovetoEnd,Source={StaticResource ResourceWrapperKey}}" Tag="Move to End"/>
                                    <contextmenu:ContextMenuItemAdv Header="{Binding Path=SmalltoLarge,Source={StaticResource ResourceWrapperKey}}" Tag="Smallest to largest"/>
                                    <contextmenu:ContextMenuItemAdv Header="{Binding Path=LargetoSmall,Source={StaticResource ResourceWrapperKey}}" Tag="Largest to smallest"/>
                                </contextmenu:ContextMenuItemAdv>
                            </contextmenu:ContextMenuAdv>
                        </contextmenu:ContextMenuAdvService.ContextMenuAdv>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>                        
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Drag Indicator-->
    <Style TargetType="ToggleButton" x:Key="DragIndicatorStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!--<ToggleButton Margin="2,2,2,0" Content="{Binding FieldHeader}" VerticalAlignment="Center" />-->
                    <Border Margin="2,2,2,0" x:Name="brdItem" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"  VerticalAlignment="Center" BorderThickness="1">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PART_contentTxt" Grid.Column="0" TextTrimming="WordEllipsis" VerticalAlignment="Center"
                                          Text="{Binding Converter={StaticResource dragConverter}}" Margin="2 4 0 2" />
                            <Button x:Name="filterBtn" Grid.Column="1" Style="{StaticResource FilterButtonStyle}" Margin="2 2 2 3" Height="13"
                                 Visibility="{Binding Converter={StaticResource dragConverter},ConverterParameter=Filter}" />
                            <Path x:Name="sortPath" Grid.Column="2"  Margin="3,8,3,7"  Stretch="Fill" Fill="#FF4F4F4F" 
                                          Data="{Binding Converter={StaticResource pathConverter}, Mode=OneWay}"
                                          VerticalAlignment="Top" Visibility="{Binding Converter={StaticResource dragConverter}}" />
                       
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- FilterBar DataTemplate -->
    <DataTemplate x:Key="PivotFilterItemTemplate">
        <ToggleButton x:Name="toggleButtonItem" Style="{StaticResource FilterBarToggleButtonStyle}" Tag="{Binding}" Margin="1,0,0,0" >
        </ToggleButton>
    </DataTemplate>

    <DataTemplate x:Key="PivotCalculationTemplate">
        <ToggleButton x:Name="toggleButtonItem" Style="{StaticResource PivotCalculationToggleButtonStyle}" Tag="{Binding}" Margin="1,0,0,0" >
        </ToggleButton>
    </DataTemplate>

    <DataTemplate x:Key="PivotColumnItemTemplate">
        <ToggleButton x:Name="toggleButtonItem" Style="{StaticResource PivotColumnToggleButtonStyle}" 
                      Command="{StaticResource sortColCommand}" CommandParameter="{Binding}" Margin="1 0 0 0" HorizontalAlignment="Stretch"
                      Tag="{Binding}" >
         
        </ToggleButton>
    </DataTemplate>

    <DataTemplate x:Key="PivotRowItemTemplate">
        <ToggleButton x:Name="toggleButtonItem" Style="{StaticResource PivotRowToggleButtonStyle}" 
                       Margin="0 0 1 0"  Command="{StaticResource sortRowCommand}" CommandParameter="{Binding}" 
                      Tag="{Binding}" >
        </ToggleButton>

        <!--<ToggleButton x:Name="toggleButtonItem" Content="{Binding FieldName}"></ToggleButton>-->

       
    </DataTemplate>

     <!-- RowGroupingBar Style -->
    <Style TargetType="local:PivotGridRowGroupBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PivotGridRowGroupBar">
                    <local:PivotGroupingItemsControl 
                        x:Name="PART_RowList"         
                        BorderThickness="0"
                        ItemsPanel="{StaticResource PivotRowItemPanelTemplate}"
                        ItemTemplate="{StaticResource PivotRowItemTemplate}"
                        ItemContainerStyle="{StaticResource PivotGroupingItemContainerStyle}"  
                        sfshared:DragAndDropManager.AllowDrop="True"                             
                        ScrollViewer.VerticalScrollBarVisibility="Disabled" 
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        VerticalAlignment="Bottom"
                        >
                    </local:PivotGroupingItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

     <!-- Grouping Bar -->
    <Style TargetType="local:PivotGridGroupingBar" x:Key="groupingbarStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PivotGridGroupingBar">
                    <Grid>
                        <Grid.Resources>
                            <resource:ResourceWrapper x:Key="ResourceWrapperKey"/>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34px"/>
                            <RowDefinition Height="32px"/>
                        </Grid.RowDefinitions>

                        <Popup x:Name="PART_Indicator">
                            <Grid x:Name="PART_MainGrid" Width="11">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="13"/>
                                    <RowDefinition Height="13"/>
                                </Grid.RowDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="VisualStateGroup">
                                        <VisualState x:Name="UpIndicatorState">
                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="PART_UpBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                                                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                                                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="-3"/>
                                                    <EasingDoubleKeyFrame KeyTime="00:00:00.4000000" Value="-6"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="DownIndicatorState">
                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="PART_DownBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                                                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                                                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="3"/>
                                                    <EasingDoubleKeyFrame KeyTime="00:00:00.4000000" Value="6"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CrossIndicatorState">
                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimationUsingKeyFrames BeginTime="00:00:01" Storyboard.TargetName="PART_CrossBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                                                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="PART_DownBorder"  Grid.Row="0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <Path x:Name="PART_UpBorderPath" Fill="#828283" Stretch="Fill" Data="M196.01875,-0.91043055 L397,303.53909 L259.91092,304.07809 L260.53125,437.9104 L136.00006,435.99997 L136.00006,303.53952 L0,303.53955 z" UseLayoutRounding="False" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform/>
                                                <SkewTransform/>
                                                <RotateTransform Angle="180"/>
                                                <TranslateTransform/>
                                            </TransformGroup>
                                        </Path.RenderTransform>
                                    </Path>
                                </Border>

                                <Border x:Name="PART_UpBorder" Grid.Row="2" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <Path x:Name="PART_DownBorderPath" Fill="#828283" Stretch="Fill" Data="M196.01875,-0.91043055 L397,303.53909 L259.91092,304.07809 L260.53125,437.9104 L136.00006,435.99997 L136.00006,303.53952 L0,303.53955 z" UseLayoutRounding="False"/>
                                </Border>

                                <Border x:Name="PART_CrossBorder" Grid.Row="0" RenderTransformOrigin="0.5,0.5">
                                    <Path x:Name="PART_CrossBorderPath" Fill="#828283" Stretch="Fill" Data="M1.5768458,0 L4.5866461,3.0098004 L7.5964422,3.5762787E-06 L9.1732903,1.5768521 L6.1634951,4.5866489 L9.1732941,7.5964479 L7.5964479,9.1732941 L4.5866489,6.1634951 L1.5768571,9.1732874 L8.3446503E-06,7.5964384 L3.0098002,4.5866461 L0,1.5768461 z" Height="12" UseLayoutRounding="False"  Width="12"/>
                                </Border>
                            </Grid>
                        </Popup>

                        <!-- FilterBar -->
                        <local:PivotGroupingItemsControl
                            x:Name="PART_FilterList"                              
                            Grid.Column="0" 
                            Grid.Row="0" Background="Transparent" 
                            sfshared:DragAndDropManager.AllowDrop="True"
                            BorderThickness="0,0,0,1"
                            ItemsPanel="{StaticResource PivotFilterItemPanelTemplate}"
                            ItemTemplate="{StaticResource PivotFilterItemTemplate}"
                            ItemContainerStyle="{StaticResource PivotGroupingItemContainerStyle}">
                            <TextBlock x:Name="filtercontentTxt" Text="{Binding Path=DropFilterFields,Source={StaticResource ResourceWrapperKey}}" FontFamily="Segoe UI" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </local:PivotGroupingItemsControl>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ComputationInfoWidth"/>
                                <ColumnDefinition Width="60" x:Name="ComputationButtonWidth"/>                                                               
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ComputationInfo List-->
                            
                            <local:PivotGroupingItemsControl 
                                x:Name="PART_ComputationInfoList"                                 
                                Grid.Column="0"  Background="Transparent" 
                                sfshared:DragAndDropManager.AllowDrop="True"
                                BorderThickness="0,0,0,0"                              
                                ItemsPanel="{StaticResource PivotComputationInfoPanelTemplate}"
                                ItemTemplate="{StaticResource PivotCalculationTemplate}"
                                ItemContainerStyle="{StaticResource PivotGroupingItemContainerStyle}"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled" 
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"                       
                                Margin="1,0,0,-1"/>
                              
                            <!--Computation Button-->
                            <Button x:Name="Button_ComputationArea" Grid.Column="1" Height="25" Margin="5,2,7,0"
                                    Visibility="Collapsed" Style="{StaticResource ComputationButtonStyle}">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="{Binding Source={StaticResource ResourceWrapperKey},Path=ToolTip_ShowFields}"></ToolTip>
                                </ToolTipService.ToolTip>
                            </Button>

                            <!-- Column List -->
                            <local:PivotGroupingItemsControl 
                                x:Name="PART_ColumnList"
                                Grid.Column="3" Background="Transparent" 
                                BorderThickness="0,0,0,0"
                                sfshared:DragAndDropManager.AllowDrop="True"                                
                                ItemsPanel="{StaticResource PivotColumnItemPanelTemplate}"
                                ItemTemplate="{StaticResource PivotColumnItemTemplate}"                                
                                ItemContainerStyle="{StaticResource PivotGroupingItemContainerStyle}" 
                                Margin="-5 0 0 0"
                                >
                                <TextBlock x:Name="colcontentTxt" Text="{Binding Path=DropColumnFields,Source={StaticResource ResourceWrapperKey}}" FontFamily="Segoe UI" FontSize="12" Margin="3,0,0,0" VerticalAlignment="Center"/>
                            </local:PivotGroupingItemsControl>

                            <Popup x:Name="PART_FilterPopup">
                                <Border BorderThickness="1" x:Name="brdItem" CornerRadius="2 2 2 2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>
                                        <ScrollViewer Grid.Row="0" x:Name="PART_GridScrollViewer" Margin="2,4"                                     
                                               HorizontalScrollBarVisibility="Auto" MinHeight="200" MinWidth="200" MaxHeight="200" MaxWidth="200" 
                                               VerticalScrollBarVisibility="Auto">
                                            <ListBox x:Name="PART_FilterPopupListBox" BorderThickness="0"  HorizontalAlignment="Stretch">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Key}" IsChecked="{Binding IsSelected,Mode=TwoWay}"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </ScrollViewer>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="PART_btnOK" Grid.Column="1" Content="{Binding Path=OkButtonContent,Source={StaticResource ResourceWrapperKey}}" Margin="3"/>
                                            <Button x:Name="PART_btnCancel" Grid.Column="2" Content="{Binding Path=CancelButtonContent,Source={StaticResource ResourceWrapperKey}}" Margin="3" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Popup>

                            <Popup x:Name="PART_RowGroupingbarPopup" sfshared:DragAndDropManager.AllowDrop="True">
                                <!--TODO: Need to set appropriate background and borderbrush below to hide the transparency between row field button and pivot grid control-->
                                <local:PivotGroupingItemsControl
                                  x:Name="PART_RowList" Margin="-2,0,0,0"
                        BorderThickness="1.7,0,1.7,0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                        ItemsPanel="{StaticResource PivotRowItemPanelTemplate}"
                        ItemTemplate="{StaticResource PivotRowItemTemplate}"
                        ItemContainerStyle="{StaticResource PivotGroupingItemContainerStyle}"  
                        sfshared:DragAndDropManager.AllowDrop="True"                             
                        ScrollViewer.VerticalScrollBarVisibility="Disabled" 
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        VerticalAlignment="Bottom">
                                    <TextBlock x:Name="rowcontentTxt" Text="{Binding Path=DropRowFields,Source={StaticResource ResourceWrapperKey}}" FontFamily="Segoe UI" FontSize="12" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                </local:PivotGroupingItemsControl>
                            </Popup>

                       

                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>       
    </Style>

    <!-- Grid Control -->
    <Style TargetType="local:PivotGridControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PivotGridControl">
                    <Border x:Name="PART_GridOuterBorder"  Background="{TemplateBinding Background}" BorderThickness="1 0 1 1" BorderBrush="{Binding Path=GridOuterBorderBrush,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
                        <Grid x:Name="Part_IndicatorGrid">
                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="PART_GroupingBarRowDefinition"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <local:PivotGridGroupingBar Grid.Row="0" x:Name="PART_PivotGridGroupingBar" Style="{StaticResource groupingbarStyle}">
                                </local:PivotGridGroupingBar>
                                <gridCommon:ScrollableContentViewer Grid.Row="1" x:Name="PART_GridScrollViewer"  
                                   CanContentScroll="True"
                                   Background="{TemplateBinding Background}"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   BorderThickness="{TemplateBinding BorderThickness}"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto">
                                    <local:PivotGridControlBase Margin="0 0 0 0" x:Name="PART_PivotGridControlBase"/>
                                </gridCommon:ScrollableContentViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>


        <Setter Property="Background" Value="{StaticResource DefaultPivotGridBackgroundBrush}"/>
        <Setter Property="ColumnHeaderCellStyle" >
            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="{StaticResource Classic.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Classic.ColumnHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="RowHeaderCellStyle" >
            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="#FFECF2F9" 
                             Foreground="{StaticResource Classic.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryHeaderStyle">

            <Setter.Value>
                <local:PivotGridCellStyle
                             Background="{StaticResource Classic.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Classic.SummaryForegroundBrush}"
                             FontFamily="Calibri"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="SummaryCellStyle" >
            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="{StaticResource Classic.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Classic.SummaryForegroundBrush}"
                             FontFamily="Calibri"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="ValueCellStyle" >
            <Setter.Value>
                <local:PivotGridCellStyle 
                             Background="{StaticResource Classic.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Classic.ValueCellForegroundBrush}"
                             FontFamily="Calibri"
                             />
            </Setter.Value>
        </Setter>
        <Setter Property="GridLineStroke" Value="#FFA4A9B4"/>
        <!--<Setter Property="Background" Value="{StaticResource Classic.GridBackground}"/>-->

        <Setter Property="GroupingBarItemBackground" Value="{StaticResource ClassicGroupingBarItemsBackground}"/>
        <Setter Property="GroupingBarItemBorderBrush" Value="#FFE2E2E2"/>
        <Setter Property="GroupingBarItemForeground" Value="#FF2A447F"/>
        <Setter Property="GridOuterBorderBrush" Value="#FFE2E2E2"/>
        <Setter Property="GroupingButtonHoverBackgroundBrush" Value="{StaticResource ClassicGroupingButtonsHoverBackgroundBrush}"/>
        <Setter Property="GroupingButtonHoverBorderBrush" Value="{StaticResource ClassicGroupingButtonHoverBorderBrush}"/>
        <Setter Property="GroupingButtonCheckedForeground" Value="{StaticResource Classic.SummaryForegroundBrush}"/>
        <Setter Property="GroupingButtonCheckedBackground" Value="{StaticResource ClassicGroupingButtonsCheckedBackgroundBrush}"/>
        <Setter Property="ExpanderStyle" Value="{StaticResource Classic.ExpanderStyle}"/>
      
    </Style>


</ResourceDictionary>
