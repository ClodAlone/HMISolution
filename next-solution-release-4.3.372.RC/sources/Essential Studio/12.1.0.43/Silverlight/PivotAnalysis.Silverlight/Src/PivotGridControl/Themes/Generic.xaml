    <!--PivotGrouping Item container style-->
    <Style x:Key="PivotGroupingItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="sfshared:DragAndDropManager.AllowDrag" Value="True"/>
        <Setter Property="sfshared:DragAndDropManager.AllowDrop" Value="True"/> 
        <Setter Property="sfshared:DragAndDropManager.DropDescriptionVisibility" Value="Collapsed"/>
    </Style>

    <!-- PivotGrouping FilterBar ItemPanel Template-->
    <ItemsPanelTemplate x:Key="PivotFilterItemPanelTemplate">
        <StackPanel
            Orientation="Horizontal" 
            ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            />
    </ItemsPanelTemplate>

       
    <!-- PivotGrouping ComputationInfo ItemPanel Template-->
    <ItemsPanelTemplate x:Key="PivotComputationInfoPanelTemplate">
        <StackPanel Orientation="Horizontal"            
            ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
            ScrollViewer.VerticalScrollBarVisibility="Hidden"
            />
    </ItemsPanelTemplate>

    <!-- PivotGrouping Column ItemPanel Template-->
    <ItemsPanelTemplate x:Key="PivotColumnItemPanelTemplate">
        <StackPanel Orientation="Horizontal" 
                    ScrollViewer.VerticalScrollBarVisibility="Disabled" 
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    />
    </ItemsPanelTemplate>

    <!-- PivotGrouping Row ItemPanel Template-->
    <ItemsPanelTemplate x:Key="PivotRowItemPanelTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled" 
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    />
    </ItemsPanelTemplate>

