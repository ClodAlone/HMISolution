<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
                    xmlns:local="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid"
                    xmlns:resource="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid.Resources"
                    xmlns:syncfusion="clr-namespace:Syncfusion.Windows;assembly=Syncfusion.GridCommon.Silverlight"
                    >
    
    <resource:ResourceWrapper x:Key="resourceWrapper"/>

    <local:ExpanderPathConverter x:Key="expanderPathConverter"/>
    <SolidColorBrush x:Key="Classic.GridBackground" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Classic.GridLineStroke" Color="#CFCFCF"/>

    <LinearGradientBrush x:Key="Classic.ColumnHeaderBackgroundBrush" StartPoint="0.495298,0" EndPoint="1.4953,0">
        <LinearGradientBrush.RelativeTransform>
            <TransformGroup>
                <SkewTransform CenterX="0.495298" CenterY="0" AngleX="-0.823281" AngleY="0"/>
                <RotateTransform CenterX="0.495298" CenterY="0" Angle="90.1791"/>
            </TransformGroup>
        </LinearGradientBrush.RelativeTransform>
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFF7FAFC" Offset="0"/>
            <GradientStop Color="#FFD4DDE9" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Classic.RowHeaderBackgroundBrush" StartPoint="0.495298,0" EndPoint="1.4953,0">
        <LinearGradientBrush.RelativeTransform>
            <TransformGroup>
                <SkewTransform CenterX="0.495298" CenterY="0" AngleX="-0.823281" AngleY="0"/>
                <RotateTransform CenterX="0.495298" CenterY="0" Angle="90.1791"/>
            </TransformGroup>
        </LinearGradientBrush.RelativeTransform>
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFF7FAFC" Offset="0"/>
            <GradientStop Color="#FFD4DDE9" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Classic.SummaryBackgroundBrush" StartPoint="0.487805,0.0634926" EndPoint="0.487805,1.01587">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFEDEEEF" Offset="0.153488"/>
            <GradientStop Color="#FFDBDDDE" Offset="0.373975"/>
            <GradientStop Color="#FFC9CCCD" Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Classic.ValueCellBackgroundBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Classic.ColumnHeaderForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Classic.RowHeaderForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Classic.ValueCellForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="Classic.SummaryForegroundBrush" Color="#000000"/>
<LinearGradientBrush x:Key="ComputationButtonBackground" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF7FA6DB" Offset="1"/>
        <GradientStop Color="#FFC3D8FE" Offset="0.993"/>
        <GradientStop Color="#FFF4FAFE" Offset="0.082"/>
    </LinearGradientBrush>
    <local:PivotGridCellStyle x:Key="Classic.ColumnHeaderStyle" 
                             Background="{StaticResource Classic.ColumnHeaderBackgroundBrush}"
                             Foreground="{StaticResource Classic.ColumnHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Classic.RowHeaderStyle" 
                             Background="{StaticResource Classic.RowHeaderBackgroundBrush}"
                             Foreground="{StaticResource Classic.RowHeaderForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Classic.SummaryStyle" 
                             Background="{StaticResource Classic.SummaryBackgroundBrush}"
                             Foreground="{StaticResource Classic.SummaryForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <local:PivotGridCellStyle x:Key="Classic.ValueCellStyle" 
                             Background="{StaticResource Classic.ValueCellBackgroundBrush}"
                             Foreground="{StaticResource Classic.ValueCellForegroundBrush}"
                             FontFamily="Calibri"
                             />

    <LinearGradientBrush x:Key="ButtonMouseOverBrush.Blue" EndPoint="0,1" StartPoint="0,0">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFE69E" Offset="1"/>
            <GradientStop Color="#FFFFE8A7" Offset="0.4"/>
            <GradientStop Color="#FFFFD767" Offset="0.4"/>
            <GradientStop Color="#FFFFFCDE"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TreeViewFill.Blue" Color="#FF7F9DB9"/>

    <LinearGradientBrush x:Key="ToolTipBackground.Blue"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#E4E5F0"
                          Offset="1"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <Style TargetType="Button" x:Key="ComputationButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="brdItem" VerticalAlignment="Center"   CornerRadius="6"
                            BorderThickness="1" Background="{StaticResource ComputationButtonBackground}" >
                        <TextBlock Height="25" Text="{Binding ShowFields,Source={StaticResource resourceWrapper}}" Margin="2,3,3,2" TextAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <LinearGradientBrush EndPoint="0.994,0.922" StartPoint="0.994,0.101">
                                                        <GradientStop Color="#FFEDF2FA" Offset="0.501"/>
                                                        <GradientStop Color="#FFD7E4F4" Offset="0.506"/>
                                                        <GradientStop Color="#FFC1D2E8" Offset="0.969"/>
                                                    </LinearGradientBrush>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    #00FFFFFF
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="brdItem" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Classic.ExpanderStyle"
           TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>

                        <!--<vsm:VisualStateManager.VisualStateGroups>
                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal" />
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="borderBackground" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ButtonMouseOverBrush.Blue}"/>
                                        </ObjectAnimationUsingKeyFrames>                                    
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled"/>
                                <vsm:VisualState x:Name="ReadOnly"/>
                            </vsm:VisualStateGroup>
                            <vsm:VisualStateGroup x:Name="FocusStates">
                                <vsm:VisualState x:Name="Focused"/>
                                <vsm:VisualState x:Name="Unfocused"/>
                            </vsm:VisualStateGroup>
                        </vsm:VisualStateManager.VisualStateGroups>-->

                        <vsm:VisualStateManager.VisualStateGroups>

                            <vsm:VisualStateGroup x:Name="CommonStates">
                                <vsm:VisualState x:Name="Normal"/>
                                <vsm:VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="MouseOverColor" Storyboard.TargetProperty="Color">
                                            <SplineColorKeyFrame KeyTime="0" Value="#FFEFA210"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Disabled">
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>
                            
                            <!--<vsm:VisualStateGroup x:Name="CheckStates">
                                <vsm:VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                    </Storyboard>
                                </vsm:VisualState>
                                <vsm:VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="CheckedVisual" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="0:0:0.1" Storyboard.TargetName="UncheckedVisual" Storyboard.TargetProperty="Opacity" To="0" />
                                    </Storyboard>
                                </vsm:VisualState>
                            </vsm:VisualStateGroup>-->

                        </vsm:VisualStateManager.VisualStateGroups>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="11" x:Name="border"
                                            BorderBrush="{StaticResource TreeViewFill.Blue}"
                                            CornerRadius="2" 
                                            Width="11" 
                                            BorderThickness="1" 
                                            >
                            <Border.Background>
                                <LinearGradientBrush x:Name="borderBackground" StartPoint="0,0" EndPoint="0,1">
                                    <LinearGradientBrush.GradientStops>
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E4E5F0" Offset="1"/>
                                    </LinearGradientBrush.GradientStops>
                                </LinearGradientBrush>
                               
                            </Border.Background>

                            <Border BorderThickness="2" CornerRadius="2">
                                <Border.BorderBrush>
                                    <SolidColorBrush x:Name="MouseOverColor" Color="Transparent"/>
                                </Border.BorderBrush>
                                <Grid>
                                    <Path Margin="0" Fill="Black" Data="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, 
                                        Converter={StaticResource expanderPathConverter}}"/>
                                    <!--<Path Margin="0" Data="M0,2L0,3 2,3 2,5 3,5 3,3 5,3 5,2 3,2 3,0 2,0 2,2z" 
                                              Fill="Black" Name="UncheckedVisual" />
                                    <Path Margin="0" Data="M0,2L0,3 5,3 5,2z" 
                                              Fill="Black" Name="CheckedVisual" />-->
                                </Grid>
                            </Border>                      

                        </Border>
                        <ContentPresenter Grid.Column="1"
                                              Margin="4,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                    </Grid>
                    <!--<ControlTemplate.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter Property="Path.Data" TargetName="ExpandPath" Value="M0,2L0,3 5,3 5,2z"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver"
                                 Value="true">
                            <Setter Property="Background"
                                    Value="{StaticResource ButtonMouseOverBrush.Blue}"
                                    TargetName="border"/>
                        </Trigger>
                    </ControlTemplate.Triggers>-->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>




