<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows"
                    xmlns:contextmenu="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.Silverlight"
                    xmlns:local="clr-namespace:Syncfusion.Silverlight.Controls.PivotGrid">
    <local:SortDirectionConverter x:Key="sortDirectionConverter"/>
    <Style TargetType="local:PivotExpanderCell">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PivotExpanderCell">
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_CellValueTextBlock" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <SolidColorBrush Color="Red"/>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_CellValueTextBlock" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_CellValueTextBlock" Storyboard.TargetProperty="TextDecorations">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Underline
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>                                    
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        
                        <ToggleButton x:Name="PART_Expander" VerticalAlignment="Top" Margin="3"
                            Style="{Binding Path=ExpanderStyle, RelativeSource={RelativeSource TemplatedParent}}"
                            IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Tag="{Binding}"/> 
                       
                        <TextBlock x:Name="PART_CellValueTextBlock" VerticalAlignment="Top" Margin="-3,0,3,0" Text="{Binding Path=Text, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{Binding Path=FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{Binding Path=FontSize, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="{Binding Path=FontWeight, RelativeSource={RelativeSource TemplatedParent}}"
                                           />
                        <contextmenu:ContextMenuAdvService.ContextMenuAdv>
                            <contextmenu:ContextMenuAdv x:Name="PART_ExpandCollapseContextMenu">
                            </contextmenu:ContextMenuAdv>
                        </contextmenu:ContextMenuAdvService.ContextMenuAdv>
                    </StackPanel>
                    <!--<Expander x:Name="PART_Expander" 
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Left"
                                  Margin="1,2"
                                  IsExpanded="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                        <Expander.Style>
                            <Style TargetType="{x:Type Expander}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Expander}">
                                            <Border SnapsToDevicePixels="true" 
                                                        Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                        CornerRadius="3">
                                                <ToggleButton x:Name="HeaderSite" 
                                                                  Margin="1" 
                                                                  MinHeight="0" 
                                                                  MinWidth="0" 
                                                                  Style="{Binding Path=ExpanderStyle, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:PivotGridControl}}}" 
                                                                  Content="{TemplateBinding Header}" 
                                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Expander.Style>
                        <Expander.Header>
                            <TextBlock Text="{Binding Path=Text, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{Binding Path=FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{Binding Path=FontSize, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="{Binding Path=FontWeight, RelativeSource={RelativeSource TemplatedParent}}"
                                           />
                        </Expander.Header>
                    </Expander>-->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:PivotSortHeaderCell">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PivotSortHeaderCell">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PART_CellValueTextBlock" VerticalAlignment="Top" Margin="5,2.5,3,0" Text="{Binding Path=Text, RelativeSource={RelativeSource TemplatedParent}}" 
                                           Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{Binding Path=FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{Binding Path=FontSize, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="{Binding Path=FontWeight, RelativeSource={RelativeSource TemplatedParent}}"
                                           TextWrapping="Wrap"  ToolTipService.ToolTip="{Binding Path=Text,ElementName=PART_CellValueTextBlock}" TextTrimming="WordEllipsis"
                                           />

                        <Path x:Name="colSortPath" Grid.Column="2"  Margin="3,9,3,0" VerticalAlignment="Top"  Height="6" Width="7" Stretch="Fill" Fill="#FF4F4F4F" 
                                        Data="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource sortDirectionConverter}}" 
                                            />


                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:PivotGridHyperlinkCell">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PivotGridHyperlinkCell">
                    <Grid>
                        <Grid.RowDefinitions >
                            <RowDefinition Height="*"/>                            
                        </Grid.RowDefinitions>
                            <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_CellValueTextBlock" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <SolidColorBrush Color="Red"/>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_CellValueTextBlock" Storyboard.TargetProperty="Cursor">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Hand
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetName="PART_CellValueTextBlock" Storyboard.TargetProperty="TextDecorations">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    Underline
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBlock x:Name="PART_CellValueTextBlock" Margin="5,5,5,3" HorizontalAlignment="{Binding Path=HAlignment,RelativeSource={RelativeSource TemplatedParent}}" Grid.Row="0"  Text="{Binding Path=FormattedText}"                                           
                                           Foreground="{Binding Path=Foreground,RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{Binding Path=FontFamily,RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{Binding Path=FontSize,RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="{Binding Path=FontWeight,RelativeSource={RelativeSource TemplatedParent}}">                          
                        </TextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
