                            </ControlTemplate>
                            <ControlTemplate x:Key="HorizontalThumbTemplate"
                                             TargetType="Thumb">
                                <Grid>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="MouseOver">
                                                <Storyboard>

                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient"
                                                                                   Storyboard.TargetProperty="Fill">
                                                        <DiscreteObjectKeyFrame KeyTime="0"
                                                                                Value="{StaticResource ScrollBarHorizontalThumbMouseOverBrushKey}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>

                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundGradient"
                                                                                   Storyboard.TargetProperty="Fill">
                                                        <DiscreteObjectKeyFrame KeyTime="0"
                                                                                Value="{StaticResource ScrollBarHorizontalThumbPressedBrushKey}" />
                                                    </ObjectAnimationUsingKeyFrames>

                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThumbVisual"
                                                                                   Storyboard.TargetProperty="Opacity">
                                                        <SplineDoubleKeyFrame KeyTime="0:0:0"
                                                                              Value="0" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Grid x:Name="ThumbVisual"
                                          Margin="0,1,0,1">
                                        <Rectangle x:Name="Background"
                                                   Stroke="{StaticResource ScrollBarHorizontalThumbBorderBrushKey}"
                                                   Fill="{StaticResource ScrollBarHorizontalThumbBackgroundBrushKey}" />

                                        <Rectangle x:Name="BackgroundPressed"
                                                   Fill="{StaticResource BackgroundAnimationBrushKey}"
                                                   Stroke="#00000000"
                                                   StrokeThickness="1"
                                                   RadiusX="2"
                                                   RadiusY="2"
                                                   Opacity="0" />
                                        <Rectangle x:Name="BackgroundGradient"
                                                   Fill="{StaticResource ScrollBarHorizontalThumbGradientBrushKey}"
                                                   Stroke="{StaticResource ScrollBarHorizontalThumbBorderBrushKey}"
                                                   StrokeThickness="0"
                                                   Margin="1" />

                                        <Rectangle x:Name="Highlight"
                                                   Stroke="{StaticResource FocusedBorderBrushKey}"
                                                   StrokeThickness="1"
                                                   Margin="1"
                                                   IsHitTestVisible="false"
                                                   Opacity="0" />
                                        <Path Data="M0,0 L8,0 L8,8 L0,8 z"
                                              Height="8"
                                              Stretch="Fill"
                                              Width="11">
                                            <Path.Fill>
                                                <LinearGradientBrush EndPoint="1.155,0.023"
                                                                     StartPoint="-0.296,0.021">
                                                    <GradientStop Color="#FF595959"
                                                                  Offset="0.118" />
                                                    <GradientStop Color="#FF9D9D9D"
                                                                  Offset="0.126" />
                                                    <GradientStop Color="#FF9D9D9D"
                                                                  Offset="0.244" />
                                                    <GradientStop Color="#FF595959"
                                                                  Offset="0.256" />
                                                    <GradientStop Color="#FF595959"
                                                                  Offset="0.374" />
                                                    <GradientStop Color="#FF9D9D9D"
                                                                  Offset="0.382" />
                                                    <GradientStop Color="#FF9D9D9D"
                                                                  Offset="0.5" />
                                                    <GradientStop Color="#FF595959"
                                                                  Offset="0.508" />
                                                    <GradientStop Color="#FF595959"
                                                                  Offset="0.626" />
                                                    <GradientStop Color="#FF9D9D9D"
                                                                  Offset="0.634" />
                                                    <GradientStop Color="#FF9D9D9D"
                                                                  Offset="0.756" />
                                                    <GradientStop Color="#FF595959"
                                                                  Offset="0.763" />
                                                    <GradientStop Color="#FF595959"
                                                                  Offset="0.882" />
                                                    <GradientStop Color="#FF9D9D9D"
                                                                  Offset="0.89" />
                                                </LinearGradientBrush>
                                            </Path.Fill>
                                        </Path>
                                    </Grid>
                                </Grid>
                            </ControlTemplate>
                        </Grid.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver" />

                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0"
                                                                  Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="HorizontalRoot">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Stroke="#00000000"
                                       Fill="{StaticResource ScrollBarHorizontalBackgroundBrushKey}"
                                       StrokeThickness="1"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Grid.ColumnSpan="5" />

                            <Rectangle Fill="{TemplateBinding Background}"
                                       Stroke="#00000000"
                                       StrokeThickness="1"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Grid.ColumnSpan="5" />
                            <Rectangle StrokeThickness="1"
                                       Stroke="{StaticResource ScrollBarHorizontalOuterBorderBrushKey}"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Opacity=".375"
                                       Grid.ColumnSpan="5" />

                            <Rectangle RadiusX="1"
                                       Stroke="{StaticResource ScrollBarHorizontalInnerBorderBrushKey}"
