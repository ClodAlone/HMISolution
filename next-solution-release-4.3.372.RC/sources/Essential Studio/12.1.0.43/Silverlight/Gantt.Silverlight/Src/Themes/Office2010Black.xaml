                                                                  Offset="0.118" />
                                                    <GradientStop Color="#FF9D9D9D"
                                                                  Offset="0.126" />
                                                    <GradientStop Color="#FF9D9D9D"
                                                                  Offset="0.244" />
                                                    <GradientStop Color="#FF595959"
                                                                  Offset="0.256" />
                                                    <GradientStop Color="#FF595959"
                                                                  Offset="0.374" />
                                                    <GradientStop Color="#FF9D9D9D"
                                                                  Offset="0.382" />
                                                    <GradientStop Color="#FF9D9D9D"
                                                                  Offset="0.5" />
                                                    <GradientStop Color="#FF595959"
                                                                  Offset="0.508" />
                                                    <GradientStop Color="#FF595959"
                                                                  Offset="0.626" />
                                                    <GradientStop Color="#FF9D9D9D"
                                                                  Offset="0.634" />
                                                    <GradientStop Color="#FF9D9D9D"
                                                                  Offset="0.756" />
                                                    <GradientStop Color="#FF595959"
                                                                  Offset="0.763" />
                                                    <GradientStop Color="#FF595959"
                                                                  Offset="0.882" />
                                                    <GradientStop Color="#FF9D9D9D"
                                                                  Offset="0.89" />
