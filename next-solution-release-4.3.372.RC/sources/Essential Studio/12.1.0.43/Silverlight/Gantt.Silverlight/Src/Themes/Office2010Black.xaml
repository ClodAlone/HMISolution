                                               Fill="{StaticResource ScrollBarHorizontalRepeatButtonBackgroundBrushKey}"
                                               Stroke="{StaticResource ScrollBarHorizontalRepeatButtonBorderBrushKey}"
                                               StrokeThickness="1"
                                               RadiusX="2"
                                               RadiusY="2"
                                               Opacity="0" />

                                    <Rectangle x:Name="BackgroundAnimation"
                                               Fill="{StaticResource BackgroundAnimationBrushKey}"
                                               Stroke="#00000000"
                                               StrokeThickness="1"
                                               RadiusX="2"
                                               RadiusY="2"
                                               Opacity="0" />
