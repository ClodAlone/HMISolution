                        <Grid x:Name="VerticalRoot"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Rectangle Stroke="#00000000"
                                       Fill="{StaticResource ScrollBarVerticalBackgroundBrushKey}"
                                       StrokeThickness="1"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Grid.RowSpan="5" />
                            <Rectangle StrokeThickness="1"
                                       Stroke="{StaticResource ScrollBarVerticalOuterBorderBrushKey}"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Opacity=".375"
                                       Grid.RowSpan="5" />
                            <Rectangle RadiusX="1"
                                       Stroke="{StaticResource ScrollBarVerticalInnerBorderBrushKey}"
                                       RadiusY="1"
                                       Margin="1"
                                       Grid.RowSpan="5" />
                            <RepeatButton x:Name="VerticalSmallDecrease"
                                          Height="20"
                                          Margin="1"
                                          IsTabStop="False"
                                          Template="{StaticResource VerticalDecrementTemplate}"
                                          Grid.Row="0"
                                          Interval="50" />
                            <RepeatButton x:Name="VerticalLargeDecrease"
                                          Height="0"
                                          IsTabStop="False"
                                          Template="{StaticResource RepeatButtonTemplate}"
                                          Grid.Row="1"
                                          Interval="50" />
                            <Thumb x:Name="VerticalThumb"
                                   Height="70"
                                   MinHeight="70"
                                   Template="{StaticResource VerticalThumbTemplate}"
                                   Grid.Row="2" />
                            <RepeatButton x:Name="VerticalLargeIncrease"
                                          IsTabStop="False"
                                          Template="{StaticResource RepeatButtonTemplate}"
                                          Grid.Row="3"
                                          Interval="50"
                                          HorizontalAlignment="Left"
                                          Width="44" />
                            <RepeatButton x:Name="VerticalSmallIncrease"
                                          Height="20"
                                          Margin="1"
                                          IsTabStop="False"
                                          Template="{StaticResource VerticalIncrementTemplate}"
                                          Grid.Row="4"
                                          Interval="50" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

  
    <!-- ScrollViewer -->

    <Style x:Key="Office2010BlackScrollViewerStyle"
           TargetType="ScrollViewer">
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="VerticalContentAlignment"
                Value="Top" />
        <Setter Property="VerticalScrollBarVisibility"
                Value="Visible" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="BorderBrush"
                Value="{StaticResource ScrollViewerBorderBrushKey}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <!--<Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">-->
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="ScrollContentPresenter"
                                                    Cursor="{TemplateBinding Cursor}"
                                                    Margin="{TemplateBinding Padding}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <Rectangle Fill="{StaticResource ScrollViewerRectangleBrushKey}"
                                       Grid.Column="1"
                                       Grid.Row="1" />
                            <ScrollBar Style="{StaticResource Office2010BlackScrollBarStyle}"
                                       x:Name="VerticalScrollBar"
                                       Margin="0,-1,-1,-1"
                                       Width="18"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       IsTabStop="False"
                                       Grid.Column="1"
                                       Grid.Row="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Minimum="0"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Orientation="Vertical"
                                       ViewportSize="{TemplateBinding ViewportHeight}" />
                            <ScrollBar Style="{StaticResource Office2010BlackScrollBarStyle}"
                                       x:Name="HorizontalScrollBar"
                                       Height="18"
                                       Margin="-1,0,-1,-1"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       IsTabStop="False"
                                       Grid.Column="0"
                                       Grid.Row="1"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       Minimum="0"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Orientation="Horizontal"
                                       ViewportSize="{TemplateBinding ViewportWidth}" />
                        </Grid>
                    <!--</Border>-->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollableContentViewerStyle1"
           TargetType="sfgridcommon:ScrollableContentViewer">
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="VerticalContentAlignment"
                Value="Top" />
        <Setter Property="VerticalScrollBarVisibility"
                Value="Visible" />
        <Setter Property="Padding"
                Value="-1.25,-1.25,-1.25,0" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush EndPoint="0.5,1"
                                     StartPoint="0.5,0">
                    <GradientStop Color="#FFA3AEB9"
                                  Offset="0" />
                    <GradientStop Color="#FF8399A9"
                                  Offset="0.375" />
                    <GradientStop Color="#FF718597"
                                  Offset="0.375" />
                    <GradientStop Color="#FF617584"
                                  Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="sfgridcommon:ScrollableContentViewer">
                    <Border CornerRadius="2"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <sfgridcommon:ScrollableContentPresenter x:Name="ScrollContentPresenter"
                                                                                    Cursor="{TemplateBinding Cursor}"
                                                                                    Margin="{TemplateBinding Padding}"
                                                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <Rectangle Grid.Column="1"
                                       Grid.Row="1"
                                       Fill="#FFE9EEF4" />

                            <ScrollBar x:Name="VerticalScrollBar"
                                       Style="{StaticResource Office2010BlackScrollBarStyle}"
                                       Width="18"
                                       IsTabStop="False"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Grid.Column="1"
                                       Grid.Row="0"
                                       Orientation="Vertical"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Minimum="0"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Margin="0,-1,-1,-1" />

                            <ScrollBar x:Name="HorizontalScrollBar"
                                       Height="18"
                                       Style="{StaticResource Office2010BlackScrollBarStyle}"
                                       IsTabStop="False"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Grid.Column="0"
                                       Grid.Row="1"
                                       Orientation="Horizontal"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       Minimum="0"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Margin="0,-1,-1,-1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Gantt Schedule Brushes-->
    
    <LinearGradientBrush x:Key="scheduleheaderbg"
                         EndPoint="0.032, 0.066"
                         StartPoint="0.032,0.957">
        <GradientStop Color="#FFEAEAEA"
                      Offset="0.08" />
        <GradientStop Color="#FFDFDFDF"
                      Offset="0.936" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="scheduleheaderbb"
                     Color="#FF3B3B3B" />

    <SolidColorBrush x:Key="ResourceNameForegroundBrush" Color="Black"/>

    <!-- Gantt Control styles-->
    
    <Style TargetType="local:GanttControl">
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="BorderBrush"
                Value="LightGray" />
        <Setter Property="Background"
                Value="White" />
        <Setter Property="ScheduleBackground"
                Value="{StaticResource scheduleheaderbg}" />
        <Setter Property="ScheduleForeground"
                Value="Black"/>
        <Setter Property="ScheduleBorderBrush"
                Value="{StaticResource scheduleheaderbb}" />
        <Setter Property="ScheduleBorderThickness" Value="0,0,0,1" />
        <Setter Property="NonWorkingHoursBackground" Value="#FFEAEAEA"/>
        <Setter Property="ResourceContainerTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding Content, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="Bold" VerticalAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GanttControl">
                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}" UseLayoutRounding="True"
                            Background="{TemplateBinding Background}">
                        <Grid x:Name="PART_LayoutGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>
                            <Grid:GanttGrid x:Name="PART_GanttGrid"
                                            BorderBrush="Transparent"
											VisualStyle="Office14Black"
                                            ScrollViewerStyle="{StaticResource ScrollableContentViewerStyle1}"
                                            HeaderBackground ="{TemplateBinding GridHeaderBackground}"
                                            HeaderForeground="{TemplateBinding GridHeaderForeground}"
                                            ShowAddNewColumn="{TemplateBinding ShowAddNewColumn}"
                                            ShowDateWithTime ="{TemplateBinding ShowDateWithTime}"
                                            BorderThickness="0" UseLayoutRounding="True"
                                            Grid.Column="0" Margin="0,0,-0.5,0" />
                            <Controls:GridSplitter Grid.Column="1" 
                                              Width="5" 
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              ShowsPreview="True"
                                              BorderThickness="1,0,1,0"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              x:Name="PART_GanttGridSplitter">
                                <Controls:GridSplitter.Background>                                   
                                    <SolidColorBrush Color="#FFEAEAEA"/>
                                </Controls:GridSplitter.Background>
                            </Controls:GridSplitter>
                            <ScrollViewer x:Name="PART_ScheduleViewScrollViewer"
                                              Grid.Column="2" Padding="0"                                         
                                              Style="{StaticResource Office2010BlackScrollViewerStyle}"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollBarVisibility="Auto">
                                <Grid Margin="0,-1,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <schedule:GanttSchedule x:Name="PART_GantSchedule" Grid.Row="0" 
                                                                 HorizontalAlignment="Left"
                                                                 StartTime="{TemplateBinding StartTime}"
                                                                 IsUIVirtualizaionEnabled="{TemplateBinding UseOnDemandSchedule}"
                                                                 EndTime="{TemplateBinding EndTime}" UseLayoutRounding="True"
                                                                 BorderBrush="{TemplateBinding ScheduleBorderBrush}"
                                                                 BorderThickness="{TemplateBinding ScheduleBorderThickness}"
                                                                 Foreground="{TemplateBinding ScheduleForeground}"
                                                                 Background="{TemplateBinding ScheduleBackground}" />

                                    <Chart:GanttChart x:Name="PART_GanttChart" Grid.Row="1" TaskNodeBackground="{TemplateBinding TaskNodeBackground}"
                                                                 HighlightItemBrush="{TemplateBinding HighlightItemBrush}"
                                                                 ConnectorStroke="{TemplateBinding ConnectorStroke}" 
                                                                 ToolTipTemplate="{TemplateBinding ToolTipTemplate}"
                                                                 ResourceNameVisibility="{TemplateBinding ResourceNameVisibility}"
                                                                 HorizontalAlignment="Left" 
                                                                 NonWorkingHoursBackground="{TemplateBinding NonWorkingHoursBackground}" 
                                                                 CurrentDateLine="{TemplateBinding CurrentDateLine}"
                                                                 StickCurrentDateLineTo="{TemplateBinding StickCurrentDateLineTo}"
                                                                 ProgressIndicatorBackground="{TemplateBinding ProgressIndicatorBackground}"
                                                                 ShowResizingTooltip="{TemplateBinding ShowResizingTooltip}"
                                                                 ShowNonWorkingHoursBackground="{TemplateBinding ShowNonWorkingHoursBackground}"
                                                                 ShowChartLines="{TemplateBinding ShowChartLines}"
                                                                 StartTime="{TemplateBinding StartTime}"
                                                                 EndTime="{TemplateBinding EndTime}"
                                                                 RowHeight="{TemplateBinding RowHeight}"
                                                                 ResourceNamePlacement="{TemplateBinding ResourceNamePlacement}"
                                                                 ResourceNameForeground="{StaticResource ResourceNameForegroundBrush}"
                                                                 Width="{Binding ElementName=PART_GantSchedule, Path=Width}"
                                                                 Background="White" />
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>
</ResourceDictionary>
