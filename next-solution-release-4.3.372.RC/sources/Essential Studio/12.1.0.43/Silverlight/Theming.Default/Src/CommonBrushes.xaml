   <Style x:Key="ToolTip" TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource ToolTipBackgroundBrushKey}"/>
        <Setter Property="Padding" Value="3,0,3,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ToolTipBorderBrushKey}"/>
