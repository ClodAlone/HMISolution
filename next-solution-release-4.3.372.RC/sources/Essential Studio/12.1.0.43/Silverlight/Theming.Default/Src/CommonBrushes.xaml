                            <Rectangle x:Name="BackgroundOverlay" Fill="White" Stroke ="{TemplateBinding CheckBoxBrush}" Width="11.3715" Height="11.3715" Stretch="Fill" StrokeMiterLimit="2.75" Fill="{TemplateBinding CheckBoxFill}"/>-->
                            <Rectangle x:Name="BoxMiddleBackground" Fill="{StaticResource CheckBoxFill}" Stroke="{StaticResource CheckBoxBrush}" StrokeThickness="0" RadiusX="0" RadiusY="0" Height="12" Width="12"/>
                            <Rectangle x:Name="BoxMiddle" Stroke="{StaticResource CheckBoxBrush}" Fill="{StaticResource CheckBoxFill}" StrokeThickness="0" RadiusX="0" RadiusY="0" Height="12" Width="12"/>
                            <Rectangle x:Name="PressedBoxMiddle" Opacity="0" Stroke="#5586A3" Fill="{StaticResource CheckMiddleBoxPressedBackgroundBrushKey}" RadiusX="0" RadiusY="0" StrokeThickness="1" Height="12" Width="12"/>
                            <Rectangle x:Name="HoverBoxMiddle" Opacity="0" Stroke="#5586A3" Fill="{StaticResource CheckMiddleBoxHoverBackgroundBrushKey}" StrokeThickness="1" RadiusX="0" RadiusY="0" Height="12" Width="12"/>

                            <Rectangle x:Name="BoxMiddleLine" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" RadiusX="0" RadiusY="0" Height="10" Width="10" Opacity=".2"/>
                            <Path x:Name="CheckIcon" Fill="{StaticResource CheckIconColorKey}" Stretch="Fill" Height="10" Margin="1,1,0,1.5" Width="10.5" Opacity="0" Data="F1 M 335.226,344.226L 335.21,344.194L 336.283,343.393L 337.866,345.351L 340.913,340.038L 342.741,340.741L 338.351,347.616L 337.319,347.601L 335.226,344.226 Z"/>
                            <Rectangle x:Name="IndeterminateIcon" Fill="{StaticResource GlyphBrushKey}" Height="2" Width="6" Opacity="0"/>
                            <Rectangle x:Name="DisabledVisualElement" Fill="{StaticResource DisabledBackgroundBrushKey}" RadiusX="0" RadiusY="0" Height="16" Width="16" Opacity="0"/>
                            <Rectangle x:Name="ContentFocusVisualElement" Stroke="#848484" StrokeThickness="0" RadiusX="0" RadiusY="0" Height="16" Width="16" IsHitTestVisible="false" Opacity="0"/>
                            <Border x:Name="ValidationErrorElement" Margin="1" Visibility="Collapsed" BorderBrush="#FFDB000C" BorderThickness="1" CornerRadius="0" ToolTipService.PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                                           <ToolTipService.ToolTip>
                                    <ToolTip x:Name="validationTooltip" DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}" Template="{StaticResource ValidationToolTipTemplate}" Placement="Right" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToolTip.Triggers>
                                            <EventTrigger RoutedEvent="Canvas.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="validationTooltip" Storyboard.TargetProperty="IsHitTestVisible">
                                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                                <DiscreteObjectKeyFrame.Value>
                                                                    <System:Boolean>true</System:Boolean>
                                                                </DiscreteObjectKeyFrame.Value>
                                                            </DiscreteObjectKeyFrame>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ToolTip.Triggers>
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                                <Grid Height="10" HorizontalAlignment="Right" Margin="0,-4,-4,0" VerticalAlignment="Top" Width="10" Background="Transparent">
                                    <Path Fill="#FFDC000C" Margin="0,3,0,0" Data="M 1,0 L5,0 A 2,2 90 0 1 7,2 L7,6 z"/>
                                    <Path Fill="#ffffff" Margin="0,3,0,0" Data="M 0,0 L2,0 L 7,5 L7,7"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

