<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Grid">

    <LinearGradientBrush x:Key="LightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#FFF" Offset="0.0"/>
                <GradientStop Color="#EEE" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="validationBG" Color="#FFFFE1"/>
    <SolidColorBrush x:Key="SolidBorderBrush" Color="#888" />
    <SolidColorBrush x:Key="BackBrush" Color="#FAFAD2" />

    <DataTemplate x:Key="tooltipTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource LightBrush}"
            BorderBrush="{StaticResource SolidBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            >
            <TextBlock Text="{Binding Path=CellValue}" Padding="2" />
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="customTooltipTemplate">
        <Border Name="Border"
                Background="{StaticResource LightBrush}"
                BorderBrush="{StaticResource SolidBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <ContentControl Content="{Binding Path=ToolTip}" Padding="2" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="datavalidationtooltipTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource validationBG}"
            BorderBrush="{StaticResource SolidBorderBrush}"
            BorderThickness="1"
            >
            <TextBlock Text="{Binding Path=DataValidationTooltip}" Padding="2" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="cellTemplate">
        <Border    
            Name="Border"
            Background="{StaticResource BackBrush}"
            BorderBrush="{StaticResource SolidBorderBrush}"
            BorderThickness="1"
            
            >
            <TextBlock Text="{Binding Path=Comment}" Padding="2" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="errorTemplate">
        <Border 
                    Name="Border"
                    Background="{Binding Path=ErrorInfo.ErrorTooltipBackgroundBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    >
            <TextBlock  Text="{Binding Path=ErrorInfo.ErrorMessage}" Foreground="{Binding Path=ErrorInfo.ErrorTooltipForegroundBrush}" Padding="2" />
        </Border>
    </DataTemplate>

</ResourceDictionary>
