<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Syncfusion.Windows.Controls.Grid"
    xmlns:sfgridcommon="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.GridCommon.Silverlight">

    <Style TargetType="local:GridTreeControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GridTreeControl">
                    <Border
                           Name="PART_Border"
                           BorderThickness="1,1,1,0"
                           Background="Transparent"
                          >
                        <sfgridcommon:ScrollableContentViewer
                                  Name="PART_ScrollViewer"
                                  CanContentScroll="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{TemplateBinding ScrollViewerStyle}"
                                   >
                            <local:GridTreeControlImpl
                                                       Name="PART_GridControl"
                                                             />

                        </sfgridcommon:ScrollableContentViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:GridTreeHeaderCellControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GridTreeHeaderCellControl">
                    <Border Padding="0"                                                    
                            Name="PART_MainBorder" >

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="MouseOver" >
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_MainBorder" Storyboard.TargetProperty="Background" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0" />
                                        </ObjectAnimationUsingKeyFrames>                                       
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_MainBorder" Storyboard.TargetProperty="BorderBrush" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_TextBlock" Storyboard.TargetProperty="Foreground" Duration="0">
                                            <DiscreteObjectKeyFrame KeyTime="0" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid Name="PART_MainGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="textBorder" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" 
                                       HorizontalAlignment="Stretch"   Background="Transparent">
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                        Name="PART_TextBlock" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Stretch"                               
                                       Text="{TemplateBinding Text}"
                                       Margin="2,2,2,2"
                                       
                                 />
                            </Border>
                            <Border x:Name="sortBorder" Grid.Row="0"
                                Grid.Column="1" Background="Transparent" BorderThickness="1"
                                    Visibility="{Binding Path=SortVisibility, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">

                                <Grid Name="PART_SortGrid"                          
                               Height="9.87" Width="10.84"
                                Visibility="{Binding Path=SortVisibility, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                >
                                    
                                    <Path 
                                x:Name="BorderStyleAsc"
                                Stretch="Fill"
                                Fill="{Binding Path=SortBrush, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                Data="F1 M 146.529,135.153L 156.997,145.62L 136.061,145.62L 146.529,135.153 Z"
                                Visibility="{Binding Path=AscVisibility, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>

                                    <Path x:Name="BorderStyleDesc"
                                  Stretch="Fill"
                                  Fill="{Binding Path=SortBrush, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  Data="F1 M 101,104.333L 104.333,100.999L 107.667,97.6667L 101,97.6667L 94.3333,97.6667L 97.6667,100.999L 101,104.333 Z "
                                  Visibility="{Binding Path=DescVisibility, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>

                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:GridTreeExpanderCellControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GridTreeExpanderCellControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Image Name="PART_GLYPH" Grid.Column="0" Margin="0,5,0,5" VerticalAlignment="{TemplateBinding VerticalAlignment}"></Image>
                        <Image Name="PART_NODEIMAGE" Grid.Column="1" Stretch="Fill"  Margin="0,3,0,3" VerticalAlignment="Center" HorizontalAlignment="Left"></Image>
                        <TextBlock Name="PART_TextBlock" Grid.Column="2" VerticalAlignment="{TemplateBinding VerticalAlignment}"></TextBlock>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:GridTreeExpanderCellControlExt">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GridTreeExpanderCellControlExt">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Image Name="PART_GLYPH" Grid.Column="0" Margin="0,5,0,5" VerticalAlignment="{TemplateBinding VerticalAlignment}"></Image>
                        <Image Name="PART_NODEIMAGE" Grid.Column="1" Stretch="Fill" Margin="0,3,0,3" VerticalAlignment="Center" HorizontalAlignment="Left"></Image>
                        <Border Padding="0"    Name="Part_Border" Margin="{TemplateBinding BorderMargin}" Height="{TemplateBinding Height}" Child="{TemplateBinding ChildElement}" Grid.Column="2"   ></Border>                       

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
