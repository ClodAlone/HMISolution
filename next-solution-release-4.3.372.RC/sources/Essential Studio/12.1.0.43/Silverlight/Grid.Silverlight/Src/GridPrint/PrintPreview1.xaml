<controls:ChildWindow x:Class="Syncfusion.Windows.Controls.Grid.GridPrint.PrintPreview1"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
           xmlns:controls="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls"                     
            Width="517" Height="453" 
           Title="Print Preview" x:Name="printpreview">

    <Grid Margin="15">               
        <Grid>            
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>               
            </Grid.RowDefinitions>
            
            <StackPanel Name="Multipagestack" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible" Grid.Row="0" Orientation="Horizontal" Margin="0,-20,0,0">
                <Button Click="FirstPage_Click" Height="25" Name="FirstPage" Margin="6,0,2,0" MinWidth="25">
                    <Button.Content>
                        <Image Source="/Syncfusion.Grid.Silverlight;component/GridPrint/Images/FirstEnable.png" Width="16" Height="16"/>
                    </Button.Content>
                </Button>
                <Button Click="PageDecrease_Click" Height="25" Name="PageDecrease" Margin="6,0,2,0" MinWidth="25">
                    <Button.Content>
                        <Image Source="/Syncfusion.Grid.Silverlight;component/GridPrint/Images/PreviousEnable.png" Width="16" Height="16"/>
                    </Button.Content>
                </Button>
                <TextBlock VerticalAlignment="Center" FontSize="12" Margin="3,0,2,0" Text="Page"/>
                <TextBox Name="CurrentPageBox" Text="1" Height="25" IsReadOnly="True"  MinWidth="30" MinHeight="10"></TextBox>
                <TextBlock VerticalAlignment="Center" FontSize="12" Margin="1,0,0,0" Text="{Binding Path=PageCount,ElementName=printpreview,StringFormat=' of {0}'}" ></TextBlock>
                <Button Click="PageIncrease_Click" Height="25"  Name="PageIncrease" Margin="3,0,5,0" MinWidth="25">
                    <Button.Content>
                        <Image Source="/Syncfusion.Grid.Silverlight;component/GridPrint/Images/NextEnable.png" Width="16" Height="16"/>
                    </Button.Content>
                </Button>
                <Button Click="LastPage_Click" Name="LastPage" Height="25" Margin="6,0,2,0" MinWidth="25">
                    <Button.Content>
                        <Image Source="/Syncfusion.Grid.Silverlight;component/GridPrint/Images/LastEnable.png" Width="16" Height="16"/>
                    </Button.Content>
                </Button>
                <Button  Margin="6,3,3,3" MinWidth="25" Height="25" Click="OnPrintClick">
                    <Button.Content>
                        <Image Source="/Syncfusion.Grid.Silverlight;component/GridPrint/Images/printer.png" Width="16" Height="16"/>
                    </Button.Content>
                </Button>
                <Button  Margin="6,3,0,3" MinWidth="25" Height="25" Click="OnCancelClick">
                    <Button.Content>
                        <Image Source="/Syncfusion.Grid.Silverlight;component/GridPrint/Images/cancel.png" Width="16" Height="16"/>
                    </Button.Content>
                </Button>
                <ComboBox Name="PageSizeCombo" Width="70" Height="25"   Margin="9,0,5,0" SelectedIndex="4" SelectionChanged="PageSizeCombo_SelectionChanged">
                    <ComboBoxItem>ISOA0</ComboBoxItem>
                    <ComboBoxItem >ISOA1</ComboBoxItem>
                    <ComboBoxItem>ISOA2</ComboBoxItem>
                    <ComboBoxItem>ISOA3</ComboBoxItem>
                    <ComboBoxItem>ISOA4</ComboBoxItem>
                    <ComboBoxItem>ISOA5</ComboBoxItem>
                    <ComboBoxItem>ISOA6</ComboBoxItem>
                    <ComboBoxItem>ISOA7</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            
            <Border Background="White" Height="Auto" Width="Auto"  BorderThickness="1" BorderBrush="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1">
                <!--<Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">-->
                    <!--<Border Margin="{Binding PageMargin}" VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="Red">-->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalAlignment="Center" HorizontalAlignment="Center"
                          VerticalScrollBarVisibility="Auto"
                          >
                            <ContentPresenter x:Name="layoutContent"  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </ScrollViewer>
                    <!--</Border>-->
                <!--</Viewbox>-->
            </Border>
            
        </Grid>
    </Grid>
</controls:ChildWindow>