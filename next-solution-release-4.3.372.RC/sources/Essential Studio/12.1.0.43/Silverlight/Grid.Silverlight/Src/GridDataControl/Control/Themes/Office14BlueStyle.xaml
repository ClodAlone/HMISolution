                                              StrokeThickness="1" />

                                        <Path Width="1"
                                              Height="7"
                                              Margin="0,0,-2,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M7.8333325,4.2499995 L7.012101,12.2499995"
                                              Fill="Transparent"
                                              Stretch="Fill"
                                              Stroke="#FF6F7A85"
                                              StrokeThickness="1" />

                                        <Path Width="1"
                                              Height="6"
                                              Margin="0,0,-4,0"
