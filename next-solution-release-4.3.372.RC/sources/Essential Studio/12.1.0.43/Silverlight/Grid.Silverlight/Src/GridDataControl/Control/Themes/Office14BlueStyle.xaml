                                   Opacity="0"
                                   RadiusX="2"
                                   RadiusY="2"
                                   Stroke="#FF6DBDD1"
                                   StrokeThickness="1" />
                        <Border x:Name="ValidationErrorElement"
                                BorderBrush="#FFDB000C"
                                BorderThickness="1"
                                CornerRadius="1"
