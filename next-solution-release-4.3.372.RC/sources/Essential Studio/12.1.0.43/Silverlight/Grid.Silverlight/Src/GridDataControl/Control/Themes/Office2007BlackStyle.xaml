    <SolidColorBrush x:Key="SubItemMouseHoverBorderBrushKey" Color="Orange"/>


    <SolidColorBrush x:Key="ExtendButtonFillKey" Color="Black" />

    <SolidColorBrush x:Key="PopUpShadowBrushKey" Color="DarkGray" />

    <SolidColorBrush x:Key="PopUpBackgroundBrush" Color="#FFF0F0F0" />

    <SolidColorBrush x:Key="PopUpBorderBrush" Color="#FFB2B2B2" />

    <SolidColorBrush x:Key="PopUpLeftBackgroundBrush" Color="#FFF1F1F1" />

    <Style x:Key="Office2007BlackMenuItemStyle" TargetType="shared:MenuItemAdv">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="5" />
        <Setter Property="Foreground" Value="{StaticResource MenuItemForegroundBrushKey}" />
        <Setter Property="Padding" Value="4,3,2,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shared:MenuItemAdv">
                    <Grid x:Name="menuItemAdvGrid">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SubItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuItemContent" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuItemDisabledForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="GestureTextBlock" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuItemDisabledForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExtendButton" Storyboard.TargetProperty="Path.Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="FadeAnimation">
                                    <Storyboard x:Name="Fade">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PopUpBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                                            <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MenuItemSelected">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MenuItemFocused">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MenuItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuItemContent" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Black" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="SubMenuItemFocused">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SubItemHoverBorder" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                        </Grid.ColumnDefinitions>

                        <!--  <Border x:Name="Border" Grid.ColumnSpan="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>  -->
                        <Border x:Name="MenuItemHoverBorder"
                                Grid.ColumnSpan="5"
                                Margin="1,2,2,0"
                                Background="{StaticResource MenuItemMouseHoverBackgroundBrushKey}"
                                BorderBrush="{StaticResource MenuItemMouseHoverBorderBrushKey}"
                                BorderThickness="1"
                                Opacity="0" />
                        <Border x:Name="SubItemBorder"
                                Grid.ColumnSpan="5"
                                Margin="2,0,2,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2" />
                        <Border x:Name="SubItemHoverBorder"
                                Grid.ColumnSpan="5"
                                Margin="2,0,2,0"
                                Background="{StaticResource SubItemMouseHoverBackgroundBrushKey}"
                                BorderBrush="{StaticResource SubItemMouseHoverBorderBrushKey}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Opacity="0" />

                        <Grid x:Name="IconGrid"
                              Grid.Column="0"
                              MinWidth="25"
                              MinHeight="25">
                            <ContentControl x:Name="IconContent"
                                            Width="25"
                                            Height="25"
                                            Margin="3,3,3,-1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                            <CheckBox x:Name="CheckBoxPanel"
                                      Style="{TemplateBinding CheckBoxStyle}"
                                      Visibility="{TemplateBinding CheckBoxVisibility}" />
                            <RadioButton x:Name="RadioButtonPanel"
                                         Style="{TemplateBinding RadioButtonStyle}"
                                         Visibility="{TemplateBinding RadioButtonVisibility}" />
                        </Grid>

                        <ContentControl x:Name="MenuItemContent"
                                        Grid.Column="2"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                                        Foreground="{TemplateBinding Foreground}" />
                        <TextBlock x:Name="GestureTextBlock"
                                   Grid.Column="3"
                                   Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Text="{TemplateBinding InputGestureText}"
                                   Visibility="Collapsed" />

                        <Border Grid.Column="4" Visibility="{TemplateBinding ExtendButtonVisibility}">
                            <Path Name="ExtendButton"
                                  Grid.Column="5"
                                  Width="3"
                                  Height="5"
                                  HorizontalAlignment="Left"
                                  Data="M129,173 L129,282 L246,222 z"
                                  Fill="{StaticResource ExtendButtonFillKey}"
                                  Stretch="Fill"
                                  Stroke="{StaticResource ExtendButtonFillKey}"
                                  UseLayoutRounding="False" />
                        </Border>

                        <Popup x:Name="SubMenuPopup">
                            <Border x:Name="PopUpBorder"
                                    Background="Transparent"
                                    BorderBrush="Transparent">
                                <Border Margin="2.5,2.5,0,0" Background="{StaticResource PopUpShadowBrushKey}">
                                    <Border Margin="-2.5,-2.5,3,3"
                                            Background="{StaticResource PopUpBackgroundBrush}"
                                            BorderBrush="{StaticResource PopUpBorderBrush}"
                                            BorderThickness="0.7">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Button x:Name="PART_TopScroll"
                                                    Grid.Row="0"
                                                    Height="{TemplateBinding ScrollerHeight}"
                                                    Style="{TemplateBinding TopScrollButtonStyle}"
                                                    Visibility="Collapsed" />
                                            <Grid x:Name="PopUpGrid" Grid.Row="1">
                                                <Rectangle Width="26"
                                                           Margin="0,0,5,4"
                                                           HorizontalAlignment="Left"
                                                           Fill="{StaticResource PopUpLeftBackgroundBrush}"
                                                           RadiusX="2"
                                                           RadiusY="2" />
                                                <Rectangle Width="1"
                                                           Margin="26,0,0,0"
                                                           HorizontalAlignment="Left"
                                                           Fill="LightGray" />
                                                <Rectangle Width="1"
                                                           Margin="27,0,0,0"
                                                           HorizontalAlignment="Left"
                                                           Fill="White" />
                                                <ScrollViewer x:Name="PART_ScrollViewer"
                                                              BorderBrush="Transparent"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Padding="0"
                                                              VerticalScrollBarVisibility="Hidden">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Grid>
                                            <Button x:Name="PART_BottomScroll"
                                                    Grid.Row="2"
                                                    Height="{TemplateBinding ScrollerHeight}"
                                                    Style="{TemplateBinding BottomScrollButtonStyle}"
                                                    Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                </Border>
                                <Border.RenderTransform>
                                    <CompositeTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Border.Projection>
                                    <PlaneProjection />
                                </Border.Projection>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Office2007BlackMenuItemStyle}" TargetType="shared:MenuItemAdv" />


</ResourceDictionary>
