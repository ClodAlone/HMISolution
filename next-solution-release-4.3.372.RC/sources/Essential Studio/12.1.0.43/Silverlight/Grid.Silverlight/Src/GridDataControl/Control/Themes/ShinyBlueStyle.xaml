    <Style x:Key="ShinyBlueCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrushKey.ShinyBlue}" />
        <Setter Property="Foreground" Value="{StaticResource ShinyBlueCheckBoxForeground}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="4,1,0,0" />
