                                Opacity="0" />
                        <Border x:Name="FocusVisualElement"
                                Margin="1"
                                BorderBrush="{StaticResource ButtonBackgroundBrushKey.ShinyBlue}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                IsHitTestVisible="False"
                                Opacity="0" />
