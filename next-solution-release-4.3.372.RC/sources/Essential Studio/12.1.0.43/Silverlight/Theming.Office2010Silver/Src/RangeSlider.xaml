            <!--<Path Width="7.83331" x:Name="paththumb" Height="13.0976" Stretch="Fill" StrokeLineJoin="Round" Stroke="#FFF0C132" Fill="{StaticResource RangeSliderThumbBrushKey}" Data="F1 M 972.308,16.6385L 979.142,16.6385L 979.142,25.7218L 978.817,25.7218L 975.706,28.7361L 972.631,25.7218L 972.308,25.7218L 972.308,16.6385 Z ">
            </Path>-->
