<?xml version="1.0" encoding="utf-8" ?>
<xs:schema id="DLSMetaSchema" targetNamespace="http://tempuri.org/DLSMetaSchema.xsd" elementFormDefault="qualified"
  xmlns="http://tempuri.org/DLSMetaSchema.xsd" xmlns:mstns="http://tempuri.org/DLSMetaSchema.xsd"
  xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="meta-schema">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="root">
          <xs:complexType>
            <xs:sequence></xs:sequence>
            <xs:attribute name="name" type="xs:string" />
            <xs:attribute name="type" type="xs:string" />
          </xs:complexType>
        </xs:element>
        <xs:element name="type">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="group" type="group"></xs:element>
              <xs:element name="attribute">
                <xs:complexType>
                  <xs:sequence />
                  <xs:attributeGroup ref="nameTypeAttr" />
                  <xs:attribute name="fixed" type="xs:string" />
                </xs:complexType>
              </xs:element>
              <xs:element name="element" type="element"></xs:element>
              <xs:element name="enum">
                <xs:complexType>
                  <xs:sequence></xs:sequence>
                  <xs:attribute name="value" type="xs:string" />
                </xs:complexType>
              </xs:element>
              <xs:element name="extention">
                <xs:complexType>
                  <xs:sequence />
                  <xs:attribute name="ref" type="xs:string" />
                </xs:complexType>
              </xs:element>
              <xs:element name="pattern">
                <xs:complexType>
                  <xs:sequence />
                  <xs:attribute name="value" type="xs:string" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" />
            <xs:attribute name="mode" type="typeMode" />
          </xs:complexType>
        </xs:element>
        <xs:element name="group" type="group" />
        <xs:element name="include">
          <xs:complexType>
            <xs:sequence />
            <xs:attribute name="name" type="xs:string" />
            <xs:attribute name="namespace" type="xs:string" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="element">
    <xs:sequence />
    <xs:attributeGroup ref="nameTypeAttr" />
  </xs:complexType>
  <xs:attributeGroup name="nameTypeAttr">
    <xs:attribute name="name" type="xs:string" />
    <xs:attribute name="type" type="xs:string" />
  </xs:attributeGroup>
  <xs:complexType name="group">
    <xs:sequence></xs:sequence>
    <xs:attribute name="name" type="xs:string" />
    <xs:attribute name="item" type="xs:string" />
    <xs:attribute name="type" type="xs:string" />
    <xs:attribute name="ref" type="xs:string" />
  </xs:complexType>
  <xs:simpleType name="typeMode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="seq" />
      <xs:enumeration value="choice" />
      <xs:enumeration value="enum" />
      <xs:enumeration value="pattern" />
      <xs:enumeration value="grouping" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>