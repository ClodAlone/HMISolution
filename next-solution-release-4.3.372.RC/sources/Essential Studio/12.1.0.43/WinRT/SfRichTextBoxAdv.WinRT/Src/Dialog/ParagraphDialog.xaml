<sync:WindowControl x:Class="Syncfusion.UI.Xaml.Controls.ParagraphDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="paragraphDialog"
     xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows" VisualStyle="Aero"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" AnimationType="None" ResizeMode="NoResize" Height="260" Width="525"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" WindowStartupLocation="CenterScreen" mc:Ignorable="d" 
    xmlns:sync="clr-namespace:Syncfusion.UI.Xaml.Controls;assembly=Syncfusion.Shared.WinRT"
    xmlns:Syncfusion="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.Shared.WinRT" 
    xmlns:shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WinRT"
    Title="Paragraph" IconSize="0,0" >
    
    <StackPanel x:Name="LayoutRoot"  Background="#F0F0F0" Margin="-1,-4,-1,-1">
        <Border Background="White" BorderBrush="Gray" BorderThickness="1" Margin="0" CornerRadius="0" >
           <Grid Margin="5">
           		<Grid.ColumnDefinitions>
           			<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>       		
				</Grid.ColumnDefinitions>      
				 <Grid Margin="7" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="65" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0">
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="5,0,0,0">
                            <TextBlock Text="General" HorizontalAlignment="Left" FontSize="12" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="10,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Alignment" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Name="cmbalignment" SelectedIndex="0" Margin="5,5,0,5"  Width="100" HorizontalAlignment="Left">
                                <ComboBoxItem >Left</ComboBoxItem>
                                <ComboBoxItem>Centered</ComboBoxItem>
                                <ComboBoxItem>Right</ComboBoxItem>
                                <ComboBoxItem>Justified</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="5,0,0,0">
                            <TextBlock Text="Indentation" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Left [inch]" />
                            <Syncfusion:NumericUpDown  x:Name="leftIndention" Margin="5"  Grid.Column="1" Increment="0.1" DecimalPlaces="1" HorizontalAlignment="Left" Width="100" Height="22">
                                
                            </Syncfusion:NumericUpDown>
                            <TextBlock Grid.Row="4" Margin="8,0,0,0" VerticalAlignment="Center"  Text="Right [inch]" d:LayoutOverrides="GridBox"/>
                            <Syncfusion:NumericUpDown x:Name="rightIndention" Margin="5" HorizontalAlignment="Left" Increment="0.1" DecimalPlaces="1" Width="100" Grid.Column="1" Grid.Row="1"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
			
                <Border Grid.Column="1" Margin="8,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="5">
                            <TextBlock Text="Spacing" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="10,5,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Before [pt]"  />
                            <Syncfusion:NumericUpDown Grid.Column="1" x:Name="beforeSpacing" HorizontalAlignment="Left" Increment="6" Margin="5" Width="100"   />
                            <TextBlock Grid.Row="1" Margin="7,0,0,0" VerticalAlignment="Center" Text="After [pt]"/>
                            <Syncfusion:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="afterSpacing"  Width="100" Margin="5" Increment="6" HorizontalAlignment="Left" />
                            <!--<TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Line Spacing:" Grid.Column="2" />-->
                            <TextBlock Text="Mulitiple Spacing At" Grid.Row="2" Grid.Column="0" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            <!--<TextBlock Margin="7,0,0,0" Grid.Column="3" VerticalAlignment="Center" Text="At:" />-->
                            <Syncfusion:NumericUpDown HorizontalAlignment="Left" x:Name="linespacing" DecimalPlaces="2" VerticalAlignment="Center" Increment="0.5" Value="1" Width="100" Margin="5" Grid.Column="1" Grid.Row="2" />
                        </Grid>
                    </Grid>
                </Border>
		   </Grid>
        </Border>

        <Grid HorizontalAlignment="Right" Margin="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"></ColumnDefinition>
                <ColumnDefinition Width="84"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Width="75" HorizontalAlignment="left" Grid.Column="0" Margin="4,4,0,8"   Content="OK" Click="btnAccept_Click" />
            <Button Name="btnAccept" Content="Cancel"  Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Width="75" Margin="0,4,4,8" Click="Button_Click"/>
        </Grid>
    </StackPanel>
</sync:WindowControl>
