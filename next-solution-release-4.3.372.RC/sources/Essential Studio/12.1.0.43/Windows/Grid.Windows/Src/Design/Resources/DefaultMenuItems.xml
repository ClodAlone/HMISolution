<?xml version="1.0" encoding="utf-8"?>
<MenuDefinition xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" MenuName="Main Menu">
  <MenuItems>
	<MenuItemStruct>
		<text>&amp;File</text>
		<children>
			<MenuItemStruct>
				<text>&amp;Load from Xml</text>
				<shortcutText>Opens a file from an Xml formatted file</shortcutText>
				<eventHandler>LoadFromXml</eventHandler>
			</MenuItemStruct>
			<MenuItemStruct>
				<text>&amp;Save to Xml</text>
				<shortcutText>Saves grid to an Xml formatted file</shortcutText>
				<eventHandler>SaveToXml</eventHandler>
			</MenuItemStruct>
			<MenuItemStruct>
				<text>-</text>
			</MenuItemStruct>
			<MenuItemStruct>
				<text>&amp;Load from Template</text>
				<shortcutText>Opens a file from a SOAP template file</shortcutText>
				<eventHandler>LoadFromTemplate</eventHandler>
			</MenuItemStruct>
			<MenuItemStruct>
				<text>&amp;Save to Template</text>
				<shortcutText>Saves grid to a SOAP formatted file</shortcutText>
				<eventHandler>SaveToTemplate</eventHandler>
			</MenuItemStruct>
			<MenuItemStruct>
				<text>-</text>
			</MenuItemStruct>
			<MenuItemStruct>
				<text>E&amp;xit</text>
				<iconResource>CancelIcon</iconResource>
				<shortcutText>Close Editor</shortcutText>
				<eventHandler>ExitProgram</eventHandler>
			</MenuItemStruct>
		</children>
	</MenuItemStruct>
	<MenuItemStruct>
		<text>&amp;Edit</text>
		
		<children>
		<MenuItemStruct>
			<text>&amp;Undo</text>
			<iconResource>UndoIcon</iconResource>
			<shortcutText>Undo last action</shortcutText>
			
			<shortcut>CtrlZ</shortcut>
			<eventHandler>UndoAction</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>&amp;Redo</text>
			<iconResource>RedoIcon</iconResource>
			<shortcutText>Redo last undo action</shortcutText>
			
			<shortcut>CtrlY</shortcut>
			<eventHandler>RedoAction</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>-</text>
			
		</MenuItemStruct>
		<MenuItemStruct>
			<text>Cu&amp;t</text>
			<iconResource>CutIcon</iconResource>
			<shortcutText>Cut selection to clipboard</shortcutText>
			
			<shortcut>CtrlX</shortcut>
			<eventHandler>CutAction</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>&amp;Copy</text>
			<iconResource>CopyIcon</iconResource>
			<shortcutText>Copy selection to clipboard</shortcutText>
			
			<shortcut>CtrlC</shortcut>
			<eventHandler>CopyAction</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>&amp;Paste</text>
			<iconResource>PasteIcon</iconResource>
			<shortcutText>Paste text from clipboard</shortcutText>
			
			<shortcut>CtrlV</shortcut>
			<eventHandler>PasteAction</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>&amp;Delete</text>
			<iconResource>DeleteIcon</iconResource>
			<shortcutText>Delete selection</shortcutText>
			
			<eventHandler>DeleteAction</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>-</text>
			
		</MenuItemStruct>
		<MenuItemStruct>
			<text>Remove Rows</text>
			<shortcutText>Remove selected rows from grid</shortcutText>
			
			<eventHandler>RemoveRows</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>Remove Columns</text>
			<shortcutText>Remove selected columns from grid</shortcutText>
			
			<eventHandler>RemoveCols</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>Insert Row</text>
			<shortcutText>Insert rows before current cell</shortcutText>
			
			<eventHandler>InsertRows</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>Insert Column</text>
			<shortcutText>Insert column before current cell</shortcutText>
			
			<eventHandler>InsertCols</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>-</text>
			
		</MenuItemStruct>
		<MenuItemStruct>
			<text>&amp;Find</text>
			<iconResource>FindIcon</iconResource>
			<shortcutText>Find text</shortcutText>
			
			<shortcut>CtrlF</shortcut>
			<eventHandler>Find</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>&amp;Replace</text>
			<iconResource>ReplaceIcon</iconResource>
			<shortcutText>Replace text</shortcutText>
			
			<shortcut>CtrlR</shortcut>
			<eventHandler>Replace</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>Find &amp;Next</text>
			<iconResource>FindNextIcon</iconResource>
			<shortcutText>Find next</shortcutText>
			
			<shortcut>F3</shortcut>
			<eventHandler>FindNext</eventHandler>
		</MenuItemStruct>
		</children>
	</MenuItemStruct>
	<MenuItemStruct>
		<text>&amp;Format</text>
		
		<children>
		<MenuItemStruct>
			<text>Freeze &amp;Columns</text>
			<shortcutText>Freeze Columns</shortcutText>
			
			<eventHandler>FreezeColumns</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>Release Co&amp;lumns</text>
			<shortcutText>Release Columns</shortcutText>
			
			<eventHandler>ReleaseColumns</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>Freeze &amp;Rows</text>
			<shortcutText>Freeze Rows</shortcutText>
			
			<eventHandler>FreezeRows</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>Release Ro&amp;ws</text>
			<shortcutText>Release Rows</shortcutText>
			
			<eventHandler>ReleaseRows</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>-</text>
			
		</MenuItemStruct>
		<MenuItemStruct>
			<text>&amp;Cover Cells</text>
			<shortcutText>Convert active selection to a covered cell</shortcutText>
			
			<eventHandler>CoverCell</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>&amp;Reset Covered Cell</text>
			<shortcutText>Convert covered cell to individual cells</shortcutText>
			
			<eventHandler>ResetCover</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>-</text>
			
		</MenuItemStruct>
		<MenuItemStruct>
			<text>&amp;Align</text>
			
			<children>
			<MenuItemStruct>
				<text>&amp;Left</text>
				<iconResource>AlignLeftIcon</iconResource>
				<shortcutText>Align left</shortcutText>
				
				<eventHandler>AlignLeft</eventHandler>
			</MenuItemStruct>
			<MenuItemStruct>
				<text>&amp;Center</text>
				<iconResource>AlignCenterIcon</iconResource>
				<shortcutText>Center text in cell</shortcutText>
				
				<eventHandler>AlignCenter</eventHandler>
			</MenuItemStruct>
			<MenuItemStruct>
				<text>&amp;Right</text>
				<iconResource>AlignRightIcon</iconResource>
				<shortcutText>Align right</shortcutText>
				
				<eventHandler>AlignRight</eventHandler>
			</MenuItemStruct>
			</children>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>&amp;Font Style</text>
			
			<children>
			<MenuItemStruct>
				<text>&amp;Bold</text>
				<iconResource>FontBoldIcon</iconResource>
				<shortcutText>Make font bold</shortcutText>
				
				<eventHandler>FontStyleBold</eventHandler>
			</MenuItemStruct>
			<MenuItemStruct>
				<text>&amp;Italic</text>
				<iconResource>FontItalicIcon</iconResource>
				<shortcutText>Make font italic</shortcutText>
				
				<eventHandler>FontStyleItalic</eventHandler>
			</MenuItemStruct>
			<MenuItemStruct>
				<text>&amp;Underline</text>
				<iconResource>FontUnderlineIcon</iconResource>
				<shortcutText>Make font unerlined</shortcutText>
				
				<eventHandler>FontStyleUnderline</eventHandler>
			</MenuItemStruct>
			</children>
		</MenuItemStruct>
		</children>
	</MenuItemStruct>
	<MenuItemStruct>
		<text>&amp;Help</text>
		
		<children>
		<MenuItemStruct>
			<text>&amp;Help Topics</text>
			<iconResource>HelpIcon</iconResource>
			<shortcutText>Open custom helpfile (see File-&amp;gt;Options)</shortcutText>
			
			<shortcut>F1</shortcut>
			<eventHandler>CustomHelp</eventHandler>
		</MenuItemStruct>
		<MenuItemStruct>
			<text>-</text>
			
		</MenuItemStruct>
		<MenuItemStruct>
			<text>&amp;About</text>
			<iconResource>AboutIcon</iconResource>
			<shortcutText>About ObjectGrid</shortcutText>
			
			<eventHandler>AboutObjectGrid</eventHandler>
		</MenuItemStruct>
		</children>
	</MenuItemStruct>
  </MenuItems>
</MenuDefinition>