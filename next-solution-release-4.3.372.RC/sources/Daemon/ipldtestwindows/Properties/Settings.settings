<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="ipldtestwindows.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="FileFormatVersion" Type="System.String" Scope="Application">
      <Value Profile="(Default)">4.1.326</Value>
    </Setting>
    <Setting Name="LicenseSKUFile" Type="System.String" Scope="Application">
      <Value Profile="(Default)">&lt;?xml version="1.0" encoding="utf-8"?&gt;

&lt;!--

+ Editor Options:
DEV				: Editor (enable the Editor of the projects)
DBG				: Debugger (allow to attach to our process with a debugger otherwise the anti-debugger check inside our application will close the process)
WDEP			: WebClient WPF/SVG Deploy Command (enable the command inside the editor for deploying projects)

+ Runtime Options (yes/no):

CMD				: Movicon HMI Client Runtime
SVR				: I/O Data Server Runtime
DIS				: Alarm Dispatcher
SCD				: Scheduler

OUAS			: OPC UA Server
NTW				: Networking

+======+======+======================================================================================+
| OUAS | NRW | Description                                                                           +
+======+======+======================================================================================+
|  no  | no  | I/O Data Server will accept only local connections (no third parts OPC Clients)       |
+======+======+======================================================================================+
|  yes | no  | I/O Data Server will accept only local connections (third parts OPC Clients too)      |
+======+======+======================================================================================+
|  no  | yes | I/O Data Server will accept local or remote connections (no third parts OPC Clients)  |
+======+======+======================================================================================+
|  yes | yes | I/O Data Server will accept local or remote connections (third parts OPC Clients too) |
+======+======+======================================================================================+

LNX				: .NET Core Runtime Only
VB				: .NET Scripts
RED				: Redundancy
DLR				: Historian Manager
RCP				: Recipe Manager
REP				: Report Manager
GEO				: Geo SCADA
G3D				: 3D Graphics
ART				: Cognitive Augmented Reality
STA				: Downtime Analyzer

MDB				: Basic driver packages
AUT				: Automation driver packages
TLM				: Telemetry driver packages
FCS				: Facilities driver packages
IOT				: IoT driver packages

+ Runtime Options (numerical):

STG				: Server License Tags Nr.
DRV				: I/O Drivers Nr.
SCR				: HMI Screens Nr.
ALR				: Alarms Nr.
WCL5			: WebClients Nr.
NET				: Nr. Users for NET License
SIN				: Multiple Instance I/O Data Servers
PEN				: Pro.Energy Measures Nr.
PLN				: Pro.Lean OEE Nr.

--&gt;

&lt;root&gt;
	&lt;sku1&gt;
		&lt;DEV /&gt;&lt;SVR /&gt;&lt;RCP /&gt;&lt;VB /&gt;&lt;WDEP /&gt;&lt;OUAS /&gt;&lt;NTW /&gt;&lt;MDB /&gt;&lt;AUT /&gt;&lt;LNX /&gt;&lt;STG&gt;2000&lt;/STG&gt;&lt;DRV&gt;1&lt;/DRV&gt;&lt;SIN&gt;1&lt;/SIN&gt;
	&lt;/sku1&gt;
	&lt;sku2&gt;
		&lt;SVR /&gt;&lt;DLR /&gt;&lt;RCP /&gt;&lt;VB /&gt;&lt;WDEP /&gt;&lt;OUAS /&gt;&lt;REP /&gt;&lt;NTW /&gt;&lt;MDB /&gt;&lt;AUT /&gt;&lt;LNX /&gt;&lt;STG&gt;2000&lt;/STG&gt;&lt;DRV&gt;1&lt;/DRV&gt;&lt;WCL5&gt;2&lt;/WCL5&gt;&lt;ALR&gt;100000&lt;/ALR&gt;&lt;SIN&gt;1&lt;/SIN&gt;
	&lt;/sku2&gt;
	&lt;sku3&gt;
		&lt;SVR /&gt;&lt;DLR /&gt;&lt;CMD /&gt;&lt;RCP /&gt;&lt;VB /&gt;&lt;SCD /&gt;&lt;WDEP /&gt;&lt;REP /&gt;&lt;DIS /&gt;&lt;NTW /&gt;&lt;MDB /&gt;&lt;AUT /&gt;&lt;STG&gt;500&lt;/STG&gt;&lt;CTG&gt;100000&lt;/CTG&gt;&lt;DRV&gt;2&lt;/DRV&gt;&lt;CHLD&gt;16&lt;/CHLD&gt;&lt;WCL5&gt;1&lt;/WCL5&gt;&lt;ALR&gt;100000&lt;/ALR&gt;&lt;SCR&gt;100000&lt;/SCR&gt;&lt;SIN&gt;1&lt;/SIN&gt;
	&lt;/sku3&gt;
	&lt;sku4&gt;
		&lt;SVR /&gt;&lt;DLR /&gt;&lt;CMD /&gt;&lt;RCP /&gt;&lt;VB /&gt;&lt;SCD /&gt;&lt;WDEP /&gt;&lt;REP /&gt;&lt;DIS /&gt;&lt;NTW /&gt;&lt;MDB /&gt;&lt;AUT /&gt;&lt;STG&gt;2000&lt;/STG&gt;&lt;CTG&gt;100000&lt;/CTG&gt;&lt;DRV&gt;2&lt;/DRV&gt;&lt;CHLD&gt;16&lt;/CHLD&gt;&lt;WCL5&gt;1&lt;/WCL5&gt;&lt;ALR&gt;100000&lt;/ALR&gt;&lt;SCR&gt;100000&lt;/SCR&gt;&lt;SIN&gt;1&lt;/SIN&gt;
	&lt;/sku4&gt;
	&lt;sku5&gt;
		&lt;SVR /&gt;&lt;DLR /&gt;&lt;CMD /&gt;&lt;RCP /&gt;&lt;VB /&gt;&lt;SCD /&gt;&lt;WDEP /&gt;&lt;REP /&gt;&lt;DIS /&gt;&lt;NTW /&gt;&lt;MDB /&gt;&lt;AUT /&gt;&lt;STG&gt;5000&lt;/STG&gt;&lt;CTG&gt;100000&lt;/CTG&gt;&lt;DRV&gt;2&lt;/DRV&gt;&lt;CHLD&gt;16&lt;/CHLD&gt;&lt;WCL5&gt;1&lt;/WCL5&gt;&lt;ALR&gt;100000&lt;/ALR&gt;&lt;SCR&gt;100000&lt;/SCR&gt;&lt;PLN&gt;5&lt;/PLN&gt;&lt;SIN&gt;1&lt;/SIN&gt;
	&lt;/sku5&gt;
	&lt;sku6&gt;
		&lt;SVR /&gt;&lt;DLR /&gt;&lt;CMD /&gt;&lt;RCP /&gt;&lt;VB /&gt;&lt;SCD /&gt;&lt;WDEP /&gt;&lt;REP /&gt;&lt;DIS /&gt;&lt;NTW /&gt;&lt;MDB /&gt;&lt;AUT /&gt;&lt;STG&gt;20000&lt;/STG&gt;&lt;CTG&gt;100000&lt;/CTG&gt;&lt;DRV&gt;2&lt;/DRV&gt;&lt;CHLD&gt;16&lt;/CHLD&gt;&lt;WCL5&gt;1&lt;/WCL5&gt;&lt;ALR&gt;100000&lt;/ALR&gt;&lt;SCR&gt;100000&lt;/SCR&gt;&lt;PLN&gt;10&lt;/PLN&gt;&lt;SIN&gt;1&lt;/SIN&gt;
	&lt;/sku6&gt;
	&lt;sku7&gt;
		&lt;SVR /&gt;&lt;DLR /&gt;&lt;CMD /&gt;&lt;RCP /&gt;&lt;VB /&gt;&lt;SCD /&gt;&lt;WDEP /&gt;&lt;REP /&gt;&lt;DIS /&gt;&lt;NTW /&gt;&lt;MDB /&gt;&lt;AUT /&gt;&lt;STG&gt;2000&lt;/STG&gt;&lt;CTG&gt;100000&lt;/CTG&gt;&lt;DRV&gt;32&lt;/DRV&gt;&lt;CHLD&gt;16&lt;/CHLD&gt;&lt;WCL5&gt;1&lt;/WCL5&gt;&lt;ALR&gt;100000&lt;/ALR&gt;&lt;SCR&gt;100000&lt;/SCR&gt;&lt;PLN&gt;10&lt;/PLN&gt;&lt;SIN&gt;1&lt;/SIN&gt;
	&lt;/sku7&gt;
	&lt;sku8&gt;
		&lt;SVR /&gt;&lt;DLR /&gt;&lt;RCP /&gt;&lt;VB /&gt;&lt;WDEP /&gt;&lt;OUAS /&gt;&lt;REP /&gt;&lt;NTW /&gt;&lt;MDB /&gt;&lt;AUT /&gt;&lt;IOT /&gt;&lt;LNX /&gt;&lt;STG&gt;2000&lt;/STG&gt;&lt;DRV&gt;2&lt;/DRV&gt;&lt;WCL5&gt;2&lt;/WCL5&gt;&lt;ALR&gt;100000&lt;/ALR&gt;&lt;SIN&gt;1&lt;/SIN&gt;
	&lt;/sku8&gt;
&lt;/root&gt;</Value>
    </Setting>
    <Setting Name="SleepCycleTime" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">1000</Value>
    </Setting>
    <Setting Name="MaxCycleCount" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">0</Value>
    </Setting>
