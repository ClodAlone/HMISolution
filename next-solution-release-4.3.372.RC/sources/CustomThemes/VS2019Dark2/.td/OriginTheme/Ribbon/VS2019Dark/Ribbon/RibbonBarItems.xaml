<ControlTemplate x:Key="{dxrt:BarButtonGroupThemeKey ResourceKey=ResourceHolderTemplateInPageGroup}" TargetType="{x:Type ContentControl}"><ContentPresenter Content="{TemplateBinding Content}" /></ControlTemplate>

<Style x:Key="{dxrt:BarButtonGroupThemeKey ResourceKey=BorderStyle}" TargetType="{x:Type dxb:ItemBorderControl}" />

<ControlTemplate x:Key="{dxrt:BarButtonGroupThemeKey ResourceKey=CustomizationButtonTemplate}" TargetType="{x:Type dxr:RibbonCheckedBorderControl}"><TextBlock Text="{TemplateBinding Content}" /></ControlTemplate>

<Style x:Key="{dxrt:BarButtonGroupThemeKey ResourceKey=CustomizationButtonStyle}" TargetType="{x:Type dxr:RibbonCheckedBorderControl}"><Setter Property="Template" Value="{DynamicResource {dxrt:BarButtonGroupThemeKey ResourceKey=CustomizationButtonTemplate}}" /><Setter Property="VerticalAlignment" Value="Center" /></Style>

