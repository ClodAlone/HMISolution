<!-- General --><Style x:Key="{dxt:DefaultStyleThemeKey FullName=DevExpress.Xpf.Grid.RowDetailContainerControl}" TargetType="{x:Type dxg:RowDetailContainerControl}"><Setter Property="Background" Value="#FF252526" cs:id="Setter_0000" /><Setter Property="BorderBrush" Value="#FF3F3F46" cs:id="Setter_0001" /><Setter Property="Foreground" Value="#FFF1F1F1" cs:id="Setter_0002" /></Style>

<!-- RowSplitter --><Style x:Key="{dxt:DefaultStyleThemeKey FullName=DevExpress.Xpf.Grid.RowSplitter}" TargetType="{x:Type dxg:RowSplitter}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type dxg:RowSplitter}"><Grid x:Name="Root" Cursor="SizeNS"><Border x:Name="IsDefault" Background="#FF333337" BorderBrush="#FF3F3F46" BorderThickness="0,1,0,1" cs:id="Border_0001" /><Path Margin="3" Style="{StaticResource UIShape.SizeGrip.Horizontal}" /></Grid></ControlTemplate></Setter.Value></Setter></Style>

<!-- OptionToggleButton --><Style x:Key="{dxt:DefaultStyleThemeKey FullName=DevExpress.Xpf.Grid.OptionsToggleButton}" TargetType="{x:Type dxg:OptionsToggleButton}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type dxg:OptionsToggleButton}"><Grid x:Name="Root" Background="Transparent" Margin="0,0,0,-1" cs:id="Grid_0000"><Path x:Name="Content" Opacity="0.62" Style="{StaticResource UIShape.OptionsToggleButton}" /></Grid><ControlTemplate.Triggers><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsChecked" Value="False" /></MultiTrigger.Conditions><Setter Property="Opacity" TargetName="Content" Value="1" /></MultiTrigger><Trigger Property="IsChecked" Value="True"><Setter Property="Opacity" TargetName="Content" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

</ResourceDictionary>