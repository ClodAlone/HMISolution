ent"><dxdove:DockDependentDecorator BottomMargin="0" CaptionLocation="{Binding CaptionLocation}" LeftMargin="0" RightMargin="0" TopMargin="0"><Border x:Name="HeaderPart" Background="{TemplateBinding ActualBackground}" BorderBrush="#FF3F3F46" BorderThickness="{TemplateBinding ActualContentBorderThickness}" dxdove:DockPane.HitTestType="Content" cs:id="Border_0000"><dxdove:LayoutTabFastRenderPanel x:Name="PART_FastRenderPanel" dxdove:DockPane.HitTestType="Content" /></Border></dxdove:DockDependentDecorator></Grid></dxdove:DockingSplitLayoutPanel.Content2><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="ActiveStates"><VisualState x:Name="ActiveEmptyState" /><VisualState x:Name="Active" /><VisualState x:Name="Inactive" /><VisualState x:Name="Empty" /></VisualStateGroup><VisualStateGroup x:Name="HeaderStates"><VisualState x:Name="HeaderVisible" /><VisualState x:Name="HeaderHidden" /></VisualStateGroup></VisualStateManager.VisualStateGroups></dxdove:DockingSplitLayoutPanel><ControlTemplate.Triggers><Trigger Property="dx:ThemeManager.IsTouchEnabled" Value="True"><Setter Property="ButtonHeight" TargetName="PART_ControlBox" Value="44" /><Setter Property="ButtonWidth" TargetName="PART_ControlBox" Value="44" /><Setter Property="Margin" TargetName="PART_ControlBox" Value="0" /><Setter Property="MinHeight" TargetName="Root" Value="44" /></Trigger><Trigger Property="AreTabHeadersVisible" Value="False"><Setter Property="Visibility" TargetName="HeadersPanel" Value="Collapsed" /><Setter Property="Margin" TargetName="Root" Value="0" /><Setter Property="BorderThickness" TargetName="HeaderPart" Value="1" /></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="ViewStyle" Value="Light" /><Condition Property="AreTabHeadersVisible" Value="False" /></MultiTrigger.Conditions><Setter Property="BorderThickness" TargetName="HeaderPart" Value="0" /></MultiTrigger><Trigger Property="TabbedGroupDisplayMode" Value="ContentOnly"><Setter Property="BorderThickness" Target