                                  TargetName="PART_ContentContainer"
                                  ThrowIfInvalidTargetName="False"
                                  Value="$Foreground"
                                  cs:id="RenderSetter_0012"/>
            </dxi:RenderStateTrigger>
        </dxi:RenderStateGroup>
    </dxi:RenderTriggersCollection>

