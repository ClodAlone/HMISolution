<ResourceDictionary mc:Ignorable="cs"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:cs="colorscheme_ignorable_uri"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                    xmlns:dxbt="http://schemas.devexpress.com/winfx/2008/xaml/bars/themekeys"
                    xmlns:dxi="http://schemas.devexpress.com/winfx/2008/xaml/core/internal"
                    xmlns:dxpdf="http://schemas.devexpress.com/winfx/2008/xaml/pdf"
                    xmlns:dxpdft="http://schemas.devexpress.com/winfx/2008/xaml/pdf/themekeys"
                    xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <dxt:ResourceDictionaryEx Source="/DevExpress.Xpf.Themes.VS2017Dark.v20.2;component/PdfViewer/VS2017Dark/UICore.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- General -->

    <ControlTemplate x:Key="{dxpdft:PdfViewerThemeKey ResourceKey=PdfPageControlItemTemplate}" TargetType="{x:Type dxpdf:PdfPageControlItem}">
        <Border x:Name="PageBorder"
                BorderBrush="$Border"
                BorderThickness="1"
                Margin="-1"
                cs:id="Border_0000"/>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="BorderBrush"
                        TargetName="PageBorder"
                        Value="$Focused"
                        cs:id="Setter_0000"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="{dxpdft:PdfViewerThemeKey ResourceKey=PdfThumbnailControlItemTemplate}" TargetType="{x:Type dxpdf:PdfThumbnailPageControlItem}">
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="Shadow" Grid.Row="0">
                    <Border BorderBrush="$Backstage.Editor.Background"
                            BorderThickness="5"
                            CornerRadius="5"
                            Margin="-6"
                            Opacity="0.01"
                            cs:id="Border_0000"/>
                    <Border BorderBrush="$Backstage.Editor.Background"
                            BorderThickness="4"
                            CornerRadius="4"
                            Margin="-5"
                            Opacity="0.01"
                            cs:id="Border_0001"/>
                    <Border BorderBrush="$Backstage.Editor.Background"
                            BorderThickness="3"
                            CornerRadius="3"
                            Margin="-4"
                            Opacity="0.02"
                            cs:id="Border_0002"/>
                    <Border BorderBrush="$Backstage.Editor.Background"
                            BorderThickness="2"
                            CornerRadius="2"
                            Margin="-3"
                            Opacity="0.03"
                            cs:id="Border_0003"/>
                    <Border BorderBrush="$Backstage.Editor.Background"
                            BorderThickness="1"
                            CornerRadius="1"
                            Margin="-2"
                            Opacity="0.05"
                            cs:id="Border_0004"/>
                    <Border BorderBrush="$Editor.Background"
                            BorderThickness="1"
                            Margin="-1"
                            cs:id="Border_0005"/>
                </Grid>
                <Border x:Name="Highlight"
                        BorderBrush="$SelectionBackground"
                        BorderThickness="6"
                        Grid.Row="0"
                        Margin="-7"
                        Opacity="0"
                        cs:id="Border_0007"/>
                <Border x:Name="Selection"
                        BorderBrush="$Border"
                        BorderThickness="2"
                        Grid.Row="0"
                        Margin="-9"
                        Opacity="0"
                        cs:id="Border_0006"/>
                <TextBlock Grid.Row="1"
                           Margin="0,12,0,10"
                           Text="{Binding Path=PageNumber}"
                           TextAlignment="Center"/>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="true">
                <Setter Property="Opacity"
                        TargetName="Selection"
                        Value="1"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="true">
                <Setter Property="Opacity"
                        TargetName="Highlight"
                        Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <DataTemplate x:Key="{dxpdft:PdfViewerThemeKey ResourceKey=SelectionCanvasContentTemplate}">
        <Border HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                cs:id="Border_0000">
            <Border.Background>
                <SolidColorBrush Color="$SelectionBackground"
                                 Opacity="0.3"
                                 cs:id="SolidColorBrush_0000"/>
            </Border.Background>
        </Border>
    </DataTemplate>

</ResourceDictionary>