<?xml version="1.0" encoding="utf-8" ?>
<s0:InstalledApplication
  xmlns:s0="http://opcfoundation.org/UA/SDK/Installation.xsd"
  xmlns:s1="http://opcfoundation.org/UA/SDK/Configuration.xsd"
  xmlns="http://opcfoundation.org/UA/2011/03/SecuredApplication.xsd"
  xmlns:ua="http://opcfoundation.org/UA/2008/02/Types.xsd">

  <ApplicationName>UA Local Discovery Server</ApplicationName>
  <ApplicationUri></ApplicationUri>
  <ApplicationType>DiscoveryServer_3</ApplicationType>

  <ConfigurationFile>%CommonApplicationData%\OPC Foundation\Config\Opc.Ua.DiscoveryServer.Config.xml</ConfigurationFile>
  <!--<ConfigurationFile>Opc.Ua.DiscoveryServer.Config.xml</ConfigurationFile>-->

  <TrustedCertificateStore>
    <StoreType>Windows</StoreType>
    <StorePath>LocalMachine\UA Applications</StorePath>
  </TrustedCertificateStore>
  
  <BaseAddresses>
    <ua:String>opc.tcp://localhost:4840/UADiscovery</ua:String>
    <ua:String>http://localhost:52601/UADiscovery</ua:String>
  </BaseAddresses>
  
  <s0:DeleteCertificatesOnUninstall>false</s0:DeleteCertificatesOnUninstall>
  <s0:ConfigureFirewall>true</s0:ConfigureFirewall>
  <s0:SetConfigurationFilePermisions>true</s0:SetConfigurationFilePermisions>
  <s0:SetExecutableFilePermisions>true</s0:SetExecutableFilePermisions>
  <s0:InstallAsService>true</s0:InstallAsService>
  <s0:ServiceStartMode>Auto</s0:ServiceStartMode>
  <s0:ServiceDescription>Allows UA client applications to discover UA servers running on the host.</s0:ServiceDescription>
  
  <s0:TraceConfiguration>
    <s1:OutputFilePath>CommonApplicationData%\OPC Foundation\Logs\Opc.Ua.DiscoveryServer.InstallLog.txt</s1:OutputFilePath>
    <s1:DeleteOnLoad>true</s1:DeleteOnLoad>
    <!-- Show Only Errors -->
    <!-- <s1:TraceMasks>1</s1:TraceMasks> -->
    <!-- Show Only Security and Errors -->
    <s1:TraceMasks>513</s1:TraceMasks>
    <!-- Show Only Security, Errors and Trace -->
    <!-- <s1:TraceMasks>515</s1:TraceMasks> -->
    <!-- Show Only Security, COM Calls, Errors and Trace -->
    <!-- <s1:TraceMasks>771</s1:TraceMasks> -->
    <!-- Show Only Security, Service Calls, Errors and Trace -->
    <!-- <s1:TraceMasks>523</s1:TraceMasks> -->
    <!-- Show Only Security, ServiceResultExceptions, Errors and Trace -->
    <!-- <s1:TraceMasks>519</s1:TraceMasks> -->
  </s0:TraceConfiguration>
  
</s0:InstalledApplication>