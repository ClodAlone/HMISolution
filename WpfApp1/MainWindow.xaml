<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <DockPanel Grid.ColumnSpan="5" Background="{StaticResource VSPaneBackground}" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="File"/>
                <Button Content="Edit"/>
                <Button Content="View"/>
                <Button Content="Run BG Task" Click="RunBackgroundTask_Click" Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Left tool window -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource VSPaneBackground}" BorderBrush="{StaticResource VSPaneBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock Text="Solution Explorer" Margin="8" FontWeight="Bold" Foreground="{StaticResource VSText}"/>
                <ListBox x:Name="SolutionList" Margin="8" Background="Transparent" Foreground="{StaticResource VSText}" MouseDoubleClick="SolutionList_MouseDoubleClick">
                    <ListBoxItem>Project1</ListBoxItem>
                    <ListBoxItem>App.xaml</ListBoxItem>
                    <ListBoxItem>MainWindow.xaml</ListBoxItem>
                </ListBox>
                <TextBlock Text="Plugins" Margin="8,16,8,0" FontWeight="Bold" Foreground="{StaticResource VSText}"/>
                <ListBox x:Name="PluginList" Margin="8" Background="Transparent" Foreground="{StaticResource VSText}"/>
            </DockPanel>
        </Border>

        <!-- Left splitter -->
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True"/>

        <!-- Document area with tabs -->
        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource VSBackground}">
            <DockPanel>
                <TabControl x:Name="DocumentTabControl">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MainWindow.xaml" Margin="0,0,6,0"/>
                                <Button Content="×" Click="CloseTab_Click" Padding="0" Width="16" Height="16"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Background="Transparent">
                            <TextBlock Text="// Your editor content would appear here" Foreground="{StaticResource VSInactiveText}" Margin="12"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- Right splitter -->
        <GridSplitter Grid.Row="1" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True"/>

        <!-- Right properties window -->
        <Border Grid.Row="1" Grid.Column="4" Background="{StaticResource VSPaneBackground}" BorderBrush="{StaticResource VSPaneBorder}" BorderThickness="1,0,0,0">
            <DockPanel>
                <TextBlock Text="Properties" Margin="8" FontWeight="Bold" Foreground="{StaticResource VSText}"/>
                <StackPanel Margin="8">
                    <TextBlock Text="(No item selected)" Foreground="{StaticResource VSInactiveText}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status / Active tasks -->
        <Border Grid.Row="2" Grid.ColumnSpan="5" Background="{StaticResource VSPaneBackground}" BorderBrush="{StaticResource VSPaneBorder}" BorderThickness="1,0,0,0">
            <StackPanel Orientation="Horizontal" Margin="8">
                <ItemsControl x:Name="ActiveTasksControl" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6" Margin="4" Background="#2A2A2A" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource VSText}" Margin="0,0,8,0" Width="160"/>
                                    <ProgressBar Width="200" Height="14" Value="{Binding Progress}" Maximum="100" Margin="0,0,8,0"/>
                                    <Button Content="Cancel" Tag="{Binding}" Click="CancelActiveTask_Click"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </Grid>
</Window>
