  ],
  "Strings": [
    { "Key": "app_title", "Translations": { "en": "Water Treatment Plant", "de": "Wasseraufbereitungsanlage", "it": "Impianto di Trattamento Acque", "fr": "Station de Traitement des Eaux" } }
  ],
  "Cameras": []
