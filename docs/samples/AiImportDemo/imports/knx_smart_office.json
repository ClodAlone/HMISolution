  "Scripts": [
    {
      "Name": "DaylightHarvesting",
      "Enabled": true,
      "IntervalMs": 30000,
      "Language": "CSharp",
      "Group": "Lighting",
      "Code": "// Adjust open-space lights based on daylight lux level\nvar lux = ReadDouble(\"Office.Floor1.OpenSpace.LuxLevel\");\nvar occupied = ReadBool(\"Office.Floor1.OpenSpace.Occupancy\");\nif (!occupied) {\n    Write(\"Office.Floor1.OpenSpace.Lights_Zone1_Pct\", 10.0);\n    Write(\"Office.Floor1.OpenSpace.Lights_Zone2_Pct\", 10.0);\n    Write(\"Office.Floor1.OpenSpace.Lights_Zone3_Pct\", 10.0);\n} else if (lux > 600) {\n    Write(\"Office.Floor1.OpenSpace.Lights_Zone1_Pct\", 40.0);\n    Write(\"Office.Floor1.OpenSpace.Lights_Zone2_Pct\", 35.0);\n} else if (lux < 200) {\n    Write(\"Office.Floor1.OpenSpace.Lights_Zone1_Pct\", 100.0);\n    Write(\"Office.Floor1.OpenSpace.Lights_Zone2_Pct\", 100.0);\n}"
    },
    {
      "Name": "MeetingRoomPresence",
      "Enabled": true,
      "IntervalMs": 10000,
      "Language": "CSharp",
      "Group": "Lighting",
      "Code": "// Turn off meeting room lights when unoccupied for energy saving\nvar occupied = ReadBool(\"Office.Floor1.MeetingRoom1.Occupancy\");\nif (!occupied) {\n    var current = ReadDouble(\"Office.Floor1.MeetingRoom1.Lights_Pct\");\n    if (current > 0) {\n        Write(\"Office.Floor1.MeetingRoom1.Lights_Pct\", 0.0);\n        Log(\"Meeting Room 1: lights off (unoccupied)\");\n    }\n}"
    }
  ],
