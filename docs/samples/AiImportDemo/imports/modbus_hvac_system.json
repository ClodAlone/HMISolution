  "Scripts": [
    {
      "Name": "EnergyMonitor",
      "Enabled": true,
      "IntervalMs": 60000,
      "Language": "CSharp",
      "Group": "Energy",
      "Code": "var power = ReadDouble(\"HVAC.EnergyMeter.TotalPower_kW\");\nvar pf = ReadDouble(\"HVAC.EnergyMeter.PowerFactor\");\nif (power > 300)\n    Log($\"WARNING: High power demand: {power:F1} kW (PF: {pf:F2})\");"
    }
  ],
  "PlcPrograms": [
    {
      "Name": "AHU_TempControl",
      "Enabled": true,
      "IntervalMs": 500,
      "Language": "ST",
      "Group": "HVAC",
      "Code": "VAR\n    supplyTemp : REAL;\n    returnTemp : REAL;\n    fanSpeed : REAL;\n    damper : REAL;\nEND_VAR\n\nsupplyTemp := ReadReal('HVAC.AHU1.SupplyAirTemp_C');\nreturnTemp := ReadReal('HVAC.AHU1.ReturnAirTemp_C');\nfanSpeed := ReadReal('HVAC.AHU1.FanSpeed_Pct');\n\n// Simple proportional control on damper\nIF supplyTemp > 25.0 THEN\n    damper := 100.0;\nELSIF supplyTemp < 18.0 THEN\n    damper := 20.0;\nELSE\n    damper := 50.0 + (supplyTemp - 21.5) * 10.0;\nEND_IF;\n\nIF damper > 100.0 THEN damper := 100.0; END_IF;\nIF damper < 0.0 THEN damper := 0.0; END_IF;\n\nWriteReal('HVAC.AHU1.DamperPosition_Pct', damper);"
    }
  ],
