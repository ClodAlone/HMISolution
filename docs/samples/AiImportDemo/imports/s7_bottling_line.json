{
  "Server": {
    "EndpointUrl": "opc.tcp://localhost:4840/S7BottlingLine",
    "EnableAnonymous": true
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "history.db",
    "TableName": "variable_data"
  },
  "Users": [],
  "UserGroups": [],
  "Folder": {
    "Name": "Bottling",
    "Folders": [
      {
        "Name": "Filler",
        "Variables": [
          { "Name": "FillLevel_ml", "Type": "Double", "Access": "Read", "Value": 330.5, "Statistics": { "Enabled": true }, "Alarm": { "TriggerType": "Limit", "HighLimit": 340.0, "LowLimit": 320.0, "Message": "Fill level out of tolerance", "Hysteresis": 1.0 }, "DataLogging": { "Enabled": true, "Hysteresis": 0.2 }, "S7": { "IpAddress": "192.168.0.10", "Rack": 0, "Slot": 1, "Address": "DB1.DBD0", "PollTime": 100 } },
          { "Name": "FillPressure_bar", "Type": "Double", "Access": "Read", "Value": 2.8, "Alarm": { "TriggerType": "Limit", "HighLimit": 4.0, "LowLimit": 1.5, "Message": "Fill pressure abnormal", "Hysteresis": 0.1 }, "DataLogging": { "Enabled": true, "Hysteresis": 0.05 }, "S7": { "IpAddress": "192.168.0.10", "Rack": 0, "Slot": 1, "Address": "DB1.DBD4", "PollTime": 200 } },
          { "Name": "BottleCount", "Type": "Int32", "Access": "Read", "Value": 48720, "Statistics": { "Enabled": true }, "DataLogging": { "Enabled": true, "Hysteresis": 1 }, "S7": { "IpAddress": "192.168.0.10", "Rack": 0, "Slot": 1, "Address": "DB1.DBD8", "PollTime": 500 } },
          { "Name": "RejectCount", "Type": "Int32", "Access": "Read", "Value": 127, "Alarm": { "TriggerType": "Condition", "Operator": "Changed", "ConditionSeverity": 500, "Message": "Bottle rejected" }, "DataLogging": { "Enabled": true, "Hysteresis": 1 }, "S7": { "IpAddress": "192.168.0.10", "Rack": 0, "Slot": 1, "Address": "DB1.DBD12", "PollTime": 500 } },
          { "Name": "NozzleTemp_C", "Type": "Double", "Access": "Read", "Value": 4.2, "Statistics": { "Enabled": true }, "DataLogging": { "Enabled": true, "Hysteresis": 0.1 }, "S7": { "IpAddress": "192.168.0.10", "Rack": 0, "Slot": 1, "Address": "DB1.DBD16", "PollTime": 1000 } },
          { "Name": "Running", "Type": "Boolean", "Access": "ReadWrite", "Value": true, "S7": { "IpAddress": "192.168.0.10", "Rack": 0, "Slot": 1, "Address": "DB1.DBX20.0", "PollTime": 200 } },
          { "Name": "SpeedSetpoint_bph", "Type": "Double", "Access": "ReadWrite", "Value": 6000.0, "InitialValue": "6000", "Retentive": true, "S7": { "IpAddress": "192.168.0.10", "Rack": 0, "Slot": 1, "Address": "DB1.DBD24", "PollTime": 1000 } }
        ]
      },
      {
        "Name": "Capper",
        "Variables": [
          { "Name": "TorqueActual_Nm", "Type": "Double", "Access": "Read", "Value": 2.1, "Statistics": { "Enabled": true }, "Alarm": { "TriggerType": "Limit", "HighLimit": 3.5, "LowLimit": 1.0, "Message": "Capping torque out of spec", "Hysteresis": 0.1 }, "DataLogging": { "Enabled": true, "Hysteresis": 0.05 }, "S7": { "IpAddress": "192.168.0.10", "Rack": 0, "Slot": 1, "Address": "DB2.DBD0", "PollTime": 100 } },
          { "Name": "TorqueSetpoint_Nm", "Type": "Double", "Access": "ReadWrite", "Value": 2.0, "InitialValue": "2.0", "Retentive": true, "S7": { "IpAddress": "192.168.0.10", "Rack": 0, "Slot": 1, "Address": "DB2.DBD4", "PollTime": 1000 } },
          { "Name": "MissedCaps", "Type": "Int32", "Access": "Read", "Value": 3, "Alarm": { "TriggerType": "Condition", "Operator": "Changed", "ConditionSeverity": 600, "Message": "Missed cap detected" }, "S7": { "IpAddress": "192.168.0.10", "Rack": 0, "Slot": 1, "Address": "DB2.DBD8", "PollTime": 500 } },
          { "Name": "CapHopperLow", "Type": "Boolean", "Access": "Read", "Value": false, "Alarm": { "TriggerType": "Condition", "Operator": "==", "CompareValue": "true", "ConditionSeverity": 400, "Message": "Cap hopper level low — refill needed" }, "S7": { "IpAddress": "192.168.0.10", "Rack": 0, "Slot": 1, "Address": "DB2.DBX12.0", "PollTime": 1000 } }
        ]
      },
      {
        "Name": "Labeler",
        "Variables": [
          { "Name": "LabelSpeed_mpm", "Type": "Double", "Access": "Read", "Value": 45.0, "DataLogging": { "Enabled": true, "Hysteresis": 0.5 }, "S7": { "IpAddress": "192.168.0.11", "Rack": 0, "Slot": 1, "Address": "DB3.DBD0", "PollTime": 200 } },
          { "Name": "LabelRollDiameter_mm", "Type": "Double", "Access": "Read", "Value": 280.0, "Alarm": { "TriggerType": "Limit", "LowLimit": 50.0, "Message": "Label roll nearly empty", "Hysteresis": 5.0 }, "S7": { "IpAddress": "192.168.0.11", "Rack": 0, "Slot": 1, "Address": "DB3.DBD4", "PollTime": 2000 } },
          { "Name": "MisalignedCount", "Type": "Int32", "Access": "Read", "Value": 8, "DataLogging": { "Enabled": true, "Hysteresis": 1 }, "S7": { "IpAddress": "192.168.0.11", "Rack": 0, "Slot": 1, "Address": "DB3.DBD8", "PollTime": 1000 } },
          { "Name": "Running", "Type": "Boolean", "Access": "ReadWrite", "Value": true, "S7": { "IpAddress": "192.168.0.11", "Rack": 0, "Slot": 1, "Address": "DB3.DBX12.0", "PollTime": 200 } }
        ]
      },
      {
        "Name": "Conveyor",
        "Variables": [
          { "Name": "Speed_mpm", "Type": "Double", "Access": "ReadWrite", "Value": 12.5, "InitialValue": "12.5", "Retentive": true, "Statistics": { "Enabled": true }, "DataLogging": { "Enabled": true, "Hysteresis": 0.1 }, "S7": { "IpAddress": "192.168.0.12", "Rack": 0, "Slot": 1, "Address": "DB4.DBD0", "PollTime": 500 } },
          { "Name": "MotorCurrent_A", "Type": "Double", "Access": "Read", "Value": 8.5, "Alarm": { "TriggerType": "Limit", "HighLimit": 15.0, "Message": "Conveyor motor overload", "Hysteresis": 0.5 }, "DataLogging": { "Enabled": true, "Hysteresis": 0.2 }, "S7": { "IpAddress": "192.168.0.12", "Rack": 0, "Slot": 1, "Address": "DB4.DBD4", "PollTime": 500 } },
          { "Name": "Running", "Type": "Boolean", "Access": "ReadWrite", "Value": true, "S7": { "IpAddress": "192.168.0.12", "Rack": 0, "Slot": 1, "Address": "DB4.DBX8.0", "PollTime": 200 } },
          { "Name": "JamDetected", "Type": "Boolean", "Access": "Read", "Value": false, "Alarm": { "TriggerType": "Condition", "Operator": "==", "CompareValue": "true", "ConditionSeverity": 800, "Message": "Conveyor jam detected — line stopped" }, "S7": { "IpAddress": "192.168.0.12", "Rack": 0, "Slot": 1, "Address": "DB4.DBX8.1", "PollTime": 200 } }
        ]
      },
      {
        "Name": "Production",
        "Variables": [
          { "Name": "BatchNumber", "Type": "String", "Access": "Read", "Value": "BT-2025-04281", "S7": { "IpAddress": "192.168.0.10", "Rack": 0, "Slot": 1, "Address": "DB5.DBB0", "PollTime": 5000 } },
          { "Name": "DailyTarget", "Type": "Int32", "Access": "ReadWrite", "Value": 50000, "InitialValue": "50000", "Retentive": true },
          { "Name": "DailyProduced", "Type": "Int32", "Access": "Read", "Value": 32150, "Statistics": { "Enabled": true }, "DataLogging": { "Enabled": true, "Hysteresis": 10 }, "S7": { "IpAddress": "192.168.0.10", "Rack": 0, "Slot": 1, "Address": "DB5.DBD20", "PollTime": 5000 } },
          { "Name": "LineEfficiency_Pct", "Type": "Double", "Access": "Read", "Value": 94.2, "Statistics": { "Enabled": true }, "DataLogging": { "Enabled": true, "Hysteresis": 0.1 }, "S7": { "IpAddress": "192.168.0.10", "Rack": 0, "Slot": 1, "Address": "DB5.DBD24", "PollTime": 10000 } }
        ]
      }
    ]
  },
  "Scripts": [
    {
      "Name": "EfficiencyCalculator",
      "Enabled": true,
      "IntervalMs": 30000,
      "Language": "CSharp",
      "Group": "Production",
      "Code": "var produced = ReadInt(\"Bottling.Production.DailyProduced\");\nvar target = ReadInt(\"Bottling.Production.DailyTarget\");\nif (target > 0)\n{\n    var eff = Math.Round((double)produced / target * 100.0, 1);\n    Write(\"Bottling.Production.LineEfficiency_Pct\", eff);\n}"
    }
  ],
  "PlcPrograms": [
    {
      "Name": "FillerControl",
      "Enabled": true,
      "IntervalMs": 100,
      "Language": "ST",
      "Group": "Filling",
      "Code": "VAR\n    fillLevel : REAL;\n    pressure : REAL;\n    running : BOOL;\nEND_VAR\n\nfillLevel := ReadReal('Bottling.Filler.FillLevel_ml');\npressure := ReadReal('Bottling.Filler.FillPressure_bar');\nrunning := ReadBool('Bottling.Filler.Running');\n\nIF running AND (pressure < 1.5 OR pressure > 4.0) THEN\n    WriteBool('Bottling.Filler.Running', FALSE);\nEND_IF;"
    }
  ],
  "Screens": [
    {
      "Name": "BottlingOverview",
      "Width": 1920,
      "Height": 1080,
      "Group": "Main",
      "Symbols": [
        { "Id": "title", "Type": "text", "X": 20, "Y": 15, "Width": 500, "Height": 40, "Label": "S7 Bottling Line", "Fill": "#ffffff", "Stroke": "none", "FontSize": 22 },
        { "Id": "g_fill", "Type": "gauge", "X": 50, "Y": 100, "Width": 200, "Height": 200, "VariablePath": "Bottling.Filler.FillLevel_ml", "MinValue": 300, "MaxValue": 360, "GaugeStyle": "arc", "GaugeUnit": "ml", "GaugeArcColor": "#38bdf8", "Label": "Fill Level" },
        { "Id": "g_torque", "Type": "gauge", "X": 300, "Y": 100, "Width": 200, "Height": 200, "VariablePath": "Bottling.Capper.TorqueActual_Nm", "MinValue": 0, "MaxValue": 5, "GaugeStyle": "arc", "GaugeUnit": "Nm", "GaugeArcColor": "#fbbf24", "Label": "Cap Torque" },
        { "Id": "g_speed", "Type": "gauge", "X": 550, "Y": 100, "Width": 200, "Height": 200, "VariablePath": "Bottling.Conveyor.Speed_mpm", "MinValue": 0, "MaxValue": 30, "GaugeStyle": "arc", "GaugeUnit": "m/min", "GaugeArcColor": "#4ade80", "Label": "Conveyor" },
        { "Id": "g_eff", "Type": "gauge", "X": 800, "Y": 100, "Width": 200, "Height": 200, "VariablePath": "Bottling.Production.LineEfficiency_Pct", "MinValue": 0, "MaxValue": 100, "GaugeStyle": "semicircle", "GaugeUnit": "%", "GaugeArcColor": "#a78bfa", "Label": "Efficiency" },
        { "Id": "eb_speed", "Type": "editbox", "X": 50, "Y": 350, "Width": 200, "Height": 55, "VariablePath": "Bottling.Filler.SpeedSetpoint_bph", "Label": "Filler Speed (bph)", "EditBoxStep": 100, "EditBoxFormat": "F0", "EditBoxShowStatistics": true },
        { "Id": "chart", "Type": "hdachart", "X": 50, "Y": 450, "Width": 1000, "Height": 400, "HdaVariablePaths": [ "Bottling.Filler.FillLevel_ml", "Bottling.Capper.TorqueActual_Nm", "Bottling.Conveyor.Speed_mpm" ], "HdaTimeRangeMinutes": 60, "HdaMaxPoints": 500 }
      ]
    }
  ],
  "Recipes": [],
  "Strings": [],
  "Cameras": []
}
