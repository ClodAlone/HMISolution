              { "Name": "WeldCount", "Type": "Int32", "Access": "Read", "Value": 15823, "DataLogging": { "Enabled": true, "Hysteresis": 1 }, "S7": { "IpAddress": "192.168.10.1", "Rack": 0, "Slot": 1, "Address": "DB10.DBD20", "PollTime": 500 } },
