      {
        "Name": "Production",
        "Variables": [
          { "Name": "DailyTarget", "Type": "Int32", "Access": "ReadWrite", "Value": 450, "InitialValue": "450", "Retentive": true },
          { "Name": "DailyActual", "Type": "Int32", "Access": "Read", "Value": 312, "DataLogging": { "Enabled": true, "Hysteresis": 1 } },
          { "Name": "OEE_Percent", "Type": "Double", "Access": "Read", "Value": 85.3, "DataLogging": { "Enabled": true, "Hysteresis": 0.1 } },
