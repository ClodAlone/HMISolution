  },
  "Scripts": [
    {
      "Name": "OEE_Calculator",
      "Enabled": true,
      "IntervalMs": 10000,
      "Language": "CSharp",
      "Group": "Production",
      "Code": "var target = ReadInt(\"Plant.Production.DailyTarget\");\nvar actual = ReadInt(\"Plant.Production.DailyActual\");\nif (target > 0) {\n    var oee = (double)actual / target * 100.0;\n    Write(\"Plant.Production.OEE_Percent\", Math.Round(oee, 1));\n}"
    },
    {
      "Name": "WeldQualityMonitor",
      "Enabled": true,
      "IntervalMs": 1000,
      "Language": "CSharp",
      "Group": "Quality",
      "Code": "// Monitor weld current stability\nvar current1 = ReadDouble(\"Plant.BodyShop.WeldingRobot1.WeldCurrent\");\nvar current2 = ReadDouble(\"Plant.BodyShop.WeldingRobot2.WeldCurrent\");\nif (current1 < 120 || current2 < 120) {\n    Log(\"WARNING: Low weld current detected - check wire feed\");\n}"
    }
  ],
  "PlcPrograms": [
    {
      "Name": "ConveyorControl",
      "Enabled": true,
      "IntervalMs": 100,
      "Language": "ST",
      "Group": "Assembly",
      "Code": "(* Conveyor speed regulation based on part count *)\nVAR\n    speed : REAL;\n    partCount : DINT;\nEND_VAR\n\npartCount := ReadInt('Plant.Assembly.Conveyor.PartCount');\nIF partCount > 800 THEN\n    speed := 1.5; (* Slow down near target *)\nELSE\n    speed := 2.5;\nEND_IF;\nWrite('Plant.Assembly.Conveyor.Speed', speed);"
    }
  ],
