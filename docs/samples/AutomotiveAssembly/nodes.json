              { "Name": "TargetTorque_Nm", "Type": "Double", "Access": "ReadWrite", "Value": 45.0, "InitialValue": "45.0", "Retentive": true, "S7": { "IpAddress": "192.168.10.31", "Rack": 0, "Slot": 1, "Address": "DB31.DBD4", "PollTime": 1000 } },
              { "Name": "BoltCount", "Type": "Int32", "Access": "Read", "Value": 24, "S7": { "IpAddress": "192.168.10.31", "Rack": 0, "Slot": 1, "Address": "DB31.DBD8", "PollTime": 500 } },
