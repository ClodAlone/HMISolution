  "Scripts": [
    {
      "Name": "BatchLogger",
      "Enabled": true,
      "IntervalMs": 30000,
      "Language": "CSharp",
      "Group": "Batch",
      "Code": "var active = ReadBool(\"Brewery.Mashing.BatchActive\");\nif (active) {\n    var temp = ReadDouble(\"Brewery.Mashing.MashTunTemp\");\n    var step = ReadInt(\"Brewery.Mashing.BatchStep\");\n    var timer = ReadDouble(\"Brewery.Mashing.BatchTimer_min\");\n    Log($\"Batch step {step}: Temp={temp:F1}°C, Timer={timer:F1} min\");\n}"
    }
  ],
  "PlcPrograms": [
    {
      "Name": "MashTempControl",
      "Enabled": true,
      "IntervalMs": 500,
      "Language": "ST",
      "Group": "Mashing",
      "Code": "(* Mash tun temperature PID control via steam valve *)\nVAR\n    temp, setpoint, error, valve : REAL;\nEND_VAR\n\ntemp := Read('Brewery.Mashing.MashTunTemp');\nsetpoint := Read('Brewery.Mashing.MashTunTempSetpoint');\nerror := setpoint - temp;\nvalve := Read('Brewery.Mashing.SteamValve_Pct') + error * 2.0;\nIF valve > 100.0 THEN valve := 100.0; END_IF;\nIF valve < 0.0 THEN valve := 0.0; END_IF;\nWrite('Brewery.Mashing.SteamValve_Pct', valve);"
    }
  ],
