        { "Id": "ferm2_temp", "Type": "gauge", "X": 970, "Y": 80, "Width": 200, "Height": 200, "VariablePath": "Brewery.Fermentation.Tank2.Temperature", "MinValue": 0, "MaxValue": 30, "GaugeStyle": "thermometer", "GaugeUnit": "°C", "Fill": "#2980b9", "Label": "Ferm Tank 2" },
