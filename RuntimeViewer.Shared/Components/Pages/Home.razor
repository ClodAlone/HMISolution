@page "/"
@page "/screen/{ScreenName}"
@using SharedModels
@using RuntimeViewer.Shared.Services
@using RuntimeViewer.Shared.Components.Viewer
@implements IDisposable

<PageTitle>@(_currentScreen?.Name ?? "Runtime Viewer")</PageTitle>

@if (_loginRequired && !Auth.IsAuthenticated)
{
    @* -- Login Modal (required — blocks everything) -- *@
    <div class="rv-login-overlay">
        <div class="rv-login-card">
            <div class="rv-login-header">
                <span>🔐</span>
                <span>Runtime Viewer Login</span>
            </div>
            <div class="rv-login-body">
                @if (!string.IsNullOrEmpty(_loginError))
                {
                    <div class="rv-login-error">@_loginError</div>
                }
                <div class="rv-login-field">
                    <label>Username</label>
                    <input type="text" @bind="_loginUsername" @onkeydown="OnLoginKeyDown"
                           placeholder="Enter username" autofocus />
                </div>
                <div class="rv-login-field">
                    <label>Password</label>
                    <input type="password" @bind="_loginPassword" @onkeydown="OnLoginKeyDown"
                           placeholder="Enter password" />
                </div>
                <button class="rv-login-btn" @onclick="DoLogin" disabled="@_loginBusy">
                    @if (_loginBusy)
                    {
                        <span>Signing in…</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
            </div>
            <div class="rv-login-footer">Runtime Viewer</div>
        </div>
    </div>
}
else if (Auth.MustChangePassword)
{
    @* -- Force Change Password Modal -- *@
    <div class="rv-login-overlay">
        <div class="rv-login-card">
            <div class="rv-login-header">
                <span>🔑</span>
                <span>Change Password</span>
            </div>
            <div class="rv-login-body">
                <div style="font-size: 12px; color: #aaa; margin-bottom: 8px;">
                    You must change your password before continuing.
                </div>
                <div style="font-size: 10px; color: #888; margin-bottom: 12px; font-style: italic;">
                    @(SharedModels.PasswordValidator.GetRequirementsText(Project.Model?.Server?.RequireStrongPassword ?? false))
                </div>
                @if (!string.IsNullOrEmpty(_changePwError))
                {
                    <div class="rv-login-error">@_changePwError</div>
                }
                @if (!string.IsNullOrEmpty(_changePwSuccess))
                {
                    <div style="background: #155724; color: #d4edda; padding: 6px 10px; border-radius: 4px; font-size: 12px; margin-bottom: 8px;">@_changePwSuccess</div>
                }
                <div class="rv-login-field">
                    <label>Current Password</label>
                    <input type="password" @bind="_changePwCurrent" placeholder="Current password" />
                </div>
                <div class="rv-login-field">
                    <label>New Password</label>
                    <input type="password" @bind="_changePwNew" placeholder="New password" />
                </div>
                <div class="rv-login-field">
                    <label>Confirm New Password</label>
                    <input type="password" @bind="_changePwConfirm" @onkeydown="OnChangePwKeyDown"
                           placeholder="Confirm new password" />
                </div>
                <button class="rv-login-btn" @onclick="DoChangePassword">Change Password</button>
            </div>
        </div>
    </div>
}
else
{

<div class="rv-app @(Project.IsKiosk ? "rv-kiosk" : "") @(NavStyle == "sidebar" ? "rv-nav-sidebar" : "")">
    @if (!Project.IsKiosk || Project.Settings.ShowNavigationBar)
    {
        @* -- Full top bar (normal mode, or kiosk with ShowNavigationBar) -- *@
        <div class="rv-topbar">
            <span class="rv-title">Runtime Viewer</span>

            @if (NavigableScreens.Count > 1 && NavStyle != "bottom" && NavStyle != "hamburger")
            {
                <div class="rv-screen-tabs">
                    @foreach (var scr in NavigableScreens)
                    {
                        var s = scr;
                        <button class="rv-tab @(s == _currentScreen ? "active" : "")"
                                @onclick="() => DoNavigateScreen(s.Name)">
                            @s.Name
                        </button>
                    }
                </div>
            }
            @if (NavStyle == "hamburger" && NavigableScreens.Count > 1)
            {
                <button class="rv-hamburger-btn" @onclick="() => _hamburgerOpen = true" title="Navigation">&#x2630;</button>
            }

            <div class="rv-status">
                @if (Opc.IsConnected)
                {
                    <span class="rv-badge rv-badge-ok">Connected</span>
                }
                else if (_connecting)
                {
                    <span class="rv-badge rv-badge-warn">Connecting...</span>
                }
                else
                {
                    <span class="rv-badge rv-badge-err">Disconnected</span>
                    <button class="rv-btn" @onclick="Connect">Reconnect</button>
                }
                @if (!string.IsNullOrEmpty(Opc.ErrorMessage))
                {
                    <span class="rv-error" title="@Opc.ErrorMessage">Warning</span>
                }
                <span class="rv-file" title="@Project.ConfigPath">@Path.GetFileName(Project.ConfigPath)</span>

                @if (Auth.IsAuthenticated)
                {
                    <span class="rv-badge" style="background:#555;color:#ccc;" title="@Auth.Group">@Auth.Username</span>
                    <button class="rv-btn" style="background:#dc3545;" @onclick="DoLogout">Logout</button>
                }
                else if (_hasUsers)
                {
                    <button class="rv-btn" style="background:#555;" @onclick="ShowAccessLoginPrompt" title="Sign in to access restricted content">🔐 Login</button>
                }
                <button class="rv-btn" style="background:@(_bestFit ? "#2563eb" : "#374151"); font-size:10px;"
                        @onclick="() => _bestFit = !_bestFit" title="@(_bestFit ? "Switch to actual size (scrollable)" : "Switch to best fit (scale to viewport)")">@(_bestFit ? "▣ Fit" : "▢ 1:1")</button>
                <button class="rv-btn" style="background:@(_showDiag ? "#2563eb" : "#374151"); font-size:10px;"
                        @onclick="ToggleDiag" title="OPC Diagnostics">🔍 Diag</button>
                @if (Project.Settings.EnableTagBrowser)
                {
                    <button class="rv-btn" style="background:@(_showTagBrowser ? "#2563eb" : "#374151"); font-size:10px;"
                            @onclick="ToggleTagBrowser" title="Tag Browser">&#x1F3F7;&#xFE0F; Tags</button>
                }
                @if (_pushSupported)
                {
                    <button class="rv-btn" style="background:@(_pushSubscribed ? "#2563eb" : "#374151"); font-size:10px;"
                            @onclick="TogglePushNotifications"
                            disabled="@_pushBusy"
                            title="@(_pushSubscribed ? "Disable push notifications" : "Enable push notifications")">
                        🔔 @(_pushSubscribed ? "On" : "Off")
                    </button>
                }
            </div>
        </div>
    }
    else if (Project.IsKiosk && NavigableScreens.Count > 1 && NavStyle != "bottom")
    {
        @* -- Kiosk: minimal navigation bar (nav only, no status chrome) -- *@
        <div class="rv-topbar rv-topbar-minimal">
            @if (NavStyle == "hamburger")
            {
                <button class="rv-hamburger-btn" @onclick="() => _hamburgerOpen = true" title="Navigation">&#x2630;</button>
            }
            else
            {
                <div class="rv-screen-tabs">
                    @foreach (var scr in NavigableScreens)
                    {
                        var s = scr;
                        <button class="rv-tab @(s == _currentScreen ? "active" : "")"
                                @onclick="() => DoNavigateScreen(s.Name)">
                            @s.Name
                        </button>
                    }
                </div>
            }
            @if (Auth.IsAuthenticated)
            {
                <span style="flex:1;"></span>
                <span class="rv-badge" style="background:#555;color:#ccc;font-size:10px;">@Auth.Username</span>
                <button class="rv-btn" style="background:#dc3545;font-size:10px;" @onclick="DoLogout">Logout</button>
            }
            else if (_hasUsers)
            {
                <span style="flex:1;"></span>
                <button class="rv-btn" style="background:#555;font-size:10px;" @onclick="ShowAccessLoginPrompt">🔐 Login</button>
            }
        </div>
    }
    else if (Auth.IsAuthenticated)
    {
        @* Kiosk mode: small floating logout button (no navigation needed) *@
        <div class="rv-kiosk-logout">
            <span class="small" style="color:#aaa;">@Auth.Username</span>
            <button class="rv-btn" style="background:#dc3545;font-size:10px;" @onclick="DoLogout">Logout</button>
        </div>
    }
    else if (_hasUsers)
    {
        @* Kiosk mode: small floating login button *@
        <div class="rv-kiosk-logout">
            <button class="rv-btn" style="background:#555;font-size:10px;" @onclick="ShowAccessLoginPrompt">🔐 Login</button>
        </div>
    }

    @* -- Diagnostics panel -- *@
    @if (_showDiag)
    {
        <div class="rv-diag-panel">
            <div class="rv-diag-header">
                <span>🔍 OPC Diagnostics</span>
                <span style="flex:1;"></span>
                <span class="rv-diag-badge">Session: @(Opc.IsConnected ? "✓ Connected" : "✗ Disconnected")</span>
                <span class="rv-diag-badge">Values: @(_diagValueCount)</span>
                <button class="rv-diag-btn" @onclick="ToggleDiag">✕ Close</button>
            </div>
            <div class="rv-diag-body" @ref="_diagScrollRef">
                @foreach (var line in Opc.DiagnosticLog)
                {
                    var cls = line.Contains("✗") || line.Contains("FAILED") || line.Contains("Error")
                        ? "rv-diag-err"
                        : line.Contains("✓") ? "rv-diag-ok"
                        : line.Contains("NOTIFY") ? "rv-diag-notify"
                        : "";
                    <div class="rv-diag-line @cls">@line</div>
                }
                @if (Opc.DiagnosticLog.Count == 0)
                {
                    <div class="rv-diag-line" style="color:#666;">No log entries yet. Waiting for OPC activity…</div>
                }
            </div>
            <div class="rv-diag-footer">
                <span style="color:#888;font-size:9px;">Live values cache:</span>
                @{ var cachedValues = GetCachedValues(); }
                @if (cachedValues.Count == 0)
                {
                    <span style="color:#666;font-size:9px;margin-left:8px;">empty — no values received yet</span>
                }
                else
                {
                    @foreach (var kv in cachedValues.Take(20))
                    {
                        <span class="rv-diag-val"><b>@kv.Key</b> = @kv.Value</span>
                    }
                    @if (cachedValues.Count > 20)
                    {
                        <span style="color:#888;font-size:9px;">… +@(cachedValues.Count - 20) more</span>
                    }
                }
            </div>
        </div>
    }

    @* -- Tag Browser panel -- *@
    @if (_showTagBrowser)
    {
        <TagBrowserPanel OnClose="ToggleTagBrowser" />
    }

    @* -- Canvas -- *@
    <div class="rv-viewport">
        @if (_currentScreen != null)
        {
            <ScreenRenderer Screen="_currentScreen" IsKiosk="Project.IsKiosk" BestFit="_bestFit" OnRequestLogin="ShowAccessLoginPrompt" />
        }
        else if (Project.Screens.Count == 0)
        {
            <div class="rv-empty">
                <h3>No screens found</h3>
                <p>The loaded configuration has no screens defined.</p>
                @if (string.IsNullOrEmpty(Project.ConfigPath))
                {
                    <p class="rv-hint">Pass a JSON config path as a command-line argument:<br />
                        <code>dotnet run -- path/to/nodes.json</code></p>
                }
            </div>
        }
    </div>

    @* -- Bottom tab navigation -- *@
    @if (NavStyle == "bottom" && NavigableScreens.Count > 1)
    {
        <div class="rv-bottom-nav">
            @foreach (var scr in NavigableScreens)
            {
                var s = scr;
                <button class="rv-bottom-tab @(s == _currentScreen ? "active" : "")"
                        @onclick="() => DoNavigateScreen(s.Name)">
                    <span class="rv-bottom-tab-icon">&#x1F5BC;</span>
                    <span class="rv-bottom-tab-label">@s.Name</span>
                </button>
            }
        </div>
    }
</div>

@* -- Hamburger menu overlay -- *@
@if (_hamburgerOpen)
{
    <div class="rv-hamburger-backdrop" @onclick="() => _hamburgerOpen = false"></div>
    <div class="rv-hamburger-menu">
        <div class="rv-hamburger-header">
            <span>Navigation</span>
            <button class="rv-hamburger-close" @onclick="() => _hamburgerOpen = false">&#x2715;</button>
        </div>
        @foreach (var scr in NavigableScreens)
        {
            var s = scr;
            <div class="rv-hamburger-item @(s == _currentScreen ? "active" : "")"
                 @onclick="() => { DoNavigateScreen(s.Name); _hamburgerOpen = false; }">
                <span>&#x1F5BC;</span>
                <span>@s.Name</span>
            </div>
        }
    </div>
}

@* -- Kiosk fullscreen prompt -- *@
@if (Project.IsKiosk && !_isFullscreen)
{
    <div class="rv-kiosk-prompt" @onclick="EnterFullscreen">
        <div class="rv-kiosk-prompt-box">
            <div class="rv-kiosk-prompt-icon">&#x26F6;</div>
            <div class="rv-kiosk-prompt-text">Click anywhere to enter fullscreen</div>
            <div class="rv-kiosk-prompt-hint">Press Escape to exit fullscreen later</div>
        </div>
    </div>
}

@* -- Popup overlay -- *@
@if (_popupScreen != null)
{
    <div class="rv-popup-backdrop" @onclick="ClosePopup"></div>
    <div class="rv-popup">
        <div class="rv-popup-header">
            <span>@_popupScreen.Name</span>
            <button class="rv-popup-close" @onclick="ClosePopup">✕</button>
        </div>
        <div class="rv-popup-body">
            <ScreenRenderer Screen="_popupScreen" OnRequestLogin="ShowAccessLoginPrompt" />
        </div>
    </div>
}

@* -- Modal overlay -- *@
@if (_modalScreen != null)
{
    <div class="rv-modal-backdrop"></div>
    <div class="rv-modal">
        <div class="rv-modal-header">
            <span>@_modalScreen.Name</span>
            <button class="rv-popup-close" @onclick="CloseModal">✕</button>
        </div>
        <div class="rv-modal-body">
            <ScreenRenderer Screen="_modalScreen" OnRequestLogin="ShowAccessLoginPrompt" />
        </div>
    </div>
}

@* -- Access login prompt (shown when clicking a locked symbol) -- *@
@if (_showAccessLogin)
{
    <div class="rv-login-overlay rv-login-overlay-access" @onclick="DismissAccessLogin">
        <div class="rv-login-card" @onclick:stopPropagation>
            <div class="rv-login-header">
                <span>🔒</span>
                <span>Authentication Required</span>
            </div>
            <div class="rv-login-body">
                <div class="rv-login-hint">This action requires write access. Please sign in.</div>
                @if (!string.IsNullOrEmpty(_loginError))
                {
                    <div class="rv-login-error">@_loginError</div>
                }
                <div class="rv-login-field">
                    <label>Username</label>
                    <input type="text" @bind="_loginUsername" @onkeydown="OnLoginKeyDown"
                           placeholder="Enter username" autofocus />
                </div>
                <div class="rv-login-field">
                    <label>Password</label>
                    <input type="password" @bind="_loginPassword" @onkeydown="OnLoginKeyDown"
                           placeholder="Enter password" />
                </div>
                <button class="rv-login-btn" @onclick="DoAccessLogin" disabled="@_loginBusy">
                    @if (_loginBusy)
                    {
                        <span>Signing in…</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
                <button class="rv-login-btn-cancel" @onclick="DismissAccessLogin">Cancel</button>
            </div>
        </div>
    </div>
}

@* -- Toast notifications -- *@
@if (_toasts.Count > 0)
{
    <div class="rv-toast-container">
        @foreach (var toast in _toasts)
        {
            var t = toast;
            <div class="rv-toast rv-toast-@t.Type @(t.FadeOut ? "rv-toast-fade-out" : "")">
                <span class="rv-toast-icon">@ToastIcon(t.Type)</span>
                <div class="rv-toast-body">
                    <div class="rv-toast-title">@t.Title</div>
                    @if (!string.IsNullOrEmpty(t.Message))
                    {
                        <div class="rv-toast-message">@t.Message</div>
                    }
                </div>
                <button class="rv-toast-close" @onclick="() => DismissToast(t.Id)">&#x2715;</button>
            </div>
        }
    </div>
}

} @* end else (authenticated) *@

@code {
    [Parameter] public string? ScreenName { get; set; }

    [Inject] private ProjectService Project { get; set; } = default!;
    [Inject] private OpcRuntimeClient Opc { get; set; } = default!;
    [Inject] private CommandService Commands { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private RuntimeAuthService Auth { get; set; } = default!;
    [Inject] private LocalizationService Localization { get; set; } = default!;
    [Inject] private PushNotificationInterop PushInterop { get; set; } = default!;

    private ScreenConfig? _currentScreen;
    private ScreenConfig? _popupScreen;
    private ScreenConfig? _modalScreen;
    private bool _connecting;
    private bool _isFullscreen;
    private IJSObjectReference? _kioskModule;

    // Login state
    private bool _loginRequired;
    private bool _hasUsers;
    private bool _showAccessLogin;
    private string _loginUsername = "";
    private string _loginPassword = "";
    private string _loginError = "";
    private bool _loginBusy;

    // Change password state
    private string _changePwCurrent = "";
    private string _changePwNew = "";
    private string _changePwConfirm = "";
    private string _changePwError = "";
    private string _changePwSuccess = "";

    // Idle auto-logoff
    private DateTime _lastActivity = DateTime.UtcNow;
    private System.Threading.Timer? _idleTimer;
    private DotNetObjectReference<Home>? _idleRef;

    // Toast notifications
    private List<ToastItem> _toasts = new();
    private int _toastId;
    private bool _hamburgerOpen;

    // Tag Browser
    private bool _showTagBrowser;

    // Diagnostics
    private bool _bestFit = true;
    private bool _showDiag;
    private int _diagValueCount;
    private System.Threading.Timer? _diagTimer;
    private ElementReference _diagScrollRef;

    // Push Notifications
    private bool _pushSupported;
    private bool _pushSubscribed;
    private bool _pushBusy;
    private string? _vapidPublicKey;

    protected override void OnInitialized()
    {
        _loginRequired = RuntimeAuthService.IsLoginRequired(Project.Model);
        Commands.NavigateScreen += DoNavigateScreen;
        _hasUsers = (Project.Model?.Users?.Count ?? 0) > 0;
        Commands.OpenScreenPopup += DoOpenPopup;
        Commands.OpenScreenModal += DoOpenModal;
        Commands.RequestLogin += OnCommandLogin;
        Commands.RequestLogout += OnCommandLogout;
        Commands.ChangeLanguage += OnChangeLanguage;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Project.IsKiosk)
        {
            _kioskModule = await JS.InvokeAsync<IJSObjectReference>("import", "./kiosk.js");
            _isFullscreen = await _kioskModule.InvokeAsync<bool>("isFullscreen");
            StateHasChanged();
        }

        if (firstRender && _loginRequired)
        {
            // Register idle activity tracking via JS interop
            _idleRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("eval", """
                window.__rvSetupIdle = function(dotNetRef) {
                    window.__rvIdleRef = dotNetRef;
                    var handler = function() { dotNetRef.invokeMethodAsync('OnUserActivity'); };
                    document.addEventListener('mousemove', handler);
                    document.addEventListener('keydown', handler);
                    document.addEventListener('click', handler);
                    document.addEventListener('touchstart', handler);
                };
            """);
            await JS.InvokeVoidAsync("__rvSetupIdle", _idleRef);

            // Start idle check timer (every 5 seconds)
            _idleTimer = new System.Threading.Timer(CheckIdleTimeout, null, 5000, 5000);
        }

        if (firstRender)
        {
            await InitPushNotificationsAsync();
        }
    }

    [JSInvokable]
    public void OnUserActivity()
    {
        _lastActivity = DateTime.UtcNow;
    }

    private void CheckIdleTimeout(object? state)
    {
        if (!Auth.IsAuthenticated || Auth.AutoLogOffSeconds <= 0) return;

        var idleSeconds = (DateTime.UtcNow - _lastActivity).TotalSeconds;
        if (idleSeconds >= Auth.AutoLogOffSeconds)
        {
            InvokeAsync(() =>
            {
                DoLogout();
                ShowToast("warning", "Session Expired", "You have been logged out due to inactivity.");
                _loginError = "You have been logged out due to inactivity.";
                StateHasChanged();
            });
        }
    }

    private async Task EnterFullscreen()
    {
        if (_kioskModule != null)
        {
            await _kioskModule.InvokeVoidAsync("enterFullscreen");
            _isFullscreen = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(ScreenName))
        {
            _currentScreen = Project.Screens.FirstOrDefault(s =>
                s.Name.Equals(ScreenName, StringComparison.OrdinalIgnoreCase));
        }

        _currentScreen ??= Project.StartupScreen;

        // If the resolved screen is restricted for the current user's group, fall back
        if (_currentScreen != null && !Auth.IsGroupAllowed(_currentScreen.AllowedGroups))
        {
            _currentScreen = NavigableScreens.FirstOrDefault();
        }

        if (!Opc.IsConnected && !_connecting && !string.IsNullOrEmpty(Project.Settings.EndpointUrl))
        {
            // When anonymous is disabled, wait for the user to log in first
            if (!Project.Settings.EnableAnonymous && _loginRequired && !Auth.IsAuthenticated)
                return;
            await Connect();
        }
    }

    private string? _opcPassword;

    private async Task Connect()
    {
        _connecting = true;
        StateHasChanged();

        // When anonymous access is disabled, use the logged-in user's credentials
        if (Auth.IsAuthenticated && !(Project.Settings.EnableAnonymous))
            await Opc.ConnectAsync(Project.Settings.EndpointUrl, Auth.Username, _opcPassword);
        else
            await Opc.ConnectAsync(Project.Settings.EndpointUrl);

        _connecting = false;
        if (Opc.IsConnected)
            ShowToast("success", "Connected", "OPC server connection established.");
        else if (!string.IsNullOrEmpty(Opc.ErrorMessage))
            ShowToast("error", "Connection Failed", Opc.ErrorMessage);
        StateHasChanged();
    }

    private void DoNavigateScreen(string name)
    {
        InvokeAsync(() =>
        {
            ShowToast("info", "Navigate", $"Switching to {name}");
            Nav.NavigateTo($"/screen/{Uri.EscapeDataString(name)}");
            StateHasChanged();
        });
    }

    private void DoOpenPopup(string name)
    {
        InvokeAsync(() =>
        {
            var screen = Project.Screens.FirstOrDefault(s =>
                s.Name.Equals(name, StringComparison.OrdinalIgnoreCase));
            if (screen != null && !Auth.IsGroupAllowed(screen.AllowedGroups)) return;
            _popupScreen = screen;
            StateHasChanged();
        });
    }

    private void DoOpenModal(string name)
    {
        InvokeAsync(() =>
        {
            var screen = Project.Screens.FirstOrDefault(s =>
                s.Name.Equals(name, StringComparison.OrdinalIgnoreCase));
            if (screen != null && !Auth.IsGroupAllowed(screen.AllowedGroups)) return;
            _modalScreen = screen;
            StateHasChanged();
        });
    }

    private void ClosePopup() { _popupScreen = null; }
    private void CloseModal() { _modalScreen = null; }

    // ─── Login / Logout ──────────────────────────────────────

    private async Task OnLoginKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoLogin();
    }

    private async Task DoLogin()
    {
        _loginError = "";
        _loginBusy = true;
        StateHasChanged();

        await Task.Delay(100); // UI feedback

        var model = Project.Model;
        if (model == null)
        {
            _loginError = "No project loaded.";
            _loginBusy = false;
            return;
        }

        var (success, message) = Auth.Login(_loginUsername, _loginPassword, model.Users, model.UserGroups);
        _loginBusy = false;

        if (success)
        {
            _opcPassword = _loginPassword;
            _loginError = "";
            _loginUsername = "";
            _loginPassword = "";
            _lastActivity = DateTime.UtcNow;
            ShowToast("success", "Signed In", $"Welcome, {Auth.Username}.");

            // (Re)connect to OPC with the authenticated credentials
            if (!Opc.IsConnected && !string.IsNullOrEmpty(Project.Settings.EndpointUrl))
                await Connect();
        }
        else
        {
            _loginError = message;
        }
    }

    private void DoLogout()
    {
        ShowToast("info", "Signed Out", "You have been logged out.");
        Auth.Logout();
        _opcPassword = null;
        _popupScreen = null;
        _modalScreen = null;
        _loginUsername = "";
        _loginPassword = "";
        _loginError = "";

        // Disconnect OPC when anonymous is not allowed
        if (!Project.Settings.EnableAnonymous)
            Opc.Disconnect();
    }

    private void ShowAccessLoginPrompt()
    {
        _loginError = "";
        _loginUsername = "";
        _loginPassword = "";
        _showAccessLogin = true;
    }

    private async Task DoAccessLogin()
    {
        _loginError = "";
        _loginBusy = true;
        StateHasChanged();

        await Task.Delay(100);

        var model = Project.Model;
        if (model == null)
        {
            _loginError = "No project loaded.";
            _loginBusy = false;
            return;
        }

        var (success, message) = Auth.Login(_loginUsername, _loginPassword, model.Users, model.UserGroups);
        _loginBusy = false;

        if (success)
        {
            _showAccessLogin = false;
            _loginError = "";
            _loginUsername = "";
            _loginPassword = "";
        }
        else
        {
            _loginError = message;
        }
    }

    private void DismissAccessLogin()
    {
        _showAccessLogin = false;
        _loginError = "";
        _loginUsername = "";
        _loginPassword = "";
    }

    private void OnCommandLogin()
    {
        InvokeAsync(() =>
        {
            ShowAccessLoginPrompt();
            StateHasChanged();
        });
    }

    private void OnCommandLogout()
    {
        InvokeAsync(() =>
        {
            DoLogout();
            StateHasChanged();
        });
    }

    private void OnChangeLanguage(string lang)
    {
        Localization.SetLanguage(lang);
        InvokeAsync(StateHasChanged);
    }

    // ─── Change Password ─────────────────────────────────────

    private async Task OnChangePwKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoChangePassword();
    }

    private Task DoChangePassword()
    {
        _changePwError = "";
        _changePwSuccess = "";

        var requireStrong = Project.Model?.Server?.RequireStrongPassword ?? false;
        var (success, message) = Auth.ChangePassword(_changePwCurrent, _changePwNew, _changePwConfirm, requireStrong);
        if (success)
        {
            _changePwSuccess = message;
            _changePwCurrent = "";
            _changePwNew = "";
            _changePwConfirm = "";
            ShowToast("success", "Password Changed", message);
            // Persist the password change to the nodes.json file
            SaveProjectQuietly();
        }
        else
        {
            _changePwError = message;
        }

        return Task.CompletedTask;
    }

    private void SaveProjectQuietly()
    {
        try
        {
            var model = Project.Model;
            if (model != null && !string.IsNullOrEmpty(Project.ConfigPath))
            {
                var options = new System.Text.Json.JsonSerializerOptions { WriteIndented = true };
                var json = System.Text.Json.JsonSerializer.Serialize(model, options);
                File.WriteAllText(Project.ConfigPath, json);
            }
        }
        catch { /* best effort */ }
    }

    private void ToggleDiag()
    {
        _showDiag = !_showDiag;
        if (_showDiag)
        {
            Opc.StateChanged += OnDiagStateChanged;
            _diagTimer = new System.Threading.Timer(_ =>
            {
                _ = InvokeAsync(() =>
                {
                    _diagValueCount = GetCachedValues().Count;
                    StateHasChanged();
                });
            }, null, 500, 1000);
        }
        else
        {
            Opc.StateChanged -= OnDiagStateChanged;
            _diagTimer?.Dispose();
            _diagTimer = null;
        }
    }

    private void OnDiagStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleTagBrowser()
    {
        _showTagBrowser = !_showTagBrowser;
    }

    // ─── Push Notification helpers ──────────────────────
    private async Task InitPushNotificationsAsync()
    {
        try
        {
            var webPush = Project.Settings.AlarmNotification?.WebPush;
            if (webPush is not { Enabled: true }) return;

            _pushSupported = await PushInterop.IsSupportedAsync();
            if (!_pushSupported) return;

            await PushInterop.RegisterServiceWorkerAsync();

            // Fetch VAPID public key from the server
            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
            var resp = await http.GetFromJsonAsync<VapidKeyResponse>("/api/push/vapid-key");
            _vapidPublicKey = resp?.PublicKey;
            if (string.IsNullOrEmpty(_vapidPublicKey)) { _pushSupported = false; return; }

            // Check if already subscribed
            var existing = await PushInterop.GetSubscriptionAsync();
            _pushSubscribed = existing != null;
            StateHasChanged();
        }
        catch
        {
            _pushSupported = false;
        }
    }

    private async Task TogglePushNotifications()
    {
        if (_pushBusy || string.IsNullOrEmpty(_vapidPublicKey)) return;
        _pushBusy = true;
        try
        {
            if (_pushSubscribed)
            {
                // Get current subscription to unregister from server
                var current = await PushInterop.GetSubscriptionAsync();
                if (current != null)
                {
                    using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
                    await http.PostAsJsonAsync("/api/push/unsubscribe",
                        new { current.Endpoint, current.P256dh, current.Auth });
                }
                await PushInterop.UnsubscribeAsync();
                _pushSubscribed = false;
                ShowToast("info", "Push notifications disabled");
            }
            else
            {
                var sub = await PushInterop.SubscribeAsync(_vapidPublicKey);
                if (sub != null)
                {
                    using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
                    await http.PostAsJsonAsync("/api/push/subscribe",
                        new { sub.Endpoint, sub.P256dh, sub.Auth });
                    _pushSubscribed = true;
                    ShowToast("success", "Push notifications enabled");
                }
                else
                {
                    ShowToast("warning", "Notification permission denied");
                }
            }
        }
        catch (Exception ex)
        {
            ShowToast("error", "Push error", ex.Message);
        }
        finally
        {
            _pushBusy = false;
        }
    }

    private record VapidKeyResponse(string PublicKey);

    private List<KeyValuePair<string, string>> GetCachedValues()
    {
        // Collect all known variable paths from current screen and read their cached values
        var result = new List<KeyValuePair<string, string>>();
        if (_currentScreen == null) return result;

        var paths = _currentScreen.Symbols
            .Where(s => !string.IsNullOrEmpty(s.VariablePath))
            .Select(s => s.VariablePath!)
            .Distinct();

        foreach (var p in paths)
        {
            var v = Opc.GetValue(p);
            result.Add(new KeyValuePair<string, string>(p, v ?? "(null)"));
        }
        return result;
    }

    // ─── Toast helpers ─────────────────────────────────────
    private record ToastItem(int Id, string Type, string Title, string Message, bool FadeOut = false);

    private void ShowToast(string type, string title, string message = "")
    {
        var id = ++_toastId;
        _toasts.Add(new ToastItem(id, type, title, message));
        _ = AutoDismissToast(id);
    }

    private async Task AutoDismissToast(int id)
    {
        await Task.Delay(4000);
        await InvokeAsync(() => { FadeOutToast(id); StateHasChanged(); });
        await Task.Delay(300);
        await InvokeAsync(() => { _toasts.RemoveAll(t => t.Id == id); StateHasChanged(); });
    }

    private void FadeOutToast(int id)
    {
        var idx = _toasts.FindIndex(t => t.Id == id);
        if (idx >= 0) _toasts[idx] = _toasts[idx] with { FadeOut = true };
    }

    private void DismissToast(int id)
    {
        _toasts.RemoveAll(t => t.Id == id);
    }

    private string ToastIcon(string type) => type switch
    {
        "success" => "\u2705",
        "error" => "\u274C",
        "warning" => "\u26A0\uFE0F",
        _ => "\u2139\uFE0F"
    };

    private List<ScreenConfig> NavigableScreens => Project.Screens
        .Where(s => s.ShowInNavigation && Auth.IsGroupAllowed(s.AllowedGroups))
        .ToList();
    private string NavStyle => Project.Settings.NavigationStyle?.ToLowerInvariant() ?? "tabs";

    public async void Dispose()
    {
        Commands.NavigateScreen -= DoNavigateScreen;
        Commands.OpenScreenPopup -= DoOpenPopup;
        Commands.OpenScreenModal -= DoOpenModal;
        Commands.RequestLogin -= OnCommandLogin;
        Commands.RequestLogout -= OnCommandLogout;
        Commands.ChangeLanguage -= OnChangeLanguage;
        Opc.StateChanged -= OnDiagStateChanged;
        _idleTimer?.Dispose();
        _diagTimer?.Dispose();
        _idleRef?.Dispose();
        if (_kioskModule != null)
        {
            try { await _kioskModule.DisposeAsync(); } catch { }
        }
    }
}
