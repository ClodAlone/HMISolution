        {
            var vars = sym.PopupVariables.Split(';', StringSplitOptions.RemoveEmptyEntries);
            for (int i = 0; i < vars.Length && i < 5; i++)
            {
                var path = vars[i].Trim();
                var val = Opc.GetValue(path) ?? "--";
                var label = path.Contains('.') ? path[(path.LastIndexOf('.') + 1)..] : path;
                builder.OpenElement(seq++, "text");
                builder.AddAttribute(seq++, "x", F(8)); builder.AddAttribute(seq++, "y", F(32 + i * 14));
                builder.AddAttribute(seq++, "fill", "#94a3b8"); builder.AddAttribute(seq++, "font-size", 9);
                builder.AddContent(seq++, $"{label}: {val}");
                builder.CloseElement();
            }
        }
    };

    // â”€â”€ Setpoint Ramp (SVG) â”€â”€
    private RenderFragment RenderSetpointRamp(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width; var h = sym.Height;
        var range = sym.SetpointMax - sym.SetpointMin;
        if (range <= 0) range = 100;

        double.TryParse(liveValue, NumberStyles.Float, CultureInfo.InvariantCulture, out var current);
        var targetStr = !string.IsNullOrEmpty(sym.SetpointTargetPath) ? Opc.GetValue(sym.SetpointTargetPath) : null;
        double.TryParse(targetStr, NumberStyles.Float, CultureInfo.InvariantCulture, out var target);

        // Background
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w); builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", 4); builder.AddAttribute(seq++, "fill", "#1e293b");
        builder.AddAttribute(seq++, "stroke", "#334155"); builder.AddAttribute(seq++, "stroke-width", 1);
        builder.CloseElement();

        // Current value bar
        var curFrac = Math.Clamp((current - sym.SetpointMin) / range, 0, 1);
        var curX = 10 + curFrac * (w - 20);
        builder.OpenElement(seq++, "line");
        builder.AddAttribute(seq++, "x1", 10); builder.AddAttribute(seq++, "y1", F(h * 0.6));
        builder.AddAttribute(seq++, "x2", F(curX)); builder.AddAttribute(seq++, "y2", F(h * 0.6));
        builder.AddAttribute(seq++, "stroke", sym.SetpointColor); builder.AddAttribute(seq++, "stroke-width", 3);
        builder.CloseElement();

        // Target marker
        var tgtFrac = Math.Clamp((target - sym.SetpointMin) / range, 0, 1);
        var tgtX = 10 + tgtFrac * (w - 20);
        builder.OpenElement(seq++, "line");
        builder.AddAttribute(seq++, "x1", F(tgtX)); builder.AddAttribute(seq++, "y1", F(h * 0.4));
        builder.AddAttribute(seq++, "x2", F(tgtX)); builder.AddAttribute(seq++, "y2", F(h * 0.8));
        builder.AddAttribute(seq++, "stroke", sym.SetpointTargetColor); builder.AddAttribute(seq++, "stroke-width", 2);
        builder.AddAttribute(seq++, "stroke-dasharray", "4,2");
        builder.CloseElement();

        // Ramp arrow
        builder.OpenElement(seq++, "line");
        builder.AddAttribute(seq++, "x1", F(curX)); builder.AddAttribute(seq++, "y1", F(h * 0.6));
        builder.AddAttribute(seq++, "x2", F(tgtX)); builder.AddAttribute(seq++, "y2", F(h * 0.6));
        builder.AddAttribute(seq++, "stroke", sym.SetpointTargetColor); builder.AddAttribute(seq++, "stroke-width", 1);
        builder.AddAttribute(seq++, "stroke-dasharray", "2,2"); builder.AddAttribute(seq++, "opacity", "0.6");
        builder.CloseElement();

        // Labels
        builder.OpenElement(seq++, "text");
        builder.AddAttribute(seq++, "x", F(10)); builder.AddAttribute(seq++, "y", F(14));
        builder.AddAttribute(seq++, "fill", sym.SetpointColor); builder.AddAttribute(seq++, "font-size", 10);
        builder.AddContent(seq++, $"{F(current)} {sym.SetpointUnit}");
        builder.CloseElement();

        builder.OpenElement(seq++, "text");
        builder.AddAttribute(seq++, "x", F(w - 10)); builder.AddAttribute(seq++, "y", F(14));
        builder.AddAttribute(seq++, "text-anchor", "end");
        builder.AddAttribute(seq++, "fill", sym.SetpointTargetColor); builder.AddAttribute(seq++, "font-size", 10);
        builder.AddContent(seq++, $"â†’ {F(target)} {sym.SetpointUnit}");
        builder.CloseElement();

        if (sym.SetpointShowRate && !string.IsNullOrEmpty(sym.SetpointRatePath))
        {
            var rateVal = Opc.GetValue(sym.SetpointRatePath) ?? "--";
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(w / 2.0)); builder.AddAttribute(seq++, "y", F(h - 4));
            builder.AddAttribute(seq++, "text-anchor", "middle");
            builder.AddAttribute(seq++, "fill", "#94a3b8"); builder.AddAttribute(seq++, "font-size", 9);
            builder.AddContent(seq++, $"Rate: {rateVal}/min");
            builder.CloseElement();
        }
    };

    // â”€â”€ Flow Meter (SVG) â”€â”€
    private RenderFragment RenderFlowMeter(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
