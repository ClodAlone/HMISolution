    // ANIMATION SYSTEM â€” CSS @keyframes generation for symbol animations
    // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

    /// <summary>
    /// Evaluates whether an OnVariable-triggered animation's condition is currently met.
    /// </summary>
    private bool IsAnimationTriggered(SymbolAnimation anim)
    {
        if (string.IsNullOrEmpty(anim.TriggerVariable)) return false;
        var val = Opc.GetValue(anim.TriggerVariable);
        if (string.IsNullOrEmpty(val)) return false;
        if (string.IsNullOrEmpty(anim.TriggerCondition)) return val != "0" && !string.Equals(val, "false", StringComparison.OrdinalIgnoreCase);
        var cond = anim.TriggerCondition.Trim();
        if (double.TryParse(val, System.Globalization.NumberStyles.Any, _ci, out var numVal))
        {
            if (cond.StartsWith(">=") && double.TryParse(cond[2..], System.Globalization.NumberStyles.Any, _ci, out var th)) return numVal >= th;
            if (cond.StartsWith("<=") && double.TryParse(cond[2..], System.Globalization.NumberStyles.Any, _ci, out th)) return numVal <= th;
            if (cond.StartsWith(">") && double.TryParse(cond[1..], System.Globalization.NumberStyles.Any, _ci, out th)) return numVal > th;
            if (cond.StartsWith("<") && double.TryParse(cond[1..], System.Globalization.NumberStyles.Any, _ci, out th)) return numVal < th;
            if (cond.StartsWith("==" ) && double.TryParse(cond[2..], System.Globalization.NumberStyles.Any, _ci, out th)) return Math.Abs(numVal - th) < 0.001;
            if (cond.StartsWith("!=") && double.TryParse(cond[2..], System.Globalization.NumberStyles.Any, _ci, out th)) return Math.Abs(numVal - th) >= 0.001;
        }
        return string.Equals(val, cond, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Checks whether an animation should be active (enabled, has keyframes, trigger met).
    /// </summary>
    private bool IsAnimActive(SymbolAnimation anim)
    {
        if (!anim.Enabled || anim.Keyframes.Count == 0) return false;
        if (anim.Trigger == "OnVariable" && !IsAnimationTriggered(anim)) return false;
        return true;
    }

    /// <summary>
    /// Builds all CSS @keyframes rules for every symbol animation on the current screen.
    /// Position animations use translate(X,Y) in absolute SVG coordinates.
    /// Scale/Rotation use local-space transforms (applied on the inner &lt;g&gt;).
    /// Width/Height animate the actual SVG width/height attributes via CSS.
    /// StrokeWidth/Opacity/Fill/Stroke animate SVG presentation attributes directly.
    /// </summary>
    private string BuildAllKeyframesCss()
    {
        if (Screen == null) return "";
        var sb = new System.Text.StringBuilder();

        foreach (var sym in Screen.Symbols)
        {
            foreach (var anim in sym.Animations)
            {
                if (!IsAnimActive(anim)) continue;

                var animName = $"anim_{sym.Id}_{anim.Id}";
                sb.AppendLine($"@keyframes {animName} {{");

                foreach (var kf in anim.Keyframes.OrderBy(k => k.Percent))
                {
                    sb.Append($"  {kf.Percent.ToString("F0", _ci)}% {{ ");

                    switch (anim.Property)
                    {
                        case "Position":
                            var parts = kf.Value.Split(',');
                            if (parts.Length == 2 &&
                                double.TryParse(parts[0].Trim(), System.Globalization.NumberStyles.Any, _ci, out var px) &&
                                double.TryParse(parts[1].Trim(), System.Globalization.NumberStyles.Any, _ci, out var py))
                            {
                                // Absolute translate â€” replaces the SVG transform on the outer <g>
                                sb.Append($"transform: translate({px.ToString("F1", _ci)}px, {py.ToString("F1", _ci)}px); ");
                            }
                            break;
                        case "Scale":
                            var sparts = kf.Value.Split(',');
                            var sx = kf.Value;
                            var sy = kf.Value;
                            if (sparts.Length == 2) { sx = sparts[0].Trim(); sy = sparts[1].Trim(); }
                            // Local-space scale on inner <g>, transform-origin centers it
                            sb.Append($"transform: scale({sx}, {sy}); ");
                            break;
                        case "Rotation":
                            // Local-space rotation on inner <g>, transform-origin centers it
                            sb.Append($"transform: rotate({kf.Value}deg); ");
                            break;
                        case "Opacity":
                            sb.Append($"opacity: {kf.Value}; ");
                            break;
                        case "Fill":
                            sb.Append($"fill: {kf.Value}; ");
                            break;
                        case "Stroke":
                            sb.Append($"stroke: {kf.Value}; ");
                            break;
                        case "StrokeWidth":
                            // stroke-width is an inherited SVG presentation attribute
                            sb.Append($"stroke-width: {kf.Value}px; ");
                            break;
                        case "Width":
                            if (double.TryParse(kf.Value, System.Globalization.NumberStyles.Any, _ci, out var newW) && sym.Width > 0)
                            {
                                var scaleX = newW / sym.Width;
                                // Scale from the left edge (transform-origin: 0 center)
                                sb.Append($"transform: scaleX({scaleX.ToString("F3", _ci)}); ");
                            }
                            break;
                        case "Height":
                            if (double.TryParse(kf.Value, System.Globalization.NumberStyles.Any, _ci, out var newH) && sym.Height > 0)
                            {
                                var scaleY = newH / sym.Height;
                                // Scale from the top edge (transform-origin: center 0)
                                sb.Append($"transform: scaleY({scaleY.ToString("F3", _ci)}); ");
                            }
                            break;
                    }

                    sb.AppendLine("}");
                }

                sb.AppendLine("}");
            }
        }

        return sb.ToString();
    }

    /// <summary>
    /// Builds the inline CSS animation style for the OUTER &lt;g&gt; element.
    /// Only Position animations go here (they need to override the SVG translate).
    /// </summary>
    private string BuildPositionAnimStyle(ScreenSymbol sym)
    {
        if (sym.Animations.Count == 0) return "";
        var sb = new System.Text.StringBuilder();
        var first = true;

        foreach (var anim in sym.Animations)
        {
            if (!IsAnimActive(anim)) continue;
            if (anim.Property != "Position") continue;

            var animName = $"anim_{sym.Id}_{anim.Id}";
            var dur = (anim.DurationMs / 1000.0).ToString("F2", _ci);
            var delay = (anim.DelayMs / 1000.0).ToString("F2", _ci);
            var iteration = anim.RepeatCount == 0 ? "infinite" : anim.RepeatCount.ToString();
            var direction = anim.AutoReverse ? "alternate" : "normal";
            var easing = MapEasing(anim.Easing);

            if (!first) sb.Append(", ");
            sb.Append($"{animName} {dur}s {easing} {delay}s {iteration} {direction}");
            first = false;
        }

        if (sb.Length == 0) return "";
        return $"animation: {sb};";
    }

    /// <summary>
    /// Builds the inline CSS animation style for the INNER &lt;g&gt; element.
    /// Handles: Scale, Rotation, Opacity, Fill, Stroke, StrokeWidth, Width, Height.
    /// These all operate in local coordinates (0,0 is the symbol's top-left).
    /// </summary>
    private string BuildLocalAnimStyle(ScreenSymbol sym)
    {
        if (sym.Animations.Count == 0) return "";
        var sb = new System.Text.StringBuilder();
        var first = true;
        var needsOriginCenter = false;
        var needsOriginLeft = false;
        var needsOriginTop = false;

        foreach (var anim in sym.Animations)
        {
            if (!IsAnimActive(anim)) continue;
            if (anim.Property == "Position") continue; // Handled by outer <g>

            var animName = $"anim_{sym.Id}_{anim.Id}";
            var dur = (anim.DurationMs / 1000.0).ToString("F2", _ci);
            var delay = (anim.DelayMs / 1000.0).ToString("F2", _ci);
            var iteration = anim.RepeatCount == 0 ? "infinite" : anim.RepeatCount.ToString();
            var direction = anim.AutoReverse ? "alternate" : "normal";
            var easing = MapEasing(anim.Easing);

            if (!first) sb.Append(", ");
            sb.Append($"{animName} {dur}s {easing} {delay}s {iteration} {direction}");
            first = false;

            if (anim.Property is "Scale" or "Rotation") needsOriginCenter = true;
            if (anim.Property == "Width") needsOriginLeft = true;
            if (anim.Property == "Height") needsOriginTop = true;
        }

        if (sb.Length == 0) return "";

        // Set transform-origin for the inner <g> in local coordinates
        var originX = needsOriginLeft ? "0px" : $"{F(sym.Width / 2)}px";
        var originY = needsOriginTop ? "0px" : $"{F(sym.Height / 2)}px";
        var origin = (needsOriginCenter || needsOriginLeft || needsOriginTop)
            ? $" transform-origin: {originX} {originY};"
            : "";

        return $"animation: {sb};{origin}";
    }

    private static string MapEasing(string easing) => easing switch
    {
        "EaseIn" => "ease-in",
        "EaseOut" => "ease-out",
        "EaseInOut" => "ease-in-out",
        "Bounce" => "cubic-bezier(0.34, 1.56, 0.64, 1)",
        "Elastic" => "cubic-bezier(0.68, -0.55, 0.27, 1.55)",
        _ => "linear"
    };


    // â”€â”€â”€ Animated Text rendering (SVG canvas via foreignObject) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    private RenderFragment RenderAnimText(ScreenSymbol sym, string resolvedLabel) => builder =>
    {
        int seq = 0;
        var w = sym.Width;
        var h = sym.Height;
        var mode = sym.AnimTextMode ?? "scroll";
        var speed = sym.AnimTextSpeed > 0 ? sym.AnimTextSpeed : 5;
        var color1 = sym.Fill ?? "#00e5ff";
        var color2 = sym.AnimTextColor2 ?? "#ff4444";
        var bg1 = sym.AnimTextBackground ?? "";
        var bg2 = sym.AnimTextBackground2 ?? "";
        var radius = sym.AnimTextBorderRadius;
        var showBorder = sym.AnimTextShowBorder;
        var fontSize = sym.FontSize > 0 ? sym.FontSize : 14;
        var fontFamily = string.IsNullOrEmpty(sym.FontFamily) ? "sans-serif" : sym.FontFamily;
        var fontWeight = string.IsNullOrEmpty(sym.FontWeight) ? "normal" : sym.FontWeight;
        var fontStyle = string.IsNullOrEmpty(sym.FontStyle) ? "normal" : sym.FontStyle;

        // Build message list
        var messages = new List<string>();
        if (!string.IsNullOrWhiteSpace(sym.AnimTextMessages))
        {
            foreach (var line in sym.AnimTextMessages.Split('\n', StringSplitOptions.RemoveEmptyEntries))
            {
                var trimmed = line.Trim();
                if (!string.IsNullOrEmpty(trimmed))
                    messages.Add(Localization.Resolve(trimmed));
            }
        }
        if (messages.Count == 0)
            messages.Add(resolvedLabel);

        var uniqueId = $"animtext_{sym.Id}";

        // foreignObject wrapper
        builder.OpenElement(seq++, "foreignObject");
        builder.AddAttribute(seq++, "width", w);
        builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "x", 0);
        builder.AddAttribute(seq++, "y", 0);

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "xmlns", "http://www.w3.org/1999/xhtml");

        var containerStyle = $"width:{w}px;height:{h}px;overflow:hidden;position:relative;" +
            $"border-radius:{radius}px;display:flex;align-items:center;justify-content:center;" +
            $"font-family:{fontFamily};font-size:{fontSize}px;font-weight:{fontWeight};font-style:{fontStyle};" +
            (!string.IsNullOrEmpty(bg1) ? $"background:{bg1};" : "") +
            (showBorder ? $"border:1px solid {sym.Stroke};" : "");

        builder.AddAttribute(seq++, "style", containerStyle);

        // Style tag with animations
        builder.OpenElement(seq++, "style");
        var css = "";
        switch (mode)
        {
            case "scroll":
                css = $@"
@keyframes {uniqueId}_scroll {{ 0% {{ transform: translateX(100%); }} 100% {{ transform: translateX(-100%); }} }}
.{uniqueId}_container {{ white-space: nowrap; animation: {uniqueId}_scroll {F(speed)}s linear infinite; color: {color1}; }}";
                break;
            case "flash":
                css = $@"
@keyframes {uniqueId}_flash {{
  0%,49% {{ color: {color1}; {(string.IsNullOrEmpty(bg1) ? "" : $"background: {bg1};")} }}
  50%,100% {{ color: {color2}; {(string.IsNullOrEmpty(bg2) ? "" : $"background: {bg2};")} }}
}}
.{uniqueId}_container {{ animation: {uniqueId}_flash {F(speed)}s step-end infinite; text-align:center; }}";
                break;
            case "pulse":
                css = $@"
@keyframes {uniqueId}_pulse {{ 0%,100% {{ opacity: 1; }} 50% {{ opacity: 0.2; }} }}
.{uniqueId}_container {{ animation: {uniqueId}_pulse {F(speed)}s ease-in-out infinite; color: {color1}; text-align:center; }}";
                break;
            case "typewriter":
                var charCount = messages[0].Length;
                css = $@"
@keyframes {uniqueId}_type {{ from {{ width: 0; }} to {{ width: {charCount}ch; }} }}
@keyframes {uniqueId}_blink {{ 50% {{ border-color: transparent; }} }}
.{uniqueId}_container {{ overflow:hidden; white-space:nowrap; border-right:2px solid {color1}; width:0; color:{color1};
  animation: {uniqueId}_type {F(speed)}s steps({charCount}) infinite, {uniqueId}_blink 0.7s step-end infinite; }}";
                break;
            case "fade":
                var fadeCount = messages.Count;
                var pctPer = fadeCount > 0 ? 100.0 / fadeCount : 100;
                var fadeKf = "";
                for (int i = 0; i < fadeCount; i++)
                {
                    var p1 = F(i * pctPer);
                    var p2 = F(i * pctPer + pctPer * 0.4);
                    var p3 = F(i * pctPer + pctPer * 0.5);
                    var p4 = F((i + 1) * pctPer);
                    fadeKf += $"{p1}%,{p2}% {{ opacity:1; }} {p3}%,{p4}% {{ opacity:0; }} ";
                }
                css = $@"
@keyframes {uniqueId}_fade {{ {fadeKf} }}
.{uniqueId}_container {{ animation: {uniqueId}_fade {F(speed * fadeCount)}s infinite; color: {color1}; text-align:center; }}";
                break;
        }
        builder.AddContent(seq++, (Microsoft.AspNetCore.Components.MarkupString)css);
        builder.CloseElement(); // style

        if (mode == "scroll")
        {
            // Scrolling marquee of messages
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", $"{uniqueId}_container");
            var combined = string.Join("    \u2022    ", messages);
            builder.AddContent(seq++, combined);
            builder.CloseElement();
        }
        else if (mode == "fade")
        {
            // Show first message, cycling handled by CSS with JS counter (simplified: show current via timer index)
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", $"{uniqueId}_container");
            var fadeIdx = (int)((DateTime.UtcNow.TimeOfDay.TotalSeconds / speed) % messages.Count);
            builder.AddContent(seq++, messages[fadeIdx]);
            builder.CloseElement();
        }
        else
        {
            // flash, pulse, typewriter â€” show current message
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", $"{uniqueId}_container");
            if (messages.Count > 1)
            {
                var msgIdx = (int)((DateTime.UtcNow.TimeOfDay.TotalSeconds / speed) % messages.Count);
                builder.AddContent(seq++, messages[msgIdx]);
            }
            else
            {
                builder.AddContent(seq++, messages[0]);
            }
            builder.CloseElement();
        }

        builder.CloseElement(); // div container
        builder.CloseElement(); // foreignObject
    };

