            builder.AddAttribute(seq++, "rx", 4); builder.AddAttribute(seq++, "fill", sym.FlowMeterBodyColor);
            builder.AddAttribute(seq++, "stroke", "#475569"); builder.AddAttribute(seq++, "stroke-width", 1);
            builder.CloseElement();

            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(cx)); builder.AddAttribute(seq++, "y", F(cy - 4));
            builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
            builder.AddAttribute(seq++, "fill", sym.FlowMeterFlowColor); builder.AddAttribute(seq++, "font-size", 16);
            builder.AddAttribute(seq++, "font-weight", "700");
            builder.AddContent(seq++, F(flow));
            builder.CloseElement();

            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(cx)); builder.AddAttribute(seq++, "y", F(cy + 12));
            builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "fill", "#94a3b8");
            builder.AddAttribute(seq++, "font-size", 9);
            builder.AddContent(seq++, sym.FlowMeterUnit);
            builder.CloseElement();
        }
        else
        {
            // Circular style: gauge circle with pointer
            builder.OpenElement(seq++, "circle");
            builder.AddAttribute(seq++, "cx", F(cx)); builder.AddAttribute(seq++, "cy", F(cy));
            builder.AddAttribute(seq++, "r", F(r)); builder.AddAttribute(seq++, "fill", sym.FlowMeterBodyColor);
            builder.AddAttribute(seq++, "stroke", "#475569"); builder.AddAttribute(seq++, "stroke-width", 1.5);
            builder.CloseElement();

            // Flow value
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(cx)); builder.AddAttribute(seq++, "y", F(cy - 2));
            builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
            builder.AddAttribute(seq++, "fill", sym.FlowMeterFlowColor); builder.AddAttribute(seq++, "font-size", 14);
            builder.AddAttribute(seq++, "font-weight", "700");
            builder.AddContent(seq++, F(flow));
            builder.CloseElement();

            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(cx)); builder.AddAttribute(seq++, "y", F(cy + 12));
            builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "fill", "#94a3b8");
            builder.AddAttribute(seq++, "font-size", 8);
            builder.AddContent(seq++, sym.FlowMeterUnit);
            builder.CloseElement();
        }

        // Totalizer
        if (sym.FlowMeterShowTotalizer && !string.IsNullOrEmpty(sym.FlowMeterTotalizerPath))
        {
            var totVal = Opc.GetValue(sym.FlowMeterTotalizerPath) ?? "0";
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(cx)); builder.AddAttribute(seq++, "y", F(h - 3));
            builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "fill", "#64748b");
            builder.AddAttribute(seq++, "font-size", 8);
            builder.AddContent(seq++, $"Î£ {totVal} {sym.FlowMeterTotalizerUnit}");
            builder.CloseElement();
        }
    };

    // â”€â”€ XY Plot (SVG) â”€â”€
    private RenderFragment RenderXYPlot(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width; var h = sym.Height;

        // Background
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w); builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", 4); builder.AddAttribute(seq++, "fill", sym.XYPlotBackground);
        builder.AddAttribute(seq++, "stroke", "#334155"); builder.AddAttribute(seq++, "stroke-width", 1);
        builder.CloseElement();

        var pad = 30.0;

        // Grid
        if (sym.XYPlotShowGrid)
        {
            for (int i = 1; i < 5; i++)
            {
                var gx = pad + i * (w - 2 * pad) / 5.0;
                builder.OpenElement(seq++, "line");
                builder.AddAttribute(seq++, "x1", F(gx)); builder.AddAttribute(seq++, "y1", F(pad));
                builder.AddAttribute(seq++, "x2", F(gx)); builder.AddAttribute(seq++, "y2", F(h - pad));
                builder.AddAttribute(seq++, "stroke", "#1e293b"); builder.AddAttribute(seq++, "stroke-width", 0.5);
                builder.CloseElement();
                var gy = pad + i * (h - 2 * pad) / 5.0;
                builder.OpenElement(seq++, "line");
                builder.AddAttribute(seq++, "x1", F(pad)); builder.AddAttribute(seq++, "y1", F(gy));
                builder.AddAttribute(seq++, "x2", F(w - pad)); builder.AddAttribute(seq++, "y2", F(gy));
                builder.AddAttribute(seq++, "stroke", "#1e293b"); builder.AddAttribute(seq++, "stroke-width", 0.5);
                builder.CloseElement();
            }
        }

        // Axes
        if (sym.XYPlotShowAxes)
        {
            builder.OpenElement(seq++, "line");
            builder.AddAttribute(seq++, "x1", F(pad)); builder.AddAttribute(seq++, "y1", F(pad));
            builder.AddAttribute(seq++, "x2", F(pad)); builder.AddAttribute(seq++, "y2", F(h - pad));
            builder.AddAttribute(seq++, "stroke", "#475569"); builder.AddAttribute(seq++, "stroke-width", 1);
            builder.CloseElement();
            builder.OpenElement(seq++, "line");
            builder.AddAttribute(seq++, "x1", F(pad)); builder.AddAttribute(seq++, "y1", F(h - pad));
            builder.AddAttribute(seq++, "x2", F(w - pad)); builder.AddAttribute(seq++, "y2", F(h - pad));
            builder.AddAttribute(seq++, "stroke", "#475569"); builder.AddAttribute(seq++, "stroke-width", 1);
            builder.CloseElement();

            // Axis labels
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(w / 2.0)); builder.AddAttribute(seq++, "y", F(h - 6));
            builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "fill", "#64748b");
            builder.AddAttribute(seq++, "font-size", 9);
            builder.AddContent(seq++, sym.XYPlotXLabel);
            builder.CloseElement();

            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(10)); builder.AddAttribute(seq++, "y", F(h / 2.0));
            builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "fill", "#64748b");
            builder.AddAttribute(seq++, "font-size", 9);
            builder.AddAttribute(seq++, "transform", $"rotate(-90,{F(10)},{F(h / 2.0)})");
            builder.AddContent(seq++, sym.XYPlotYLabel);
            builder.CloseElement();
        }

        // Current point marker
        double.TryParse(liveValue, NumberStyles.Float, CultureInfo.InvariantCulture, out var xVal);
        var yStr = !string.IsNullOrEmpty(sym.XYPlotYPath) ? Opc.GetValue(sym.XYPlotYPath) : null;
        double.TryParse(yStr, NumberStyles.Float, CultureInfo.InvariantCulture, out var yVal);

        // Simple cross at current point (normalized 0-100 by default)
        var px = pad + (w - 2 * pad) * Math.Clamp(xVal / 100.0, 0, 1);
        var py = (h - pad) - (h - 2 * pad) * Math.Clamp(yVal / 100.0, 0, 1);
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", F(px)); builder.AddAttribute(seq++, "cy", F(py));
        builder.AddAttribute(seq++, "r", 4); builder.AddAttribute(seq++, "fill", sym.XYPlotColor);
        builder.CloseElement();

        // Title
        builder.OpenElement(seq++, "text");
        builder.AddAttribute(seq++, "x", F(w / 2.0)); builder.AddAttribute(seq++, "y", F(14));
        builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "fill", "#94a3b8");
        builder.AddAttribute(seq++, "font-size", 10);
        builder.AddContent(seq++, !string.IsNullOrEmpty(sym.Label) ? sym.Label : "XY Plot");
        builder.CloseElement();
    };

