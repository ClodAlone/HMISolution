@using SharedModels
@using RuntimeViewer.Shared.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable

@if (Screen == null)
{
    <div class="rv-empty">No screen to display.</div>
}
else if (Screen.LayoutMode == "responsive")
{
    @* ─── Responsive HTML Grid Layout ─────────────────────── *@
    var bgDataResp = ResolveImageData(Screen.BackgroundImageId);
    <div class="rv-responsive-grid @(IsKiosk ? "rv-responsive-kiosk" : "")"
         style="background: @Screen.Background;@(string.IsNullOrEmpty(bgDataResp) ? "" : $" background-image: url('{bgDataResp}'); background-size: cover; background-position: center;") gap: @(Screen.GridGap)px; grid-template-columns: repeat(@Screen.GridColumns, 1fr);">
        @foreach (var sym in Screen.Symbols.OrderBy(s => s.Order))
        {
            var liveValue = Opc.GetValue(sym.VariablePath ?? "");
            var fillColor = EvalFillBinding(sym, liveValue);
            var visible = EvalVisibilityBinding(sym, liveValue);
            var labelText = EvalLabelBinding(sym, liveValue);
            var resolvedLabel = Localization.Resolve(labelText ?? sym.Label);

            if (!visible) continue;
            if (!string.IsNullOrEmpty(sym.RequiredAccess) && !Auth.HasReadAccess(sym.RequiredAccess))
                continue;

            var hasCmd = sym.Commands.Count > 0;
            var canExecute = hasCmd && Auth.HasWriteAccess(sym.RequiredAccess);
            var isLocked = hasCmd && !canExecute && !string.IsNullOrEmpty(sym.RequiredAccess);

            <div class="rv-responsive-widget @(hasCmd ? "rv-responsive-interactive" : "") @(isLocked ? "rv-responsive-locked" : "")"
                 style="grid-column: span @Math.Clamp(sym.ColSpan, 1, Screen.GridColumns); grid-row: span @Math.Max(1, sym.RowSpan); min-height: @(sym.RowHeight)px; order: @sym.Order;"
                 @onclick="() => OnSymbolClick(sym)"
                 @onmousedown="(e) => OnSymbolMouseDown(e, sym)"
                 @onmouseup="(e) => OnSymbolMouseUp(e, sym)">

                @switch (sym.Type)
                {
                    case "rect":
                        <svg viewBox="0 0 @sym.Width @sym.Height" class="rv-responsive-svg" preserveAspectRatio="xMidYMid meet">
                            <rect width="@sym.Width" height="@sym.Height" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="3" />
                        </svg>
                        break;
                    case "circle":
                        var cr = Math.Min(sym.Width, sym.Height) / 2;
                        <svg viewBox="0 0 @sym.Width @sym.Height" class="rv-responsive-svg" preserveAspectRatio="xMidYMid meet">
                            <circle cx="@F(sym.Width / 2)" cy="@F(sym.Height / 2)" r="@F(cr)" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                        </svg>
                        break;
                    case "ellipse":
                        <svg viewBox="0 0 @sym.Width @sym.Height" class="rv-responsive-svg" preserveAspectRatio="xMidYMid meet">
                            <ellipse cx="@F(sym.Width / 2)" cy="@F(sym.Height / 2)" rx="@F(sym.Width / 2)" ry="@F(sym.Height / 2)"
                                     fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                        </svg>
                        break;
                    case "text":
                        <div class="rv-responsive-text" style="color: @fillColor;">@resolvedLabel</div>
                        break;
                    case "gauge":
                        var gaugeValStr = liveValue;
                        var gaugeNum = ParseDouble(gaugeValStr);
                        var gMin = sym.MinValue ?? 0;
                        var gMax = sym.MaxValue ?? 100;
                        var gPct = gMax > gMin ? (gaugeNum - gMin) / (gMax - gMin) * 100 : 0;
                        <div class="rv-responsive-gauge">
                            <div class="rv-responsive-gauge-bar" style="width: @F(gPct)%; background: @fillColor;"></div>
                            <span class="rv-responsive-gauge-label">@F(gaugeNum) / @gMax</span>
                        </div>
                        break;
                    case "indicator":
                        <div class="rv-responsive-indicator" style="background: @fillColor; transition: background 0.4s ease;">@resolvedLabel</div>
                        break;
                    case "svg":
                        @if (!string.IsNullOrEmpty(sym.SvgContent))
                        {
                            <div class="rv-responsive-svg-wrap">@((MarkupString)StripSvgWrapper(sym.SvgContent))</div>
                        }
                        break;
                    case "alarmlist":
                        <AlarmListWidget />
                        break;
                    case "hdachart":
                        <HdaChartWidget VariablePaths="@sym.HdaVariablePaths"
                                        TimeRangeMinutes="@sym.HdaTimeRangeMinutes"
                                        MaxPoints="@sym.HdaMaxPoints" />
                        break;
                    case "hdagrid":
                        <HdaGridWidget VariablePaths="@sym.HdaVariablePaths"
                                       TimeRangeMinutes="@sym.HdaTimeRangeMinutes"
                                       MaxPoints="@sym.HdaMaxPoints" />
                        break;
                    case "eventlog":
                        <EventLogWidget MaxRows="@sym.EventLogMaxRows"
                                        TimeRangeMinutes="@sym.EventLogTimeRangeMinutes"
                                        Categories="@sym.EventLogCategories" />
                        break;
                    case "editbox":
                        <EditBoxWidget VariablePath="@sym.VariablePath"
                                       Step="@sym.EditBoxStep"
                                       Format="@sym.EditBoxFormat"
                                       Min="@sym.MinValue"
                                       Max="@sym.MaxValue"
                                       ShowStatistics="@sym.EditBoxShowStatistics" />
                        break;
                    case "ipcamera":
                        <IpCameraWidget CameraId="@(sym.Camera?.CameraId ?? "")"
                                        ServerBaseUrl=""
                                        ShowOverlay="@(sym.Camera?.EnableYolo == true)"
                                        DetectionVariablePrefix="@(sym.Camera?.DetectionVariablePrefix ?? "")" />
                        break;
                    case "recipe":
                        var recipeVarsR = GetRecipeVariables(sym.RecipeName);
                        <RecipeWidget RecipeName="@sym.RecipeName" Variables="@recipeVarsR" />
                        break;
                    case "weeklyplanner":
                        var wpSlotsR = GetSchedulerSlots(sym.SchedulerName);
                        var wpAllowEditR = GetSchedulerAllowEdit(sym.SchedulerName);
                        var wpSlotMinR = GetSchedulerSlotMinutes(sym.SchedulerName);
                        <WeeklyPlannerWidget SchedulerName="@sym.SchedulerName"
                                             Slots="@wpSlotsR"
                                             AllowEdit="@wpAllowEditR"
                                             SlotMinutes="@wpSlotMinR" />
                        break;
                    case "screenembed":
                        <ScreenEmbedWidget ScreenNames="@sym.EmbeddedScreens" />
                        break;
                    case "imagemap":
                        var imgMapSrcR = ResolveImageMap(sym, liveValue);
                        @if (!string.IsNullOrEmpty(imgMapSrcR))
                        {
                            <img src="@imgMapSrcR" style="width: 100%; height: 100%; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="rv-responsive-indicator" style="background: @fillColor; transition: background 0.4s ease;">@resolvedLabel</div>
                        }
                        break;
                    case "trend":
                        <RealtimeTrendWidget Pens="@sym.TrendPens"
                                             TimeWindowSeconds="@sym.TrendTimeWindowSeconds"
                                             ShowGrid="@sym.TrendShowGrid"
                                             ShowCursor="@sym.TrendShowCursor"
                                             ShowLegend="@sym.TrendShowLegend"
                                             YMin="@sym.TrendYMin"
                                             YMax="@sym.TrendYMax"
                                             Background="@sym.TrendBackground" />
                        break;
                    case "switch":
                        var swIsOn = liveValue is "True" or "true" or "1";
                        var swOnCol = sym.SwitchOnColor ?? "#34c759";
                        var swOffCol = sym.SwitchOffColor ?? "#787880";
                        <div style="display: inline-flex; align-items: center; cursor: pointer;">
                            <svg width="51" height="31" viewBox="0 0 51 31" xmlns="http://www.w3.org/2000/svg">
                                <rect width="51" height="31" rx="15.5" fill="@(swIsOn ? swOnCol : swOffCol)"
                                      style="transition: fill 0.3s ease;" />
                                <circle cx="@(swIsOn ? 35.5 : 15.5)" cy="15.5" r="13.5" fill="white"
                                        style="transition: cx 0.3s ease; filter: drop-shadow(0 1px 3px rgba(0,0,0,0.3));" />
                            </svg>
                        </div>
                        break;
                    case "rotaryswitch":
                        var rvPos = (int)ParseDouble(liveValue);
                        var rvN = Math.Max(2, Math.Min(12, sym.SwitchPositions));
                        rvPos = Math.Max(0, Math.Min(rvN - 1, rvPos));
                        var rvLabels2 = (sym.SwitchPositionLabels ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                        var rvLbl = rvPos < rvLabels2.Length ? rvLabels2[rvPos].Trim() : rvPos.ToString();
                        var rvAngle = -150.0 + (300.0 / (rvN - 1)) * rvPos;
                        var rvRad = rvAngle * Math.PI / 180.0;
                        var rvKx = 40 + 14.7 * Math.Sin(rvRad);
                        var rvKy = 40 - 14.7 * Math.Cos(rvRad);
                        <div style="display: inline-flex; flex-direction: column; align-items: center; cursor: pointer;">
                            <svg width="80" height="80" viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="40" cy="40" r="38" fill="@(sym.SwitchDialColor ?? "#2d2d2d")" stroke="#555" stroke-width="1" />
                                @for (int rpi = 0; rpi < rvN; rpi++)
                                {
                                    var ra = -150.0 + (300.0 / (rvN - 1)) * rpi;
                                    var rr = ra * Math.PI / 180.0;
                                    var rtx1 = 40 + 36 * Math.Sin(rr);
                                    var rty1 = 40 - 36 * Math.Cos(rr);
                                    var rtx2 = 40 + 31 * Math.Sin(rr);
                                    var rty2 = 40 - 31 * Math.Cos(rr);
                                    <line x1="@F(rtx1)" y1="@F(rty1)" x2="@F(rtx2)" y2="@F(rty2)"
                                          stroke="#aaa" stroke-width="1.5" stroke-linecap="round" />
                                }
                                <circle cx="40" cy="40" r="21" fill="@(sym.SwitchKnobColor ?? "#e0e0e0")" stroke="#999" stroke-width="0.5"
                                        style="filter: drop-shadow(0 1px 2px rgba(0,0,0,0.4));" />
                                <line x1="40" y1="40" x2="@F(rvKx)" y2="@F(rvKy)"
                                      stroke="#333" stroke-width="2.5" stroke-linecap="round"
                                      style="transition: x2 0.3s ease, y2 0.3s ease;" />
                            </svg>
                            <span style="font-size: 11px; color: #ccc;">@rvLbl</span>
                        </div>
                        break;
                    case "knob":
                        var rkVal = ParseDouble(liveValue);
                        var rkMin = sym.MinValue ?? 0;
                        var rkMax = sym.MaxValue ?? 100;
                        var rkFrac = (rkMax > rkMin) ? Math.Clamp((rkVal - rkMin) / (rkMax - rkMin), 0, 1) : 0;
                        var rkAngle3 = -150.0 + 300.0 * rkFrac;
                        var rkRad3 = rkAngle3 * Math.PI / 180.0;
                        var rkPx = 40 + 14 * Math.Sin(rkRad3);
                        var rkPy = 40 - 14 * Math.Cos(rkRad3);
                        <div style="display: inline-flex; flex-direction: column; align-items: center; cursor: pointer;">
                            <svg width="80" height="90" viewBox="0 0 80 90" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="40" cy="40" r="38" fill="#1a1a1a" stroke="#555" stroke-width="1" />
                                <circle cx="40" cy="40" r="24" fill="@(sym.KnobColor ?? "#3a3a3a")" stroke="#666" stroke-width="0.5"
                                        style="filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));" />
                                <line x1="40" y1="40" x2="@F(rkPx)" y2="@F(rkPy)"
                                      stroke="@(sym.KnobPointerColor ?? "#ff6b35")" stroke-width="2.5" stroke-linecap="round"
                                      style="transition: x2 0.3s ease, y2 0.3s ease;" />
                                <circle cx="40" cy="40" r="3" fill="@(sym.KnobPointerColor ?? "#ff6b35")" />
                            </svg>
                            @if (sym.KnobShowValue)
                            {
                                <span style="font-size: 11px; color: #ccc;">@(rkVal.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))@(sym.KnobUnit)</span>
                            }
                        </div>
                        break;
                    case "hslider":
                        var hsVal2 = ParseDouble(liveValue);
                        var hsMin2 = sym.MinValue ?? 0;
                        var hsMax2 = sym.MaxValue ?? 100;
                        var hsFrac2 = (hsMax2 > hsMin2) ? Math.Clamp((hsVal2 - hsMin2) / (hsMax2 - hsMin2), 0, 1) : 0;
                        <div style="display: inline-flex; flex-direction: column; align-items: center; cursor: pointer; padding: 4px;">
                            <svg width="160" height="36" viewBox="0 0 160 36" xmlns="http://www.w3.org/2000/svg">
                                <rect x="8" y="14" width="144" height="8" rx="4" fill="@(sym.SliderTrackColor ?? "#444")" />
                                <rect x="8" y="14" width="@F(144 * hsFrac2)" height="8" rx="4" fill="@(sym.SliderFillColor ?? "#3b82f6")" />
                                <circle cx="@F(8 + 144 * hsFrac2)" cy="18" r="9" fill="@(sym.SliderThumbColor ?? "#ffffff")" stroke="#ccc" stroke-width="0.5"
                                        style="filter: drop-shadow(0 1px 3px rgba(0,0,0,0.4)); transition: cx 0.2s ease;" />
                            </svg>
                            @if (sym.SliderShowValue)
                            {
                                <span style="font-size: 10px; color: #ccc;">@(hsVal2.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))</span>
                            }
                        </div>
                        break;
                    case "vslider":
                        var vsVal2 = ParseDouble(liveValue);
                        var vsMin2 = sym.MinValue ?? 0;
                        var vsMax2 = sym.MaxValue ?? 100;
                        var vsFrac2 = (vsMax2 > vsMin2) ? Math.Clamp((vsVal2 - vsMin2) / (vsMax2 - vsMin2), 0, 1) : 0;
                        <div style="display: inline-flex; flex-direction: column; align-items: center; cursor: pointer; padding: 4px;">
                            <svg width="36" height="160" viewBox="0 0 36 160" xmlns="http://www.w3.org/2000/svg">
                                <rect x="14" y="8" width="8" height="144" rx="4" fill="@(sym.SliderTrackColor ?? "#444")" />
                                <rect x="14" y="@F(8 + 144 * (1 - vsFrac2))" width="8" height="@F(144 * vsFrac2)" rx="4" fill="@(sym.SliderFillColor ?? "#3b82f6")" />
                                <circle cx="18" cy="@F(8 + 144 * (1 - vsFrac2))" r="9" fill="@(sym.SliderThumbColor ?? "#ffffff")" stroke="#ccc" stroke-width="0.5"
                                        style="filter: drop-shadow(0 1px 3px rgba(0,0,0,0.4)); transition: cy 0.2s ease;" />
                            </svg>
                            @if (sym.SliderShowValue)
                            {
                                <span style="font-size: 10px; color: #ccc;">@(vsVal2.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))</span>
                            }
                        </div>
                        break;
                    case "button":
                        @RenderResponsiveButton(sym, resolvedLabel)
                        break;
                    case "animtext":
                        @RenderResponsiveAnimText(sym, resolvedLabel)
                        break;
                }

                @if (isLocked)
                {
                    <span class="rv-responsive-lock">🔒</span>
                }
            </div>
        }
    </div>
}
else
{
    var bgDataSvg = ResolveImageData(Screen.BackgroundImageId);
    <svg xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 @Screen.Width @Screen.Height"
         width="@(IsKiosk || BestFit ? null : Screen.Width)"
         height="@(IsKiosk || BestFit ? null : Screen.Height)"
         preserveAspectRatio="xMidYMid meet"
         class="rv-canvas @(IsKiosk ? "rv-canvas-kiosk" : "") @(BestFit && !IsKiosk ? "rv-canvas-bestfit" : "")"
         style="background: @Screen.Background;"
         @ref="_svgRef">

        @{ var kfCss = BuildAllKeyframesCss(); }
        @if (!string.IsNullOrEmpty(kfCss))
        {
            <defs>
                <style>@((MarkupString)kfCss)</style>
            </defs>
        }

        @if (!string.IsNullOrEmpty(bgDataSvg))
        {
            <image href="@bgDataSvg" x="0" y="0"
                   width="@Screen.Width" height="@Screen.Height"
                   preserveAspectRatio="xMidYMid slice" />
        }

        @foreach (var sym in Screen.Symbols)
        {
            var liveValue = Opc.GetValue(sym.VariablePath ?? "");
            var fillColor = EvalFillBinding(sym, liveValue);
            var visible = EvalVisibilityBinding(sym, liveValue);
            var rotation = EvalRotationBinding(sym, liveValue);
            var labelText = EvalLabelBinding(sym, liveValue);

            // Resolve localized strings: labels starting with @ are string IDs
            var resolvedLabel = Localization.Resolve(labelText ?? sym.Label);

            if (!visible) continue;

            // Access-level visibility: if symbol requires access and user lacks read → hide
            if (!string.IsNullOrEmpty(sym.RequiredAccess) && !Auth.HasReadAccess(sym.RequiredAccess))
                continue;

            var hasCmd = sym.Commands.Count > 0;
            var canExecute = hasCmd && Auth.HasWriteAccess(sym.RequiredAccess);
            
            var isPressed = _pressedSymbolId == sym.Id;
            var isLocked = hasCmd && !canExecute && !string.IsNullOrEmpty(sym.RequiredAccess);

            <LiveSymbol @key="sym.Id" Value="@liveValue"><g transform="translate(@sym.X, @sym.Y) rotate(@F(rotation), @F(sym.Width / 2), @F(sym.Height / 2))"
               class="@(hasCmd ? "rv-interactive" : "") @(isPressed ? "rv-pressed" : "") @(isLocked ? "rv-locked" : "")"
               style="@(hasCmd ? "cursor: pointer;" : "") @BuildPositionAnimStyle(sym)"
               @onmousedown="(e) => OnSymbolMouseDown(e, sym)" @onmousedown:stopPropagation
               @onmouseup="(e) => OnSymbolMouseUp(e, sym)" @onmouseup:stopPropagation
               @onclick="() => OnSymbolClick(sym)" @onclick:stopPropagation>

                @* Invisible hit area *@
                <rect width="@sym.Width" height="@sym.Height" fill="transparent" stroke="none" />

                <g style="@BuildLocalAnimStyle(sym)">

                @switch (sym.Type)
                {
                    case "rect":
                        <rect width="@sym.Width" height="@sym.Height"
                              fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="3" />
                        break;
                    case "circle":
                        var r = Math.Min(sym.Width, sym.Height) / 2;
                        <circle cx="@F(sym.Width / 2)" cy="@F(sym.Height / 2)" r="@F(r)"
                                fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                        break;
                    case "ellipse":
                        <ellipse cx="@F(sym.Width / 2)" cy="@F(sym.Height / 2)"
                                 rx="@F(sym.Width / 2)" ry="@F(sym.Height / 2)"
                                 fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                        break;
                    case "text":
                        @RenderSvgText(sym.Width / 2, sym.Height / 2 + 5, "middle", "middle", fillColor, 14, resolvedLabel, sym)
                        break;
                    case "line":
                        <line x1="0" y1="@sym.Height" x2="@sym.Width" y2="0"
                              stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                        break;
                    case "gauge":
                        @RenderGauge(sym, fillColor, liveValue)
                        break;
                    case "indicator":
                        <circle cx="@F(sym.Width / 2)" cy="@F(sym.Height / 2)"
                                r="@F(Math.Min(sym.Width, sym.Height) / 2 - 2)"
                                fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth"
                                style="transition: fill 0.4s ease;" />
                        @RenderSvgText(sym.Width / 2, sym.Height / 2 + 4, "middle", "middle", "white", 10, resolvedLabel, sym)
                        break;
                    case "svg":
                        @if (!string.IsNullOrEmpty(sym.SvgContent))
                        {
                            @RenderLibrarySvg(sym)
                        }
                        break;
                    case "alarmlist":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <AlarmListWidget />
                            </div>
                        </foreignObject>
                        break;
                    case "hdachart":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <HdaChartWidget VariablePaths="@sym.HdaVariablePaths"
                                                TimeRangeMinutes="@sym.HdaTimeRangeMinutes"
                                                MaxPoints="@sym.HdaMaxPoints" />
                            </div>
                        </foreignObject>
                        break;
                    case "hdagrid":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <HdaGridWidget VariablePaths="@sym.HdaVariablePaths"
                                               TimeRangeMinutes="@sym.HdaTimeRangeMinutes"
                                               MaxPoints="@sym.HdaMaxPoints" />
                            </div>
                        </foreignObject>
                        break;
                    case "eventlog":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <EventLogWidget MaxRows="@sym.EventLogMaxRows"
                                                TimeRangeMinutes="@sym.EventLogTimeRangeMinutes"
                                                Categories="@sym.EventLogCategories" />
                            </div>
                        </foreignObject>
                        break;
                    case "editbox":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <EditBoxWidget VariablePath="@sym.VariablePath"
                                               Step="@sym.EditBoxStep"
                                               Format="@sym.EditBoxFormat"
                                               Min="@sym.MinValue"
                                               Max="@sym.MaxValue"
                                       ShowStatistics="@sym.EditBoxShowStatistics" />
                            </div>
                        </foreignObject>
                        break;
                    case "ipcamera":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <IpCameraWidget CameraId="@(sym.Camera?.CameraId ?? "")"
                                                ServerBaseUrl="@(sym.Camera != null ? "" : "")"
                                                ShowOverlay="@(sym.Camera?.EnableYolo == true)"
                                                DetectionVariablePrefix="@(sym.Camera?.DetectionVariablePrefix ?? "")" />
                            </div>
                        </foreignObject>
                        break;
                    case "recipe":
                        var recipeVars = GetRecipeVariables(sym.RecipeName);
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <RecipeWidget RecipeName="@sym.RecipeName"
                                              Variables="@recipeVars" />
                            </div>
                        </foreignObject>
                        break;
                    case "weeklyplanner":
                        var wpSlots = GetSchedulerSlots(sym.SchedulerName);
                        var wpAllowEdit = GetSchedulerAllowEdit(sym.SchedulerName);
                        var wpSlotMin = GetSchedulerSlotMinutes(sym.SchedulerName);
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <WeeklyPlannerWidget SchedulerName="@sym.SchedulerName"
                                                     Slots="@wpSlots"
                                                     AllowEdit="@wpAllowEdit"
                                                     SlotMinutes="@wpSlotMin" />
                            </div>
                        </foreignObject>
                        break;
                    case "screenembed":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px; overflow: hidden;">
                                <ScreenEmbedWidget ScreenNames="@sym.EmbeddedScreens" />
                            </div>
                        </foreignObject>
                        break;
                    case "imagemap":
                        var imgMapSrc = ResolveImageMap(sym, liveValue);
                        @if (!string.IsNullOrEmpty(imgMapSrc))
                        {
                            <image href="@imgMapSrc" x="0" y="0"
                                   width="@sym.Width" height="@sym.Height"
                                   preserveAspectRatio="xMidYMid meet" />
                        }
                        else
                        {
                            <rect width="@sym.Width" height="@sym.Height" fill="#1e293b" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                            @RenderSvgText(sym.Width / 2, sym.Height / 2, "middle", "middle", "#64748b", 10, "No image")
                        }
                        break;
                    case "trend":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <RealtimeTrendWidget Pens="@sym.TrendPens"
                                                     TimeWindowSeconds="@sym.TrendTimeWindowSeconds"
                                                     ShowGrid="@sym.TrendShowGrid"
                                                     ShowCursor="@sym.TrendShowCursor"
                                                     ShowLegend="@sym.TrendShowLegend"
                                                     YMin="@sym.TrendYMin"
                                                     YMax="@sym.TrendYMax"
                                                     Background="@sym.TrendBackground" />
                            </div>
                        </foreignObject>
                        break;
                    case "switch":
                        @RenderToggleSwitch(sym, liveValue)
                        break;
                    case "rotaryswitch":
                        @RenderRotarySwitch(sym, liveValue)
                        break;
                    case "knob":
                        @RenderKnob(sym, liveValue)
                        break;
                    case "hslider":
                        @RenderHSlider(sym, liveValue)
                        break;
                    case "vslider":
                        @RenderVSlider(sym, liveValue)
                        break;
                    case "button":
                        @RenderButton(sym, resolvedLabel)
                        break;
                    case "animtext":
                        @RenderAnimText(sym, resolvedLabel)
                        break;
                }

                @if (!string.IsNullOrEmpty(resolvedLabel) && sym.Type is not "text" and not "button" and not "animtext")
                {
                    @RenderSvgText(sym.Width / 2, sym.Height + 14, "middle", null, "#333", 11, resolvedLabel, sym)
                }

                @* Hover highlight outline — shown via CSS :hover *@
                @if (hasCmd)
                {
                    <rect class="rv-hover-outline" x="-2" y="-2" width="@(sym.Width + 4)" height="@(sym.Height + 4)"
                          fill="none" stroke="@(isLocked ? "#dc3545" : "#0d6efd")" stroke-width="2" stroke-dasharray="4,2" rx="4"
                          style="pointer-events: none;" />
                }

                @* Lock icon for symbols requiring write access the user doesn't have *@
                @if (isLocked)
                {
                    @RenderSvgText(sym.Width - 2, 12, "end", null, "#dc3545", 12, "🔒")
                }
                </g>
            </g></LiveSymbol>
        }
    </svg>
}

@code {
    [Parameter] public ScreenConfig? Screen { get; set; }
    [Parameter] public bool IsKiosk { get; set; }
    [Parameter] public bool BestFit { get; set; }
    [Parameter] public EventCallback OnRequestLogin { get; set; }
    [Inject] private OpcRuntimeClient Opc { get; set; } = default!;
    [Inject] private CommandService Commands { get; set; } = default!;
    [Inject] private RuntimeAuthService Auth { get; set; } = default!;
    [Inject] private LocalizationService Localization { get; set; } = default!;
    [Inject] private ProjectService Project { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private ElementReference _svgRef;
    private IJSObjectReference? _jsModule;
    private System.Threading.Timer? _refreshTimer;
    private string? _pressedSymbolId;

    private string? ResolveImageData(string? imageId)
    {
        if (string.IsNullOrEmpty(imageId)) return null;
        return Project.Model?.Images?.FirstOrDefault(i => i.Id == imageId)?.Data;
    }
    private readonly Dictionary<string, double> _gaugeDisplayPct = new();
    private const double _gaugeLerpSpeed = 0.18;
    private ScreenSymbol? _dragSliderSymbol;
    private bool _isDraggingSlider;
    private ScreenSymbol? _dragKnobSymbol;
    private bool _isDraggingKnob;
    private double _knobDragStartAngle;
    private double _knobDragStartValue;
    private bool _suppressNextClick;
    private DateTime _lastDragWrite = DateTime.MinValue;
    private const int DragWriteIntervalMs = 60;
    private string? _pendingDragPath;
    private string? _pendingDragValue;
    private DotNetObjectReference<ScreenRenderer>? _dotnetRef;
    private bool _jsDragActive;
    private volatile bool _valuesDirty;

    protected override void OnInitialized()
    {
        Opc.ValuesChanged += OnValuesChanged;
        Localization.LanguageChanged += OnLanguageChanged;
        _refreshTimer = new System.Threading.Timer(_ =>
        {
            if (_valuesDirty)
            {
                _valuesDirty = false;
                InvokeAsync(StateHasChanged);
            }
        }, null, 500, 500);
    }

    protected override void OnParametersSet()
    {
        if (Screen != null && Opc.IsConnected)
        {
            var paths = Screen.Symbols
                .Where(s => !string.IsNullOrEmpty(s.VariablePath))
                .Select(s => s.VariablePath!)
                .Distinct()
                .ToList();

            // Also monitor variables referenced by commands
            foreach (var sym in Screen.Symbols)
            {
                foreach (var cmd in sym.Commands)
                {
                    if (!string.IsNullOrEmpty(cmd.VariablePath))
                        paths.Add(cmd.VariablePath);
                }

                // Monitor recipe OPC command/status variables and recipe variable paths
                if (sym.Type == "recipe" && !string.IsNullOrEmpty(sym.RecipeName))
                {
                    var prefix = $"Recipe.{sym.RecipeName}";
                    paths.Add($"{prefix}.ActiveName");
                    paths.Add($"{prefix}.RecipeList");
                    paths.Add($"{prefix}.LastStatus");
                    paths.Add($"{prefix}.Load");
                    paths.Add($"{prefix}.Save");
                    paths.Add($"{prefix}.Activate");
                    paths.Add($"{prefix}.Delete");

                    foreach (var rv in GetRecipeVariables(sym.RecipeName))
                        paths.Add(rv.VariablePath);
                }

                // Monitor statistics sub-variables for editboxes with ShowStatistics
                if (sym.Type == "editbox" && sym.EditBoxShowStatistics && !string.IsNullOrEmpty(sym.VariablePath))
                {
                    paths.Add(sym.VariablePath + ".Statistics.Min");
                    paths.Add(sym.VariablePath + ".Statistics.Max");
                    paths.Add(sym.VariablePath + ".Statistics.Average");
                    paths.Add(sym.VariablePath + ".Statistics.Count");
                }

                // Monitor realtime trend pen variables
                if (sym.Type == "trend")
                {
                    foreach (var pen in sym.TrendPens)
                    {
                        if (!string.IsNullOrEmpty(pen.VariablePath))
                            paths.Add(pen.VariablePath);
                    }
                }
            }

            var distinctPaths = paths.Distinct().ToList();
            Opc.MonitorVariables(distinctPaths);
