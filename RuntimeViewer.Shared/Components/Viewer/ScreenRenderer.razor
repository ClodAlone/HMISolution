            builder.AddAttribute(seq++, "fill", color); builder.AddAttribute(seq++, "stroke", "#334155"); builder.AddAttribute(seq++, "stroke-width", 1);
            builder.CloseElement();
            // Stem
            builder.OpenElement(seq++, "line");
            builder.AddAttribute(seq++, "x1", F(w/2)); builder.AddAttribute(seq++, "y1", "0");
            builder.AddAttribute(seq++, "x2", F(w/2)); builder.AddAttribute(seq++, "y2", F(-6));
            builder.AddAttribute(seq++, "stroke", "#334155"); builder.AddAttribute(seq++, "stroke-width", 3);
            builder.CloseElement();
            // Handle
            builder.OpenElement(seq++, "rect");
            builder.AddAttribute(seq++, "x", F(w/2-8)); builder.AddAttribute(seq++, "y", F(-10));
            builder.AddAttribute(seq++, "width", 16); builder.AddAttribute(seq++, "height", 4);
            builder.AddAttribute(seq++, "rx", 1); builder.AddAttribute(seq++, "fill", "#64748b");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(seq++, "polygon");
            builder.AddAttribute(seq++, "points", $"0,0 {F(w/2)},{F(h/2)} {w},0");
            builder.AddAttribute(seq++, "fill", color); builder.AddAttribute(seq++, "stroke", "#334155"); builder.AddAttribute(seq++, "stroke-width", 1);
            builder.CloseElement();
            builder.OpenElement(seq++, "polygon");
            builder.AddAttribute(seq++, "points", $"0,{h} {F(w/2)},{F(h/2)} {w},{h}");
            builder.AddAttribute(seq++, "fill", color); builder.AddAttribute(seq++, "stroke", "#334155"); builder.AddAttribute(seq++, "stroke-width", 1);
            builder.CloseElement();
            builder.OpenElement(seq++, "line");
            builder.AddAttribute(seq++, "x1", "0"); builder.AddAttribute(seq++, "y1", F(h/2));
            builder.AddAttribute(seq++, "x2", F(-6)); builder.AddAttribute(seq++, "y2", F(h/2));
            builder.AddAttribute(seq++, "stroke", "#334155"); builder.AddAttribute(seq++, "stroke-width", 3);
            builder.CloseElement();
            builder.OpenElement(seq++, "rect");
            builder.AddAttribute(seq++, "x", F(-10)); builder.AddAttribute(seq++, "y", F(h/2-8));
            builder.AddAttribute(seq++, "width", 4); builder.AddAttribute(seq++, "height", 16);
            builder.AddAttribute(seq++, "rx", 1); builder.AddAttribute(seq++, "fill", "#64748b");
            builder.CloseElement();
        }
    };

    // â”€â”€â”€ Sparkline rendering â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private RenderFragment RenderSparkline(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width;
        var h = sym.Height;
        var color = sym.SparklineColor ?? "#3b82f6";
        var sw = sym.SparklineStrokeWidth > 0 ? sym.SparklineStrokeWidth : 2;

        // Background
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w); builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", 3);
        builder.AddAttribute(seq++, "fill", "#111827"); builder.AddAttribute(seq++, "stroke", "#334155"); builder.AddAttribute(seq++, "stroke-width", 1);
        builder.CloseElement();

        // Get sparkline data from the data store (ring buffer)
        var key = sym.Id + "_spark";
        if (!_sparklineData.TryGetValue(key, out var data))
        {
            data = new SparklineBuffer(sym.SparklinePoints > 0 ? sym.SparklinePoints : 30);
            _sparklineData[key] = data;
        }
        double.TryParse(liveValue, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var val);
        data.Add(val);

        var points = data.GetPoints();
        if (points.Length >= 2)
        {
            var minY = sym.MinValue ?? points.Min();
            var maxY = sym.MaxValue is null or 0 ? points.Max() : sym.MaxValue.Value;
            if (Math.Abs(maxY - minY) < 0.001) { minY -= 1; maxY += 1; }

            var pad = 4.0;
            var plotW = w - pad * 2;
            var plotH = h - pad * 2;
            var sb = new System.Text.StringBuilder();
            for (var i = 0; i < points.Length; i++)
            {
                var px = pad + (plotW * i / (points.Length - 1));
                var py = pad + plotH - plotH * ((points[i] - minY) / (maxY - minY));
                py = Math.Clamp(py, pad, pad + plotH);
                if (i > 0) sb.Append(' ');
                sb.Append($"{F(px)},{F(py)}");
            }

            if (sym.SparklineFillArea)
            {
                builder.OpenElement(seq++, "polygon");
                var fillPoints = $"{F(pad)},{F(pad + plotH)} {sb} {F(pad + plotW)},{F(pad + plotH)}";
                builder.AddAttribute(seq++, "points", fillPoints);
                builder.AddAttribute(seq++, "fill", color);
                builder.AddAttribute(seq++, "opacity", "0.15");
                builder.CloseElement();
            }

            builder.OpenElement(seq++, "polyline");
            builder.AddAttribute(seq++, "points", sb.ToString());
            builder.AddAttribute(seq++, "fill", "none");
            builder.AddAttribute(seq++, "stroke", color);
            builder.AddAttribute(seq++, "stroke-width", F(sw));
            builder.CloseElement();
        }

        // Current value overlay
        if (sym.SparklineShowValue)
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(w - 4));
            builder.AddAttribute(seq++, "y", 12);
            builder.AddAttribute(seq++, "text-anchor", "end");
            builder.AddAttribute(seq++, "fill", color);
            builder.AddAttribute(seq++, "font-size", 10);
            builder.AddAttribute(seq++, "font-family", "system-ui, sans-serif");
            builder.AddContent(seq++, val.ToString("F1", System.Globalization.CultureInfo.InvariantCulture));
            builder.CloseElement();
        }
    };

    // â”€â”€â”€ Color Zone rendering â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private RenderFragment RenderColorZone(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width;
        var h = sym.Height;
        var r = sym.ColorZoneBorderRadius;
        double.TryParse(liveValue, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var val);

        var color = EvaluateColorZoneRules(sym.ColorZoneRules, val, sym.ColorZoneDefault ?? "#334155");

        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w); builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", r);
        builder.AddAttribute(seq++, "fill", color);
        builder.AddAttribute(seq++, "style", "transition: fill 0.3s ease;");
        builder.CloseElement();

        if (sym.ColorZoneShowValue)
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(w / 2.0));
            builder.AddAttribute(seq++, "y", F(h / 2.0));
            builder.AddAttribute(seq++, "text-anchor", "middle");
            builder.AddAttribute(seq++, "dominant-baseline", "middle");
            builder.AddAttribute(seq++, "fill", "#ffffff");
            builder.AddAttribute(seq++, "font-size", sym.FontSize > 0 ? sym.FontSize : 14);
            builder.AddAttribute(seq++, "font-family", "system-ui, sans-serif");
            builder.AddContent(seq++, liveValue ?? "---");
            builder.CloseElement();
        }
    };

    private static string EvaluateColorZoneRules(string? rules, double value, string defaultColor)
    {
        if (string.IsNullOrWhiteSpace(rules)) return defaultColor;
        var result = defaultColor;
        foreach (var rule in rules.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            // Parse: ">80 #ef4444" or ">=20 #22c55e" or "<10 #3b82f6" or "==50 #fbbf24"
            var parts = rule.Split(' ', 2, StringSplitOptions.TrimEntries);
            if (parts.Length < 2) continue;
            var cond = parts[0];
            var color = parts[1];
            bool match = false;
            if (cond.StartsWith(">=") && double.TryParse(cond[2..], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v1)) match = value >= v1;
            else if (cond.StartsWith("<=") && double.TryParse(cond[2..], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v2)) match = value <= v2;
            else if (cond.StartsWith("==") && double.TryParse(cond[2..], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v3)) match = Math.Abs(value - v3) < 0.001;
            else if (cond.StartsWith("!=") && double.TryParse(cond[2..], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v4)) match = Math.Abs(value - v4) >= 0.001;
            else if (cond.StartsWith(">") && double.TryParse(cond[1..], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v5)) match = value > v5;
            else if (cond.StartsWith("<") && double.TryParse(cond[1..], System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v6)) match = value < v6;
            if (match) result = color;
        }
        return result;
    }

    // â”€â”€â”€ Alarm Banner rendering â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private RenderFragment RenderAlarmBanner(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width;
        var h = sym.Height;

        // Alarm count from bound variable (integer)
        var alarmCount = 0;
        var highestSeverity = "none";
        if (double.TryParse(liveValue, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var av))
        {
            alarmCount = (int)av;
            if (alarmCount >= 100) highestSeverity = "critical";
            else if (alarmCount >= 10) highestSeverity = "high";
            else if (alarmCount > 0) highestSeverity = "warning";
        }

        var bgColor = highestSeverity switch
        {
            "critical" => "#7f1d1d",
            "high" => "#78350f",
            "warning" => "#1e3a5f",
            _ => "#1e293b"
        };
        var dotColor = highestSeverity switch
        {
            "critical" => "#ef4444",
            "high" => "#f59e0b",
            "warning" => "#3b82f6",
            _ => "#22c55e"
        };
        var statusText = alarmCount == 0 ? "No active alarms" : $"{alarmCount} active alarm{(alarmCount != 1 ? "s" : "")}";

        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w); builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", 4); builder.AddAttribute(seq++, "fill", bgColor);
        builder.AddAttribute(seq++, "stroke", "#334155"); builder.AddAttribute(seq++, "stroke-width", 1);
        if (sym.AlarmBannerFlash && highestSeverity is "critical")
            builder.AddAttribute(seq++, "style", "animation: alarmFlash 0.5s ease-in-out infinite alternate;");
        builder.CloseElement();

        // Status dot
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", 18); builder.AddAttribute(seq++, "cy", F(h / 2.0));
        builder.AddAttribute(seq++, "r", 8); builder.AddAttribute(seq++, "fill", dotColor);
        builder.CloseElement();

        // Count
        if (sym.AlarmBannerShowCount)
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", 18); builder.AddAttribute(seq++, "y", F(h / 2.0));
            builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
            builder.AddAttribute(seq++, "fill", "#fff"); builder.AddAttribute(seq++, "font-size", 9);
            builder.AddContent(seq++, alarmCount.ToString());
            builder.CloseElement();
        }

        // Status text
        builder.OpenElement(seq++, "text");
        builder.AddAttribute(seq++, "x", 36); builder.AddAttribute(seq++, "y", F(h / 2.0));
        builder.AddAttribute(seq++, "text-anchor", "start"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
        builder.AddAttribute(seq++, "fill", "#94a3b8"); builder.AddAttribute(seq++, "font-size", 11);
        builder.AddAttribute(seq++, "font-family", "system-ui, sans-serif");
        builder.AddContent(seq++, statusText);
        builder.CloseElement();
    };

    // â”€â”€â”€ Dropdown rendering (SVG: static preview) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private RenderFragment RenderDropdown(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width;
        var h = sym.Height;
        var bg = sym.DropdownBackground ?? "#1e293b";
        var options = (sym.DropdownOptions ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var values = (sym.DropdownValues ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var display = liveValue ?? "";
        // Map value back to label
        for (var i = 0; i < values.Length && i < options.Length; i++)
            if (values[i] == display) { display = options[i]; break; }
        if (string.IsNullOrEmpty(display) && options.Length > 0) display = options[0];

        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w); builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", 4); builder.AddAttribute(seq++, "fill", bg);
        builder.AddAttribute(seq++, "stroke", "#475569"); builder.AddAttribute(seq++, "stroke-width", 1);
        builder.CloseElement();

        builder.OpenElement(seq++, "text");
        builder.AddAttribute(seq++, "x", 8); builder.AddAttribute(seq++, "y", F(h / 2.0));
        builder.AddAttribute(seq++, "text-anchor", "start"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
        builder.AddAttribute(seq++, "fill", "#e2e8f0"); builder.AddAttribute(seq++, "font-size", 11);
        builder.AddContent(seq++, display);
        builder.CloseElement();

        // Chevron
        builder.OpenElement(seq++, "polygon");
        builder.AddAttribute(seq++, "points", $"{F(w-16)},{F(h/2-3)} {F(w-8)},{F(h/2-3)} {F(w-12)},{F(h/2+3)}");
        builder.AddAttribute(seq++, "fill", "#94a3b8");
        builder.CloseElement();
    };

    // â€”â€”â€” Radio Group rendering (SVG) â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”â€”
    private RenderFragment RenderRadioGroup(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width;
        var h = sym.Height;
        var bg = sym.DropdownBackground ?? "#1e293b";
        var options = (sym.DropdownOptions ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var values = (sym.DropdownValues ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var isVertical = sym.RadioGroupLayout == "vertical";
        var count = Math.Max(1, options.Length);

        if (options.Length == 0)
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(w / 2));
            builder.AddAttribute(seq++, "y", F(h / 2));
            builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
            builder.AddAttribute(seq++, "fill", "#64748b"); builder.AddAttribute(seq++, "font-size", 10);
            builder.AddContent(seq++, "Radio Group (no options)");
            builder.CloseElement();
            return;
        }

        // Background
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w); builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", 4); builder.AddAttribute(seq++, "fill", bg);
        builder.AddAttribute(seq++, "stroke", "#475569"); builder.AddAttribute(seq++, "stroke-width", 1);
        builder.CloseElement();

        for (var idx = 0; idx < options.Length; idx++)
        {
            var label = options[idx];
            var val = idx < values.Length ? values[idx] : label;
            var isSelected = val == (liveValue ?? "");

            double cx, cy, tw, th;
            if (isVertical)
            {
                th = h / count;
                cx = 14; cy = th * idx + th / 2;
                tw = w;
            }
            else
            {
                tw = w / count;
                cx = tw * idx + 14; cy = h / 2.0;
            }

            // Radio circle (outer)
            builder.OpenElement(seq++, "circle");
            builder.AddAttribute(seq++, "cx", F(cx)); builder.AddAttribute(seq++, "cy", F(cy));
            builder.AddAttribute(seq++, "r", 5);
            builder.AddAttribute(seq++, "fill", "none");
            builder.AddAttribute(seq++, "stroke", isSelected ? "#3b82f6" : "#64748b");
            builder.AddAttribute(seq++, "stroke-width", 1.5);
            builder.CloseElement();

            // Radio dot (inner, if selected)
            if (isSelected)
            {
                builder.OpenElement(seq++, "circle");
                builder.AddAttribute(seq++, "cx", F(cx)); builder.AddAttribute(seq++, "cy", F(cy));
                builder.AddAttribute(seq++, "r", 2.5);
                builder.AddAttribute(seq++, "fill", "#3b82f6");
                builder.CloseElement();
            }

            // Label text
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(cx + 10));
            builder.AddAttribute(seq++, "y", F(cy));
            builder.AddAttribute(seq++, "text-anchor", "start"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
            builder.AddAttribute(seq++, "fill", isSelected ? "#e2e8f0" : "#94a3b8"); builder.AddAttribute(seq++, "font-size", 11);
            builder.AddContent(seq++, label);
            builder.CloseElement();
        }
    };

    // â”€â”€â”€ Data Table rendering (SVG via foreignObject) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private RenderFragment RenderDataTable(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width;
        var h = sym.Height;
        var bg = sym.DataTableBackground ?? "#111827";
        var columns = (sym.DataTableColumns ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (columns.Length == 0) columns = new[] { "Variable", "Value" };

        // Background
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w); builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", 4); builder.AddAttribute(seq++, "fill", bg);
        builder.AddAttribute(seq++, "stroke", "#334155"); builder.AddAttribute(seq++, "stroke-width", 1);
        builder.CloseElement();

        var y = 0.0;
        // Header
        if (sym.DataTableShowHeader)
        {
            builder.OpenElement(seq++, "rect");
            builder.AddAttribute(seq++, "width", w); builder.AddAttribute(seq++, "height", 24);
            builder.AddAttribute(seq++, "rx", 4); builder.AddAttribute(seq++, "fill", "#1e293b");
            builder.CloseElement();
            var colW = (w - 8.0) / columns.Length;
            for (var i = 0; i < columns.Length; i++)
            {
                builder.OpenElement(seq++, "text");
                builder.AddAttribute(seq++, "x", F(4 + colW * i + colW / 2));
                builder.AddAttribute(seq++, "y", 15);
                builder.AddAttribute(seq++, "text-anchor", "middle");
                builder.AddAttribute(seq++, "fill", "#94a3b8"); builder.AddAttribute(seq++, "font-size", 10);
                builder.AddContent(seq++, columns[i]);
                builder.CloseElement();
            }
            y = 28;
        }

        // Data rows from HdaVariablePaths
        var paths = sym.HdaVariablePaths;
        var maxRows = Math.Min(sym.DataTableMaxRows > 0 ? sym.DataTableMaxRows : 10, (int)((h - y) / 20));
        for (var r = 0; r < Math.Min(paths.Count, maxRows); r++)
        {
            var rowY = y + 4 + r * 20;
            if (rowY + 16 > h) break;
            var varPath = paths[r];
            var varVal = Opc.GetValue(varPath) ?? "---";
            var varName = varPath.Contains('/') ? varPath[(varPath.LastIndexOf('/') + 1)..] : varPath;

            // Separator line
            if (r > 0)
            {
                builder.OpenElement(seq++, "line");
                builder.AddAttribute(seq++, "x1", 4); builder.AddAttribute(seq++, "y1", F(rowY));
                builder.AddAttribute(seq++, "x2", F(w - 4)); builder.AddAttribute(seq++, "y2", F(rowY));
                builder.AddAttribute(seq++, "stroke", "#1e293b"); builder.AddAttribute(seq++, "stroke-width", 1);
                builder.CloseElement();
            }

            // Variable name
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", 8); builder.AddAttribute(seq++, "y", F(rowY + 13));
            builder.AddAttribute(seq++, "text-anchor", "start"); builder.AddAttribute(seq++, "fill", "#94a3b8"); builder.AddAttribute(seq++, "font-size", 10);
            builder.AddContent(seq++, varName);
            builder.CloseElement();

            // Value
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(w - 8)); builder.AddAttribute(seq++, "y", F(rowY + 13));
            builder.AddAttribute(seq++, "text-anchor", "end"); builder.AddAttribute(seq++, "fill", "#e2e8f0"); builder.AddAttribute(seq++, "font-size", 10);
            builder.AddContent(seq++, varVal);
            builder.CloseElement();
        }
    };

    // Sparkline data buffer helper
    private readonly Dictionary<string, SparklineBuffer> _sparklineData = new();

    private sealed class SparklineBuffer(int capacity)
    {
        private readonly double[] _data = new double[capacity];
        private int _head;
        private int _count;

        public void Add(double value)
        {
            _data[_head] = value;
            _head = (_head + 1) % _data.Length;
            if (_count < _data.Length) _count++;
        }

        public double[] GetPoints()
        {
            var result = new double[_count];
            for (var i = 0; i < _count; i++)
                result[i] = _data[(_head - _count + i + _data.Length) % _data.Length];
            return result;
        }
    }

