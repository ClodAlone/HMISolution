                        break;
                    case "dropdown":
                        @RenderDropdown(sym, liveValue)
                        break;
                    case "radiogroup":
                        @RenderRadioGroup(sym, liveValue)
                        break;
                    case "datatable":
                        @RenderDataTable(sym, liveValue)
                        break;
                    case "alarmbanner":
                        @RenderAlarmBanner(sym, liveValue)
                        break;
                    case "conveyor":
                        @RenderConveyor(sym, liveValue)
                        break;
                    case "piechart":
                        @RenderPieChart(sym, liveValue)
                        break;
                    case "barchart":
                        @RenderBarChart(sym, liveValue)
                        break;
                    case "navbutton":
                        @RenderNavButton(sym, liveValue)
                        break;
                    case "heatexchanger":
                        @RenderHeatExchanger(sym, liveValue)
                        break;
                    case "popup":
                        @RenderPopup(sym, liveValue)
                        break;
                    case "setpointramp":
