    // --- Pie Chart rendering ---
    private RenderFragment RenderPieChart(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width; var h = sym.Height;
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w); builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", 4); builder.AddAttribute(seq++, "fill", sym.PieChartBackground);
        builder.AddAttribute(seq++, "stroke", "#334155"); builder.AddAttribute(seq++, "stroke-width", 1);
        builder.CloseElement();

        var cx = w / 2.0; var cy = h / 2.0;
        var r = Math.Min(w, h) / 2.0 - 10;
        if (r < 5) r = 5;

        var sliceDefs = (sym.PieChartSlices ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries);
        var values = new List<(string label, double val, string color)>();
        foreach (var sd in sliceDefs)
        {
            var parts = sd.Trim().Split(' ', 2);
            if (parts.Length < 2) continue;
            var labelPath = parts[0]; var color = parts[1];
            var eqIdx = labelPath.IndexOf('=');
            string label, path;
            if (eqIdx > 0) { label = labelPath[..eqIdx]; path = labelPath[(eqIdx + 1)..]; }
            else { label = labelPath; path = labelPath; }
            var raw = Opc.GetValue(path) ?? "0";
            if (double.TryParse(raw, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) && v > 0)
                values.Add((label, v, color));
        }

        if (values.Count == 0)
        {
            builder.OpenElement(seq++, "circle");
            builder.AddAttribute(seq++, "cx", F(cx)); builder.AddAttribute(seq++, "cy", F(cy));
            builder.AddAttribute(seq++, "r", F(r)); builder.AddAttribute(seq++, "fill", "#334155");
            builder.CloseElement();
        }
        else
        {
            var total = values.Sum(v => v.val);
            var startAngle = -Math.PI / 2;
            foreach (var (label, val, color) in values)
            {
                var angle = val / total * 2 * Math.PI;
                var endAngle = startAngle + angle;
                var largeArc = angle > Math.PI ? 1 : 0;
                var x1 = cx + r * Math.Cos(startAngle); var y1 = cy + r * Math.Sin(startAngle);
                var x2 = cx + r * Math.Cos(endAngle); var y2 = cy + r * Math.Sin(endAngle);
                builder.OpenElement(seq++, "path");
                builder.AddAttribute(seq++, "d", $"M {F(cx)},{F(cy)} L {F(x1)},{F(y1)} A {F(r)},{F(r)} 0 {largeArc},1 {F(x2)},{F(y2)} Z");
                builder.AddAttribute(seq++, "fill", color);
                builder.CloseElement();
                if (sym.PieChartShowLabels)
                {
                    var midAngle = startAngle + angle / 2;
                    var lx = cx + r * 0.65 * Math.Cos(midAngle);
                    var ly = cy + r * 0.65 * Math.Sin(midAngle);
                    var pct = (val / total * 100).ToString("F0") + "%";
                    builder.OpenElement(seq++, "text");
                    builder.AddAttribute(seq++, "x", F(lx)); builder.AddAttribute(seq++, "y", F(ly));
                    builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
                    builder.AddAttribute(seq++, "fill", "#fff"); builder.AddAttribute(seq++, "font-size", 9);
                    builder.AddContent(seq++, pct);
                    builder.CloseElement();
                }
                startAngle = endAngle;
            }
            if (sym.PieChartStyle == "doughnut")
            {
                builder.OpenElement(seq++, "circle");
                builder.AddAttribute(seq++, "cx", F(cx)); builder.AddAttribute(seq++, "cy", F(cy));
                builder.AddAttribute(seq++, "r", F(r * 0.5)); builder.AddAttribute(seq++, "fill", sym.PieChartBackground);
                builder.CloseElement();
            }
        }
    };

    // --- Bar Chart rendering ---
    private RenderFragment RenderBarChart(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width; var h = sym.Height;
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w); builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", 4); builder.AddAttribute(seq++, "fill", sym.BarChartBackground);
        builder.AddAttribute(seq++, "stroke", "#334155"); builder.AddAttribute(seq++, "stroke-width", 1);
        builder.CloseElement();

        var barDefs = (sym.BarChartBars ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries);
        var values = new List<(string label, double val, string color)>();
        foreach (var bd in barDefs)
        {
            var parts = bd.Trim().Split(' ', 2);
            if (parts.Length < 2) continue;
            var labelPath = parts[0]; var color = parts[1];
            var eqIdx = labelPath.IndexOf('=');
            string label, path;
            if (eqIdx > 0) { label = labelPath[..eqIdx]; path = labelPath[(eqIdx + 1)..]; }
            else { label = labelPath; path = labelPath; }
            var raw = Opc.GetValue(path) ?? "0";
            double.TryParse(raw, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v);
            values.Add((label, Math.Abs(v), color));
        }

        if (values.Count == 0) return;
        var maxVal = sym.BarChartMaxValue > 0 ? sym.BarChartMaxValue : values.Max(v => v.val);
        if (maxVal == 0) maxVal = 1;
        var isVert = sym.BarChartOrientation == "vertical";
        var pad = 8.0;
        var barCount = values.Count;

        if (isVert)
        {
            var barW = (w - pad * 2) / barCount;
            for (int i = 0; i < barCount; i++)
            {
                var (label, val, color) = values[i];
                var barH = (h - pad * 2) * Math.Min(val / maxVal, 1.0);
                var bx = pad + i * barW;
                var by = h - pad - barH;
                builder.OpenElement(seq++, "rect");
                builder.AddAttribute(seq++, "x", F(bx + 1)); builder.AddAttribute(seq++, "y", F(by));
                builder.AddAttribute(seq++, "width", F(barW - 2)); builder.AddAttribute(seq++, "height", F(barH));
                builder.AddAttribute(seq++, "rx", 2); builder.AddAttribute(seq++, "fill", color);
                builder.CloseElement();
                if (sym.BarChartShowValues)
                {
                    builder.OpenElement(seq++, "text");
                    builder.AddAttribute(seq++, "x", F(bx + barW / 2)); builder.AddAttribute(seq++, "y", F(by - 3));
                    builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "fill", "#94a3b8");
                    builder.AddAttribute(seq++, "font-size", 9);
                    builder.AddContent(seq++, val.ToString("F1"));
                    builder.CloseElement();
                }
            }
        }
        else
        {
            var barH2 = (h - pad * 2) / barCount;
            for (int i = 0; i < barCount; i++)
            {
                var (label, val, color) = values[i];
                var barW2 = (w - pad * 2) * Math.Min(val / maxVal, 1.0);
                var by2 = pad + i * barH2;
                builder.OpenElement(seq++, "rect");
                builder.AddAttribute(seq++, "x", F(pad)); builder.AddAttribute(seq++, "y", F(by2 + 1));
                builder.AddAttribute(seq++, "width", F(barW2)); builder.AddAttribute(seq++, "height", F(barH2 - 2));
                builder.AddAttribute(seq++, "rx", 2); builder.AddAttribute(seq++, "fill", color);
                builder.CloseElement();
                if (sym.BarChartShowValues)
                {
                    builder.OpenElement(seq++, "text");
                    builder.AddAttribute(seq++, "x", F(pad + barW2 + 4)); builder.AddAttribute(seq++, "y", F(by2 + barH2 / 2));
                    builder.AddAttribute(seq++, "text-anchor", "start"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
                    builder.AddAttribute(seq++, "fill", "#94a3b8"); builder.AddAttribute(seq++, "font-size", 9);
                    builder.AddContent(seq++, val.ToString("F1"));
                    builder.CloseElement();
                }
            }
        }
    };

