                        break;
                    case "mimicpump":
                        <circle cx="@F(sym.Width/2)" cy="@F(sym.Height/2)" r="@F(Math.Min(sym.Width,sym.Height)/2-2)" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth"/>
                        <polygon points="@($"{F(sym.Width*0.3)},{F(sym.Height*0.3)} {F(sym.Width*0.7)},{F(sym.Height*0.5)} {F(sym.Width*0.3)},{F(sym.Height*0.7)}")" fill="@sym.Stroke" opacity="0.8"/>
                        break;
                    case "mimicvalve":
                        <polygon points="@($"{F(sym.Width*0.15)},{F(sym.Height*0.2)} {F(sym.Width*0.85)},{F(sym.Height*0.5)} {F(sym.Width*0.15)},{F(sym.Height*0.8)}")" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth"/>
                        <polygon points="@($"{F(sym.Width*0.85)},{F(sym.Height*0.2)} {F(sym.Width*0.15)},{F(sym.Height*0.5)} {F(sym.Width*0.85)},{F(sym.Height*0.8)}")" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth"/>
                        <line x1="@F(sym.Width*0.5)" y1="@F(sym.Height*0.2)" x2="@F(sym.Width*0.5)" y2="0" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth"/>
                        break;
                    case "mimictank":
                        <rect width="@sym.Width" height="@sym.Height" rx="4" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth"/>
                        <rect x="2" y="@F(sym.Height*0.5)" width="@F(sym.Width-4)" height="@F(sym.Height*0.48)" rx="2" fill="@sym.Stroke" opacity="0.25"/>
                        break;
                    case "mimicsensor":
                        <rect width="@sym.Width" height="@F(sym.Height*0.7)" rx="4" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth"/>
                        @RenderSvgText(sym.Width/2, sym.Height*0.4, "middle", "middle", sym.Stroke, 12, "PT")
                        <line x1="@F(sym.Width/2)" y1="@F(sym.Height*0.7)" x2="@F(sym.Width/2)" y2="@F(sym.Height)" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth"/>
                        break;
                    case "mimiccontroller":
                        <rect width="@sym.Width" height="@sym.Height" rx="4" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth"/>
                        @RenderSvgText(sym.Width/2, sym.Height*0.35, "middle", "middle", sym.Stroke, 10, "PLC")
                        <rect x="@F(sym.Width*0.1)" y="@F(sym.Height*0.55)" width="@F(sym.Width*0.8)" height="@F(sym.Height*0.2)" rx="2" fill="#1e293b"/>
                        <circle cx="@F(sym.Width*0.25)" cy="@F(sym.Height*0.65)" r="3" fill="#22c55e"/>
                        <circle cx="@F(sym.Width*0.42)" cy="@F(sym.Height*0.65)" r="3" fill="#22c55e"/>
                        <circle cx="@F(sym.Width*0.59)" cy="@F(sym.Height*0.65)" r="3" fill="#f59e0b"/>
                        break;
                    case "mimicmixer":
                        <rect width="@sym.Width" height="@sym.Height" rx="6" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth"/>
                        <line x1="@F(sym.Width/2)" y1="0" x2="@F(sym.Width/2)" y2="@F(sym.Height*0.35)" stroke="#94a3b8" stroke-width="2"/>
                        <line x1="@F(sym.Width*0.3)" y1="@F(sym.Height*0.45)" x2="@F(sym.Width*0.7)" y2="@F(sym.Height*0.65)" stroke="#94a3b8" stroke-width="2"/>
                        <line x1="@F(sym.Width*0.7)" y1="@F(sym.Height*0.45)" x2="@F(sym.Width*0.3)" y2="@F(sym.Height*0.65)" stroke="#94a3b8" stroke-width="2"/>
                        break;
                    case "mimicheater":
                        <rect width="@sym.Width" height="@sym.Height" rx="4" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth"/>
                        <path d="M @F(sym.Width*0.2),@F(sym.Height*0.5) C @F(sym.Width*0.2),@F(sym.Height*0.35) @F(sym.Width*0.3),@F(sym.Height*0.25) @F(sym.Width*0.35),@F(sym.Height*0.35)" fill="none" stroke="#ef4444" stroke-width="1.5"/>
                        <path d="M @F(sym.Width*0.55),@F(sym.Height*0.5) C @F(sym.Width*0.55),@F(sym.Height*0.35) @F(sym.Width*0.65),@F(sym.Height*0.25) @F(sym.Width*0.7),@F(sym.Height*0.35)" fill="none" stroke="#f59e0b" stroke-width="1.5"/>
                        break;
                    case "mimicfilter":
                        <polygon points="@($"{F(sym.Width*0.15)},0 {F(sym.Width*0.85)},0 {F(sym.Width*0.78)},{F(sym.Height)} {F(sym.Width*0.22)},{F(sym.Height)}")" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth"/>
                        <line x1="@F(sym.Width*0.22)" y1="@F(sym.Height*0.35)" x2="@F(sym.Width*0.78)" y2="@F(sym.Height*0.35)" stroke="#475569" stroke-width="1" stroke-dasharray="3,2"/>
                        <line x1="@F(sym.Width*0.2)" y1="@F(sym.Height*0.55)" x2="@F(sym.Width*0.8)" y2="@F(sym.Height*0.55)" stroke="#475569" stroke-width="1" stroke-dasharray="3,2"/>
                        break;
                    case "mimiccompressor":
                        <circle cx="@F(sym.Width/2)" cy="@F(sym.Height/2)" r="@F(Math.Min(sym.Width,sym.Height)/2-2)" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth"/>
                        <path d="M @F(sym.Width*0.3),@F(sym.Height*0.35) L @F(sym.Width*0.5),@F(sym.Height*0.5) L @F(sym.Width*0.3),@F(sym.Height*0.65)" fill="none" stroke="#06b6d4" stroke-width="2"/>
                        <path d="M @F(sym.Width*0.5),@F(sym.Height*0.5) L @F(sym.Width*0.7),@F(sym.Height*0.35) M @F(sym.Width*0.5),@F(sym.Height*0.5) L @F(sym.Width*0.7),@F(sym.Height*0.65)" fill="none" stroke="#06b6d4" stroke-width="2"/>
                        break;
                    case "mimicreactor":
                        <rect width="@sym.Width" height="@sym.Height" rx="8" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth"/>
                        <circle cx="@F(sym.Width*0.35)" cy="@F(sym.Height*0.4)" r="4" fill="@sym.Stroke" opacity="0.5"/>
                        <circle cx="@F(sym.Width*0.6)" cy="@F(sym.Height*0.55)" r="5" fill="@sym.Stroke" opacity="0.4"/>
                        <circle cx="@F(sym.Width*0.45)" cy="@F(sym.Height*0.65)" r="3.5" fill="@sym.Stroke" opacity="0.6"/>
                        break;
                        break;
                }

                @if (!string.IsNullOrEmpty(resolvedLabel) && sym.Type is not "text" and not "button" and not "animtext" and not "numericdisplay" and not "progressbar" and not "dropdown" and not "radiogroup" and not "sparkline" and not "colorzone" and not "alarmbanner" and not "conveyor" and not "piechart" and not "barchart" and not "navbutton" and not "heatexchanger" and not "popup" and not "setpointramp" and not "flowmeter" and not "xyplot" and not "pdfviewer" and not "alarmanalytics" and not "kpiwidget" and not "mimicpump" and not "mimicvalve" and not "mimictank" and not "mimicsensor" and not "mimiccontroller" and not "mimicmixer" and not "mimicheater" and not "mimicfilter" and not "mimiccompressor" and not "mimicreactor")
                {
                    @RenderSvgText(sym.Width / 2, sym.Height + 14, "middle", null, "#333", 11, resolvedLabel, sym)
                }

                @* Hover highlight outline â€” shown via CSS :hover *@
                @if (hasCmd)
                {
                    <rect class="rv-hover-outline" x="-2" y="-2" width="@(sym.Width + 4)" height="@(sym.Height + 4)"
                          fill="none" stroke="@(isLocked ? "#dc3545" : "#0d6efd")" stroke-width="2" stroke-dasharray="4,2" rx="4"
                          style="pointer-events: none;" />
                }

                @* Lock icon for symbols requiring write access the user doesn't have *@
                @if (isLocked)
                {
                    @RenderSvgText(sym.Width - 2, 12, "end", null, "#dc3545", 12, "ðŸ”’")
                }
                </g>
            </g></LiveSymbol>
        }

        @* ── Auto-routed connections ── *@
        @foreach (var conn in Screen.Connections)
        {
            var srcSym = Screen.Symbols.FirstOrDefault(s => s.Id == conn.SourceSymbolId);
            var tgtSym = Screen.Symbols.FirstOrDefault(s => s.Id == conn.TargetSymbolId);
            if (srcSym == null || tgtSym == null) continue;
            var srcPort = srcSym.ConnectionPorts.FirstOrDefault(p => p.Id == conn.SourcePortId);
            var tgtPort = tgtSym.ConnectionPorts.FirstOrDefault(p => p.Id == conn.TargetPortId);
            if (srcPort == null || tgtPort == null) continue;

            var sx = srcSym.X + srcPort.RelativeX * srcSym.Width;
            var sy = srcSym.Y + srcPort.RelativeY * srcSym.Height;
            var tx = tgtSym.X + tgtPort.RelativeX * tgtSym.Width;
            var ty = tgtSym.Y + tgtPort.RelativeY * tgtSym.Height;
            var pathD = ComputeOrthogonalRoute(sx, sy, srcPort.Direction, tx, ty, tgtPort.Direction, Screen, srcSym, tgtSym);
            var dashArray = conn.LineStyle == "dashed" ? "8,4" : conn.LineStyle == "dotted" ? "2,4" : "none";
            var showFlow = conn.ShowFlow;
            if (showFlow && !string.IsNullOrEmpty(conn.FlowVariablePath))
            {
                var flowVal = OpcGet(conn.FlowVariablePath, null);
                showFlow = flowVal is "1" or "true" or "True";
            }
            <g>
                <path d="@pathD" fill="none" stroke="@conn.Color" stroke-width="@conn.StrokeWidth"
                      stroke-dasharray="@dashArray" stroke-linecap="round" stroke-linejoin="round"/>
                @if (showFlow)
                {
                    <circle r="3" fill="@conn.FlowColor">
                        <animateMotion dur="2s" repeatCount="indefinite" path="@pathD"
                                       keyPoints="@(conn.FlowDirection == "reverse" ? "1;0" : "0;1")" keyTimes="0;1" calcMode="linear"/>
                    </circle>
                    <circle r="3" fill="@conn.FlowColor" opacity="0.5">
                        <animateMotion dur="2s" repeatCount="indefinite" path="@pathD" begin="0.66s"
                                       keyPoints="@(conn.FlowDirection == "reverse" ? "1;0" : "0;1")" keyTimes="0;1" calcMode="linear"/>
                    </circle>
                    <circle r="3" fill="@conn.FlowColor" opacity="0.3">
                        <animateMotion dur="2s" repeatCount="indefinite" path="@pathD" begin="1.33s"
                                       keyPoints="@(conn.FlowDirection == "reverse" ? "1;0" : "0;1")" keyTimes="0;1" calcMode="linear"/>
                    </circle>
                }
                @if (!string.IsNullOrEmpty(conn.Label))
                {
                    var mx = (sx + tx) / 2;
                    var my = (sy + ty) / 2;
                    <rect x="@F(mx - conn.Label.Length * 3.5 - 4)" y="@F(my - 8)" width="@F(conn.Label.Length * 7 + 8)" height="16" rx="3" fill="rgba(0,0,0,0.7)"/>
                    @RenderSvgText(mx, my + 4, "middle", "middle", "#e2e8f0", 10, conn.Label)
                }
            </g>
        }

    </svg>
}

@code {
    [Parameter] public ScreenConfig? Screen { get; set; }
    [Parameter] public bool IsKiosk { get; set; }
    [Parameter] public bool BestFit { get; set; }
    [Parameter] public EventCallback OnRequestLogin { get; set; }

    /// <summary>
    /// Optional alias map for parameterized (template) screens.
    /// Keys are alias placeholder names, values are real OPC variable paths.
    /// Variable paths containing {AliasName} tokens are resolved at runtime.
    /// </summary>
    [Parameter] public Dictionary<string, string>? VariableAliases { get; set; }

    /// <summary>
    /// Effective fit mode: per-screen FitMode wins if set; BestFit parameter acts as legacy override.
    /// </summary>
    private string EffectiveFitMode
    {
        get
        {
            // Per-screen setting takes priority when explicitly set
            var mode = Screen?.FitMode ?? "";
            if (!string.IsNullOrEmpty(mode) && mode is "contain" or "fill" or "scroll")
                return mode;
            // Legacy fallback: BestFit parameter â†’ "contain", else "scroll"
            return BestFit ? "contain" : "scroll";
        }
    }    [Inject] private OpcRuntimeClient Opc { get; set; } = default!;
    [Inject] private CommandService Commands { get; set; } = default!;
    [Inject] private RuntimeAuthService Auth { get; set; } = default!;
    [Inject] private LocalizationService Localization { get; set; } = default!;
    [Inject] private ProjectService Project { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private ElementReference _svgRef;
    private IJSObjectReference? _jsModule;
    private System.Threading.Timer? _refreshTimer;
    private string? _pressedSymbolId;
    private readonly string _callerId = Guid.NewGuid().ToString("N");

    private string? ResolveImageData(string? imageId)
    {
        if (string.IsNullOrEmpty(imageId)) return null;
        var cache = GetImageCache();
        return cache != null && cache.TryGetValue(imageId, out var data) ? data : null;
    }

    private Dictionary<string, string>? GetImageCache()
    {
        var images = Project.Model?.Images;

        if (images == null) { _imageCache = null; return null; }
        if (_imageCache != null && ReferenceEquals(images, _imageCacheSource)) return _imageCache;
        _imageCache = new Dictionary<string, string>(images.Count, StringComparer.Ordinal);
        foreach (var img in images)
            _imageCache.TryAdd(img.Id, img.Data);
        _imageCacheSource = images;
        return _imageCache;
    }

    private List<ScreenSymbol> GetSortedSymbols()
    {
        if (_sortedSymbols != null && _sortedSymbolsScreenName == Screen?.Name)
            return _sortedSymbols;
        _sortedSymbolsScreenName = Screen?.Name;
        _sortedSymbols = Screen?.Symbols?.OrderBy(s => s.Order).ToList() ?? new();
        return _sortedSymbols;
    }
    private readonly Dictionary<string, double> _gaugeDisplayPct = new();
    private const double _gaugeLerpSpeed = 0.18;
    private ScreenSymbol? _dragSliderSymbol;
    private bool _isDraggingSlider;
    private ScreenSymbol? _dragKnobSymbol;
    private bool _isDraggingKnob;
    private double _knobDragStartAngle;
    private double _knobDragStartValue;
    private double _knobPrevAngle;
    private double _knobCurrentValue;
    private bool _suppressNextClick;
    private DateTime _lastDragWrite = DateTime.MinValue;
    private const int DragWriteIntervalMs = 60;
    private string? _pendingDragPath;
    private string? _pendingDragValue;
    private DotNetObjectReference<ScreenRenderer>? _dotnetRef;
    private bool _jsDragActive;
    private volatile bool _valuesDirty;
    private string? _lastMonitoredScreenName;
    private HashSet<string> _lastMonitoredPaths = new();
    private Dictionary<string, string>? _imageCache;
    private List<ImageResource>? _imageCacheSource;
    private List<ScreenSymbol>? _sortedSymbols;
    private string? _sortedSymbolsScreenName;
    private Dictionary<string, string>? _fontStyleCache;

    /// <summary>Builds inline CSS for widget font overrides from the symbol config.
    /// Result is cached per symbol Id since font properties are immutable at runtime.</summary>
    private string WidgetFontStyle(ScreenSymbol sym)
    {
        _fontStyleCache ??= new Dictionary<string, string>(StringComparer.Ordinal);
        if (_fontStyleCache.TryGetValue(sym.Id, out var cached))
            return cached;

        bool hasFamily = !string.IsNullOrEmpty(sym.FontFamily);
        bool hasSize = sym.FontSize > 0;
        bool hasWeight = !string.IsNullOrEmpty(sym.FontWeight);
        bool hasStyle = !string.IsNullOrEmpty(sym.FontStyle);

        string result;
        if (!hasFamily && !hasSize && !hasWeight && !hasStyle)
            result = string.Empty;
        else
            result = string.Concat(
                hasFamily ? string.Concat("font-family: ", sym.FontFamily, "; --widget-font-family: ", sym.FontFamily, "; ") : "",
                hasSize ? string.Concat("font-size: ", sym.FontSize.ToString(), "px; --widget-font-size: ", sym.FontSize.ToString(), "px; ") : "",
                hasWeight ? string.Concat("font-weight: ", sym.FontWeight, "; --widget-font-weight: ", sym.FontWeight, "; ") : "",
                hasStyle ? string.Concat("font-style: ", sym.FontStyle, "; --widget-font-style: ", sym.FontStyle, "; ") : "");

        _fontStyleCache[sym.Id] = result;
        return result;
    }

    protected override void OnInitialized()
    {
        Opc.ValuesChanged += OnValuesChanged;
        Localization.LanguageChanged += OnLanguageChanged;
        _refreshTimer = new System.Threading.Timer(_ =>
        {
            if (_valuesDirty)
            {
                _valuesDirty = false;
                InvokeAsync(StateHasChanged);
            }
        }, null, 500, 500);
    }

    protected override void OnParametersSet()
    {
        if (Screen != null && Opc.IsConnected)
        {
            var paths = Screen.Symbols
                .Where(s => !string.IsNullOrEmpty(s.VariablePath))
                .Select(s => ResolveAlias(s.VariablePath, s.InstanceAliases is { Count: > 0 } ? s.InstanceAliases : null))
                .Distinct()
                .ToList();

            // Also monitor variables referenced by commands
            foreach (var sym in Screen.Symbols)
            {
                foreach (var cmd in sym.Commands)
                {
                    if (!string.IsNullOrEmpty(cmd.VariablePath))
                        paths.Add(ResolveAlias(cmd.VariablePath, sym.InstanceAliases is { Count: > 0 } ? sym.InstanceAliases : null));
                }

                // Monitor recipe OPC command/status variables and recipe variable paths
                if (sym.Type == "recipe" && !string.IsNullOrEmpty(sym.RecipeName))
                {
                    var prefix = $"Recipe.{sym.RecipeName}";
                    paths.Add($"{prefix}.ActiveName");
                    paths.Add($"{prefix}.RecipeList");
                    paths.Add($"{prefix}.LastStatus");
                    paths.Add($"{prefix}.Load");
                    paths.Add($"{prefix}.Save");
                    paths.Add($"{prefix}.Activate");
                    paths.Add($"{prefix}.Delete");

                    foreach (var rv in GetRecipeVariables(sym.RecipeName))
                        paths.Add(rv.VariablePath);
                }

                // Monitor statistics sub-variables for editboxes with ShowStatistics
                if (sym.Type == "editbox" && sym.EditBoxShowStatistics && !string.IsNullOrEmpty(sym.VariablePath))
                {
                    var resolvedEditPath = ResolveAlias(sym.VariablePath, sym.InstanceAliases is { Count: > 0 } ? sym.InstanceAliases : null);
                    paths.Add(resolvedEditPath + ".Statistics.Min");
                    paths.Add(resolvedEditPath + ".Statistics.Max");
                    paths.Add(resolvedEditPath + ".Statistics.Average");
                    paths.Add(resolvedEditPath + ".Statistics.Count");
                }

                // Monitor realtime trend pen variables
                if (sym.Type == "trend")
                {
                    foreach (var pen in sym.TrendPens)
                    {
                        if (!string.IsNullOrEmpty(pen.VariablePath))
                            paths.Add(pen.VariablePath);
                    }
                }

                // Monitor animation trigger variables
                foreach (var anim in sym.Animations)
                {
                    if (!string.IsNullOrEmpty(anim.TriggerVariable))
                        paths.Add(ResolveAlias(anim.TriggerVariable, sym.InstanceAliases is { Count: > 0 } ? sym.InstanceAliases : null));
                }
            }

            var distinctPaths = new HashSet<string>(paths);

            // Only re-subscribe if the screen or variable set actually changed
            if (Screen.Name != _lastMonitoredScreenName || !distinctPaths.SetEquals(_lastMonitoredPaths))
            {
                _lastMonitoredScreenName = Screen.Name;
                _lastMonitoredPaths = distinctPaths;
                Opc.MonitorVariables(distinctPaths, _callerId);
            }
        }
    }

    /// &lt;summary&gt;
    /// Resolves alias placeholders in a variable path.
    /// Replaces {AliasName} tokens using the VariableAliases dictionary.
    /// Returns the original path if no aliases apply.
    /// &lt;/summary&gt;
    private string ResolveAlias(string? path)
    {
        return ResolveAlias(path, null);
    }

    /// <summary>Resolves alias placeholders using both screen-level VariableAliases and per-symbol InstanceAliases.</summary>
    private string ResolveAlias(string? path, Dictionary<string, string>? instanceAliases)
    {
        if (string.IsNullOrEmpty(path))
            return path ?? "";
        if (!path.Contains('{'))
            return path;
        // Apply per-instance aliases first (from UserSymbolGroup instances)
        if (instanceAliases is { Count: > 0 })
        {
            foreach (var kv in instanceAliases)
                if (!string.IsNullOrEmpty(kv.Value))
                    path = path.Replace($"{{{kv.Key}}}", kv.Value);
        }
        // Then apply screen-level aliases
        if (VariableAliases is { Count: > 0 })
        {
            foreach (var kv in VariableAliases)
                path = path.Replace($"{{{kv.Key}}}", kv.Value);
        }
        return path;
    }

    /// &lt;summary&gt;Read an OPC value, resolving aliases first.&lt;/summary&gt;
    private string? OpcGet(string? path)
    {
        return Opc.GetValue(ResolveAlias(path));
    }

    /// <summary>Read an OPC value, resolving both screen and instance aliases.</summary>
    private string? OpcGet(string? path, ScreenSymbol sym)
    {
        var aliases = sym.InstanceAliases is { Count: > 0 } ? sym.InstanceAliases : null;
        return Opc.GetValue(ResolveAlias(path, aliases));
    }

    private void OnValuesChanged()
    {
        // Signal the timer to re-render on its next tick.
        // Do NOT call StateHasChanged here â€” it would fire on every
        // OPC notification and create a render storm.
        _valuesDirty = true;
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    // â”€â”€â”€ Mouse interaction â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    private async Task OnSymbolMouseDown(MouseEventArgs e, ScreenSymbol sym)
    {
        // Start slider drag if applicable
        if (sym.Type is "hslider" or "vslider" && !string.IsNullOrEmpty(sym.VariablePath))
        {
            _dragSliderSymbol = sym;
            _isDraggingSlider = true;
            await StartJsDrag();
            ApplySliderDragFromSvg(await GetSvgPoint(e));
            return;
        }

        // Start knob drag if applicable
        if (sym.Type == "knob" && !string.IsNullOrEmpty(sym.VariablePath))
        {
            if (_jsModule != null)
            {
                try
                {
                    var svgPt = await _jsModule.InvokeAsync<SvgPoint>("clientToSvg", _svgRef, e.ClientX, e.ClientY);
                    var cx = sym.X + sym.Width / 2.0;
                    var cy = sym.Y + sym.Height / 2.0;
                    _knobDragStartAngle = Math.Atan2(svgPt.X - cx, -(svgPt.Y - cy)) * 180.0 / Math.PI;
                    _knobPrevAngle = _knobDragStartAngle;
                    _knobDragStartValue = ParseDouble(OpcGet(sym.VariablePath, sym) ?? "0");
                    _knobCurrentValue = _knobDragStartValue;
                    _dragKnobSymbol = sym;
                    _isDraggingKnob = true;
                    await StartJsDrag();
                }
                catch { }
            }
            return;
        }

        if (sym.Commands.Count > 0 && !Auth.HasWriteAccess(sym.RequiredAccess))
        {
            await OnRequestLogin.InvokeAsync();
            return;
        }

        _pressedSymbolId = sym.Id;

        foreach (var cmd in sym.Commands)
        {
            if (cmd.Trigger is "MouseDown" or "WhilePressed")
                await Commands.ExecuteAsync(cmd, VariableAliases);
        }
    }

    private async Task OnRadioGroupSelect(string variablePath, string value)
    {
        var resolved = ResolveAlias(variablePath);
        if (string.IsNullOrEmpty(resolved)) return;
        Opc.UpdateLocalValue(resolved, value);
        StateHasChanged();
        await Opc.WriteValueAsync(resolved, value);
    }

    private async Task OnSymbolMouseUp(MouseEventArgs e, ScreenSymbol sym)
    {
        // Drag end is handled by JS pointer-capture (JsDragEnd)
        if (_isDraggingSlider || _isDraggingKnob) return;

        if (sym.Commands.Count > 0 && !Auth.HasWriteAccess(sym.RequiredAccess))
            return;

        // MouseUp trigger
        foreach (var cmd in sym.Commands)
        {
            if (cmd.Trigger == "MouseUp")
                await Commands.ExecuteAsync(cmd, VariableAliases);
        }

        // WhilePressed release
        if (_pressedSymbolId == sym.Id)
        {
            foreach (var cmd in sym.Commands)
            {
                if (cmd.Trigger == "WhilePressed")
                    await Commands.ExecuteReleaseAsync(cmd);
            }
        }

        _pressedSymbolId = null;
    }

    private async Task OnSymbolClick(ScreenSymbol sym)
    {
        // Suppress click after a drag interaction (slider/knob)
        if (_suppressNextClick)
        {
            _suppressNextClick = false;
            return;
        }

        // Rotary switch: cycle position on click
        if (sym.Type == "rotaryswitch" && !string.IsNullOrEmpty(sym.VariablePath))
        {
            if (!Auth.HasWriteAccess(sym.RequiredAccess))
            {
                await OnRequestLogin.InvokeAsync();
                return;
            }
            var n = Math.Max(2, Math.Min(12, sym.SwitchPositions));
            var pos = (int)ParseDouble(OpcGet(sym.VariablePath, sym) ?? "0");
            pos = (pos + 1) % n;
            var posStr = pos.ToString();
            var resolvedRotary = ResolveAlias(sym.VariablePath, sym.InstanceAliases is { Count: > 0 } ? sym.InstanceAliases : null);
            Opc.UpdateLocalValue(resolvedRotary, posStr);
            StateHasChanged();
            await Opc.WriteValueAsync(resolvedRotary, posStr);
            return;
        }

        // Toggle switch: toggle on click
        if (sym.Type == "switch" && !string.IsNullOrEmpty(sym.VariablePath))
        {
            if (!Auth.HasWriteAccess(sym.RequiredAccess))
            {
                await OnRequestLogin.InvokeAsync();
                return;
            }
            var current = OpcGet(sym.VariablePath, sym) ?? "0";
            var isOn = current is "True" or "true" or "1";
            var newVal = isOn ? "0" : "1";
            var resolvedSwitch = ResolveAlias(sym.VariablePath, sym.InstanceAliases is { Count: > 0 } ? sym.InstanceAliases : null);
            Opc.UpdateLocalValue(resolvedSwitch, newVal);
            StateHasChanged();
            await Opc.WriteValueAsync(resolvedSwitch, newVal);
            return;
        }

        // Radio group: cycle through options on click (SVG mode)
        if (sym.Type == "radiogroup" && !string.IsNullOrEmpty(sym.VariablePath))
        {
            if (!Auth.HasWriteAccess(sym.RequiredAccess))
            {
                await OnRequestLogin.InvokeAsync();
                return;
            }
            var opts = (sym.DropdownOptions ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var vals = (sym.DropdownValues ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (opts.Length > 0)
            {
                var current = OpcGet(sym.VariablePath, sym) ?? "";
                var curIdx = -1;
                for (var k = 0; k < opts.Length; k++)
                {
                    var v = k < vals.Length ? vals[k] : opts[k];
                    if (v == current) { curIdx = k; break; }
                }
                var nextIdx = (curIdx + 1) % opts.Length;
                var nextVal = nextIdx < vals.Length ? vals[nextIdx] : opts[nextIdx];
                var resolvedRadio = ResolveAlias(sym.VariablePath, sym.InstanceAliases is { Count: > 0 } ? sym.InstanceAliases : null);
                Opc.UpdateLocalValue(resolvedRadio, nextVal);
                StateHasChanged();
                await Opc.WriteValueAsync(resolvedRadio, nextVal);
            }
            return;
        }

        // NavButton: trigger NavigateScreen from NavButtonTarget property
        if (sym.Type == "navbutton" && !string.IsNullOrEmpty(sym.NavButtonTarget))
        {
            Commands.RaiseNavigateScreen(sym.NavButtonTarget, "");
            return;
        }

        if (sym.Commands.Count > 0 && !Auth.HasWriteAccess(sym.RequiredAccess))
        {
            await OnRequestLogin.InvokeAsync();
            return;
        }

        foreach (var cmd in sym.Commands)
        {
            if (cmd.Trigger == "Click")
                await Commands.ExecuteAsync(cmd, VariableAliases);
        }
    }

    /// <summary>Helper to convert client mouse coords to SVG space.</summary>
    private async Task<SvgPoint> GetSvgPoint(MouseEventArgs e)
    {
        if (_jsModule == null) return default;
        return await _jsModule.InvokeAsync<SvgPoint>("clientToSvg", _svgRef, e.ClientX, e.ClientY);
    }

    /// <summary>Begin JS-side pointer capture for smooth drag without SignalR per-pixel traffic.</summary>
    private async Task StartJsDrag()
    {
        if (_jsModule == null) return;
        try
        {
            _dotnetRef ??= DotNetObjectReference.Create(this);
            await _jsModule.InvokeVoidAsync("startDrag", _svgRef, _dotnetRef, DragWriteIntervalMs);
            _jsDragActive = true;
        }
        catch { _jsDragActive = false; }
    }

    /// <summary>Called from JS on each throttled pointer-move during drag.</summary>
    [JSInvokable]
    public void JsDragMove(double svgX, double svgY)
    {
        var pt = new SvgPoint(svgX, svgY);
        if (_isDraggingSlider && _dragSliderSymbol != null)
            ApplySliderDragFromSvg(pt);
        if (_isDraggingKnob && _dragKnobSymbol != null)
            ApplyKnobDragFromSvg(pt);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Called from JS on pointer-up (end of drag).</summary>
    [JSInvokable]
    public async Task JsDragEnd(double svgX, double svgY)
    {
        _jsDragActive = false;
        // Apply final position
        JsDragMove(svgX, svgY);

        if (_isDraggingSlider)
        {
            _isDraggingSlider = false;
            _dragSliderSymbol = null;
            _suppressNextClick = true;
            await FlushPendingDragWrite();
        }
        if (_isDraggingKnob)
        {
            _isDraggingKnob = false;
            _dragKnobSymbol = null;
            _suppressNextClick = true;
            await FlushPendingDragWrite();
        }

        // Release WhilePressed if mouse leaves the symbol area
        if (_pressedSymbolId != null && Screen != null)
        {
            var sym = Screen.Symbols.FirstOrDefault(s => s.Id == _pressedSymbolId);
            if (sym != null)
            {
                foreach (var cmd in sym.Commands)
                {
                    if (cmd.Trigger == "WhilePressed")
                        await Commands.ExecuteReleaseAsync(cmd);
                }
            }
            _pressedSymbolId = null;
        }
    }

    private void ApplySliderDragFromSvg(SvgPoint svgPt)
    {
        var sym = _dragSliderSymbol;
        if (sym == null || string.IsNullOrEmpty(sym.VariablePath)) return;
        try
        {
            var min = sym.MinValue ?? 0;
            var max = sym.MaxValue ?? 100;
            double frac;
            if (sym.Type == "hslider")
            {
                var thumbR = Math.Min(sym.Height * 0.35, 14);
                var pad = thumbR + 2;
                var trackW = sym.Width - pad * 2;
                var localX = svgPt.X - sym.X - pad;
                frac = Math.Clamp(localX / trackW, 0, 1);
            }
            else
            {
                var thumbR = Math.Min(sym.Width * 0.35, 14);
                var pad = thumbR + 2;
                var trackH = sym.Height - pad * 2;
                var localY = svgPt.Y - sym.Y - pad;
                frac = Math.Clamp(1.0 - localY / trackH, 0, 1);
            }
            var newVal = Math.Clamp(min + frac * (max - min), min, max);
            ThrottledDragWrite(sym.VariablePath, newVal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
        }
        catch { }
    }

    private void ApplyKnobDragFromSvg(SvgPoint svgPt)
    {
        var sym = _dragKnobSymbol;
        if (sym == null || string.IsNullOrEmpty(sym.VariablePath)) return;
        try
        {
            var cx = sym.X + sym.Width / 2.0;
            var cy = sym.Y + sym.Height / 2.0;
            var currentAngle = Math.Atan2(svgPt.X - cx, -(svgPt.Y - cy)) * 180.0 / Math.PI;

            // Use incremental delta from previous angle to avoid Â±180Â° wrapping
            var delta = currentAngle - _knobPrevAngle;
            if (delta > 180) delta -= 360;
            if (delta < -180) delta += 360;
            _knobPrevAngle = currentAngle;

            var min = sym.MinValue ?? 0;
            var max = sym.MaxValue ?? 100;
            // Map 300Â° rotation range to full value range
            var valueDelta = delta / 300.0 * (max - min);
            _knobCurrentValue = Math.Clamp(_knobCurrentValue + valueDelta, min, max);
            ThrottledDragWrite(sym.VariablePath, _knobCurrentValue.ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
        }
        catch { }
    }

    private record struct SvgPoint(double X, double Y);

    private Task? _inFlightWrite;

    private void ThrottledDragWrite(string variablePath, string value)
    {
        // Optimistic local update so the UI refreshes instantly
        Opc.UpdateLocalValue(variablePath, value);

        _pendingDragPath = variablePath;
        _pendingDragValue = value;
        var now = DateTime.UtcNow;
        if ((now - _lastDragWrite).TotalMilliseconds >= DragWriteIntervalMs)
        {
            _lastDragWrite = now;
            _pendingDragPath = null;
            _pendingDragValue = null;
            _inFlightWrite = Opc.WriteValueAsync(variablePath, value);
        }
    }

    /// <summary>Flush any pending throttled drag value (called on mouse-up).</summary>
    private async Task FlushPendingDragWrite()
    {
        if (_inFlightWrite != null)
        {
            try { await _inFlightWrite; } catch { }
            _inFlightWrite = null;
        }
        if (_pendingDragPath != null && _pendingDragValue != null)
        {
            await Opc.WriteValueAsync(_pendingDragPath, _pendingDragValue);
            _pendingDragPath = null;
            _pendingDragValue = null;
        }
    }


    // â”€â”€â”€ Formatting â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€


    private string ComputeOrthogonalRoute(double sx, double sy, string srcDir, double tx, double ty, string tgtDir, ScreenConfig screen, ScreenSymbol srcSym, ScreenSymbol tgtSym)
    {
        const double margin = 30.0;
        const double pad = 16.0;
        string F(double v) => v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

        // 1. Exit points (stub endpoints outside symbol boundary)
        double ex = sx, ey = sy, etx = tx, ety = ty;
        switch (srcDir) { case "left": ex = sx - margin; break; case "right": ex = sx + margin; break; case "up": ey = sy - margin; break; case "down": ey = sy + margin; break; }
        switch (tgtDir) { case "left": etx = tx - margin; break; case "right": etx = tx + margin; break; case "up": ety = ty - margin; break; case "down": ety = ty + margin; break; }

        // 2. Obstacles: inflated bounding boxes of ALL non-text symbols (including src and tgt)
        //    Routes must go AROUND source and target symbols; only the stub segments
        //    (port-point to exit-point) are allowed to cross the src/tgt boundary.
        var obstacles = new List<(double L, double T, double R, double B)>();
        foreach (var sym in screen.Symbols)
        {
            if (sym.Type == "text") continue;
            obstacles.Add((sym.X - pad, sym.Y - pad, sym.X + sym.Width + pad, sym.Y + sym.Height + pad));
        }

        // Hit-test helpers
        bool HitsH(double y, double x1, double x2)
        {
            double lo = Math.Min(x1, x2), hi = Math.Max(x1, x2);
            foreach (var o in obstacles)
                if (y > o.T && y < o.B && hi > o.L && lo < o.R) return true;
            return false;
        }
        bool HitsV(double x, double y1, double y2)
        {
            double lo = Math.Min(y1, y2), hi = Math.Max(y1, y2);
            foreach (var o in obstacles)
                if (x > o.L && x < o.R && hi > o.T && lo < o.B) return true;
            return false;
        }

        // Collect obstacle edges for scanning clear channels
        var edgesX = new SortedSet<double>();
        var edgesY = new SortedSet<double>();
        foreach (var o in obstacles)
        {
            edgesX.Add(o.L - 2); edgesX.Add(o.R + 2);
            edgesY.Add(o.T - 2); edgesY.Add(o.B + 2);
        }

        // Find a clear vertical channel (x-coord) between two y-values, preferring near mid
        double FindClearV(double fromX, double toX, double y1, double y2)
        {
            double mid = (fromX + toX) / 2;
            if (!HitsV(mid, y1, y2)) return mid;
            double best = mid; double bestDist = double.MaxValue;
            foreach (var cx in edgesX)
            {
                if (!HitsV(cx, y1, y2))
                {
                    double d = Math.Abs(cx - mid);
                    if (d < bestDist) { best = cx; bestDist = d; }
                }
            }
            if (bestDist < double.MaxValue) return best;
            for (double off = pad; off < 800; off += pad)
            {
                if (!HitsV(mid + off, y1, y2)) return mid + off;
                if (!HitsV(mid - off, y1, y2)) return mid - off;
            }
            return mid;
        }

        // Find a clear horizontal channel (y-coord) between two x-values, preferring near mid
        double FindClearH(double fromY, double toY, double x1, double x2)
        {
            double mid = (fromY + toY) / 2;
            if (!HitsH(mid, x1, x2)) return mid;
            double best = mid; double bestDist = double.MaxValue;
            foreach (var cy in edgesY)
            {
                if (!HitsH(cy, x1, x2))
                {
                    double d = Math.Abs(cy - mid);
                    if (d < bestDist) { best = cy; bestDist = d; }
                }
            }
            if (bestDist < double.MaxValue) return best;
            for (double off = pad; off < 800; off += pad)
            {
                if (!HitsH(mid + off, x1, x2)) return mid + off;
                if (!HitsH(mid - off, x1, x2)) return mid - off;
            }
            return mid;
        }

        bool srcH = srcDir is "left" or "right";
        bool tgtH = tgtDir is "left" or "right";
        var pts = new List<(double x, double y)> { (ex, ey) };

        if (srcH && tgtH)
        {
            double mx = FindClearV(ex, etx, Math.Min(ey, ety), Math.Max(ey, ety));
            if (!HitsH(ey, ex, mx) && !HitsH(ety, mx, etx))
            {
                pts.Add((mx, ey)); pts.Add((mx, ety));
            }
            else
            {
                // U-route: try both above and below, pick closest to exit points
                double screenH = screen.Height > 0 ? screen.Height : 800;
                double screenW = screen.Width > 0 ? screen.Width : 1400;
                double loX = Math.Min(ex, etx), hiX = Math.Max(ex, etx);
                double loY = Math.Min(ey, ety);
                double localTop = double.MaxValue, localBot = double.MinValue;
                foreach (var o in obstacles) { if (o.R > loX && o.L < hiX) { if (o.T < localTop) localTop = o.T; if (o.B > localBot) localBot = o.B; } }
                double candAbove = localTop - pad;
                double candBelow = localBot + pad;
                double distAbove = Math.Abs(candAbove - loY);
                double distBelow = Math.Abs(candBelow - loY);
                double cy1;
                if (candAbove >= 0 && candBelow <= screenH)
                    cy1 = distAbove <= distBelow ? candAbove : candBelow;
                else if (candAbove >= 0)
                    cy1 = candAbove;
                else if (candBelow <= screenH)
                    cy1 = candBelow;
                else
                    cy1 = candAbove;
                double clearY = FindClearH(cy1, cy1, loX, hiX);
                pts.Add((ex, clearY)); pts.Add((etx, clearY));
            }
        }
        else if (!srcH && !tgtH)
        {
            double my = FindClearH(Math.Min(ey, ety), Math.Max(ey, ety), Math.Min(ex, etx), Math.Max(ex, etx));
            if (!HitsV(ex, ey, my) && !HitsV(etx, my, ety))
            {
                pts.Add((ex, my)); pts.Add((etx, my));
            }
            else
            {
                double loY2 = Math.Min(ey, ety), hiY2 = Math.Max(ey, ety);
                double loX2 = Math.Min(ex, etx);
                double localLeft = double.MaxValue, localRight = double.MinValue;
                foreach (var o in obstacles) { if (o.B > loY2 && o.T < hiY2) { if (o.L < localLeft) localLeft = o.L; if (o.R > localRight) localRight = o.R; } }
                double candLeft = localLeft - pad;
                double candRight = localRight + pad;
                double sW = screen.Width > 0 ? screen.Width : 1400;
                double dL = Math.Abs(candLeft - loX2);
                double dR = Math.Abs(candRight - loX2);
                double cx1;
                if (candLeft >= 0 && candRight <= sW)
                    cx1 = dL <= dR ? candLeft : candRight;
                else if (candLeft >= 0)
                    cx1 = candLeft;
                else if (candRight <= sW)
                    cx1 = candRight;
                else
                    cx1 = candLeft;
                double clearX = FindClearV(cx1, cx1, loY2, hiY2);
                pts.Add((clearX, ey)); pts.Add((clearX, ety));
            }
        }
        else
        {
            if (srcH)
            {
                if (!HitsH(ey, ex, etx) && !HitsV(etx, ey, ety))
                    pts.Add((etx, ey));
                else if (!HitsV(ex, ey, ety) && !HitsH(ety, ex, etx))
                    pts.Add((ex, ety));
                else
                {
                    double mx = FindClearV(ex, etx, Math.Min(ey, ety), Math.Max(ey, ety));
                    pts.Add((mx, ey)); pts.Add((mx, ety));
                }
            }
            else
            {
                if (!HitsV(ex, ey, ety) && !HitsH(ety, ex, etx))
                    pts.Add((ex, ety));
                else if (!HitsH(ey, ex, etx) && !HitsV(etx, ey, ety))
                    pts.Add((etx, ey));
                else
                {
                    double my = FindClearH(ey, ety, Math.Min(ex, etx), Math.Max(ex, etx));
                    pts.Add((ex, my)); pts.Add((etx, my));
                }
            }
        }

        pts.Add((etx, ety));

        // Build SVG path
        var sb = new System.Text.StringBuilder();
        sb.Append($"M {F(sx)} {F(sy)}");
        foreach (var (px, py) in pts)
            sb.Append($" L {F(px)} {F(py)}");
        sb.Append($" L {F(tx)} {F(ty)}");
        return sb.ToString();
    }


    private static string F(double v) => v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private static double ParseDouble(string? val)
    {
        if (val != null && double.TryParse(val, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var d))
            return d;
        return 0;
    }

    private static string StripSvgWrapper(string svg)
    {
        // Return raw SVG content wrapped in a container so it renders inside the div
        return $"<svg xmlns='http://www.w3.org/2000/svg' style='width:100%;height:100%' preserveAspectRatio='xMidYMid meet'>{svg}</svg>";
    }

    // â”€â”€â”€ Binding evaluations â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    private double? ParseNumericValue(string? val)
    {
        if (val == null) return null;
        if (double.TryParse(val, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var d))
            return d;
        if (bool.TryParse(val, out var b))
            return b ? 1 : 0;
        return null;
    }

    private string EvalFillBinding(ScreenSymbol sym, string? liveValue)
    {
        if (string.IsNullOrEmpty(sym.FillBinding) || liveValue == null)
            return sym.Fill;
        try
        {
            var numVal = ParseNumericValue(liveValue);
            if (sym.FillBinding.Contains('?') && sym.FillBinding.Contains(':'))
            {
                var result = EvalSimpleCondition(sym.FillBinding, liveValue, numVal);
                if (result != null) return result;
            }
        }
        catch { }
        return sym.Fill;
    }

    private bool EvalVisibilityBinding(ScreenSymbol sym, string? liveValue)
    {
        if (string.IsNullOrEmpty(sym.VisibilityBinding) || liveValue == null)
            return true;
        try
        {
            var numVal = ParseNumericValue(liveValue);
            return EvalSimpleBool(sym.VisibilityBinding, liveValue, numVal);
        }
        catch { }
        return true;
    }

    private double EvalRotationBinding(ScreenSymbol sym, string? liveValue)
    {
        if (string.IsNullOrEmpty(sym.RotationBinding) || liveValue == null)
            return sym.Rotation;
        try
        {
            var numVal = ParseNumericValue(liveValue);
            if (numVal.HasValue)
            {
                var expr = sym.RotationBinding.Replace("value",
                    numVal.Value.ToString(System.Globalization.CultureInfo.InvariantCulture));
                if (expr.Contains('*'))
                {
                    var parts = expr.Split('*');
                    if (parts.Length == 2
                        && double.TryParse(parts[0].Trim(), System.Globalization.NumberStyles.Any,
                            System.Globalization.CultureInfo.InvariantCulture, out var a)
                        && double.TryParse(parts[1].Trim(), System.Globalization.NumberStyles.Any,
                            System.Globalization.CultureInfo.InvariantCulture, out var b))
                        return a * b;
                }
                if (double.TryParse(expr.Trim(), System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var d))
                    return d;
            }
        }
        catch { }
        return sym.Rotation;
    }

    private string? EvalLabelBinding(ScreenSymbol sym, string? liveValue)
    {
        if (string.IsNullOrEmpty(sym.LabelBinding) || liveValue == null)
            return null;
        try
        {
            if (sym.LabelBinding.Contains("value"))
            {
                var suffix = ExtractLabelSuffix(sym.LabelBinding, liveValue);
                if (suffix.Length > 0)
                    return string.Concat(liveValue, " ", suffix);
                return liveValue;
            }
        }
        catch { }
        return liveValue;
    }

    private static string ExtractLabelSuffix(string binding, string liveValue)
    {
        Span<char> buf = stackalloc char[binding.Length];
        int pos = 0;
        for (int i = 0; i < binding.Length; i++)
        {
            char c = binding[i];
            if (c == '+' || c == '\'') continue;
            buf[pos++] = c;
        }
        var cleaned = buf[..pos].Trim();
        int idx = cleaned.IndexOf("value".AsSpan(), StringComparison.Ordinal);
        if (idx >= 0)
        {
            var before = cleaned[..idx];
            var after = cleaned[(idx + 5)..];
            before.CopyTo(buf);
            after.CopyTo(buf[before.Length..]);
            cleaned = buf[..(before.Length + after.Length)];
        }
        Span<char> result = stackalloc char[cleaned.Length];
        int wp = 0;
        bool lastSpace = false;
        for (int i = 0; i < cleaned.Length; i++)
        {
            if (cleaned[i] == ' ') { if (!lastSpace) { result[wp++] = ' '; lastSpace = true; } }
            else { result[wp++] = cleaned[i]; lastSpace = false; }
        }
        return new string(result[..wp].Trim());
    }

    private string? EvalSimpleCondition(string binding, string liveValue, double? numVal)
    {
        var qIdx = binding.IndexOf('?');
        var cIdx = binding.IndexOf(':', qIdx + 1);
        if (qIdx < 0 || cIdx < 0) return null;

        // Use spans to avoid intermediate substring/trim allocations
        var bindSpan = binding.AsSpan();
        var condSpan = bindSpan[..qIdx].Trim();
        var trueSpan = TrimQuotes(bindSpan[(qIdx + 1)..cIdx].Trim());
        var falseSpan = TrimQuotes(bindSpan[(cIdx + 1)..].Trim());

        // EvalSimpleBool already accepts string but internally works on span;
        // pass the pre-trimmed condition as a string only once
        bool result = EvalSimpleBool(condSpan.ToString(), liveValue, numVal);
        // Materialize only the chosen branch
        return result ? trueSpan.ToString() : falseSpan.ToString();
    }

    private static ReadOnlySpan<char> TrimQuotes(ReadOnlySpan<char> span)
    {
        if (span.Length >= 2)
        {
            char first = span[0];
            if ((first == '\'' || first == '"' || first == ' ') && span[^1] == first)
                span = span[1..^1];
        }
        return span.Trim();
    }

    private bool EvalSimpleBool(string condition, string liveValue, double? numVal)
    {
        var span = condition.AsSpan().Trim();
        // Single-pass operator detection: scan for two-char operators first, then single-char
        int opIdx = -1;
        int opLen = 0;
        for (int i = 0; i < span.Length - 1; i++)
        {
            char c = span[i];
            char c1 = span[i + 1];
            if (c == '=' && c1 == '=') { opIdx = i; opLen = 2; break; }
            if (c == '!' && c1 == '=') { opIdx = i; opLen = 2; break; }
            if (c == '>' && c1 == '=') { opIdx = i; opLen = 2; break; }
            if (c == '<' && c1 == '=') { opIdx = i; opLen = 2; break; }
            if (opIdx < 0 && (c == '>' || c == '<')) { opIdx = i; opLen = 1; }
        }
        if (opIdx < 0) return true;

        var rightSpan = span[(opIdx + opLen)..].Trim();
        // Trim quotes from right operand
        if (rightSpan.Length >= 2 && (rightSpan[0] == '\'' || rightSpan[0] == '"') && rightSpan[^1] == rightSpan[0])
            rightSpan = rightSpan[1..^1];

        if (opLen == 2 && span[opIdx] == '=')
        {
            // == operator: string/bool/numeric equality
            if (rightSpan.Equals("true", StringComparison.OrdinalIgnoreCase))
                return liveValue.Equals("True", StringComparison.OrdinalIgnoreCase) || liveValue == "1";
            if (rightSpan.Equals("false", StringComparison.OrdinalIgnoreCase))
                return liveValue.Equals("False", StringComparison.OrdinalIgnoreCase) || liveValue == "0";
            if (numVal.HasValue && double.TryParse(rightSpan, System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var rn))
                return Math.Abs(numVal.Value - rn) < 0.0001;
            return liveValue.AsSpan().SequenceEqual(rightSpan);
        }

        // Numeric comparison operators
        if (!numVal.HasValue) return true;
        if (!double.TryParse(rightSpan, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var threshold))
            return true;

        double val = numVal.Value;
        if (opLen == 2)
        {
            return span[opIdx] switch
            {
                '!' => Math.Abs(val - threshold) > 0.0001,
                '>' => val >= threshold,
                '<' => val <= threshold,
                _ => true
            };
        }
        return span[opIdx] == '>' ? val > threshold : val < threshold;
    }

    // â”€â”€â”€ SVG text helper â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    /// <summary>
    /// Resolves the active image from an imagemap widget's entry list.
    /// Evaluates each entry's condition against the live variable value in order;
    /// returns the ImageData of the first matching entry. "*" or "" = default/fallback.
    /// </summary>
    private string? ResolveImageMap(ScreenSymbol sym, string? liveValue)
    {
        if (sym.ImageMapEntries.Count == 0) return null;

        var numVal = ParseNumericValue(liveValue);
        string? fallback = null;

        foreach (var entry in sym.ImageMapEntries)
        {
            if (string.IsNullOrEmpty(entry.ImageData)) continue;

            var cond = entry.Condition?.Trim() ?? "";
            if (cond is "" or "*")
            {
                fallback ??= entry.ImageData;
                continue;
            }

            if (liveValue == null) continue;

            try
            {
                if (EvalSimpleBool(cond, liveValue, numVal))
                    return entry.ImageData;
            }
            catch { }
        }

        return fallback ?? (sym.ImageMapEntries.FirstOrDefault(e => !string.IsNullOrEmpty(e.ImageData))?.ImageData);
    }

    private RenderFragment RenderSvgText(double x, double y, string? anchor, string? baseline,
        string fill, int fontSize, string content) => builder =>
    {
        int seq = 0;
        builder.OpenElement(seq++, "text");
        builder.AddAttribute(seq++, "x", x);
        builder.AddAttribute(seq++, "y", y);
        if (anchor != null) builder.AddAttribute(seq++, "text-anchor", anchor);
        if (baseline != null) builder.AddAttribute(seq++, "dominant-baseline", baseline);
        builder.AddAttribute(seq++, "fill", fill);
        builder.AddAttribute(seq++, "font-size", fontSize);
        builder.AddAttribute(seq++, "font-family", "sans-serif");
        builder.AddContent(seq++, content);
        builder.CloseElement();
    };

    private RenderFragment RenderSvgText(double x, double y, string? anchor, string? baseline,
        string fill, int fontSize, string content, ScreenSymbol? sym) => builder =>
    {
        int seq = 0;
        builder.OpenElement(seq++, "text");
        builder.AddAttribute(seq++, "x", x);
        builder.AddAttribute(seq++, "y", y);
        if (anchor != null) builder.AddAttribute(seq++, "text-anchor", anchor);
        if (baseline != null) builder.AddAttribute(seq++, "dominant-baseline", baseline);
        builder.AddAttribute(seq++, "fill", fill);
        builder.AddAttribute(seq++, "font-size", sym?.FontSize > 0 ? sym.FontSize : fontSize);
        builder.AddAttribute(seq++, "font-family", !string.IsNullOrEmpty(sym?.FontFamily) ? sym.FontFamily : "sans-serif");
        if (!string.IsNullOrEmpty(sym?.FontWeight)) builder.AddAttribute(seq++, "font-weight", sym.FontWeight);
        if (!string.IsNullOrEmpty(sym?.FontStyle)) builder.AddAttribute(seq++, "font-style", sym.FontStyle);
        builder.AddContent(seq++, content);
        builder.CloseElement();
    };

    // â”€â”€â”€ Library SVG symbol renderer â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    private RenderFragment RenderLibrarySvg(ScreenSymbol sym) => builder =>
    {
        var svg = sym.SvgContent ?? "";
        var viewBox = "0 0 64 64";
        var vbMatch = System.Text.RegularExpressions.Regex.Match(svg, @"viewBox\s*=\s*""([^""]+)""");
        if (vbMatch.Success) viewBox = vbMatch.Groups[1].Value;
        var innerContent = svg;
        var openTagEnd = svg.IndexOf('>');
        var closeTag = svg.LastIndexOf("</svg>", StringComparison.OrdinalIgnoreCase);
        if (openTagEnd > 0 && closeTag > openTagEnd)
            innerContent = svg[(openTagEnd + 1)..closeTag];
        int seq = 0;
        builder.OpenElement(seq++, "svg");
        builder.AddAttribute(seq++, "viewBox", viewBox);
        builder.AddAttribute(seq++, "width", sym.Width);
        builder.AddAttribute(seq++, "height", sym.Height);
        builder.AddAttribute(seq++, "overflow", "visible");
        builder.AddMarkupContent(seq++, innerContent);
        builder.CloseElement();
    };

    // â”€â”€â”€ Toggle Switch rendering â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    private RenderFragment RenderToggleSwitch(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var isOn = liveValue is "True" or "true" or "1";
        var w = sym.Width;
        var h = sym.Height;
        var r = h / 2.0;
        var knobR = r - 2;
        var onColor = sym.SwitchOnColor ?? "#34c759";
        var offColor = sym.SwitchOffColor ?? "#787880";
        var bgColor = isOn ? onColor : offColor;
        var knobCx = isOn ? (w - r) : r;

        var style = sym.SwitchStyle ?? "apple";

        // Background pill
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w);
        builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", F(r));
        builder.AddAttribute(seq++, "ry", F(r));
        builder.AddAttribute(seq++, "fill", bgColor);
        builder.AddAttribute(seq++, "style", "transition: fill 0.3s ease;");
        builder.CloseElement();

        if (style == "apple")
        {
            // Inner shadow (subtle inset)
            builder.OpenElement(seq++, "rect");
            builder.AddAttribute(seq++, "x", 1);
            builder.AddAttribute(seq++, "y", 1);
            builder.AddAttribute(seq++, "width", w - 2);
            builder.AddAttribute(seq++, "height", h - 2);
            builder.AddAttribute(seq++, "rx", F(r - 1));
            builder.AddAttribute(seq++, "ry", F(r - 1));
            builder.AddAttribute(seq++, "fill", "none");
            builder.AddAttribute(seq++, "stroke", "rgba(0,0,0,0.15)");
            builder.AddAttribute(seq++, "stroke-width", 1);
            builder.CloseElement();
        }

        // Knob
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", F(knobCx));
        builder.AddAttribute(seq++, "cy", F(r));
        builder.AddAttribute(seq++, "r", F(knobR));
        builder.AddAttribute(seq++, "fill", "white");
        builder.AddAttribute(seq++, "style",
            style == "apple"
                ? "transition: cx 0.3s ease; filter: drop-shadow(0 1px 3px rgba(0,0,0,0.3));"
                : "transition: cx 0.3s ease;");
        builder.CloseElement();
    };

    // â”€â”€â”€ Rotary Switch rendering â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    private RenderFragment RenderRotarySwitch(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var n = Math.Max(2, Math.Min(12, sym.SwitchPositions));
        var pos = (int)ParseDouble(liveValue);
        pos = Math.Max(0, Math.Min(n - 1, pos));
        var labels = (sym.SwitchPositionLabels ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries);
        var dialColor = sym.SwitchDialColor ?? "#2d2d2d";
        var knobColor = sym.SwitchKnobColor ?? "#e0e0e0";

        var size = Math.Min(sym.Width, sym.Height);
        var cx = sym.Width / 2.0;
        var cy = sym.Height / 2.0;
        var outerR = size / 2.0 - 2;
        var innerR = outerR * 0.55;

        // Outer dial
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", F(cx));
        builder.AddAttribute(seq++, "cy", F(cy));
        builder.AddAttribute(seq++, "r", F(outerR));
        builder.AddAttribute(seq++, "fill", dialColor);
        builder.AddAttribute(seq++, "stroke", "#555");
        builder.AddAttribute(seq++, "stroke-width", 1);
        builder.CloseElement();

        // Position tick marks and labels
        for (int i = 0; i < n; i++)
        {
            var angle = -150.0 + (300.0 / (n - 1)) * i;
            var rad = angle * Math.PI / 180.0;

            // Tick
            var tx1 = cx + (outerR - 2) * Math.Sin(rad);
            var ty1 = cy - (outerR - 2) * Math.Cos(rad);
            var tx2 = cx + (outerR - 7) * Math.Sin(rad);
            var ty2 = cy - (outerR - 7) * Math.Cos(rad);
            builder.OpenElement(seq++, "line");
            builder.AddAttribute(seq++, "x1", F(tx1));
            builder.AddAttribute(seq++, "y1", F(ty1));
            builder.AddAttribute(seq++, "x2", F(tx2));
            builder.AddAttribute(seq++, "y2", F(ty2));
            builder.AddAttribute(seq++, "stroke", i == pos ? "#fff" : "#aaa");
            builder.AddAttribute(seq++, "stroke-width", i == pos ? 2 : 1.5);
            builder.AddAttribute(seq++, "stroke-linecap", "round");
            builder.CloseElement();

            // Label
            var lx = cx + (outerR + 9) * Math.Sin(rad);
            var ly = cy - (outerR + 9) * Math.Cos(rad);
            var pLabel = i < labels.Length ? labels[i].Trim() : i.ToString();
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(lx));
            builder.AddAttribute(seq++, "y", F(ly + 3));
            builder.AddAttribute(seq++, "text-anchor", "middle");
            builder.AddAttribute(seq++, "dominant-baseline", "middle");
            builder.AddAttribute(seq++, "fill", i == pos ? "#fff" : "#888");
            builder.AddAttribute(seq++, "font-size", 8);
            builder.AddAttribute(seq++, "font-family", "sans-serif");
            builder.AddContent(seq++, pLabel);
            builder.CloseElement();
        }

        // Inner knob
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", F(cx));
        builder.AddAttribute(seq++, "cy", F(cy));
        builder.AddAttribute(seq++, "r", F(innerR));
        builder.AddAttribute(seq++, "fill", knobColor);
        builder.AddAttribute(seq++, "stroke", "#999");
        builder.AddAttribute(seq++, "stroke-width", 0.5);
        builder.AddAttribute(seq++, "style", "filter: drop-shadow(0 1px 2px rgba(0,0,0,0.4)); cursor: pointer;");
        builder.CloseElement();

        // Pointer line
        var posAngle = -150.0 + (300.0 / (n - 1)) * pos;
        var posRad = posAngle * Math.PI / 180.0;
        var kx = cx + innerR * 0.7 * Math.Sin(posRad);
        var ky = cy - innerR * 0.7 * Math.Cos(posRad);
        builder.OpenElement(seq++, "line");
        builder.AddAttribute(seq++, "x1", F(cx));
        builder.AddAttribute(seq++, "y1", F(cy));
        builder.AddAttribute(seq++, "x2", F(kx));
        builder.AddAttribute(seq++, "y2", F(ky));
        builder.AddAttribute(seq++, "stroke", "#333");
        builder.AddAttribute(seq++, "stroke-width", 2.5);
        builder.AddAttribute(seq++, "stroke-linecap", "round");
        builder.CloseElement();

        // Center dot
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", F(cx));
        builder.AddAttribute(seq++, "cy", F(cy));
        builder.AddAttribute(seq++, "r", 3);
        builder.AddAttribute(seq++, "fill", "#555");
        builder.CloseElement();
    };


    // â”€â”€â”€ Knob rendering â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    private RenderFragment RenderKnob(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var val = ParseDouble(liveValue);
        var min = sym.MinValue ?? 0;
        var max = sym.MaxValue ?? 100;
        var frac = (max > min) ? Math.Clamp((val - min) / (max - min), 0, 1) : 0;
        var w = sym.Width;
        var h = sym.Height;
        var size = Math.Min(w, h);
        var cx = w / 2.0;
        var cy = h / 2.0;
        var outerR = size / 2.0 - 4;
        var innerR = outerR * 0.65;
        var knobColor = sym.KnobColor ?? "#3a3a3a";
        var ptrColor = sym.KnobPointerColor ?? "#ff6b35";
        var ticks = 5;

        // Outer ring
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", F(cx));
        builder.AddAttribute(seq++, "cy", F(cy));
        builder.AddAttribute(seq++, "r", F(outerR + 2));
        builder.AddAttribute(seq++, "fill", "#1a1a1a");
        builder.AddAttribute(seq++, "stroke", "#555");
        builder.AddAttribute(seq++, "stroke-width", 1);
        builder.CloseElement();

        // Scale ticks and labels
        if (sym.KnobShowScale)
        {
            for (int i = 0; i <= ticks; i++)
            {
                var angle = -150.0 + (300.0 / ticks) * i;
                var rad = angle * Math.PI / 180.0;
                var tx1 = cx + outerR * Math.Sin(rad);
                var ty1 = cy - outerR * Math.Cos(rad);
                var tx2 = cx + (outerR - 5) * Math.Sin(rad);
                var ty2 = cy - (outerR - 5) * Math.Cos(rad);

                builder.OpenElement(seq++, "line");
                builder.AddAttribute(seq++, "x1", F(tx1));
                builder.AddAttribute(seq++, "y1", F(ty1));
                builder.AddAttribute(seq++, "x2", F(tx2));
                builder.AddAttribute(seq++, "y2", F(ty2));
                builder.AddAttribute(seq++, "stroke", "#888");
                builder.AddAttribute(seq++, "stroke-width", 1);
                builder.AddAttribute(seq++, "stroke-linecap", "round");
                builder.CloseElement();

                var tickVal = min + (max - min) / ticks * i;
                var lx = cx + (outerR + 9) * Math.Sin(rad);
                var ly = cy - (outerR + 9) * Math.Cos(rad) + 3;
                builder.OpenElement(seq++, "text");
                builder.AddAttribute(seq++, "x", F(lx));
                builder.AddAttribute(seq++, "y", F(ly));
                builder.AddAttribute(seq++, "text-anchor", "middle");
                builder.AddAttribute(seq++, "dominant-baseline", "middle");
                builder.AddAttribute(seq++, "fill", "#888");
                builder.AddAttribute(seq++, "font-size", 7);
                builder.AddContent(seq++, tickVal.ToString("F0"));
                builder.CloseElement();
            }
        }

        // Knob body
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", F(cx));
        builder.AddAttribute(seq++, "cy", F(cy));
        builder.AddAttribute(seq++, "r", F(innerR));
        builder.AddAttribute(seq++, "fill", knobColor);
        builder.AddAttribute(seq++, "stroke", "#666");
        builder.AddAttribute(seq++, "stroke-width", 0.5);
        builder.AddAttribute(seq++, "style", "filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5)); cursor: grab; pointer-events: all;");
        builder.CloseElement();

        // Pointer line
        var ptrAngle = -150.0 + 300.0 * frac;
        var ptrRad = ptrAngle * Math.PI / 180.0;
        var px = cx + innerR * 0.75 * Math.Sin(ptrRad);
        var py = cy - innerR * 0.75 * Math.Cos(ptrRad);

        builder.OpenElement(seq++, "line");
        builder.AddAttribute(seq++, "x1", F(cx));
        builder.AddAttribute(seq++, "y1", F(cy));
        builder.AddAttribute(seq++, "x2", F(px));
        builder.AddAttribute(seq++, "y2", F(py));
        builder.AddAttribute(seq++, "stroke", ptrColor);
        builder.AddAttribute(seq++, "stroke-width", 2.5);
        builder.AddAttribute(seq++, "stroke-linecap", "round");
        builder.AddAttribute(seq++, "style", "transition: x2 0.3s ease, y2 0.3s ease;");
        builder.CloseElement();

        // Center dot
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", F(cx));
        builder.AddAttribute(seq++, "cy", F(cy));
        builder.AddAttribute(seq++, "r", 3);
        builder.AddAttribute(seq++, "fill", ptrColor);
        builder.CloseElement();

        // Value readout
        if (sym.KnobShowValue)
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(cx));
            builder.AddAttribute(seq++, "y", F(h - 2));
            builder.AddAttribute(seq++, "text-anchor", "middle");
            builder.AddAttribute(seq++, "fill", "#ccc");
            builder.AddAttribute(seq++, "font-size", 9);
            builder.AddContent(seq++, val.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + (sym.KnobUnit ?? ""));
            builder.CloseElement();
        }
    };

    // â”€â”€â”€ Horizontal Slider rendering â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    private RenderFragment RenderHSlider(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var val = ParseDouble(liveValue);
        var min = sym.MinValue ?? 0;
        var max = sym.MaxValue ?? 100;
        var frac = (max > min) ? Math.Clamp((val - min) / (max - min), 0, 1) : 0;
        var w = sym.Width;
        var h = sym.Height;
        var trackH = Math.Max(4, h * 0.15);
        var trackY = h / 2.0;
        var thumbR = Math.Min(h * 0.35, 14);
        var pad = thumbR + 2;
        var trackW = w - pad * 2;
        var fillW = trackW * frac;
        var thumbX = pad + trackW * frac;
        var trackColor = sym.SliderTrackColor ?? "#444";
        var fillColor = sym.SliderFillColor ?? "#3b82f6";
        var thumbColor = sym.SliderThumbColor ?? "#ffffff";

        // Background
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w);
        builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", 6);
        builder.AddAttribute(seq++, "fill", "#1a1a2e");
        builder.AddAttribute(seq++, "stroke", sym.Stroke ?? "#334155");
        builder.AddAttribute(seq++, "stroke-width", sym.StrokeWidth);
        builder.CloseElement();

        // Track
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "x", F(pad));
        builder.AddAttribute(seq++, "y", F(trackY - trackH / 2));
        builder.AddAttribute(seq++, "width", F(trackW));
        builder.AddAttribute(seq++, "height", F(trackH));
        builder.AddAttribute(seq++, "rx", F(trackH / 2));
        builder.AddAttribute(seq++, "fill", trackColor);
        builder.CloseElement();

        // Filled portion
        if (fillW > 0)
        {
            builder.OpenElement(seq++, "rect");
            builder.AddAttribute(seq++, "x", F(pad));
            builder.AddAttribute(seq++, "y", F(trackY - trackH / 2));
            builder.AddAttribute(seq++, "width", F(fillW));
            builder.AddAttribute(seq++, "height", F(trackH));
            builder.AddAttribute(seq++, "rx", F(trackH / 2));
            builder.AddAttribute(seq++, "fill", fillColor);
            builder.AddAttribute(seq++, "style", "transition: width 0.2s ease;");
            builder.CloseElement();
        }

        // Tick marks
        if (sym.SliderShowTicks)
        {
            var numTicks = 5;
            for (int i = 0; i <= numTicks; i++)
            {
                var tx = pad + trackW / numTicks * i;
                builder.OpenElement(seq++, "line");
                builder.AddAttribute(seq++, "x1", F(tx));
                builder.AddAttribute(seq++, "y1", F(trackY + trackH / 2 + 3));
                builder.AddAttribute(seq++, "x2", F(tx));
                builder.AddAttribute(seq++, "y2", F(trackY + trackH / 2 + 7));
                builder.AddAttribute(seq++, "stroke", "#666");
                builder.AddAttribute(seq++, "stroke-width", 1);
                builder.CloseElement();
            }
        }

        // Thumb
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", F(thumbX));
        builder.AddAttribute(seq++, "cy", F(trackY));
        builder.AddAttribute(seq++, "r", F(thumbR));
        builder.AddAttribute(seq++, "fill", thumbColor);
        builder.AddAttribute(seq++, "stroke", "#ccc");
        builder.AddAttribute(seq++, "stroke-width", 0.5);
        builder.AddAttribute(seq++, "style",
            "filter: drop-shadow(0 1px 3px rgba(0,0,0,0.4)); transition: cx 0.2s ease; cursor: grab;");
        builder.CloseElement();

        // Grip lines on thumb
        for (int g = -1; g <= 1; g += 2)
        {
            builder.OpenElement(seq++, "line");
            builder.AddAttribute(seq++, "x1", F(thumbX + g * 2.5));
            builder.AddAttribute(seq++, "y1", F(trackY - 3));
            builder.AddAttribute(seq++, "x2", F(thumbX + g * 2.5));
            builder.AddAttribute(seq++, "y2", F(trackY + 3));
            builder.AddAttribute(seq++, "stroke", "#999");
            builder.AddAttribute(seq++, "stroke-width", 0.8);
            builder.CloseElement();
        }

        // Value readout
        if (sym.SliderShowValue)
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(thumbX));
            builder.AddAttribute(seq++, "y", F(trackY - thumbR - 4));
            builder.AddAttribute(seq++, "text-anchor", "middle");
            builder.AddAttribute(seq++, "fill", "#ccc");
            builder.AddAttribute(seq++, "font-size", 8);
            builder.AddContent(seq++, val.ToString("F1", System.Globalization.CultureInfo.InvariantCulture));
            builder.CloseElement();
        }
    };

    // â”€â”€â”€ Vertical Slider rendering â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    private RenderFragment RenderVSlider(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var val = ParseDouble(liveValue);
        var min = sym.MinValue ?? 0;
        var max = sym.MaxValue ?? 100;
        var frac = (max > min) ? Math.Clamp((val - min) / (max - min), 0, 1) : 0;
        var w = sym.Width;
        var h = sym.Height;
        var trackW = Math.Max(4, w * 0.15);
        var trackX = w / 2.0;
        var thumbR = Math.Min(w * 0.35, 14);
        var pad = thumbR + 2;
        var trackH = h - pad * 2;
        var fillH = trackH * frac;
        var thumbY = h - pad - trackH * frac;  // bottom = min, top = max
        var trackColor = sym.SliderTrackColor ?? "#444";
        var fillColor = sym.SliderFillColor ?? "#3b82f6";
        var thumbColor = sym.SliderThumbColor ?? "#ffffff";

        // Background
        builder.OpenElement(seq++, "rect");
