@using SharedModels
@using RuntimeViewer.Shared.Services
@implements IDisposable

@if (Screen == null)
{
    <div class="rv-empty">No screen to display.</div>
}
else if (Screen.LayoutMode == "responsive")
{
    @* ─── Responsive HTML Grid Layout ─────────────────────── *@
    <div class="rv-responsive-grid @(IsKiosk ? "rv-responsive-kiosk" : "")"
         style="background: @Screen.Background;@(string.IsNullOrEmpty(Screen.BackgroundImage) ? "" : $" background-image: url('{Screen.BackgroundImage}'); background-size: cover; background-position: center;") gap: @(Screen.GridGap)px; grid-template-columns: repeat(@Screen.GridColumns, 1fr);">
        @foreach (var sym in Screen.Symbols.OrderBy(s => s.Order))
        {
            var liveValue = Opc.GetValue(sym.VariablePath ?? "");
            var fillColor = EvalFillBinding(sym, liveValue);
            var visible = EvalVisibilityBinding(sym, liveValue);
            var labelText = EvalLabelBinding(sym, liveValue);
            var resolvedLabel = Localization.Resolve(labelText ?? sym.Label);

            if (!visible) continue;
            if (!string.IsNullOrEmpty(sym.RequiredAccess) && !Auth.HasReadAccess(sym.RequiredAccess))
                continue;

            var hasCmd = sym.Commands.Count > 0;
            var canExecute = hasCmd && Auth.HasWriteAccess(sym.RequiredAccess);
            var isLocked = hasCmd && !canExecute && !string.IsNullOrEmpty(sym.RequiredAccess);

            <div class="rv-responsive-widget @(hasCmd ? "rv-responsive-interactive" : "") @(isLocked ? "rv-responsive-locked" : "")"
                 style="grid-column: span @Math.Clamp(sym.ColSpan, 1, Screen.GridColumns); grid-row: span @Math.Max(1, sym.RowSpan); min-height: @(sym.RowHeight)px; order: @sym.Order;"
                 @onclick="() => OnSymbolClick(sym)"
                 @onmousedown="(e) => OnSymbolMouseDown(e, sym)"
                 @onmouseup="(e) => OnSymbolMouseUp(e, sym)">

                @switch (sym.Type)
                {
                    case "rect":
                        <svg viewBox="0 0 @sym.Width @sym.Height" class="rv-responsive-svg" preserveAspectRatio="xMidYMid meet">
                            <rect width="@sym.Width" height="@sym.Height" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="3" />
                        </svg>
                        break;
                    case "circle":
                        var cr = Math.Min(sym.Width, sym.Height) / 2;
                        <svg viewBox="0 0 @sym.Width @sym.Height" class="rv-responsive-svg" preserveAspectRatio="xMidYMid meet">
                            <circle cx="@F(sym.Width / 2)" cy="@F(sym.Height / 2)" r="@F(cr)" fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                        </svg>
                        break;
                    case "ellipse":
                        <svg viewBox="0 0 @sym.Width @sym.Height" class="rv-responsive-svg" preserveAspectRatio="xMidYMid meet">
                            <ellipse cx="@F(sym.Width / 2)" cy="@F(sym.Height / 2)" rx="@F(sym.Width / 2)" ry="@F(sym.Height / 2)"
                                     fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                        </svg>
                        break;
                    case "text":
                        <div class="rv-responsive-text" style="color: @fillColor;">@resolvedLabel</div>
                        break;
                    case "gauge":
                        var gaugeValStr = liveValue;
                        var gaugeNum = ParseDouble(gaugeValStr);
                        var gMin = sym.MinValue ?? 0;
                        var gMax = sym.MaxValue ?? 100;
                        var gPct = gMax > gMin ? (gaugeNum - gMin) / (gMax - gMin) * 100 : 0;
                        <div class="rv-responsive-gauge">
                            <div class="rv-responsive-gauge-bar" style="width: @F(gPct)%; background: @fillColor;"></div>
                            <span class="rv-responsive-gauge-label">@F(gaugeNum) / @gMax</span>
                        </div>
                        break;
                    case "indicator":
                        <div class="rv-responsive-indicator" style="background: @fillColor;">@resolvedLabel</div>
                        break;
                    case "svg":
                        @if (!string.IsNullOrEmpty(sym.SvgContent))
                        {
                            <div class="rv-responsive-svg-wrap">@((MarkupString)StripSvgWrapper(sym.SvgContent))</div>
                        }
                        break;
                    case "alarmlist":
                        <AlarmListWidget />
                        break;
                    case "hdachart":
                        <HdaChartWidget VariablePaths="@sym.HdaVariablePaths"
                                        TimeRangeMinutes="@sym.HdaTimeRangeMinutes"
                                        MaxPoints="@sym.HdaMaxPoints" />
                        break;
                    case "hdagrid":
                        <HdaGridWidget VariablePaths="@sym.HdaVariablePaths"
                                       TimeRangeMinutes="@sym.HdaTimeRangeMinutes"
                                       MaxPoints="@sym.HdaMaxPoints" />
                        break;
                    case "eventlog":
                        <EventLogWidget MaxRows="@sym.EventLogMaxRows"
                                        TimeRangeMinutes="@sym.EventLogTimeRangeMinutes"
                                        Categories="@sym.EventLogCategories" />
                        break;
                    case "editbox":
                        <EditBoxWidget VariablePath="@sym.VariablePath"
                                       Step="@sym.EditBoxStep"
                                       Format="@sym.EditBoxFormat"
                                       Min="@sym.MinValue"
                                       Max="@sym.MaxValue" />
                        break;
                    case "ipcamera":
                        <IpCameraWidget CameraId="@(sym.Camera?.CameraId ?? "")"
                                        ServerBaseUrl=""
                                        ShowOverlay="@(sym.Camera?.EnableYolo == true)"
                                        DetectionVariablePrefix="@(sym.Camera?.DetectionVariablePrefix ?? "")" />
                        break;
                    case "recipe":
                        var recipeVarsR = GetRecipeVariables(sym.RecipeName);
                        <RecipeWidget RecipeName="@sym.RecipeName" Variables="@recipeVarsR" />
                        break;
                    case "screenembed":
                        <ScreenEmbedWidget ScreenNames="@sym.EmbeddedScreens" />
                        break;
                    case "imagemap":
                        var imgMapSrcR = ResolveImageMap(sym, liveValue);
                        @if (!string.IsNullOrEmpty(imgMapSrcR))
                        {
                            <img src="@imgMapSrcR" style="width: 100%; height: 100%; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="rv-responsive-indicator" style="background: @fillColor;">@resolvedLabel</div>
                        }
                        break;
                    case "trend":
                        <RealtimeTrendWidget Pens="@sym.TrendPens"
                                             TimeWindowSeconds="@sym.TrendTimeWindowSeconds"
                                             ShowGrid="@sym.TrendShowGrid"
                                             ShowCursor="@sym.TrendShowCursor"
                                             ShowLegend="@sym.TrendShowLegend"
                                             YMin="@sym.TrendYMin"
                                             YMax="@sym.TrendYMax"
                                             Background="@sym.TrendBackground" />
                        break;
                }

                @if (isLocked)
                {
                    <span class="rv-responsive-lock">🔒</span>
                }
            </div>
        }
    </div>
}
else
{
    <svg xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 @Screen.Width @Screen.Height"
         width="@(IsKiosk ? null : Screen.Width)"
         height="@(IsKiosk ? null : Screen.Height)"
         preserveAspectRatio="xMidYMid meet"
         class="rv-canvas @(IsKiosk ? "rv-canvas-kiosk" : "")"
         style="background: @Screen.Background;"
         @onmouseup="OnGlobalMouseUp">

        @if (!string.IsNullOrEmpty(Screen.BackgroundImage))
        {
            <image href="@Screen.BackgroundImage" x="0" y="0"
                   width="@Screen.Width" height="@Screen.Height"
                   preserveAspectRatio="xMidYMid slice" />
        }

        @foreach (var sym in Screen.Symbols)
        {
            var liveValue = Opc.GetValue(sym.VariablePath ?? "");
            var fillColor = EvalFillBinding(sym, liveValue);
            var visible = EvalVisibilityBinding(sym, liveValue);
            var rotation = EvalRotationBinding(sym, liveValue);
            var labelText = EvalLabelBinding(sym, liveValue);

            // Resolve localized strings: labels starting with @ are string IDs
            var resolvedLabel = Localization.Resolve(labelText ?? sym.Label);

            if (!visible) continue;

            // Access-level visibility: if symbol requires access and user lacks read → hide
            if (!string.IsNullOrEmpty(sym.RequiredAccess) && !Auth.HasReadAccess(sym.RequiredAccess))
                continue;

            var hasCmd = sym.Commands.Count > 0;
            var canExecute = hasCmd && Auth.HasWriteAccess(sym.RequiredAccess);
            var isHovered = _hoveredSymbolId == sym.Id;
            var isPressed = _pressedSymbolId == sym.Id;
            var isLocked = hasCmd && !canExecute && !string.IsNullOrEmpty(sym.RequiredAccess);

            <g transform="translate(@sym.X, @sym.Y) rotate(@F(rotation), @F(sym.Width / 2), @F(sym.Height / 2))"
               class="@(hasCmd ? "rv-interactive" : "") @(isHovered && hasCmd ? "rv-hovered" : "") @(isPressed ? "rv-pressed" : "") @(isLocked ? "rv-locked" : "")"
               style="@(hasCmd ? "cursor: pointer;" : "")"
               @onmouseenter="() => OnSymbolEnter(sym)"
               @onmouseleave="() => OnSymbolLeave(sym)"
               @onmousedown="(e) => OnSymbolMouseDown(e, sym)" @onmousedown:stopPropagation
               @onmouseup="(e) => OnSymbolMouseUp(e, sym)" @onmouseup:stopPropagation
               @onclick="() => OnSymbolClick(sym)" @onclick:stopPropagation>

                @* Invisible hit area *@
                <rect width="@sym.Width" height="@sym.Height" fill="transparent" stroke="none" />

                @switch (sym.Type)
                {
                    case "rect":
                        <rect width="@sym.Width" height="@sym.Height"
                              fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="3" />
                        break;
                    case "circle":
                        var r = Math.Min(sym.Width, sym.Height) / 2;
                        <circle cx="@F(sym.Width / 2)" cy="@F(sym.Height / 2)" r="@F(r)"
                                fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                        break;
                    case "ellipse":
                        <ellipse cx="@F(sym.Width / 2)" cy="@F(sym.Height / 2)"
                                 rx="@F(sym.Width / 2)" ry="@F(sym.Height / 2)"
                                 fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                        break;
                    case "text":
                        @RenderSvgText(sym.Width / 2, sym.Height / 2 + 5, "middle", "middle", fillColor, 14, resolvedLabel)
                        break;
                    case "line":
                        <line x1="0" y1="@sym.Height" x2="@sym.Width" y2="0"
                              stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                        break;
                    case "gauge":
                        @RenderGauge(sym, fillColor, liveValue)
                        break;
                    case "indicator":
                        <circle cx="@F(sym.Width / 2)" cy="@F(sym.Height / 2)"
                                r="@F(Math.Min(sym.Width, sym.Height) / 2 - 2)"
                                fill="@fillColor" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" />
                        @RenderSvgText(sym.Width / 2, sym.Height / 2 + 4, "middle", "middle", "white", 10, resolvedLabel)
                        break;
                    case "svg":
                        @if (!string.IsNullOrEmpty(sym.SvgContent))
                        {
                            @RenderLibrarySvg(sym)
                        }
                        break;
                    case "alarmlist":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <AlarmListWidget />
                            </div>
                        </foreignObject>
                        break;
                    case "hdachart":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <HdaChartWidget VariablePaths="@sym.HdaVariablePaths"
                                                TimeRangeMinutes="@sym.HdaTimeRangeMinutes"
                                                MaxPoints="@sym.HdaMaxPoints" />
                            </div>
                        </foreignObject>
                        break;
                    case "hdagrid":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <HdaGridWidget VariablePaths="@sym.HdaVariablePaths"
                                               TimeRangeMinutes="@sym.HdaTimeRangeMinutes"
                                               MaxPoints="@sym.HdaMaxPoints" />
                            </div>
                        </foreignObject>
                        break;
                    case "eventlog":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <EventLogWidget MaxRows="@sym.EventLogMaxRows"
                                                TimeRangeMinutes="@sym.EventLogTimeRangeMinutes"
                                                Categories="@sym.EventLogCategories" />
                            </div>
                        </foreignObject>
                        break;
                    case "editbox":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <EditBoxWidget VariablePath="@sym.VariablePath"
                                               Step="@sym.EditBoxStep"
                                               Format="@sym.EditBoxFormat"
                                               Min="@sym.MinValue"
                                               Max="@sym.MaxValue" />
                            </div>
                        </foreignObject>
                        break;
                    case "ipcamera":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <IpCameraWidget CameraId="@(sym.Camera?.CameraId ?? "")"
                                                ServerBaseUrl="@(sym.Camera != null ? "" : "")"
                                                ShowOverlay="@(sym.Camera?.EnableYolo == true)"
                                                DetectionVariablePrefix="@(sym.Camera?.DetectionVariablePrefix ?? "")" />
                            </div>
                        </foreignObject>
                        break;
                    case "recipe":
                        var recipeVars = GetRecipeVariables(sym.RecipeName);
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <RecipeWidget RecipeName="@sym.RecipeName"
                                              Variables="@recipeVars" />
                            </div>
                        </foreignObject>
                        break;
                    case "screenembed":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px; overflow: hidden;">
                                <ScreenEmbedWidget ScreenNames="@sym.EmbeddedScreens" />
                            </div>
                        </foreignObject>
                        break;
                    case "imagemap":
                        var imgMapSrc = ResolveImageMap(sym, liveValue);
                        @if (!string.IsNullOrEmpty(imgMapSrc))
                        {
                            <image href="@imgMapSrc" x="0" y="0"
                                   width="@sym.Width" height="@sym.Height"
                                   preserveAspectRatio="xMidYMid meet" />
                        }
                        else
                        {
                            <rect width="@sym.Width" height="@sym.Height" fill="#1e293b" stroke="@sym.Stroke" stroke-width="@sym.StrokeWidth" rx="4" />
                            @RenderSvgText(sym.Width / 2, sym.Height / 2, "middle", "middle", "#64748b", 10, "No image")
                        }
                        break;
                    case "trend":
                        <foreignObject width="@sym.Width" height="@sym.Height">
                            <div xmlns="http://www.w3.org/1999/xhtml" style="width: @(sym.Width)px; height: @(sym.Height)px;">
                                <RealtimeTrendWidget Pens="@sym.TrendPens"
                                                     TimeWindowSeconds="@sym.TrendTimeWindowSeconds"
                                                     ShowGrid="@sym.TrendShowGrid"
                                                     ShowCursor="@sym.TrendShowCursor"
                                                     ShowLegend="@sym.TrendShowLegend"
                                                     YMin="@sym.TrendYMin"
                                                     YMax="@sym.TrendYMax"
                                                     Background="@sym.TrendBackground" />
                            </div>
                        </foreignObject>
                        break;
                }

                @if (!string.IsNullOrEmpty(resolvedLabel) && sym.Type is not "text")
                {
                    @RenderSvgText(sym.Width / 2, sym.Height + 14, "middle", null, "#333", 11, resolvedLabel)
                }

                @* Hover highlight outline *@
                @if (isHovered && hasCmd)
                {
                    <rect x="-2" y="-2" width="@(sym.Width + 4)" height="@(sym.Height + 4)"
                          fill="none" stroke="@(isLocked ? "#dc3545" : "#0d6efd")" stroke-width="2" stroke-dasharray="4,2" rx="4"
                          opacity="0.7" style="pointer-events: none;" />
                }

                @* Lock icon for symbols requiring write access the user doesn't have *@
                @if (isLocked)
                {
                    @RenderSvgText(sym.Width - 2, 12, "end", null, "#dc3545", 12, "🔒")
                }
            </g>
        }
    </svg>
}

@code {
    [Parameter] public ScreenConfig? Screen { get; set; }
    [Parameter] public bool IsKiosk { get; set; }
    [Parameter] public EventCallback OnRequestLogin { get; set; }
    [Inject] private OpcRuntimeClient Opc { get; set; } = default!;
    [Inject] private CommandService Commands { get; set; } = default!;
    [Inject] private RuntimeAuthService Auth { get; set; } = default!;
    [Inject] private LocalizationService Localization { get; set; } = default!;
    [Inject] private ProjectService Project { get; set; } = default!;

    private System.Threading.Timer? _refreshTimer;
    private string? _hoveredSymbolId;
    private string? _pressedSymbolId;

    protected override void OnInitialized()
    {
        Opc.ValuesChanged += OnValuesChanged;
        Localization.LanguageChanged += OnLanguageChanged;
        _refreshTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(StateHasChanged);
        }, null, 500, 250);
    }

    protected override void OnParametersSet()
    {
        if (Screen != null && Opc.IsConnected)
        {
            var paths = Screen.Symbols
                .Where(s => !string.IsNullOrEmpty(s.VariablePath))
                .Select(s => s.VariablePath!)
                .Distinct()
                .ToList();

            // Also monitor variables referenced by commands
            foreach (var sym in Screen.Symbols)
            {
                foreach (var cmd in sym.Commands)
                {
                    if (!string.IsNullOrEmpty(cmd.VariablePath))
                        paths.Add(cmd.VariablePath);
                }

                // Monitor recipe OPC command/status variables and recipe variable paths
                if (sym.Type == "recipe" && !string.IsNullOrEmpty(sym.RecipeName))
                {
                    var prefix = $"Recipe.{sym.RecipeName}";
                    paths.Add($"{prefix}.ActiveName");
                    paths.Add($"{prefix}.RecipeList");
                    paths.Add($"{prefix}.LastStatus");
                    paths.Add($"{prefix}.Load");
                    paths.Add($"{prefix}.Save");
                    paths.Add($"{prefix}.Activate");
                    paths.Add($"{prefix}.Delete");

                    foreach (var rv in GetRecipeVariables(sym.RecipeName))
                        paths.Add(rv.VariablePath);
                }

                // Monitor realtime trend pen variables
                if (sym.Type == "trend")
                {
                    foreach (var pen in sym.TrendPens)
                    {
                        if (!string.IsNullOrEmpty(pen.VariablePath))
                            paths.Add(pen.VariablePath);
                    }
                }
            }

            Opc.MonitorVariables(paths.Distinct());
        }
    }

    private void OnValuesChanged() { }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    // ─── Mouse interaction ──────────────────────────────────

    private void OnSymbolEnter(ScreenSymbol sym) => _hoveredSymbolId = sym.Id;
    private void OnSymbolLeave(ScreenSymbol sym)
    {
        if (_hoveredSymbolId == sym.Id) _hoveredSymbolId = null;
    }

    private async Task OnSymbolMouseDown(MouseEventArgs e, ScreenSymbol sym)
    {
        if (sym.Commands.Count > 0 && !Auth.HasWriteAccess(sym.RequiredAccess))
        {
            await OnRequestLogin.InvokeAsync();
            return;
        }

        _pressedSymbolId = sym.Id;

        foreach (var cmd in sym.Commands)
        {
            if (cmd.Trigger is "MouseDown" or "WhilePressed")
                await Commands.ExecuteAsync(cmd);
        }
    }

    private async Task OnSymbolMouseUp(MouseEventArgs e, ScreenSymbol sym)
    {
        if (sym.Commands.Count > 0 && !Auth.HasWriteAccess(sym.RequiredAccess))
            return;

        // MouseUp trigger
        foreach (var cmd in sym.Commands)
        {
            if (cmd.Trigger == "MouseUp")
                await Commands.ExecuteAsync(cmd);
        }

        // WhilePressed release
        if (_pressedSymbolId == sym.Id)
        {
            foreach (var cmd in sym.Commands)
            {
                if (cmd.Trigger == "WhilePressed")
                    await Commands.ExecuteReleaseAsync(cmd);
            }
        }

        _pressedSymbolId = null;
    }

    private async Task OnSymbolClick(ScreenSymbol sym)
    {
        if (sym.Commands.Count > 0 && !Auth.HasWriteAccess(sym.RequiredAccess))
        {
            await OnRequestLogin.InvokeAsync();
            return;
        }

        foreach (var cmd in sym.Commands)
        {
            if (cmd.Trigger == "Click")
                await Commands.ExecuteAsync(cmd);
        }
    }

    private async Task OnGlobalMouseUp(MouseEventArgs e)
    {
        // Release WhilePressed if mouse leaves the symbol area
        if (_pressedSymbolId != null && Screen != null)
        {
            var sym = Screen.Symbols.FirstOrDefault(s => s.Id == _pressedSymbolId);
            if (sym != null)
            {
                foreach (var cmd in sym.Commands)
                {
                    if (cmd.Trigger == "WhilePressed")
                        await Commands.ExecuteReleaseAsync(cmd);
                }
            }
            _pressedSymbolId = null;
        }
    }

    // ─── Formatting ─────────────────────────────────────────

    private static string F(double v) => v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private static double ParseDouble(string? val)
    {
        if (val != null && double.TryParse(val, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var d))
            return d;
        return 0;
    }

    private static string StripSvgWrapper(string svg)
    {
        // Return raw SVG content wrapped in a container so it renders inside the div
        return $"<svg xmlns='http://www.w3.org/2000/svg' style='width:100%;height:100%' preserveAspectRatio='xMidYMid meet'>{svg}</svg>";
    }

    // ─── Binding evaluations ────────────────────────────────

    private double? ParseNumericValue(string? val)
    {
        if (val == null) return null;
        if (double.TryParse(val, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var d))
            return d;
        if (bool.TryParse(val, out var b))
            return b ? 1 : 0;
        return null;
    }

    private string EvalFillBinding(ScreenSymbol sym, string? liveValue)
    {
        if (string.IsNullOrEmpty(sym.FillBinding) || liveValue == null)
            return sym.Fill;
        try
        {
            var numVal = ParseNumericValue(liveValue);
            if (sym.FillBinding.Contains('?') && sym.FillBinding.Contains(':'))
            {
                var result = EvalSimpleCondition(sym.FillBinding, liveValue, numVal);
                if (result != null) return result;
            }
        }
        catch { }
        return sym.Fill;
    }

    private bool EvalVisibilityBinding(ScreenSymbol sym, string? liveValue)
    {
        if (string.IsNullOrEmpty(sym.VisibilityBinding) || liveValue == null)
            return true;
        try
        {
            var numVal = ParseNumericValue(liveValue);
            return EvalSimpleBool(sym.VisibilityBinding, liveValue, numVal);
        }
        catch { }
        return true;
    }

    private double EvalRotationBinding(ScreenSymbol sym, string? liveValue)
    {
        if (string.IsNullOrEmpty(sym.RotationBinding) || liveValue == null)
            return sym.Rotation;
        try
        {
            var numVal = ParseNumericValue(liveValue);
            if (numVal.HasValue)
            {
                var expr = sym.RotationBinding.Replace("value",
                    numVal.Value.ToString(System.Globalization.CultureInfo.InvariantCulture));
                if (expr.Contains('*'))
                {
                    var parts = expr.Split('*');
                    if (parts.Length == 2
                        && double.TryParse(parts[0].Trim(), System.Globalization.NumberStyles.Any,
                            System.Globalization.CultureInfo.InvariantCulture, out var a)
                        && double.TryParse(parts[1].Trim(), System.Globalization.NumberStyles.Any,
                            System.Globalization.CultureInfo.InvariantCulture, out var b))
                        return a * b;
                }
                if (double.TryParse(expr.Trim(), System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var d))
                    return d;
            }
        }
        catch { }
        return sym.Rotation;
    }

    private string? EvalLabelBinding(ScreenSymbol sym, string? liveValue)
    {
        if (string.IsNullOrEmpty(sym.LabelBinding) || liveValue == null)
            return null;
        try
        {
            if (sym.LabelBinding.Contains("value"))
            {
                var result = sym.LabelBinding.Replace("value", liveValue);
                result = result.Replace("+ '", "").Replace("' +", "").Replace("'", "")
                    .Replace("+", "").Replace("  ", " ").Trim();
                if (!string.IsNullOrEmpty(result))
                    return $"{liveValue} {result.Replace(liveValue, "").Trim()}".Trim();
                return liveValue;
            }
        }
        catch { }
        return liveValue;
    }

    private string? EvalSimpleCondition(string binding, string liveValue, double? numVal)
    {
        var qIdx = binding.IndexOf('?');
        var cIdx = binding.IndexOf(':', qIdx + 1);
        if (qIdx < 0 || cIdx < 0) return null;
        var condition = binding[..qIdx].Trim();
        var trueVal = binding[(qIdx + 1)..cIdx].Trim().Trim('\'', '"', ' ');
        var falseVal = binding[(cIdx + 1)..].Trim().Trim('\'', '"', ' ');
        return EvalSimpleBool(condition, liveValue, numVal) ? trueVal : falseVal;
    }

    private bool EvalSimpleBool(string condition, string liveValue, double? numVal)
    {
        condition = condition.Trim();
        if (condition.Contains("=="))
        {
            var parts = condition.Split("==", 2);
            var right = parts[1].Trim().Trim('\'', '"');
            if (right.Equals("true", StringComparison.OrdinalIgnoreCase))
                return liveValue.Equals("True", StringComparison.OrdinalIgnoreCase) || liveValue == "1";
            if (right.Equals("false", StringComparison.OrdinalIgnoreCase))
                return liveValue.Equals("False", StringComparison.OrdinalIgnoreCase) || liveValue == "0";
            if (numVal.HasValue && double.TryParse(right, System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var rn))
                return Math.Abs(numVal.Value - rn) < 0.0001;
            return liveValue == right;
        }
        if (numVal.HasValue)
        {
            if (condition.Contains(">=")) return TryCompare(condition, ">=", numVal.Value, (a, b) => a >= b);
            if (condition.Contains("<=")) return TryCompare(condition, "<=", numVal.Value, (a, b) => a <= b);
            if (condition.Contains('>')) return TryCompare(condition, ">", numVal.Value, (a, b) => a > b);
            if (condition.Contains('<')) return TryCompare(condition, "<", numVal.Value, (a, b) => a < b);
            if (condition.Contains("!=")) return TryCompare(condition, "!=", numVal.Value, (a, b) => Math.Abs(a - b) > 0.0001);
        }
        return true;
    }

    private static bool TryCompare(string expr, string op, double value, Func<double, double, bool> compare)
    {
        var parts = expr.Split(op, 2);
        if (parts.Length == 2 && double.TryParse(parts[1].Trim(), System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var threshold))
            return compare(value, threshold);
        return true;
    }

    // ─── SVG text helper ────────────────────────────────────

    /// <summary>
    /// Resolves the active image from an imagemap widget's entry list.
    /// Evaluates each entry's condition against the live variable value in order;
    /// returns the ImageData of the first matching entry. "*" or "" = default/fallback.
    /// </summary>
    private string? ResolveImageMap(ScreenSymbol sym, string? liveValue)
    {
        if (sym.ImageMapEntries.Count == 0) return null;

        var numVal = ParseNumericValue(liveValue);
        string? fallback = null;

        foreach (var entry in sym.ImageMapEntries)
        {
            if (string.IsNullOrEmpty(entry.ImageData)) continue;

            var cond = entry.Condition?.Trim() ?? "";
            if (cond is "" or "*")
            {
                fallback ??= entry.ImageData;
                continue;
            }

            if (liveValue == null) continue;

            try
            {
                if (EvalSimpleBool(cond, liveValue, numVal))
                    return entry.ImageData;
            }
            catch { }
        }

        return fallback ?? (sym.ImageMapEntries.FirstOrDefault(e => !string.IsNullOrEmpty(e.ImageData))?.ImageData);
    }

    private RenderFragment RenderSvgText(double x, double y, string? anchor, string? baseline,
        string fill, int fontSize, string content) => builder =>
    {
        int seq = 0;
        builder.OpenElement(seq++, "text");
        builder.AddAttribute(seq++, "x", x);
        builder.AddAttribute(seq++, "y", y);
        if (anchor != null) builder.AddAttribute(seq++, "text-anchor", anchor);
        if (baseline != null) builder.AddAttribute(seq++, "dominant-baseline", baseline);
        builder.AddAttribute(seq++, "fill", fill);
        builder.AddAttribute(seq++, "font-size", fontSize);
        builder.AddAttribute(seq++, "font-family", "sans-serif");
        builder.AddContent(seq++, content);
        builder.CloseElement();
    };

    // ─── Library SVG symbol renderer ────────────────────────

    private RenderFragment RenderLibrarySvg(ScreenSymbol sym) => builder =>
    {
        var svg = sym.SvgContent ?? "";
        var viewBox = "0 0 64 64";
        var vbMatch = System.Text.RegularExpressions.Regex.Match(svg, @"viewBox\s*=\s*""([^""]+)""");
        if (vbMatch.Success) viewBox = vbMatch.Groups[1].Value;
        var innerContent = svg;
        var openTagEnd = svg.IndexOf('>');
        var closeTag = svg.LastIndexOf("</svg>", StringComparison.OrdinalIgnoreCase);
        if (openTagEnd > 0 && closeTag > openTagEnd)
            innerContent = svg[(openTagEnd + 1)..closeTag];
        int seq = 0;
        builder.OpenElement(seq++, "svg");
        builder.AddAttribute(seq++, "viewBox", viewBox);
        builder.AddAttribute(seq++, "width", sym.Width);
        builder.AddAttribute(seq++, "height", sym.Height);
        builder.AddAttribute(seq++, "overflow", "visible");
        builder.AddMarkupContent(seq++, innerContent);
        builder.CloseElement();
    };

    // ─── Gauge rendering ────────────────────────────────────

    private RenderFragment RenderGauge(ScreenSymbol sym, string fill, string? liveValue) => builder =>
    {
        var style = sym.GaugeStyle ?? "needle";
        switch (style)
        {
            case "arc": RenderGaugeArc(builder, sym, fill, liveValue); break;
            case "semicircle": RenderGaugeSemicircle(builder, sym, fill, liveValue); break;
            case "hbar": RenderGaugeHBar(builder, sym, fill, liveValue); break;
            case "vbar": RenderGaugeVBar(builder, sym, fill, liveValue); break;
            case "thermometer": RenderGaugeThermometer(builder, sym, fill, liveValue); break;
            default: RenderGaugeNeedle(builder, sym, fill, liveValue); break;
        }
    };

    private static readonly System.Globalization.CultureInfo _ci = System.Globalization.CultureInfo.InvariantCulture;

    private (double numVal, double min, double max, double pct, string valText) GaugeCalc(ScreenSymbol sym, string? liveValue)
    {
        var numVal = ParseNumericValue(liveValue) ?? 0;
        var min = sym.MinValue ?? 0;
        var max = sym.MaxValue ?? 100;
        var range = max - min;
        var pct = range > 0 ? Math.Clamp((numVal - min) / range, 0, 1) : 0;
        var fmt = string.IsNullOrEmpty(sym.GaugeValueFormat) ? "F1" : sym.GaugeValueFormat;
        var valText = numVal.ToString(fmt, _ci) + (string.IsNullOrEmpty(sym.GaugeUnit) ? "" : " " + sym.GaugeUnit);
        return (numVal, min, max, pct, valText);
    }

    // ── Needle (classic dial, 270° sweep) ───────────────────
    private void RenderGaugeNeedle(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, ScreenSymbol sym, string fill, string? liveValue)
    {
        int seq = 0;
        var (numVal, min, max, pct, valText) = GaugeCalc(sym, liveValue);
        var cx = sym.Width / 2; var cy = sym.Height / 2;
        var r = Math.Min(cx, cy) - 4;
        var trackColor = sym.GaugeTrackColor ?? "#e0e0e0";
        var needleColor = sym.GaugeNeedleColor ?? "#333333";
        var ticks = sym.GaugeTicks;

        // Background circle
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", cx); builder.AddAttribute(seq++, "cy", cy);
        builder.AddAttribute(seq++, "r", r); builder.AddAttribute(seq++, "fill", trackColor);
        builder.AddAttribute(seq++, "stroke", sym.Stroke); builder.AddAttribute(seq++, "stroke-width", sym.StrokeWidth);
        builder.CloseElement();

        // Arc progress
        var arcR = r * 0.85;
        var arcLen = pct * 270.0 / 360.0 * 2.0 * Math.PI * arcR;
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", cx); builder.AddAttribute(seq++, "cy", cy);
        builder.AddAttribute(seq++, "r", arcR); builder.AddAttribute(seq++, "fill", "none");
        builder.AddAttribute(seq++, "stroke", fill); builder.AddAttribute(seq++, "stroke-width", 4);
        builder.AddAttribute(seq++, "stroke-dasharray", $"{arcLen.ToString("F1", _ci)} 999");
        builder.AddAttribute(seq++, "transform", $"rotate(-225, {cx.ToString("F1", _ci)}, {cy.ToString("F1", _ci)})");
        builder.CloseElement();

        // Tick marks
        if (ticks > 0)
        {
            for (int i = 0; i <= ticks; i++)
            {
                var t = (double)i / ticks;
                var a = (-135 + t * 270) * Math.PI / 180;
                var x1 = cx + r * 0.92 * Math.Cos(a);
                var y1 = cy + r * 0.92 * Math.Sin(a);
                var x2 = cx + r * 1.0 * Math.Cos(a);
                var y2 = cy + r * 1.0 * Math.Sin(a);
                builder.OpenElement(seq++, "line");
                builder.AddAttribute(seq++, "x1", x1.ToString("F1", _ci)); builder.AddAttribute(seq++, "y1", y1.ToString("F1", _ci));
                builder.AddAttribute(seq++, "x2", x2.ToString("F1", _ci)); builder.AddAttribute(seq++, "y2", y2.ToString("F1", _ci));
                builder.AddAttribute(seq++, "stroke", needleColor); builder.AddAttribute(seq++, "stroke-width", 1);
                builder.CloseElement();

                if (sym.GaugeShowTickLabels)
                {
                    var tv = min + t * (max - min);
                    var lx = cx + r * 0.75 * Math.Cos(a);
                    var ly = cy + r * 0.75 * Math.Sin(a);
                    builder.OpenElement(seq++, "text");
                    builder.AddAttribute(seq++, "x", lx.ToString("F1", _ci)); builder.AddAttribute(seq++, "y", ly.ToString("F1", _ci));
                    builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
                    builder.AddAttribute(seq++, "fill", needleColor); builder.AddAttribute(seq++, "font-size", Math.Max(7, r * 0.13).ToString("F0", _ci));
                    builder.AddAttribute(seq++, "font-family", "sans-serif");
                    builder.AddContent(seq++, tv.ToString("F0", _ci));
                    builder.CloseElement();
                }
            }
        }

        // Needle
        var angle = -135 + pct * 270;
        var rad = angle * Math.PI / 180;
        var nx = cx + r * 0.7 * Math.Cos(rad);
        var ny = cy + r * 0.7 * Math.Sin(rad);
        builder.OpenElement(seq++, "line");
        builder.AddAttribute(seq++, "x1", cx); builder.AddAttribute(seq++, "y1", cy);
        builder.AddAttribute(seq++, "x2", nx.ToString("F1", _ci)); builder.AddAttribute(seq++, "y2", ny.ToString("F1", _ci));
        builder.AddAttribute(seq++, "stroke", needleColor); builder.AddAttribute(seq++, "stroke-width", 2);
        builder.CloseElement();

        // Center dot
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", cx); builder.AddAttribute(seq++, "cy", cy);
        builder.AddAttribute(seq++, "r", 3); builder.AddAttribute(seq++, "fill", needleColor);
        builder.CloseElement();

        // Value text
        if (sym.GaugeShowValue)
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", cx); builder.AddAttribute(seq++, "y", cy + r * 0.45);
            builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "fill", needleColor);
            builder.AddAttribute(seq++, "font-size", "10"); builder.AddAttribute(seq++, "font-family", "sans-serif");
            builder.AddContent(seq++, valText);
            builder.CloseElement();
        }
    }

    // ── Arc (donut ring, 270° sweep) ────────────────────────
    private void RenderGaugeArc(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, ScreenSymbol sym, string fill, string? liveValue)
    {
        int seq = 0;
        var (numVal, min, max, pct, valText) = GaugeCalc(sym, liveValue);
        var cx = sym.Width / 2; var cy = sym.Height / 2;
        var r = Math.Min(cx, cy) - 6;
        var trackColor = sym.GaugeTrackColor ?? "#e0e0e0";
        var sw = Math.Max(6, r * 0.18);

        // Track
        var trackLen = 270.0 / 360.0 * 2.0 * Math.PI * r;
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", cx); builder.AddAttribute(seq++, "cy", cy);
        builder.AddAttribute(seq++, "r", r); builder.AddAttribute(seq++, "fill", "none");
        builder.AddAttribute(seq++, "stroke", trackColor); builder.AddAttribute(seq++, "stroke-width", sw);
        builder.AddAttribute(seq++, "stroke-dasharray", $"{trackLen.ToString("F1", _ci)} 999");
        builder.AddAttribute(seq++, "stroke-linecap", "round");
        builder.AddAttribute(seq++, "transform", $"rotate(-225, {cx.ToString("F1", _ci)}, {cy.ToString("F1", _ci)})");
        builder.CloseElement();

        // Fill arc
        var fillLen = pct * trackLen;
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", cx); builder.AddAttribute(seq++, "cy", cy);
        builder.AddAttribute(seq++, "r", r); builder.AddAttribute(seq++, "fill", "none");
        builder.AddAttribute(seq++, "stroke", fill); builder.AddAttribute(seq++, "stroke-width", sw);
        builder.AddAttribute(seq++, "stroke-dasharray", $"{fillLen.ToString("F1", _ci)} 999");
        builder.AddAttribute(seq++, "stroke-linecap", "round");
        builder.AddAttribute(seq++, "transform", $"rotate(-225, {cx.ToString("F1", _ci)}, {cy.ToString("F1", _ci)})");
        builder.CloseElement();

        // Tick marks
        if (sym.GaugeTicks > 0)
        {
            for (int i = 0; i <= sym.GaugeTicks; i++)
            {
                var t = (double)i / sym.GaugeTicks;
                var a = (-135 + t * 270) * Math.PI / 180;
                var x1 = cx + (r - sw / 2 - 2) * Math.Cos(a);
                var y1 = cy + (r - sw / 2 - 2) * Math.Sin(a);
                if (sym.GaugeShowTickLabels)
                {
                    var tv = min + t * (max - min);
                    var lx = cx + (r - sw / 2 - 10) * Math.Cos(a);
                    var ly = cy + (r - sw / 2 - 10) * Math.Sin(a);
                    builder.OpenElement(seq++, "text");
                    builder.AddAttribute(seq++, "x", lx.ToString("F1", _ci)); builder.AddAttribute(seq++, "y", ly.ToString("F1", _ci));
                    builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
                    builder.AddAttribute(seq++, "fill", sym.GaugeNeedleColor ?? "#333"); builder.AddAttribute(seq++, "font-size", Math.Max(7, r * 0.12).ToString("F0", _ci));
                    builder.AddAttribute(seq++, "font-family", "sans-serif");
                    builder.AddContent(seq++, tv.ToString("F0", _ci));
                    builder.CloseElement();
                }
            }
        }

        // Center value
        if (sym.GaugeShowValue)
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", cx); builder.AddAttribute(seq++, "y", cy + 4);
            builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
            builder.AddAttribute(seq++, "fill", sym.GaugeNeedleColor ?? "#333");
            builder.AddAttribute(seq++, "font-size", Math.Max(10, r * 0.22).ToString("F0", _ci));
            builder.AddAttribute(seq++, "font-family", "sans-serif"); builder.AddAttribute(seq++, "font-weight", "bold");
            builder.AddContent(seq++, valText);
            builder.CloseElement();
        }
    }

    // ── Semicircle (180° half-circle) ───────────────────────
    private void RenderGaugeSemicircle(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, ScreenSymbol sym, string fill, string? liveValue)
    {
        int seq = 0;
        var (numVal, min, max, pct, valText) = GaugeCalc(sym, liveValue);
        var cx = sym.Width / 2; var cy = sym.Height * 0.7;
        var r = Math.Min(sym.Width / 2, sym.Height * 0.65) - 4;
        var trackColor = sym.GaugeTrackColor ?? "#e0e0e0";
        var sw = Math.Max(6, r * 0.18);
        var halfCirc = Math.PI * r;

        // Track arc (180°)
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", cx); builder.AddAttribute(seq++, "cy", cy);
        builder.AddAttribute(seq++, "r", r); builder.AddAttribute(seq++, "fill", "none");
        builder.AddAttribute(seq++, "stroke", trackColor); builder.AddAttribute(seq++, "stroke-width", sw);
        builder.AddAttribute(seq++, "stroke-dasharray", $"{halfCirc.ToString("F1", _ci)} 999");
        builder.AddAttribute(seq++, "stroke-linecap", "round");
        builder.AddAttribute(seq++, "transform", $"rotate(-180, {cx.ToString("F1", _ci)}, {cy.ToString("F1", _ci)})");
        builder.CloseElement();

        // Fill arc
        var fillLen = pct * halfCirc;
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", cx); builder.AddAttribute(seq++, "cy", cy);
        builder.AddAttribute(seq++, "r", r); builder.AddAttribute(seq++, "fill", "none");
        builder.AddAttribute(seq++, "stroke", fill); builder.AddAttribute(seq++, "stroke-width", sw);
        builder.AddAttribute(seq++, "stroke-dasharray", $"{fillLen.ToString("F1", _ci)} 999");
        builder.AddAttribute(seq++, "stroke-linecap", "round");
        builder.AddAttribute(seq++, "transform", $"rotate(-180, {cx.ToString("F1", _ci)}, {cy.ToString("F1", _ci)})");
        builder.CloseElement();

        // Tick marks
        if (sym.GaugeTicks > 0)
        {
            for (int i = 0; i <= sym.GaugeTicks; i++)
            {
                var t = (double)i / sym.GaugeTicks;
                var a = (Math.PI + t * Math.PI);
                var x1 = cx + (r + sw / 2 + 2) * Math.Cos(a);
                var y1 = cy + (r + sw / 2 + 2) * Math.Sin(a);
                var x2 = cx + (r + sw / 2 + 6) * Math.Cos(a);
                var y2 = cy + (r + sw / 2 + 6) * Math.Sin(a);
                builder.OpenElement(seq++, "line");
                builder.AddAttribute(seq++, "x1", x1.ToString("F1", _ci)); builder.AddAttribute(seq++, "y1", y1.ToString("F1", _ci));
                builder.AddAttribute(seq++, "x2", x2.ToString("F1", _ci)); builder.AddAttribute(seq++, "y2", y2.ToString("F1", _ci));
                builder.AddAttribute(seq++, "stroke", sym.GaugeNeedleColor ?? "#333"); builder.AddAttribute(seq++, "stroke-width", 1);
                builder.CloseElement();

                if (sym.GaugeShowTickLabels)
                {
                    var tv = min + t * (max - min);
                    var lx = cx + (r + sw / 2 + 14) * Math.Cos(a);
                    var ly = cy + (r + sw / 2 + 14) * Math.Sin(a);
                    builder.OpenElement(seq++, "text");
                    builder.AddAttribute(seq++, "x", lx.ToString("F1", _ci)); builder.AddAttribute(seq++, "y", ly.ToString("F1", _ci));
                    builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
                    builder.AddAttribute(seq++, "fill", sym.GaugeNeedleColor ?? "#333"); builder.AddAttribute(seq++, "font-size", Math.Max(7, r * 0.11).ToString("F0", _ci));
                    builder.AddAttribute(seq++, "font-family", "sans-serif");
                    builder.AddContent(seq++, tv.ToString("F0", _ci));
                    builder.CloseElement();
                }
            }
        }

        // Center value
        if (sym.GaugeShowValue)
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", cx); builder.AddAttribute(seq++, "y", cy - r * 0.15);
            builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
            builder.AddAttribute(seq++, "fill", sym.GaugeNeedleColor ?? "#333");
            builder.AddAttribute(seq++, "font-size", Math.Max(10, r * 0.25).ToString("F0", _ci));
            builder.AddAttribute(seq++, "font-family", "sans-serif"); builder.AddAttribute(seq++, "font-weight", "bold");
            builder.AddContent(seq++, valText);
            builder.CloseElement();
        }
    }

    // ── Horizontal bar ──────────────────────────────────────
    private void RenderGaugeHBar(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, ScreenSymbol sym, string fill, string? liveValue)
    {
        int seq = 0;
        var (numVal, min, max, pct, valText) = GaugeCalc(sym, liveValue);
        var w = sym.Width; var h = sym.Height;
        var trackColor = sym.GaugeTrackColor ?? "#e0e0e0";
        var barH = h * 0.45;
        var barY = (h - barH) / 2;

        // Track
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "x", 0); builder.AddAttribute(seq++, "y", barY);
        builder.AddAttribute(seq++, "width", w); builder.AddAttribute(seq++, "height", barH);
        builder.AddAttribute(seq++, "rx", 3); builder.AddAttribute(seq++, "fill", trackColor);
        builder.AddAttribute(seq++, "stroke", sym.Stroke); builder.AddAttribute(seq++, "stroke-width", sym.StrokeWidth);
        builder.CloseElement();

        // Fill
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "x", 0); builder.AddAttribute(seq++, "y", barY);
        builder.AddAttribute(seq++, "width", (pct * w).ToString("F1", _ci)); builder.AddAttribute(seq++, "height", barH);
        builder.AddAttribute(seq++, "rx", 3); builder.AddAttribute(seq++, "fill", fill);
        builder.CloseElement();

        // Tick marks
        if (sym.GaugeTicks > 0)
        {
            for (int i = 0; i <= sym.GaugeTicks; i++)
            {
                var t = (double)i / sym.GaugeTicks;
                var tx = t * w;
                builder.OpenElement(seq++, "line");
                builder.AddAttribute(seq++, "x1", tx.ToString("F1", _ci)); builder.AddAttribute(seq++, "y1", (barY + barH).ToString("F1", _ci));
                builder.AddAttribute(seq++, "x2", tx.ToString("F1", _ci)); builder.AddAttribute(seq++, "y2", (barY + barH + 4).ToString("F1", _ci));
                builder.AddAttribute(seq++, "stroke", sym.GaugeNeedleColor ?? "#333"); builder.AddAttribute(seq++, "stroke-width", 1);
                builder.CloseElement();

                if (sym.GaugeShowTickLabels)
                {
                    var tv = min + t * (max - min);
                    builder.OpenElement(seq++, "text");
                    builder.AddAttribute(seq++, "x", tx.ToString("F1", _ci)); builder.AddAttribute(seq++, "y", (barY + barH + 13).ToString("F1", _ci));
                    builder.AddAttribute(seq++, "text-anchor", "middle");
                    builder.AddAttribute(seq++, "fill", sym.GaugeNeedleColor ?? "#333"); builder.AddAttribute(seq++, "font-size", "8");
                    builder.AddAttribute(seq++, "font-family", "sans-serif");
                    builder.AddContent(seq++, tv.ToString("F0", _ci));
                    builder.CloseElement();
                }
            }
        }

        // Value
        if (sym.GaugeShowValue)
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", (w / 2).ToString("F1", _ci)); builder.AddAttribute(seq++, "y", (barY - 4).ToString("F1", _ci));
            builder.AddAttribute(seq++, "text-anchor", "middle");
            builder.AddAttribute(seq++, "fill", sym.GaugeNeedleColor ?? "#333");
            builder.AddAttribute(seq++, "font-size", "11"); builder.AddAttribute(seq++, "font-family", "sans-serif");
            builder.AddAttribute(seq++, "font-weight", "bold");
            builder.AddContent(seq++, valText);
            builder.CloseElement();
        }
    }

    // ── Vertical bar (bottom-up) ────────────────────────────
    private void RenderGaugeVBar(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, ScreenSymbol sym, string fill, string? liveValue)
    {
        int seq = 0;
        var (numVal, min, max, pct, valText) = GaugeCalc(sym, liveValue);
        var w = sym.Width; var h = sym.Height;
        var trackColor = sym.GaugeTrackColor ?? "#e0e0e0";
        var barW = w * 0.45;
        var barX = (w - barW) / 2;
        var fillH = pct * h;

        // Track
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "x", barX); builder.AddAttribute(seq++, "y", 0);
        builder.AddAttribute(seq++, "width", barW); builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", 3); builder.AddAttribute(seq++, "fill", trackColor);
        builder.AddAttribute(seq++, "stroke", sym.Stroke); builder.AddAttribute(seq++, "stroke-width", sym.StrokeWidth);
        builder.CloseElement();

        // Fill (bottom-up)
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "x", barX); builder.AddAttribute(seq++, "y", (h - fillH).ToString("F1", _ci));
        builder.AddAttribute(seq++, "width", barW); builder.AddAttribute(seq++, "height", fillH.ToString("F1", _ci));
        builder.AddAttribute(seq++, "rx", 3); builder.AddAttribute(seq++, "fill", fill);
        builder.CloseElement();

        // Tick marks (right side)
        if (sym.GaugeTicks > 0)
        {
            for (int i = 0; i <= sym.GaugeTicks; i++)
            {
                var t = (double)i / sym.GaugeTicks;
                var ty = h - t * h;
                builder.OpenElement(seq++, "line");
                builder.AddAttribute(seq++, "x1", (barX + barW).ToString("F1", _ci)); builder.AddAttribute(seq++, "y1", ty.ToString("F1", _ci));
                builder.AddAttribute(seq++, "x2", (barX + barW + 4).ToString("F1", _ci)); builder.AddAttribute(seq++, "y2", ty.ToString("F1", _ci));
                builder.AddAttribute(seq++, "stroke", sym.GaugeNeedleColor ?? "#333"); builder.AddAttribute(seq++, "stroke-width", 1);
                builder.CloseElement();

                if (sym.GaugeShowTickLabels)
                {
                    var tv = min + t * (max - min);
                    builder.OpenElement(seq++, "text");
                    builder.AddAttribute(seq++, "x", (barX + barW + 8).ToString("F1", _ci)); builder.AddAttribute(seq++, "y", (ty + 3).ToString("F1", _ci));
                    builder.AddAttribute(seq++, "text-anchor", "start");
                    builder.AddAttribute(seq++, "fill", sym.GaugeNeedleColor ?? "#333"); builder.AddAttribute(seq++, "font-size", "8");
                    builder.AddAttribute(seq++, "font-family", "sans-serif");
                    builder.AddContent(seq++, tv.ToString("F0", _ci));
                    builder.CloseElement();
                }
            }
        }

        // Value text (above)
        if (sym.GaugeShowValue)
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", (w / 2).ToString("F1", _ci)); builder.AddAttribute(seq++, "y", (h - fillH - 6).ToString("F1", _ci));
            builder.AddAttribute(seq++, "text-anchor", "middle");
            builder.AddAttribute(seq++, "fill", sym.GaugeNeedleColor ?? "#333");
            builder.AddAttribute(seq++, "font-size", "10"); builder.AddAttribute(seq++, "font-family", "sans-serif");
            builder.AddAttribute(seq++, "font-weight", "bold");
            builder.AddContent(seq++, valText);
            builder.CloseElement();
        }
    }

    // ── Thermometer ─────────────────────────────────────────
    private void RenderGaugeThermometer(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, ScreenSymbol sym, string fill, string? liveValue)
    {
        int seq = 0;
        var (numVal, min, max, pct, valText) = GaugeCalc(sym, liveValue);
        var w = sym.Width; var h = sym.Height;
        var trackColor = sym.GaugeTrackColor ?? "#e0e0e0";
        var tubeW = Math.Max(10, w * 0.25);
        var bulbR = tubeW * 0.9;
        var tubeX = (w - tubeW) / 2;
        var tubeTop = 4.0;
        var tubeBot = h - bulbR * 2 - 4;
        var tubeH = tubeBot - tubeTop;
        var fillH = pct * tubeH;
        var bulbCx = w / 2;
        var bulbCy = h - bulbR - 2;

        // Tube track
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "x", tubeX); builder.AddAttribute(seq++, "y", tubeTop);
        builder.AddAttribute(seq++, "width", tubeW); builder.AddAttribute(seq++, "height", tubeH);
        builder.AddAttribute(seq++, "rx", tubeW / 2); builder.AddAttribute(seq++, "fill", trackColor);
        builder.AddAttribute(seq++, "stroke", sym.Stroke); builder.AddAttribute(seq++, "stroke-width", sym.StrokeWidth);
        builder.CloseElement();

        // Tube fill (bottom-up)
        if (fillH > 0)
        {
            builder.OpenElement(seq++, "rect");
            builder.AddAttribute(seq++, "x", tubeX); builder.AddAttribute(seq++, "y", (tubeTop + tubeH - fillH).ToString("F1", _ci));
            builder.AddAttribute(seq++, "width", tubeW); builder.AddAttribute(seq++, "height", fillH.ToString("F1", _ci));
            builder.AddAttribute(seq++, "rx", tubeW / 2); builder.AddAttribute(seq++, "fill", fill);
            builder.CloseElement();
        }

        // Bulb
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", bulbCx); builder.AddAttribute(seq++, "cy", bulbCy);
        builder.AddAttribute(seq++, "r", bulbR); builder.AddAttribute(seq++, "fill", fill);
        builder.AddAttribute(seq++, "stroke", sym.Stroke); builder.AddAttribute(seq++, "stroke-width", sym.StrokeWidth);
        builder.CloseElement();

        // Tick marks (right of tube)
        if (sym.GaugeTicks > 0)
        {
            for (int i = 0; i <= sym.GaugeTicks; i++)
            {
                var t = (double)i / sym.GaugeTicks;
                var ty = tubeTop + tubeH - t * tubeH;
                builder.OpenElement(seq++, "line");
                builder.AddAttribute(seq++, "x1", (tubeX + tubeW + 1).ToString("F1", _ci)); builder.AddAttribute(seq++, "y1", ty.ToString("F1", _ci));
                builder.AddAttribute(seq++, "x2", (tubeX + tubeW + 5).ToString("F1", _ci)); builder.AddAttribute(seq++, "y2", ty.ToString("F1", _ci));
                builder.AddAttribute(seq++, "stroke", sym.GaugeNeedleColor ?? "#333"); builder.AddAttribute(seq++, "stroke-width", 1);
                builder.CloseElement();

                if (sym.GaugeShowTickLabels)
                {
                    var tv = min + t * (max - min);
                    builder.OpenElement(seq++, "text");
                    builder.AddAttribute(seq++, "x", (tubeX + tubeW + 8).ToString("F1", _ci)); builder.AddAttribute(seq++, "y", (ty + 3).ToString("F1", _ci));
                    builder.AddAttribute(seq++, "text-anchor", "start");
                    builder.AddAttribute(seq++, "fill", sym.GaugeNeedleColor ?? "#333"); builder.AddAttribute(seq++, "font-size", "8");
                    builder.AddAttribute(seq++, "font-family", "sans-serif");
                    builder.AddContent(seq++, tv.ToString("F0", _ci));
                    builder.CloseElement();
                }
            }
        }

        // Value text inside bulb
        if (sym.GaugeShowValue)
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", bulbCx); builder.AddAttribute(seq++, "y", (bulbCy + 3).ToString("F1", _ci));
            builder.AddAttribute(seq++, "text-anchor", "middle"); builder.AddAttribute(seq++, "dominant-baseline", "middle");
            builder.AddAttribute(seq++, "fill", "white");
            builder.AddAttribute(seq++, "font-size", Math.Max(8, bulbR * 0.7).ToString("F0", _ci));
            builder.AddAttribute(seq++, "font-family", "sans-serif"); builder.AddAttribute(seq++, "font-weight", "bold");
            builder.AddContent(seq++, valText);
            builder.CloseElement();
        }
    }

    private List<RecipeVariable> GetRecipeVariables(string recipeName)
    {
        if (string.IsNullOrEmpty(recipeName)) return new();
        var recipe = Project.Model?.Recipes
            .FirstOrDefault(r => r.Name.Equals(recipeName, StringComparison.OrdinalIgnoreCase));
        return recipe?.Variables ?? new();
    }

    public void Dispose()
    {
        Opc.ValuesChanged -= OnValuesChanged;
        Localization.LanguageChanged -= OnLanguageChanged;
        _refreshTimer?.Dispose();
    }
}

