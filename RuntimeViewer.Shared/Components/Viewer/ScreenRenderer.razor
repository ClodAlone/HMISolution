                        break;
                    case "button":
                        @RenderButton(sym, resolvedLabel)
                        break;
                    case "animtext":
                        @RenderAnimText(sym, resolvedLabel)
                        break;
                    case "progressbar":
                        @RenderProgressBar(sym, liveValue)
                        break;
                    case "numericdisplay":
                        @RenderNumericDisplay(sym, liveValue)
                        break;
                    case "ledarray":
                        @RenderLedArray(sym, liveValue)
                        break;
                    case "pipe":
                        @RenderPipe(sym, liveValue)
                        break;
                    case "tank":
                        @RenderTank(sym, liveValue)
                        break;
                    case "motorcontrol":
                        @RenderMotorControl(sym, liveValue)
                        break;
                    case "valve":
