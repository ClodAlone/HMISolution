        double.TryParse(liveValue, NumberStyles.Float, CultureInfo.InvariantCulture, out var flow);
        var cx = w / 2.0; var cy = h / 2.0;
        var r = Math.Min(w, h) / 2.0 - 4;

        if (sym.FlowMeterStyle == "digital")
