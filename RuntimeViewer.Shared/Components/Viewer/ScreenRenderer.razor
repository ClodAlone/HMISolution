        int.TryParse(liveValue, out var mask);

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style",
            $"width:100%;height:100%;background:#0f172a;border:1px solid {sym.Stroke ?? "#334155"};border-radius:3px;display:flex;{(isHoriz ? "flex-direction:row" : "flex-direction:column")};align-items:center;justify-content:center;gap:3px;padding:4px;");

        var ledCount = Math.Min(count, 32);
        for (var i = 0; i < ledCount; i++)
        {
            var isOn = (mask & (1 << i)) != 0;
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "style",
                $"flex:1;{(isHoriz ? "height:80%" : "width:80%")};min-{(isHoriz ? "width" : "height")}:4px;background:{(isOn ? onColor : offColor)};border-radius:2px;{(isOn ? $"box-shadow:0 0 6px {onColor};" : "")}");
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    // Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Responsive Pipe Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
    private RenderFragment RenderResponsivePipe(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var pipeColor = sym.PipeColor ?? "#64748b";
        var isHoriz = (sym.PipeOrientation ?? "horizontal") == "horizontal";
        var isCorner = (sym.PipeOrientation ?? "").StartsWith("corner");

        if (isCorner)
        {
            // For responsive mode, render an inline SVG corner inside a div
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "style", "width:100%;height:100%;display:flex;align-items:center;justify-content:center;");
            builder.OpenElement(seq++, "svg");
            builder.AddAttribute(seq++, "viewBox", "0 0 100 100");
            builder.AddAttribute(seq++, "style", "width:100%;height:100%;");
            builder.AddAttribute(seq++, "xmlns", "http://www.w3.org/2000/svg");
            var cDir = sym.PipeOrientation;
            var cThk = 30.0;
            var cMid = 15.0;
            string cPath = cDir switch
            {
                "corner-tl" => $"M 100,{F(cMid)} L {F(cMid)},{F(cMid)} L {F(cMid)},100",
                "corner-tr" => $"M 0,{F(cMid)} L {F(100 - cMid)},{F(cMid)} L {F(100 - cMid)},100",
                "corner-bl" => $"M {F(cMid)},0 L {F(cMid)},{F(100 - cMid)} L 100,{F(100 - cMid)}",
                _ =>           $"M {F(100 - cMid)},0 L {F(100 - cMid)},{F(100 - cMid)} L 0,{F(100 - cMid)}"
            };
            builder.OpenElement(seq++, "path");
            builder.AddAttribute(seq++, "d", cPath);
            builder.AddAttribute(seq++, "stroke", pipeColor);
            builder.AddAttribute(seq++, "stroke-width", F(cThk));
            builder.AddAttribute(seq++, "fill", "none");
            builder.AddAttribute(seq++, "stroke-linejoin", "round");
            builder.AddAttribute(seq++, "stroke-linecap", "round");
            builder.CloseElement();
            builder.CloseElement(); // svg
            builder.CloseElement(); // div
        }
        else
        {
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style",
            $"width:100%;height:100%;display:flex;align-items:center;justify-content:center;");

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style",
            isHoriz
                ? $"width:100%;height:60%;background:{pipeColor};border-radius:999px;position:relative;overflow:hidden;"
                : $"width:60%;height:100%;background:{pipeColor};border-radius:999px;position:relative;overflow:hidden;");

        // Highlight bar
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style",
            isHoriz
                ? "position:absolute;top:2px;left:10%;right:10%;height:25%;background:rgba(255,255,255,0.15);border-radius:2px;"
                : "position:absolute;left:2px;top:10%;bottom:10%;width:25%;background:rgba(255,255,255,0.15);border-radius:2px;");
        builder.CloseElement();

        builder.CloseElement(); // pipe body
        builder.CloseElement(); // wrapper
        }
    };

    // â”€â”€â”€ Tank rendering â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private RenderFragment RenderTank(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width;
        var h = sym.Height;
        var liquidColor = sym.TankLiquidColor ?? "#3b82f6";
        var bodyColor = sym.TankBodyColor ?? "#64748b";
        var minV = sym.MinValue ?? 0;
        var maxV = sym.MaxValue is null or 0 ? 100.0 : sym.MaxValue.Value;
        double.TryParse(liveValue, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var rawVal);
        var frac = (maxV - minV) > 0 ? Math.Clamp((rawVal - minV) / (maxV - minV), 0, 1) : 0;

        // Body
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "x", 2); builder.AddAttribute(seq++, "y", 2);
        builder.AddAttribute(seq++, "width", w - 4); builder.AddAttribute(seq++, "height", h - 4);
        builder.AddAttribute(seq++, "rx", 4);
        builder.AddAttribute(seq++, "fill", "#0f172a");
        builder.AddAttribute(seq++, "stroke", bodyColor);
        builder.AddAttribute(seq++, "stroke-width", 2);
        builder.CloseElement();

        // Liquid fill
        var fillH = (h - 8) * frac;
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "x", 4);
        builder.AddAttribute(seq++, "y", F(h - 4 - fillH));
        builder.AddAttribute(seq++, "width", w - 8);
        builder.AddAttribute(seq++, "height", F(fillH));
        builder.AddAttribute(seq++, "rx", 2);
        builder.AddAttribute(seq++, "fill", liquidColor);
        builder.AddAttribute(seq++, "opacity", "0.8");
        builder.CloseElement();

        // Level text
        if (sym.TankShowLevel)
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(w / 2.0));
            builder.AddAttribute(seq++, "y", F(h / 2.0));
            builder.AddAttribute(seq++, "text-anchor", "middle");
            builder.AddAttribute(seq++, "dominant-baseline", "middle");
            builder.AddAttribute(seq++, "fill", "#ffffff");
            builder.AddAttribute(seq++, "font-size", 12);
            builder.AddAttribute(seq++, "font-family", "system-ui, sans-serif");
            builder.AddContent(seq++, $"{frac * 100:F0}%");
            builder.CloseElement();
        }
    };

    // â”€â”€â”€ Motor Control rendering â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private RenderFragment RenderMotorControl(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width;
        var h = sym.Height;
        var isOn = liveValue is "True" or "true" or "1";
        var runColor = sym.MotorRunColor ?? "#22c55e";
        var stopColor = sym.MotorStopColor ?? "#64748b";
        var faultColor = sym.MotorFaultColor ?? "#ef4444";

        // Check fault via separate binding if available
        var isFault = false;
        if (!string.IsNullOrEmpty(sym.MotorFaultPath))
        {
            var faultVal = Opc.GetValue(sym.MotorFaultPath);
            isFault = faultVal is "True" or "true" or "1";
        }

        var color = isFault ? faultColor : isOn ? runColor : stopColor;
        var r = Math.Min(w, h) / 2.0 - 4;
        var cx = w / 2.0;
        var cy = h / 2.0;

        // Circle body
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", F(cx)); builder.AddAttribute(seq++, "cy", F(cy));
        builder.AddAttribute(seq++, "r", F(r));
        builder.AddAttribute(seq++, "fill", "#1e293b");
        builder.AddAttribute(seq++, "stroke", color);
        builder.AddAttribute(seq++, "stroke-width", 2);
        if (isOn && sym.MotorAnimateRotation && !isFault)
            builder.AddAttribute(seq++, "style", "animation: motorSpin 1s linear infinite;");
        builder.CloseElement();

        // "M" label
        builder.OpenElement(seq++, "text");
        builder.AddAttribute(seq++, "x", F(cx)); builder.AddAttribute(seq++, "y", F(cy));
        builder.AddAttribute(seq++, "text-anchor", "middle");
        builder.AddAttribute(seq++, "dominant-baseline", "middle");
        builder.AddAttribute(seq++, "fill", color);
        builder.AddAttribute(seq++, "font-size", (int)(r * 0.8));
        builder.AddAttribute(seq++, "font-weight", "bold");
        var label = (sym.MotorStyle ?? "motor") switch { "pump" => "P", "fan" => "F", _ => "M" };
        builder.AddContent(seq++, label);
        builder.CloseElement();

        // Status indicator dot
        builder.OpenElement(seq++, "circle");
        builder.AddAttribute(seq++, "cx", F(cx + r * 0.6));
        builder.AddAttribute(seq++, "cy", F(cy - r * 0.6));
        builder.AddAttribute(seq++, "r", 4);
        builder.AddAttribute(seq++, "fill", color);
        if (isFault)
            builder.AddAttribute(seq++, "style", "animation: alarmFlash 0.5s ease-in-out infinite alternate;");
        builder.CloseElement();
    };

    // â”€â”€â”€ Valve rendering â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    private RenderFragment RenderValve(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width;
        var h = sym.Height;
        var isOpen = liveValue is "True" or "true" or "1";
        var openColor = sym.ValveOpenColor ?? "#22c55e";
