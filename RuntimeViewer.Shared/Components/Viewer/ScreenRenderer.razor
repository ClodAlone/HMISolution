    // --- Conveyor rendering ---
    private RenderFragment RenderConveyor(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width; var h = sym.Height;
        var isRunning = liveValue is "1" or "true" or "True";
        var isFault = false;
        if (!string.IsNullOrEmpty(sym.ConveyorFaultPath))
        {
            var fv = Opc.GetValue(sym.ConveyorFaultPath);
            isFault = fv is "1" or "true" or "True";
        }
        var beltColor = isFault ? sym.ConveyorFaultColor : (isRunning ? sym.ConveyorRunColor : sym.ConveyorBeltColor);
        var isH = sym.ConveyorOrientation == "horizontal";

        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w); builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", 4); builder.AddAttribute(seq++, "fill", sym.ConveyorFrameColor);
        builder.AddAttribute(seq++, "stroke", "#334155"); builder.AddAttribute(seq++, "stroke-width", 1);
        builder.CloseElement();

        if (isH)
        {
            builder.OpenElement(seq++, "rect");
            builder.AddAttribute(seq++, "x", 4); builder.AddAttribute(seq++, "y", F(h * 0.2));
            builder.AddAttribute(seq++, "width", F(w - 8)); builder.AddAttribute(seq++, "height", F(h * 0.6));
            builder.AddAttribute(seq++, "rx", 2); builder.AddAttribute(seq++, "fill", beltColor);
            if (isRunning && sym.ConveyorAnimate && !isFault)
                builder.AddAttribute(seq++, "style", $"background:repeating-linear-gradient(90deg,{beltColor} 0px,{beltColor} 8px,#0002 8px,#0002 16px);animation:conveyorScroll {F(sym.ConveyorSpeed)}s linear infinite;");
            builder.CloseElement();
            // Rollers
            builder.OpenElement(seq++, "circle");
            builder.AddAttribute(seq++, "cx", 14); builder.AddAttribute(seq++, "cy", F(h / 2.0));
            builder.AddAttribute(seq++, "r", F(h * 0.22)); builder.AddAttribute(seq++, "fill", sym.ConveyorFrameColor);
            builder.AddAttribute(seq++, "stroke", "#94a3b8"); builder.AddAttribute(seq++, "stroke-width", 1.5);
            builder.CloseElement();
            builder.OpenElement(seq++, "circle");
            builder.AddAttribute(seq++, "cx", F(w - 14)); builder.AddAttribute(seq++, "cy", F(h / 2.0));
            builder.AddAttribute(seq++, "r", F(h * 0.22)); builder.AddAttribute(seq++, "fill", sym.ConveyorFrameColor);
            builder.AddAttribute(seq++, "stroke", "#94a3b8"); builder.AddAttribute(seq++, "stroke-width", 1.5);
            builder.CloseElement();
        }
        else
        {
