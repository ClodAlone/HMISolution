    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Cache-bust to ensure new JS is loaded after deployment
                var cacheBuster = DateTime.UtcNow.Ticks;
                _jsModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", $"./_content/RuntimeViewer.Shared/screenrenderer.js?v={cacheBuster}");
            }
            catch { /* JS module not available â€” slider drag disabled */ }
        }
    }


    // Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Progress Bar rendering Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
    private RenderFragment RenderProgressBar(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width;
        var h = sym.Height;
        var r = sym.ProgressBarBorderRadius;
        var trackColor = sym.ProgressBarTrackColor ?? "#2d2d2d";
        var fillColor = sym.Fill ?? "#3b82f6";
        var isVert = (sym.ProgressBarOrientation ?? "horizontal") == "vertical";
        double.TryParse(liveValue, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var rawVal);
        var minV = sym.MinValue ?? 0;
        var maxV = sym.MaxValue is null or 0 ? 100.0 : sym.MaxValue.Value;
        var pct = Math.Clamp(rawVal, minV, maxV);
        var range = maxV - minV;
        var frac = range > 0 ? (pct - minV) / range : 0;

        // Track
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w);
        builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", r);
        builder.AddAttribute(seq++, "fill", trackColor);
        builder.CloseElement();

        // Fill
        builder.OpenElement(seq++, "rect");
        if (isVert)
        {
            var fillH = h * frac;
            builder.AddAttribute(seq++, "y", F(h - fillH));
            builder.AddAttribute(seq++, "width", w);
            builder.AddAttribute(seq++, "height", F(fillH));
        }
        else
        {
            builder.AddAttribute(seq++, "width", F(w * frac));
            builder.AddAttribute(seq++, "height", h);
        }
        builder.AddAttribute(seq++, "rx", r);
        builder.AddAttribute(seq++, "fill", fillColor);
        builder.CloseElement();

        // Value text
        if (sym.ProgressBarShowValue)
        {
            var pctText = $"{frac * 100:F0}%";
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(w / 2.0));
            builder.AddAttribute(seq++, "y", F(h / 2.0 + 1));
            builder.AddAttribute(seq++, "text-anchor", "middle");
            builder.AddAttribute(seq++, "dominant-baseline", "middle");
            builder.AddAttribute(seq++, "fill", "#ffffff");
            builder.AddAttribute(seq++, "font-size", h > 20 ? 12 : 9);
            builder.AddAttribute(seq++, "font-family", "system-ui, sans-serif");
            builder.AddContent(seq++, pctText);
            builder.CloseElement();
        }
    };

    // Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Numeric Display rendering Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
    private RenderFragment RenderNumericDisplay(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width;
        var h = sym.Height;
        var bg = sym.NumericDisplayBackground ?? "#111827";
        var fmt = sym.NumericDisplayFormat ?? "F1";
        var unit = sym.NumericDisplayUnit ?? "";
        var fillColor = sym.Fill ?? "#00e5ff";
        double.TryParse(liveValue, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var val);
        var displayText = val.ToString(fmt, System.Globalization.CultureInfo.InvariantCulture);

        // Background
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w);
        builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", 4);
        builder.AddAttribute(seq++, "fill", bg);
        builder.AddAttribute(seq++, "stroke", sym.Stroke ?? "#334155");
        builder.AddAttribute(seq++, "stroke-width", sym.StrokeWidth);
        builder.CloseElement();

        // Value
        var fontSize = sym.FontSize > 0 ? sym.FontSize : (int)(h * 0.45);
        builder.OpenElement(seq++, "text");
        builder.AddAttribute(seq++, "x", F(w / 2.0));
        builder.AddAttribute(seq++, "y", F(h / 2.0 + (string.IsNullOrEmpty(unit) ? 0 : -4)));
        builder.AddAttribute(seq++, "text-anchor", "middle");
        builder.AddAttribute(seq++, "dominant-baseline", "middle");
        builder.AddAttribute(seq++, "fill", fillColor);
        builder.AddAttribute(seq++, "font-size", fontSize);
        builder.AddAttribute(seq++, "font-family", "'Courier New', monospace");
        builder.AddAttribute(seq++, "font-weight", "bold");
        builder.AddContent(seq++, displayText);
        builder.CloseElement();

        // Unit
        if (!string.IsNullOrEmpty(unit))
        {
            builder.OpenElement(seq++, "text");
            builder.AddAttribute(seq++, "x", F(w / 2.0));
            builder.AddAttribute(seq++, "y", F(h - 6));
            builder.AddAttribute(seq++, "text-anchor", "middle");
            builder.AddAttribute(seq++, "fill", "#94a3b8");
            builder.AddAttribute(seq++, "font-size", 10);
            builder.AddAttribute(seq++, "font-family", "system-ui, sans-serif");
            builder.AddContent(seq++, unit);
            builder.CloseElement();
        }
    };

    // Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ LED Array rendering Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
    private RenderFragment RenderLedArray(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width;
        var h = sym.Height;
        var count = sym.LedArrayCount > 0 ? sym.LedArrayCount : 8;
        var onColor = sym.LedArrayOnColor ?? "#22c55e";
        var offColor = sym.LedArrayOffColor ?? "#1e293b";
        var isHoriz = (sym.LedArrayOrientation ?? "horizontal") == "horizontal";

        int.TryParse(liveValue, out var mask);

        // Background
        builder.OpenElement(seq++, "rect");
        builder.AddAttribute(seq++, "width", w);
        builder.AddAttribute(seq++, "height", h);
        builder.AddAttribute(seq++, "rx", 3);
        builder.AddAttribute(seq++, "fill", "#0f172a");
        builder.AddAttribute(seq++, "stroke", sym.Stroke ?? "#334155");
        builder.AddAttribute(seq++, "stroke-width", sym.StrokeWidth);
        builder.CloseElement();

        var ledCount = Math.Min(count, 32);
        for (var i = 0; i < ledCount; i++)
        {
            var isOn = (mask & (1 << i)) != 0;
            builder.OpenElement(seq++, "rect");
            if (isHoriz)
            {
                var lw = (w - 8.0) / ledCount - 2;
                var lx = 4 + i * ((w - 8.0) / ledCount);
                builder.AddAttribute(seq++, "x", F(lx));
                builder.AddAttribute(seq++, "y", 4);
                builder.AddAttribute(seq++, "width", F(Math.Max(lw, 2)));
                builder.AddAttribute(seq++, "height", F(h - 8));
            }
            else
            {
                var lh = (h - 8.0) / ledCount - 2;
                var ly = 4 + i * ((h - 8.0) / ledCount);
                builder.AddAttribute(seq++, "x", 4);
                builder.AddAttribute(seq++, "y", F(ly));
                builder.AddAttribute(seq++, "width", F(w - 8));
                builder.AddAttribute(seq++, "height", F(Math.Max(lh, 2)));
            }
            builder.AddAttribute(seq++, "rx", 2);
            builder.AddAttribute(seq++, "fill", isOn ? onColor : offColor);
            if (isOn) builder.AddAttribute(seq++, "style", $"filter: drop-shadow(0 0 3px {onColor});");
            builder.CloseElement();
        }
    };

    // Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Pipe rendering Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
    private RenderFragment RenderPipe(ScreenSymbol sym, string? liveValue) => builder =>
    {
        int seq = 0;
        var w = sym.Width;
        var h = sym.Height;
        var pipeColor = sym.PipeColor ?? "#64748b";
        var flowColor = sym.PipeFlowColor ?? "#94a3b8";
        var showFlow = sym.PipeShowFlow;
        var speed = sym.PipeFlowSpeed > 0 ? sym.PipeFlowSpeed : 1;
        var isHoriz = (sym.PipeOrientation ?? "horizontal") == "horizontal";
        var isCorner = (sym.PipeOrientation ?? "").StartsWith("corner");

        // Check if flow should be active from bound variable
        bool flowActive = showFlow;
        if (!string.IsNullOrEmpty(liveValue))
        {
            flowActive = showFlow && liveValue is not "0" and not "false" and not "False";
        }

        if (isCorner)
        {
            var cornerDir = sym.PipeOrientation ?? "corner-tl";
            var cThk = Math.Min(w, h) * 0.3;
            var cMid = cThk / 2;
            string pathD = cornerDir switch
            {
                "corner-tl" => $"M {F(w)},{F(cMid)} L {F(cMid)},{F(cMid)} L {F(cMid)},{F(h)}",
                "corner-tr" => $"M 0,{F(cMid)} L {F(w - cMid)},{F(cMid)} L {F(w - cMid)},{F(h)}",
                "corner-bl" => $"M {F(cMid)},0 L {F(cMid)},{F(h - cMid)} L {F(w)},{F(h - cMid)}",
                _ =>           $"M {F(w - cMid)},0 L {F(w - cMid)},{F(h - cMid)} L 0,{F(h - cMid)}"
            };
            // Corner pipe body
            builder.OpenElement(seq++, "path");
            builder.AddAttribute(seq++, "d", pathD);
            builder.AddAttribute(seq++, "stroke", pipeColor);
            builder.AddAttribute(seq++, "stroke-width", F(cThk));
            builder.AddAttribute(seq++, "fill", "none");
            builder.AddAttribute(seq++, "stroke-linejoin", "round");
            builder.AddAttribute(seq++, "stroke-linecap", "round");
            builder.CloseElement();
            // Highlight along the outer edge
            var hlThk = cThk * 0.25;
            var hlOff = cThk * 0.35;
            string hlD = cornerDir switch
            {
                "corner-tl" => $"M {F(w)},{F(cMid - hlOff)} L {F(cMid - hlOff)},{F(cMid - hlOff)} L {F(cMid - hlOff)},{F(h)}",
                "corner-tr" => $"M 0,{F(cMid - hlOff)} L {F(w - cMid + hlOff)},{F(cMid - hlOff)} L {F(w - cMid + hlOff)},{F(h)}",
                "corner-bl" => $"M {F(cMid - hlOff)},0 L {F(cMid - hlOff)},{F(h - cMid + hlOff)} L {F(w)},{F(h - cMid + hlOff)}",
                _ =>           $"M {F(w - cMid + hlOff)},0 L {F(w - cMid + hlOff)},{F(h - cMid + hlOff)} L 0,{F(h - cMid + hlOff)}"
            };
            builder.OpenElement(seq++, "path");
            builder.AddAttribute(seq++, "d", hlD);
            builder.AddAttribute(seq++, "stroke", "rgba(255,255,255,0.15)");
            builder.AddAttribute(seq++, "stroke-width", F(hlThk));
            builder.AddAttribute(seq++, "fill", "none");
            builder.AddAttribute(seq++, "stroke-linejoin", "round");
            builder.AddAttribute(seq++, "stroke-linecap", "round");
            builder.CloseElement();
            // Flow stripes along corner path
            if (flowActive)
            {
                var animDur = $"{F(speed)}s";
                builder.OpenElement(seq++, "path");
                builder.AddAttribute(seq++, "d", pathD);
                builder.AddAttribute(seq++, "stroke", flowColor);
                builder.AddAttribute(seq++, "stroke-width", 2);
                builder.AddAttribute(seq++, "fill", "none");
                builder.AddAttribute(seq++, "stroke-dasharray", "6,4");
                builder.AddAttribute(seq++, "stroke-linejoin", "round");
                builder.AddAttribute(seq++, "style", $"animation: pipeFlow {animDur} linear infinite;");
                builder.CloseElement();
            }
        }
        else if (isHoriz)
        {
            var pipeH = h * 0.6;
            var pipeY = (h - pipeH) / 2;
            // Pipe body
            builder.OpenElement(seq++, "rect");
            builder.AddAttribute(seq++, "x", 0);
            builder.AddAttribute(seq++, "y", F(pipeY));
            builder.AddAttribute(seq++, "width", w);
            builder.AddAttribute(seq++, "height", F(pipeH));
            builder.AddAttribute(seq++, "rx", F(pipeH / 2));
            builder.AddAttribute(seq++, "fill", pipeColor);
            builder.CloseElement();

            // Highlight
            builder.OpenElement(seq++, "rect");
            builder.AddAttribute(seq++, "x", F(pipeH / 2));
            builder.AddAttribute(seq++, "y", F(pipeY + 2));
            builder.AddAttribute(seq++, "width", F(w - pipeH));
            builder.AddAttribute(seq++, "height", F(pipeH * 0.25));
            builder.AddAttribute(seq++, "rx", 2);
            builder.AddAttribute(seq++, "fill", "rgba(255,255,255,0.15)");
            builder.CloseElement();

            // Flow stripes
            if (flowActive)
            {
                var animDur = $"{F(speed)}s";
                for (var i = 0; i < 5; i++)
                {
                    var sx = w * 0.1 + i * w * 0.2;
                    builder.OpenElement(seq++, "line");
                    builder.AddAttribute(seq++, "x1", F(sx));
                    builder.AddAttribute(seq++, "y1", F(pipeY + pipeH * 0.3));
                    builder.AddAttribute(seq++, "x2", F(sx + w * 0.08));
                    builder.AddAttribute(seq++, "y2", F(pipeY + pipeH * 0.3));
                    builder.AddAttribute(seq++, "stroke", flowColor);
                    builder.AddAttribute(seq++, "stroke-width", 2);
                    builder.AddAttribute(seq++, "stroke-dasharray", "6,4");
                    builder.AddAttribute(seq++, "style", $"animation: pipeFlow {animDur} linear infinite;");
                    builder.CloseElement();
                }
            }
        }
        else
        {
            var pipeW = w * 0.6;
            var pipeX = (w - pipeW) / 2;
            // Pipe body
            builder.OpenElement(seq++, "rect");
            builder.AddAttribute(seq++, "x", F(pipeX));
            builder.AddAttribute(seq++, "y", 0);
            builder.AddAttribute(seq++, "width", F(pipeW));
            builder.AddAttribute(seq++, "height", h);
            builder.AddAttribute(seq++, "rx", F(pipeW / 2));
            builder.AddAttribute(seq++, "fill", pipeColor);
            builder.CloseElement();

            // Highlight
            builder.OpenElement(seq++, "rect");
            builder.AddAttribute(seq++, "x", F(pipeX + 2));
            builder.AddAttribute(seq++, "y", F(pipeW / 2));
            builder.AddAttribute(seq++, "width", F(pipeW * 0.25));
            builder.AddAttribute(seq++, "height", F(h - pipeW));
            builder.AddAttribute(seq++, "rx", 2);
            builder.AddAttribute(seq++, "fill", "rgba(255,255,255,0.15)");
            builder.CloseElement();

            // Flow stripes
            if (flowActive)
            {
                var animDur = $"{F(speed)}s";
                for (var i = 0; i < 5; i++)
                {
                    var sy = h * 0.1 + i * h * 0.2;
                    builder.OpenElement(seq++, "line");
                    builder.AddAttribute(seq++, "x1", F(pipeX + pipeW * 0.3));
                    builder.AddAttribute(seq++, "y1", F(sy));
                    builder.AddAttribute(seq++, "x2", F(pipeX + pipeW * 0.3));
                    builder.AddAttribute(seq++, "y2", F(sy + h * 0.08));
                    builder.AddAttribute(seq++, "stroke", flowColor);
                    builder.AddAttribute(seq++, "stroke-width", 2);
                    builder.AddAttribute(seq++, "stroke-dasharray", "6,4");
                    builder.AddAttribute(seq++, "style", $"animation: pipeFlowV {animDur} linear infinite;");
                    builder.CloseElement();
                }
            }
        }
    };

    // Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Responsive Progress Bar Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
