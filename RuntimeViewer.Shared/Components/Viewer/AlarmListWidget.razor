@using SharedModels
@using RuntimeViewer.Shared.Services
@implements IDisposable

<div class="@(_palette is null ? "alarm-list-widget" : "alarm-list-widget wt-panel")" style="width: 100%; height: 100%; display: flex; flex-direction: column; font-family: var(--widget-font-family, sans-serif); font-size: var(--widget-font-size, 11px); font-weight: var(--widget-font-weight, normal); font-style: var(--widget-font-style, normal); background: var(--alarm-bg, #1a1a2e); color: var(--alarm-text, #e0e0e0); border: 1px solid var(--alarm-border, #333); border-radius: @C("4px", _ => "10px"); overflow: hidden;@C("", p => $" box-shadow: {p.Shadow};")">
    @* Toolbar *@
    <div class="@(_palette is null ? null : "wt-toolbar")" style="display: flex; gap: 4px; align-items: center; padding: @C("4px 6px", _ => "6px 8px"); background: var(--alarm-header-bg, #16213e); border-bottom: 1px solid var(--alarm-border, #333); flex-shrink: 0; flex-wrap: wrap;">
        <span style="font-weight: bold; font-size: 1.1em;">🔔 Alarms</span>
        <span class="@(_palette is null ? null : "wt-count")" style="font-size: 0.9em; color: @C("#888", p => p.Muted);">(@_alarms.Count)</span>
        <span style="flex: 1;"></span>
        <button class="alarm-btn" @onclick="RefreshAlarms" disabled="@IsBusy" title="Refresh alarms">🔄</button>
        <span style="width: 1px; height: 14px; background: @C("#444", p => p.Border);"></span>
        <button class="alarm-btn" @onclick="AckSelected" disabled="@(!HasSelected || IsBusy)" title="Acknowledge selected">✔ Ack</button>
        <button class="alarm-btn" @onclick="ConfirmSelected" disabled="@(!HasSelected || IsBusy)" title="Confirm/Reset selected">✔✔ Reset</button>
        <span style="width: 1px; height: 14px; background: @C("#444", p => p.Border);"></span>
        <button class="alarm-btn" @onclick="ShowShelveDialog" disabled="@(!HasSelected || IsBusy)" title="Shelve selected alarms">🔇 Shelve</button>
        <button class="alarm-btn" @onclick="UnshelveSelected" disabled="@(!HasShelvedSelected || IsBusy)" title="Unshelve selected alarms">🔔 Unshelve</button>
        <span style="width: 1px; height: 14px; background: @C("#444", p => p.Border);"></span>
        <button class="alarm-btn alarm-btn-danger" @onclick="AckAll" disabled="@(_alarms.Count == 0 || IsBusy)" title="Acknowledge all">✔ Ack All</button>
        <button class="alarm-btn alarm-btn-danger" @onclick="ConfirmAll" disabled="@(_alarms.Count == 0 || IsBusy)" title="Confirm/Reset all">✔✔ Reset All</button>
    </div>

    @* Shelve duration dialog *@
    @if (_showShelveDialog)
    {
        <div style="display: flex; align-items: center; gap: 6px; padding: 4px 8px; background: @C("#1e2a4a", p => p.Header); border-bottom: 1px solid @C("#444", p => p.Border); flex-shrink: 0;">
            <span style="font-size: 1em; color: @C("#aaa", p => p.Muted);">Shelve for:</span>
            <select @bind="_shelveDurationMinutes" style="background: @C("#2a2a4a", p => p.Button); color: @C("#e0e0e0", p => p.Text); border: 1px solid @C("#555", p => p.Border); border-radius: @C("3px", _ => "6px"); padding: 2px 4px; font-size: 1em;">
                <option value="15">15 min</option>
                <option value="30">30 min</option>
                <option value="60">1 hour</option>
                <option value="120">2 hours</option>
                <option value="480">8 hours</option>
                <option value="1440">24 hours</option>
            </select>
            <button class="alarm-btn" @onclick="ShelveSelected" disabled="@(!HasSelected || IsBusy)" style="background: #4a3a00; color: #ffc107;">🔇 Confirm Shelve</button>
            <button class="alarm-btn" @onclick="() => _showShelveDialog = false">✕ Cancel</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage ?? _refreshError))
    {
        <div role="alert" style="padding: 6px 8px; color: #ff8a80;">@(_errorMessage ?? _refreshError)</div>
    }

    @* Table *@
    <div style="flex: 1; overflow-y: auto;">
        @if (_loading)
        {
            <div style="text-align: center; padding: 20px; color: @C("#888", p => p.Muted);">
                <span>⏳ Loading alarms…</span>
            </div>
        }
        else if (_alarms.Count == 0)
        {
            <div class="@(_palette is null ? null : "wt-empty")" style="text-align: center; padding: 20px; color: @C("#888", p => p.Muted);">
                <span>✅ No active alarms</span>
            </div>
        }
        else
        {
            <table class="alarm-table">
                <thead>
                    <tr>
                        <th style="width: 28px;">
                            <input type="checkbox" @onchange="ToggleAll" checked="@AllSelected" title="Select all" />
                        </th>
                        <th style="width: 50px;">Severity</th>
                        <th>Source</th>
                        <th>Message</th>
                        <th style="width: 55px;">State</th>
                        <th style="width: 130px;">Time</th>
                        <th style="width: 40px;">Ack</th>
                        <th style="width: 40px;">Cfm</th>
                        <th style="width: 55px;">Shelved</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alarm in _alarms)
                    {
                        var a = alarm;
                        var severityClass = GetSeverityClass(a.Severity);
                        var shelvedClass = a.IsShelved ? "alarm-shelved" : "";
                        <tr @key="a.ConditionId" class="@severityClass @shelvedClass @(a.IsSelected ? "alarm-selected" : "") @(!a.IsAcked ? "alarm-unacked" : "") @(!a.IsActive ? "alarm-inactive" : "")" @onclick="() => ToggleSelection(a)">
                            <td @onclick:stopPropagation>
                                <input type="checkbox" checked="@a.IsSelected" @onchange="() => ToggleSelection(a)" />
                            </td>
                            <td><span class="alarm-sev @severityClass">@a.Severity</span></td>
                            <td class="alarm-source">@a.SourceName</td>
                            <td>@a.Message</td>
                            <td>
                                @if (a.IsActive)
                                {
                                    <span class="alarm-state-active" title="Condition is currently active">🔴 Active</span>
                                }
                                else
                                {
                                    <span class="alarm-state-inactive" title="Condition has returned to normal">⚪ Normal</span>
                                }
                            </td>
                            <td class="alarm-time">@a.Time.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@(a.IsAcked ? "✔" : "—")</td>
                            <td>@(a.IsConfirmed ? "✔" : "—")</td>
                            <td>
                                @if (a.IsShelved)
                                {
                                    <span title="Temporarily shelved" style="color: #ffc107;">🔇</span>
                                }
                                else
                                {
                                    <span style="color: @C("#555", p => p.Muted);">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    .alarm-shelved {
        opacity: 0.55;
        background: repeating-linear-gradient(
            -45deg,
            transparent,
            transparent 8px,
            rgba(255, 193, 7, 0.06) 8px,
            rgba(255, 193, 7, 0.06) 16px
        ) !important;
    }
    .alarm-shelved td {
        font-style: italic;
    }
    .alarm-state-active {
        color: #ff5252;
        font-weight: bold;
    }
    .alarm-state-inactive {
        color: #888;
    }
    .alarm-inactive {
        opacity: 0.75;
    }
</style>

@code {
    [Inject] private OpcRuntimeClient Opc { get; set; } = default!;

    /// <summary>Widget theme (ScreenSymbol.WidgetTheme). "classic" keeps the legacy look.</summary>
    [Parameter] public string Theme { get; set; } = WidgetThemes.Classic;

    private WidgetPalette? _palette => WidgetThemes.GetPalette(Theme);
    private string C(string classic, Func<WidgetPalette, string> themed) => WidgetThemes.Pick(_palette, classic, themed);

    private List<AlarmEntry> _alarms = new();
    private bool _loading;
    private System.Threading.Timer? _refreshTimer;
    private bool _showShelveDialog;
    private int _shelveDurationMinutes = 60;
    private bool _refreshing;
    private bool _actionInProgress;
    private string? _errorMessage;
    private string? _refreshError;
    private bool IsBusy => _loading || _refreshing || _actionInProgress;

    private bool HasSelected => _alarms.Any(a => a.IsSelected);
    private bool HasShelvedSelected => _alarms.Any(a => a.IsSelected && a.IsShelved);
    private bool AllSelected => _alarms.Count > 0 && _alarms.All(a => a.IsSelected);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAlarms();
        // Auto-refresh every 5 seconds
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshAlarms();
                StateHasChanged();
            });
        }, null, 5000, 5000);
    }

    private bool _initialLoadDone;

    private async Task RefreshAlarms()
    {
        if (_refreshing || _actionInProgress) return;
        _refreshing = true;
        try
        {
            if (!_initialLoadDone) { _loading = true; StateHasChanged(); }
            var fresh = await Opc.CollectDetailedAlarmsAsync();

            var selectedIds = _alarms.Where(a => a.IsSelected).Select(a => a.ConditionId).ToHashSet();
            foreach (var a in fresh)
                a.IsSelected = selectedIds.Contains(a.ConditionId);

            _alarms = fresh;
            _initialLoadDone = true;
            _refreshError = null;
        }
        catch (Exception ex)
        {
            _refreshError = $"Unable to refresh alarms: {ex.Message}";
        }
        finally
        {
            _loading = false;
            _refreshing = false;
        }
    }

    private void ToggleSelection(AlarmEntry alarm)
    {
        if (!IsBusy) alarm.IsSelected = !alarm.IsSelected;
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if (IsBusy) return;
        var check = e.Value is true;
        foreach (var a in _alarms) a.IsSelected = check;
    }

    private Task AckSelected() => RunAlarmActionAsync("Ack", _alarms.Where(a => a.IsSelected && !a.IsAcked),
        a => Opc.AcknowledgeAlarmAsync(a.ConditionId, a.EventId));

    private Task ConfirmSelected() => RunAlarmActionAsync("Reset", _alarms.Where(a => a.IsSelected && !a.IsConfirmed),
        a => Opc.ConfirmAlarmAsync(a.ConditionId, a.EventId));

    private Task AckAll() => RunAlarmActionAsync("Ack", _alarms.Where(a => !a.IsAcked),
        a => Opc.AcknowledgeAlarmAsync(a.ConditionId, a.EventId));

    private Task ConfirmAll() => RunAlarmActionAsync("Reset", _alarms.Where(a => !a.IsConfirmed),
        a => Opc.ConfirmAlarmAsync(a.ConditionId, a.EventId));

    private void ShowShelveDialog()
    {
        _showShelveDialog = true;
    }

    private Task ShelveSelected()
    {
        _showShelveDialog = false;
        return RunAlarmActionAsync("Shelve", _alarms.Where(a => a.IsSelected && !a.IsShelved),
            a => Opc.ShelveAlarmAsync(a.ConditionId, _shelveDurationMinutes));
    }

    private Task UnshelveSelected() => RunAlarmActionAsync("Unshelve", _alarms.Where(a => a.IsSelected && a.IsShelved),
        a => Opc.UnshelveAlarmAsync(a.ConditionId));

    private async Task RunAlarmActionAsync(string name, IEnumerable<AlarmEntry> alarms, Func<AlarmEntry, Task<bool>> action)
    {
        if (IsBusy) return;
        var targets = alarms.ToList();
        _actionInProgress = true;
        _errorMessage = null;
        var failures = new List<string>();
        try
        {
            foreach (var alarm in targets)
            {
                if (!await action(alarm))
                    failures.Add($"{alarm.SourceName}: {Opc.AlarmErrorMessage ?? "Server rejected the operation."}");
            }
            if (failures.Count > 0)
                _errorMessage = $"{name} failed for {failures.Count} alarm(s). {string.Join(" ", failures)}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"{name} failed: {ex.Message}";
        }
        finally
        {
            _actionInProgress = false;
        }
        await RefreshAlarms();
    }

    private static string GetSeverityClass(string severity)
    {
        if (int.TryParse(severity, out var sev))
        {
            return sev switch
            {
                >= 900 => "alarm-critical",
                >= 500 => "alarm-high",
                >= 200 => "alarm-medium",
                _ => "alarm-low"
            };
        }
        return "alarm-low";
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}