@using SharedModels
@using RuntimeViewer.Shared.Services
@implements IDisposable

<div class="alarm-list-widget" style="width: 100%; height: 100%; display: flex; flex-direction: column; font-family: var(--widget-font-family, sans-serif); font-size: var(--widget-font-size, 11px); font-weight: var(--widget-font-weight, normal); font-style: var(--widget-font-style, normal); background: var(--alarm-bg, #1a1a2e); color: var(--alarm-text, #e0e0e0); border: 1px solid var(--alarm-border, #333); border-radius: 4px; overflow: hidden;">
    @* Toolbar *@
    <div style="display: flex; gap: 4px; align-items: center; padding: 4px 6px; background: var(--alarm-header-bg, #16213e); border-bottom: 1px solid var(--alarm-border, #333); flex-shrink: 0; flex-wrap: wrap;">
        <span style="font-weight: bold; font-size: 12px;">🔔 Alarms</span>
        <span style="font-size: 10px; color: #888;">(@_alarms.Count)</span>
        <span style="flex: 1;"></span>
        <button class="alarm-btn" @onclick="RefreshAlarms" disabled="@_loading" title="Refresh alarms">🔄</button>
        <span style="width: 1px; height: 14px; background: #444;"></span>
        <button class="alarm-btn" @onclick="AckSelected" disabled="@(!HasSelected || _loading)" title="Acknowledge selected">✔ Ack</button>
        <button class="alarm-btn" @onclick="ConfirmSelected" disabled="@(!HasSelected || _loading)" title="Confirm/Reset selected">✔✔ Reset</button>
        <span style="width: 1px; height: 14px; background: #444;"></span>
        <button class="alarm-btn" @onclick="ShowShelveDialog" disabled="@(!HasSelected || _loading)" title="Shelve selected alarms">🔇 Shelve</button>
        <button class="alarm-btn" @onclick="UnshelveSelected" disabled="@(!HasShelvedSelected || _loading)" title="Unshelve selected alarms">🔔 Unshelve</button>
        <span style="width: 1px; height: 14px; background: #444;"></span>
        <button class="alarm-btn alarm-btn-danger" @onclick="AckAll" disabled="@(_alarms.Count == 0 || _loading)" title="Acknowledge all">✔ Ack All</button>
        <button class="alarm-btn alarm-btn-danger" @onclick="ConfirmAll" disabled="@(_alarms.Count == 0 || _loading)" title="Confirm/Reset all">✔✔ Reset All</button>
    </div>

    @* Shelve duration dialog *@
    @if (_showShelveDialog)
    {
        <div style="display: flex; align-items: center; gap: 6px; padding: 4px 8px; background: #1e2a4a; border-bottom: 1px solid #444; flex-shrink: 0;">
            <span style="font-size: 11px; color: #aaa;">Shelve for:</span>
            <select @bind="_shelveDurationMinutes" style="background: #2a2a4a; color: #e0e0e0; border: 1px solid #555; border-radius: 3px; padding: 2px 4px; font-size: 11px;">
                <option value="15">15 min</option>
                <option value="30">30 min</option>
                <option value="60">1 hour</option>
                <option value="120">2 hours</option>
                <option value="480">8 hours</option>
                <option value="1440">24 hours</option>
            </select>
            <button class="alarm-btn" @onclick="ShelveSelected" style="background: #4a3a00; color: #ffc107;">🔇 Confirm Shelve</button>
            <button class="alarm-btn" @onclick="() => _showShelveDialog = false">✕ Cancel</button>
        </div>
    }

    @* Table *@
    <div style="flex: 1; overflow-y: auto;">
        @if (_loading)
        {
            <div style="text-align: center; padding: 20px; color: #888;">
                <span>⏳ Loading alarms…</span>
            </div>
        }
        else if (_alarms.Count == 0)
        {
            <div style="text-align: center; padding: 20px; color: #888;">
                <span>✅ No active alarms</span>
            </div>
        }
        else
        {
            <table class="alarm-table">
                <thead>
                    <tr>
                        <th style="width: 28px;">
                            <input type="checkbox" @onchange="ToggleAll" checked="@AllSelected" title="Select all" />
                        </th>
                        <th style="width: 50px;">Severity</th>
                        <th>Source</th>
                        <th>Message</th>
                        <th style="width: 130px;">Time</th>
                        <th style="width: 40px;">Ack</th>
                        <th style="width: 40px;">Cfm</th>
                        <th style="width: 55px;">Shelved</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alarm in _alarms)
                    {
                        var a = alarm;
                        var severityClass = GetSeverityClass(a.Severity);
                        var shelvedClass = a.IsShelved ? "alarm-shelved" : "";
                        <tr class="@severityClass @shelvedClass @(a.IsSelected ? "alarm-selected" : "") @(!a.IsAcked ? "alarm-unacked" : "")" @onclick="() => ToggleSelection(a)">
                            <td @onclick:stopPropagation>
                                <input type="checkbox" checked="@a.IsSelected" @onchange="() => ToggleSelection(a)" />
                            </td>
                            <td><span class="alarm-sev @severityClass">@a.Severity</span></td>
                            <td class="alarm-source">@a.SourceName</td>
                            <td>@a.Message</td>
                            <td class="alarm-time">@a.Time.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@(a.IsAcked ? "✔" : "—")</td>
                            <td>@(a.IsConfirmed ? "✔" : "—")</td>
                            <td>
                                @if (a.IsShelved)
                                {
                                    <span title="@($"Shelved by {a.ShelvedBy} until {a.ShelvedUntil:HH:mm}")" style="color: #ffc107;">🔇</span>
                                }
                                else
                                {
                                    <span style="color: #555;">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    .alarm-shelved {
        opacity: 0.55;
        background: repeating-linear-gradient(
            -45deg,
            transparent,
            transparent 8px,
            rgba(255, 193, 7, 0.06) 8px,
            rgba(255, 193, 7, 0.06) 16px
        ) !important;
    }
    .alarm-shelved td {
        font-style: italic;
    }
</style>

@code {
    [Inject] private OpcRuntimeClient Opc { get; set; } = default!;

    private List<AlarmEntry> _alarms = new();
    private bool _loading;
    private System.Threading.Timer? _refreshTimer;
    private bool _showShelveDialog;
    private int _shelveDurationMinutes = 60;

    private bool HasSelected => _alarms.Any(a => a.IsSelected);
    private bool HasShelvedSelected => _alarms.Any(a => a.IsSelected && a.IsShelved);
    private bool AllSelected => _alarms.Count > 0 && _alarms.All(a => a.IsSelected);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAlarms();
        // Auto-refresh every 5 seconds
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshAlarms();
                StateHasChanged();
            });
        }, null, 5000, 5000);
    }

    private bool _initialLoadDone;

    private async Task RefreshAlarms()
    {
        if (!Opc.IsConnected) return;
        if (!_initialLoadDone) { _loading = true; StateHasChanged(); }

        var fresh = await Opc.CollectDetailedAlarmsAsync();

        // Preserve selection state across refreshes
        var selectedIds = _alarms.Where(a => a.IsSelected).Select(a => a.Id).ToHashSet();
        foreach (var a in fresh)
        {
            if (selectedIds.Contains(a.Id))
                a.IsSelected = true;
        }

        _alarms = fresh;
        _loading = false;
        _initialLoadDone = true;
    }

    private void ToggleSelection(AlarmEntry alarm)
    {
        alarm.IsSelected = !alarm.IsSelected;
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        var check = e.Value is true;
        foreach (var a in _alarms) a.IsSelected = check;
    }

    private async Task AckSelected()
    {
        var selected = _alarms.Where(a => a.IsSelected).ToList();
        foreach (var a in selected)
            await Opc.AcknowledgeAlarmAsync(a.ConditionId, a.EventId);
        await RefreshAlarms();
    }

    private async Task ConfirmSelected()
    {
        var selected = _alarms.Where(a => a.IsSelected).ToList();
        foreach (var a in selected)
            await Opc.ConfirmAlarmAsync(a.ConditionId, a.EventId);
        await RefreshAlarms();
    }

    private async Task AckAll()
    {
        await Opc.AcknowledgeAllAlarmsAsync();
        await RefreshAlarms();
    }

    private async Task ConfirmAll()
    {
        await Opc.ResetAllAlarmsAsync();
        await RefreshAlarms();
    }

    private void ShowShelveDialog()
    {
        _showShelveDialog = true;
    }

    private async Task ShelveSelected()
    {
        _showShelveDialog = false;
        var selected = _alarms.Where(a => a.IsSelected && !a.IsShelved).ToList();
        foreach (var a in selected)
            await Opc.ShelveAlarmAsync(a.SourceName, _shelveDurationMinutes);
        await RefreshAlarms();
    }

    private async Task UnshelveSelected()
    {
        var selected = _alarms.Where(a => a.IsSelected && a.IsShelved).ToList();
        foreach (var a in selected)
            await Opc.UnshelveAlarmAsync(a.SourceName);
        await RefreshAlarms();
    }

    private static string GetSeverityClass(string severity)
    {
        if (int.TryParse(severity, out var sev))
        {
            return sev switch
            {
                >= 900 => "alarm-critical",
                >= 500 => "alarm-high",
                >= 200 => "alarm-medium",
                _ => "alarm-low"
            };
        }
        return "alarm-low";
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}