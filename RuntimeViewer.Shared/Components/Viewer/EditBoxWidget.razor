@using RuntimeViewer.Shared.Services
@implements IDisposable

<div class="editbox-widget" @onclick:stopPropagation @onmousedown:stopPropagation @onmouseup:stopPropagation>
    <div class="editbox-inner">
        @if (_isEditing)
        {
            <input class="editbox-input" type="text"
                   @bind="_editValue" @bind:event="oninput"
                   @onkeydown="OnKeyDown"
                   @onblur="OnBlur"
                   autofocus />
        }
        else
        {
            <div class="editbox-display" @onclick="StartEdit" title="Click to edit — @VariablePath">
                @DisplayValue
            </div>
        }
        @if (_isNumeric)
        {
            <div class="editbox-spin">
                <button class="editbox-spin-btn" @onclick="SpinUp" @onclick:stopPropagation title="Increment by @StepDisplay">▲</button>
                <button class="editbox-spin-btn" @onclick="SpinDown" @onclick:stopPropagation title="Decrement by @StepDisplay">▼</button>
            </div>
        }
    </div>
    @if (ShowStatistics && _isNumeric)
    {
        var statsMin = Opc.GetValue(VariablePath + ".Statistics.Min");
        var statsMax = Opc.GetValue(VariablePath + ".Statistics.Max");
        var statsAvg = Opc.GetValue(VariablePath + ".Statistics.Average");
        var statsCnt = Opc.GetValue(VariablePath + ".Statistics.Count");
        <div class="editbox-stats">
            <span title="Min">&#x25BC; @FormatStat(statsMin)</span>
            <span title="Average">&#x2298; @FormatStat(statsAvg)</span>
            <span title="Max">&#x25B2; @FormatStat(statsMax)</span>
            <span title="Count"># @(statsCnt ?? "0")</span>
        </div>
    }
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="editbox-status @(_statusIsError ? "editbox-status-err" : "editbox-status-ok")">@_statusMessage</div>
    }
</div>

<style>
    .editbox-widget {
        width: 100%; height: 100%; display: flex; flex-direction: column;
        font-family: var(--widget-font-family, sans-serif); font-size: var(--widget-font-size, 13px); font-weight: var(--widget-font-weight, normal); font-style: var(--widget-font-style, normal);
        background-color: var(--editbox-bg, #1e293b); color: var(--editbox-text, #e2e8f0);
        border: 1px solid var(--editbox-border, #475569); border-radius: 4px;
        overflow: hidden; box-sizing: border-box;
    }
    .editbox-inner {
        flex: 1; display: flex; align-items: stretch; min-height: 0;
    }
    .editbox-display {
        flex: 1; display: flex; align-items: center; padding: 0 8px;
        cursor: text; user-select: none; overflow: hidden; white-space: nowrap;
        text-overflow: ellipsis; font-family: monospace; font-size: 14px;
    }
    .editbox-display:hover { background: rgba(255,255,255,0.05); }
    .editbox-input {
        flex: 1; border: none; outline: none;
        background: #0f172a; color: #f1f5f9;
        padding: 0 8px; font-family: monospace; font-size: 14px;
        min-width: 0;
    }
    .editbox-spin {
        display: flex; flex-direction: column; width: 24px; flex-shrink: 0;
        border-left: 1px solid #475569;
    }
    .editbox-spin-btn {
        flex: 1; border: none; background: transparent; color: #94a3b8;
        cursor: pointer; font-size: 8px; line-height: 1; padding: 0;
        display: flex; align-items: center; justify-content: center;
    }
    .editbox-spin-btn:hover { background: #334155; color: #e2e8f0; }
    .editbox-spin-btn:active { background: #475569; }
    .editbox-spin-btn + .editbox-spin-btn { border-top: 1px solid #475569; }
    .editbox-status {
        font-size: 9px; padding: 1px 6px; text-align: center; flex-shrink: 0;
    }
    .editbox-status-ok { background: #064e3b; color: #6ee7b7; }
    .editbox-status-err { background: #7f1d1d; color: #fca5a5; }
    .editbox-stats {
        display: flex; justify-content: space-between; padding: 2px 6px;
        font-size: 9px; color: #94a3b8; background: #0f172a;
        border-top: 1px solid #334155;
    }
    .editbox-stats span { white-space: nowrap; }
</style>

@code {
    [Parameter] public string VariablePath { get; set; } = "";
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public string Format { get; set; } = "";
    [Parameter] public double? Min { get; set; }
    [Parameter] public double? Max { get; set; }
    [Parameter] public bool ShowStatistics { get; set; }

    [Inject] private OpcRuntimeClient Opc { get; set; } = default!;

    private bool _isEditing;
    private string _editValue = "";
    private string _statusMessage = "";
    private bool _statusIsError;
    private bool _isNumeric;
    private System.Threading.Timer? _statusTimer;
    private bool _spinBusy;
    private bool _isWriting;
    private string? _lastRenderedValue;

    private string DisplayValue
    {
        get
        {
            var raw = Opc.GetValue(VariablePath ?? "");
            if (raw == null) return "—";
            if (!string.IsNullOrEmpty(Format) && double.TryParse(raw, System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var dv))
                return dv.ToString(Format, System.Globalization.CultureInfo.InvariantCulture);
            return raw;
        }
    }

    private string StepDisplay => Step.ToString(System.Globalization.CultureInfo.InvariantCulture);

    protected override void OnInitialized()
    {
        Opc.ValueChanged += OnValueChanged;
        Opc.ValuesChanged += OnValuesChanged;
    }

    private void OnValueChanged(string path)
    {
        // Only re-render when our specific variable changes
        if (!string.Equals(path, VariablePath, StringComparison.Ordinal)) return;

        // Re-evaluate numeric status on every change so string variables display correctly
        var val = Opc.GetValue(VariablePath ?? "");
        _isNumeric = val != null && double.TryParse(val, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out _);
        InvokeAsync(StateHasChanged);
    }

    private void OnValuesChanged()
    {
        // Fallback: if the per-path ValueChanged event was missed (e.g. due to
        // subscription churn), re-render when ANY value changes and ours differs.
        var current = Opc.GetValue(VariablePath ?? "");
        if (current != _lastRenderedValue)
        {
            _lastRenderedValue = current;
            _isNumeric = current != null && double.TryParse(current, System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out _);
            InvokeAsync(StateHasChanged);
        }
    }

    protected override void OnParametersSet()
    {
        // Determine if the live value looks numeric to show spin buttons
        var val = Opc.GetValue(VariablePath ?? "");
        _isNumeric = val != null && double.TryParse(val, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out _);
        _lastRenderedValue = val;
    }

    private void StartEdit()
    {
        _editValue = Opc.GetValue(VariablePath ?? "") ?? "";
        _isEditing = true;
    }

    private void OnBlur()
    {
        // Don't cancel edit while an async write is in progress;
        // the write handler will clear _isEditing itself.
        if (!_isWriting)
            _isEditing = false;
    }

    private void CancelEdit()
    {
        _isEditing = false;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _isWriting = true;
            try
            {
                await WriteValue(_editValue);
            }
            finally
            {
                _isWriting = false;
                _isEditing = false;
            }
        }
        else if (e.Key == "Escape")
        {
            _isEditing = false;
        }
    }

    private async Task SpinUp()
    {
        if (_spinBusy) return;
        _spinBusy = true;
        try
        {
            var current = GetNumericValue();
            if (current.HasValue)
            {
                var newVal = current.Value + Step;
                if (Max.HasValue && newVal > Max.Value) newVal = Max.Value;
                await WriteValue(newVal.ToString(System.Globalization.CultureInfo.InvariantCulture));
            }
        }
        finally { _spinBusy = false; }
    }

    private async Task SpinDown()
    {
        if (_spinBusy) return;
        _spinBusy = true;
        try
        {
            var current = GetNumericValue();
            if (current.HasValue)
            {
                var newVal = current.Value - Step;
                if (Min.HasValue && newVal < Min.Value) newVal = Min.Value;
                await WriteValue(newVal.ToString(System.Globalization.CultureInfo.InvariantCulture));
            }
        }
        finally { _spinBusy = false; }
    }

    private double? GetNumericValue()
    {
        var raw = Opc.GetValue(VariablePath ?? "");
        if (raw != null && double.TryParse(raw, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var d))
            return d;
        return null;
    }

    private async Task WriteValue(string value)
    {
        if (string.IsNullOrEmpty(VariablePath))
        {
            ShowStatus("No variable path configured", true);
            return;
        }

        var success = await Opc.WriteValueAsync(VariablePath, value);
        if (success)
        {
            ShowStatus("✓ Written", false);
            // Refresh numeric check after write
            _isNumeric = double.TryParse(value, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out _);
        }
        else
        {
            ShowStatus("✗ Write failed", true);
        }
    }

    private void ShowStatus(string msg, bool isError)
    {
        _statusMessage = msg;
        _statusIsError = isError;
        _statusTimer?.Dispose();
        _statusTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() => { _statusMessage = ""; StateHasChanged(); });
        }, null, 2000, Timeout.Infinite);
    }

    private string FormatStat(string? val)
    {
        if (val != null && double.TryParse(val, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var d))
            return d.ToString(!string.IsNullOrEmpty(Format) ? Format : "F1",
                System.Globalization.CultureInfo.InvariantCulture);
        return val ?? "--";
    }

    public void Dispose()
    {
        Opc.ValueChanged -= OnValueChanged;
        Opc.ValuesChanged -= OnValuesChanged;
        _statusTimer?.Dispose();
    }
}

