@using SharedModels
@using RuntimeViewer.Shared.Services
@implements IAsyncDisposable

@{
    var chartTime = DateTime.UtcNow;
    var cursorTime = ShowCursor && _cursorX.HasValue ? XToTime(_cursorX.Value, chartTime) : (DateTime?)null;
}

<div class="@(_wtPalette is null ? null : "wt-panel wt-trend")" style="width: 100%; height: 100%; display: flex; flex-direction: column; font-family: var(--widget-font-family, sans-serif); font-size: var(--widget-font-size, 11px); font-weight: var(--widget-font-weight, normal); font-style: var(--widget-font-style, normal); background: @C(Background, pal => pal.Surface); color: @C("#e0e0e0", pal => pal.Text); border: 1px solid @C("#333", pal => pal.Border); border-radius: @C("4px", _ => "10px"); overflow: hidden;@C("", pal => $" box-shadow: {pal.Shadow};")">
    @* Toolbar *@
    <div class="@(_wtPalette is null ? null : "wt-toolbar")" style="display: flex; align-items: center; gap: 6px; padding: @C("2px 6px", _ => "5px 8px"); background: @C("#0d1117", pal => pal.Header); border-bottom: 1px solid @C("#333", pal => pal.Border); flex-shrink: 0;">
        <span style="font-weight: bold; font-size: 1.1em;">📈 Trend</span>
        <span style="font-size: 0.9em; color: @C("#888", pal => pal.Muted);">@Pens.Count pen(s) &middot; @(_timeWindowSec)s</span>
        <span style="flex: 1;"></span>
        <button class="hda-btn" @onclick="TogglePause" title="@(_paused ? "Resume" : "Pause")">@(_paused ? "▶" : "⏸")</button>
        <button class="hda-btn" @onclick="ClearBuffers" title="Clear history">🗑</button>
        <button class="hda-btn" @onclick="ExportCsv" title="Export trend data to CSV">📥 CSV</button>
    </div>

    @* Chart *@
    <div style="flex: 1; position: relative; min-height: 0;" @onmousemove="OnChartMouseMove" @onmouseleave="OnChartMouseLeave">
        <svg @ref="_svgRef" viewBox="0 0 @_chartW @_chartH" width="100%" height="100%" preserveAspectRatio="none"
             xmlns="http://www.w3.org/2000/svg" style="display: block;">

            @* Background *@
            <rect width="@_chartW" height="@_chartH" fill="@Background" />

            @* Grid *@
            @if (ShowGrid)
            {
                @for (int i = 0; i <= _gridYDivs; i++)
                {
                    var y = _mTop + (_plotH * i / (double)_gridYDivs);
                    <line x1="@_mLeft" y1="@Fmt(y)" x2="@(_chartW - _mRight)" y2="@Fmt(y)"
                          stroke="@GridColor" stroke-width="1" stroke-dasharray="@(_wtPalette is null ? null : "2,4")" />
                }
                @for (int i = 0; i <= _gridXDivs; i++)
                {
                    var x = _mLeft + (_plotW * i / (double)_gridXDivs);
                    <line x1="@Fmt(x)" y1="@_mTop" x2="@Fmt(x)" y2="@(_chartH - _mBottom)"
                          stroke="@GridColor" stroke-width="1" stroke-dasharray="@(_wtPalette is null ? null : "2,4")" />
                }
            }

            @* Axes *@
            <line x1="@_mLeft" y1="@_mTop" x2="@_mLeft" y2="@(_chartH - _mBottom)"
                  stroke="@AxisColor" stroke-width="1" />
            <line x1="@_mLeft" y1="@(_chartH - _mBottom)"
                  x2="@(_chartW - _mRight)" y2="@(_chartH - _mBottom)"
                  stroke="@AxisColor" stroke-width="1" />

            @* Y-axis labels *@
            @if (_hasDualAxes)
            {
                @* Left Y-axis labels (color-matched to first left-axis pen) *@
                var leftPenIdx = Pens.Select((p, i) => (p, i)).FirstOrDefault(x => x.p.YAxisId == 0);
                var leftColor = GetPenColor(leftPenIdx.p, leftPenIdx.i);
                @for (int i = 0; i <= _gridYDivs; i++)
                {
                    var y = _mTop + (_plotH * i / (double)_gridYDivs);
                    var val = _yMax - ((_yMax - _yMin) * i / (double)_gridYDivs);
                    @RenderSvgLabel(_mLeft - 4, y + 3, "end", leftColor, 8, Fmt(val))
                }

                @* Right Y-axis line *@
                <line x1="@(_chartW - _mRight)" y1="@_mTop" x2="@(_chartW - _mRight)" y2="@(_chartH - _mBottom)"
                      stroke="@AxisColor" stroke-width="1" />

                @* Right Y-axis labels (color-matched to first right-axis pen) *@
                var rightPenIdx = Pens.Select((p, i) => (p, i)).FirstOrDefault(x => x.p.YAxisId == 1);
                var rightColor = GetPenColor(rightPenIdx.p, rightPenIdx.i);
                @for (int i = 0; i <= _gridYDivs; i++)
                {
                    var y = _mTop + (_plotH * i / (double)_gridYDivs);
                    var val = _yMaxRight - ((_yMaxRight - _yMinRight) * i / (double)_gridYDivs);
                    @RenderSvgLabel(_chartW - _mRight + 4, y + 3, "start", rightColor, 8, Fmt(val))
                }
            }
            else
            {
                @for (int i = 0; i <= _gridYDivs; i++)
                {
                    var y = _mTop + (_plotH * i / (double)_gridYDivs);
                    var val = _yMax - ((_yMax - _yMin) * i / (double)_gridYDivs);
                    @RenderSvgLabel(_mLeft - 4, y + 3, "end", LabelColor, 8, Fmt(val))
                }
            }

            @* X-axis labels (time offsets) *@
            @for (int i = 0; i <= _gridXDivs; i++)
            {
                var x = _mLeft + (_plotW * i / (double)_gridXDivs);
                var secAgo = _timeWindowSec - (_timeWindowSec * i / (double)_gridXDivs);
                var lbl = secAgo >= 60 ? $"-{secAgo / 60:F0}m" : $"-{secAgo:F0}s";
                if (i == _gridXDivs) lbl = "now";
                @RenderSvgLabel(x, _chartH - _mBottom + 12, "middle", LabelColor, 7, lbl)
            }

            @* Pen polylines *@
            @for (int p = 0; p < Pens.Count; p++)
            {
                var pen = Pens[p];
                var buf = GetBuffer(p);
                if (buf.Length < 2) continue;
                var color = GetPenColor(pen, p);
                var lw = pen.LineWidth > 0 ? pen.LineWidth : 1.5;
                var pts = BuildPolyline(buf, p, chartTime);
                @if (_wtPalette is not null && !string.IsNullOrEmpty(pts))
                {
                    var gradId = $"{_areaId}_{p}";
                    <defs>
                        <linearGradient id="@gradId" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="@color" stop-opacity="0.32" />
                            <stop offset="100%" stop-color="@color" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <polygon class="wt-trend-area" points="@BuildArea(pts)" fill="url(#@gradId)" stroke="none" />
                }
                <polyline points="@pts" fill="none" stroke="@color" stroke-width="@Fmt(lw)"
                          stroke-linejoin="round" vector-effect="non-scaling-stroke" />
            }

            @* Cursor crosshair *@
            @if (ShowCursor && _cursorX.HasValue)
            {
                var cx = _cursorX.Value;
                <line x1="@Fmt(cx)" y1="@_mTop" x2="@Fmt(cx)" y2="@(_chartH - _mBottom)"
                      stroke="@C("#ffffff40", pal => pal.Muted)" stroke-width="1" stroke-dasharray="3,2" />

                var labelY = _mTop + 12.0;
                @for (int p = 0; p < Pens.Count; p++)
                {
                    var pen2 = Pens[p];
                    var buf2 = GetBuffer(p);
                    var val2 = InterpolateAtTime(buf2, cursorTime!.Value);
                    if (val2 == null) continue;
                    var color2 = GetPenColor(pen2, p);
                    var cy = ValueToY(val2.Value, pen2.YAxisId);

                    <circle cx="@Fmt(cx)" cy="@Fmt(cy)" r="3" fill="@color2" stroke="white" stroke-width="0.5" />
                    @RenderSvgLabel(cx + 6, labelY, "start", color2, 8, $"{GetPenLabel(pen2)}: {Fmt(val2.Value)}")
                    labelY += 11;
                }
            }
        </svg>
    </div>

    @* Legend *@
    @if (ShowLegend && Pens.Count > 0)
    {
        <div style="display: flex; gap: 8px; padding: @C("2px 6px", _ => "4px 8px"); background: @C("#0d1117", pal => pal.Header); border-top: 1px solid @C("#333", pal => pal.Border); flex-wrap: wrap; flex-shrink: 0; font-size: 0.9em;">
            @for (int p = 0; p < Pens.Count; p++)
            {
                var pen = Pens[p];
                var color = GetPenColor(pen, p);
                var buf = GetBuffer(p);
                var lastVal = cursorTime.HasValue
                    ? InterpolateAtTime(buf, cursorTime.Value)
                    : buf.Length > 0 ? buf[^1].Value : (double?)null;
                <span>
                    <span style="display:inline-block;width:12px;height:3px;background:@color;vertical-align:middle;margin-right:3px;@C("", _ => "border-radius:2px;")"></span>
                    @GetPenLabel(pen)
                    @if (lastVal.HasValue)
                    {
                        <span style="color:@C("#9ca3af", pal => pal.Muted);"> = @Fmt(lastVal.Value)</span>
                    }
                    @if (_hasDualAxes)
                    {
                        <span style="color:@C("#555", pal => pal.Muted);font-size:0.8em;"> (@(pen.YAxisId == 0 ? "L" : "R"))</span>
                    }
                </span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<TrendPen> Pens { get; set; } = new();
    [Parameter] public int TimeWindowSeconds { get; set; } = 60;
    [Parameter] public bool ShowGrid { get; set; } = true;
    [Parameter] public bool ShowCursor { get; set; } = true;
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public double? YMin { get; set; }
    [Parameter] public double? YMax { get; set; }
    [Parameter] public string Background { get; set; } = "#111827";

    /// <summary>Widget theme (ScreenSymbol.WidgetTheme). "classic" keeps the legacy look.</summary>
    [Parameter] public string Theme { get; set; } = WidgetThemes.Classic;

    private WidgetPalette? _wtPalette => WidgetThemes.GetPalette(Theme);
    private string C(string classic, Func<WidgetPalette, string> themed) => WidgetThemes.Pick(_wtPalette, classic, themed);
    private string GridColor => C("#1f2937", pal => pal.Grid);
    private string AxisColor => C("#374151", pal => pal.Border);
    private string LabelColor => C("#6b7280", pal => pal.Muted);
    private readonly string _areaId = "wtarea_" + Guid.NewGuid().ToString("N")[..8];

    /// <summary>Closes a polyline down to the X axis so it can be filled as an area.</summary>
    private string BuildArea(string points)
    {
        var first = points.IndexOf(',');
        var lastSpace = points.LastIndexOf(' ');
        var lastComma = points.LastIndexOf(',');
        if (first <= 0 || lastComma <= lastSpace) return "";
        var baseY = Fmt(_chartH - _mBottom);
        return $"{points[..first]},{baseY} {points} {points[(lastSpace + 1)..lastComma]},{baseY}";
    }

    [Inject] private OpcRuntimeClient Opc { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private record struct Sample(DateTime Time, double Value);

    // Each pen's buffer is an immutable array; SampleAll builds new arrays
    // and swaps them atomically so renders never see a half-modified list.
    private volatile Sample[][] _buffers = [];
    private System.Threading.Timer? _sampleTimer;
    private bool _paused;
    private int _timeWindowSec = 60;
    private double? _cursorX;
    private ElementReference _svgRef;
    private Task<IJSObjectReference>? _coordinateModule;
    private long _cursorMoveVersion;
    private bool _disposed;
    private record struct SvgPoint(double X, double Y);

    // Chart layout
    private const int _chartW = 800;
    private const int _chartH = 280;
    private const int _mLeft = 55;
    private const int _mTop = 8;
    private const int _mBottom = 20;
    private const int _gridYDivs = 5;
    private const int _gridXDivs = 6;

    private int _mRight => _hasDualAxes ? 55 : 8;
    private int _plotW => _chartW - _mLeft - _mRight;
    private const int _plotH = _chartH - _mTop - _mBottom;

    private double _yMin;
    private double _yMax;

    // Dual-axis support
    private bool _hasDualAxes;
    private double _yMinRight;
    private double _yMaxRight;

    private static readonly string[] _palette =
    [
        "#3b82f6", "#ef4444", "#10b981", "#f59e0b", "#8b5cf6",
        "#ec4899", "#06b6d4", "#84cc16", "#f97316", "#6366f1"
    ];

    protected override void OnInitialized()
    {
        _timeWindowSec = TimeWindowSeconds > 0 ? TimeWindowSeconds : 60;
        _hasDualAxes = Pens.Any(pal => pal.YAxisId == 1);
        EnsureBuffers();
        _sampleTimer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                if (!_paused) SampleAll();
                StateHasChanged();
            });
        }, null, 500, 250);
    }

    protected override void OnParametersSet()
    {
        _timeWindowSec = TimeWindowSeconds > 0 ? TimeWindowSeconds : 60;
        EnsureBuffers();
    }

    private void EnsureBuffers()
    {
        var current = _buffers;
        if (current.Length == Pens.Count) return;
        var next = new Sample[Pens.Count][];
        for (int i = 0; i < next.Length; i++)
            next[i] = i < current.Length ? current[i] : [];
        _buffers = next;
    }

    private void SampleAll()
    {
        var now = DateTime.UtcNow;
        var cutoff = now.AddSeconds(-_timeWindowSec * 1.2);
        var snap = _buffers;
        var next = new Sample[snap.Length][];

        for (int i = 0; i < snap.Length && i < Pens.Count; i++)
        {
            var old = snap[i];
            var path = Pens[i].VariablePath;
            Sample? newSample = null;
            if (!string.IsNullOrEmpty(path))
            {
                var raw = Opc.GetValue(path);
                if (raw != null && double.TryParse(raw, System.Globalization.NumberStyles.Any,
                        System.Globalization.CultureInfo.InvariantCulture, out var d))
                {
                    newSample = new Sample(now, d);
                }
            }

            // Build new array: keep non-expired samples + optional new sample
            int keepFrom = 0;
            for (int j = 0; j < old.Length; j++)
            {
                if (old[j].Time >= cutoff) { keepFrom = j; break; }
                if (j == old.Length - 1) keepFrom = old.Length; // all expired
            }
            int keepCount = old.Length - keepFrom;
            int newLen = keepCount + (newSample.HasValue ? 1 : 0);
            var arr = new Sample[newLen];
            if (keepCount > 0) Array.Copy(old, keepFrom, arr, 0, keepCount);
            if (newSample.HasValue) arr[^1] = newSample.Value;
            next[i] = arr;
        }

        // Atomic swap — any concurrent render sees either old or new, never partial
        _buffers = next;
        ComputeYRange();
    }

    private void ComputeYRange()
    {
        if (!_hasDualAxes)
        {
            // Original shared-axis logic
            if (YMin.HasValue && YMax.HasValue)
            {
                _yMin = YMin.Value;
                _yMax = YMax.Value;
                return;
            }

            var lo = double.MaxValue;
            var hi = double.MinValue;
            var snap = _buffers;
            for (int b = 0; b < snap.Length; b++)
            {
                var arr = snap[b];
                for (int j = 0; j < arr.Length; j++)
                {
                    if (arr[j].Value < lo) lo = arr[j].Value;
                    if (arr[j].Value > hi) hi = arr[j].Value;
                }
            }

            if (lo == double.MaxValue) { lo = 0; hi = 100; }
            if (Math.Abs(hi - lo) < 0.001) { lo -= 1; hi += 1; }

            var range = hi - lo;
            lo -= range * 0.05;
            hi += range * 0.05;

            _yMin = YMin ?? lo;
            _yMax = YMax ?? hi;
        }
        else
        {
            // Dual-axis: compute separate ranges for axis 0 (left) and axis 1 (right)
            ComputeAxisRange(0, out _yMin, out _yMax);
            ComputeAxisRange(1, out _yMinRight, out _yMaxRight);
        }
    }

    private void ComputeAxisRange(int axisId, out double axisMin, out double axisMax)
    {
        var lo = double.MaxValue;
        var hi = double.MinValue;
        var snap = _buffers;

        // Check per-pen overrides first
        double? overrideMin = null, overrideMax = null;
        for (int p = 0; p < Pens.Count; p++)
        {
            if (Pens[p].YAxisId != axisId) continue;
            if (Pens[p].YMin.HasValue) overrideMin ??= Pens[p].YMin;
            if (Pens[p].YMax.HasValue) overrideMax ??= Pens[p].YMax;

            if (p < snap.Length)
            {
                var arr = snap[p];
                for (int j = 0; j < arr.Length; j++)
                {
                    if (arr[j].Value < lo) lo = arr[j].Value;
                    if (arr[j].Value > hi) hi = arr[j].Value;
                }
            }
        }

        // Fallback for axis 0 to global YMin/YMax parameters
        if (axisId == 0)
        {
            overrideMin ??= YMin;
            overrideMax ??= YMax;
        }

        if (lo == double.MaxValue) { lo = 0; hi = 100; }
        if (Math.Abs(hi - lo) < 0.001) { lo -= 1; hi += 1; }

        var range = hi - lo;
        lo -= range * 0.05;
        hi += range * 0.05;

        axisMin = overrideMin ?? lo;
        axisMax = overrideMax ?? hi;
    }

    private Sample[] GetBuffer(int idx)
    {
        var snap = _buffers;
        return idx >= 0 && idx < snap.Length ? snap[idx] : [];
    }

    private string BuildPolyline(Sample[] buf, int penIndex, DateTime chartTime)
    {
        var sb = new System.Text.StringBuilder();
        var axisId = penIndex < Pens.Count ? Pens[penIndex].YAxisId : 0;
        var (yLo, yHi) = GetAxisRange(axisId);
        var rangeY = yHi - yLo;
        if (rangeY == 0) rangeY = 1;

        var windowStart = chartTime.AddSeconds(-_timeWindowSec);
        if (buf.Length >= 2 && buf[0].Time < windowStart && buf[^1].Time > windowStart)
        {
            // Retain the segment crossing the window edge so cursor readings stay on the curve.
            var boundaryValue = InterpolateAtTime(buf, windowStart);
            if (boundaryValue.HasValue)
                sb.Append(Fmt(_mLeft)).Append(',').Append(Fmt(ValueToY(boundaryValue.Value, axisId)));
        }

        foreach (var s in buf)
        {
            var secAgo = (chartTime - s.Time).TotalSeconds;
            if (secAgo > _timeWindowSec) continue;
            var xFrac = 1.0 - secAgo / _timeWindowSec;
            var yFrac = (s.Value - yLo) / rangeY;

            var px = _mLeft + xFrac * _plotW;
            var py = _mTop + (1 - yFrac) * _plotH;

            if (sb.Length > 0) sb.Append(' ');
            sb.Append(Fmt(px)); sb.Append(','); sb.Append(Fmt(py));
        }

        return sb.ToString();
    }

    private double ValueToY(double val, int axisId = 0)
    {
        var (yLo, yHi) = GetAxisRange(axisId);
        var rangeY = yHi - yLo;
        if (rangeY == 0) rangeY = 1;
        var yFrac = (val - yLo) / rangeY;
        return _mTop + (1 - yFrac) * _plotH;
    }

    private (double min, double max) GetAxisRange(int axisId) =>
        _hasDualAxes && axisId == 1 ? (_yMinRight, _yMaxRight) : (_yMin, _yMax);

    private DateTime XToTime(double x, DateTime chartTime)
    {
        var frac = (x - _mLeft) / _plotW;
        var secAgo = (1 - frac) * _timeWindowSec;
        return chartTime.AddSeconds(-secAgo);
    }

    private double? InterpolateAtTime(Sample[] buf, DateTime t)
    {
        if (buf.Length < 2 || t < buf[0].Time || t > buf[^1].Time) return null;
        if (t == buf[0].Time) return buf[0].Value;
        if (t == buf[^1].Time) return buf[^1].Value;

        for (int i = 1; i < buf.Length; i++)
        {
            if (buf[i].Time >= t)
            {
                var dt = (buf[i].Time - buf[i - 1].Time).TotalSeconds;
                if (dt <= 0) return buf[i].Value;
                var frac = (t - buf[i - 1].Time).TotalSeconds / dt;
                return buf[i - 1].Value + frac * (buf[i].Value - buf[i - 1].Value);
            }
        }
        return buf[^1].Value;
    }

    private async Task OnChartMouseMove(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (!ShowCursor || _disposed) return;
        var version = ++_cursorMoveVersion;
        _coordinateModule ??= JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/RuntimeViewer.Shared/screenrenderer.js").AsTask();
        var module = await _coordinateModule;
        if (_disposed || version != _cursorMoveVersion) return;
        var point = await module.InvokeAsync<SvgPoint>("clientToSvg", _svgRef, e.ClientX, e.ClientY);
        if (_disposed || version != _cursorMoveVersion) return;

        _cursorX = point.X >= _mLeft && point.X <= _chartW - _mRight
            && point.Y >= _mTop && point.Y <= _chartH - _mBottom ? point.X : null;
    }

    private void OnChartMouseLeave(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        ++_cursorMoveVersion;
        _cursorX = null;
    }

    private void TogglePause() => _paused = !_paused;

    private void ClearBuffers()
    {
        var snap = _buffers;
        var next = new Sample[snap.Length][];
        for (int i = 0; i < next.Length; i++) next[i] = [];
        _buffers = next;
    }

    private static string GetPenColor(TrendPen pen, int index) =>
        !string.IsNullOrEmpty(pen.Color) ? pen.Color : _palette[index % _palette.Length];

    private static string GetPenLabel(TrendPen pen) =>
        !string.IsNullOrEmpty(pen.Label) ? pen.Label : GetShortName(pen.VariablePath);

    private static string GetShortName(string path)
    {
        var idx = path.LastIndexOf('.');
        return idx >= 0 ? path[(idx + 1)..] : path;
    }

    private static string Fmt(double v) =>
        v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private RenderFragment RenderSvgLabel(double x, double y, string anchor, string fill, int fontSize, string content) => builder =>
    {
        int seq = 0;
        builder.OpenElement(seq++, "text");
        builder.AddAttribute(seq++, "x", Fmt(x));
        builder.AddAttribute(seq++, "y", Fmt(y));
        builder.AddAttribute(seq++, "text-anchor", anchor);
        builder.AddAttribute(seq++, "fill", fill);
        builder.AddAttribute(seq++, "font-size", fontSize);
        builder.AddAttribute(seq++, "font-family", "monospace");
        builder.AddContent(seq++, content);
        builder.CloseElement();
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        ++_cursorMoveVersion;
        _sampleTimer?.Dispose();
        if (_coordinateModule is not null)
        {
            try
            {
                var module = await _coordinateModule;
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser connection may already be closed during teardown.
            }
        }
    }

    private async Task ExportCsv()
    {
        var snap = _buffers;
        if (snap.Length == 0 || Pens.Count == 0) return;

        var sb = new System.Text.StringBuilder();
        sb.Append("Timestamp");
        foreach (var pen in Pens)
            sb.Append(',').Append(pen.VariablePath ?? "");
        sb.AppendLine();

        // Merge all samples by time
        var allTimes = new SortedSet<DateTime>();
        for (int i = 0; i < Math.Min(snap.Length, Pens.Count); i++)
            foreach (var s in snap[i])
                allTimes.Add(s.Time);

        var lookups = new Dictionary<DateTime, double>[Math.Min(snap.Length, Pens.Count)];
        for (int i = 0; i < lookups.Length; i++)
            lookups[i] = snap[i].ToDictionary(s => s.Time, s => s.Value);

        foreach (var time in allTimes)
        {
            sb.Append(time.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff", System.Globalization.CultureInfo.InvariantCulture));
            for (int i = 0; i < lookups.Length; i++)
            {
                sb.Append(',');
                if (lookups[i].TryGetValue(time, out var val))
                    sb.Append(val.ToString(System.Globalization.CultureInfo.InvariantCulture));
            }
            sb.AppendLine();
        }

        var csv = sb.ToString();
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/RuntimeViewer.Shared/dataexport.js");
        await module.InvokeVoidAsync("downloadText",
            $"trend-{DateTime.Now:yyyyMMdd-HHmmss}.csv", "text/csv", csv);
        await module.DisposeAsync();
    }
}
