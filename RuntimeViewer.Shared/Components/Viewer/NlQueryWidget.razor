@using SharedModels
@using RuntimeViewer.Shared.Services

<div class="nlquery-widget" style="width: 100%; height: 100%; display: flex; flex-direction: column; font-family: var(--widget-font-family, sans-serif); font-size: var(--widget-font-size, 12px); background: var(--nlq-bg, #111827); color: var(--nlq-text, #e0e0e0); border: 1px solid var(--nlq-border, #333); border-radius: 4px; overflow: hidden;">

    @* Header *@
    <div style="padding: 6px 10px; background: #1f2937; border-bottom: 1px solid #333; display: flex; align-items: center; gap: 6px; flex-shrink: 0;">
        <span style="font-size: 14px;">🤖</span>
        <span style="font-weight: bold; font-size: 12px;">Process Data Assistant</span>
        <span style="flex: 1;"></span>
        @if (_history.Count > 0)
        {
            <button style="background: none; border: 1px solid #555; color: #aaa; border-radius: 3px; padding: 2px 8px; cursor: pointer; font-size: 10px;"
                    @onclick="ClearHistory">Clear</button>
        }
    </div>

    @* Conversation area *@
    <div style="flex: 1; overflow-y: auto; padding: 8px; display: flex; flex-direction: column; gap: 8px;" @ref="_chatArea">
        @if (_history.Count == 0 && !_loading)
        {
            <div style="text-align: center; padding: 20px; color: #666;">
                <div style="font-size: 24px; margin-bottom: 8px;">💬</div>
                <div>Ask questions about your process data</div>
                <div style="font-size: 10px; margin-top: 8px; color: #555;">
                    Examples: "What was the max temperature yesterday?"
                    · "Average pressure in the last 2 hours?"
                    · "Show me a summary of today's data"
                </div>
            </div>
        }

        @foreach (var entry in _history)
        {
            @* User message *@
            <div style="display: flex; justify-content: flex-end;">
                <div style="background: #1d4ed8; color: white; padding: 6px 10px; border-radius: 10px 10px 2px 10px; max-width: 80%; word-wrap: break-word; font-size: 12px;">
                    @entry.Question
                </div>
            </div>

            @* AI response *@
            <div style="display: flex; justify-content: flex-start; gap: 6px;">
                <span style="font-size: 16px; flex-shrink: 0; margin-top: 2px;">🤖</span>
                <div style="background: #1f2937; border: 1px solid #333; padding: 8px 10px; border-radius: 2px 10px 10px 10px; max-width: 85%; word-wrap: break-word;">
                    <div style="white-space: pre-wrap; font-size: 12px; line-height: 1.5;">@entry.Answer</div>
                    @if (entry.VariablesUsed.Count > 0)
                    {
                        <div style="margin-top: 4px; font-size: 9px; color: #666; border-top: 1px solid #2a2a2a; padding-top: 4px;">
                            📊 @string.Join(", ", entry.VariablesUsed) · ⏱ @(entry.DurationMs)ms
                        </div>
                    }
                </div>
            </div>
        }

        @if (_loading)
        {
            <div style="display: flex; justify-content: flex-start; gap: 6px;">
                <span style="font-size: 16px; flex-shrink: 0; margin-top: 2px;">🤖</span>
                <div style="background: #1f2937; border: 1px solid #333; padding: 8px 10px; border-radius: 2px 10px 10px 10px;">
                    <span class="nlq-typing">Analyzing data</span>
                </div>
            </div>
        }
    </div>

    @* Input area *@
    <div style="padding: 6px 8px; background: #1f2937; border-top: 1px solid #333; display: flex; gap: 6px; flex-shrink: 0;">
        <input type="text" @bind="_currentQuestion" @bind:event="oninput"
               @onkeydown="OnKeyDown"
               placeholder="@_placeholder"
               disabled="@_loading"
               style="flex: 1; background: #0f172a; border: 1px solid #444; border-radius: 4px; padding: 6px 10px; color: #e0e0e0; font-size: 12px; outline: none;" />
        <button @onclick="Submit" disabled="@(_loading || string.IsNullOrWhiteSpace(_currentQuestion))"
                style="background: #2563eb; color: white; border: none; border-radius: 4px; padding: 6px 14px; cursor: pointer; font-size: 12px; font-weight: bold; opacity: @(_loading || string.IsNullOrWhiteSpace(_currentQuestion) ? "0.5" : "1");">
            @(_loading ? "…" : "Ask")
        </button>
    </div>
</div>

<style>
    .nlq-typing::after {
        content: '...';
        animation: nlq-dots 1.5s infinite;
    }
    @@keyframes nlq-dots {
        0% { content: '.'; }
        33% { content: '..'; }
        66% { content: '...'; }
    }
</style>

@code {
    [Inject] private NaturalLanguageQueryService NlQuery { get; set; } = default!;
    [Inject] private ProjectService Project { get; set; } = default!;

    private ElementReference _chatArea;
    private string _currentQuestion = "";
    private bool _loading;
    private string _placeholder = "Ask about your process data...";
    private readonly List<ChatEntry> _history = new();

    protected override void OnInitialized()
    {
        var cfg = Project.Settings.NaturalLanguageQuery;
        if (cfg != null && !string.IsNullOrEmpty(cfg.Placeholder))
            _placeholder = cfg.Placeholder;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_loading && !string.IsNullOrWhiteSpace(_currentQuestion))
            await Submit();
    }

    private async Task Submit()
    {
        var question = _currentQuestion.Trim();
        if (string.IsNullOrWhiteSpace(question) || _loading) return;

        _currentQuestion = "";
        _loading = true;
        StateHasChanged();

        var result = await NlQuery.AskAsync(question);

        _history.Add(new ChatEntry
        {
            Question = question,
            Answer = result.Answer,
            VariablesUsed = result.VariablesUsed,
            DurationMs = result.DurationMs
        });

        _loading = false;
        StateHasChanged();
    }

    private void ClearHistory()
    {
        _history.Clear();
        StateHasChanged();
    }

    private sealed class ChatEntry
    {
        public string Question { get; set; } = "";
        public string Answer { get; set; } = "";
        public List<string> VariablesUsed { get; set; } = [];
        public long DurationMs { get; set; }
    }
}
