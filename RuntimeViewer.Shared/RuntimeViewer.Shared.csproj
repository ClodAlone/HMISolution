<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedModels\SharedModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0-preview.4.25258.110" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0-preview.4.25258.110" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua" Version="1.5.378.106" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.6" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <!-- When building one configuration, also build the other so both Debug and Release binaries are always available -->
  <Target Name="BuildOtherConfiguration" AfterTargets="Build" Condition="'$(BuildingOtherConfiguration)' != 'true'">
    <Message Importance="high" Text="Building RuntimeViewer.Shared — $(OtherConfiguration) ..." />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             Properties="Configuration=$(OtherConfiguration);BuildingOtherConfiguration=true" />
  </Target>

  <PropertyGroup>
    <OtherConfiguration Condition="'$(Configuration)' == 'Debug'">Release</OtherConfiguration>
    <OtherConfiguration Condition="'$(Configuration)' == 'Release'">Debug</OtherConfiguration>
  </PropertyGroup>

</Project>
